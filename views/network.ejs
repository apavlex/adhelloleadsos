<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { tailwindInPage: true }) %>
  <style>
    .net-stat { border: 1px solid rgba(15, 23, 42, 0.08); background: rgba(255, 255, 255, 0.86); border-radius: 1.15rem; padding: 0.9rem 1rem; }
    html.dark .net-stat { background: rgba(15, 23, 42, 0.72); border-color: rgba(255, 255, 255, 0.08); }
    .net-card { border: 1px solid rgba(15, 23, 42, 0.08); background: #fff; border-radius: 1.35rem; padding: 1rem 1.05rem; }
    html.dark .net-card { background: rgba(15, 23, 42, 0.78); border-color: rgba(255, 255, 255, 0.08); }
    .net-tabs { display: flex; gap: 0.35rem; overflow-x: auto; padding-bottom: 0.25rem; margin-bottom: 1rem; }
    .net-tab { flex-shrink: 0; border-radius: 999px; padding: 0.5rem 0.95rem; font-size: 0.78rem; font-weight: 700; border: 1px solid rgba(15, 23, 42, 0.12); color: inherit; text-decoration: none; }
    html.dark .net-tab { border-color: rgba(255, 255, 255, 0.14); }
    .net-tab:hover { border-color: var(--brand-yellow, #FFD644); }
    .net-tab.is-on { background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); border-color: transparent; }
    .net-tabs { align-items: center; padding: 0.2rem 0.2rem 0.6rem; }
    .net-tabs > .net-tab.is-on { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 16%, transparent); color: inherit; border-color: var(--brand-yellow, #FFD644); }
    .net-tab-cta { order: -1; display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0; border-radius: 999px; padding: 0.55rem 1.1rem; font-size: 0.8rem; font-weight: 800; text-decoration: none; background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); box-shadow: 0 4px 10px -6px color-mix(in srgb, var(--brand-yellow, #FFD644) 80%, #000); transition: background 120ms ease, transform 80ms ease; }
    .net-tab-cta:hover { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 88%, #000); }
    .net-tab-cta:active { transform: scale(0.97); }
    .net-tab-cta.is-on { box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-yellow, #FFD644) 35%, transparent); }
    .net-tab-cta svg { width: 0.95rem; height: 0.95rem; }
    @media (min-width: 640px) { .net-tab-cta { order: 99; margin-left: auto; } }
    .net-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0.45rem 0.85rem; font-size: 0.74rem; font-weight: 700; line-height: 1; white-space: nowrap; border: 1px solid transparent; cursor: pointer; text-decoration: none; }
    .net-btn-yellow { background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); }
    .net-btn-yellow:hover { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 88%, #000); }
    .net-btn-ghost { background: transparent; border-color: rgba(15, 23, 42, 0.14); color: inherit; }
    html.dark .net-btn-ghost { border-color: rgba(255, 255, 255, 0.16); }
    .net-btn-ghost:hover { border-color: var(--brand-yellow, #FFD644); }
    .net-btn-danger { background: transparent; color: #e11d48; border-color: rgba(225, 29, 72, 0.3); }
    .net-label { display: block; font-size: 10px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #64748b; margin-bottom: 0.3rem; }
    .net-input { width: 100%; border-radius: 0.85rem; border: 1px solid rgba(148, 163, 184, 0.4); background: rgba(248, 250, 252, 0.9); padding: 0.6rem 0.75rem; font-size: 0.875rem; color: inherit; }
    html.dark .net-input { background: rgba(2, 6, 23, 0.45); border-color: rgba(255, 255, 255, 0.12); color: #f8fafc; }
    .net-checks { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .net-check { display: inline-flex; align-items: center; gap: 0.35rem; border-radius: 999px; border: 1px solid rgba(15, 23, 42, 0.12); padding: 0.3rem 0.65rem; font-size: 12px; font-weight: 600; cursor: pointer; }
    html.dark .net-check { border-color: rgba(255, 255, 255, 0.14); }
    .net-check:has(input:checked) { background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); border-color: transparent; }
    .net-check input { accent-color: var(--brand-on-accent, #111827); }
    .net-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(148, 163, 184, 0.16); color: #64748b; }
    .net-pill-sent { background: rgba(59, 130, 246, 0.14); color: #1d4ed8; }
    .net-pill-accepted, .net-pill-booked { background: rgba(245, 158, 11, 0.16); color: #b45309; }
    .net-pill-won { background: rgba(16, 185, 129, 0.14); color: #047857; }
    .net-pill-unrouted, .net-pill-declined { background: rgba(225, 29, 72, 0.12); color: #be123c; }
    html.dark .net-pill-sent { color: #93c5fd; }
    html.dark .net-pill-accepted, html.dark .net-pill-booked { color: #fcd34d; }
    html.dark .net-pill-won { color: #6ee7b7; }
    html.dark .net-pill-unrouted, html.dark .net-pill-declined { color: #fda4af; }
    .net-seats { display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.45rem; margin-top: 0.75rem; }
    .net-seat { border-radius: 0.9rem; padding: 0.55rem 0.7rem; border: 1px dashed rgba(148, 163, 184, 0.55); min-width: 0; }
    .net-seat.is-held { border-style: solid; border-color: color-mix(in srgb, var(--brand-yellow, #FFD644) 60%, transparent); background: color-mix(in srgb, var(--brand-yellow, #FFD644) 12%, transparent); }
    .net-seat.is-paused { opacity: 0.6; }
    .net-seat-holder { display: block; margin: 0.1rem -0.35rem 0; padding: 0.12rem 0.35rem; border-radius: 0.5rem; font-size: 13px; font-weight: 600; color: inherit; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .net-seat-holder:hover, .net-seat-holder:focus-visible { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 22%, transparent); text-decoration: underline; }
    .net-seat-holder.is-paused { opacity: 0.6; }
    .net-seat-holder.is-waiting { display: flex; align-items: center; gap: 0.3rem; font-weight: 500; color: #64748b; }
    .net-seat-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .net-seat-wait { flex-shrink: 0; padding: 0 0.3rem; border-radius: 999px; font-size: 9px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(148, 163, 184, 0.2); vertical-align: 1px; }
    .net-seat-row { display: flex; align-items: center; gap: 0.15rem; min-width: 0; }
    .net-seat-row .net-seat-holder { flex: 1 1 auto; min-width: 0; }
    .net-seat-remove { margin: 0.1rem 0 0; flex-shrink: 0; }
    .net-seat-remove button { width: 1.25rem; height: 1.25rem; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 999px; background: transparent; color: #94a3b8; font-size: 15px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity 120ms ease; }
    .net-seat-row:hover .net-seat-remove button, .net-seat-remove button:focus-visible { opacity: 1; }
    .net-seat-remove button:hover { background: rgba(225, 29, 72, 0.12); color: #e11d48; }
    @media (hover: none) { .net-seat-remove button { opacity: 0.7; } }
    .net-seat-allow { margin: 0.3rem 0 0; }
    .net-seat-allow button { padding: 0.25rem 0.65rem; border-radius: 999px; border: 0; font-size: 11px; font-weight: 800; background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); cursor: pointer; }
    .net-seat-allow button:hover { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 88%, #000); }
    .net-seat-add { display: inline-block; margin-top: 0.2rem; font-size: 11px; font-weight: 700; color: #64748b; text-decoration: none; }
    .net-seat-add:hover { text-decoration: underline; }
    .net-seat p { margin: 0; }
    .net-seat { position: relative; }
    .net-seat.is-off { opacity: 0.45; border-style: dotted; }
    .net-seat.is-off:hover { opacity: 0.85; }
    .net-seat-toggle { margin: 0; }
    .net-seat-x {
      position: absolute; top: 0.3rem; right: 0.3rem; width: 1.35rem; height: 1.35rem; border-radius: 999px; border: 0;
      display: inline-flex; align-items: center; justify-content: center; font-size: 0.95rem; line-height: 1;
      color: #94a3b8; background: transparent; cursor: pointer; opacity: 0; transition: opacity 0.15s ease, background 0.15s ease;
    }
    .net-seat:hover .net-seat-x, .net-seat-x:focus-visible { opacity: 1; }
    .net-seat-x:hover { background: rgba(225, 29, 72, 0.12); color: #e11d48; }
    @media (hover: none) { .net-seat-x { opacity: 0.7; } }
    .net-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.45rem; margin-top: 0.75rem; }
    @media (min-width: 640px) { .net-metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .net-metric { border-radius: 0.8rem; padding: 0.45rem 0.6rem; background: rgba(15, 23, 42, 0.03); }
    html.dark .net-metric { background: rgba(255, 255, 255, 0.04); }
    .net-metric span { display: block; font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #64748b; }
    .net-metric strong { display: block; font-size: 1.05rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .net-file { display: block; width: 100%; font-size: 0.8rem; color: #64748b; cursor: pointer; }
    .net-file::file-selector-button {
      margin-right: 0.65rem; border-radius: 999px; padding: 0.5rem 0.95rem; font: inherit; font-size: 0.74rem; font-weight: 700;
      background: transparent; color: #0f172a; border: 1px solid rgba(15, 23, 42, 0.14); cursor: pointer; transition: border-color 0.15s ease;
    }
    .net-file:hover::file-selector-button { border-color: var(--brand-yellow, #FFD644); }
    html.dark .net-file::file-selector-button { color: #f8fafc; border-color: rgba(255, 255, 255, 0.16); }
    .net-swatch {
      -webkit-appearance: none; appearance: none; flex-shrink: 0; width: 2.5rem; height: 2.5rem; padding: 0; border-radius: 999px;
      border: 1px solid rgba(15, 23, 42, 0.14); background: transparent; cursor: pointer; overflow: hidden;
    }
    html.dark .net-swatch { border-color: rgba(255, 255, 255, 0.16); }
    .net-swatch::-webkit-color-swatch-wrapper { padding: 3px; }
    .net-swatch::-webkit-color-swatch { border: none; border-radius: 999px; }
    .net-swatch::-moz-color-swatch { border: none; border-radius: 999px; }
    .net-swatch:focus-visible { outline: 2px solid var(--brand-yellow, #FFD644); outline-offset: 2px; }
    .net-trade-form { display: grid; gap: 0.5rem; }
    @media (min-width: 640px) { .net-trade-form { grid-template-columns: 1fr 1fr auto; align-items: end; } .net-trade-form .net-btn { height: 2.6rem; } }
    .net-review-other { display: grid; gap: 0.5rem; }
    @media (min-width: 640px) { .net-review-other { grid-template-columns: 12rem minmax(0, 1fr); } }
    details.net-more > summary { list-style: none; cursor: pointer; }
    details.net-more > summary::-webkit-details-marker { display: none; }
  </style>
  <%- include('partials/tailwind_css') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <%
    const noticeBad = notice && /^(Could not|Only|Pick|Name|Add|Confirm|That|Member not|Zone not|Referral not|Can't|Unknown|Write|This referral|The sender)/.test(notice);
    const tabs = [
      { id: 'seats', label: 'Seats' },
      { id: 'members', label: 'Members (' + totals.members + ')' },
      { id: 'applications', label: 'Applications' + (pendingApplications ? ' (' + pendingApplications + ')' : '') },
      { id: 'referrals', label: 'Referrals (' + totals.total + ')' },
      { id: 'brand', label: 'App branding' },
      { id: 'setup', label: 'Setup' },
    ];
    function tradeChecks(name, selected) {
      return networkTrades.map(function (t) {
        return '<label class="net-check"><input type="checkbox" name="' + name + '" value="' + t.slug + '"' + (selected.indexOf(t.slug) >= 0 ? ' checked' : '') + ' />' + t.name + '</label>';
      }).join('');
    }
    function zoneChecks(name, selected) {
      return zones.map(function (z) {
        return '<label class="net-check"><input type="checkbox" name="' + name + '" value="' + z.id + '"' + (selected.indexOf(z.id) >= 0 ? ' checked' : '') + ' />' + z.name.replace(/</g, '&lt;') + '</label>';
      }).join('');
    }
  %>
  <main class="max-wide px-6 py-8 md:py-12">
    <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-brand-muted mb-2">Referral network</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight"><%= network.name %></h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-muted dark:text-slate-400"><% if (network.seatLimit === 1) { %>One company per trade in each zone. Referrals go to the seat holder<% } else { %><%= network.seatLimit ? 'Up to ' + network.seatLimit : 'Any number of' %> companies per trade in each zone. Referrals rotate between them<% } %>, who accept and report the outcome from a text link — no login needed.</p>
      </div>
    </header>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
      <div class="net-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Members</p>
        <p class="font-display font-black text-2xl"><%= totals.members %></p>
      </div>
      <div class="net-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Seats held / open</p>
        <p class="font-display font-black text-2xl"><%= totals.heldSeats %> <span class="text-brand-muted text-lg">/ <%= totals.openSeats %></span></p>
      </div>
      <div class="net-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Open referrals</p>
        <p class="font-display font-black text-2xl"><%= totals.open %><% if (totals.unrouted) { %> <span class="text-rose-600 text-sm font-bold"><%= totals.unrouted %> need a member</span><% } %></p>
      </div>
      <div class="net-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Won</p>
        <p class="font-display font-black text-2xl"><%= totals.wonValueLabel %> <span class="text-brand-muted text-sm font-bold"><%= totals.won %> <%= totals.won === 1 ? 'job' : 'jobs' %></span></p>
      </div>
    </div>

    <nav class="net-tabs" aria-label="Network sections">
      <% tabs.forEach(function (t) { %>
      <a href="/network?tab=<%= t.id %>" class="net-tab <%= tab === t.id ? 'is-on' : '' %>" <%= tab === t.id ? 'aria-current=page' : '' %>><%= t.label %></a>
      <% }); %>
      <a href="/network?tab=send" class="net-tab-cta <%= tab === 'send' ? 'is-on' : '' %>" data-open-send-referral <%= tab === 'send' ? 'aria-current=page' : '' %>>
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.27 3.13a59.77 59.77 0 0118.22 8.87 59.77 59.77 0 01-18.22 8.88L6 12zm0 0h7.5" /></svg>
        Send referral
      </a>
    </nav>

    <% if (notice) { %>
    <p id="networkStatus" class="mb-4 rounded-xl px-3 py-2 text-sm font-medium <%= noticeBad ? 'bg-amber-50 text-amber-950 dark:bg-amber-950/50 dark:text-amber-100' : 'bg-emerald-50 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100' %>" role="status"><%= notice %></p>
    <% } else { %>
    <p id="networkStatus" class="mb-4 hidden rounded-xl px-3 py-2 text-sm font-medium" role="status"></p>
    <% } %>

    <% if (tab === 'seats') { %>
      <% if (!zones.length) { %>
      <div class="net-card text-center py-10">
        <p class="text-sm text-brand-muted max-w-md mx-auto">Add your first zone (the cities and ZIP codes it covers) to see one seat per trade.</p>
        <a href="/network?tab=setup" class="net-btn net-btn-yellow mt-4">Add a zone</a>
      </div>
      <% } else { %>
      <% if (canManage) { %>
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <p class="text-[12px] text-brand-muted">Tap × on an open seat to hide a trade you don't need. Missing one? <a href="/network?tab=setup#net-add-trade" class="font-semibold underline">Add a trade</a>. Partners per trade: <a href="/network?tab=setup#netSeatLimit" class="font-semibold underline"><%= network.seatLimit || 'no limit' %></a>.</p>
        <% if (hiddenTrades.length) { %>
        <button type="button" id="netShowHidden" class="net-btn net-btn-ghost" aria-pressed="false" data-count="<%= hiddenTrades.length %>">Show hidden trades (<%= hiddenTrades.length %>)</button>
        <% } %>
      </div>
      <% } %>
      <div class="space-y-4">
        <% seatRows.forEach(function (row) { const held = row.seats.filter(function (s) { return s.holders.length; }).length; %>
        <section class="net-card">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-display font-bold text-lg"><%= row.zone.name %></h2>
            <p class="text-[11px] font-bold uppercase tracking-wide text-brand-muted"><%= held %> of <%= row.seats.length %> seats held</p>
          </div>
          <% if (row.zone.cities.length || row.zone.zips.length) { %>
          <p class="text-[12px] text-brand-muted mt-0.5 truncate"><%= row.zone.cities.join(' · ') %><% if (row.zone.zips.length) { %><%= row.zone.cities.length ? ' · ' : '' %><%= row.zone.zips.length %> ZIP<%= row.zone.zips.length === 1 ? '' : 's' %><% } %></p>
          <% } %>
          <div class="net-seats">
            <% row.seats.forEach(function (seat) { %>
            <% if (seat.holders.length || seat.waiting.length) { var partnerCount = seat.holders.length + seat.waiting.length; %>
            <div class="net-seat is-held">
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted truncate"><%= seat.trade.name %><%= partnerCount > 1 ? ' · ' + partnerCount : '' %></p>
              <% seat.holders.map(function (h) { return Object.assign({ waiting: false }, h); }).concat(seat.waiting.map(function (w) { return Object.assign({ waiting: true }, w); })).forEach(function (p) { %>
              <div class="net-seat-row">
                <% if (p.waiting) { %>
                <a href="<%= p.href %>" class="net-seat-holder is-waiting" title="<%= p.name %> picked this trade but the seat is full, so they don't get referrals yet. Open in Referral Partners."><span class="net-seat-name"><%= p.name %></span><span class="net-seat-wait">waiting</span></a>
                <% } else { %>
                <a href="<%= p.href %>" class="net-seat-holder <%= p.paused ? 'is-paused' : '' %>" title="Open <%= p.name %> in Referral Partners"><%= p.name %><%= p.paused ? ' (paused)' : '' %></a>
                <% } %>
                <% if (canManage) { %>
                <form method="post" action="/network/members/<%= p.id %>/trades/<%= seat.trade.slug %>/remove" class="net-seat-remove" onsubmit="return confirm(<%= JSON.stringify('Remove ' + p.name + ' from ' + seat.trade.name + (zones.length > 1 ? ' in every zone' : '') + '? They stay a network member.') %>);">
                  <input type="hidden" name="back" value="seats" />
                  <button type="submit" title="Remove <%= p.name %> from <%= seat.trade.name %>" aria-label="Remove <%= p.name %> from <%= seat.trade.name %>">×</button>
                </form>
                <% } %>
              </div>
              <% }); %>
              <% if (seat.waiting.length && canManage) { %>
              <form method="post" action="/network/setup" class="net-seat-allow">
                <input type="hidden" name="seatLimit" value="<%= partnerCount %>" />
                <input type="hidden" name="back" value="seats" />
                <button type="submit" title="Let up to <%= partnerCount %> partners share each trade so waiting members start getting referrals">Allow <%= partnerCount %> per trade</button>
              </form>
              <% } else if (!seat.full && canManage) { %>
              <a href="/network?tab=members&trade=<%= encodeURIComponent(seat.trade.slug) %>#net-add-member" class="net-seat-add">+ Add partner</a>
              <% } %>
            </div>
            <% } else { %>
            <div class="net-seat">
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted truncate <%= canManage ? 'pr-5' : '' %>"><%= seat.trade.name %></p>
              <a href="<%= seat.recruitUrl %>" class="text-[12px] font-semibold text-brand-muted hover:underline">Open · Recruit →</a>
              <% if (canManage) { %>
              <form method="post" action="/network/trades/<%= seat.trade.slug %>/toggle" class="net-seat-toggle">
                <input type="hidden" name="on" value="0" />
                <button type="submit" class="net-seat-x" title="Hide <%= seat.trade.name %> from the list<%= zones.length > 1 ? ' in every zone' : '' %>" aria-label="Hide <%= seat.trade.name %>">×</button>
              </form>
              <% } %>
            </div>
            <% } %>
            <% }); %>
            <% if (canManage) { hiddenTrades.forEach(function (t) { %>
            <div class="net-seat is-off" data-hidden-trade hidden>
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted truncate"><%= t.name %></p>
              <form method="post" action="/network/trades/<%= t.slug %>/toggle" class="net-seat-toggle">
                <input type="hidden" name="on" value="1" />
                <button type="submit" class="text-[12px] font-semibold text-brand-muted hover:underline">+ Add to list</button>
              </form>
            </div>
            <% }); } %>
          </div>
        </section>
        <% }); %>
      </div>
      <% } %>
    <% } %>

    <% if (tab === 'members') { %>
      <% if (canManage) { %>
      <details class="net-card net-more mb-4" id="net-add-member" <%= prefillLeadKey || prefillTrade || !members.length ? 'open' : '' %>>
        <summary class="flex items-center justify-between gap-2">
          <span class="font-display font-bold">Add a member</span>
          <span class="net-btn net-btn-ghost">From referral partners</span>
        </summary>
        <% if (!candidates.length) { %>
        <p class="mt-3 text-sm text-brand-muted">No referral partners to add. <a class="underline" href="/referrals">Add partners</a> first, then make them network members.</p>
        <% } else if (!zones.length) { %>
        <p class="mt-3 text-sm text-brand-muted"><a class="underline" href="/network?tab=setup">Add a zone</a> first so members can hold seats.</p>
        <% } else { %>
        <form method="post" action="/network/members" class="mt-3 space-y-3">
          <div>
            <label class="net-label" for="netMemberLead">Partner</label>
            <select id="netMemberLead" name="leadKey" class="net-input" required>
              <option value="">Pick a referral partner…</option>
              <% candidates.forEach(function (c) { %>
              <option value="<%= c.key %>" <%= c.key === prefillLeadKey ? 'selected' : '' %>><%= c.title %><%= c.where ? ' — ' + c.where : '' %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <span class="net-label">Trades</span>
            <div class="net-checks"><%- tradeChecks('trades', prefillTrade ? [prefillTrade] : []) %></div>
          </div>
          <div>
            <span class="net-label">Zones</span>
            <div class="net-checks"><%- zoneChecks('zoneIds', zones.length === 1 ? [zones[0].id] : []) %></div>
          </div>
          <button type="submit" class="net-btn net-btn-yellow">Add to network</button>
        </form>
        <% } %>
      </details>
      <% } %>

      <% if (!members.length) { %>
      <div class="net-card text-center py-10"><p class="text-sm text-brand-muted">No members yet.</p></div>
      <% } else { %>
      <div class="space-y-3">
        <% members.forEach(function (m) { %>
        <article class="net-card">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-base font-semibold truncate"><%= m.companyName %></p>
              <p class="text-[12px] text-brand-muted truncate"><%= [m.contactName, m.phone, m.email].filter(Boolean).join(' · ') || 'No contact on file' %></p>
            </div>
            <span class="flex shrink-0 items-center gap-1.5">
              <% if (!ghlSubaccounts) { %>
              <% } else if (m.ghlLocationId) { %>
              <a class="net-pill net-pill-sent no-underline" href="<%= m.ghlSubaccountUrl || '#' %>" target="_blank" rel="noopener" title="GHL sub-account <%= m.ghlLocationId %>">GHL ✓</a>
              <% } else if (m.ghlError) { %>
              <span class="net-pill net-pill-declined" title="<%= m.ghlError %>">GHL failed</span>
              <% } %>
              <span class="net-pill <%= m.status === 'active' ? 'net-pill-won' : '' %>"><%= m.status === 'active' ? 'Active' : 'Paused' %></span>
            </span>
          </div>
          <% if (ghlSubaccounts && !m.ghlLocationId && m.ghlError) { const needsAgencyKey = /not authorized for this scope|agency-level token/i.test(m.ghlError); %>
          <p class="mt-1 text-[12px] text-rose-700 dark:text-rose-300">
            <% if (needsAgencyKey) { %>GHL: your GHL key can't create sub-accounts — it needs an agency key. <a href="/workspace/integrations#ghl-integration" class="font-semibold underline">Add Agency API key</a>, then Retry.<% } else { %>GHL: <%= m.ghlError %><% } %>
          </p>
          <% } %>
          <p class="mt-2 text-[12px]"><span class="font-bold">Seats:</span> <%= m.seats.length ? m.seats.join(', ') : 'None — edit seats below' %></p>
          <div class="net-metrics">
            <div class="net-metric"><span>Received</span><strong><%= m.stats.received %></strong></div>
            <div class="net-metric"><span>Given</span><strong><%= m.stats.given %></strong></div>
            <div class="net-metric"><span>Open</span><strong><%= m.stats.open %></strong></div>
            <div class="net-metric"><span>Won</span><strong>$<%= Math.round(m.stats.wonValue).toLocaleString('en-US') %></strong></div>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button type="button" class="net-btn net-btn-ghost" data-net-copy-portal="<%= m.id %>" data-net-copy-kind="referral">Copy referral app</button>
            <button type="button" class="net-btn net-btn-ghost" data-net-copy-portal="<%= m.id %>" data-net-copy-kind="contractor">Copy contractor app</button>
            <form method="post" action="/network/members/<%= m.id %>/send-portal-link"><button type="submit" class="net-btn net-btn-ghost">Text referral app</button></form>
            <% if (canManage && ghlSubaccounts && !m.ghlLocationId) { %>
            <form method="post" action="/network/members/<%= m.id %>/ghl"><button type="submit" class="net-btn net-btn-ghost"><%= m.ghlError ? 'Retry GHL sub-account' : 'Create GHL sub-account' %></button></form>
            <% } %>
            <% if (canManage) { %>
            <form method="post" action="/network/members/<%= m.id %>/status">
              <input type="hidden" name="status" value="<%= m.status === 'active' ? 'paused' : 'active' %>" />
              <button type="submit" class="net-btn net-btn-ghost"><%= m.status === 'active' ? 'Pause' : 'Activate' %></button>
            </form>
            <form method="post" action="/network/members/<%= m.id %>/remove" onsubmit="return confirm(<%= JSON.stringify('Remove ' + m.companyName + ' from the network? Their seats open up, their app link stops working, and past referrals stay in your history.') %>);">
              <button type="submit" class="net-btn net-btn-danger">Remove from network</button>
            </form>
            <% } %>
          </div>
          <% if (canManage) { %>
          <details class="net-more mt-3">
            <summary class="text-[12px] font-bold text-brand-muted hover:underline">Edit trades &amp; zones</summary>
            <form method="post" action="/network/members/<%= m.id %>/seats" class="mt-2 space-y-3">
              <div><span class="net-label">Trades</span><div class="net-checks"><%- tradeChecks('trades', m.trades) %></div></div>
              <div><span class="net-label">Zones</span><div class="net-checks"><%- zoneChecks('zoneIds', m.zoneIds) %></div></div>
              <button type="submit" class="net-btn net-btn-yellow">Save seats</button>
            </form>
          </details>
          <details class="net-more mt-2">
            <summary class="text-[12px] font-bold text-brand-muted hover:underline">Review links (<%= m.reviewLinkCount ? m.reviewLinkCount + ' set' : 'none yet' %>)</summary>
            <form method="post" action="/network/members/<%= m.id %>/review-links" class="mt-2 space-y-3" autocomplete="off">
              <p class="text-[12px] text-brand-muted">Where <%= m.companyName %>'s customers can leave a review. These show as buttons on their review page<% if (m.reviewSlug) { %> (<a class="underline" href="/rv/<%= m.reviewSlug %>" target="_blank" rel="noopener">open it</a>)<% } %>. The member can also edit them in their app.</p>
              <div class="grid gap-3 sm:grid-cols-2">
                <% reviewPlatforms.forEach(function (p) { %>
                <div>
                  <label class="net-label flex items-center gap-1.5" for="rl-<%= m.id %>-<%= p.key %>"><span class="inline-flex h-4 w-4 items-center justify-center rounded text-[9px] font-black text-white" style="background: <%= p.color %>" aria-hidden="true"><%= p.letter %></span><%= p.label %></label>
                  <input id="rl-<%= m.id %>-<%= p.key %>" name="<%= p.key %>" type="url" inputmode="url" class="net-input" value="<%= (m.reviewLinks && m.reviewLinks[p.key]) || '' %>" placeholder="<%= p.placeholder %>" />
                </div>
                <% }); %>
              </div>
              <div>
                <span class="net-label">Other review sites</span>
                <div class="space-y-2">
                  <% m.reviewOtherRows.forEach(function (o, i) { %>
                  <div class="net-review-other">
                    <input name="otherLabel" class="net-input" value="<%= o.label %>" placeholder="Site name" maxlength="40" aria-label="Other site <%= i + 1 %> name" />
                    <input name="otherUrl" type="url" inputmode="url" class="net-input" value="<%= o.url %>" placeholder="https://" aria-label="Other site <%= i + 1 %> link" />
                  </div>
                  <% }); %>
                </div>
              </div>
              <button type="submit" class="net-btn net-btn-yellow">Save review links</button>
            </form>
          </details>
          <% } %>
        </article>
        <% }); %>
      </div>
      <% } %>
    <% } %>

    <% if (tab === 'referrals') { %>
      <div class="net-checks mb-3">
        <a href="/network?tab=referrals" class="net-tab <%= !statusFilter ? 'is-on' : '' %>">All</a>
        <% statuses.forEach(function (s) { if (!s.count && statusFilter !== s.id) return; %>
        <a href="/network?tab=referrals&status=<%= s.id %>" class="net-tab <%= statusFilter === s.id ? 'is-on' : '' %>"><%= s.label %> (<%= s.count %>)</a>
        <% }); %>
      </div>
      <% if (!referrals.length) { %>
      <div class="net-card text-center py-10">
        <p class="text-sm text-brand-muted">No referrals<%= statusFilter ? ' with that status' : ' yet' %>.</p>
        <a href="/network?tab=send" class="net-btn net-btn-yellow mt-4" data-open-send-referral>Send a referral</a>
      </div>
      <% } else { %>
      <div class="space-y-3">
        <% referrals.forEach(function (r) { const h = r.homeowner || {}; %>
        <article class="net-card">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-base font-semibold truncate"><%= r.trade %> · <%= h.name %></p>
              <p class="text-[12px] text-brand-muted truncate"><%= [h.phone, h.email, [h.city, h.zip].filter(Boolean).join(' ')].filter(Boolean).join(' · ') %></p>
              <p class="text-[12px] mt-0.5"><%= r.from %> → <%= r.to || 'unassigned' %><%= r.zone ? ' · ' + r.zone : '' %> · <%= r.when %></p>
            </div>
            <span class="net-pill net-pill-<%= r.status %>"><%= r.statusLabel %><%= r.value ? ' · ' + r.value : '' %></span>
          </div>
          <% if (r.reason) { %><p class="mt-2 text-[12px] text-rose-700 dark:text-rose-300"><%= r.reason %></p><% } %>
          <% if (r.note) { %><p class="mt-2 text-[13px]"><span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Note · </span><%= r.note %></p><% } %>
          <% if (r.lastEvent && r.lastEvent.type === 'note') { %><p class="mt-1 text-[12px] text-brand-muted">Latest: <%= r.lastEvent.text %></p><% } %>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <% r.actions.forEach(function (a) { if (a === 'win') return; %>
            <form method="post" action="/network/referrals/<%= r.id %>/action">
              <input type="hidden" name="action" value="<%= a %>" />
              <button type="submit" class="net-btn <%= a === 'decline' || a === 'lose' ? 'net-btn-danger' : 'net-btn-ghost' %>"><%= { accept: 'Accept', decline: 'Decline', book: 'Booked', lose: 'Lost' }[a] %></button>
            </form>
            <% }); %>
            <% if (r.actions.indexOf('win') >= 0) { %>
            <form method="post" action="/network/referrals/<%= r.id %>/action" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="win" />
              <input type="text" inputmode="decimal" name="value" placeholder="Job $" class="net-input" style="width: 6.5rem; padding: 0.4rem 0.6rem;" required />
              <button type="submit" class="net-btn net-btn-yellow">Won</button>
            </form>
            <% } %>
            <% if (r.canAssign && activeMembers.length) { %>
            <form method="post" action="/network/referrals/<%= r.id %>/action" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="assign" />
              <select name="toMemberId" class="net-input" style="width: auto; padding: 0.4rem 0.6rem;" required>
                <option value=""><%= r.status === 'sent' ? 'Reassign to…' : 'Assign to…' %></option>
                <% activeMembers.forEach(function (m) { if (m.id === r.fromMemberId || m.id === r.toMemberId) return; %>
                <option value="<%= m.id %>"><%= m.companyName %></option>
                <% }); %>
              </select>
              <button type="submit" class="net-btn net-btn-ghost">Assign</button>
            </form>
            <% } %>
          </div>
          <form method="post" action="/network/referrals/<%= r.id %>/action" class="mt-2 flex gap-2">
            <input type="hidden" name="action" value="note" />
            <input type="text" name="text" maxlength="500" placeholder="Add a note" class="net-input" />
            <button type="submit" class="net-btn net-btn-ghost shrink-0">Save note</button>
          </form>
        </article>
        <% }); %>
      </div>
      <% } %>
    <% } %>

    <% if (tab === 'send') { %>
      <form method="post" action="/network/referrals" class="net-card space-y-3 max-w-2xl">
        <h2 class="font-display font-bold text-lg">Send a referral</h2>
        <p class="text-[12px] text-brand-muted -mt-2">It goes to the member holding that trade seat in the homeowner's zone and they get a text to accept.</p>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label class="net-label" for="netSendTrade">Trade needed</label>
            <select id="netSendTrade" name="tradeSlug" class="net-input" required>
              <option value="">Pick a trade…</option>
              <% networkTrades.forEach(function (t) { %><option value="<%= t.slug %>"><%= t.name %></option><% }); %>
            </select>
          </div>
          <div>
            <label class="net-label" for="netSendZone">Zone</label>
            <select id="netSendZone" name="zoneId" class="net-input">
              <option value="">Auto from city / ZIP</option>
              <% zones.forEach(function (z) { %><option value="<%= z.id %>"><%= z.name %></option><% }); %>
            </select>
          </div>
          <div>
            <label class="net-label" for="netSendName">Homeowner name</label>
            <input id="netSendName" name="name" class="net-input" required autocomplete="off" />
          </div>
          <div>
            <label class="net-label" for="netSendPhone">Phone</label>
            <input id="netSendPhone" name="phone" type="tel" class="net-input" autocomplete="off" />
          </div>
          <div>
            <label class="net-label" for="netSendEmail">Email</label>
            <input id="netSendEmail" name="email" type="email" class="net-input" autocomplete="off" />
          </div>
          <div>
            <label class="net-label" for="netSendAddress">Street address</label>
            <input id="netSendAddress" name="address" class="net-input" autocomplete="off" />
          </div>
          <div>
            <label class="net-label" for="netSendCity">City</label>
            <input id="netSendCity" name="city" class="net-input" autocomplete="off" />
          </div>
          <div>
            <label class="net-label" for="netSendZip">ZIP</label>
            <input id="netSendZip" name="zip" inputmode="numeric" maxlength="10" class="net-input" autocomplete="off" />
          </div>
        </div>
        <div>
          <label class="net-label" for="netSendNote">What they need</label>
          <textarea id="netSendNote" name="note" rows="3" maxlength="1000" class="net-input" placeholder="e.g. AC not cooling, wants a quote this week"></textarea>
        </div>
        <label class="flex items-start gap-2 text-sm font-semibold">
          <input type="checkbox" name="consent" value="on" required class="mt-0.5" />
          The homeowner agreed to be contacted by a network member.
        </label>
        <button type="submit" class="net-btn net-btn-yellow">Send referral</button>
      </form>
    <% } %>

    <% if (tab === 'applications') { %>
      <p class="mb-3 text-[13px] text-brand-muted max-w-2xl">Businesses your members invited from the Enroll tab in their app. Approving adds them as a member, <%= ghlSubaccounts && network.autoGhlSubaccount ? 'creates their GHL sub-account, ' : '' %>and texts them their app link.</p>
      <% if (!applications.length) { %>
      <div class="net-card text-center py-10"><p class="text-sm text-brand-muted">No applications yet. Members can invite businesses from the Enroll tab in their app.</p></div>
      <% } else { %>
      <div class="space-y-3">
        <% applications.forEach(function (a) { %>
        <article class="net-card">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-base font-semibold truncate"><%= a.companyName %></p>
              <p class="text-[12px] text-brand-muted truncate"><%= [a.contactName, a.phone, a.email].filter(Boolean).join(' · ') %></p>
              <p class="text-[12px] mt-0.5"><%= [a.tradeLabel, a.city].filter(Boolean).join(' · ') %><%= a.invitedBy ? ' · invited by ' + a.invitedBy : '' %> · <%= a.when %></p>
            </div>
            <span class="net-pill <%= a.status === 'approved' ? 'net-pill-won' : (a.status === 'rejected' ? 'net-pill-declined' : 'net-pill-sent') %>"><%= a.status === 'pending' ? 'Waiting' : (a.status === 'approved' ? 'Approved' : 'Rejected') %></span>
          </div>
          <% if (a.note) { %><p class="mt-2 text-[13px]"><span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Note · </span><%= a.note %></p><% } %>
          <% if (a.status === 'pending' && canManage) { %>
          <form method="post" action="/network/applications/<%= a.id %>/approve" class="mt-3 space-y-3">
            <div><span class="net-label">Trades</span><div class="net-checks"><%- tradeChecks('trades', a.tradeSlug ? [a.tradeSlug] : []) %></div></div>
            <% if (zones.length) { %>
            <div><span class="net-label">Zones</span><div class="net-checks"><%- zoneChecks('zoneIds', a.suggestedZoneId ? [a.suggestedZoneId] : (zones.length === 1 ? [zones[0].id] : [])) %></div></div>
            <% } %>
            <div class="flex flex-wrap gap-2">
              <button type="submit" class="net-btn net-btn-yellow">Approve &amp; send app link</button>
              <button type="submit" formaction="/network/applications/<%= a.id %>/reject" class="net-btn net-btn-danger" onclick="return confirm('Reject this applicant?');">Reject</button>
            </div>
          </form>
          <% } else if (a.status === 'approved' && a.memberName) { %>
          <p class="mt-2 text-[12px] text-brand-muted">Now a member: <%= a.memberName %></p>
          <% } %>
        </article>
        <% }); %>
      </div>
      <% } %>
    <% } %>

    <% if (tab === 'brand') { %>
      <div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-5 items-start">
        <form method="post" action="/network/brand" enctype="multipart/form-data" class="net-card space-y-4" id="netBrandForm">
          <div>
            <h2 class="font-display font-bold text-lg">Member app branding</h2>
            <p class="text-[12px] text-brand-muted">Members see this in their referral app, on their review page, and as the Home Screen icon.</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            <div>
              <label class="net-label" for="brAppName">App name</label>
              <input id="brAppName" name="appName" value="<%= network.brand.appName %>" placeholder="<%= network.name %>" maxlength="60" class="net-input" data-br="appName" />
            </div>
            <div>
              <label class="net-label" for="brSubtitle">Subtitle</label>
              <input id="brSubtitle" name="subtitle" value="<%= network.brand.subtitle %>" placeholder="Authorized Nationwide Network" maxlength="80" class="net-input" data-br="subtitle" />
            </div>
            <div class="sm:col-span-2">
              <label class="net-label" for="brTagline">Greeting line</label>
              <input id="brTagline" name="tagline" value="<%= network.brand.tagline %>" placeholder="Every referral makes a difference." maxlength="120" class="net-input" data-br="tagline" />
            </div>
            <div>
              <label class="net-label" for="brAccent">Accent color</label>
              <div class="flex items-center gap-2">
                <input type="color" id="brAccentPick" value="<%= brand.accent %>" class="net-swatch" aria-label="Pick accent color" />
                <input id="brAccent" name="accent" value="<%= brand.accent %>" maxlength="7" class="net-input" data-br="accent" />
              </div>
            </div>
            <div>
              <label class="net-label" for="brStatValue">Headline number</label>
              <input id="brStatValue" name="statValue" value="<%= network.brand.statValue %>" inputmode="numeric" placeholder="846429" class="net-input" data-br="statValue" />
            </div>
            <div>
              <label class="net-label" for="brStatLabel">Number label</label>
              <input id="brStatLabel" name="statLabel" value="<%= network.brand.statLabel %>" placeholder="Homes serviced" maxlength="40" class="net-input" data-br="statLabel" />
            </div>
            <div>
              <label class="net-label" for="brStatSuffix">Small note next to number</label>
              <input id="brStatSuffix" name="statSuffix" value="<%= network.brand.statSuffix %>" placeholder="and growing" maxlength="30" class="net-input" data-br="statSuffix" />
            </div>
          </div>
          <% [['logo', 'Logo', 'Square works best. Also used as the app icon.'], ['hero', 'Hero photo', 'Wide photo for the top of Home (e.g. your truck or team).']].forEach(function (img) { var k = img[0]; var cur = network.brand[k + 'Url']; var uploaded = cur && cur.indexOf('/m/brand/') === 0; %>
          <div class="rounded-xl border border-brand-border dark:border-white/10 p-3 space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="net-label" style="margin:0"><%= img[1] %></span>
              <% if (cur) { %><img src="<%= cur %>" alt="" class="h-10 <%= k === 'hero' ? 'w-16 object-cover' : 'w-10 object-contain' %> rounded-lg bg-slate-100" /><% } %>
            </div>
            <p class="text-[12px] text-brand-muted"><%= img[2] %></p>
            <input type="file" name="<%= k %>" accept="image/png,image/jpeg,image/webp,image/gif" class="net-file" />
            <input name="<%= k %>Url" value="<%= uploaded ? '' : (cur || '') %>" placeholder="…or paste an https:// image URL" class="net-input" />
            <% if (cur) { %><label class="flex items-center gap-2 text-[12px] font-semibold"><input type="checkbox" name="remove_<%= k %>" value="on" /> Remove <%= img[1].toLowerCase() %></label><% } %>
          </div>
          <% }); %>
          <button type="submit" class="net-btn net-btn-yellow">Save branding</button>
        </form>

        <aside class="lg:sticky lg:top-24">
          <p class="net-label">Preview</p>
          <style>
            /* iPhone 15-style frame. The screen is the real member Home page at 390×844, scaled to fit. */
            .br-phone { --s: 0.759; position: relative; width: 320px; margin: 0 auto; padding: 12px; border-radius: 56px;
              background: linear-gradient(145deg, #3a3a3d, #1b1b1d 45%, #2c2c2f); box-shadow: inset 0 0 0 1.5px #4a4a4e, inset 0 0 0 4px #121214, 0 30px 60px -20px rgba(15, 23, 42, 0.45), 0 12px 24px -12px rgba(15, 23, 42, 0.3); }
            .br-phone__btn { position: absolute; width: 4px; border-radius: 2px; background: linear-gradient(90deg, #2a2a2d, #4a4a4e); }
            .br-phone__btn--action { left: -3px; top: 104px; height: 28px; }
            .br-phone__btn--up { left: -3px; top: 150px; height: 52px; }
            .br-phone__btn--down { left: -3px; top: 212px; height: 52px; }
            .br-phone__btn--side { right: -3px; top: 172px; height: 84px; background: linear-gradient(270deg, #2a2a2d, #4a4a4e); }
            .br-phone__screen { position: relative; width: 296px; height: 641px; border-radius: 44px; overflow: hidden; background: #f2f2f7; isolation: isolate; clip-path: inset(0 round 44px); }
            .br-phone__viewport { position: absolute; top: 0; left: 0; width: 390px; height: 844px; transform: scale(var(--s)); transform-origin: 0 0; border-radius: 58px; overflow: hidden; }
            .br-phone__viewport iframe { display: block; width: 390px; height: 844px; border: 0; border-radius: 58px; background: transparent; }
            .br-phone__status { position: absolute; top: 0; left: 0; right: 0; height: 54px; display: flex; align-items: center; justify-content: space-between; padding: 6px 30px 0 52px; pointer-events: none; color: #000;
              font: 600 17px/1 -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, sans-serif; letter-spacing: -0.02em; }
            .br-phone__status svg { display: block; fill: currentColor; }
            .br-phone__icons { display: flex; align-items: center; gap: 6px; }
            .br-phone__island { position: absolute; top: 11px; left: 50%; width: 125px; height: 37px; margin-left: -62.5px; border-radius: 20px; background: #000; pointer-events: none; }
            .br-phone__home { position: absolute; bottom: 8px; left: 50%; width: 139px; height: 5px; margin-left: -69.5px; border-radius: 3px; background: #000; pointer-events: none; }
            .br-phone__loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 600 13px/1 -apple-system, Inter, sans-serif; color: #8e8e93; }
            @media (prefers-color-scheme: dark) {
              .br-phone__screen { background: #000; }
              .br-phone__status { color: #fff; }
              .br-phone__home { background: #fff; }
            }
          </style>
          <div class="br-phone" id="brPhone" style="--acc: <%= brand.accent %>;">
            <span class="br-phone__btn br-phone__btn--action" aria-hidden="true"></span>
            <span class="br-phone__btn br-phone__btn--up" aria-hidden="true"></span>
            <span class="br-phone__btn br-phone__btn--down" aria-hidden="true"></span>
            <span class="br-phone__btn br-phone__btn--side" aria-hidden="true"></span>
            <div class="br-phone__screen">
              <div class="br-phone__loading">Loading preview…</div>
              <div class="br-phone__viewport">
                <iframe id="brPreviewFrame" src="/network/brand/preview" title="Member app preview" loading="lazy" tabindex="-1"></iframe>
                <div class="br-phone__status" aria-hidden="true">
                  <span>9:41</span>
                  <span class="br-phone__icons">
                    <svg width="19" height="12" viewBox="0 0 19 12"><rect x="0" y="7.5" width="3.2" height="4.5" rx="1"/><rect x="5" y="5" width="3.2" height="7" rx="1"/><rect x="10" y="2.5" width="3.2" height="9.5" rx="1"/><rect x="15" y="0" width="3.2" height="12" rx="1"/></svg>
                    <svg width="17" height="12" viewBox="0 0 17 12"><path d="M8.5 2.4c2.3 0 4.4.9 6 2.4l1.2-1.2A10.2 10.2 0 0 0 8.5.7 10.2 10.2 0 0 0 1.3 3.6l1.2 1.2a8.5 8.5 0 0 1 6-2.4Zm0 3.4c1.4 0 2.6.5 3.6 1.4l1.2-1.2a6.8 6.8 0 0 0-9.6 0l1.2 1.2c1-.9 2.2-1.4 3.6-1.4Zm0 3.4c.5 0 1 .2 1.3.5L8.5 11 7.2 9.7c.3-.3.8-.5 1.3-.5Z"/></svg>
                    <svg width="27" height="13" viewBox="0 0 27 13"><rect x="0.5" y="0.5" width="23" height="12" rx="3.8" fill="none" stroke="currentColor" stroke-opacity="0.38"/><rect x="2" y="2" width="20" height="9" rx="2.5"/><path d="M25 4.5v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill-opacity="0.4"/></svg>
                  </span>
                </div>
                <div class="br-phone__island" aria-hidden="true"></div>
                <div class="br-phone__home" aria-hidden="true"></div>
              </div>
            </div>
          </div>
          <p class="mt-3 text-center text-[11px] text-brand-muted">The real member app with sample numbers. Changes show here before you save.</p>
        </aside>
      </div>
    <% } %>

    <% if (tab === 'setup') { %>
      <div class="space-y-4 max-w-3xl">
        <% if (canManage) { %>
        <form method="post" action="/network/setup" class="net-card space-y-3">
          <h2 class="font-display font-bold text-lg">Network</h2>
          <div>
            <label class="net-label" for="netName">Name</label>
            <input id="netName" name="name" value="<%= network.name %>" class="net-input" maxlength="120" required />
          </div>
          <details class="net-more">
            <summary class="text-[12px] font-bold text-brand-muted hover:underline">Trades in this network (<%= network.trades.length %> of <%= allTrades.length %> on)</summary>
            <div class="net-checks mt-2">
              <% allTrades.forEach(function (t) { %>
              <label class="net-check"><input type="checkbox" name="trades" value="<%= t.slug %>" <%= network.trades.indexOf(t.slug) >= 0 ? 'checked' : '' %> /><%= t.name %></label>
              <% }); %>
            </div>
          </details>
          <div>
            <label class="net-label" for="netSeatLimit">Partners per trade in each zone</label>
            <select id="netSeatLimit" name="seatLimit" class="net-input" style="max-width: 20rem;">
              <% [[1, '1 — exclusive seat'], [2, '2'], [3, '3'], [4, '4'], [5, '5'], [10, '10'], [0, 'No limit']].forEach(function (o) { %>
              <option value="<%= o[0] %>" <%= network.seatLimit === o[0] ? 'selected' : '' %>><%= o[1] %></option>
              <% }); %>
            </select>
            <p class="text-[12px] text-brand-muted mt-1">With more than one, referrals rotate to the partner who was sent one least recently. Lowering it keeps current partners.</p>
          </div>
          <% if (ghlSubaccounts) { %>
          <input type="hidden" name="ghlToggle" value="1" />
          <label class="flex items-start gap-2 text-sm font-semibold">
            <input type="checkbox" name="autoGhlSubaccount" value="on" class="mt-0.5" <%= network.autoGhlSubaccount ? 'checked' : '' %> />
            <span>Create a GHL sub-account for each new member <span class="block text-[12px] font-normal text-brand-muted">Uses the agency key, company ID and snapshot from Workspace → Integrations.</span></span>
          </label>
          <% } %>
          <button type="submit" class="net-btn net-btn-yellow">Save</button>
        </form>

        <section class="net-card space-y-3" id="net-add-trade">
          <div>
            <h2 class="font-display font-bold text-lg">Add a trade</h2>
            <p class="text-[12px] text-brand-muted">Missing a category? Add it and it gets one seat in every zone. The search words are what "Recruit" looks up in Find leads.</p>
          </div>
          <form method="post" action="/network/trades" class="net-trade-form">
            <div>
              <label class="net-label" for="netTradeName">Trade name</label>
              <input id="netTradeName" name="name" class="net-input" maxlength="40" placeholder="e.g. Interior designers" required />
            </div>
            <div>
              <label class="net-label" for="netTradeKeyword">Search words <span class="normal-case tracking-normal font-semibold">(optional)</span></label>
              <input id="netTradeKeyword" name="keyword" class="net-input" maxlength="80" placeholder="e.g. interior designer" />
            </div>
            <button type="submit" class="net-btn net-btn-yellow">Add trade</button>
          </form>
          <% if (customTrades.length) { %>
          <div>
            <span class="net-label">Your custom trades (<%= customTrades.length %> of <%= maxCustomTrades %>)</span>
            <ul class="rounded-xl border border-brand-border/60 dark:border-white/10">
              <% customTrades.forEach(function (t, i) { %>
              <li class="flex items-center justify-between gap-3 px-3 py-2 <%= i ? 'border-t border-brand-border/40 dark:border-white/10' : '' %>">
                <div class="min-w-0">
                  <p class="text-sm font-semibold truncate"><%= t.name %><% if (network.trades.indexOf(t.slug) < 0) { %> <span class="net-pill">Off</span><% } %></p>
                  <p class="text-[11px] text-brand-muted truncate">Searches “<%= t.keyword %>”<%= t.seatsHeld ? ' · ' + t.seatsHeld + ' seat' + (t.seatsHeld === 1 ? '' : 's') + ' held' : '' %></p>
                </div>
                <form method="post" action="/network/trades/<%= t.slug %>/delete" onsubmit="return confirm('Remove <%= t.name.replace(/'/g, '') %> from the network?');">
                  <button type="submit" class="net-btn net-btn-ghost" <%= t.seatsHeld ? 'disabled title="A member holds this seat. Edit their trades first."' : '' %>>Remove</button>
                </form>
              </li>
              <% }); %>
            </ul>
          </div>
          <% } %>
        </section>
        <% } %>

        <section class="net-card space-y-3">
          <h2 class="font-display font-bold text-lg">Zones</h2>
          <p class="text-[12px] text-brand-muted -mt-2">A zone is a service area. Each trade has one seat per zone. Referrals match a zone by ZIP first, then city.</p>
          <% zones.forEach(function (z) { %>
          <details class="net-more rounded-xl border border-brand-border dark:border-white/10 p-3" <%= editZoneId === z.id ? 'open' : '' %>>
            <summary class="flex items-center justify-between gap-2">
              <span class="font-semibold"><%= z.name %></span>
              <span class="text-[11px] text-brand-muted"><%= z.cities.length %> cities · <%= z.zips.length %> ZIPs</span>
            </summary>
            <% if (canManage) { %>
            <form method="post" action="/network/zones" class="mt-3 space-y-2">
              <input type="hidden" name="id" value="<%= z.id %>" />
              <input name="name" value="<%= z.name %>" class="net-input" required />
              <textarea name="cities" rows="3" class="net-input" placeholder="One city per line, e.g. Austin, TX"><%= z.cities.join('\n') %></textarea>
              <textarea name="zips" rows="2" class="net-input" placeholder="ZIP codes, separated by spaces or commas"><%= z.zips.join(', ') %></textarea>
              <div class="flex gap-2">
                <button type="submit" class="net-btn net-btn-yellow">Save zone</button>
              </div>
            </form>
            <form method="post" action="/network/zones/<%= z.id %>/delete" class="mt-2" onsubmit="return confirm('Remove this zone and its seats?');">
              <button type="submit" class="net-btn net-btn-danger">Remove zone</button>
            </form>
            <% } %>
          </details>
          <% }); %>
          <% if (canManage) { %>
          <form method="post" action="/network/zones" class="rounded-xl border border-dashed border-brand-border dark:border-white/15 p-3 space-y-2">
            <p class="font-semibold text-sm">Add a zone</p>
            <input name="name" placeholder="Zone name, e.g. Austin North" class="net-input" required />
            <textarea name="cities" rows="3" class="net-input" placeholder="One city per line, e.g. Austin, TX"></textarea>
            <textarea name="zips" rows="2" class="net-input" placeholder="ZIP codes, separated by spaces or commas"></textarea>
            <button type="submit" class="net-btn net-btn-yellow">Add zone</button>
          </form>
          <% } %>
        </section>
      </div>
    <% } %>
  </main>
  <script>
    (function () {
      var status = document.getElementById('networkStatus');
      function say(text, ok) {
        if (!status) return;
        status.textContent = text;
        status.className = 'mb-4 rounded-xl px-3 py-2 text-sm font-medium ' + (ok
          ? 'bg-emerald-50 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100'
          : 'bg-amber-50 text-amber-950 dark:bg-amber-950/50 dark:text-amber-100');
      }
      document.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-net-copy-portal]');
        if (!btn) return;
        var id = btn.getAttribute('data-net-copy-portal');
        btn.disabled = true;
        var kind = btn.getAttribute('data-net-copy-kind') || 'referral';
        fetch('/network/members/' + encodeURIComponent(id) + '/portal-link', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            btn.disabled = false;
            var url = kind === 'contractor' ? (data && data.contractorUrl) : (data && (data.referralUrl || data.url));
            if (!url) {
              say(
                kind === 'contractor'
                  ? 'No contractor app yet — sell them an appointment package on Today (tag trade e.g. Electrician) first.'
                  : ((data && data.error) || 'Could not build that link.'),
                false,
              );
              return;
            }
            var label = kind === 'contractor' ? 'Contractor app link copied.' : 'Referral app link copied.';
            var done = function () { say(label, true); };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(done).catch(function () { window.prompt('Copy the app link:', url); });
            } else {
              window.prompt('Copy the app link:', url);
            }
          })
          .catch(function () { btn.disabled = false; say('Could not build that link.', false); });
      });

      var brandForm = document.getElementById('netBrandForm');
      var frame = document.getElementById('brPreviewFrame');
      if (brandForm && frame) {
        var pick = document.getElementById('brAccentPick');
        var accentInput = document.getElementById('brAccent');
        var fallbacks = { appName: <%- JSON.stringify(network.name).replace(/</g, '\\u003c') %>, tagline: 'Every referral makes a difference.', subtitle: 'Referral partner network' };
        var saved = <%- JSON.stringify({ logo: brand.logoUrl || '', hero: brand.heroUrl || '' }).replace(/</g, '\\u003c') %>;
        var blobs = { logo: '', hero: '' };
        var badgeIcon = '';
        function onAccent(hex) {
          var m = /^#?([0-9a-f]{6})$/i.exec(hex || '');
          if (!m) return '#ffffff';
          var lum = [0, 2, 4].map(function (i) {
            var c = parseInt(m[1].slice(i, i + 2), 16) / 255;
            return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
          });
          var l = 0.2126 * lum[0] + 0.7152 * lum[1] + 0.0722 * lum[2];
          return 1.05 / (l + 0.05) >= 2.9 ? '#ffffff' : '#0f172a';
        }
        function field(name) {
          var el = brandForm.elements[name];
          return el && typeof el.value === 'string' ? el.value.trim() : '';
        }
        function imageFor(kind) {
          var remove = brandForm.elements['remove_' + kind];
          if (remove && remove.checked) return '';
          if (blobs[kind]) return blobs[kind];
          var url = field(kind + 'Url');
          if (/^https:\/\/\S+$/i.test(url)) return url;
          return url ? '' : saved[kind];
        }
        function setText(doc, sel, text) {
          var el = doc.querySelector(sel);
          if (el) el.textContent = text;
        }
        function sync() {
          var doc;
          try { doc = frame.contentDocument; } catch (e) { return; }
          if (!doc || !doc.querySelector('.ma-hero')) return;
          var root = doc.documentElement;

          var accent = field('accent');
          if (/^#[0-9a-f]{6}$/i.test(accent)) {
            root.style.setProperty('--acc', accent);
            root.style.setProperty('--on', onAccent(accent));
            document.getElementById('brPhone').style.setProperty('--acc', accent);
          }

          var tagline = doc.querySelector('.ma-hello p');
          if (tagline) {
            var words = (field('tagline') || fallbacks.tagline).split(/\s+/);
            var count = words.length >= 5 ? 3 : (words.length > 2 ? 2 : 0);
            tagline.textContent = count ? words.slice(0, -count).join(' ') + ' ' : words.join(' ');
            if (count) {
              var em = doc.createElement('em');
              em.textContent = words.slice(-count).join(' ');
              tagline.appendChild(em);
            }
          }

          var appName = field('appName') || fallbacks.appName;
          setText(doc, '.ma-hero__name', appName);
          setText(doc, '.ma-hero__sub', field('subtitle') || fallbacks.subtitle);
          doc.title = appName;

          var card = doc.querySelector('.ma-hero__card');
          if (card) {
            card.querySelectorAll('.ma-hero__stat, .ma-hero__label').forEach(function (el) { el.remove(); });
            var raw = field('statValue');
            var n = Number(raw.replace(/[^0-9.]/g, ''));
            var stat = doc.createElement('p');
            stat.className = 'ma-hero__stat';
            var small = doc.createElement('small');
            var label = doc.createElement('p');
            label.className = 'ma-hero__label';
            if (raw && isFinite(n)) {
              stat.textContent = Math.round(n).toLocaleString('en-US');
              small.textContent = field('statSuffix');
              label.textContent = field('statLabel');
            } else {
              stat.textContent = '8';
              small.textContent = 'jobs completed';
              label.textContent = '$12,400 won from referrals';
            }
            if (small.textContent) stat.appendChild(small);
            card.appendChild(stat);
            if (label.textContent) card.appendChild(label);
          }

          var hero = doc.querySelector('.ma-hero');
          var heroImg = hero.querySelector('.ma-hero__img');
          var heroUrl = imageFor('hero');
          if (heroUrl) {
            if (!heroImg) {
              heroImg = doc.createElement('img');
              heroImg.className = 'ma-hero__img';
              heroImg.alt = '';
              hero.insertBefore(heroImg, hero.firstChild);
            }
            if (heroImg.getAttribute('src') !== heroUrl) heroImg.src = heroUrl;
          } else if (heroImg) {
            heroImg.remove();
          }

          var logoUrl = imageFor('logo');
          var badge = doc.querySelector('.ma-hero__badge');
          if (badge) {
            if (logoUrl) {
              var bImg = badge.querySelector('img');
              if (!bImg) { badge.textContent = ''; bImg = doc.createElement('img'); bImg.alt = ''; badge.appendChild(bImg); }
              if (bImg.getAttribute('src') !== logoUrl) bImg.src = logoUrl;
            } else if (badge.querySelector('img')) {
              badge.innerHTML = badgeIcon;
            }
          }
          var brandBox = doc.querySelector('.ma-top__brand');
          var topLogo = doc.querySelector('.ma-top__logo');
          if (logoUrl && brandBox) {
            if (!topLogo) {
              topLogo = doc.createElement('img');
              topLogo.className = 'ma-top__logo';
              topLogo.alt = '';
              brandBox.insertBefore(topLogo, brandBox.firstChild);
            }
            if (topLogo.getAttribute('src') !== logoUrl) topLogo.src = logoUrl;
          } else if (topLogo) {
            topLogo.remove();
          }
        }
        frame.addEventListener('load', function () {
          var doc;
          try { doc = frame.contentDocument; } catch (e) { return; }
          if (!doc) return;
          // Preview only: links and buttons inside the phone do nothing.
          doc.addEventListener('click', function (e) { e.preventDefault(); }, true);
          doc.addEventListener('submit', function (e) { e.preventDefault(); }, true);
          var iconTpl = doc.getElementById('maBadgeIcon');
          badgeIcon = iconTpl ? iconTpl.innerHTML : '';
          var loading = frame.closest('.br-phone__screen').querySelector('.br-phone__loading');
          if (loading) loading.remove();
          sync();
        });
        ['logo', 'hero'].forEach(function (kind) {
          var input = brandForm.elements[kind];
          if (!input || input.type !== 'file') return;
          input.addEventListener('change', function () {
            if (blobs[kind]) URL.revokeObjectURL(blobs[kind]);
            var file = input.files && input.files[0];
            blobs[kind] = file && /^image\//.test(file.type) ? URL.createObjectURL(file) : '';
            sync();
          });
        });
        if (pick && accentInput) {
          pick.addEventListener('input', function () { accentInput.value = pick.value; sync(); });
          accentInput.addEventListener('input', function () { if (/^#[0-9a-f]{6}$/i.test(accentInput.value.trim())) pick.value = accentInput.value.trim(); });
        }
        brandForm.addEventListener('input', sync);
        brandForm.addEventListener('change', sync);
      }
    })();
    (function () {
      var toggle = document.getElementById('netShowHidden');
      if (toggle) {
        var key = 'net:showHiddenTrades';
        var apply = function (on) {
          document.querySelectorAll('[data-hidden-trade]').forEach(function (el) { el.hidden = !on; });
          toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
          toggle.textContent = (on ? 'Hide' : 'Show') + ' hidden trades (' + toggle.getAttribute('data-count') + ')';
        };
        var stored = false;
        try { stored = localStorage.getItem(key) === '1'; } catch (e) { /* private mode */ }
        apply(stored);
        toggle.addEventListener('click', function () {
          var on = toggle.getAttribute('aria-pressed') !== 'true';
          try { localStorage.setItem(key, on ? '1' : '0'); } catch (e) { /* private mode */ }
          apply(on);
        });
      }
      var status = document.getElementById('networkStatus');
      document.querySelectorAll('form.net-seat-toggle').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = form.querySelector('button');
          if (btn) btn.disabled = true;
          fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            body: new URLSearchParams(new FormData(form)).toString(),
          })
            .then(function (r) { return r.json().catch(function () { return {}; }); })
            .then(function (data) {
              if (data && data.success) { window.location.reload(); return; }
              if (btn) btn.disabled = false;
              if (status) {
                status.textContent = (data && (data.error || data.notice)) || 'Could not update that trade.';
                status.className = 'mb-4 rounded-xl px-3 py-2 text-sm font-medium bg-amber-50 text-amber-950 dark:bg-amber-950/50 dark:text-amber-100';
                status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
              }
            })
            .catch(function () { if (btn) btn.disabled = false; });
        });
      });
    })();
  </script>
  <%- include('partials/footer') %>
</body>
</html>
