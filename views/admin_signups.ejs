<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Signups & trials' }) %>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>
  <style>
    .su-pill { display: inline-flex; align-items: center; border-radius: 9999px; padding: 0.15rem 0.6rem; font-size: 10.5px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
    .su-pill.trial { background: #FEF3C7; color: #92400E; }
    .su-pill.expired { background: #FEE2E2; color: #991B1B; }
    .su-pill.active { background: #DCFCE7; color: #166534; }
    .su-pill.none { background: #E2E8F0; color: #334155; }
    .su-dl { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.3rem 0.75rem; font-size: 13px; }
    .su-dl dt { color: var(--brand-muted); font-size: 10.5px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; padding-top: 0.15rem; }
    .su-dl dd { min-width: 0; overflow-wrap: anywhere; }
    .su-meter { height: 0.4rem; border-radius: 9999px; background: rgba(17,24,39,0.08); overflow: hidden; }
    .su-meter > span { display: block; height: 100%; background: #EAB308; }
    .su-meter > span.full { background: #DC2626; }
    .su-actions input[type=number] { width: 5.5rem; }
    .su-actions select, .su-actions input { border-radius: 0.75rem; border: 1px solid var(--brand-border); background: #fff; padding: 0.45rem 0.6rem; font-size: 13px; }
    .dark .su-actions select, .dark .su-actions input { background: #0f172a; border-color: rgba(255,255,255,0.1); color: #fff; }
    .su-card:target { box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.6); }
  </style>

  <main class="max-wide px-6 py-10 md:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <h1 class="font-display font-black text-2xl md:text-3xl text-brand-dark dark:text-white mb-2">Signups &amp; trials</h1>
        <p class="text-sm text-brand-muted max-w-2xl">Everyone who started a free trial. Trials last <%= defaults.days %> days, can use your scraper and AI keys up to <%= defaults.paidCallsPerDay %> lead-search calls and <%= defaults.aiCallsPerDay %> AI calls a day, and can't text, email or call from your accounts.</p>
      </div>
      <div class="flex flex-wrap gap-2 text-center">
        <div class="rounded-xl bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 px-4 py-2"><p class="text-xl font-black"><%= counts.total %></p><p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Signups</p></div>
        <div class="rounded-xl bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 px-4 py-2"><p class="text-xl font-black"><%= counts.trial %></p><p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">On trial</p></div>
        <div class="rounded-xl bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 px-4 py-2"><p class="text-xl font-black"><%= counts.expired %></p><p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Ended</p></div>
        <div class="rounded-xl bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 px-4 py-2"><p class="text-xl font-black"><%= counts.active %></p><p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Active</p></div>
      </div>
    </div>

    <section class="brand-card p-5 md:p-6 mb-6 dark:bg-slate-900 dark:border-white/10">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Signup link</p>
      <div class="flex flex-col sm:flex-row gap-2">
        <input id="signupLink" readonly value="<%= signupUrl %>" class="flex-1 min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800 px-4 py-3 text-sm font-semibold" onclick="this.select()" />
        <button type="button" id="signupCopy" class="btn-pill btn-primary px-6 py-3 text-xs font-black uppercase tracking-widest">Copy</button>
      </div>
      <p class="mt-2 text-xs text-brand-muted">Put this on your site or send it to anyone. To add someone to one of your own workspaces instead, use Workspace → Team → Invite.</p>
    </section>

    <% if (flash) { %>
      <p class="mb-4 rounded-xl px-4 py-2.5 text-sm <%= flashError ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-emerald-50 border border-emerald-200 text-emerald-800' %>"><%= flash %></p>
    <% } %>

    <% if (!rows.length) { %>
      <p class="text-sm text-brand-muted">No signups yet.</p>
    <% } %>

    <div class="grid gap-4 lg:grid-cols-2">
      <% rows.forEach(function (r) { %>
        <% const st = r.status; const ws = r.workspace; %>
        <% const stateLabel = !st ? 'No workspace' : st.state === 'trial' ? (st.daysLeft + (st.daysLeft === 1 ? ' day left' : ' days left')) : st.state === 'expired' ? 'Trial ended' : 'Active'; %>
        <article id="ws-<%= r.workspaceId %>" class="su-card brand-card p-5 md:p-6 dark:bg-slate-900 dark:border-white/10 min-w-0">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="min-w-0">
              <h2 class="font-display font-black text-lg text-brand-dark dark:text-white truncate"><%= r.company || (ws && ws.name) || r.email %></h2>
              <p class="text-xs text-brand-muted">Signed up <time datetime="<%= r.createdAt %>"><%= new Date(r.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></time><% if (ws) { %> &middot; <%= ws.memberCount %> member<%= ws.memberCount === 1 ? '' : 's' %><% } %></p>
            </div>
            <span class="su-pill <%= st ? st.state : 'none' %>"><%= stateLabel %></span>
          </div>

          <dl class="su-dl">
            <dt>Name</dt><dd><%= r.name || r.googleName || '—' %></dd>
            <dt>Email</dt><dd><a class="underline underline-offset-2" href="mailto:<%= r.email %>"><%= r.email %></a></dd>
            <dt>Phone</dt><dd><% if (r.phone) { %><a class="underline underline-offset-2" href="tel:<%= r.phone.replace(/[^\d+]/g, '') %>"><%= r.phone %></a><% } else { %>—<% } %></dd>
            <dt>Website</dt><dd><% if (r.website) { %><a class="underline underline-offset-2" href="<%= r.website %>" target="_blank" rel="noopener"><%= r.website.replace(/^https?:\/\//, '') %></a><% } else { %>—<% } %></dd>
            <dt>Niche</dt><dd><%= r.niche || '—' %></dd>
            <dt>Team size</dt><dd><%= r.teamSize || '—' %></dd>
            <dt>Heard from</dt><dd><%= r.source || '—' %><%= r.sourceOther ? ' (' + r.sourceOther + ')' : '' %></dd>
            <dt>Workspace</dt><dd><%= ws ? ws.name : '—' %><% if (ws && ws.slug) { %> <span class="text-brand-muted">/<%= ws.slug %></span><% } %></dd>
            <% if (st) { %><dt>Trial ends</dt><dd><%= new Date(st.endsAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></dd><% } %>
          </dl>

          <% if (st) { %>
            <div class="grid grid-cols-2 gap-3 mt-4">
              <% [['Lead search today', r.usage.paid, st.limits.paidCallsPerDay], ['AI today', r.usage.ai, st.limits.aiCallsPerDay]].forEach(function (m) { const pct = st.state === 'active' ? 0 : Math.min(100, Math.round((m[1] / Math.max(1, m[2])) * 100)); %>
                <div>
                  <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1"><%= m[0] %> <span class="font-bold normal-case tracking-normal"><%= m[1] %><%= st.state === 'active' ? '' : ' / ' + m[2] %></span></p>
                  <div class="su-meter"><span class="<%= pct >= 100 ? 'full' : '' %>" style="width: <%= pct %>%"></span></div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <% if (ws) { %>
            <div class="su-actions mt-5 pt-4 border-t border-brand-border dark:border-white/10 flex flex-col gap-3">
              <div class="flex flex-wrap gap-2">
                <form method="post" action="/admin/signups/<%= ws.id %>/open">
                  <button type="submit" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest" title="Join as admin and open Integrations to add scraper / API keys">Add API keys</button>
                </form>
                <form method="post" action="/admin/signups/<%= ws.id %>/open">
                  <input type="hidden" name="next" value="today" />
                  <button type="submit" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Open workspace</button>
                </form>
                <% if (st && st.state !== 'active') { %>
                  <form method="post" action="/admin/signups/<%= ws.id %>/trial" onsubmit="return confirm('Activate this workspace? Trial limits and the end date stop applying.');">
                    <input type="hidden" name="action" value="activate" />
                    <button type="submit" class="btn-pill bg-white dark:bg-slate-900 border border-emerald-300 dark:border-emerald-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-emerald-700 dark:text-emerald-300">Activate (paid)</button>
                  </form>
                <% } else if (st) { %>
                  <form method="post" action="/admin/signups/<%= ws.id %>/trial">
                    <input type="hidden" name="action" value="deactivate" />
                    <button type="submit" class="btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Back to trial</button>
                  </form>
                <% } %>
                <% if (st && st.state === 'trial') { %>
                  <form method="post" action="/admin/signups/<%= ws.id %>/trial" onsubmit="return confirm('End this trial now? The workspace locks until you extend or activate it.');">
                    <input type="hidden" name="action" value="end" />
                    <button type="submit" class="btn-pill bg-white dark:bg-slate-900 border border-red-200 dark:border-red-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-300">End trial</button>
                  </form>
                <% } %>
              </div>
              <% if (st && st.state !== 'active') { %>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <form method="post" action="/admin/signups/<%= ws.id %>/trial" class="flex items-center gap-2">
                    <input type="hidden" name="action" value="extend" />
                    <select name="days" aria-label="Extend by">
                      <option value="3">+3 days</option>
                      <option value="7" selected>+7 days</option>
                      <option value="14">+14 days</option>
                      <option value="30">+30 days</option>
                    </select>
                    <button type="submit" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Extend</button>
                  </form>
                  <form method="post" action="/admin/signups/<%= ws.id %>/trial" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="action" value="limits" />
                    <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Daily</label>
                    <input type="number" name="paidCallsPerDay" min="1" value="<%= st.limits.paidCallsPerDay %>" aria-label="Lead search calls per day" title="Lead search calls per day" />
                    <input type="number" name="aiCallsPerDay" min="1" value="<%= st.limits.aiCallsPerDay %>" aria-label="AI calls per day" title="AI calls per day" />
                    <button type="submit" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Save limits</button>
                  </form>
                </div>
              <% } %>
              <% if (r.log.length) { %>
                <p class="text-[11px] text-brand-muted">Last change: <%= r.log[0].action %> by <%= r.log[0].by || 'admin' %> &middot; <%= new Date(r.log[0].at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></p>
              <% } %>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </main>
  <script>
  (function () {
    var btn = document.getElementById('signupCopy');
    var input = document.getElementById('signupLink');
    if (!btn || !input) return;
    btn.addEventListener('click', function () {
      input.select();
      (navigator.clipboard ? navigator.clipboard.writeText(input.value) : Promise.reject()).catch(function () { document.execCommand('copy'); });
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
    });
  })();
  </script>
</body>
</html>
