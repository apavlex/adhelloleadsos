<%
  const _seoActive = typeof activePage !== 'undefined' ? activePage : '';
  const _seoCan = typeof navCan === 'function' ? navCan : function () { return true; };
  const _seoSticky = typeof seoNavSticky !== 'undefined' && seoNavSticky;
  const _seoStickyTop = typeof seoNavStickyTop === 'string' && seoNavStickyTop ? seoNavStickyTop : 'top-[4.75rem]';
%>
<nav class="<%= _seoSticky ? ('sticky ' + _seoStickyTop + ' z-30 -mx-6 px-6 py-3 mb-6 bg-brand-bg/90 dark:bg-slate-950/90 backdrop-blur border-b border-brand-border/40 dark:border-white/10') : 'mb-6' %> flex flex-wrap gap-2" aria-label="SEO / Local Rank">
  <% if (_seoCan('seo-gap')) { %>
  <a href="/seo-gap" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= _seoActive === 'seo-gap' ? 'btn-primary' : 'border border-brand-border dark:border-white/20' %>">SEO Gap</a>
  <% } %>
  <% if (_seoCan('backlinks')) { %>
  <a href="/backlinks" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= _seoActive === 'backlinks' ? 'btn-primary' : 'border border-brand-border dark:border-white/20' %>">Backlinks</a>
  <% } %>
  <% if (_seoCan('local-seo')) { %>
  <a href="/local-seo" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= _seoActive === 'local-seo' ? 'btn-primary' : 'border border-brand-border dark:border-white/20' %>">Local SEO</a>
  <% } %>
  <% if (_seoCan('business-reviews')) { %>
  <a href="/business-reviews" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= _seoActive === 'business-reviews' ? 'btn-primary' : 'border border-brand-border dark:border-white/20' %>">Reviews</a>
  <% } %>
  <% if (_seoCan('seo-qa')) { %>
  <a href="/seo-qa" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= _seoActive === 'seo-qa' ? 'btn-primary' : 'border border-brand-border dark:border-white/20' %>">Q&amp;A</a>
  <% } %>
</nav>
