<% const _bulkMode = typeof bulkBarMode !== 'undefined' && bulkBarMode === 'search' ? 'search' : 'pipeline'; %>
<div
  id="bulkActionBar"
  class="bulk-action-bar app-body-portal fixed bottom-6 left-1/2 -translate-x-1/2 text-white px-6 py-4 sm:px-8 sm:py-5 rounded-2xl z-[220] flex flex-col gap-3 max-w-[min(100vw-2rem,56rem)] opacity-0 translate-y-24 pointer-events-none transition-all duration-300 ease-out border border-white/10"
  role="toolbar"
  aria-label="Bulk lead actions"
  aria-hidden="true"
  data-bulk-mode="<%= _bulkMode %>"
  data-visible="false"
>
  <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
    <div class="flex items-center gap-4 sm:border-r sm:border-white/10 sm:pr-8 shrink-0">
      <div id="selectedCountCircle" class="w-10 h-10 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-sm shadow-lg">0</div>
      <div class="text-sm font-bold text-white/90 whitespace-nowrap">Leads selected</div>
    </div>

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 min-w-0">
      <div class="flex flex-col-reverse gap-2 min-w-0 w-full sm:w-auto">
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 px-3 py-2 rounded-2xl bg-white/5 border border-white/10">
          <label for="bulkFolderSelect" class="text-[10px] font-black uppercase tracking-widest text-white/70 shrink-0">Folder</label>
          <select id="bulkFolderSelect" class="min-w-[9rem] max-w-[16rem] rounded-lg bg-white/10 border border-white/10 px-2 py-1.5 text-xs font-black uppercase tracking-widest text-white/90 focus:outline-none focus:ring-2 focus:ring-brand-yellow/40 cursor-pointer">
            <option value="">No folder</option>
          </select>
          <% if (_bulkMode === 'pipeline') { %>
          <button type="button" id="bulkMoveFolderBtn" class="px-3 py-2 rounded-xl bg-brand-yellow text-brand-dark text-[10px] font-black uppercase tracking-widest hover:brightness-105 active:scale-[0.98] transition-all disabled:opacity-40 disabled:cursor-not-allowed" disabled>Move</button>
          <% } %>
          <button type="button" id="bulkSaveBtn" class="bulk-save-btn px-3 py-2 rounded-xl bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest hover:brightness-105 active:scale-[0.98] transition-all disabled:opacity-40 disabled:cursor-not-allowed" disabled data-default-label="<%= _bulkMode === 'search' ? 'Save to folder' : 'Save selected' %>">
            <%= _bulkMode === 'search' ? 'Save to folder' : 'Save selected' %>
          </button>
          <button type="button" id="bulkFolderNewToggle" class="px-2.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:bg-white/10 border border-transparent hover:border-brand-yellow/35 transition-colors shrink-0" title="Create a new folder">+ New folder</button>
        </div>
        <p id="bulkSaveFeedback" class="hidden text-[11px] font-bold leading-snug px-1" role="status" aria-live="polite"></p>
        <div id="bulkFolderNewRow" class="hidden flex-wrap items-center gap-2 px-3 py-2 rounded-2xl bg-white/5 border border-brand-yellow/25">
          <input type="text" id="bulkFolderNewName" autocomplete="off" placeholder="New folder name…" class="min-w-[10rem] flex-1 rounded-lg bg-white/10 border border-white/15 px-3 py-2 text-xs font-semibold text-white placeholder:text-white/45 focus:outline-none focus:ring-2 focus:ring-brand-yellow/50" />
          <button type="button" id="bulkFolderNewSave" class="px-3 py-2 rounded-xl bg-brand-yellow text-brand-dark text-[10px] font-black uppercase tracking-widest hover:brightness-105 shrink-0">Create</button>
          <button type="button" id="bulkFolderNewCancel" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-white/75 hover:text-white border border-white/15 shrink-0">Cancel</button>
        </div>
      </div>

      <button type="button" class="js-bulk-enhance flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-yellow transition-all group shrink-0" title="Enrich selected leads">
        <svg class="w-4 h-4 text-brand-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        <span class="text-xs font-black uppercase tracking-widest">Enhance</span>
      </button>
      <button type="button" class="js-bulk-export-csv flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-400 transition-all group shrink-0" title="Export selected leads">
        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
        <span class="text-xs font-black uppercase tracking-widest">Export</span>
      </button>

      <% if (_bulkMode === 'pipeline') { %>
      <button type="button" id="bulkSmsBtn" class="flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-blue-500/15 hover:bg-blue-500/25 border border-blue-400/40 transition-all group shrink-0" title="Send SMS to selected leads">
        <span class="text-xs font-black uppercase tracking-widest text-blue-100">SMS</span>
      </button>
      <button type="button" id="bulkVoicemailBtn" class="flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-violet-500/15 hover:bg-violet-500/25 border border-violet-400/40 transition-all group shrink-0" title="Voicemail drop">
        <span class="text-xs font-black uppercase tracking-widest text-violet-100">Voicemail</span>
      </button>
      <button type="button" id="batchOutreachBtnBulk" class="flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-rose-500/15 hover:bg-rose-500/25 border border-rose-400/40 transition-all group shrink-0" title="Cold call war room">
        <span class="text-xs font-black uppercase tracking-widest text-rose-100">Call room</span>
      </button>
      <a href="/focus" id="bulkFocusModeBtn" class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/45 transition-all group shrink-0" title="Focus mode">
        <span class="text-xs font-black uppercase tracking-widest text-amber-100">Focus</span>
      </a>
      <% } %>

      <div class="hidden sm:block w-px h-6 bg-white/10 shrink-0"></div>
      <button type="button" id="cancelSelectionBtn" class="text-xs font-bold text-white/50 hover:text-white transition-colors uppercase tracking-widest shrink-0 px-1">Cancel</button>
    </div>
  </div>
  <% if (_bulkMode === 'pipeline') { %>
  <button type="button" id="bulkDeleteBtn" class="w-full text-center pt-2 border-t border-white/10 text-xs font-black uppercase tracking-widest text-rose-400 hover:text-rose-300 transition-colors">Delete selected…</button>
  <% } %>
</div>
