<% const _bulkMode = typeof bulkBarMode !== 'undefined' && bulkBarMode === 'search' ? 'search' : 'pipeline'; %>
<% const _bulkFolders = typeof folders !== 'undefined' && Array.isArray(folders) ? folders : []; %>
<% const _bulkFolderPref = typeof activeFolderKey !== 'undefined' && activeFolderKey ? String(activeFolderKey) : (typeof targetFolderKey !== 'undefined' && targetFolderKey ? String(targetFolderKey) : ''); %>
<div
  id="bulkActionBar"
  class="bulk-action-bar app-body-portal fixed bottom-4 left-1/2 -translate-x-1/2 text-white px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl z-[280] flex flex-col items-stretch gap-1.5 w-[min(100vw-1rem,56rem)] opacity-0 translate-y-16 pointer-events-none transition-all duration-300 ease-out border border-white/10"
  role="toolbar"
  aria-label="Bulk lead actions"
  aria-hidden="true"
  data-bulk-mode="<%= _bulkMode %>"
  data-visible="false"
>
  <div id="bulkFolderNewRow" class="hidden w-full flex flex-wrap items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg bg-white/5 border border-brand-yellow/25 bulk-bar-expand-row" role="group" aria-label="Create folder">
    <input type="text" id="bulkFolderNewName" autocomplete="off" placeholder="New folder name…" class="min-w-[8rem] flex-1 rounded-md bg-white/10 border border-white/15 px-2 py-1 text-[11px] font-semibold text-white placeholder:text-white/45 focus:outline-none focus:ring-1 focus:ring-brand-yellow/50" />
    <button type="button" id="bulkFolderNewSave" class="bulk-bar-btn bulk-bar-btn--accent">Create</button>
    <button type="button" id="bulkFolderNewCancel" class="bulk-bar-btn bulk-bar-btn--ghost">Cancel</button>
  </div>

  <div id="bulkTagsRow" class="hidden w-full flex flex-col items-center gap-2 py-1.5 px-2 rounded-lg bg-white/5 border border-sky-400/25 bulk-bar-expand-row" role="group" aria-label="Manage tags">
    <div class="flex flex-wrap items-center justify-center gap-1.5 w-full">
      <label for="bulkTagSelect" class="sr-only">Tag</label>
      <select id="bulkTagSelect" class="bulk-bar-select min-w-[7.5rem] max-w-[11rem] rounded-md bg-white/10 border border-white/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-white/90 focus:outline-none focus:ring-1 focus:ring-sky-400/50 cursor-pointer">
        <option value="">Select tag…</option>
      </select>
      <label for="bulkTagColor" class="sr-only">Tag color</label>
      <input type="color" id="bulkTagColor" value="#94a3b8" class="bulk-tag-color-input shrink-0" title="Change selected tag color" aria-label="Selected tag color" disabled />
      <button type="button" id="bulkTagAddBtn" class="bulk-bar-btn bulk-bar-btn--accent">Add</button>
      <button type="button" id="bulkTagRemoveBtn" class="bulk-bar-btn bulk-bar-btn--ghost">Remove</button>
      <button type="button" id="bulkTagsCancel" class="bulk-bar-btn bulk-bar-btn--ghost">Close</button>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-1.5 w-full">
      <input type="text" id="bulkTagNewName" autocomplete="off" placeholder="New tag name…" class="min-w-[8rem] flex-1 rounded-md bg-white/10 border border-white/15 px-2 py-1 text-[11px] font-semibold text-white placeholder:text-white/45 focus:outline-none focus:ring-1 focus:ring-sky-400/50" />
      <label for="bulkTagNewColor" class="sr-only">New tag color</label>
      <input type="color" id="bulkTagNewColor" value="#EAB308" class="bulk-tag-color-input shrink-0" title="New tag color" aria-label="New tag color" />
      <button type="button" id="bulkTagNewSave" class="bulk-bar-btn bulk-bar-btn--accent">Create &amp; add</button>
    </div>
  </div>

  <div class="flex flex-col items-center gap-1.5 w-full bulk-bar-main">
    <div class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 w-full">
      <div class="flex items-center gap-2 shrink-0 border-r border-white/10 pr-2.5 mr-0.5">
        <div id="selectedCountCircle" class="w-7 h-7 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-xs shadow-md tabular-nums">0</div>
        <span class="text-[10px] font-bold text-white/85 uppercase tracking-wide whitespace-nowrap hidden sm:inline">Selected</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-1.5 min-w-0 bulk-bar-folder-strip">
      <label for="bulkFolderSelect" class="sr-only">Folder</label>
      <select id="bulkFolderSelect" class="bulk-bar-select min-w-[7.5rem] max-w-[11rem] rounded-md bg-white/10 border border-white/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-white/90 focus:outline-none focus:ring-1 focus:ring-brand-yellow/50 cursor-pointer">
        <option value=""<%= !_bulkFolderPref ? ' selected' : '' %>>No folder</option>
        <% _bulkFolders.forEach(function (fd) { if (!fd || !fd.key) return; %>
        <option value="<%= fd.key %>"<%= _bulkFolderPref === String(fd.key) ? ' selected' : '' %>><%= fd.name || 'Folder' %></option>
        <% }); %>
      </select>
      <button type="button" id="bulkMoveFolderBtn" class="bulk-bar-btn bulk-bar-btn--accent" disabled title="Move saved leads into the selected folder">Move</button>
      <% if (_bulkMode === 'pipeline') { %>
      <% const _boardStages = typeof pipelineStages !== 'undefined' && Array.isArray(pipelineStages) ? pipelineStages : []; %>
      <% if (_boardStages.length) { %>
      <label for="bulkPipelineStageSelect" class="sr-only">Pipeline stage</label>
      <select id="bulkPipelineStageSelect" class="bulk-bar-select min-w-[6.5rem] max-w-[10rem] rounded-md bg-white/10 border border-white/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-white/90 focus:outline-none focus:ring-1 focus:ring-brand-yellow/50 cursor-pointer" title="Stage for pipeline board">
        <% _boardStages.forEach(function (st, idx) { if (!st || !st.id) return; %>
        <option value="<%= st.id %>"<%= idx === 0 ? ' selected' : '' %>><%= st.name %></option>
        <% }); %>
      </select>
      <button type="button" id="bulkAddToBoardBtn" class="bulk-bar-btn bulk-bar-btn--board" disabled title="Save selected leads to this stage and show on the pipeline board">Board</button>
      <% } %>
      <% } %>
      <button type="button" id="bulkSaveBtn" class="bulk-bar-btn bulk-bar-btn--save bulk-save-btn" disabled data-default-label="<%= _bulkMode === 'search' ? 'Save' : 'Save' %>">
        <%= _bulkMode === 'search' ? 'Save' : 'Save' %>
      </button>
      <button type="button" id="bulkFolderNewToggle" class="bulk-bar-btn bulk-bar-btn--ghost text-brand-yellow" title="Create a new folder" aria-expanded="false" aria-controls="bulkFolderNewRow">+ Folder</button>
      <button type="button" id="bulkTagsToggle" class="bulk-bar-btn bulk-bar-btn--ghost text-sky-300" title="Add or remove tags">Tags</button>
      </div>
    </div>

    <div class="bulk-bar-tools-row flex flex-nowrap items-center justify-center gap-1.5 w-full overflow-x-auto" role="group" aria-label="Lead tools">
      <button type="button" class="bulk-bar-btn bulk-bar-btn--ghost js-bulk-enhance shrink-0" title="Enrich selected leads">
        <svg class="w-3.5 h-3.5 text-brand-yellow shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        <span>Enhance</span>
      </button>
      <button type="button" class="bulk-bar-btn bulk-bar-btn--ghost js-bulk-socials shrink-0" title="Find Instagram, TikTok, and X profiles for DMs">
        <svg class="w-3.5 h-3.5 text-pink-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
        <span>Socials</span>
      </button>
      <button type="button" class="bulk-bar-btn bulk-bar-btn--ghost js-bulk-export-csv shrink-0" title="Export selected leads">
        <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
        <span>Export</span>
      </button>
      <% if (_bulkMode === 'pipeline') { %>
      <button type="button" id="bulkMergeBtn" class="bulk-bar-btn bulk-bar-btn--ghost text-violet-300 shrink-0" title="Merge selected leads into one record (multi-location)">
        <svg class="w-3.5 h-3.5 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 21l7.737-7.737a3 3 0 014.242 0l.818.818M4 21h5v-5M4 21l7.5-7.5M19 8l-6 6" /></svg>
        <span>Merge</span>
      </button>
      <% } %>
    </div>

    <% if (_bulkMode === 'pipeline') { %>
    <div class="bulk-bar-primary-row w-full" role="group" aria-label="Primary outreach">
      <a href="/focus?channel=call" id="bulkFocusModeBtn" class="bulk-bar-btn bulk-bar-btn--focus bulk-bar-btn--primary-lg bulk-bar-primary-split hidden" title="Call and log selected leads">Call</a>
      <button type="button" id="bulkSmsBtn" class="bulk-bar-btn bulk-bar-btn--sms bulk-bar-btn--primary-lg bulk-bar-primary-split hidden" title="AI-personalized SMS or iMessage to selected leads">SMS</button>
      <button type="button" id="bulkDirectMailBtn" class="bulk-bar-btn bulk-bar-btn--mail bulk-bar-btn--primary-lg bulk-bar-primary-split hidden" title="Tag and move selected leads into the Direct Mail folder">Direct Mail</button>
      <button type="button" id="bulkPushGhlBtn" class="bulk-bar-btn bulk-bar-btn--ghl bulk-bar-btn--primary-lg bulk-bar-primary-split hidden" title="Sync selected leads to Go High Level — run SMS, email, and voicemail from GHL">Sync GHL</button>
    </div>
    <% } %>

    <div class="flex flex-wrap items-center justify-center gap-2 w-full bulk-bar-secondary-actions pt-0.5">
      <button type="button" id="cancelSelectionBtn" class="text-[10px] font-bold text-white/45 hover:text-white transition-colors uppercase tracking-wide px-1">Cancel</button>
      <% if (_bulkMode === 'pipeline') { %>
      <span class="text-white/20 text-[10px]" aria-hidden="true">|</span>
      <button type="button" id="bulkDeleteBtn" class="text-[10px] font-bold uppercase tracking-wide text-rose-400/90 hover:text-rose-300 transition-colors px-1" title="Delete selected leads">Delete…</button>
      <% } %>
    </div>
  </div>

  <p id="bulkSaveFeedback" class="hidden w-full text-center text-[10px] font-semibold leading-tight px-0.5" role="status" aria-live="polite"></p>
  <a id="bulkOpenGhlContactsLink" href="https://my.adhello.ai/" target="_blank" rel="noopener noreferrer" class="hidden text-[10px] font-bold uppercase tracking-wide text-brand-yellow hover:text-white underline underline-offset-2">Open GHL contacts →</a>
</div>
