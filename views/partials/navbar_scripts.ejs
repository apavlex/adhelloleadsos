      if (softphoneSession.state !== 'in_call' || !softphoneSession.webrtc) {
        clearSoftphoneRemoteAudioWatchdog();
        return;
      }
      attempts += 1;
      applySoftphoneAudioToActiveCall().then(function (playing) {
        if (playing || attempts >= 30) clearSoftphoneRemoteAudioWatchdog();
      });
    }, 500);
  }

