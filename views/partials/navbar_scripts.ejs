    var parsed = parseSoftphoneQuickLogSelection(spDisposition ? spDisposition.value : '');
    var notes = spNotes ? String(spNotes.value || '').trim() : '';
    if (parsed && parsed.code) {
      payload.disposition = parsed.code;
