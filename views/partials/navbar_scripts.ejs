<%# Dialer HTML after main content so mobile paints the page before ~41KB of softphone markup. %>
<%- include('/partials/softphone_modal') %>
<%# Softphone + nav chrome — externalized so HTML isn't ~236KB of inline JS every hop. %>
<script src="/js/navbar-shell.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/theme-toggle.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/lead-send-info.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/task-reminders.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/quick-add-task.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/send-referral-modal.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/push-alerts.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<%# Bell must load with defer (not idle): idle often runs after DOMContentLoaded and never binds clicks / resumes GHL sync. %>
<script src="/js/nav-notifications.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/nav-inbound.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
