    spMicStatus.classList.toggle('dark:text-rose-400', !!isError);
    spMicStatus.classList.toggle('text-emerald-700', !!msg && !isError);
    spMicStatus.classList.toggle('dark:text-emerald-300', !!msg && !isError);
