<% const _activityTab = typeof activityTab !== 'undefined' ? activityTab : 'activity'; %>
<nav class="inline-flex items-center gap-1 p-1 mb-6 rounded-2xl bg-white dark:bg-slate-900 border border-brand-border/50 dark:border-white/10 shadow-sm" aria-label="Activity sections">
  <% [{ id: 'activity', href: '/activity', label: 'Activity' }, { id: 'team', href: '/team-history', label: 'Team history' }].forEach(function (t) { %>
  <a href="<%= t.href %>" class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors <%= _activityTab === t.id ? 'bg-brand-yellow text-brand-dark shadow-sm' : 'text-brand-muted hover:text-brand-dark dark:hover:text-white' %>"<%- _activityTab === t.id ? ' aria-current="page"' : '' %>><%= t.label %></a>
  <% }); %>
</nav>
