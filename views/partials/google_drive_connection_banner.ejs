<% if (typeof driveImport !== 'undefined' && driveImport) { %>
  <% const _gdReady = !!driveImport.pickerReady; %>
  <% const _gdConnected = _gdReady && !!driveImport.connected; %>
  <% const _gdOAuthErr = !!driveImport.driveOAuthError; %>
  <% if (_gdReady && !_gdConnected && !_gdOAuthErr) { %>
  <a href="/auth/google/drive-link" class="group mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border-2 border-blue-300/80 dark:border-blue-500/40 bg-gradient-to-r from-blue-50 to-white dark:from-blue-950/40 dark:to-slate-900 px-5 py-4 shadow-sm hover:border-blue-400 dark:hover:border-blue-400/60 hover:shadow-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950">
    <div class="flex items-start gap-3 min-w-0">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-blue-200/80 dark:border-blue-500/30 shadow-sm">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
      </span>
      <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-blue-700 dark:text-blue-300">Google Drive</p>
        <p class="text-sm font-semibold text-brand-dark dark:text-white mt-0.5">Connect Google Drive to import and export lead lists</p>
        <p class="text-xs text-brand-muted dark:text-slate-400 mt-1 max-w-xl">One click links your account. Files go to the <em class="not-italic font-semibold text-brand-dark/80 dark:text-slate-300">AdHello Leads</em> folder in Drive.</p>
      </div>
    </div>
    <span class="inline-flex items-center gap-2 shrink-0 rounded-full bg-blue-600 dark:bg-blue-500 text-white px-5 py-2.5 text-[10px] font-black uppercase tracking-widest group-hover:bg-blue-700 dark:group-hover:bg-blue-400 transition-colors shadow-sm">
      Connect
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
    </span>
  </a>
  <% } else if (_gdConnected) { %>
  <div class="mb-6 flex flex-wrap items-center gap-2.5 rounded-xl border border-emerald-200/80 dark:border-emerald-800/60 bg-emerald-50/80 dark:bg-emerald-950/25 px-4 py-2.5" role="status">
    <svg class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200">Google Drive connected</span>
    <span class="text-[10px] font-semibold text-emerald-700/90 dark:text-emerald-300/90">· Use Import or Export → My Google Drive</span>
  </div>
  <% } else if (driveImport.setupHint) { %>
  <div class="mb-8 rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-5 py-4">
    <p class="text-sm font-semibold text-amber-950 dark:text-amber-100">Google Drive import is not fully configured on this server.</p>
    <p class="text-xs text-amber-900/80 dark:text-amber-200/80 mt-1">An admin needs to set <code class="font-mono text-[11px]">GOOGLE_PICKER_API_KEY</code> alongside your Google OAuth credentials.</p>
  </div>
  <% } %>
<% } %>
