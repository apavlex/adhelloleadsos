<% const _lfs = typeof leadsFilterSuffix !== 'undefined' ? leadsFilterSuffix : ''; %>
<% const _lf = typeof leadListFilters !== 'undefined' && leadListFilters ? leadListFilters : {}; %>
<% const _fk = _lf.folderKey ? String(_lf.folderKey) : ''; %>
<% const _folders = typeof folders !== 'undefined' && folders ? folders : []; %>
<% const _activeFolder = _fk ? _folders.find(function (x) { return x && String(x.key) === _fk; }) : null; %>
<% const _stOpts = typeof pipelineStatusOptions !== 'undefined' && pipelineStatusOptions ? pipelineStatusOptions : []; %>
<% const _src = typeof sourceFilter !== 'undefined' ? sourceFilter : 'all'; %>
<% const _hasActiveFilters = _lf && typeof _lf === 'object' && Object.keys(_lf).length > 0; %>
<% const _advOpen = !!(_lf.addedFrom || _lf.addedTo || _lf.stage || _lf.status || (_lf.minRating != null && String(_lf.minRating) !== '') || (_lf.minReviews != null && String(_lf.minReviews) !== '')); %>
<% function _pipelineQs(omit) {
  var o = omit || '';
  var p = ['tab=pipeline', 'source=' + encodeURIComponent(_src)];
  if (o !== 'folderKey' && _fk) p.push('folderKey=' + encodeURIComponent(_fk));
  if (o !== 'q' && _lf.q) p.push('q=' + encodeURIComponent(String(_lf.q)));
  if (o !== 'origin' && _lf.origin) p.push('origin=' + encodeURIComponent(String(_lf.origin)));
  if (o !== 'addedFrom' && _lf.addedFrom) p.push('addedFrom=' + encodeURIComponent(String(_lf.addedFrom)));
  if (o !== 'addedTo' && _lf.addedTo) p.push('addedTo=' + encodeURIComponent(String(_lf.addedTo)));
  if (o !== 'stage' && _lf.stage != null && String(_lf.stage) !== '') p.push('stage=' + encodeURIComponent(String(_lf.stage)));
  if (o !== 'status' && _lf.status) p.push('status=' + encodeURIComponent(String(_lf.status)));
  if (o !== 'minRating' && _lf.minRating != null && String(_lf.minRating) !== '') p.push('minRating=' + encodeURIComponent(String(_lf.minRating)));
  if (o !== 'minReviews' && _lf.minReviews != null && String(_lf.minReviews) !== '') p.push('minReviews=' + encodeURIComponent(String(_lf.minReviews)));
  return '/prospecting?' + p.join('&');
} %>
<% if (typeof importError !== 'undefined' && importError) { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4">
    <p class="text-sm font-semibold text-rose-900 dark:text-rose-100">Import failed: <%= importError %></p>
    <a href="/prospecting?tab=pipeline" class="mt-2 inline-block text-xs font-black uppercase text-rose-800 dark:text-rose-200 underline">Dismiss</a>
  </div>
<% } %>
<% if (typeof driveImport !== 'undefined' && driveImport && driveImport.driveConnectedBanner) { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4">
    <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">Google Drive is connected. Use <strong>Import → My Google Drive</strong> or <strong>Export → My Google Drive</strong>; files save to the <em>AdHello Leads</em> folder.</p>
    <a href="/prospecting?tab=pipeline" class="mt-2 inline-block text-xs font-black uppercase text-emerald-800 dark:text-emerald-200 underline">Dismiss</a>
  </div>
<% } %>
<% if (typeof importNotice !== 'undefined' && importNotice) { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
    <% const hasRowBreakdown = importNotice.rows != null && importNotice.created != null && importNotice.updated != null; %>
    <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100 max-w-3xl">
      <% if (hasRowBreakdown) { %>
        CSV import finished: <strong><%= importNotice.rows %></strong> rows processed —
        <strong><%= importNotice.created %></strong> new lead<%= importNotice.created === 1 ? '' : 's' %>,
        <strong><%= importNotice.updated %></strong> merged into an existing lead (duplicate email in this workspace).
        <% if (importNotice.skipped > 0) { %> <strong><%= importNotice.skipped %></strong> skipped.<% } %>
        <% if (importNotice.failed > 0) { %> <strong><%= importNotice.failed %></strong> failed.<% } %>
      <% } else { %>
        CSV import finished:
        <strong><%= importNotice.imported %></strong> saved
        <% if (importNotice.skipped > 0) { %>, <strong><%= importNotice.skipped %></strong> skipped<% } %>
        <% if (importNotice.failed > 0) { %>, <strong><%= importNotice.failed %></strong> failed<% } %>.
      <% } %>
    </p>
    <a href="/prospecting?tab=pipeline" class="text-xs font-black uppercase text-emerald-800 dark:text-emerald-200 underline shrink-0">Dismiss</a>
  </div>
<% } %>
<div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10 md:mb-12">
  <div>
    <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-3">
      <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Pipeline</span>
    </div>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl tracking-tight text-brand-dark dark:text-white">
      <span class="text-brand-muted dark:text-slate-500">Board</span> &amp; stages
    </h2>
    <% const _wsAll = typeof leadSourceCounts !== 'undefined' && leadSourceCounts ? leadSourceCounts.all : leads.length; %>
    <p class="text-sm text-brand-muted dark:text-slate-300 font-medium mt-3 max-w-xl leading-relaxed">
      <% if (_activeFolder) { %>
      Viewing folder <strong class="text-brand-dark dark:text-white"><%= _activeFolder.name %></strong>
      (<strong class="text-brand-dark dark:text-white"><%= _wsAll %></strong> lead<%= _wsAll === 1 ? '' : 's' %> here<% if (typeof sourceFilter !== 'undefined' && sourceFilter !== 'all') { %> — <strong class="text-brand-dark dark:text-white"><%= leads.length %></strong> with this source filter<% } %>).
      <% } else { %>
      One board for <strong class="text-brand-dark dark:text-white">cold + warm</strong>
      (<strong class="text-brand-dark dark:text-white"><%= _wsAll %></strong> unfiled in this workspace<% if (typeof sourceFilter !== 'undefined' && sourceFilter !== 'all') { %> — <strong class="text-brand-dark dark:text-white"><%= leads.length %></strong> with this filter<% } %>).
      <% } %>
      Drag cards on the kanban to move through stages; table view shows status and source. Filed leads live in <a href="/prospecting?tab=folders" class="font-bold text-brand-yellow hover:underline">Folders</a> until you open them here.
    </p>
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mt-4 flex flex-wrap gap-x-4 gap-y-2">
      <a href="/sequences" class="font-bold text-brand-yellow hover:underline">Cadences</a>
      <a href="/prospecting?tab=queue" class="text-brand-yellow hover:underline">Working queue</a>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
      <a href="/workspace/team" class="text-brand-dark dark:text-white hover:underline">Team &amp; assign</a>
      <% } %>
    </p>
    <% if (typeof leadSourceCounts !== 'undefined' && leadSourceCounts) { %>
    <div class="flex flex-wrap gap-2 mt-5" role="tablist" aria-label="Filter by lead source">
      <a href="/prospecting?tab=pipeline&amp;source=all<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter === 'undefined' || sourceFilter === 'all') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">All (<%= leadSourceCounts.all %>)</a>
      <a href="/prospecting?tab=pipeline&amp;source=cold<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'cold') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Cold (<%= leadSourceCounts.cold %>)</a>
      <a href="/prospecting?tab=pipeline&amp;source=inbound<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'inbound') ? 'bg-amber-500 text-white border-amber-500' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Warm inbound (<%= leadSourceCounts.inbound %>)</a>
    </div>
    <% } %>
  </div>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
    <div class="flex items-center bg-white dark:bg-slate-900 rounded-full border border-brand-border dark:border-white/10 p-1 shadow-sm ring-1 ring-brand-border/20 dark:ring-white/5" role="group" aria-label="Table or pipeline view">
        <button type="button" id="showTableView" class="px-4 py-2.5 text-[10px] font-black uppercase tracking-widest rounded-full transition-all duration-150 bg-brand-yellow text-brand-dark shadow-sm">Table</button>
        <button type="button" id="showKanbanView" class="px-4 py-2.5 text-[10px] font-black uppercase tracking-widest rounded-full transition-all duration-150 text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white">Pipeline</button>
    </div>
    <%- include('/partials/pipeline_import_export_menus') %>
    <a href="/leads/find" class="btn-pill btn-primary shadow-md hover:shadow-lg">
      <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      Find More Leads
    </a>
  </div>
</div>

<div class="brand-card dark:bg-slate-900 dark:border-white/10 mb-8 overflow-hidden">
  <div class="px-5 py-3 md:px-6 md:py-4 border-b border-brand-border/30 dark:border-white/10 flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="text-[11px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Search &amp; refine</span>
      <% if (_hasActiveFilters) { %>
      <span class="rounded-full bg-brand-yellow/25 dark:bg-brand-yellow/20 px-2.5 py-0.5 text-[9px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow border border-brand-yellow/40">Filtered</span>
      <% } %>
      <span class="text-[10px] font-semibold text-brand-muted dark:text-slate-400"><%= leads.length %> lead<%= leads.length === 1 ? '' : 's' %> in view</span>
    </div>
  </div>
<form method="get" action="/prospecting" class="px-5 py-4 md:px-6 md:py-5">
  <input type="hidden" name="tab" value="pipeline" />
  <input type="hidden" name="source" value="<%= _src %>" />
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 gap-y-3 items-end">
    <div class="lg:col-span-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Folder</label>
      <select name="folderKey" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-bold text-brand-dark dark:text-white" title="Show leads from a folder or main pipeline">
        <option value=""<%= !_fk ? ' selected' : '' %>>Main pipeline (unfiled)</option>
        <% _folders.forEach(function (fd) { if (!fd || !fd.key) return; %>
        <option value="<%= fd.key %>"<%= _fk === String(fd.key) ? ' selected' : '' %>><%= fd.name || 'Folder' %></option>
        <% }); %>
      </select>
    </div>
    <div class="lg:col-span-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Search</label>
      <input type="search" name="q" value="<%= _lf.q || '' %>" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Company, email, phone, website…" />
    </div>
    <div class="lg:col-span-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Origin</label>
      <select name="origin" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-bold text-brand-dark dark:text-white">
        <option value=""<%= !_lf.origin ? ' selected' : '' %>>All origins</option>
        <option value="search"<%= _lf.origin === 'search' ? ' selected' : '' %>>Searched / maps</option>
        <option value="csv"<%= _lf.origin === 'csv' ? ' selected' : '' %>>CSV import</option>
        <option value="manual"<%= _lf.origin === 'manual' ? ' selected' : '' %>>Manual / offline</option>
        <option value="warm"<%= _lf.origin === 'warm' ? ' selected' : '' %>>Warm (inbound)</option>
      </select>
    </div>
    <div class="lg:col-span-3 flex flex-wrap items-end gap-2">
      <button type="submit" class="btn-pill btn-primary px-6 py-2.5 text-[10px] font-black uppercase tracking-widest">Apply</button>
      <a href="/prospecting?tab=pipeline&amp;source=<%= _src %>" class="inline-flex items-center justify-center rounded-full border-2 border-brand-border dark:border-white/15 bg-transparent px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/30 dark:hover:bg-white/5 transition-colors text-center">Clear</a>
    </div>
  </div>

  <details class="mt-4 pt-4 border-t border-brand-border/30 dark:border-white/10 group/more" <%= _advOpen ? 'open' : '' %>>
    <summary class="flex cursor-pointer list-none items-center gap-2 text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-slate-200 [&::-webkit-details-marker]:hidden">
      <span class="transition-transform duration-200 group-open/more:rotate-180" aria-hidden="true">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </span>
      More filters
    </summary>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 pt-4 items-end">
    <div class="lg:col-span-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Added from</label>
      <input type="date" name="addedFrom" value="<%= _lf.addedFrom || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
    </div>
    <div class="lg:col-span-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Added to</label>
      <input type="date" name="addedTo" value="<%= _lf.addedTo || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
    </div>
    <div class="lg:col-span-2">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Pipeline stage</label>
      <select name="stage" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-bold text-brand-dark dark:text-white">
        <option value=""<%= !_lf.stage ? ' selected' : '' %>>All stages</option>
        <% if (typeof pipelineStages !== 'undefined' && pipelineStages && pipelineStages.length) { pipelineStages.forEach(function (st, idx) { %>
        <option value="<%= st.id %>"<%= String(_lf.stage) === String(st.id) ? ' selected' : '' %>><%= st.name %></option>
        <% }); } %>
      </select>
    </div>
    <div class="lg:col-span-4">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Status</label>
      <select name="status" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-bold text-brand-dark dark:text-white">
        <option value=""<%= !_lf.status ? ' selected' : '' %>>Any status</option>
        <% _stOpts.forEach(function (st) { %>
        <option value="<%= st %>"<%= _lf.status === st ? ' selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>
    <div class="lg:col-span-2">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Min rating</label>
      <input type="number" name="minRating" min="0" max="5" step="0.1" value="<%= _lf.minRating || '' %>" placeholder="0" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
    </div>
    <div class="lg:col-span-2">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1.5 block">Min reviews</label>
      <input type="number" name="minReviews" min="0" step="1" value="<%= _lf.minReviews || '' %>" placeholder="0" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
    </div>
    <div class="lg:col-span-12 flex flex-wrap gap-2 pt-1">
      <button type="submit" class="btn-pill btn-primary px-6 py-2.5 text-[10px] font-black uppercase tracking-widest">Apply filters</button>
    </div>
    </div>
  </details>
</form>
</div>

<% if (_hasActiveFilters) { %>
<div class="flex flex-wrap items-center gap-2 mb-8" aria-label="Active filters">
  <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mr-1">Active</span>
  <% if (_lf.q) { %>
  <a href="<%= _pipelineQs('q') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors" title="Remove search filter">Search: <span class="max-w-[10rem] truncate"><%= _lf.q %></span><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_fk && _activeFolder) { %>
  <a href="<%= _pipelineQs('folderKey') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors" title="Back to main pipeline">Folder: <%= _activeFolder.name %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.origin) { %>
  <a href="<%= _pipelineQs('origin') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors" title="Remove origin filter">Origin: <%= _lf.origin %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.addedFrom) { %>
  <a href="<%= _pipelineQs('addedFrom') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">From: <%= _lf.addedFrom %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.addedTo) { %>
  <a href="<%= _pipelineQs('addedTo') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">To: <%= _lf.addedTo %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.stage != null && String(_lf.stage) !== '') { %>
  <a href="<%= _pipelineQs('stage') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Stage <%= _lf.stage %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.status) { %>
  <a href="<%= _pipelineQs('status') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors"><%= _lf.status %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.minRating != null && String(_lf.minRating) !== '') { %>
  <a href="<%= _pipelineQs('minRating') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Rating ≥ <%= _lf.minRating %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <% if (_lf.minReviews != null && String(_lf.minReviews) !== '') { %>
  <a href="<%= _pipelineQs('minReviews') %>" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 pl-3 pr-2 py-1 text-[10px] font-bold text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Reviews ≥ <%= _lf.minReviews %><span class="text-brand-muted" aria-hidden="true">×</span></a>
  <% } %>
  <a href="/prospecting?tab=pipeline&amp;source=<%= _src %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline ml-1">Clear all</a>
</div>
<% } %>

<p class="text-[11px] font-medium text-brand-muted dark:text-slate-400 mb-10 max-w-2xl leading-relaxed">
