<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#FFDB3A" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<% const _wl = typeof whiteLabel !== 'undefined' && whiteLabel ? whiteLabel : null; %>
<meta name="apple-mobile-web-app-title" content="<%= _wl ? _wl.appName : 'AdHello' %>">
<meta name="application-name" content="<%= _wl ? _wl.appName : 'AdHello' %>">
<meta name="format-detection" content="telephone=no">
<%
  let _pageTitle = typeof title !== 'undefined' ? String(title) : 'AdHello.ai | Leads';
  if (_wl && _wl.customName) _pageTitle = _pageTitle.replace(/Agency OS|AdHello(\.ai)?/g, _wl.customName);
%>
<title><%= _pageTitle %></title>
<% if (_wl && _wl.custom) { %>
<link rel="manifest" href="<%= _wl.manifestUrl %>">
<link rel="icon" href="<%= _wl.iconUrl(192) %>" type="image/png">
<link rel="apple-touch-icon" href="<%= _wl.iconUrl(180) %>" sizes="180x180">
<% } else { %>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/images/adhello-app-icon.png" type="image/png">
<link rel="apple-touch-icon" href="/images/adhello-app-icon-192.png" sizes="192x192">
<link rel="apple-touch-icon" href="/images/adhello-app-icon-512.png" sizes="512x512">
<% } %>
<script>
  /* Before CSS: set dark/light on <html> so custom.css variables match on first paint. */
  (function () {
    try {
      var d = document.documentElement;
      var t = localStorage.getItem('color-theme');
      if (t === 'dark') d.classList.add('dark');
      else if (t === 'light') d.classList.remove('dark');
      else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) d.classList.add('dark');
      else d.classList.remove('dark');
    } catch (e) {}
  })();
</script>
<% if (typeof workspaceId !== 'undefined' && workspaceId) { %>
<script>window.__ADHELLO_WORKSPACE_ID__ = <%- safeJsonForScript(String(workspaceId)) %>;</script>
<% } %>
<script>window.__ADHELLO_SCRIPT_PROFILE__ = <%- safeJsonForScript(typeof scriptSignOffProfile !== 'undefined' && scriptSignOffProfile ? scriptSignOffProfile : { name: '', company: '', phone: '', email: '' }) %>;</script>
<style>
  /* First-paint background before stylesheets apply (avoids cream→dark snap; also html canvas color). */
  html:not(.dark) { background-color: #FAF7ED; }
  html.dark { background-color: #020617; }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Manrope:wght@700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet"></noscript>
<style id="portaledPopoverSurfaces">
  .portaled-popover-surface,
  .adhello-mini-calendar,
  #leadCallbackDatePopover,
  [data-pipeline-menu-panel],
  .tag-filter-combobox-menu,
  .pipeline-columns-popover,
  #pipelineColumnsPopover,
  .opp-pop,
  .opp-pop__surface {
    background-color: #ffffff !important;
    background-image: none !important;
    background: #ffffff !important;
    opacity: 1 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    isolation: isolate;
  }
  [data-pipeline-menu-panel].hidden,
  [data-pipeline-menu-panel][hidden] {
    display: none !important;
  }
  .pipeline-import-export-menu-panel,
  .pipeline-import-export-menu-panel__surface {
    background-color: #ffffff !important;
    background-image: none !important;
    background: #ffffff !important;
    opacity: 1 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    isolation: isolate;
  }
  html.dark .pipeline-import-export-menu-panel,
  html.dark .pipeline-import-export-menu-panel__surface {
    background-color: #0f172a !important;
    background: #0f172a !important;
    color: #f8fafc;
  }
  html.dark .portaled-popover-surface,
  html.dark .adhello-mini-calendar,
  html.dark #leadCallbackDatePopover,
  html.dark [data-pipeline-menu-panel],
  html.dark .tag-filter-combobox-menu,
  html.dark .pipeline-columns-popover,
  html.dark #pipelineColumnsPopover,
  html.dark .opp-pop,
  html.dark .opp-pop__surface {
    background-color: #0f172a !important;
    background: #0f172a !important;
    color: #f8fafc;
  }
</style>
<link rel="stylesheet" href="/css/custom.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
<%- include('/partials/app_shell_styles') %>
<% if (typeof workspaceAccent !== 'undefined' && workspaceAccent) { %>
<style>:root {
  --brand-yellow: <%= workspaceAccent %>;
  --workspace-accent: <%= workspaceAccent %>;
  --brand-on-accent: <%= typeof workspaceAccentText !== 'undefined' && workspaceAccentText ? workspaceAccentText : '#111827' %>;
}</style>
<% } %>
<% if (typeof quickLogClient !== 'undefined' && quickLogClient) { %>
<script>window.__QUICK_LOG=<%- JSON.stringify(quickLogClient).replace(/</g, '\\u003c') %>;</script>
<% } %>
<%
  const _np = typeof navPrimary !== 'undefined' ? String(navPrimary) : '';
  const _rp = typeof requestPath !== 'undefined' ? String(requestPath) : '';
  const _needPipeline =
    _np === 'prospecting' ||
    _np === 'find' ||
    _rp.startsWith('/leads') ||
    _rp.startsWith('/prospecting') ||
    _rp.startsWith('/pipeline');
  const _needGcal = true; /* softphone + lead panel follow-up pickers are global */
  const _needDmQueue = true; /* softphone Mail tab is global — always load queue helpers */
  const _needReviews = true; /* softphone keypad shows stars on every page */
  const _av = typeof assetVersion !== 'undefined' ? assetVersion : '1';
%>
<%# Shared helpers — deferred so first paint isn't blocked by page-specific JS %>
<script src="/js/script-placeholders.js?v=<%= _av %>" defer></script>
<script src="/js/portaled-popover-surface.js?v=<%= _av %>" defer></script>
<script src="/js/lead-team-badges.js?v=<%= _av %>" defer></script>
<% if (_needGcal) { %>
<script src="/js/gcal-datetime-picker.js?v=<%= _av %>" defer></script>
<% } %>
<% if (_needDmQueue) { %>
<script src="/js/direct-mail-queue.js?v=<%= _av %>" defer></script>
<% } %>
<% if (_needPipeline) { %>
<% if (typeof pipelineTablePrefs !== 'undefined' && pipelineTablePrefs) { %>
<script>window.__SERVER_PIPELINE_TABLE_PREFS = <%- JSON.stringify(pipelineTablePrefs).replace(/</g, '\\u003c') %>;</script>
<% } %>
<script src="/js/pipeline-prefs-prime.js?v=<%= _av %>" defer></script>
<script src="/js/pipeline-import-export-menus.js?v=<%= _av %>" defer></script>
<% } %>
<% if (_np === 'today' || _rp.startsWith('/opportunities')) { %>
<script src="/js/adhello-dialog.js?v=<%= _av %>"></script>
<script src="/js/sortable-loader.js?v=<%= _av %>"></script>
<script src="/js/opportunities-board.js?v=<%= _av %>" defer></script>
<% } %>
<% if (_needReviews) { %>
<script src="/js/review-stars.js?v=<%= _av %>" defer></script>
<script src="/js/review-freshness.js?v=<%= _av %>" defer></script>
<% } %>
<script>window.__ADHELLO_GOOGLE_MAPS_STATIC_KEY__ = <%- JSON.stringify(typeof googleMapsStaticKey === 'string' ? googleMapsStaticKey : '') %>; window.__ADHELLO_LEAD_PANEL_JS_MAP__ = false;</script>
<script src="/js/googleMapsLoader.js?v=<%= _av %>" defer></script>
<script src="/js/osmLeafletMap.js?v=<%= _av %>" defer></script>
<script src="/js/keyboard-nav-shortcuts.js?v=<%= _av %>" defer></script>
<script src="/js/nav-prefetch.js?v=<%= _av %>" defer></script>
<script src="/js/pwa-register.js?v=<%= _av %>" defer></script>
<%# Pages with their own <head> styles after this partial pass { tailwindInPage: true } and include tailwind_css last. %>
<% if (typeof tailwindInPage === 'undefined' || !tailwindInPage) { %>
<%- include('/partials/tailwind_css') %>
<% } %>
