          <button type="button" id="softphoneHoldBtn" class="rounded-lg border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800/80 px-2 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/45" title="Toggle hold (H)" aria-label="Toggle hold">Hold</button>
          <button type="button" id="softphoneHangupBtn" class="rounded-lg bg-rose-600 text-white px-2 py-2 text-[10px] font-black uppercase tracking-widest hover:bg-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-400/55" title="End call (Esc)" aria-label="End call">Hang up</button>
