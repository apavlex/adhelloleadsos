              <input type="tel" id="softphoneToNumber" placeholder="Enter number" inputmode="tel" autocomplete="tel" class="softphone-number-display w-full min-w-0 bg-transparent border-0 p-0 text-[1.35rem] font-semibold tabular-nums text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-0" aria-label="Dial number" />
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <span id="softphoneStatusPill" class="softphone-status-pill">idle</span>
              <span id="softphoneTimer" class="softphone-timer-pill">00:00</span>
            </div>
          </div>
          <p id="softphoneStatus" class="text-[11px] text-slate-500 dark:text-slate-400 mb-1 min-h-[1rem] leading-snug">Enter a number and place a call.</p>
          <div class="flex items-center gap-2 mb-3 min-h-[1rem]">
            <span id="softphoneAudioPulse" class="hidden h-2 w-2 rounded-full bg-emerald-500 motion-safe:animate-pulse"></span>
