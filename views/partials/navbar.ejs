<% const np = typeof navPrimary !== 'undefined' ? navPrimary : ''; %>
<% const _ws = typeof workspace !== 'undefined' && workspace ? workspace : null; %>
<% const _wsList = typeof workspaceSwitcherList !== 'undefined' && workspaceSwitcherList ? workspaceSwitcherList : []; %>
<% const _wsAccent = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : '#CA8A04'; %>
<% const _wsSettingsHash = (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && _ws && _ws.id) ? 'workspace-pipeline' : 'workspace-members'; %>
<header class="sticky top-0 z-50 w-full px-6 py-4 border-t-[3px]" style="border-top-color: <%= _wsAccent %>">
  <div class="max-w-7xl mx-auto flex items-center justify-between bg-white/80 dark:bg-slate-900/80 backdrop-blur-md px-6 py-3 rounded-full border border-brand-border dark:border-white/10 shadow-sm">
    <div class="relative shrink-0 min-w-0 max-w-[min(100%,20rem)] sm:max-w-xs" id="wsSwitcherWrap">
      <button type="button" id="wsSwitcherBtn" class="flex items-center gap-2 sm:gap-2.5 group h-9 sm:h-10 w-full min-w-0 text-left rounded-xl px-1 py-1 hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-colors" aria-expanded="false" aria-haspopup="true" aria-controls="wsSwitcherMenu">
        <span class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center overflow-hidden rounded-[22%]" aria-hidden="true">
          <img src="/images/adhello-app-icon.png" alt="" width="40" height="40" class="h-full w-full object-contain" loading="eager" decoding="async" />
        </span>
        <span class="min-w-0 flex-1 hidden sm:flex flex-col">
          <span class="font-display font-black text-sm tracking-tight text-brand-dark dark:text-white truncate"><%= _ws && _ws.name ? _ws.name : 'Workspace' %></span>
          <span class="text-[9px] font-bold text-brand-muted truncate">Agency OS</span>
        </span>
        <span class="w-2 h-2 rounded-full shrink-0 sm:ml-0.5" style="background-color: <%= _wsAccent %>" aria-hidden="true"></span>
        <svg class="w-4 h-4 shrink-0 text-brand-muted hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </button>
      <div id="wsSwitcherMenu" class="hidden absolute left-0 mt-2 w-72 max-w-[90vw] rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 z-[120] text-left" role="menu">
        <p class="px-4 py-2 text-[9px] font-black uppercase tracking-widest text-brand-muted">Workspaces</p>
        <% _wsList.forEach(function (w) { %>
        <form method="post" action="/workspaces/switch" class="block">
          <input type="hidden" name="workspaceId" value="<%= w.id %>" />
          <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 flex items-center gap-2" role="menuitem">
            <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= w.accentColor || '#CA8A04' %>"></span>
            <span class="truncate"><%= w.name %></span>
          </button>
        </form>
        <% }) %>
        <div class="border-t border-brand-border dark:border-white/10 mt-1 pt-1">
          <a href="/workspaces/new" class="block px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10">+ Create workspace</a>
          <p class="px-4 pt-2 pb-1 text-[9px] font-black uppercase tracking-widest text-brand-muted">Workspace</p>
          <a href="/workspace#workspace-sales-scripts" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 pl-6">Sales scripts</a>
          <a href="/workspace#workspace-voicemail" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 pl-6">Voicemail</a>
          <a href="/workspace#<%= _wsSettingsHash %>" class="block px-4 py-2.5 text-sm text-brand-muted hover:bg-brand-cream/40 dark:hover:bg-white/10 pl-6">Workspace settings</a>
        </div>
      </div>
    </div>

    <!-- Primary nav -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-6 flex-wrap justify-center" aria-label="Primary">
      <a href="/today" class="nav-link text-sm <%= np === 'today' ? 'active' : '' %>">Today</a>
      <a href="/find" class="nav-link text-sm <%= np === 'find' ? 'active' : '' %>">Find Leads</a>
      <a href="/prospecting" class="nav-link text-sm <%= np === 'prospecting' ? 'active' : '' %>">Prospecting</a>
      <a href="/sales/personas" class="nav-link text-sm <%= np === 'sales' ? 'active' : '' %>">Scripts</a>
      <a href="/tasks" class="nav-link text-sm <%= np === 'tasks' ? 'active' : '' %>">Tasks</a>
      <a href="/analytics" class="nav-link text-sm <%= np === 'reports' ? 'active' : '' %>">Reports</a>
      <a href="https://app.adhello.ai" target="_blank" rel="noopener noreferrer" class="nav-link text-sm">Manage Ads</a>
      <a href="/resources" class="nav-link text-sm <%= np === 'resources' ? 'active' : '' %>">Resources</a>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <% if (user) { %>
      <button type="button" id="manualLeadOpen" class="inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-yellow text-slate-900 px-3 sm:px-4 py-2 text-[10px] sm:text-[11px] font-black uppercase tracking-widest shadow-lg shadow-brand-yellow/40 hover:shadow-xl hover:shadow-brand-yellow/55 hover:brightness-105 active:scale-[0.98] transition-all border border-amber-400/30 dark:border-amber-300/20">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        <span class="hidden min-[400px]:inline">Add lead</span>
        <span class="min-[400px]:hidden">Add</span>
      </button>
      <% } %>
      <div id="processingIndicator" class="bell-icon-wrapper nav-bell w-10 h-10 flex items-center justify-center text-brand-dark dark:text-gray-300 rounded-full hover:bg-brand-cream dark:hover:bg-gray-800 transition-all cursor-pointer relative">
        <div class="processing-ring"></div>
        <span id="bulkEnhanceBellBadge" class="hidden absolute bottom-0 right-0 min-w-[1.35rem] h-[1.15rem] px-1 rounded-md bg-emerald-600 text-white text-[8px] font-black leading-none flex items-center justify-center border-2 border-white dark:border-slate-900 shadow-sm z-[2] tabular-nums" aria-hidden="true"></span>
        <div id="notificationPing" class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full hidden"></div>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
        <div id="notificationDropdown" class="absolute top-full mt-3 right-0 w-80 bg-white dark:bg-slate-900 shadow-2xl rounded-2xl hidden p-0 border border-brand-border dark:border-white/10 z-[100] animate-slide-up overflow-hidden">
          <div class="p-4 border-b border-brand-border dark:border-white/5 bg-brand-cream/30 dark:bg-white/5">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Notifications</h3>
          </div>
          <div id="notificationList" class="max-h-[320px] overflow-y-auto">
            <div class="p-8 text-center text-brand-muted dark:text-slate-500 italic text-[11px]">
              No new notifications
            </div>
          </div>
          <div id="notificationDesktopRow" class="hidden p-3 border-t border-brand-border dark:border-white/5">
            <button type="button" id="navNotifyEnable" class="w-full text-left rounded-xl px-2 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 transition-colors">
              Enable desktop alerts (runs &amp; reminders)
            </button>
          </div>
          <div class="p-3 border-t border-brand-border dark:border-white/5 text-center">
            <a href="/history" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">View history</a>
          </div>
        </div>
      </div>

      <button id="navSoftphoneOpen" type="button" class="w-10 h-10 flex items-center justify-center text-brand-dark hover:bg-brand-cream dark:text-gray-300 dark:hover:bg-gray-800 rounded-full transition-colors border border-transparent" aria-label="Open softphone">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6h6M12 17h.01" />
        </svg>
      </button>

      <button id="themeToggleBtn" type="button" class="w-10 h-10 flex items-center justify-center text-brand-dark hover:bg-brand-cream dark:text-gray-300 dark:hover:bg-gray-800 rounded-full transition-colors" aria-label="Toggle theme">
        <svg class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364l-1.414-1.414M7.05 7.05L5.636 5.636m12.728 0l-1.414 1.414M7.05 16.95l-1.414 1.414M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <% if (user) { %>
      <div class="relative hidden sm:block" id="userMenuDesktop">
        <button type="button" id="userMenuBtn" class="flex items-center gap-2 rounded-full border border-brand-border dark:border-white/10 bg-brand-cream/50 dark:bg-slate-800 pl-1 pr-2 py-1 hover:bg-brand-cream dark:hover:bg-slate-700 transition-colors" aria-expanded="false" aria-haspopup="true" aria-controls="userMenuPanel">
          <span class="w-8 h-8 rounded-full bg-brand-cream border border-brand-border flex items-center justify-center font-bold text-brand-dark text-xs overflow-hidden shrink-0">
            <% if (user.photos && user.photos.length > 0) { %>
              <img src="<%= user.photos[0].value %>" alt="" class="w-full h-full object-cover">
            <% } else { %>
              <%= (user.displayName || (user.emails?.[0]?.value || 'U'))[0].toUpperCase() %>
            <% } %>
          </span>
          <svg class="w-4 h-4 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="userMenuPanel" class="hidden absolute right-0 mt-2 w-56 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 z-[110] text-left" role="menu">
          <div class="px-4 py-2 border-b border-brand-border/50 dark:border-white/10">
            <div class="text-xs font-bold text-brand-dark dark:text-white truncate"><%= user.displayName || (user.emails?.[0]?.value || 'User').split('@')[0] %></div>
            <div class="text-[10px] text-brand-muted truncate" title="<%= user.emails?.[0]?.value || '' %>"><%= user.emails?.[0]?.value || '' %></div>
          </div>
          <a href="/workspace#<%= _wsSettingsHash %>" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">Team &amp; workspace</a>
          <a href="/activation" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">7-day activation</a>
          <button type="button" id="connectAiOpen" class="w-full text-left px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">Connect AI</button>
          <a href="/logout" class="block px-4 py-2.5 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30">Log out</a>
        </div>
      </div>
      <% } else { %>
      <a href="/auth/google" class="btn-pill btn-primary px-4 py-2 text-sm font-bold shadow-sm whitespace-nowrap hidden sm:inline-flex">Login</a>
      <% } %>

      <button id="mobileMenuBtn" type="button" class="md:hidden w-10 h-10 flex items-center justify-center text-brand-dark hover:bg-brand-cream rounded-full transition-colors border border-brand-border" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobileMenu" class="fixed inset-0 z-[100] bg-brand-dark/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300 pointer-events-none">
    <div class="absolute inset-y-0 right-0 w-72 max-w-[90vw] bg-white dark:bg-slate-900 shadow-2xl p-8 translate-x-full transition-transform duration-300 pointer-events-auto overflow-y-auto">
      <div class="flex items-center justify-between mb-8">
        <span class="font-display font-extrabold text-xl tracking-tight text-brand-dark dark:text-white">Menu</span>
        <button id="closeMobileMenu" type="button" class="w-10 h-10 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white rounded-full transition-colors border border-brand-border dark:border-white/10" aria-label="Close menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <nav class="flex flex-col gap-3 mb-8" aria-label="Mobile primary">
        <a href="/today" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'today' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Today</span></a>
        <a href="/find" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'find' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Find Leads</span></a>
        <a href="/prospecting" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'prospecting' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Prospecting</span></a>
        <a href="/sales/personas" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'sales' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Scripts</span></a>
        <a href="/tasks" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'tasks' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Tasks</span></a>
        <a href="/analytics" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'reports' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Reports</span></a>
        <a href="https://app.adhello.ai" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 text-brand-muted"><span class="font-display font-bold text-lg">Manage Ads</span><span class="ml-auto text-[10px] font-black uppercase text-brand-muted">↗</span></a>
        <a href="/resources" class="flex items-center p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 <%= np === 'resources' ? 'bg-brand-yellow/10 border-brand-yellow text-brand-dark dark:text-white' : 'text-brand-muted' %>"><span class="font-display font-bold text-lg">Resources</span></a>
        <% if (user) { %>
        <button type="button" id="manualLeadOpenMobile" class="flex items-center justify-center gap-2 p-4 rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 text-brand-dark dark:text-white font-display font-bold text-lg text-left w-full">
          <svg class="w-5 h-5 text-brand-yellow shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          Add lead (offline / referral)
        </button>
        <button type="button" id="navSoftphoneOpenMobile" class="flex items-center justify-center gap-2 p-4 rounded-2xl border border-brand-border/50 dark:border-white/10 text-brand-dark dark:text-white font-display font-bold text-lg text-left w-full">
          <svg class="w-5 h-5 text-brand-yellow shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 6h6M12 17h.01" /></svg>
          Softphone
        </button>
        <% } %>
      </nav>

      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">Settings</p>
      <nav class="flex flex-col gap-2 mb-8">
        <a href="/workspace#workspace-sales-scripts" class="px-4 py-3 rounded-xl border border-brand-border/40 text-sm font-semibold text-brand-dark dark:text-white">Sales scripts</a>
        <a href="/workspace#workspace-voicemail" class="px-4 py-3 rounded-xl border border-brand-border/40 text-sm font-semibold text-brand-dark dark:text-white">Voicemail</a>
        <a href="/workspace#<%= _wsSettingsHash %>" class="px-4 py-3 rounded-xl border border-brand-border/40 text-sm font-semibold text-brand-dark dark:text-white">Team &amp; workspace</a>
        <a href="/activation" class="px-4 py-3 rounded-xl border border-brand-border/40 text-sm font-semibold text-brand-dark dark:text-white">7-day activation</a>
        <button type="button" id="connectAiOpenMobile" class="w-full text-left px-4 py-3 rounded-xl border border-brand-border/40 text-sm font-semibold text-brand-dark dark:text-white">Connect AI</button>
      </nav>

      <div class="pt-6 border-t border-brand-border dark:border-white/10">
        <% if (user) { %>
        <a href="/logout" class="text-sm font-bold text-red-600 dark:text-red-400">Log out</a>
        <% } else { %>
        <a href="/auth/google" class="text-sm font-bold text-brand-yellow">Login</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (user) { %>
  <div id="manualLeadModal" class="fixed inset-0 z-[210] hidden items-center justify-center p-4" aria-hidden="true">
    <div id="manualLeadBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm"></div>
    <div class="relative max-w-lg w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-2xl z-10 max-h-[90vh] overflow-y-auto">
      <div class="flex items-start justify-between gap-3 mb-6">
        <div>
          <h2 class="font-display font-black text-xl text-brand-dark dark:text-white">Add lead</h2>
          <p class="text-sm text-brand-muted mt-1">For referrals, events, or anyone you met offline — same pipeline as scraped leads.</p>
        </div>
        <button type="button" id="manualLeadClose" class="w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center shrink-0" aria-label="Close">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <form id="manualLeadForm" class="space-y-4">
        <div>
          <label for="manualTitle" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Business name <span class="text-red-500">*</span></label>
          <input type="text" id="manualTitle" name="title" required maxlength="200" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:ring-2 focus:ring-brand-yellow" placeholder="e.g. Ramos Painting" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="manualEmail" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Email</label>
            <input type="email" id="manualEmail" name="email" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white" placeholder="Optional" />
          </div>
          <div>
            <label for="manualPhone" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Phone</label>
            <input type="tel" id="manualPhone" name="phone" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white" placeholder="Optional" />
          </div>
        </div>
        <div>
          <label for="manualWebsite" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Website</label>
          <input type="text" id="manualWebsite" name="website" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white" placeholder="example.com" />
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div class="col-span-2 sm:col-span-1">
            <label for="manualCity" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">City</label>
            <input type="text" id="manualCity" name="city" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white" />
          </div>
          <div>
            <label for="manualState" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">State</label>
            <input type="text" id="manualState" name="state" maxlength="2" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm uppercase text-brand-dark dark:text-white" placeholder="OR" />
          </div>
        </div>
        <div>
          <label for="manualAddress" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Address</label>
          <input type="text" id="manualAddress" name="address" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white" placeholder="Optional" />
        </div>
        <div>
          <label for="manualNote" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">How you found them</label>
          <textarea id="manualNote" name="note" rows="3" maxlength="2000" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted/50 resize-y" placeholder="Referral name, event, neighborhood…"></textarea>
        </div>
        <p id="manualLeadError" class="text-sm text-red-600 dark:text-red-400 hidden"></p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button type="submit" id="manualLeadSubmit" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Save to pipeline</button>
          <button type="button" id="manualLeadCancel" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <div id="connectAiModal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4" aria-hidden="true">
    <div id="connectAiBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white mb-2">Connect AI</h2>
      <p class="text-sm text-brand-muted leading-relaxed mb-6">AI keys are configured in your deployment environment (for example Cloud Run variables or Replit secrets), not in this UI. Ask your admin to add the provider credentials there.</p>
      <button type="button" id="connectAiClose" class="w-full py-3 rounded-xl text-sm font-black uppercase tracking-widest bg-brand-dark text-white dark:bg-white dark:text-slate-900">Close</button>
    </div>
  </div>

  <div id="softphoneModal" class="hidden fixed z-[215] inset-0 pointer-events-none" aria-hidden="true">
    <div id="softphonePanel" class="fixed z-[220] pointer-events-auto w-[min(100vw-1.5rem,24rem)] max-h-[calc(100vh-4.5rem)] flex flex-col rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-2xl ring-1 ring-black/5 dark:ring-white/5 overflow-hidden" style="right:0.75rem;top:4.5rem;left:auto;">
      <div id="softphoneDragHandle" class="flex items-start justify-between gap-2 px-3 pt-3 pb-2 border-b border-brand-border/20 dark:border-white/10 cursor-grab active:cursor-grabbing select-none">
        <div class="flex items-start gap-2 min-w-0 flex-1">
          <span class="shrink-0 w-3.5 mt-1 text-slate-400 dark:text-slate-500" title="Drag to move" aria-hidden="true">
            <svg class="w-3.5 h-4" fill="currentColor" viewBox="0 0 12 20" aria-hidden="true"><circle cx="2" cy="4" r="1.5"/><circle cx="6" cy="4" r="1.5"/><circle cx="10" cy="4" r="1.5"/><circle cx="2" cy="10" r="1.5"/><circle cx="6" cy="10" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="2" cy="16" r="1.5"/><circle cx="6" cy="16" r="1.5"/><circle cx="10" cy="16" r="1.5"/></svg>
          </span>
          <div class="min-w-0">
            <h2 class="font-display font-black text-lg text-brand-dark dark:text-white leading-tight">Softphone</h2>
            <p id="softphoneStatus" class="text-xs text-brand-muted mt-0.5 leading-snug">Enter a number and place a call.</p>
            <p id="softphoneModeLine" class="text-[10px] text-brand-muted/90 mt-1.5 leading-snug"></p>
          </div>
        </div>
        <div class="flex flex-col items-end gap-1 shrink-0">
          <button type="button" id="softphoneClose" class="w-9 h-9 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center" aria-label="Close" title="Close">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
          <button type="button" id="softphoneDockRight" class="text-[9px] font-bold uppercase tracking-widest text-brand-yellow hover:underline py-0.5 bg-transparent border-0 cursor-pointer" title="Snap to right">Dock right</button>
        </div>
      </div>
      <div class="p-4 pt-3 flex-1 overflow-y-auto min-h-0">
      <div class="space-y-3">
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted">Outbound number
          <select id="softphoneFromNumber" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-white">
            <option value="">Default workspace number</option>
          </select>
        </label>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted">Dial number
          <input type="tel" id="softphoneToNumber" placeholder="+15551234567" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-base font-semibold text-brand-dark dark:text-white" />
        </label>
      </div>
      <div class="grid grid-cols-3 gap-2 mt-3">
        <% ['1','2','3','4','5','6','7','8','9','*','0','#'].forEach(function (k) { %>
        <button type="button" class="softphone-key rounded-xl border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-800 py-2 text-sm font-black text-brand-dark dark:text-white" data-key="<%= k %>"><%= k %></button>
        <% }); %>
      </div>
      <div class="mt-4 flex gap-2">
        <button type="button" id="softphoneCallBtn" class="flex-1 btn-pill bg-emerald-600 text-white py-3 text-xs font-black uppercase tracking-widest hover:bg-emerald-500 transition-colors">Call</button>
        <button type="button" id="softphoneVmBtn" class="flex-1 btn-pill bg-violet-600 text-white py-3 text-xs font-black uppercase tracking-widest hover:bg-violet-500 transition-colors">Voicemail drop</button>
      </div>
      <div class="mt-3 rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-3">
        <div class="flex items-center justify-between gap-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Call state</p>
          <span id="softphoneCallState" class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Idle</span>
        </div>
        <div class="mt-2 flex gap-2">
          <button type="button" id="softphoneMuteBtn" class="flex-1 rounded-lg border border-brand-border/60 dark:border-white/15 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Mute</button>
          <button type="button" id="softphoneHoldBtn" class="flex-1 rounded-lg border border-brand-border/60 dark:border-white/15 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Hold</button>
          <button type="button" id="softphoneHangupBtn" class="flex-1 rounded-lg bg-rose-600 text-white px-2 py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-rose-500">Hang up</button>
        </div>
        <button type="button" id="softphoneVmNowBtn" class="mt-2 w-full rounded-lg border border-violet-500/40 bg-violet-600/10 text-violet-700 dark:text-violet-300 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-violet-600/20">Drop VM + Next</button>
      </div>
      <div class="mt-3 rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Post-call wrap-up (required before next dial)</p>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted">Disposition
          <select id="softphoneDisposition" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs">
            <option value="">Select disposition...</option>
            <option value="Connected">Connected</option>
            <option value="Voicemail">Voicemail</option>
            <option value="No Answer">No answer</option>
            <option value="Gatekeeper">Gatekeeper</option>
            <option value="Wrong Number">Wrong number</option>
            <option value="Callback Requested">Callback requested</option>
          </select>
        </label>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mt-2">Call notes
          <textarea id="softphoneNotes" rows="3" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" placeholder="Key objection, promise, timing, decision-maker..."></textarea>
        </label>
        <div class="mt-2 flex gap-2">
          <button type="button" id="softphoneAiSummaryBtn" class="flex-1 rounded-lg border border-brand-border/60 dark:border-white/15 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">AI summary</button>
          <button type="button" id="softphoneCompleteWrapBtn" class="flex-1 rounded-lg bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-2 py-1.5 text-[10px] font-black uppercase tracking-widest">Complete wrap</button>
        </div>
        <p id="softphoneNextStep" class="mt-2 text-[11px] text-brand-muted"></p>
      </div>
      <div class="mt-4 pt-3 border-t border-brand-border/40 dark:border-white/10">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Recent dials</p>
        <div id="softphoneRecentList" class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
          <p class="text-xs text-brand-muted">No recent numbers yet.</p>
        </div>
      </div>
    </div>
    </div>
  </div>
</header>
<script>
(function () {
  var wsb = document.getElementById('wsSwitcherBtn');
  var wsm = document.getElementById('wsSwitcherMenu');
  var wsw = document.getElementById('wsSwitcherWrap');
  function closeWsMenu() {
    if (!wsm || !wsb) return;
    wsm.classList.add('hidden');
    wsb.setAttribute('aria-expanded', 'false');
  }
  if (wsb && wsm && wsw) {
    wsb.addEventListener('click', function (e) {
      e.stopPropagation();
      wsm.classList.toggle('hidden');
      wsb.setAttribute('aria-expanded', (!wsm.classList.contains('hidden')).toString());
    });
    document.addEventListener('click', closeWsMenu);
    wsw.addEventListener('click', function (e) { e.stopPropagation(); });
  }
})();
(function () {
  var btn = document.getElementById('userMenuBtn');
  var panel = document.getElementById('userMenuPanel');
  function closeMenu() {
    if (!panel || !btn) return;
    panel.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
  }
  if (btn && panel) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', (!panel.classList.contains('hidden')).toString());
    });
    document.addEventListener('click', closeMenu);
    panel.addEventListener('click', function (e) { e.stopPropagation(); });
  }
  function openConnectModal() {
    var m = document.getElementById('connectAiModal');
    if (m) { m.classList.remove('hidden'); m.classList.add('flex'); m.setAttribute('aria-hidden', 'false'); }
    closeMenu();
  }
  function closeConnectModal() {
    var m = document.getElementById('connectAiModal');
    if (m) { m.classList.add('hidden'); m.classList.remove('flex'); m.setAttribute('aria-hidden', 'true'); }
  }
  var o = document.getElementById('connectAiOpen');
  var om = document.getElementById('connectAiOpenMobile');
  var c = document.getElementById('connectAiClose');
  var bd = document.getElementById('connectAiBackdrop');
  if (o) o.addEventListener('click', openConnectModal);
  if (om) om.addEventListener('click', openConnectModal);
  if (c) c.addEventListener('click', closeConnectModal);
  if (bd) bd.addEventListener('click', closeConnectModal);

  var spModal = document.getElementById('softphoneModal');
  var spPanel = document.getElementById('softphonePanel');
  var spModeLine = document.getElementById('softphoneModeLine');
  var spOpen = document.getElementById('navSoftphoneOpen');
  var spOpenMobile = document.getElementById('navSoftphoneOpenMobile');
  var spClose = document.getElementById('softphoneClose');
  var spDockRight = document.getElementById('softphoneDockRight');
  var spDragHandle = document.getElementById('softphoneDragHandle');
  var SOFTPHONE_POS_KEY = 'adhelloSoftphonePos';
  var spStatus = document.getElementById('softphoneStatus');
  var spFrom = document.getElementById('softphoneFromNumber');
  var spTo = document.getElementById('softphoneToNumber');
  var spCall = document.getElementById('softphoneCallBtn');
  var spVm = document.getElementById('softphoneVmBtn');
  var spKeys = document.querySelectorAll('.softphone-key');
  var spRecentList = document.getElementById('softphoneRecentList');
  var spCallState = document.getElementById('softphoneCallState');
  var spMute = document.getElementById('softphoneMuteBtn');
  var spHold = document.getElementById('softphoneHoldBtn');
  var spHangup = document.getElementById('softphoneHangupBtn');
  var spVmNow = document.getElementById('softphoneVmNowBtn');
  var spDisposition = document.getElementById('softphoneDisposition');
  var spNotes = document.getElementById('softphoneNotes');
  var spAiSummary = document.getElementById('softphoneAiSummaryBtn');
  var spCompleteWrap = document.getElementById('softphoneCompleteWrapBtn');
  var spNextStep = document.getElementById('softphoneNextStep');
  var SOFTPHONE_RECENT_KEY = 'softphoneRecentNumbers';
  var spRelayWebrtc = false;
  var spWorkspaceCallMode = 'cloud_dial';
  var spDefaultFrom = '';
  var softphoneSession = {
    state: 'idle',
    muted: false,
    hold: false,
    wrapRequired: false,
    activeNumber: '',
    callSid: '',
    pollTimer: null,
    webrtcDialWatchdog: null,
    webrtc: false,
    relayClient: null,
    relayCall: null,
    isCloudPstn: false,
  };
  var RELAY_SDK_SRC = 'https://unpkg.com/@signalwire/js@1.5.0/dist/index.min.js';
  function loadRelayScript() {
    return new Promise(function (resolve, reject) {
      if (typeof window.Relay !== 'undefined') return resolve();
      var existing = document.querySelector('script[data-signalwire-relay]');
      if (existing) {
        existing.addEventListener('load', function () { resolve(); });
        existing.addEventListener('error', reject);
        return;
      }
      var s = document.createElement('script');
      s.src = RELAY_SDK_SRC;
      s.async = true;
      s.setAttribute('data-signalwire-relay', '1');
      s.onload = function () { resolve(); };
      s.onerror = function () { reject(new Error('Failed to load SignalWire Relay SDK.')); };
      document.head.appendChild(s);
    });
  }
  function softphoneClearWebrtcSession() {
    webrtcClearDialWatchdog();
    try {
      if (softphoneSession.relayClient) {
        softphoneSession.relayClient.disconnect();
      }
    } catch (e) {}
    softphoneSession.relayClient = null;
    softphoneSession.relayCall = null;
    softphoneSession.webrtc = false;
  }
  function softphoneDestroyWebrtc() {
    try {
      if (softphoneSession.relayCall) {
        softphoneSession.relayCall.hangup({ cause: 'NORMAL_CLEARING' }, true);
      }
    } catch (e) {}
    softphoneSession.relayCall = null;
    try {
      if (softphoneSession.relayClient) {
        softphoneSession.relayClient.disconnect();
      }
    } catch (e) {}
    softphoneSession.relayClient = null;
    softphoneSession.webrtc = false;
  }
  function webrtcClearDialWatchdog() {
    if (softphoneSession.webrtcDialWatchdog) {
      clearTimeout(softphoneSession.webrtcDialWatchdog);
      softphoneSession.webrtcDialWatchdog = null;
    }
  }
  function webrtcStartDialWatchdog() {
    webrtcClearDialWatchdog();
    softphoneSession.webrtcDialWatchdog = setTimeout(function () {
      if (softphoneSession.state !== 'dialing' || !softphoneSession.webrtc) return;
      softphoneSetStatus(
        'Still in “requesting” (WebRTC is setting up the call). If this never connects: allow microphone, try another number, or switch Workspace → call routing to “Cloud dial (SignalWire).” If it persists, check SignalWire logs and browser console for errors.',
        true,
      );
    }, 35000);
  }
  function webrtcOnNotification(notification) {
    if (!notification || !notification.call) return;
    var c = notification.call;
    var st = String(c.state || '').toLowerCase();
    if (st === 'ringing' || st === 'trying' || st === 'requesting' || st === 'early' || st === 'answering' || st === 'new') {
      softphoneSetCallState('dialing');
      if (spCallState) spCallState.textContent = st ? 'dialing · ' + st : 'dialing';
    } else if (st === 'active') {
      webrtcClearDialWatchdog();
      softphoneSetCallState('in_call');
      softphoneSetStatus('In call (WebRTC).');
    } else if (st === 'held') {
      softphoneSetCallState('in_call');
      softphoneSetStatus('On hold (WebRTC).');
    } else if (
      st === 'failed' ||
      st === 'rejected' ||
      st === 'busy' ||
      st === 'no-answer' ||
      st === 'cancel' ||
      st === 'decline' ||
      st === 'error' ||
      st === 'canceled' ||
      st === 'unanswered' ||
      st === 'congestion'
    ) {
      webrtcClearDialWatchdog();
      softphoneClearWebrtcSession();
      softphoneSetCallState('ended');
      softphoneSetWrapRequired(true);
      softphoneSetStatus('Call did not connect (WebRTC: ' + (st || 'error') + '). Check the number, your SignalWire number/caller ID, and account. Complete wrap-up to try again or use “Cloud dial” in Workspace.');
    } else if (st === 'hangup' || st === 'destroy' || st === 'purge') {
      webrtcClearDialWatchdog();
      softphoneClearWebrtcSession();
      softphoneSetCallState('ended');
      softphoneSetWrapRequired(true);
      softphoneSetStatus('Call ended. Complete wrap-up to unlock next dial.');
    }
  }
  function normalizeDial(raw) {
    var s = String(raw || '').trim();
    if (!s) return '';
    var v = s.replace(/[^\d+]/g, '');
    if (!v) return '';
    if (v.charAt(0) !== '+' && v.length === 10) return '+1' + v;
    if (v.charAt(0) !== '+') return '+' + v;
    return v;
  }
  function getRecentDials() {
    try {
      var raw = localStorage.getItem(SOFTPHONE_RECENT_KEY) || '[]';
      var arr = JSON.parse(raw);
      if (!Array.isArray(arr)) return [];
      return arr.map(function (x) { return normalizeDial(x); }).filter(Boolean).slice(0, 10);
    } catch (_) {
      return [];
    }
  }
  function saveRecentDials(arr) {
    try { localStorage.setItem(SOFTPHONE_RECENT_KEY, JSON.stringify((arr || []).slice(0, 10))); } catch (_) {}
  }
  function addRecentDial(num) {
    var n = normalizeDial(num);
    if (!n) return;
    var cur = getRecentDials().filter(function (x) { return x !== n; });
    cur.unshift(n);
    saveRecentDials(cur);
    renderRecentDials();
  }
  function renderRecentDials() {
    if (!spRecentList) return;
    var list = getRecentDials();
    spRecentList.innerHTML = '';
    if (!list.length) {
      spRecentList.innerHTML = '<p class="text-xs text-brand-muted">No recent numbers yet.</p>';
      return;
    }
    list.forEach(function (num) {
      var row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-2 rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/60 px-2.5 py-2';
      row.innerHTML =
        '<button type="button" class="softphone-recent-fill text-sm font-semibold text-brand-dark dark:text-white hover:text-brand-yellow truncate text-left flex-1" data-number="' + num + '">' + num + '</button>' +
        '<button type="button" class="softphone-recent-call text-[10px] font-black uppercase tracking-widest rounded-lg bg-emerald-600 text-white px-2 py-1 hover:bg-emerald-500" data-number="' + num + '">Call</button>';
      spRecentList.appendChild(row);
    });
  }
  function softphoneSetStatus(msg, isErr) {
    if (!spStatus) return;
    spStatus.textContent = msg || '';
    spStatus.className = 'text-sm mt-1 ' + (isErr ? 'text-red-600 dark:text-red-400' : 'text-brand-muted');
  }
  function updateCallStateLabel() {
    if (!spCallState) return;
    var s = String(softphoneSession.state || 'idle');
    if (s === 'idle' || s === 'ready' || s === 'ended') {
      spCallState.textContent = s;
      return;
    }
    if (softphoneSession.isCloudPstn) {
      if (s === 'dialing') { spCallState.textContent = 'dialing · cloud (PSTN only)'; return; }
      if (s === 'in_call') { spCallState.textContent = 'connected · no audio in this tab'; return; }
    } else if (softphoneSession.webrtc) { spCallState.textContent = s + ' · WebRTC'; return; }
    spCallState.textContent = s;
  }
  function softphoneSetCallState(state) {
    softphoneSession.state = state;
    var needsWrap = !!softphoneSession.wrapRequired;
    if (spCall) spCall.disabled = needsWrap;
    if (spVm) spVm.disabled = needsWrap;
    updateCallStateLabel();
  }
  function softphoneStopPolling() {
    if (softphoneSession.pollTimer) {
      clearInterval(softphoneSession.pollTimer);
      softphoneSession.pollTimer = null;
    }
  }
  function applyCloudPollState(st, durationStr) {
    if (st === 'completed' || st === 'canceled' || st === 'failed' || st === 'busy' || st === 'no-answer') {
      softphoneSetCallState('ended');
      softphoneSetWrapRequired(true);
      softphoneSetStatus('Call ended (' + st + '). Complete wrap-up to unlock next dial.');
      softphoneStopPolling();
      softphoneSession.isCloudPstn = false;
      return;
    }
    if (st === 'in-progress' || st === 'inprogress' || st === 'answered') {
      if (softphoneSession.isCloudPstn) {
        softphoneSetStatus('The remote end answered. No in-browser audio in cloud mode. Mute/hold are display only here.');
      }
      softphoneSetCallState('in_call');
    } else if (st === 'ringing' || st === 'queued' || st === 'initiated' || st === 'trying' || st === 'early') {
      if (softphoneSession.isCloudPstn) {
        softphoneSetStatus('Cloud leg is ringing the contact. There is no sound in this tab — the call is on the PSTN.');
      } else { softphoneSetStatus('Call progressing…'); }
      softphoneSetCallState('dialing');
    } else { softphoneSetCallState('dialing'); }
    if (spCallState && durationStr && (softphoneSession.state === 'in_call' && (st === 'in-progress' || st === 'inprogress' || st === 'answered'))) {
      if (softphoneSession.isCloudPstn) {
        spCallState.textContent = 'in call · ' + String(durationStr) + 's — no tab audio (cloud PSTN)';
      } else { spCallState.textContent = 'in_call · ' + String(durationStr) + 's'; }
    }
  }
  function softphoneStatusPollOnce() {
    if (!softphoneSession.callSid) return;
    fetch('/leads/telephony/call-status?callSid=' + encodeURIComponent(softphoneSession.callSid), {
      method: 'GET',
