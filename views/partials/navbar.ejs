  <div id="softphoneModal" class="hidden fixed z-[255] inset-0 pointer-events-none" aria-hidden="true">
    <button type="button" id="softphoneMobileBackdrop" class="md:hidden fixed inset-0 z-[258] min-h-[100dvh] bg-brand-dark/50 pointer-events-auto hidden" aria-label="Close dialer" tabindex="-1"></button>
    <div id="softphonePanel" class="softphone-panel fixed z-[260] pointer-events-auto w-full max-w-none md:w-[min(100vw-1rem,21.5rem)] h-full min-h-0 max-h-[100dvh] md:h-[min(700px,calc(100vh-4.5rem))] md:max-h-[min(700px,calc(100vh-4.5rem))] flex flex-col max-md:rounded-none md:rounded-[1.35rem] max-md:border-0 md:border border-slate-200/80 dark:border-white/10 bg-[#f7f7f8] dark:bg-slate-900 md:shadow-[0_18px_50px_rgba(15,23,42,0.18)] overflow-hidden" style="right:0.75rem;top:4.5rem;left:auto;">
      <div id="softphoneDragHandle" class="softphone-chrome flex items-center justify-between gap-2 px-3 pt-[max(0.65rem,env(safe-area-inset-top))] md:pt-2.5 pb-2 border-b border-slate-200/70 dark:border-white/10 max-md:cursor-default md:cursor-grab md:active:cursor-grabbing max-md:select-text md:select-none bg-white/90 dark:bg-slate-900/90">
        <span class="softphone-drag-dots shrink-0 text-slate-400 dark:text-slate-500 max-md:hidden" title="Drag to move" aria-hidden="true">
          <svg class="w-4 h-5" fill="currentColor" viewBox="0 0 12 20" aria-hidden="true"><circle cx="2" cy="4" r="1.5"/><circle cx="6" cy="4" r="1.5"/><circle cx="10" cy="4" r="1.5"/><circle cx="2" cy="10" r="1.5"/><circle cx="6" cy="10" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="2" cy="16" r="1.5"/><circle cx="6" cy="16" r="1.5"/><circle cx="10" cy="16" r="1.5"/></svg>
        </span>
        <div class="flex items-center gap-1.5 ml-auto shrink-0">
          <button type="button" id="softphoneSettingsBtn" class="softphone-chrome-btn" aria-label="Dialer settings" title="Settings">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </button>
          <button type="button" id="softphonePinBtn" class="softphone-chrome-btn" aria-label="Pin dialer to sidebar" title="Pin dialer" aria-pressed="false">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
          </button>
          <button type="button" id="softphoneExpandBtn" class="softphone-chrome-btn" aria-label="Expand dialer" title="Expand">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          </button>
          <button type="button" id="softphoneClose" class="softphone-chrome-btn" aria-label="Close AdHello dialer" title="Close">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <button type="button" id="softphoneDockRight" class="sr-only" tabindex="-1" aria-hidden="true">Dock right</button>
      </div>

      <div id="softphoneLiveAnnouncer" class="sr-only" role="status" aria-live="polite"></div>
      <audio id="softphoneRemoteAudio" autoplay playsinline class="sr-only" aria-hidden="true"></audio>
      <audio id="softphoneLocalAudio" autoplay playsinline muted class="sr-only" aria-hidden="true"></audio>
      <audio id="softphoneSoundcheckAudio" autoplay playsinline class="sr-only" aria-hidden="true"></audio>

      <div class="softphone-body flex-1 min-h-0 overflow-hidden flex flex-col bg-[#f7f7f8] dark:bg-slate-900">
        <div id="softphoneTabKeypad" class="softphone-tab-panel flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 pt-3 pb-4" data-tab="keypad">
          <div class="softphone-calling-from mb-3 rounded-xl border border-brand-border/50 dark:border-white/10 bg-white/80 dark:bg-slate-800/60 px-3 py-2.5">
            <label for="softphoneCallerIdSelect" class="text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300 block mb-1.5">Your caller ID</label>
            <select id="softphoneCallerIdSelect" class="softphone-caller-id-select w-full min-w-0 bg-transparent border-0 p-0 text-[1.05rem] font-semibold tabular-nums text-slate-800 dark:text-white focus:outline-none focus:ring-0 appearance-none cursor-pointer" aria-label="Caller ID shown to leads">
              <option value="">—</option>
            </select>
            <p class="mt-1.5 text-[10px] text-slate-500 dark:text-slate-400 leading-snug" id="softphoneCallingFromLine">Outbound line for this call</p>
            <div id="softphoneCallerIdMobileWrap" class="hidden mt-2 space-y-2">
              <label for="softphoneCallerIdMobile" class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Your mobile number</label>
              <input type="tel" id="softphoneCallerIdMobile" class="w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm font-semibold text-slate-800 dark:text-white" placeholder="+15551234567" autocomplete="tel" />
              <button type="button" id="softphoneCallerIdMobileSave" class="w-full rounded-xl border border-brand-yellow/60 bg-brand-yellow/15 px-3 py-2 text-[10px] font-black uppercase tracking-wide text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/25 transition-colors">Use my mobile as caller ID</button>
              <p id="softphoneCallerIdMobileHint" class="text-[10px] text-slate-500 dark:text-slate-400 leading-snug"></p>
            </div>
            <p id="softphoneOutboundMeta" class="hidden sr-only">Current outbound: —</p>
            <a href="https://id.signalwire.com/" target="_blank" rel="noopener noreferrer" class="sr-only">Buy number</a>
          </div>

          <div id="softphoneLeadNav" class="softphone-lead-nav hidden mb-2 flex items-center gap-1.5 rounded-xl border border-slate-200/70 dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-1.5 py-1">
            <button type="button" id="softphonePrevLeadBtn" class="softphone-lead-nav-btn" aria-label="Previous lead" title="Previous lead">‹</button>
