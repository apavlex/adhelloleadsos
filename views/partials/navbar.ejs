    <div id="softphonePanel" class="fixed z-[260] pointer-events-auto w-full max-w-none md:w-[min(100vw-1rem,24rem)] h-full min-h-0 max-h-[100dvh] md:h-auto md:max-h-[calc(100vh-4.5rem)] flex flex-col max-md:rounded-none md:rounded-2xl max-md:border-0 md:border border-brand-border dark:border-white/10 bg-white/95 dark:bg-slate-900/95 md:backdrop-blur-xl max-md:shadow-none md:shadow-2xl ring-0 md:ring-1 ring-black/5 dark:ring-white/5 overflow-hidden" style="right:0.75rem;top:4.5rem;left:auto;">
      <div id="softphoneDragHandle" class="flex items-start justify-between gap-3 px-4 pt-[max(1rem,env(safe-area-inset-top))] md:pt-4 pb-3 border-b border-brand-border/30 dark:border-white/10 max-md:cursor-default md:cursor-grab md:active:cursor-grabbing max-md:select-text md:select-none bg-brand-cream/35 dark:bg-slate-800/35">
        <div class="flex items-start gap-2.5 min-w-0 flex-1">
          <span class="shrink-0 w-3.5 mt-1 text-slate-400 dark:text-slate-500 max-md:hidden" title="Drag to move" aria-hidden="true">
            <svg class="w-3.5 h-4" fill="currentColor" viewBox="0 0 12 20" aria-hidden="true"><circle cx="2" cy="4" r="1.5"/><circle cx="6" cy="4" r="1.5"/><circle cx="10" cy="4" r="1.5"/><circle cx="2" cy="10" r="1.5"/><circle cx="6" cy="10" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="2" cy="16" r="1.5"/><circle cx="6" cy="16" r="1.5"/><circle cx="10" cy="16" r="1.5"/></svg>
          </span>
