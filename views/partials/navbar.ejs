        <div class="mt-2 grid grid-cols-4 gap-2">
          <button type="button" id="softphoneKeypadBtn" class="rounded-lg border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800/80 px-1.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/45" title="Keypad">Keypad</button>
          <button type="button" id="softphoneTransferBtn" class="rounded-lg border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800/80 px-1.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/45" title="Transfer (coming soon)" aria-label="Transfer call">Transfer</button>
          <button type="button" id="softphoneRecordBtn" class="rounded-lg border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800/80 px-1.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/45" title="Record (coming soon)" aria-label="Record call">Record</button>
          <button type="button" id="softphoneSpeakerBtn" class="rounded-lg border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800/80 px-1.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/45" title="Speaker">Speaker</button>
        </div>
        <button type="button" id="softphoneVmNowBtn" class="mt-2 w-full rounded-lg border border-violet-500/40 bg-violet-600/10 text-violet-700 dark:text-violet-300 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-violet-600/20">Drop VM + Next</button>
      </details>
      <div class="mt-3 rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-3">
