              <div class="flex items-center gap-1.5">
                <span id="softphoneStatusPill" class="inline-flex items-center rounded-full border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-black uppercase tracking-widest text-brand-muted">idle</span>
