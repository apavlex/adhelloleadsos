        <button type="button" id="softphoneVmBtn" class="flex-1 btn-pill bg-violet-600 text-white py-3 text-xs font-black uppercase tracking-widest hover:bg-violet-500 transition-colors focus:outline-none focus:ring-2 focus:ring-violet-400/60" aria-label="Start voicemail drop">
          <span class="inline-flex items-center gap-2 justify-center"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14m-6 4h2a2 2 0 002-2V8a2 2 0 00-2-2H9m0 12V6m0 12H7a4 4 0 01-4-4V10a4 4 0 014-4h2"/></svg>Voicemail drop</span>
        </button>
