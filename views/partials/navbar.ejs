        <button type="button" id="manualLeadTabUpload" class="flex-1 rounded-xl px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white transition-all" role="tab" aria-selected="false" data-manual-lead-tab="upload">Upload list</button>
