            <span class="w-14" aria-hidden="true"></span>
            <button type="button" id="softphoneCallBtn" class="softphone-call-btn" aria-label="Start call">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </button>
            <button type="button" id="softphoneBackspaceBtn" class="softphone-backspace-btn" aria-label="Delete last digit">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 14l-4-4 4-4M5 10h10.5a4.5 4.5 0 010 9H5"/></svg>
            </button>
          </div>

          <button type="button" id="softphoneScrollHint" class="softphone-scroll-hint hidden" aria-label="Scroll to call controls" title="More call controls below">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <div id="softphoneInCallBar" class="softphone-in-call hidden mt-3 rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 p-2.5">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wide text-slate-500">On call</span>
              <span id="softphoneCallState" class="text-[10px] font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200">Idle</span>
            </div>
            <button type="button" id="softphoneEnableAudioBtn" class="hidden w-full mb-2 rounded-xl border-2 border-brand-yellow/70 bg-brand-yellow/20 px-3 py-2 text-[11px] font-black uppercase tracking-wide text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/30 transition-colors">Tap to enable call audio</button>
            <p id="softphoneCallAudioMode" class="hidden text-[10px] font-semibold text-slate-500 dark:text-slate-400 mb-2 leading-snug"></p>
            <div class="grid grid-cols-3 gap-1.5">
              <button type="button" id="softphoneMuteBtn" class="softphone-ctrl-btn" title="Toggle mute (M)">Mute</button>
              <button type="button" id="softphoneHoldBtn" class="softphone-ctrl-btn" title="Toggle hold (H)">Hold</button>
              <button type="button" id="softphoneHangupBtn" class="softphone-ctrl-btn softphone-ctrl-btn--danger" title="End call (Esc)">Hang up</button>
            </div>
            <div class="grid grid-cols-4 gap-1.5 mt-1.5">
              <button type="button" id="softphoneKeypadBtn" class="softphone-ctrl-btn" title="Focus keypad">Keypad</button>
              <button type="button" id="softphoneTransferBtn" class="softphone-ctrl-btn" title="Transfer">Transfer</button>
              <button type="button" id="softphoneRecordBtn" class="softphone-ctrl-btn opacity-40 pointer-events-none" aria-pressed="false">Rec</button>
              <button type="button" id="softphoneSpeakerBtn" class="softphone-ctrl-btn" title="Speaker">Speaker</button>
            </div>
            <button type="button" id="softphoneRedialBtn" class="hidden w-full mt-2 rounded-xl border-2 border-brand-yellow/70 bg-brand-yellow/20 px-3 py-2.5 text-[11px] font-black uppercase tracking-wide text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/30 transition-colors" title="Call the same number again without completing wrap-up">Redial same number</button>
          </div>

          <div id="softphoneWrapPanel" class="softphone-wrap-panel mt-3 rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 p-2.5">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Quick log</span>
              <span id="softphoneWrapLeadHint" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 truncate max-w-[55%]"></span>
            </div>
            <div class="relative mb-2">
              <label for="softphoneStatusSelect" class="sr-only">Pipeline status</label>
              <select id="softphoneStatusSelect" class="w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 pr-9 text-[11px] font-bold text-slate-800 dark:text-white appearance-none">
                <option value="Not Contacted">Not Contacted</option>
                <option value="Video Recorded">Video Recorded</option>
                <option value="Called Lead">Called Lead</option>
                <option value="Email Sent">Email Sent</option>
                <option value="Follow-up">Follow-up</option>
                <option value="Closed - Won">Closed - Won</option>
                <option value="Closed - Lost">Closed - Lost</option>
              </select>
              <div class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400" aria-hidden="true">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
            <div id="softphoneQuickLogRow" class="flex flex-wrap gap-1 mb-2">
              <%- include('/partials/quick_log_pills', {
                quickLogBtnClass: 'softphone-quick-log',
                quickLogBtnExtraClass: '',
              }) %>
            </div>
            <input type="hidden" id="softphoneDisposition" value="" />
            <label for="softphoneNotes" class="sr-only">Call notes</label>
            <textarea id="softphoneNotes" rows="2" class="w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-[11px] text-slate-800 dark:text-white placeholder:text-slate-400 resize-y min-h-[3rem]" placeholder="Owner response, objection, next step…"></textarea>
            <p id="softphoneWrapFeedback" class="min-h-[1rem] text-[10px] text-slate-500 dark:text-slate-400 mt-1 leading-snug" role="status" aria-live="polite"></p>
            <p id="softphoneNextStep" class="hidden text-[10px] text-slate-500 dark:text-slate-400 mt-1 leading-snug"></p>
            <div class="grid grid-cols-2 gap-1.5 mt-2">
              <button type="button" id="softphonePushGhlBtn" class="softphone-ctrl-btn softphone-ctrl-btn--ghl col-span-2" title="Save quick log and notes, then sync to Go High Level">Sync GHL</button>
              <button type="button" id="softphoneAiSummaryBtn" class="softphone-ctrl-btn">AI summary</button>
              <button type="button" id="softphoneCompleteWrapBtn" class="softphone-ctrl-btn softphone-ctrl-btn--primary">Done</button>
            </div>
          </div>
        </div>

        <div id="softphoneTabRecents" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="recents">
          <p class="text-[15px] font-bold text-slate-800 dark:text-white mb-3">Recents</p>
          <div id="softphoneRecentList" class="space-y-2">
            <p class="text-xs text-slate-500">No recent numbers yet.</p>
          </div>
        </div>

        <div id="softphoneTabContacts" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="contacts">
          <div class="flex items-start justify-between gap-2 mb-2">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-wide text-brand-yellow">Today&apos;s queue</p>
              <p class="text-[15px] font-bold text-slate-800 dark:text-white leading-tight">Focus contacts</p>
            </div>
            <a href="/focus?channel=call" class="shrink-0 text-[10px] font-bold uppercase tracking-wide text-brand-yellow hover:underline pt-1">Focus mode →</a>
          </div>
          <p id="softphoneContactsMeta" class="text-[11px] text-slate-500 dark:text-slate-400 mb-3 leading-snug">Highest-ROI leads to call — same order as Focus mode.</p>
          <div id="softphoneContactsList" class="space-y-2 mb-4"></div>
          <div class="space-y-2">
            <a href="/today" class="softphone-link-card">Open Today&apos;s queue <span class="text-slate-400">→</span></a>
            <button type="button" id="softphoneOpenAddLead" class="softphone-link-card w-full text-left">Add lead <span class="text-slate-400">→</span></button>
          </div>
        </div>

        <div id="softphoneTabSettings" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="settings">
          <p class="text-[15px] font-bold text-slate-800 dark:text-white mb-1">Dialer settings</p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-4 leading-snug">Outbound number, call routing, and browser audio for this workspace.</p>

          <div class="softphone-settings-section mb-4">
            <label for="softphoneFromNumber" class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Outbound number</label>
            <select id="softphoneFromNumber" class="mt-1.5 w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-800 dark:text-white" aria-label="Outbound number">
              <option value="">Default workspace number</option>
            </select>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1.5 leading-snug">Used as caller ID. Must be a SignalWire number in your workspace phone bank.</p>
          </div>

          <div class="softphone-settings-section mb-4">
            <label for="softphoneCallModeSelect" class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Call routing</label>
            <select id="softphoneCallModeSelect" class="mt-1.5 w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-800 dark:text-white" <%= (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) ? '' : 'disabled' %>>
              <option value="cloud_dial">Cloud dial (browser mic)</option>
              <option value="agent_first">Agent first</option>
              <option value="browser_device">My device dialer</option>
            </select>
            <p id="softphoneCallModeSaveHint" class="text-[10px] text-slate-500 mt-1"></p>
            <p id="softphoneSettingsModeDetail" class="text-[11px] text-slate-500 dark:text-slate-400 mt-2 leading-snug"></p>
            <div id="softphoneWebrtcDiagnostics" class="hidden mt-3 rounded-xl border border-slate-200/70 dark:border-white/10 bg-white/70 dark:bg-slate-800/50 p-2.5">
              <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500 mb-2">In-tab audio checklist</p>
              <ul id="softphoneWebrtcChecklist" class="space-y-1.5 text-[10px] leading-snug"></ul>
              <p id="softphoneWebrtcDiagSummary" class="mt-2 text-[10px] font-semibold leading-snug"></p>
            </div>
          </div>

          <div id="softphoneAgentPhoneWrap" class="softphone-settings-section mb-4 hidden">
            <label for="softphoneAgentPhone" class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Your mobile (agent first)</label>
            <input type="tel" id="softphoneAgentPhone" class="mt-1.5 w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-800 dark:text-white" placeholder="+15551234567" autocomplete="tel" <%= (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) ? '' : 'disabled' %> />
            <p id="softphoneAgentPhoneHint" class="text-[10px] text-slate-500 dark:text-slate-400 mt-1.5 leading-snug">Your phone rings first; when you answer, the lead is connected.</p>
          </div>

          <div id="softphoneBrowserAudioSection" class="softphone-settings-section mb-4">
            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500 mb-1.5">Browser audio (cloud dial)</p>
            <label for="softphoneMicSelect" class="sr-only">Microphone</label>
            <select id="softphoneMicSelect" class="w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-[11px] font-semibold text-slate-800 dark:text-white mb-2">
              <option value="">Default microphone</option>
            </select>
            <label for="softphoneSpeakerSelect" class="sr-only">Speakers or headset</label>
            <select id="softphoneSpeakerSelect" class="w-full rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-[11px] font-semibold text-slate-800 dark:text-white mb-2">
              <option value="">Default speakers</option>
            </select>
            <button type="button" id="softphoneSoundcheckBtn" class="w-full rounded-xl border-2 border-brand-yellow/70 bg-brand-yellow/15 px-3 py-2.5 text-[11px] font-black uppercase tracking-wide text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/25 transition-colors">Run soundcheck</button>
            <p id="softphoneSoundcheckHint" class="text-[10px] text-slate-500 dark:text-slate-400 mt-1.5 leading-snug">Plays a test tone in your headset, then checks mic levels. Use this before your first call.</p>
            <div id="softphoneMicLevelWrap" class="hidden mt-2">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Mic level</span>
                <span id="softphoneMicLevelLabel" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Waiting…</span>
              </div>
              <div class="softphone-soundcheck-meter" aria-hidden="true">
                <div id="softphoneMicLevelFill" class="softphone-soundcheck-meter-fill" style="width:0%"></div>
              </div>
            </div>
            <button type="button" id="softphoneTestMicBtn" class="w-full mt-2 rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-[11px] font-bold text-slate-800 dark:text-white hover:border-brand-yellow/50 transition-colors">Allow mic &amp; refresh devices</button>
            <p id="softphoneMicStatus" class="text-[10px] text-slate-500 dark:text-slate-400 mt-1.5 leading-snug" role="status" aria-live="polite">Pair your Bluetooth headset, pick mic and speakers above, then run soundcheck.</p>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-200/70 dark:border-white/10">
            <a href="/workspace/phones" class="softphone-link-card">Workspace phone bank <span class="text-slate-400">→</span></a>
            <button type="button" id="callRoutingWalkthroughSoftphoneBtn" class="softphone-link-card w-full text-left">Guided setup for call routing <span class="text-slate-400">→</span></button>
          </div>
        </div>

        <div id="softphoneTabVoicemail" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="voicemail" hidden aria-hidden="true">
          <p class="text-[15px] font-bold text-slate-800 dark:text-white mb-3">Outreach in GHL</p>
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-4 leading-relaxed">Sync contacts from AdHello, then run SMS, email, and voicemail drops in Go High Level.</p>
          <a href="/workspace/integrations" class="softphone-link-card">Open GHL integration <span class="text-slate-400">→</span></a>
        </div>

        <div id="softphoneTabQueue" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="queue">
          <p class="text-[15px] font-bold text-slate-800 dark:text-white mb-1">Call queue</p>
          <p id="softphoneQueueMeta" class="text-[11px] text-slate-500 dark:text-slate-400 mb-3 leading-snug">Select leads in the pipeline (checkboxes) or open a lead — callable numbers appear here.</p>
          <div id="softphoneQueueList" class="space-y-2 mb-4"></div>
          <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500 mb-2">Quick links</p>
          <div class="space-y-2">
            <a href="/prospecting?tab=queue" class="softphone-link-card">Prospecting queue <span class="text-slate-400">→</span></a>
            <a href="/focus" class="softphone-link-card">Focus mode <span class="text-slate-400">→</span></a>
            <a href="/prospecting?tab=pipeline" class="softphone-link-card">Pipeline <span class="text-slate-400">→</span></a>
            <a href="/outreach" class="softphone-link-card">Outreach lists <span class="text-slate-400">→</span></a>
          </div>
        </div>

        <div id="softphoneTabDirectMail" class="softphone-tab-panel hidden flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-3" data-tab="direct_mail">
          <p class="text-[15px] font-bold text-slate-800 dark:text-white mb-1">Direct mail queue</p>
          <p id="softphoneDirectMailMeta" class="text-[11px] text-slate-500 dark:text-slate-400 mb-3 leading-snug">Tag hot prospects during your call session — mail them after you wrap up.</p>
          <button type="button" id="softphoneDirectMailAddBtn" class="w-full mb-3 rounded-2xl border-2 border-violet-400/50 bg-violet-500/10 px-4 py-3 text-[11px] font-black uppercase tracking-widest text-violet-900 dark:text-violet-200 hover:bg-violet-500/20 transition-colors">+ Add current lead</button>
          <div id="softphoneDirectMailList" class="space-y-2 mb-4"></div>
          <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500 mb-2">After your session</p>
          <div class="space-y-2">
            <a href="/direct-mail" id="softphoneDirectMailSendLink" class="softphone-link-card">Send postcards <span class="text-slate-400">→</span></a>
            <a href="/prospecting?tab=pipeline" id="softphoneDirectMailFolderLink" class="softphone-link-card">Open Direct Mail folder <span class="text-slate-400">→</span></a>
          </div>
        </div>
      </div>

      <nav class="softphone-bottom-nav shrink-0 border-t border-slate-200/80 dark:border-white/10 bg-white/95 dark:bg-slate-900/95 pb-[max(0.35rem,env(safe-area-inset-bottom))]" aria-label="Dialer sections">
        <button type="button" id="softphoneNavRecents" class="softphone-nav-btn" data-tab="recents" aria-selected="false">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Recents</span>
        </button>
        <button type="button" id="softphoneNavContacts" class="softphone-nav-btn" data-tab="contacts" aria-selected="false">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <span>Contacts</span>
        </button>
        <button type="button" id="softphoneNavKeypad" class="softphone-nav-btn softphone-nav-btn--active" data-tab="keypad" aria-selected="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
          <span>Keypad</span>
        </button>
        <button type="button" id="softphoneNavVoicemail" class="softphone-nav-btn hidden" data-tab="voicemail" aria-selected="false" hidden aria-hidden="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
          <span>Voicemail</span>
        </button>
        <button type="button" id="softphoneNavQueue" class="softphone-nav-btn" data-tab="queue" aria-selected="false">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          <span>Queue</span>
        </button>
        <button type="button" id="softphoneNavDirectMail" class="softphone-nav-btn relative" data-tab="direct_mail" aria-selected="false">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>Mail</span>
          <span id="softphoneNavDirectMailCount" class="hidden absolute top-0.5 right-1 min-w-[1rem] h-4 px-1 rounded-full bg-violet-500 text-white text-[9px] font-black leading-4 text-center">0</span>
        </button>
      </nav>
    </div>
  </div>
  <%- include('/partials/call_routing_walkthrough') %>
</header>
<%- include('/partials/lead_run_progress_banner') %>
</div>
