            <% ['1','2','3','4','5','6','7','8','9','*','0','#'].forEach(function (k) { %>
            <button type="button" class="softphone-key" data-key="<%= k %>" aria-label="Dial <%= k %>">
              <span class="softphone-key-main"><%= k %></span>
              <% if (k === '0') { %><span class="softphone-key-sub">+</span><% } %>
            </button>
            <% }); %>
