        <button type="button" id="softphoneCallBtn" class="flex-1 btn-pill bg-emerald-600 text-white py-3 text-xs font-black uppercase tracking-widest hover:bg-emerald-500 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-400/60" aria-label="Start call">
