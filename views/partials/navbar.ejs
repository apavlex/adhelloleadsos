<% const np = typeof navPrimary !== 'undefined' ? navPrimary : (typeof activePage !== 'undefined' ? activePage : ''); %>
<% const _leadNavActive = np === 'find' || np === 'prospecting'; %>
<% const _ws = typeof workspace !== 'undefined' && workspace ? workspace : null; %>
<% const _wsList = typeof workspaceSwitcherList !== 'undefined' && workspaceSwitcherList ? workspaceSwitcherList : []; %>
<% const _wsAccent = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : '#CA8A04'; %>
<% const _wsCount = _wsList.length; %>
<% const _wsSubLabel = _wsCount > 1 ? (_wsCount + ' workspaces') : 'Agency OS'; %>
<script>
(function () {
  var b = document.body;
  if (!b) return;
  b.classList.add('app-with-sidebar');
  try {
    var s = localStorage.getItem('adhello-sidebar');
    if (s === 'collapsed') b.classList.add('sidebar-collapsed');
    else if (s === 'hidden') b.classList.add('sidebar-hidden');
  } catch (e) {}
})();
</script>
<%- include('/partials/app_sidebar') %>
<script src="/js/sidebarShell.js?v=sidebar8" defer></script>
<% if (typeof user !== 'undefined' && user) { %><script src="/js/alex-voice-input.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script><% } %>
<script src="/js/app-nav-search.js?v=navsearch7" defer></script>
<div class="app-shell-content min-w-0 w-full flex flex-col">
<div class="app-shell-top w-full min-w-0">
<%- include('/partials/live_demo_banner') %>
<%- include('/partials/trial_banner') %>
<header id="appTopbar" class="sticky top-0 z-50 w-full px-3 sm:px-6 py-3 sm:py-4 border-t-[3px] md:border-t-0 [padding-top:max(0.75rem,env(safe-area-inset-top))]" style="border-top-color: <%= _wsAccent %>">
  <span id="adhelloAppMeta" class="sr-only" data-can-manage-workspace="<%= (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) ? '1' : '0' %>" aria-hidden="true"></span>
  <div class="app-topbar-inner w-full mx-auto flex items-center gap-2 sm:gap-3 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md px-3 sm:px-6 py-2.5 sm:py-3 rounded-2xl sm:rounded-full border border-brand-border dark:border-white/10 shadow-sm">
    <div class="flex items-center shrink-0 md:hidden">
      <% const _navLogo = typeof whiteLabel !== 'undefined' && whiteLabel ? whiteLabel.logoUrl : '/images/adhello-app-icon.png'; %>
      <button id="mobileMenuBtn" type="button" class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-[22%] border border-brand-border/70 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 hover:bg-brand-cream dark:hover:bg-slate-700 transition-colors shrink-0" aria-label="Open menu" title="Menu">
        <img src="<%= _navLogo %>" alt="" width="40" height="40" class="h-full w-full object-contain" loading="eager" decoding="async" />
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full ring-2 ring-white dark:ring-slate-900" style="background-color: <%= _wsAccent %>" aria-hidden="true"></span>
      </button>
    </div>
    <div class="hidden md:flex items-center min-w-0 flex-1 basis-0">
      <button type="button" id="sidebarOpenBtn" class="hidden md:inline-flex items-center justify-center w-10 h-10 shrink-0 mr-2 text-brand-dark dark:text-white hover:bg-brand-cream dark:hover:bg-white/10 rounded-full transition-colors border border-brand-border dark:border-white/10" aria-label="Show sidebar" title="Show sidebar">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
      </button>
      <% if (user) { %>
      <div class="nav-lead-search w-full min-w-0" id="navLeadSearchWrap">
        <form id="navLeadSearchForm" class="nav-lead-search-form" role="search" action="/prospecting" method="get" autocomplete="off">
          <input type="hidden" name="tab" value="pipeline" />
          <input type="hidden" name="includeFoldered" value="1" />
          <div class="nav-lead-search-input-wrap">
            <svg class="nav-lead-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
            <input type="search" id="navLeadSearchInput" name="q" class="nav-lead-search-input" placeholder="Search name, phone, ZIP…" aria-label="Search leads by name, any part of a phone number, ZIP, email or city" aria-autocomplete="list" aria-controls="navLeadSearchDropdown" aria-expanded="false" />
            <kbd class="nav-lead-search-kbd hidden lg:inline-flex" aria-hidden="true">⌘K</kbd>
            <button type="button" id="navLeadSearchClear" class="nav-lead-search-clear hidden" aria-label="Clear search" tabindex="-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <%- include('nav_search_ai_toggle', { aiToggleId: 'navLeadSearchAiToggle' }) %>
          </div>
          <div id="navLeadSearchDropdown" class="nav-lead-search-dropdown hidden" role="listbox" aria-label="Lead search results"></div>
        </form>
      </div>
      <% } %>
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 ml-auto">
      <% if (user) { %>
      <button type="button" id="navCallStatusBtn" class="hidden md:inline-flex items-center gap-2 max-w-[11rem] min-w-0 rounded-full border border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800/90 px-3 py-2 text-left hover:bg-brand-cream dark:hover:bg-slate-700 transition-colors" title="Dialer status — open phone" aria-live="polite">
        <span class="shrink-0 w-2 h-2 rounded-full bg-slate-400" id="navCallStatusDot" aria-hidden="true"></span>
        <span class="truncate text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white" id="navCallStatusLine">Idle</span>
      </button>
      <button type="button" id="navLeadSearchMobileBtn" class="md:hidden w-10 h-10 flex items-center justify-center text-brand-dark bg-brand-cream/70 hover:bg-brand-cream dark:text-gray-300 dark:bg-slate-800/80 dark:hover:bg-slate-700 rounded-full transition-colors border border-brand-border/60 dark:border-white/10" title="Search existing leads" aria-label="Search existing leads" aria-expanded="false" aria-controls="navLeadSearchMobileRow">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
      </button>
      <a href="/leads/find" id="navFindLeadsBtn" class="hidden md:inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-yellow px-3 sm:px-4 py-2 h-10 text-[10px] sm:text-[11px] font-black uppercase tracking-widest shadow-lg shadow-brand-yellow/40 hover:shadow-xl hover:shadow-brand-yellow/55 hover:brightness-105 active:scale-[0.98] transition-all border border-brand-yellow/30 <%= np === 'find' ? 'ring-2 ring-brand-yellow ring-offset-2 ring-offset-white dark:ring-offset-slate-900' : '' %>" title="Search and import leads" aria-label="Find leads">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
        <span class="hidden sm:inline">Find leads</span>
      </a>
      <button type="button" id="navQuickTaskOpen" class="hidden md:flex w-10 h-10 items-center justify-center text-brand-dark bg-brand-cream/70 hover:bg-brand-cream dark:text-gray-300 dark:bg-slate-800/80 dark:hover:bg-slate-700 rounded-full transition-colors border border-brand-border/60 dark:border-white/10" title="Add task" aria-label="Add task" aria-haspopup="dialog" aria-controls="navQuickTaskModal">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5a2 2 0 012-2h2a2 2 0 012 2v0a2 2 0 01-2 2h-2a2 2 0 01-2-2v0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 16h4"/>
        </svg>
      </button>
      <button type="button" id="manualLeadOpen" class="md:hidden inline-flex items-center justify-center gap-1.5 rounded-full border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 text-brand-dark dark:text-white w-10 h-10 hover:border-brand-yellow/50 active:scale-[0.98] transition-all" title="Add Opportunity" aria-label="Add Opportunity">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      </button>
      <% } %>
      <div id="processingIndicator" class="bell-icon-wrapper nav-bell w-10 h-10 flex items-center justify-center text-brand-dark dark:text-gray-300 rounded-full hover:bg-brand-cream dark:hover:bg-gray-800 transition-all cursor-pointer relative">
        <div class="processing-ring"></div>
        <span id="bulkEnhanceBellBadge" class="nav-bell-badge hidden" aria-hidden="true"></span>
        <div id="notificationPing" class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full hidden"></div>
        <span id="navInboundBadge" class="nav-inbound-badge hidden" aria-hidden="true"></span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
        <div id="notificationDropdown" class="absolute top-full mt-3 right-0 w-80 bg-white dark:bg-slate-900 shadow-2xl rounded-2xl hidden p-0 border border-brand-border dark:border-white/10 z-[100] animate-slide-up overflow-hidden">
          <div class="p-4 border-b border-brand-border dark:border-white/5 bg-brand-cream/30 dark:bg-white/5">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Notifications</h3>
          </div>
          <div id="navInboundSection" class="hidden border-b border-brand-border dark:border-white/5">
            <div class="px-4 pt-3 pb-1 flex items-center gap-2">
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Inbound</span>
              <span id="navInboundCount" class="inline-flex items-center justify-center h-5 px-1.5 rounded-full bg-brand-yellow text-brand-dark text-[10px] font-black tabular-nums"></span>
              <span class="ml-auto text-[10px] text-brand-muted">Waiting on a reply</span>
            </div>
            <ul id="navInboundList" class="max-h-[320px] overflow-y-auto"></ul>
          </div>
          <div id="notificationList" class="max-h-[320px] overflow-y-auto">
            <div class="p-8 text-center text-brand-muted dark:text-slate-500 italic text-[11px]">
              No new notifications
            </div>
          </div>
          <div id="notificationDesktopRow" class="p-3 border-t border-brand-border dark:border-white/5">
            <button type="button" id="navNotifyEnable" class="w-full rounded-xl border-2 border-sky-500/45 dark:border-sky-400/40 bg-white dark:bg-slate-900 px-3 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white text-center hover:bg-sky-50/80 dark:hover:bg-sky-950/40 transition-colors">
              Enable desktop alerts (runs &amp; reminders)
            </button>
            <p id="navNotifyStatus" class="hidden mt-2 text-[10px] text-center text-brand-muted dark:text-slate-400 leading-relaxed"></p>
          </div>
          <div id="notificationPushRow" class="hidden p-3 border-t border-brand-border dark:border-white/5">
            <button type="button" id="navPushEnable" class="w-full rounded-xl border-2 border-sky-500/45 dark:border-sky-400/40 bg-white dark:bg-slate-900 px-3 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white text-center hover:bg-sky-50/80 dark:hover:bg-sky-950/40 transition-colors">
              Turn on phone alerts
            </button>
            <p id="navPushStatus" class="mt-2 text-[10px] text-center text-brand-muted dark:text-slate-400 leading-relaxed"></p>
            <button type="button" id="navPushOff" class="hidden mt-1 w-full text-[10px] font-bold text-brand-muted dark:text-slate-400 hover:underline">Turn off on this device</button>
          </div>
          <div class="p-3 border-t border-brand-border dark:border-white/5 text-center">
            <a href="/notifications" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">All notifications</a>
          </div>
        </div>
      </div>

      <button id="navSoftphoneOpen" type="button" class="w-10 h-10 flex items-center justify-center text-brand-dark bg-brand-cream/70 hover:bg-brand-cream dark:text-gray-300 dark:bg-slate-800/80 dark:hover:bg-slate-700 rounded-full transition-colors border border-brand-border/60 dark:border-white/10" aria-label="Open AdHello dialer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </button>

      <button id="themeToggleBtn" type="button" class="theme-toggle-btn hidden md:flex w-10 h-10 items-center justify-center text-brand-dark hover:bg-brand-cream dark:text-gray-300 dark:hover:bg-gray-800 rounded-full transition-colors" aria-label="Toggle theme">
        <svg class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364l-1.414-1.414M7.05 7.05L5.636 5.636m12.728 0l-1.414 1.414M7.05 16.95l-1.414 1.414M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <% if (user) { %>
      <div class="relative hidden sm:block" id="userMenuDesktop">
        <button type="button" id="userMenuBtn" class="flex items-center gap-2 rounded-full border border-brand-border dark:border-white/10 bg-brand-cream/50 dark:bg-slate-800 pl-1 pr-2 py-1 hover:bg-brand-cream dark:hover:bg-slate-700 transition-colors" aria-expanded="false" aria-haspopup="true" aria-controls="userMenuPanel">
          <span class="w-8 h-8 rounded-full bg-brand-cream border border-brand-border flex items-center justify-center font-bold text-brand-dark text-xs overflow-hidden shrink-0">
            <% if (user.photos && user.photos.length > 0) { %>
              <img src="<%= user.photos[0].value %>" alt="" class="w-full h-full object-cover">
            <% } else { %>
              <%= (user.displayName || (user.emails?.[0]?.value || 'U'))[0].toUpperCase() %>
            <% } %>
          </span>
          <svg class="w-4 h-4 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="userMenuPanel" class="hidden absolute right-0 mt-2 w-56 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 z-[110] text-left" role="menu">
          <div class="px-4 py-2 border-b border-brand-border/50 dark:border-white/10">
            <div class="text-xs font-bold text-brand-dark dark:text-white truncate"><%= user.displayName || (user.emails?.[0]?.value || 'User').split('@')[0] %></div>
            <div class="text-[10px] text-brand-muted truncate" title="<%= user.emails?.[0]?.value || '' %>"><%= user.emails?.[0]?.value || '' %></div>
          </div>
          <a href="/workspace/team" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">Team &amp; workspace</a>
          <a href="/activation" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">7-day activation</a>
          <a href="/workspace/ai-apps" class="block px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/5">AI Connector</a>
          <a href="/logout" class="block px-4 py-2.5 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30">Log out</a>
        </div>
      </div>
      <% } else { %>
      <a href="/auth/google" class="btn-pill btn-primary px-4 py-2 text-sm font-bold shadow-sm whitespace-nowrap hidden sm:inline-flex">Login</a>
      <% } %>
    </div>
  </div>

  <% if (user) { %>
  <div id="navLeadSearchMobileRow" class="md:hidden hidden max-w-7xl mx-auto mt-2 px-3 sm:px-6">
    <div class="nav-lead-search nav-lead-search--mobile" id="navLeadSearchWrapMobile">
      <form id="navLeadSearchFormMobile" class="nav-lead-search-form" role="search" action="/prospecting" method="get" autocomplete="off">
        <input type="hidden" name="tab" value="pipeline" />
        <input type="hidden" name="includeFoldered" value="1" />
        <div class="nav-lead-search-input-wrap">
          <svg class="nav-lead-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
          <input type="search" id="navLeadSearchInputMobile" name="q" class="nav-lead-search-input" placeholder="Search name, phone, ZIP…" aria-label="Search leads by name, any part of a phone number, ZIP, email or city" aria-autocomplete="list" aria-controls="navLeadSearchDropdownMobile" aria-expanded="false" />
          <button type="button" id="navLeadSearchClearMobile" class="nav-lead-search-clear hidden" aria-label="Clear search" tabindex="-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
          <%- include('nav_search_ai_toggle', { aiToggleId: 'navLeadSearchAiToggleMobile' }) %>
        </div>
        <div id="navLeadSearchDropdownMobile" class="nav-lead-search-dropdown hidden" role="listbox" aria-label="Lead search results"></div>
      </form>
    </div>
  </div>
  <% } %>

  <div id="mobileMenu" class="fixed inset-0 z-[100] bg-brand-dark/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300 pointer-events-none md:hidden">
    <div id="mobileMenuPanel" class="ghl-sidebar absolute inset-y-0 left-0 w-72 max-w-[min(88vw,18rem)] shadow-2xl px-2 pb-4 -translate-x-full transition-transform duration-300 pointer-events-auto overflow-y-auto overscroll-contain custom-scrollbar flex flex-col [padding-top:max(0.75rem,env(safe-area-inset-top))] [padding-bottom:max(1rem,env(safe-area-inset-bottom))] [padding-left:max(0.5rem,env(safe-area-inset-left))]">
      <div class="flex items-center justify-between px-2 pb-3">
        <a href="/today" class="flex h-10 w-10 items-center justify-center rounded-xl overflow-hidden shadow-sm ring-1 ring-black/5 dark:ring-white/10" aria-label="<%= typeof whiteLabel !== 'undefined' && whiteLabel ? whiteLabel.appName : 'AdHello' %> home">
          <img src="<%= typeof whiteLabel !== 'undefined' && whiteLabel ? whiteLabel.logoUrl : '/images/adhello-app-icon.png' %>" alt="" width="40" height="40" class="h-full w-full object-contain" loading="eager" decoding="async" />
        </a>
        <button id="closeMobileMenu" type="button" class="w-10 h-10 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white rounded-full transition-colors border border-brand-border dark:border-white/10" aria-label="Close menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="relative px-1 pb-3" id="wsSwitcherWrap">
        <button type="button" id="wsSwitcherBtn" class="sidebar-ws-btn ghl-ws-switcher flex items-center gap-2.5 group w-full min-w-0 text-left rounded-lg px-3 py-2.5 transition-colors" aria-expanded="false" aria-haspopup="true" aria-controls="wsSwitcherMenu" title="Switch workspace">
          <span class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white dark:bg-slate-800 text-[#6B7280] dark:text-slate-400 ring-1 ring-[#E5E7EB] dark:ring-white/10" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 rounded-full ring-2 ring-white dark:ring-slate-900" style="background-color: <%= _wsAccent %>" aria-hidden="true"></span>
          </span>
          <span class="min-w-0 flex-1 flex flex-col">
            <span class="font-display text-sm font-semibold text-[#111827] dark:text-white truncate leading-tight"><%= _ws && _ws.name ? _ws.name : 'Workspace' %></span>
            <span class="text-xs text-[#6B7280] dark:text-slate-400 truncate leading-tight mt-0.5"><%= _wsSubLabel %></span>
          </span>
          <svg class="w-3.5 h-3.5 shrink-0 text-[#9CA3AF] ws-switcher-chevron transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
