<% const np = typeof navPrimary !== 'undefined' ? navPrimary : (typeof activePage !== 'undefined' ? activePage : ''); %>
<% const _leadNavActive = np === 'find' || np === 'prospecting'; %>
<% const _lt = typeof navLeadsTab !== 'undefined' ? navLeadsTab : ''; %>
<% const _leadsOpen = !!_lt; %>
<% const _ws = typeof workspace !== 'undefined' && workspace ? workspace : null; %>
<% const _wsList = typeof workspaceSwitcherList !== 'undefined' && workspaceSwitcherList ? workspaceSwitcherList : []; %>
<% const _wsAccent = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : '#CA8A04'; %>
<% const _wsCount = _wsList.length; %>
<% const _wsSubLabel = _wsCount > 1 ? (_wsCount + ' workspaces · switch') : 'Agency OS'; %>
<aside id="appSidebar" class="app-sidebar ghl-sidebar flex-col shrink-0 overflow-y-auto custom-scrollbar" aria-label="Main navigation">
<style>
  .sidebar-add-lead {
    border: 1.5px solid rgba(17, 24, 39, 0.38);
    border-radius: 0.7rem;
    font-weight: 700;
    margin: 0.1rem 0.15rem 0.45rem;
    background: transparent;
  }
  html.dark .sidebar-add-lead {
    border-color: rgba(255, 255, 255, 0.4);
  }
  .sidebar-add-lead:hover {
    border-color: var(--brand-yellow, #ca8a04);
    background: rgba(255, 214, 68, 0.16);
  }
  .sidebar-nav-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1;
  }
</style>
  <div class="sidebar-logo-row flex items-center justify-center pt-4 pb-2 px-3">
    <a href="/today" class="sidebar-logo-link flex h-10 w-10 items-center justify-center rounded-xl overflow-hidden shadow-sm ring-1 ring-black/5 dark:ring-white/10" title="AdHello — Today" aria-label="AdHello home">
      <img src="/images/adhello-app-icon.png" alt="" width="40" height="40" class="h-full w-full object-contain" loading="eager" decoding="async" />
    </a>
  </div>

  <div class="relative px-3 pb-3 sidebar-brand-row">
    <div class="relative min-w-0" id="wsSwitcherWrapSidebar">
      <button type="button" id="wsSwitcherBtnSidebar" class="sidebar-ws-btn ghl-ws-switcher flex items-center gap-2.5 group w-full min-w-0 text-left rounded-lg px-3 py-2.5 transition-colors" aria-expanded="false" aria-haspopup="true" aria-controls="wsSwitcherMenuSidebar" title="Switch workspace — <%= _ws && _ws.name ? _ws.name : 'Workspace' %>">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white dark:bg-slate-800 text-[#6B7280] dark:text-slate-400 ring-1 ring-[#E5E7EB] dark:ring-white/10" aria-hidden="true">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
        </span>
        <span class="min-w-0 flex-1 flex flex-col sidebar-ws-text">
          <span class="text-sm font-semibold text-[#111827] dark:text-white truncate leading-tight"><%= _ws && _ws.name ? _ws.name : 'Workspace' %></span>
          <span class="text-xs text-[#6B7280] dark:text-slate-400 truncate sidebar-ws-sub leading-tight mt-0.5"><%= _wsSubLabel %></span>
        </span>
        <span class="flex flex-col shrink-0 text-[#9CA3AF] dark:text-slate-500 sidebar-ws-text ws-switcher-chevron" aria-hidden="true">
          <svg class="w-3 h-3 -mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
          <svg class="w-3 h-3 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </span>
      </button>
      <div id="wsSwitcherMenuSidebar" class="hidden rounded-xl border border-[#E5E7EB] dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 text-left max-h-[min(24rem,70vh)] overflow-y-auto custom-scrollbar z-[120]" role="menu">
        <%- include('workspace_switcher_menu') %>
      </div>
    </div>
  </div>

  <%- include('/partials/app_nav_items', { navVariant: 'sidebar' }) %>

  <div class="sidebar-footer mt-auto border-t border-[#E5E7EB] dark:border-white/10">
    <div class="sidebar-settings-block relative px-2 py-2" data-start-open="<%= (typeof sidebarSettingsOpen !== 'undefined' && sidebarSettingsOpen) ? '1' : '0' %>">
      <nav id="sidebarSettingsMenu" class="sidebar-settings-menu hidden space-y-0.5 mb-1 px-1" aria-label="Settings">
        <% const _rp = typeof requestPath !== 'undefined' ? requestPath : ''; %>
        <a href="/scripts" class="sidebar-nav-link sidebar-nav-sub <%= _rp === '/scripts' || _rp.startsWith('/scripts/') ? 'active' : '' %>">Script library</a>
        <a href="/sops" class="sidebar-nav-link sidebar-nav-sub <%= _rp === '/sops' || _rp.startsWith('/sops/') ? 'active' : '' %>">SOPs</a>
        <a href="/workspace/voicemail" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace/voicemail') ? 'active' : '' %>">Voicemail</a>
        <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
        <a href="/workspace/phones" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace/phones') ? 'active' : '' %>">Phone settings</a>
        <% } %>
        <a href="/workspace/team" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace') && !_rp.startsWith('/workspace/voicemail') && !_rp.startsWith('/workspace/phones') ? 'active' : '' %>">Workspace settings</a>
        <a href="/activation" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/activation') ? 'active' : '' %>">7-day activation</a>
      </nav>
      <button type="button" id="sidebarSettingsToggle" class="sidebar-nav-link sidebar-settings-toggle w-full text-left <%= (typeof sidebarSettingsOpen !== 'undefined' && sidebarSettingsOpen) ? 'active' : '' %>" aria-expanded="false" aria-controls="sidebarSettingsMenu" title="Settings">
        <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span class="sidebar-settings-label">Settings</span>
        <svg class="sidebar-settings-chevron w-3.5 h-3.5 shrink-0 text-[#9CA3AF] ml-auto transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
      </button>
    </div>
    <div class="sidebar-collapse-row flex justify-end px-3 py-2.5">
      <button type="button" id="sidebarCollapseBtn" class="sidebar-collapse-btn flex h-8 w-8 items-center justify-center rounded-full bg-[#059669] text-white shadow-sm hover:bg-[#047857] transition-colors" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
        <svg class="w-4 h-4 sidebar-icon-collapse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
        <svg class="w-4 h-4 sidebar-icon-expand hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      </button>
    </div>
  </div>
</aside>
