<% const np = typeof navPrimary !== 'undefined' ? navPrimary : (typeof activePage !== 'undefined' ? activePage : ''); %>
<% const _leadNavActive = np === 'find' || np === 'prospecting'; %>
<% const _lt = typeof navLeadsTab !== 'undefined' ? navLeadsTab : ''; %>
<% const _leadsOpen = !!_lt; %>
<% const _ws = typeof workspace !== 'undefined' && workspace ? workspace : null; %>
<% const _wsList = typeof workspaceSwitcherList !== 'undefined' && workspaceSwitcherList ? workspaceSwitcherList : []; %>
<% const _wsAccent = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : '#CA8A04'; %>
<% const _wsCount = _wsList.length; %>
<% const _wsSubLabel = _wsCount > 1 ? (_wsCount + ' workspaces · switch') : 'Tap to add another workspace'; %>
<aside id="appSidebar" class="app-sidebar flex-col shrink-0 border-r border-brand-border/60 dark:border-white/10 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md overflow-y-auto custom-scrollbar" style="border-top: 3px solid <%= _wsAccent %>" aria-label="Main navigation">
  <div class="relative p-3 pr-11 border-b border-brand-border/40 dark:border-white/10 sidebar-brand-row">
    <div class="relative min-w-0 z-[2] pr-1" id="wsSwitcherWrapSidebar">
      <button type="button" id="wsSwitcherBtnSidebar" class="flex items-center gap-2.5 group w-full min-w-0 text-left rounded-xl px-2 py-2 hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-colors sidebar-ws-btn border border-transparent hover:border-brand-border/30 dark:hover:border-white/10" aria-expanded="false" aria-haspopup="true" aria-controls="wsSwitcherMenuSidebar" title="Switch workspace — <%= _ws && _ws.name ? _ws.name : 'Workspace' %>">
        <span class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[22%]" aria-hidden="true">
          <img src="/images/adhello-app-icon.png" alt="" width="36" height="36" class="h-full w-full object-contain" loading="eager" decoding="async" />
          <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full ring-2 ring-white dark:ring-slate-900" style="background-color: <%= _wsAccent %>" aria-hidden="true"></span>
        </span>
        <span class="min-w-0 flex-1 flex flex-col sidebar-ws-text">
          <span class="font-display font-black text-sm tracking-tight text-brand-dark dark:text-white truncate"><%= _ws && _ws.name ? _ws.name : 'Workspace' %></span>
          <span class="text-[9px] font-bold text-brand-muted truncate sidebar-ws-sub"><%= _wsSubLabel %></span>
        </span>
        <svg class="w-3.5 h-3.5 shrink-0 text-brand-muted opacity-70 ws-switcher-chevron sidebar-ws-text transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </button>
      <div id="wsSwitcherMenuSidebar" class="hidden rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 text-left max-h-[min(24rem,70vh)] overflow-y-auto custom-scrollbar" role="menu">
        <%- include('workspace_switcher_menu') %>
      </div>
    </div>
    <button type="button" id="sidebarCollapseBtn" class="sidebar-collapse-btn absolute right-2 top-1/2 -translate-y-1/2 z-[3] w-8 h-8 flex items-center justify-center rounded-lg text-brand-muted hover:text-brand-dark dark:hover:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 transition-colors" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
      <svg class="w-4 h-4 sidebar-icon-collapse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" /></svg>
      <svg class="w-4 h-4 sidebar-icon-expand hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
    </button>
  </div>

  <nav class="flex-1 p-3 space-y-1 sidebar-primary-nav" aria-label="Primary">
    <% if (user) { %>
    <button type="button" id="manualLeadOpenSidebar" class="sidebar-nav-link w-full text-left border border-brand-border/50 dark:border-white/10" title="Add lead">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      <span>Add lead</span>
    </button>
    <% } %>
    <a href="/today" class="sidebar-nav-link <%= np === 'today' ? 'active' : '' %>" title="Today">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
      <span>Today</span>
    </a>
    <details class="sidebar-leads-details group"<%= _leadsOpen ? ' open' : '' %>>
      <summary class="sidebar-nav-link sidebar-leads-summary list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden <%= _lt ? 'active' : '' %>" title="Leads">
        <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" /></svg>
        <span>Leads</span>
        <svg class="sidebar-leads-chevron w-3 h-3 shrink-0 opacity-50 ml-auto transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </summary>
      <nav class="sidebar-leads-sub mt-0.5 ml-3 pl-2 border-l border-brand-border/40 dark:border-white/10 space-y-0.5 pb-1" aria-label="Leads sections">
        <a href="/leads/find" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'find' ? 'active' : '' %>" title="Find leads">Find</a>
        <a href="/prospecting?tab=queue" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'queue' ? 'active' : '' %>" title="Scheduled queue">Queue</a>
        <a href="/pipeline" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'pipeline' ? 'active' : '' %>" title="Pipeline board">Pipeline</a>
        <a href="/prospecting?tab=folders" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'folders' ? 'active' : '' %>" title="Lead folders">Folders</a>
        <a href="/history" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'history' ? 'active' : '' %>" title="Search history">Search history</a>
      </nav>
    </details>
    <a href="/ceo" class="sidebar-nav-link <%= np === 'ceo' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
      <span>Automate</span>
    </a>
    <a href="/tasks" class="sidebar-nav-link <%= np === 'tasks' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Tasks</span>
    </a>
    <a href="/direct-mail" class="sidebar-nav-link <%= np === 'direct-mail' ? 'active' : '' %>" title="Marketing Studio — ads and direct mail">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.88-3.882 4.5 4.5 0 00-1.925-6.772 4.5 4.5 0 00-6.775 1.925A15.998 15.998 0 009.53 16.122zM15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      <span>Marketing Studio</span>
    </a>
    <a href="/reports" class="sidebar-nav-link <%= np === 'reports' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
      <span>Reports</span>
    </a>
    <a href="/resources" class="sidebar-nav-link <%= np === 'resources' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      <span>Resources</span>
    </a>
    <a href="/social-posts" class="sidebar-nav-link <%= np === 'social-posts' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      <span>Social Posts</span>
    </a>
    <% if (typeof ghlDashboardUrl !== 'undefined' && ghlDashboardUrl) { %>
    <a href="<%= ghlDashboardUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
      <span>GHL</span>
      <svg class="w-3 h-3 shrink-0 opacity-50 ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
    </a>
    <% } %>
    <% if (typeof hermesWebUiUrl !== 'undefined' && hermesWebUiUrl) { %>
    <a href="<%= hermesWebUiUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
      <span>AI Chat</span>
      <svg class="w-3 h-3 shrink-0 opacity-50 ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
    </a>
    <% } %>
  </nav>

  <div class="sidebar-settings-block relative p-3 mt-auto border-t border-brand-border/40 dark:border-white/10" data-start-open="<%= (typeof sidebarSettingsOpen !== 'undefined' && sidebarSettingsOpen) ? '1' : '0' %>">
    <nav id="sidebarSettingsMenu" class="sidebar-settings-menu hidden space-y-1 mb-1" aria-label="Settings">
      <% const _rp = typeof requestPath !== 'undefined' ? requestPath : ''; %>
      <a href="/scripts" class="sidebar-nav-link sidebar-nav-sub <%= _rp === '/scripts' || _rp.startsWith('/scripts/') ? 'active' : '' %>">Script library</a>
      <a href="/workspace/voicemail" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace/voicemail') ? 'active' : '' %>">Voicemail</a>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
      <a href="/workspace/phones" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace/phones') ? 'active' : '' %>">Phone forwarding</a>
      <% } %>
      <a href="/workspace/team" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/workspace') && !_rp.startsWith('/workspace/voicemail') && !_rp.startsWith('/workspace/phones') ? 'active' : '' %>">Workspace settings</a>
      <a href="/activation" class="sidebar-nav-link sidebar-nav-sub <%= _rp.startsWith('/activation') ? 'active' : '' %>">7-day activation</a>
    </nav>
    <button type="button" id="sidebarSettingsToggle" class="sidebar-nav-link sidebar-settings-toggle w-full text-left <%= (typeof sidebarSettingsOpen !== 'undefined' && sidebarSettingsOpen) ? 'active' : '' %>" aria-expanded="false" aria-controls="sidebarSettingsMenu" title="Settings">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      <span class="sidebar-settings-label">Settings</span>
      <svg class="sidebar-settings-chevron w-3.5 h-3.5 shrink-0 opacity-50 ml-auto transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
    </button>
  </div>
</aside>
