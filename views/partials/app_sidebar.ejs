<% const np = typeof navPrimary !== 'undefined' ? navPrimary : (typeof activePage !== 'undefined' ? activePage : ''); %>
<% const _leadNavActive = np === 'find' || np === 'prospecting'; %>
<% const _ws = typeof workspace !== 'undefined' && workspace ? workspace : null; %>
<% const _wsList = typeof workspaceSwitcherList !== 'undefined' && workspaceSwitcherList ? workspaceSwitcherList : []; %>
<% const _wsAccent = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : '#CA8A04'; %>
<aside id="appSidebar" class="app-sidebar flex-col shrink-0 border-r border-brand-border/60 dark:border-white/10 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md overflow-y-auto custom-scrollbar" style="border-top: 3px solid <%= _wsAccent %>" aria-label="Main navigation">
  <div class="p-3 border-b border-brand-border/40 dark:border-white/10 sidebar-brand-row">
    <div class="flex items-start gap-1 min-w-0">
    <div class="relative min-w-0 flex-1" id="wsSwitcherWrapSidebar">
      <button type="button" id="wsSwitcherBtnSidebar" class="flex items-center gap-2.5 group w-full min-w-0 text-left rounded-xl px-2 py-2 hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-colors sidebar-ws-btn" aria-expanded="false" aria-haspopup="true" aria-controls="wsSwitcherMenuSidebar" title="<%= _ws && _ws.name ? _ws.name : 'Workspace' %>">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[22%]" aria-hidden="true">
          <img src="/images/adhello-app-icon.png" alt="" width="36" height="36" class="h-full w-full object-contain" loading="eager" decoding="async" />
        </span>
        <span class="min-w-0 flex-1 flex flex-col sidebar-ws-text">
          <span class="font-display font-black text-sm tracking-tight text-brand-dark dark:text-white truncate"><%= _ws && _ws.name ? _ws.name : 'Workspace' %></span>
          <span class="text-[9px] font-bold text-brand-muted truncate">Agency OS</span>
        </span>
        <span class="w-2 h-2 rounded-full shrink-0 sidebar-ws-accent" style="background-color: <%= _wsAccent %>" aria-hidden="true"></span>
        <svg class="w-4 h-4 shrink-0 text-brand-muted sidebar-ws-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </button>
      <div id="wsSwitcherMenuSidebar" class="hidden absolute left-0 right-0 mt-1 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl py-2 z-[120] text-left" role="menu">
        <p class="px-4 py-2 text-[9px] font-black uppercase tracking-widest text-brand-muted">Workspaces</p>
        <% _wsList.forEach(function (w) { %>
        <form method="post" action="/workspaces/switch" class="block">
          <input type="hidden" name="workspaceId" value="<%= w.id %>" />
          <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 flex items-center gap-2" role="menuitem">
            <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= w.accentColor || '#CA8A04' %>"></span>
            <span class="truncate"><%= w.name %></span>
          </button>
        </form>
        <% }) %>
        <div class="border-t border-brand-border dark:border-white/10 mt-1 pt-1">
          <a href="/workspaces/new" class="block px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10">+ Create workspace</a>
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-0.5 shrink-0 sidebar-chrome-btns">
      <button type="button" id="sidebarCollapseBtn" class="w-8 h-8 flex items-center justify-center rounded-lg text-brand-muted hover:text-brand-dark dark:hover:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 transition-colors" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse menu">
        <svg class="w-4 h-4 sidebar-icon-collapse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        <svg class="w-4 h-4 sidebar-icon-expand hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
      <button type="button" id="sidebarCloseBtn" class="w-8 h-8 flex items-center justify-center rounded-lg text-brand-muted hover:text-brand-dark dark:hover:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 transition-colors" aria-label="Hide sidebar" title="Hide menu">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    </div>
  </div>

  <nav class="flex-1 p-3 space-y-1 sidebar-primary-nav" aria-label="Primary">
    <a href="/today" class="sidebar-nav-link <%= np === 'today' ? 'active' : '' %>" title="Today">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
      <span>Today</span>
    </a>
    <a href="/pipeline" class="sidebar-nav-link <%= _leadNavActive && np !== 'find' ? 'active' : '' %>" title="Leads">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" /></svg>
      <span>Leads</span>
    </a>
    <% if (user) { %>
    <button type="button" id="manualLeadOpenSidebar" class="sidebar-nav-link w-full text-left border border-brand-border/50 dark:border-white/10" title="Add lead">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      <span>Add lead</span>
    </button>
    <% } %>
    <a href="/ceo" class="sidebar-nav-link <%= np === 'ceo' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
      <span>Automate</span>
    </a>
    <a href="/tasks" class="sidebar-nav-link <%= np === 'tasks' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Tasks</span>
    </a>
    <a href="/reports" class="sidebar-nav-link <%= np === 'reports' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
      <span>Reports</span>
    </a>
    <a href="/resources" class="sidebar-nav-link <%= np === 'resources' ? 'active' : '' %>">
      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      <span>Resources</span>
    </a>
    <% if (typeof ghlDashboardUrl !== 'undefined' && ghlDashboardUrl) { %>
    <a href="<%= ghlDashboardUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
      <span>GHL</span>
      <svg class="w-3 h-3 shrink-0 opacity-50 ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
    </a>
    <% } %>
    <% if (typeof hermesWebUiUrl !== 'undefined' && hermesWebUiUrl) { %>
    <a href="<%= hermesWebUiUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
      <span>AI Chat</span>
      <svg class="w-3 h-3 shrink-0 opacity-50 ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
    </a>
    <% } %>
  </nav>

  <div class="p-3 mt-auto border-t border-brand-border/40 dark:border-white/10 sidebar-settings-block">
    <p class="px-3 py-1 text-[9px] font-black uppercase tracking-widest text-brand-muted">Settings</p>
    <nav class="space-y-1" aria-label="Settings">
      <a href="/scripts" class="sidebar-nav-link sidebar-nav-sub">Script library</a>
      <a href="/workspace/voicemail" class="sidebar-nav-link sidebar-nav-sub">Voicemail</a>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
      <a href="/workspace/phones" class="sidebar-nav-link sidebar-nav-sub">Phone forwarding</a>
      <% } %>
      <a href="/workspace/team" class="sidebar-nav-link sidebar-nav-sub">Workspace settings</a>
      <a href="/activation" class="sidebar-nav-link sidebar-nav-sub">7-day activation</a>
    </nav>
  </div>
</aside>
