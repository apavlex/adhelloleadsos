<% const _lfs = typeof leadsFilterSuffix !== 'undefined' ? leadsFilterSuffix : ''; %>
<% const _lf = typeof leadListFilters !== 'undefined' && leadListFilters ? leadListFilters : {}; %>
<% const _fk = _lf.folderKey ? String(_lf.folderKey) : ''; %>
<% const _folders = typeof folders !== 'undefined' && folders ? folders : []; %>
<% const _tags = typeof tags !== 'undefined' && tags ? tags : []; %>
<% const _tagKey = _lf.tagKey ? String(_lf.tagKey) : ''; %>
<% const _qlItems = (typeof quickLogClient !== 'undefined' && quickLogClient && quickLogClient.items) ? quickLogClient.items : []; %>
<% const _isQlTag = _tagKey.indexOf('ql:') === 0; %>
<% const _qlDisp = _isQlTag ? _tagKey.slice(3) : ''; %>
<% const _activeQlTag = _isQlTag ? _qlItems.find(function (x) { return x && String(x.disposition) === _qlDisp; }) : null; %>
<% const _activeTag = !_isQlTag && _tagKey ? _tags.find(function (x) { return x && String(x.key) === _tagKey; }) : null; %>
<% const _tagFilterLabel = _activeTag ? (_activeTag.name || 'Tag') : (_activeQlTag ? (_activeQlTag.label || _qlDisp || 'Quick log') : 'Any tag'); %>
<% const _catOpts = typeof pipelineCategoryOptions !== 'undefined' && pipelineCategoryOptions ? pipelineCategoryOptions : []; %>
<% const _activeCategory = _lf.category ? String(_lf.category) : ''; %>
<% const _stOpts = typeof pipelineStatusOptions !== 'undefined' && pipelineStatusOptions ? pipelineStatusOptions : []; %>
<% const _src = typeof sourceFilter !== 'undefined' ? sourceFilter : 'all'; %>
<% const _hasActiveFilters = _lf && typeof _lf === 'object' && Object.keys(_lf).length > 0; %>
<% const _bookmarkedOnly = _lf.bookmarked === '1' || _lf.bookmarked === 'true' || _lf.bookmarked === 'yes'; %>
<% const _advOpen = !!(_lf.addedFrom || _lf.addedTo || _lf.stage || _lf.status || _lf.tagKey || _lf.workedBy || _activeCategory || (_lf.minRating != null && String(_lf.minRating) !== '') || (_lf.minReviews != null && String(_lf.minReviews) !== '') || (_lf.maxReviews != null && String(_lf.maxReviews) !== '') || _bookmarkedOnly); %>
<% const _reach = _lf.reach ? String(_lf.reach) : ''; %>
<% const _workedBy = _lf.workedBy ? String(_lf.workedBy).toLowerCase() : ''; %>
<% const _teamMembers = typeof teamMembers !== 'undefined' && Array.isArray(teamMembers) ? teamMembers : []; %>
<% const _wsProspect = typeof workspaceProspecting !== 'undefined' && workspaceProspecting ? workspaceProspecting : {}; %>
<% const _lowReviewsThreshold = _wsProspect.lowReviewsThreshold != null ? _wsProspect.lowReviewsThreshold : 30; %>
<% const _viewCount = typeof pipelineLeadsTotal === 'number' ? pipelineLeadsTotal : (typeof leads !== 'undefined' && Array.isArray(leads) ? leads.length : 0); %>

<section class="app-context-refine" aria-label="Search and refine">
  <div class="flex items-center justify-between gap-2 mb-2 px-1">
    <p class="text-[10px] font-black uppercase tracking-widest text-[#9CA3AF] dark:text-slate-500">Search &amp; refine</p>
    <% if (_hasActiveFilters) { %>
    <span class="rounded-full bg-brand-yellow/25 px-2 py-0.5 text-[8px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow">Filtered</span>
    <% } %>
  </div>
  <p class="text-[10px] font-semibold text-[#6B7280] dark:text-slate-400 px-1 mb-3 tabular-nums"><%= _viewCount %> lead<%= _viewCount === 1 ? '' : 's' %> in view</p>

  <% if (typeof leadSourceCounts !== 'undefined' && leadSourceCounts) { %>
  <div class="flex flex-col gap-1 mb-3" role="tablist" aria-label="Filter by lead source">
    <a href="/prospecting?tab=pipeline&amp;source=all<%- _lfs.replace(/&/g, '&amp;') %>" class="app-context-chip<%= (typeof sourceFilter === 'undefined' || sourceFilter === 'all') ? ' is-active' : '' %>">All (<%= leadSourceCounts.all %>)</a>
    <a href="/prospecting?tab=pipeline&amp;source=cold<%- _lfs.replace(/&/g, '&amp;') %>" class="app-context-chip<%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'cold') ? ' is-active' : '' %>">Cold (<%= leadSourceCounts.cold %>)</a>
    <a href="/prospecting?tab=pipeline&amp;source=inbound<%- _lfs.replace(/&/g, '&amp;') %>" class="app-context-chip<%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'inbound') ? ' is-active is-warm' : '' %>">Warm inbound (<%= leadSourceCounts.inbound %>)</a>
  </div>
  <% } %>

  <form method="get" action="/prospecting" class="space-y-3">
    <input type="hidden" name="tab" value="pipeline" />
    <input type="hidden" name="source" value="<%= _src %>" />
    <% if (_reach) { %><input type="hidden" name="reach" value="<%= _reach %>" /><% } %>

    <div>
      <label class="app-context-label" for="ctxFolderKey">Folder</label>
      <%- include('folder_filter_picker', {
        folderPickerTree: typeof folderPickerTree !== 'undefined' ? folderPickerTree : { roots: [], selectedLabel: 'Main pipeline (unfiled)' },
        selectedFolderKey: _fk,
        inputName: 'folderKey'
      }) %>
    </div>
    <div>
      <label class="app-context-label" for="ctxPipelineQ">Search</label>
      <input id="ctxPipelineQ" type="search" name="q" value="<%= _lf.q || '' %>" autocomplete="off" class="app-context-input" placeholder="Company, email, phone…" />
    </div>
    <div>
      <label class="app-context-label" for="ctxPipelineOrigin">Origin</label>
      <select id="ctxPipelineOrigin" name="origin" class="app-context-input">
        <option value=""<%= !_lf.origin ? ' selected' : '' %>>All origins</option>
        <option value="maps_business"<%= _lf.origin === 'maps_business' ? ' selected' : '' %>>Business</option>
        <option value="real_estate"<%= _lf.origin === 'real_estate' || _lf.origin === 'mobile_homes' || _lf.origin === 'home_owners' ? ' selected' : '' %>>Real estate</option>
        <option value="products"<%= _lf.origin === 'products' ? ' selected' : '' %>>Products</option>
        <option value="wholesale"<%= _lf.origin === 'wholesale' ? ' selected' : '' %>>Wholesale</option>
        <option value="search"<%= _lf.origin === 'search' ? ' selected' : '' %>>All searched</option>
        <option value="csv"<%= _lf.origin === 'csv' ? ' selected' : '' %>>CSV import</option>
        <option value="manual"<%= _lf.origin === 'manual' ? ' selected' : '' %>>Manual / offline</option>
        <option value="warm"<%= _lf.origin === 'warm' ? ' selected' : '' %>>Warm (inbound)</option>
      </select>
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="submit" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest">Apply</button>
      <a href="/prospecting?tab=pipeline&amp;source=<%= _src %>" class="inline-flex items-center justify-center rounded-full border border-[#E5E7EB] dark:border-white/15 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-[#374151] dark:text-slate-200">Clear</a>
    </div>

    <details class="pt-2 border-t border-[#E5E7EB] dark:border-white/10 group/more" <%= _advOpen ? 'open' : '' %>>
      <summary class="flex cursor-pointer list-none items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#6B7280] dark:text-slate-400 hover:text-[#111827] dark:hover:text-white [&::-webkit-details-marker]:hidden py-1">
        <span class="transition-transform duration-200 group-open/more:rotate-180" aria-hidden="true">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </span>
        More filters
      </summary>
      <div class="space-y-3 pt-3">
        <div>
          <label class="app-context-label">Added from</label>
          <input type="date" name="addedFrom" value="<%= _lf.addedFrom || '' %>" class="app-context-input" />
        </div>
        <div>
          <label class="app-context-label">Added to</label>
          <input type="date" name="addedTo" value="<%= _lf.addedTo || '' %>" class="app-context-input" />
        </div>
        <div>
          <label class="app-context-label">Pipeline stage</label>
          <select name="stage" class="app-context-input">
            <option value=""<%= !_lf.stage ? ' selected' : '' %>>All stages</option>
            <% if (typeof pipelineStages !== 'undefined' && pipelineStages && pipelineStages.length) { pipelineStages.forEach(function (st) { %>
            <option value="<%= st.id %>"<%= String(_lf.stage) === String(st.id) ? ' selected' : '' %>><%= st.name %></option>
            <% }); } %>
          </select>
        </div>
        <div>
          <label class="app-context-label">Status</label>
          <select name="status" class="app-context-input">
            <option value=""<%= !_lf.status ? ' selected' : '' %>>Any status</option>
            <% _stOpts.forEach(function (st) { %>
            <option value="<%= st %>"<%= _lf.status === st ? ' selected' : '' %>><%= st %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="app-context-label" for="ctxPipelineTagFilterSearch">Tag</label>
          <div class="tag-filter-combobox relative" id="ctxPipelineTagFilter" data-tag-filter>
            <input type="hidden" name="tagKey" value="<%= _tagKey %>" data-tag-filter-value />
            <button type="button" class="tag-filter-combobox-trigger app-context-input text-left flex items-center justify-between gap-2" aria-haspopup="listbox" aria-expanded="false" data-tag-filter-trigger>
              <span class="truncate" data-tag-filter-label><%= _tagFilterLabel %></span>
              <svg class="h-4 w-4 shrink-0 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="tag-filter-combobox-menu portaled-popover-surface hidden fixed z-[10000] mt-0 rounded-xl border border-brand-border dark:border-white/10 shadow-xl overflow-hidden" data-tag-filter-menu role="listbox">
              <div class="p-2 border-b border-brand-border/30 dark:border-white/10 bg-white dark:bg-slate-900">
                <input type="search" id="ctxPipelineTagFilterSearch" class="tag-filter-combobox-search w-full rounded-lg border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-1.5 text-sm font-semibold" placeholder="Search tags…" autocomplete="off" data-tag-filter-search />
              </div>
              <ul class="max-h-[min(16rem,50vh)] overflow-y-auto custom-scrollbar py-1" data-tag-filter-list>
                <li><button type="button" class="tag-filter-combobox-option w-full text-left px-3 py-2 text-sm font-semibold<%= !_tagKey ? ' is-selected' : '' %>" data-value="">Any tag</button></li>
                <% _tags.forEach(function (tg) { if (!tg || !tg.key) return; %>
                <li><button type="button" class="tag-filter-combobox-option w-full text-left px-3 py-2 text-sm font-semibold<%= _tagKey === String(tg.key) ? ' is-selected' : '' %>" data-value="<%= tg.key %>"><%= tg.name || 'Tag' %></button></li>
                <% }); %>
                <% if (_qlItems.length) { %>
                <li class="px-3 pt-2 pb-1 pointer-events-none"><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Quick log</span></li>
                <% _qlItems.forEach(function (ql) {
                  if (!ql || !ql.disposition) return;
                  var qlKey = 'ql:' + String(ql.disposition);
                %>
                <li><button type="button" class="tag-filter-combobox-option w-full text-left px-3 py-2 text-sm font-semibold<%= _tagKey === qlKey ? ' is-selected' : '' %>" data-value="<%= qlKey %>"><%= ql.label %></button></li>
                <% }); %>
                <% } %>
              </ul>
              <p class="hidden px-3 py-2 text-xs text-brand-muted border-t border-brand-border/30" data-tag-filter-empty>No tags match</p>
            </div>
          </div>
        </div>
        <div>
          <label class="app-context-label" for="ctxPipelineCategory">Category</label>
          <input type="text" id="ctxPipelineCategory" name="category" list="ctxPipelineCategoryOptions" value="<%= _activeCategory %>" placeholder="Any category" autocomplete="off" class="app-context-input" />
          <datalist id="ctxPipelineCategoryOptions">
            <% _catOpts.forEach(function (cat) { %><option value="<%= cat %>"></option><% }); %>
          </datalist>
        </div>
        <% if (_teamMembers.length > 1) { %>
        <div>
          <label class="app-context-label" for="ctxPipelineWorkedBy">Worked by</label>
          <select id="ctxPipelineWorkedBy" name="workedBy" class="app-context-input">
            <option value=""<%= !_workedBy ? ' selected' : '' %>>Anyone</option>
            <% _teamMembers.forEach(function (m) { %>
            <option value="<%= m.email %>"<%= _workedBy === m.email ? ' selected' : '' %>><%= m.label %></option>
            <% }); %>
          </select>
        </div>
        <% } %>
        <div>
          <label class="app-context-label">Min rating</label>
          <input type="number" name="minRating" min="0" max="5" step="0.1" value="<%= _lf.minRating || '' %>" placeholder="0" class="app-context-input" />
        </div>
        <div>
          <label class="app-context-label">Min reviews</label>
          <input type="number" name="minReviews" min="0" step="1" value="<%= _lf.minReviews || '' %>" placeholder="0" class="app-context-input" />
        </div>
        <div>
          <label class="app-context-label">Max reviews</label>
          <input type="number" name="maxReviews" min="0" step="1" value="<%= _lf.maxReviews || '' %>" placeholder="e.g. 60" class="app-context-input" />
        </div>
        <div class="flex flex-col gap-2">
          <button type="submit" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest w-full">Apply filters</button>
          <a href="/prospecting?tab=pipeline&amp;source=<%= encodeURIComponent(_src) %><% if (_fk) { %>&amp;folderKey=<%= encodeURIComponent(_fk) %><% } %>&amp;maxReviews=<%= encodeURIComponent(String(_lowReviewsThreshold)) %>" class="text-center text-[10px] font-black uppercase tracking-widest text-amber-800 dark:text-amber-200">Low reviews (≤ <%= _lowReviewsThreshold %>)</a>
          <% if (_bookmarkedOnly) { %>
          <input type="hidden" name="bookmarked" value="1" />
          <a href="/prospecting?tab=pipeline&amp;source=<%= encodeURIComponent(_src) %><% if (_fk) { %>&amp;folderKey=<%= encodeURIComponent(_fk) %><% } %>" class="text-center text-[10px] font-black uppercase tracking-widest text-brand-yellow">Clear bookmarked</a>
          <% } else { %>
          <a href="/prospecting?tab=pipeline&amp;source=<%= encodeURIComponent(_src) %><% if (_fk) { %>&amp;folderKey=<%= encodeURIComponent(_fk) %><% } %>&amp;bookmarked=1" class="text-center text-[10px] font-black uppercase tracking-widest text-[#374151] dark:text-slate-300">Bookmarked only</a>
          <% } %>
        </div>
      </div>
    </details>
  </form>
</section>
