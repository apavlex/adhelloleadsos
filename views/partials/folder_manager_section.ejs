<%
  var _folderCounts = typeof folderAggregateCounts !== 'undefined' && folderAggregateCounts ? folderAggregateCounts : {};
  var _folderTags = typeof folderAggregateTags !== 'undefined' && folderAggregateTags ? folderAggregateTags : {};
  var _foldersShell = typeof foldersShell !== 'undefined' && foldersShell;
%>
<section class="space-y-8" aria-label="Folder manager" id="folderManagerSection">
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
    <div>
      <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
        <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Outreach folders</span>
      </div>
      <div class="page-heading-with-tip">
        <h2 class="font-display font-black text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Folder manager</h2>
        <%- include('help/folder_manager_info') %>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <button type="button" id="folderOrganizeByLeadsBtn" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-5 py-3.5 text-[10px] font-black uppercase tracking-widest hover:border-brand-yellow/60 transition-colors inline-flex items-center justify-center gap-2" data-sort-mode="name" title="Sort folders with leads to the top and empty folders to the bottom" aria-pressed="false">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" /></svg>
        <span id="folderOrganizeByLeadsLabel">Organize by leads</span>
      </button>
      <p id="folderOrganizeStatus" class="sr-only" role="status" aria-live="polite"></p>
      <button type="button" id="folderMergeSelectedBtn" class="btn-pill bg-violet-600/10 dark:bg-violet-950/40 text-violet-800 dark:text-violet-200 border border-violet-500/35 px-5 py-3.5 text-[10px] font-black uppercase tracking-widest hover:border-violet-500/60 transition-colors inline-flex items-center justify-center gap-2 disabled:opacity-40 disabled:pointer-events-none" disabled title="Select 2+ folders with the checkboxes, then merge them into one">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 21l7.737-7.737a3 3 0 014.242 0l.818.818M4 21h5v-5M4 21l7.5-7.5M19 8l-6 6" /></svg>
        <span id="folderMergeSelectedLabel">Merge folders</span>
      </button>
      <button type="button" id="folderCreateOpen" class="btn-pill btn-primary px-6 md:px-8 py-3.5 text-[10px] font-black uppercase tracking-widest shrink-0 inline-flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        New subfolder
      </button>
    </div>
  </div>

  <div class="relative max-w-xl">
    <label for="folderSearchFilter" class="sr-only">Search folders</label>
    <div class="flex items-center gap-3 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 focus-within:border-brand-yellow focus-within:ring-2 focus-within:ring-brand-yellow/25 transition-all">
      <svg class="shrink-0 w-4 h-4 text-brand-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
      <input type="search" id="folderSearchFilter" autocomplete="off" placeholder="Search folders — HVAC, plumbing, dental…"
        class="folder-search-input flex-1 min-w-0 border-0 bg-transparent py-3 pr-1 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:outline-none focus:ring-0" />
    </div>
    <p id="folderSearchEmpty" class="hidden text-sm text-brand-muted mt-2">No folders match your search.</p>
  </div>

  <% if (_foldersShell) { %>
    <div id="folderTreeRoot" class="space-y-4" data-folders-hydrate="1" aria-busy="true">
      <div class="brand-card p-14 md:p-20 text-center dark:bg-slate-900 dark:border-white/10">
        <div class="mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-[3px] border-brand-yellow/35 border-t-brand-yellow" aria-hidden="true"></div>
        <p class="text-brand-muted font-medium">Loading folders…</p>
      </div>
    </div>
  <% } else if (!(folders || []).length) { %>
    <div class="brand-card p-14 md:p-20 text-center dark:bg-slate-900 dark:border-white/10">
      <p class="text-brand-muted mb-6 max-w-md mx-auto">No folders yet. Create one to organize outreach (e.g. Referrals, Events, High-priority).</p>
    </div>
  <% } else { %>
    <% const _tree = typeof folderTree !== 'undefined' && folderTree ? folderTree : { groups: [] }; %>
    <div class="space-y-4" id="folderTreeRoot">
      <% (_tree.groups || []).forEach(function (group) {
        var rootFolder = group.folder;
        var groupTotal = 0;
        if (rootFolder) {
          groupTotal = _folderCounts[rootFolder.key] || 0;
        } else {
          (group.children || []).forEach(function (child) {
            groupTotal += _folderCounts[child.key] || 0;
          });
        }
      %>
      <details class="folder-group brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10 group/folder" open data-folder-group="<%= group.key %>" data-folder-group-leads="<%= groupTotal %>" data-folder-group-search="<%= (group.name + ' ' + (group.jobType || '')).toLowerCase() %>">
        <summary class="cursor-pointer list-none flex flex-wrap items-center justify-between gap-3 px-6 py-4 bg-brand-cream/30 dark:bg-slate-950/40 border-b border-brand-border/30 dark:border-white/10 hover:bg-brand-cream/50 dark:hover:bg-slate-950/60 transition-colors [&::-webkit-details-marker]:hidden">
          <div class="min-w-0 flex-1">
            <p class="font-display font-black text-lg text-brand-dark dark:text-white flex flex-wrap items-center gap-2">
              <%= group.name %>
              <% if (group.isSystem) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted border border-brand-border/50 rounded-full px-2 py-0.5">System</span><% } %>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= (group.childRows || group.children || []).length %> subfolder<%= (group.childRows || group.children || []).length === 1 ? '' : 's' %></span>
            </p>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-1"><%= groupTotal %> lead<%= groupTotal === 1 ? '' : 's' %> total</p>
          </div>
          <span class="folder-group-chevron text-brand-muted text-xs font-bold uppercase tracking-widest transition-transform group-open/folder:rotate-180" aria-hidden="true">▾</span>
        </summary>
        <ul class="m-0 p-0 list-none divide-y divide-brand-border/20 dark:divide-white/5">
          <% if (rootFolder) { %>
            <%- include('folder_manager_node', {
              f: rootFolder,
              fc: _folderCounts[rootFolder.key] || 0,
              depth: 0,
              children: group.children || [],
              folderCounts: _folderCounts,
              folderAggregateTags: _folderTags
            }) %>
          <% } else { %>
            <% (group.children || []).forEach(function (child) { %>
              <%- include('folder_manager_node', {
                f: child,
                fc: _folderCounts[child.key] || 0,
                depth: 0,
                children: child.children || [],
                folderCounts: _folderCounts,
                folderAggregateTags: _folderTags
              }) %>
            <% }); %>
          <% } %>
          <% if (!rootFolder && !(group.children || []).length) { %>
            <li class="px-6 py-8 text-sm text-brand-muted list-none">No folders in this group.</li>
          <% } %>
        </ul>
      </details>
      <% }); %>
    </div>
  <% } %>
</section>
<% if (!_foldersShell) { %>
<textarea id="folderManagerHydrateJson" class="hidden" hidden readonly><%- JSON.stringify({
  folders: (folders || []).map(function (f) {
    return {
      key: f.key,
      name: f.name,
      jobType: f.jobType || '',
      parentFolderKey: f.parentFolderKey || '',
      searchPreset: null,
      outreachAutomation: f.outreachAutomation
        ? { enabled: !!f.outreachAutomation.enabled }
        : null,
      isPipelineDefault: !!f.isPipelineDefault,
      isTradeFolder: !!f.isTradeFolder,
    };
  }),
  groups: ((typeof folderTree !== 'undefined' && folderTree && folderTree.groups) || []).map(function (g) {
    return {
      key: g.key,
      name: g.name,
      isSystem: !!g.isSystem,
      folderKey: g.folder && g.folder.key ? g.folder.key : '',
      folderName: g.folder && g.folder.name ? g.folder.name : '',
      childRows: (g.childRows || []).map(function (row) {
        var f = row.folder || {};
        return { key: f.key || '', name: f.name || '', depth: row.depth || 1, isTrade: !!f.isTradeFolder };
      }),
    };
  }),
}).replace(/</g, '\\u003c') %></textarea>
<% } %>
