<% if (typeof hideSalesTrackerHeading === 'undefined' || !hideSalesTrackerHeading) { %>
<div class="mb-10 max-w-3xl">
  <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Daily Action <span class="text-brand-muted">Tracker</span></h1>
  <p class="text-brand-muted font-medium mt-2">Log hustle metrics per day. Data is stored per logged-in user. Your <strong class="text-brand-dark dark:text-white">AI prospecting coach</strong> below reads your live pipeline and today’s volume to keep you moving.</p>
</div>
<% } %>

<%- include('/partials/prospecting_coach_card') %>

<% const streakVal = typeof streak !== 'undefined' ? streak : 0; %>
<% const cs = typeof chartSeries !== 'undefined' && chartSeries ? chartSeries : []; %>
<% const maxBar = cs.length ? Math.max(1, ...cs.map((x) => x.total)) : 1; %>
<div class="grid lg:grid-cols-3 gap-6 mb-10">
  <div class="brand-card p-6 dark:bg-slate-900 dark:border-white/10 lg:col-span-1">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outreach streak</p>
    <p class="text-4xl font-display font-black text-emerald-600 dark:text-emerald-400"><%= streakVal %></p>
    <p class="text-xs text-brand-muted mt-2">Consecutive days (any touches) ending today if you logged activity.</p>
  </div>
  <div class="brand-card p-6 dark:bg-slate-900 dark:border-white/10 lg:col-span-2">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">14-day volume</p>
    <div class="flex items-end gap-1.5 h-32 w-full">
      <% cs.forEach((pt) => { %>
        <% const barPx = Math.max(4, Math.round((pt.total / maxBar) * 100)); %>
        <div class="flex-1 min-w-0 flex flex-col justify-end h-full group" title="<%= pt.date %>: <%= pt.total %>">
          <div class="w-full max-w-[24px] mx-auto rounded-t-lg bg-emerald-500/80 dark:bg-emerald-500 transition-all group-hover:brightness-110" style="height: <%= barPx %>px"></div>
          <span class="text-[8px] font-bold text-brand-muted text-center mt-1 truncate"><%= pt.date.slice(5) %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<div id="tracker" class="grid lg:grid-cols-2 gap-8 mb-14 scroll-mt-24">
  <div class="brand-card p-8 dark:bg-slate-900 dark:border-white/10">
    <h2 class="font-display font-extrabold text-lg mb-1 text-brand-dark dark:text-white">Today · <%= today %></h2>
    <p class="text-xs text-brand-muted mb-6">Cold outreach, social, creatives &amp; bids</p>
    <form action="/sales/tracker" method="post" class="space-y-4">
      <input type="hidden" name="date" value="<%= today %>" />
      <input type="hidden" name="returnTo" value="<%= typeof trackerReturnTo !== 'undefined' ? trackerReturnTo : '/sales/tracker' %>" />
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Cold emails</label>
          <input name="coldEmails" type="number" min="0" value="<%= todayRow.coldEmails != null ? todayRow.coldEmails : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Cold DMs</label>
          <input name="coldDms" type="number" min="0" value="<%= todayRow.coldDms != null ? todayRow.coldDms : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Cold calls</label>
          <input name="coldCalls" type="number" min="0" value="<%= todayRow.coldCalls != null ? todayRow.coldCalls : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Upwork / bids</label>
          <input name="upworkBids" type="number" min="0" value="<%= todayRow.upworkBids != null ? todayRow.upworkBids : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Social posts</label>
          <input name="socialPosts" type="number" min="0" value="<%= todayRow.socialPosts != null ? todayRow.socialPosts : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Ad creatives</label>
          <input name="adCreatives" type="number" min="0" value="<%= todayRow.adCreatives != null ? todayRow.adCreatives : 0 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white" />
        </div>
      </div>
      <div>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Call / dialer notes</label>
        <textarea name="callNotes" rows="3" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white" placeholder="Numbers dialed, outcomes, follow-ups…"><%= todayRow.callNotes || '' %></textarea>
      </div>
      <div>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Day notes</label>
        <textarea name="notes" rows="3" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white" placeholder="Wins, blockers, tomorrow’s focus…"><%= todayRow.notes || '' %></textarea>
      </div>
      <button type="submit" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">Save today</button>
    </form>
  </div>

  <div class="brand-card p-8 dark:bg-slate-900 dark:border-white/10">
    <h2 class="font-display font-extrabold text-lg mb-4 text-brand-dark dark:text-white">Today’s totals</h2>
    <% const t = todayRow || {}; %>
    <dl class="grid grid-cols-2 gap-4 text-sm">
      <div class="rounded-2xl bg-brand-cream/40 dark:bg-white/5 p-4 border border-brand-border/30 dark:border-white/10">
        <dt class="text-[10px] font-black uppercase text-brand-muted">Emails + DMs</dt>
        <dd class="text-2xl font-black text-brand-dark dark:text-white mt-1"><%= (parseInt(t.coldEmails,10)||0) + (parseInt(t.coldDms,10)||0) %></dd>
      </div>
      <div class="rounded-2xl bg-brand-cream/40 dark:bg-white/5 p-4 border border-brand-border/30 dark:border-white/10">
        <dt class="text-[10px] font-black uppercase text-brand-muted">Calls</dt>
        <dd class="text-2xl font-black text-brand-dark dark:text-white mt-1"><%= parseInt(t.coldCalls,10)||0 %></dd>
      </div>
      <div class="rounded-2xl bg-brand-cream/40 dark:bg-white/5 p-4 border border-brand-border/30 dark:border-white/10">
        <dt class="text-[10px] font-black uppercase text-brand-muted">Bids</dt>
        <dd class="text-2xl font-black text-brand-dark dark:text-white mt-1"><%= parseInt(t.upworkBids,10)||0 %></dd>
      </div>
      <div class="rounded-2xl bg-brand-cream/40 dark:bg-white/5 p-4 border border-brand-border/30 dark:border-white/10">
        <dt class="text-[10px] font-black uppercase text-brand-muted">Social posts</dt>
        <dd class="text-2xl font-black text-brand-dark dark:text-white mt-1"><%= parseInt(t.socialPosts,10)||0 %></dd>
      </div>
      <div class="rounded-2xl bg-brand-cream/40 dark:bg-white/5 p-4 border border-brand-border/30 dark:border-white/10 col-span-2">
        <dt class="text-[10px] font-black uppercase text-brand-muted">Ad creatives</dt>
        <dd class="text-2xl font-black text-brand-dark dark:text-white mt-1"><%= parseInt(t.adCreatives,10)||0 %></dd>
      </div>
    </dl>
  </div>
</div>

<% const cw = typeof checklistWeek !== 'undefined' && checklistWeek ? checklistWeek : { days: [], sumTotal: 0, daysWithActivity: 0 }; %>
<% const cm = typeof checklistMonth !== 'undefined' && checklistMonth ? checklistMonth : { days: [], sumTotal: 0, daysWithActivity: 0 }; %>
<section class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10" id="outreach-checklist" aria-label="Past outreach checklist">
  <div class="px-6 py-5 border-b border-brand-border dark:border-white/10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Past outreach checklist</h2>
      <p class="text-xs text-brand-muted dark:text-slate-400 mt-1 max-w-xl">Click any day to expand notes. <strong class="text-brand-dark dark:text-white">✓</strong> means at least one touch logged. Switch between the last 7 days and last 30 days.</p>
    </div>
    <div class="flex rounded-2xl border border-brand-border dark:border-white/10 p-1 bg-brand-cream/30 dark:bg-white/5 shrink-0" role="tablist" aria-label="Checklist range">
      <button type="button" id="chkTabWeek" class="tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors bg-brand-yellow text-brand-dark shadow-sm" aria-selected="true" data-range="week">This week</button>
      <button type="button" id="chkTabMonth" class="tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" aria-selected="false" data-range="month">This month</button>
    </div>
  </div>

  <div id="checklist-panel-week" class="p-3 sm:p-4">
    <p class="px-2 pb-3 text-[11px] font-medium text-brand-muted dark:text-slate-400">
      <span class="font-black text-brand-dark dark:text-white"><%= cw.daysWithActivity %></span> days with activity ·
      <span class="font-black text-brand-dark dark:text-white"><%= cw.sumTotal %></span> total touches
    </p>
    <div class="space-y-1">
      <% cw.days.forEach((day) => { %>
        <details class="group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/40 dark:bg-slate-950/30 open:bg-white/70 dark:open:bg-slate-800/40 open:border-brand-yellow/40 transition-colors">
          <summary class="flex flex-wrap items-center gap-3 py-3 px-3 sm:px-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="w-9 h-9 rounded-xl flex items-center justify-center text-sm font-black shrink-0 <%= day.total > 0 ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25' : 'bg-brand-cream/60 dark:bg-white/5 text-brand-muted dark:text-slate-500 border border-brand-border/30 dark:border-white/10' %>" title="<%= day.total > 0 ? 'Logged touches' : 'No touches' %>"><%= day.total > 0 ? '✓' : '·' %></span>
            <div class="min-w-0 flex-1">
              <div class="font-bold text-brand-dark dark:text-white text-sm flex flex-wrap items-center gap-2">
                <span><%= day.label %></span>
                <% if (day.isToday) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow bg-brand-yellow/15 px-2 py-0.5 rounded-full">Today</span><% } %>
                <span class="text-[10px] font-mono text-brand-muted dark:text-slate-500"><%= day.date %></span>
              </div>
              <div class="text-[11px] text-brand-muted dark:text-slate-400 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                <span>Emails <strong class="text-brand-dark dark:text-slate-200"><%= day.emails %></strong></span>
                <span>·</span><span>DMs <strong class="text-brand-dark dark:text-slate-200"><%= day.dms %></strong></span>
                <span>·</span><span>Calls <strong class="text-brand-dark dark:text-slate-200"><%= day.calls %></strong></span>
                <span>·</span><span>Bids <strong class="text-brand-dark dark:text-slate-200"><%= day.bids %></strong></span>
                <span>·</span><span>Social <strong class="text-brand-dark dark:text-slate-200"><%= day.socialPosts %></strong></span>
                <span>·</span><span>Ads <strong class="text-brand-dark dark:text-slate-200"><%= day.adCreatives %></strong></span>
              </div>
            </div>
            <span class="text-xl font-black text-brand-dark dark:text-white tabular-nums shrink-0"><%= day.total %></span>
            <% if (day.hasNotes) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow shrink-0 hidden sm:inline">Notes</span><% } %>
          </summary>
          <div class="px-3 sm:px-4 pb-4 pt-0 ml-0 sm:ml-12 border-t border-brand-border/30 dark:border-white/10 mt-0">
            <% if (day.callNotes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Call / dialer</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.callNotes %></p>
              </div>
            <% } %>
            <% if (day.notes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Day notes</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.notes %></p>
              </div>
            <% } %>
            <% if (!day.hasNotes) { %>
              <p class="text-xs text-brand-muted dark:text-slate-500 pt-3 italic">No notes for this day.</p>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  </div>

  <div id="checklist-panel-month" class="p-3 sm:p-4 hidden">
    <p class="px-2 pb-3 text-[11px] font-medium text-brand-muted dark:text-slate-400">
      <span class="font-black text-brand-dark dark:text-white"><%= cm.daysWithActivity %></span> days with activity ·
      <span class="font-black text-brand-dark dark:text-white"><%= cm.sumTotal %></span> total touches
    </p>
    <div class="space-y-1 max-h-[min(70vh,32rem)] overflow-y-auto pr-1">
      <% cm.days.forEach((day) => { %>
        <details class="group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/40 dark:bg-slate-950/30 open:bg-white/70 dark:open:bg-slate-800/40 open:border-brand-yellow/40 transition-colors">
          <summary class="flex flex-wrap items-center gap-3 py-3 px-3 sm:px-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="w-9 h-9 rounded-xl flex items-center justify-center text-sm font-black shrink-0 <%= day.total > 0 ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25' : 'bg-brand-cream/60 dark:bg-white/5 text-brand-muted dark:text-slate-500 border border-brand-border/30 dark:border-white/10' %>"><%= day.total > 0 ? '✓' : '·' %></span>
            <div class="min-w-0 flex-1">
              <div class="font-bold text-brand-dark dark:text-white text-sm flex flex-wrap items-center gap-2">
                <span><%= day.label %></span>
                <% if (day.isToday) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow bg-brand-yellow/15 px-2 py-0.5 rounded-full">Today</span><% } %>
                <span class="text-[10px] font-mono text-brand-muted dark:text-slate-500"><%= day.date %></span>
              </div>
              <div class="text-[11px] text-brand-muted dark:text-slate-400 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                <span>Emails <strong class="text-brand-dark dark:text-slate-200"><%= day.emails %></strong></span>
                <span>·</span><span>DMs <strong class="text-brand-dark dark:text-slate-200"><%= day.dms %></strong></span>
                <span>·</span><span>Calls <strong class="text-brand-dark dark:text-slate-200"><%= day.calls %></strong></span>
                <span>·</span><span>Bids <strong class="text-brand-dark dark:text-slate-200"><%= day.bids %></strong></span>
                <span>·</span><span>Social <strong class="text-brand-dark dark:text-slate-200"><%= day.socialPosts %></strong></span>
                <span>·</span><span>Ads <strong class="text-brand-dark dark:text-slate-200"><%= day.adCreatives %></strong></span>
              </div>
            </div>
            <span class="text-xl font-black text-brand-dark dark:text-white tabular-nums shrink-0"><%= day.total %></span>
          </summary>
          <div class="px-3 sm:px-4 pb-4 pt-0 ml-0 sm:ml-12 border-t border-brand-border/30 dark:border-white/10 mt-0">
            <% if (day.callNotes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Call / dialer</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.callNotes %></p>
              </div>
            <% } %>
            <% if (day.notes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Day notes</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.notes %></p>
              </div>
            <% } %>
            <% if (!day.hasNotes) { %>
              <p class="text-xs text-brand-muted dark:text-slate-500 pt-3 italic">No notes for this day.</p>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<script>
(function () {
  var w = document.getElementById('checklist-panel-week');
  var m = document.getElementById('checklist-panel-month');
  var tw = document.getElementById('chkTabWeek');
  var tm = document.getElementById('chkTabMonth');
  if (!w || !m || !tw || !tm) return;
  var active = 'bg-brand-yellow text-brand-dark shadow-sm';
  var inactive = 'text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white';
  function setWeek() {
    w.classList.remove('hidden');
    m.classList.add('hidden');
    tw.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + active;
    tm.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + inactive;
    tw.setAttribute('aria-selected', 'true');
    tm.setAttribute('aria-selected', 'false');
  }
  function setMonth() {
    m.classList.remove('hidden');
    w.classList.add('hidden');
    tm.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + active;
    tw.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + inactive;
    tm.setAttribute('aria-selected', 'true');
    tw.setAttribute('aria-selected', 'false');
  }
  tw.addEventListener('click', setWeek);
  tm.addEventListener('click', setMonth);
})();
</script>

