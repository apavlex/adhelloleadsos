<% if (typeof hideSalesTrackerHeading === 'undefined' || !hideSalesTrackerHeading) { %>
<div class="mb-10 max-w-3xl">
  <div class="page-heading-with-tip">
    <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Daily Action <span class="text-brand-muted">Tracker</span></h1>
    <%- include('/partials/app_info_tip', {
      tipId: 'sales-tracker-help',
      tipKey: 'sales-tracker',
      label: 'Daily action tracker',
      size: 'lg',
      content: 'Review totals for each day — numbers can combine what you save here with <strong class="text-brand-dark dark:text-white">calls and cadence steps</strong> we detect from lead activity. Adjust anything that looks off and save.'
    }) %>
  </div>
</div>
<% } %>

<% const streakVal = typeof streak !== 'undefined' ? streak : 0; %>
<% const cs = typeof chartSeries !== 'undefined' && chartSeries ? chartSeries : []; %>
<% const chartSum = cs.reduce(function (s, x) { return s + (x.total || 0); }, 0); %>
<% const maxBar = cs.length ? Math.max(1, ...cs.map((x) => x.total)) : 1; %>
<% const _ti = typeof trackerInferred !== 'undefined' && trackerInferred ? trackerInferred : { coldCalls: 0, coldEmails: 0, coldDms: 0, upworkBids: 0, socialPosts: 0, adCreatives: 0 }; %>
<% const _tiTot = (_ti.coldCalls || 0) + (_ti.coldEmails || 0) + (_ti.coldDms || 0) + (_ti.upworkBids || 0) + (_ti.socialPosts || 0) + (_ti.adCreatives || 0); %>
<div class="grid lg:grid-cols-3 gap-6 mb-10">
  <div class="brand-card p-6 dark:bg-slate-900 dark:border-white/10 lg:col-span-1">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outreach streak</p>
    <p class="text-4xl font-display font-black text-emerald-600 dark:text-emerald-400"><%= streakVal %></p>
    <p class="text-xs text-brand-muted mt-2">Consecutive days with volume from saved totals or from calls and cadence steps on your leads (whichever is higher per day).</p>
  </div>
  <div class="brand-card p-6 dark:bg-slate-900 dark:border-white/10 lg:col-span-2">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">14-day volume</p>
    <% if (chartSum === 0) { %>
    <div class="rounded-2xl border border-dashed border-brand-border dark:border-white/15 bg-brand-cream/20 dark:bg-white/5 px-5 py-10 text-center min-h-[10rem] flex flex-col items-center justify-center">
      <p class="text-sm font-semibold text-brand-dark dark:text-white">No volume in this window yet</p>
      <p class="text-xs text-brand-muted mt-2 max-w-md mx-auto leading-relaxed">Your volume chart lights up once you log activity — or connect the softphone to auto-log calls.</p>
    </div>
    <% } else { %>
    <div class="flex items-end gap-1.5 h-32 w-full">
      <% cs.forEach((pt) => { %>
        <% const barPx = Math.max(4, Math.round((pt.total / maxBar) * 100)); %>
        <div class="flex-1 min-w-0 flex flex-col justify-end h-full group" title="<%= pt.date %>: <%= pt.total %>">
          <span class="text-[9px] font-black text-brand-dark dark:text-white text-center mb-0.5 tabular-nums"><%= pt.total %></span>
          <div class="w-full max-w-[24px] mx-auto rounded-t-lg bg-emerald-500/80 dark:bg-emerald-500 transition-all group-hover:brightness-110" style="height: <%= barPx %>px"></div>
          <span class="text-[8px] font-bold text-brand-muted text-center mt-1 truncate"><%= pt.date.slice(5) %></span>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<%- include('/partials/review_today_widget', {
  touchesToday: typeof touchesToday !== 'undefined' ? touchesToday : null,
  touchGoal: typeof touchGoal !== 'undefined' ? touchGoal : 54,
}) %>


<% const cw = typeof checklistWeek !== 'undefined' && checklistWeek ? checklistWeek : { days: [], sumTotal: 0, daysWithActivity: 0 }; %>
<% const cm = typeof checklistMonth !== 'undefined' && checklistMonth ? checklistMonth : { days: [], sumTotal: 0, daysWithActivity: 0 }; %>
<style>
  #checklist-panel-week[data-hide-empty="1"] .tracker-checklist-row[data-empty="1"],
  #checklist-panel-month[data-hide-empty="1"] .tracker-checklist-row[data-empty="1"] {
    display: none;
  }
</style>
<section class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10" id="outreach-checklist" aria-label="Past outreach checklist">
  <div class="px-6 py-5 border-b border-brand-border dark:border-white/10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <div class="page-heading-with-tip">
        <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Past outreach checklist</h2>
        <%- include('/partials/app_info_tip', {
          tipId: 'sales-tracker-checklist-help',
          tipKey: 'sales-tracker-checklist',
          label: 'Past outreach checklist',
          size: 'sm',
          content: 'Days with no touches are hidden by default on long ranges so the list stays scannable. Expand a row for notes.'
        }) %>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2 shrink-0">
      <button type="button" id="chkToggleEmptyDays" class="px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-brand-muted dark:text-slate-300 hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors" aria-pressed="false" data-showing-empty="false">Show empty days</button>
      <div class="flex rounded-2xl border border-brand-border dark:border-white/10 p-1 bg-brand-cream/30 dark:bg-white/5" role="tablist" aria-label="Checklist range">
        <button type="button" id="chkTabWeek" class="tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors bg-brand-yellow text-brand-dark shadow-sm" aria-selected="true" data-range="week">This week</button>
        <button type="button" id="chkTabMonth" class="tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" aria-selected="false" data-range="month">This month</button>
      </div>
    </div>
  </div>

  <div id="checklist-panel-week" class="p-3 sm:p-4" data-hide-empty="1">
    <p class="px-2 pb-3 text-[11px] font-medium text-brand-muted dark:text-slate-400">
      <span class="font-black text-brand-dark dark:text-white"><%= cw.daysWithActivity %></span> days with activity ·
      <span class="font-black text-brand-dark dark:text-white"><%= cw.sumTotal %></span> total touches
    </p>
    <% if (cw.daysWithActivity === 0) { %>
    <p class="px-2 pb-3 text-xs text-brand-muted dark:text-slate-400 max-w-xl">No touches in this range yet — work the pipeline or use “Show empty days” to reveal the full calendar.</p>
    <% } %>
    <div class="space-y-1">
      <% cw.days.forEach((day) => { %>
        <% const _emptyRow = day.total === 0 && !day.hasNotes; %>
        <details class="tracker-checklist-row group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/40 dark:bg-slate-950/30 open:bg-white/70 dark:open:bg-slate-800/40 open:border-brand-yellow/40 transition-colors" data-empty="<%= _emptyRow ? '1' : '0' %>">
          <summary class="flex flex-wrap items-center gap-3 py-3 px-3 sm:px-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="w-9 h-9 rounded-xl flex items-center justify-center text-sm font-black shrink-0 <%= day.total > 0 ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25' : 'bg-brand-cream/60 dark:bg-white/5 text-brand-muted dark:text-slate-500 border border-brand-border/30 dark:border-white/10' %>" title="<%= day.total > 0 ? 'Logged touches' : 'No touches' %>"><%= day.total > 0 ? '✓' : '·' %></span>
            <div class="min-w-0 flex-1">
              <div class="font-bold text-brand-dark dark:text-white text-sm flex flex-wrap items-center gap-2">
                <span><%= day.label %></span>
                <% if (day.isToday) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow bg-brand-yellow/15 px-2 py-0.5 rounded-full">Today</span><% } %>
                <span class="text-[10px] font-mono text-brand-muted dark:text-slate-500"><%= day.date %></span>
              </div>
              <div class="text-[11px] text-brand-muted dark:text-slate-400 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                <span>Emails <strong class="text-brand-dark dark:text-slate-200"><%= day.emails %></strong></span>
                <span>·</span><span>DMs <strong class="text-brand-dark dark:text-slate-200"><%= day.dms %></strong></span>
                <span>·</span><span>Calls <strong class="text-brand-dark dark:text-slate-200"><%= day.calls %></strong></span>
                <span>·</span><span>Bids <strong class="text-brand-dark dark:text-slate-200"><%= day.bids %></strong></span>
                <span>·</span><span>Social <strong class="text-brand-dark dark:text-slate-200"><%= day.socialPosts %></strong></span>
                <span>·</span><span>Ads <strong class="text-brand-dark dark:text-slate-200"><%= day.adCreatives %></strong></span>
              </div>
            </div>
            <span class="text-xl font-black text-brand-dark dark:text-white tabular-nums shrink-0"><%= day.total %></span>
            <% if (day.hasNotes) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow shrink-0 hidden sm:inline">Notes</span><% } %>
          </summary>
          <div class="px-3 sm:px-4 pb-4 pt-0 ml-0 sm:ml-12 border-t border-brand-border/30 dark:border-white/10 mt-0">
            <% if (day.callNotes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Call / dialer</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.callNotes %></p>
              </div>
            <% } %>
            <% if (day.notes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Day notes</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.notes %></p>
              </div>
            <% } %>
            <% if (!day.hasNotes) { %>
              <p class="text-xs text-brand-muted dark:text-slate-500 pt-3 italic">No notes for this day.</p>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  </div>

  <div id="checklist-panel-month" class="p-3 sm:p-4 hidden" data-hide-empty="1">
    <p class="px-2 pb-3 text-[11px] font-medium text-brand-muted dark:text-slate-400">
      <span class="font-black text-brand-dark dark:text-white"><%= cm.daysWithActivity %></span> days with activity ·
      <span class="font-black text-brand-dark dark:text-white"><%= cm.sumTotal %></span> total touches
    </p>
    <% if (cm.daysWithActivity === 0) { %>
    <p class="px-2 pb-3 text-xs text-brand-muted dark:text-slate-400 max-w-xl">No touches in this range yet — work the pipeline or use “Show empty days” to reveal the full calendar.</p>
    <% } %>
    <div class="space-y-1 max-h-[min(70vh,32rem)] overflow-y-auto pr-1">
      <% cm.days.forEach((day) => { %>
        <% const _emptyRowM = day.total === 0 && !day.hasNotes; %>
        <details class="tracker-checklist-row group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/40 dark:bg-slate-950/30 open:bg-white/70 dark:open:bg-slate-800/40 open:border-brand-yellow/40 transition-colors" data-empty="<%= _emptyRowM ? '1' : '0' %>">
          <summary class="flex flex-wrap items-center gap-3 py-3 px-3 sm:px-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="w-9 h-9 rounded-xl flex items-center justify-center text-sm font-black shrink-0 <%= day.total > 0 ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25' : 'bg-brand-cream/60 dark:bg-white/5 text-brand-muted dark:text-slate-500 border border-brand-border/30 dark:border-white/10' %>"><%= day.total > 0 ? '✓' : '·' %></span>
            <div class="min-w-0 flex-1">
              <div class="font-bold text-brand-dark dark:text-white text-sm flex flex-wrap items-center gap-2">
                <span><%= day.label %></span>
                <% if (day.isToday) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow bg-brand-yellow/15 px-2 py-0.5 rounded-full">Today</span><% } %>
                <span class="text-[10px] font-mono text-brand-muted dark:text-slate-500"><%= day.date %></span>
              </div>
              <div class="text-[11px] text-brand-muted dark:text-slate-400 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                <span>Emails <strong class="text-brand-dark dark:text-slate-200"><%= day.emails %></strong></span>
                <span>·</span><span>DMs <strong class="text-brand-dark dark:text-slate-200"><%= day.dms %></strong></span>
                <span>·</span><span>Calls <strong class="text-brand-dark dark:text-slate-200"><%= day.calls %></strong></span>
                <span>·</span><span>Bids <strong class="text-brand-dark dark:text-slate-200"><%= day.bids %></strong></span>
                <span>·</span><span>Social <strong class="text-brand-dark dark:text-slate-200"><%= day.socialPosts %></strong></span>
                <span>·</span><span>Ads <strong class="text-brand-dark dark:text-slate-200"><%= day.adCreatives %></strong></span>
              </div>
            </div>
            <span class="text-xl font-black text-brand-dark dark:text-white tabular-nums shrink-0"><%= day.total %></span>
          </summary>
          <div class="px-3 sm:px-4 pb-4 pt-0 ml-0 sm:ml-12 border-t border-brand-border/30 dark:border-white/10 mt-0">
            <% if (day.callNotes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Call / dialer</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.callNotes %></p>
              </div>
            <% } %>
            <% if (day.notes) { %>
              <div class="pt-3">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-1">Day notes</p>
                <p class="text-sm text-brand-dark dark:text-slate-200 whitespace-pre-wrap"><%= day.notes %></p>
              </div>
            <% } %>
            <% if (!day.hasNotes) { %>
              <p class="text-xs text-brand-muted dark:text-slate-500 pt-3 italic">No notes for this day.</p>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<script>
(function () {
  var w = document.getElementById('checklist-panel-week');
  var m = document.getElementById('checklist-panel-month');
  var tw = document.getElementById('chkTabWeek');
  var tm = document.getElementById('chkTabMonth');
  var toggleEmpty = document.getElementById('chkToggleEmptyDays');
  if (!w || !m || !tw || !tm) return;
  var active = 'bg-brand-yellow text-brand-dark shadow-sm';
  var inactive = 'text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white';
  function activePanel() {
    return m.classList.contains('hidden') ? w : m;
  }
  function syncEmptyToggleLabel() {
    if (!toggleEmpty) return;
    var p = activePanel();
    var showing = p.getAttribute('data-hide-empty') !== '1';
    toggleEmpty.textContent = showing ? 'Hide empty days' : 'Show empty days';
    toggleEmpty.setAttribute('aria-pressed', showing ? 'true' : 'false');
    toggleEmpty.setAttribute('data-showing-empty', showing ? 'true' : 'false');
  }
  function setWeek() {
    w.classList.remove('hidden');
    m.classList.add('hidden');
    tw.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + active;
    tm.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + inactive;
    tw.setAttribute('aria-selected', 'true');
    tm.setAttribute('aria-selected', 'false');
    syncEmptyToggleLabel();
  }
  function setMonth() {
    m.classList.remove('hidden');
    w.classList.add('hidden');
    tm.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + active;
    tw.className = 'tracker-range-tab px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors ' + inactive;
    tm.setAttribute('aria-selected', 'true');
    tw.setAttribute('aria-selected', 'false');
    syncEmptyToggleLabel();
  }
  tw.addEventListener('click', setWeek);
  tm.addEventListener('click', setMonth);
  if (toggleEmpty) {
    toggleEmpty.addEventListener('click', function () {
      var p = activePanel();
      if (p.getAttribute('data-hide-empty') === '1') p.removeAttribute('data-hide-empty');
      else p.setAttribute('data-hide-empty', '1');
      syncEmptyToggleLabel();
    });
  }
  syncEmptyToggleLabel();
})();
</script>

