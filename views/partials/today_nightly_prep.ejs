<% const npm = typeof nightlyPrepMeta !== 'undefined' && nightlyPrepMeta ? nightlyPrepMeta : {}; %>
<% const _cronPrepUrl = typeof cronPrepUrl !== 'undefined' && cronPrepUrl ? cronPrepUrl : '/api/cron/nightly-prep'; %>
<section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-label="Overnight prep">
  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
    <div class="flex-1 min-w-0">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Tomorrow’s pipeline</p>
      <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2">Overnight Maps prep</h2>
      <p class="text-sm text-brand-muted dark:text-slate-400 mb-4">
        Uses your workspace <strong class="text-brand-dark dark:text-white">ICP</strong>
        <% if (typeof icpLabel !== 'undefined' && icpLabel) { %>(<span class="font-semibold"><%= icpLabel %></span>)<% } %>
        — same keyword/city/state as Find leads. Saves enriched rows into Pipeline (<code class="text-xs">source: nightly_prep</code>) and attaches cadences when configured.
      </p>

      <form method="post" action="/today/nightly-prep-settings" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 mb-4">
        <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-bold text-brand-dark dark:text-white">
          <input type="checkbox" name="enabled" value="1" class="rounded border-brand-border" <%= npm.enabled ? 'checked' : '' %> />
          Let Render cron run this nightly for this workspace
        </label>
        <button type="submit" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white w-fit">Save</button>
      </form>

      <form method="post" action="/today/nightly-prep-run" class="inline">
        <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest shadow-md">Run prep now</button>
      </form>
      <p class="text-[11px] text-brand-muted mt-2">Manual run ignores the checkbox — useful for testing. Cron uses workspaces with the box checked, <strong class="text-brand-dark dark:text-white">or</strong> IDs in env <code class="text-xs">NIGHTLY_PREP_WORKSPACE_IDS</code>.</p>

      <% if (npm.lastRunAt || npm.lastStatus) { %>
      <div class="mt-5 rounded-xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/60 px-4 py-3 text-[11px] space-y-1">
        <p><span class="font-black uppercase tracking-wider text-brand-muted">Last run</span> <%= npm.lastRunAt ? new Date(npm.lastRunAt).toLocaleString() : '—' %></p>
        <p><span class="font-black uppercase tracking-wider text-brand-muted">Status</span> <%= npm.lastStatus || '—' %>
          <% if (npm.lastResultCount != null) { %> · <%= npm.lastResultCount %> raw<% } %>
          <% if (npm.lastLeadsSaved != null) { %> · <%= npm.lastLeadsSaved %> saved<% } %>
        </p>
        <% if (npm.lastError) { %>
        <p class="text-rose-600 dark:text-rose-400 font-semibold"><%= npm.lastError %></p>
        <% } %>
      </div>
      <% } %>
    </div>

    <details class="lg:w-[28rem] shrink-0 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/40 px-4 py-3">
      <summary class="cursor-pointer text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Render cron setup</summary>
      <div class="mt-3 text-[11px] text-brand-muted dark:text-slate-400 space-y-3 leading-relaxed">
        <p>In Render Dashboard → <strong class="text-brand-dark dark:text-white">Cron Jobs</strong> → New Cron Job → attach your web service.</p>
        <p><strong class="text-brand-dark dark:text-white">Schedule:</strong> e.g. <code class="text-xs">0 6 * * *</code> (06:00 UTC daily — adjust for your morning).</p>
        <p><strong class="text-brand-dark dark:text-white">Request:</strong> <code class="text-xs break-all block mt-1 p-2 rounded bg-white/80 dark:bg-slate-900/80"><%= _cronPrepUrl %>?secret=YOUR_CRON_SECRET</code></p>
        <p><code class="text-xs">YOUR_CRON_SECRET</code> must match env <code class="text-xs">CRON_SECRET</code> on the service (same as heartbeat).</p>
        <p>Optional env <code class="text-xs">NIGHTLY_PREP_WORKSPACE_IDS=id1,id2</code> runs those workspaces without the checkbox (still needs ICP + Maps API keys).</p>
      </div>
    </details>
  </div>
</section>
