<% 
  const sjList = typeof schedules !== 'undefined' && schedules ? schedules : [];
  const sjSuccess = typeof scheduleSuccess !== 'undefined' && scheduleSuccess;
  const sjEmbed = typeof scheduledJobsEmbed !== 'undefined' && scheduledJobsEmbed;
  const sjDeleteReturn = typeof scheduleDeleteReturnTo !== 'undefined' && scheduleDeleteReturnTo ? scheduleDeleteReturnTo : '/prospecting?tab=queue';
  const _wsNav = typeof workspaceSwitcherList !== 'undefined' ? workspaceSwitcherList : [];
  function sjWorkspaceName(wid) {
    const id = String(wid || '');
    for (let i = 0; i < _wsNav.length; i++) {
      if (_wsNav[i].id === id) return _wsNav[i].name || 'Workspace';
    }
    return 'Workspace';
  }
  function sjJobTitle(job) {
    if (typeof scheduleDisplayTitle === 'function') return scheduleDisplayTitle(job);
    return job.keyword || 'Search';
  }
  function sjJobSubtitle(job) {
    if (typeof scheduleDisplaySubtitle === 'function') return scheduleDisplaySubtitle(job);
    return `${job.city}, ${job.state} · ${job.maxResults || 20} results`;
  }
  function sjJobTypeLabel(job) {
    const jt = typeof normalizeJobType === 'function' ? normalizeJobType(job.jobType) : (job.jobType || 'maps_business');
    if (typeof JOB_TYPE_LABELS !== 'undefined' && JOB_TYPE_LABELS[jt]) return JOB_TYPE_LABELS[jt];
    return jt === 'real_estate' ? 'Real estate' : 'Business (Maps)';
  }
  function sjFreqLabel(job) {
    if (typeof scheduleFrequencyLabel === 'function') return scheduleFrequencyLabel(job);
    return job.scheduledRunAt ? 'One-time' : (job.frequency || 'daily');
  }
%>
<div class="<%= sjEmbed ? '' : 'max-wide' %>">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 <%= sjEmbed ? 'mb-8' : 'mb-12' %>">
    <div class="<%= sjEmbed ? '' : 'animate-fade-in' %>">
      <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm <%= sjEmbed ? 'mb-4' : 'mb-6' %>">
        <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Scheduled lead runs</span>
      </div>
      <h2 class="font-display font-black <%= sjEmbed ? 'text-3xl md:text-4xl' : 'text-5xl md:text-6xl' %> tracking-tight text-brand-dark dark:text-white <%= sjEmbed ? 'mb-3' : 'mb-4' %>">Scheduled <span class="text-brand-muted">Jobs</span></h2>
      <p class="<%= sjEmbed ? 'text-sm md:text-base' : 'text-lg' %> text-brand-muted font-medium max-w-xl">
        Automated scrapes for business leads (Maps) and real estate listings. Runs on your schedule — one-time or recurring nightly.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-2 shrink-0">
      <a href="/leads/find" class="btn-pill btn-primary px-6 md:px-8 flex items-center justify-center gap-3 group">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        New search
      </a>
    </div>
  </div>

  <% if (sjSuccess) { %>
    <div class="max-w-xl <%= sjEmbed ? 'mb-6' : 'mx-auto mb-10' %> bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-800/50 text-emerald-800 dark:text-emerald-200 px-6 py-4 rounded-2xl flex items-center gap-4 animate-bounce-subtle">
      <svg class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
      <span class="font-bold text-sm">Scheduled job saved — it will run at the time you picked (recurring jobs repeat until deleted).</span>
    </div>
  <% } %>

  <% if (sjList.length > 0) { %>
    <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-brand-border dark:border-white/10 bg-white dark:bg-white/5">
              <th class="px-6 md:px-8 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400">Job</th>
              <th class="px-4 md:px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Location</th>
              <th class="px-4 md:px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Schedule</th>
              <th class="px-4 md:px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Last run</th>
              <th class="px-4 md:px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
            <% sjList.forEach(function (job) { %>
              <tr class="group hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-all duration-300">
                <td class="px-6 md:px-8 py-6">
                  <div class="flex items-center gap-3 md:gap-4">
                    <div class="w-10 h-10 shrink-0 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark dark:text-white border border-brand-yellow/20">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </div>
                    <div class="min-w-0">
                      <div class="font-bold text-brand-dark dark:text-white text-base truncate"><%= sjJobTitle(job) %></div>
                      <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5 flex flex-wrap items-center gap-2">
                        <span class="inline-flex rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 px-2 py-0.5 text-[9px] font-black normal-case"><%= sjJobTypeLabel(job) %></span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-brand-cream/80 dark:bg-white/10 px-2 py-0.5 text-[9px] font-black normal-case tracking-tight text-brand-dark dark:text-white" title="Workspace"><%= sjWorkspaceName(job.workspaceId) %></span>
                        <span class="normal-case tracking-normal"><%= sjJobSubtitle(job) %></span>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-4 md:px-6 py-6 text-center">
                  <span class="text-sm font-bold text-brand-dark dark:text-white"><%= job.city %>, <%= job.state %></span>
                </td>
                <td class="px-4 md:px-6 py-6 text-center">
                  <div class="inline-flex flex-col items-center">
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-300 mb-1">
                      <%= sjFreqLabel(job) %>
                    </span>
                    <div class="text-[10px] font-bold text-brand-dark dark:text-white tracking-tight">
                      <% if (job.scheduledRunAt) { %>
                        <%= job.scheduledDate || '' %> · <%= job.scheduledTime || '09:00' %>
                      <% } else { %>
                        @ <%= job.scheduledTime || '09:00' %>
                      <% } %>
                    </div>
                    <div class="text-[9px] font-medium text-brand-muted uppercase tracking-tighter">
                      <%= job.timezone || 'UTC' %>
                    </div>
                  </div>
                </td>
                <td class="px-4 md:px-6 py-6 text-center text-sm font-medium text-brand-muted dark:text-slate-400">
                  <div class="flex flex-col items-center">
                    <span class="font-bold text-brand-dark dark:text-white"><%= job.lastRun ? new Date(job.lastRun).toLocaleDateString() : 'Pending' %></span>
                    <span class="text-[10px]"><%= job.lastRun ? new Date(job.lastRun).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Waiting for run...' %></span>
                  </div>
                </td>
                <td class="px-4 md:px-6 py-6 text-right">
                  <form action="/schedules/delete" method="POST" onsubmit="return confirm('Stop this scheduled job?')">
                    <input type="hidden" name="key" value="<%= job.key %>">
                    <input type="hidden" name="returnTo" value="<%= sjDeleteReturn %>">
                    <button type="submit" class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-red-500 hover:bg-red-50 dark:hover:bg-red-950/40 hover:border-red-200 dark:hover:border-red-800/50 transition-all flex items-center justify-center ml-auto" aria-label="Delete scheduled job">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="brand-card p-16 md:p-24 text-center dark:bg-slate-900 dark:border-white/10 <%= sjEmbed ? '' : 'max-wide' %>">
      <div class="w-20 h-20 bg-brand-cream dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border dark:border-white/10">
        <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
      </div>
      <h3 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-4">No scheduled jobs</h3>
      <p class="text-brand-muted font-medium mb-10 max-w-md mx-auto">Create a business Maps job or a real estate job with a one-time or recurring schedule. Results appear in Search history when each run completes.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/leads/find" class="btn-pill btn-primary px-10">New search</a>
      </div>
    </div>
  <% } %>
</div>
