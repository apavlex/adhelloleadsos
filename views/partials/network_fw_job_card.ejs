<%# Expects: row (team field work row) %>
<article class="net-card fw-row">
  <div class="fw-owner-bar" title="Whose Reviews app this project belongs to">
    <span class="fw-owner-bar__label">Teammate app</span>
    <span class="fw-owner-bar__name"><%= row.memberName %></span>
  </div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 min-w-0">
      <h3 class="font-display font-bold text-base md:text-lg truncate"><%= row.title %></h3>
      <span class="net-pill fw-pill-<%= row.status %><%= row.overdue ? ' fw-pill-overdue' : '' %>"><%= row.statusLabel %><%= row.overdue ? ' · overdue' : '' %></span>
    </div>
    <span class="fw-cust-label">Customer</span>
    <p class="text-sm font-semibold text-brand-dark dark:text-white truncate"><%= row.customerName %></p>
    <div class="fw-meta">
      <% if (row.whenLabel) { %><span class="text-[12px] font-semibold <%= row.overdue ? 'text-rose-600' : 'text-brand-muted' %>"><%= row.whenLabel %></span><% } %>
      <% if (row.photoCount) { %><span class="text-[12px] font-semibold text-brand-muted"><%= row.photoCount %> photo<%= row.photoCount === 1 ? '' : 's' %></span><% } %>
    </div>
    <% if (row.latestNote) { %>
    <p class="fw-note"><%= row.latestNote.length > 280 ? row.latestNote.slice(0, 280) + '…' : row.latestNote %></p>
    <% } %>
    <% if (row.photos && row.photos.length) { %>
    <div class="fw-photos">
      <% row.photos.forEach(function (p) { %>
      <a class="fw-photo" href="<%= p.href %>" target="_blank" rel="noopener" title="<%= p.caption || 'Job photo' %>">
        <img src="<%= p.href %>" alt="<%= p.caption || 'Job photo' %>" loading="lazy" decoding="async" width="52" height="52" />
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
  <div class="flex flex-wrap gap-2 shrink-0">
    <% if (row.ownerJobHref) { %>
    <a href="<%= row.ownerJobHref %>" class="net-btn net-btn-yellow">Open job</a>
    <% } %>
    <% if (row.ownerCustomerHref) { %>
    <a href="<%= row.ownerCustomerHref %>" class="net-btn net-btn-ghost">Customer</a>
    <% } %>
  </div>
</article>
