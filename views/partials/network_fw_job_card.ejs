<%# Shared by Team field work + Team calendar lists. Expects: row %>
<%
  const _hasTime = !!(row.timeLabel);
  const _hasDay = !!(row.dayLabel);
  const _whenMain = _hasTime ? row.timeLabel : (row.whenLabel || 'Unscheduled');
  const _whenSub = _hasTime && _hasDay ? row.dayLabel : (!_hasTime && _hasDay ? '' : '');
  // Twins collapsed by dedupeFieldRows list every schedule on one card.
  const _dateLabels = Array.isArray(row.dateLabels)
    ? row.dateLabels.map(function (d) { return String(d || '').trim(); }).filter(Boolean)
    : [];
  const _extraDates = _dateLabels.filter(function (d) {
    return d && d !== _whenMain && d !== row.whenLabel && d !== _whenSub;
  });
  const _photos = Array.isArray(row.photos) ? row.photos : [];
  const _photo = _photos.length ? _photos[0] : null;
  const _projectLabel = [row.title, row.customerName].filter(Boolean).join(' · ');
  const _esc = function (s) { return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); };
%>
<article class="fw-job" data-os-lr-gallery data-os-lr-project="<%= _esc(row.title) %>" data-os-lr-customer="<%= _esc(row.customerName) %>" data-os-lr-teammate="<%= _esc(row.memberName) %>">
  <div class="fw-job__top">
    <div class="min-w-0">
      <p class="fw-job__when<%= row.overdue ? ' is-overdue' : '' %>">
        <%= _whenMain %>
        <% if (_whenSub) { %><span class="fw-job__when-sub"><%= _whenSub %></span><% } %>
        <% if (_extraDates.length) { %>
        <span class="fw-job__when-sub"><%= _extraDates.join(' · ') %></span>
        <% } %>
      </p>
    </div>
    <div class="fw-job__team" title="Whose Reviews app this project belongs to">
      <div class="min-w-0">
        <small>Teammate</small>
        <span><%= row.memberName %></span>
      </div>
    </div>
  </div>

  <div>
    <h3 class="fw-job__title font-display"><%= row.title %></h3>
    <div class="fw-job__status">
      <span class="net-pill fw-pill-<%= row.status %><%= row.overdue ? ' fw-pill-overdue' : '' %>"><%= row.statusLabel %><%= row.overdue ? ' · overdue' : '' %></span>
      <% if (row.valueLabel) { %>
      <span class="fw-job__value" title="Project value"><%= row.valueLabel %></span>
      <% } %>
    </div>
  </div>

  <div class="fw-job__body<%= _photo ? ' has-photo' : '' %>">
    <div class="min-w-0">
      <p class="fw-job__customer">
        <small>Customer</small>
        <%= row.customerName %>
      </p>
      <% if (row.latestNote) { %>
      <p class="fw-job__note" style="margin-top:0.45rem"><%= row.latestNote.length > 160 ? row.latestNote.slice(0, 160) + '…' : row.latestNote %></p>
      <% } else if (row.photoCount) { %>
      <p class="fw-job__note" style="margin-top:0.45rem"><%= row.photoCount %> photo<%= row.photoCount === 1 ? '' : 's' %></p>
      <% } %>
    </div>
    <% if (_photo) { %>
    <a
      class="fw-job__shot"
      href="<%= _photo.href %>"
      data-os-lr-open
      data-os-lr-src="<%= _photo.href %>"
      data-os-lr-caption="<%= _esc(_photo.caption || 'Job photo') %>"
      data-os-lr-project="<%= _esc(row.title) %>"
      data-os-lr-customer="<%= _esc(row.customerName) %>"
      data-os-lr-teammate="<%= _esc(row.memberName) %>"
      title="<%= _photo.caption || _projectLabel || 'Job photo' %>"
    >
      <img src="<%= _photo.href %>" alt="<%= _photo.caption || 'Job photo' %>" loading="lazy" decoding="async" width="72" height="72" />
    </a>
    <% /* Keep remaining job photos in this card’s gallery only (not mixed with other jobs). */ %>
    <% _photos.slice(1).forEach(function (p) { %>
    <a
      class="sr-only"
      href="<%= p.href %>"
      data-os-lr-open
      data-os-lr-src="<%= p.href %>"
      data-os-lr-caption="<%= _esc(p.caption || 'Job photo') %>"
      data-os-lr-project="<%= _esc(row.title) %>"
      data-os-lr-customer="<%= _esc(row.customerName) %>"
      data-os-lr-teammate="<%= _esc(row.memberName) %>"
      tabindex="-1"
      aria-hidden="true"
    >Photo</a>
    <% }); %>
    <% } %>
  </div>

  <div class="fw-job__actions">
    <% if (row.ownerJobHref) { %>
    <a href="<%= row.ownerJobHref %>" class="net-btn net-btn-yellow">Open job</a>
    <% } %>
    <% if (row.ownerCustomerHref) { %>
    <a href="<%= row.ownerCustomerHref %>" class="net-btn net-btn-ghost">Customer</a>
    <% } %>
  </div>
</article>
