<% const _board = typeof opportunityBoard !== 'undefined' && opportunityBoard ? opportunityBoard : null; %>
<% const _compact = typeof opportunityCompact !== 'undefined' && opportunityCompact; %>
<% if (_board && _board.pipeline) { %>
<style>
  .opp-board {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    align-items: stretch;
    padding-bottom: 0.35rem;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  .opp-board::-webkit-scrollbar { height: 0.45rem; }
  .opp-board::-webkit-scrollbar-thumb {
    background: rgba(15, 39, 71, 0.22);
    border-radius: 999px;
  }
  html.dark .opp-board::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.22); }
  .opp-stage {
    position: relative;
    flex: 0 0 auto;
    width: 15.75rem;
    min-width: 13.75rem;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 1.15rem;
    padding: 0.85rem 0.8rem 0.7rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    max-height: min(70vh, 38rem);
  }
  html.dark .opp-stage { background: rgba(15, 23, 42, 0.72); border-color: rgba(255, 255, 255, 0.08); }
  .opp-stage.is-resizing { user-select: none; }
  .opp-stage-resize {
    position: absolute;
    top: 0.55rem;
    bottom: 0.55rem;
    right: -0.45rem;
    width: 0.9rem;
    z-index: 6;
    cursor: col-resize;
    touch-action: none;
    opacity: 0;
    pointer-events: none;
  }
  #oppBoard.is-editing .opp-stage-resize {
    opacity: 1;
    pointer-events: auto;
  }
  .opp-stage-resize::after {
    content: '';
    position: absolute;
    top: 12%;
    bottom: 12%;
    left: 50%;
    width: 0.18rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.12);
    transition: background 0.15s ease, width 0.15s ease, opacity 0.15s ease;
  }
  #oppBoard.is-editing .opp-stage:hover .opp-stage-resize::after,
  #oppBoard.is-editing .opp-stage.is-resizing .opp-stage-resize::after {
    background: rgba(15, 39, 71, 0.45);
    width: 0.25rem;
  }
  html.dark .opp-stage-resize::after { background: rgba(255, 255, 255, 0.18); }
  html.dark #oppBoard.is-editing .opp-stage:hover .opp-stage-resize::after,
  html.dark #oppBoard.is-editing .opp-stage.is-resizing .opp-stage-resize::after {
    background: rgba(250, 204, 21, 0.7);
  }
  .opp-stage-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.65rem; }
  .opp-stage-title { margin: 0; }
  .opp-stage-name-input {
    display: none;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: 0.55rem;
    background: rgba(250, 247, 237, 0.9);
    padding: 0.35rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 800;
    color: inherit;
    outline: none;
  }
  .opp-stage-name-input:focus {
    border-color: rgba(250, 204, 21, 0.75);
    box-shadow: 0 0 0 2px rgba(250, 204, 21, 0.28);
  }
  html.dark .opp-stage-name-input {
    background: rgba(15, 23, 42, 0.85);
    border-color: rgba(255, 255, 255, 0.14);
  }
  #oppBoard.is-editing .opp-stage-title { display: none; }
  #oppBoard.is-editing .opp-stage-name-input { display: block; }
  #oppBoard:not(.is-editing) .opp-actions { display: none !important; }
  #oppBoard.is-editing { outline: 2px solid rgba(250, 204, 21, 0.45); outline-offset: -2px; }
  #oppCancelEdit[hidden] { display: none !important; }
  #oppBoard:not(.is-editing) #oppDeletePipeline {
    display: none !important;
  }
  #oppDeletePipeline:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  #oppEditBoard.is-saving-mode {
    background: #0f2747;
    color: #fff;
    border-color: #0f2747;
  }
  html.dark #oppEditBoard.is-saving-mode {
    background: #FFDB3A;
    color: #111827;
    border-color: #FFDB3A;
  }
  .opp-stage-count { display: inline-flex; align-items: center; justify-content: center; min-width: 1.35rem; height: 1.35rem; padding: 0 0.35rem; border-radius: 999px; background: rgba(250, 204, 21, 0.22); color: #111827; font-size: 0.6875rem; font-weight: 800; }
  html.dark .opp-stage-count { color: #f8fafc; }
  .opp-stage-cards {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 7.25rem;
    min-width: 0;
    flex: 1 1 auto;
    border-radius: 0.85rem;
    background: rgba(250, 247, 237, 0.72);
    padding: 0.4rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  html.dark .opp-stage-cards { background: rgba(2, 6, 23, 0.35); }
  .opp-stage-cards > .opp-card,
  .opp-stage-cards > .opp-drop {
    flex: 0 0 auto;
  }
  .opp-stage-cards::-webkit-scrollbar { width: 0.4rem; }
  .opp-stage-cards::-webkit-scrollbar-thumb {
    background: rgba(15, 39, 71, 0.22);
    border-radius: 999px;
  }
  html.dark .opp-stage-cards::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.22); }
  .opp-drop { flex: 1 1 auto; min-height: 6.5rem; display: flex; align-items: center; justify-content: center; border: 1px dashed rgba(17, 24, 39, 0.14); border-radius: 0.7rem; color: #9ca3af; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; }
  html.dark .opp-drop { border-color: rgba(255, 255, 255, 0.14); }
  .opp-compact .opp-stage { width: 15.25rem; min-width: 13.75rem; padding: 0.7rem 0.7rem 0.55rem; max-height: none; }
  .opp-compact .opp-card { padding: 0.55rem 0.6rem; flex: 0 0 auto; }
  .opp-compact .opp-stage-cards {
    /* Room for ~2 full cards (title + meta + action icons); scroll for the rest */
    max-height: 17.5rem;
    scrollbar-gutter: stable;
  }
  .opp-compact .opp-stage-cards.is-empty {
    max-height: none;
    min-height: 7.25rem;
  }
  .opp-compact .opp-drop { min-height: 6.25rem; }

  /* Full Opportunities page — board is the page (no floating card), columns fill height */
  body.opp-page {
    height: 100dvh;
    max-height: 100dvh;
    background: #fff;
  }
  html.dark body.opp-page {
    background: #0f172a;
  }
  body.opp-page .app-shell-content {
    height: 100dvh;
    max-height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }
  body.opp-page .app-shell-content > main.opp-page-main {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }
  body.opp-page #oppBoard.opp-page-board {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    outline: none;
  }
  body.opp-page #oppBoard.opp-page-board.is-editing {
    outline: none;
  }
  body.opp-page #oppBoard.opp-page-board > .opp-page-toolbar {
    flex: 0 0 auto;
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
    background: #fff;
  }
  html.dark body.opp-page #oppBoard.opp-page-board > .opp-page-toolbar {
    background: #0f172a;
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  body.opp-page #oppBoard.opp-page-board > .opp-page-board-body {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0.75rem 0.85rem 0.85rem;
    background: rgba(250, 247, 237, 0.55);
  }
  html.dark body.opp-page #oppBoard.opp-page-board > .opp-page-board-body {
    background: rgba(2, 6, 23, 0.45);
  }
  body.opp-page #oppBoard.opp-page-board .opp-board {
    flex: 1 1 auto;
    min-height: 0;
    height: 100%;
    align-items: stretch;
    padding-bottom: 0.15rem;
  }
  body.opp-page #oppBoard.opp-page-board .opp-stage {
    flex: 1 1 16rem;
    width: auto;
    min-width: 15rem;
    max-width: none;
    max-height: none;
    height: auto;
    align-self: stretch;
  }
  body.opp-page #oppBoard.opp-page-board .opp-stage-cards {
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
  }
  body.opp-page #oppBoard.opp-page-board .opp-drop {
    min-height: 8rem;
  }
  body.opp-page.opp-fullscreen .app-shell-top {
    /* keep top bar; icons-only sidebar is enough for “fullscreen” board mode */
  }
  #oppFullscreenBtn .opp-fs-exit { display: none; }
  body.opp-page.opp-fullscreen #oppFullscreenBtn .opp-fs-enter { display: none; }
  body.opp-page.opp-fullscreen #oppFullscreenBtn .opp-fs-exit { display: inline; }
  #oppFullscreenBtn svg { width: 0.85rem; height: 0.85rem; display: inline-block; vertical-align: -0.1rem; margin-right: 0.35rem; }
  #oppBoardMsg.is-ok { color: #047857; }
  .opp-actions { display: inline-flex; align-items: center; gap: 0.35rem; }
  .opp-actions button { border: 0; background: transparent; padding: 0.15rem 0.35rem; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af; cursor: pointer; border-radius: 0.4rem; }
  .opp-actions .opp-rename { color: #0f2747; background: rgba(15, 39, 71, 0.06); }
  .opp-actions .opp-rename:hover { color: #111827; background: rgba(250, 204, 21, 0.28); }
  .opp-actions .opp-remove:hover { color: #be123c; background: rgba(244, 63, 94, 0.1); }
  html.dark .opp-actions .opp-rename { color: #f8fafc; background: rgba(255, 255, 255, 0.08); }
  #oppBoardMsg.hidden { display: none; }
  .opp-pipeline-select { height: 2.5rem; border-radius: 999px; border: 1px solid rgba(17, 24, 39, 0.12); background: #fff; padding: 0 0.85rem; font-size: 0.75rem; font-weight: 700; color: #111827; }
  html.dark .opp-pipeline-select { background: #0f172a; border-color: rgba(255, 255, 255, 0.12); color: #f8fafc; }
</style>
<section class="<%= _compact ? 'mb-8 md:mb-10 rounded-[2rem] border-2 border-brand-yellow/50 dark:border-brand-yellow/35 bg-white dark:bg-slate-900/90 shadow-lg shadow-brand-yellow/10 overflow-hidden opp-compact' : 'opp-page-board overflow-hidden' %>" id="oppBoard" data-pipeline-id="<%= _board.pipeline.id %>" data-first-stage-id="<%= _board.stages[0] ? _board.stages[0].id : '' %>" aria-label="Opportunities">
  <script type="application/json" id="oppBoardPipelinesJson"><%- JSON.stringify(_board.pipelines || []).replace(/</g, '\\u003c') %></script>
  <script type="application/json" id="oppBoardTemplatesJson"><%- JSON.stringify(_board.templates || []).replace(/</g, '\\u003c') %></script>
  <div class="opp-page-toolbar px-4 sm:px-5 md:px-6 pt-4 sm:pt-5 pb-3 md:pb-4 border-b border-brand-border/40 dark:border-white/10">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Opportunities</p>
        <% if (_compact) { %>
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight"><%= _board.pipeline.name %></h2>
        <p class="text-xs font-semibold text-brand-muted mt-2">Switch pipelines here. Drag cards between stages, or move a lead to another pipeline from the card.</p>
        <% } else { %>
        <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight"><%= _board.pipeline.name %></h1>
        <p class="text-xs font-semibold text-brand-muted mt-2">Drag cards between stages, or move a lead to another pipeline from the card.</p>
        <% } %>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <label class="sr-only" for="oppPipelineSelect">Pipeline</label>
        <select id="oppPipelineSelect" class="opp-pipeline-select" title="Switch pipeline">
          <% _board.pipelines.forEach(function (pipeline) { %>
          <option value="<%= pipeline.id %>" <%= pipeline.id === _board.pipeline.id ? 'selected' : '' %>><%= pipeline.name %></option>
          <% }); %>
        </select>
        <button type="button" id="oppNewPipeline" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">New pipeline</button>
        <button type="button" id="oppEditBoard" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Edit</button>
        <button type="button" id="oppDeletePipeline" class="btn-pill border border-rose-400/50 dark:border-rose-400/40 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-rose-700 dark:text-rose-300" title="Delete this opportunity pipeline" <%= (_board.pipelines || []).length <= 1 ? 'disabled' : '' %>>Delete pipeline</button>
        <button type="button" id="oppCancelEdit" hidden class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
        <% if (_compact) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Open full board</a>
        <button type="button" id="oppAddFromMenu" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } else { %>
        <button type="button" id="oppAddStage" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Add stage</button>
        <button type="button" id="oppFullscreenBtn" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white" title="Fullscreen — collapse menu to icons" aria-pressed="false">
          <span class="opp-fs-enter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>Fullscreen</span>
          <span class="opp-fs-exit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg>Exit</span>
        </button>
        <button type="button" id="oppAddCard" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } %>
      </div>
    </div>
    <p id="oppBoardMsg" class="hidden mt-3 text-sm font-semibold text-red-700" role="status"></p>
  </div>
  <div class="opp-page-board-body px-3 sm:px-4 md:px-5 py-3 md:py-4">
    <div class="opp-board" id="oppStageRow">
      <% _board.stages.forEach(function (stage, stageIdx) { %>
      <% var _isLastStage = stageIdx === _board.stages.length - 1; %>
      <section class="opp-stage" data-stage-id="<%= stage.id %>" data-hidden-count="<%= stage.hiddenCount || 0 %>">
        <div class="opp-stage-head">
          <div class="min-w-0 flex-1">
            <h3 class="opp-stage-title text-sm font-extrabold text-brand-dark dark:text-white truncate"><%= stage.name %></h3>
            <input type="text" class="opp-stage-name-input" maxlength="40" value="<%= stage.name %>" aria-label="Stage name" data-stage-id="<%= stage.id %>" />
            <p class="opp-stage-meta text-[11px] text-brand-muted mt-0.5"><% if (stage.valueLabel) { %><%= stage.valueLabel %><% } else { %><%= stage.count === 1 ? '1 opportunity' : stage.count + ' opportunities' %><% } %></p>
          </div>
          <div class="opp-stage-head-tools">
            <button type="button" class="opp-stage-call" data-opp-action="stage-call" title="Call everyone in this stage" aria-label="Call everyone in this stage" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></button>
            <button type="button" class="opp-stage-sms" data-opp-action="stage-sms" title="Text everyone in this stage" aria-label="Text everyone in this stage" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0z"/></svg></button>
            <span class="opp-stage-count"><%= stage.count %></span>
          </div>
        </div>        <div class="opp-actions mb-2">
          <button type="button" class="opp-remove" data-stage-id="<%= stage.id %>">Remove</button>
        </div>
        <div class="opp-stage-cards<%= stage.cards.length ? '' : ' is-empty' %>" data-stage-id="<%= stage.id %>">
          <% if (!stage.cards.length) { %><div class="opp-drop">Drop here</div><% } %>
          <% stage.cards.forEach(function (card) { %>
          <% var _cardPhone = String(card.phone || '').trim(); var _hasPhone = !!_cardPhone && _cardPhone !== 'N/A' && _cardPhone !== '—'; %>
          <article class="opp-card" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" data-value="<%= card.value %>" data-phone="<%= _hasPhone ? _cardPhone : '' %>">
            <div class="opp-card-head">
              <button type="button" class="opp-card-title" data-opp-action="profile" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="<%= card.title %>"><%= card.title %></button>
              <% if (card.city) { %>
              <span class="opp-card-pin" title="<%= card.city %>" aria-label="<%= card.city %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.25"/></svg>
              </span>
              <% } %>
              <button type="button" class="opp-card-remove" data-opp-action="remove" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Remove from opportunities" aria-label="Remove from opportunities"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M8 7l1 12h6l1-12"/><path d="M10 11v5M14 11v5"/></svg></button>
            </div>
            <% if (card.category) { %><p class="opp-card-category" title="<%= card.category %>"><%= card.category %></p><% } %>
            <% if (card.status) { %><p class="opp-card-status" title="<%= card.status %>"><%= card.status %></p><% } %>
            <% if (card.note) { %><p class="opp-card-note" title="<%= card.note %>"><%= card.note %></p><% } %>
            <% if (card.reviews) { %><p class="opp-card-reviews"><span aria-hidden="true">★</span> <%= card.reviews %></p><% } else if (card.city && !card.status) { %><p class="opp-card-status"><%= card.city %></p><% } %>
            <% if (card.valueLabel) { %><p class="opp-card-value"><%= card.valueLabel %></p><% } %>
            <div class="opp-card-tools">
              <button type="button" class="opp-card-call" data-opp-action="call" data-lead-key="<%= card.key %>" data-title="<%= card.title %>"<%= _hasPhone ? '' : ' disabled' %> title="<%= _hasPhone ? 'Call ' + _cardPhone + ' in the softphone' : 'No phone number on this lead' %>" aria-label="Call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></button>
              <button type="button" data-opp-action="sms" data-phone="<%= card.phone %>" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="SMS" aria-label="SMS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0z"/></svg></button>
              <button type="button" data-opp-action="email" data-email="<%= card.email %>" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></button>
              <button type="button" data-opp-action="schedule" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Schedule" aria-label="Schedule"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></button>
              <button type="button" data-opp-action="task" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Task" aria-label="Task"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8 12 3 3 5-6"/></svg></button>
              <button type="button" data-opp-action="tags" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" data-tags="<%= JSON.stringify(card.tagKeys || []) %>" title="Tags" aria-label="Tags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.25"/></svg></button>
              <button type="button" data-opp-action="move" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Move to another pipeline" aria-label="Move to another pipeline"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7h11M16 3l4 4-4 4"/><path d="M16 17H5M8 21l-4-4 4-4"/></svg></button>
              <button type="button" data-opp-action="ghl" data-lead-key="<%= card.key %>" title="Sync GHL" aria-label="Sync GHL"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M21 21v-5h-5"/></svg></button>
              <button type="button" data-opp-action="advance" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Move to next stage" aria-label="Move to next stage"<%= _isLastStage ? ' hidden' : '' %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></button>
            </div>
          </article>
          <% }); %>
        </div>
        <div class="opp-stage-resize" role="separator" aria-orientation="vertical" aria-label="Resize column" title="Drag to resize column"></div>
        <% if (!_compact && stage.hiddenCount) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="inline-block mt-2 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">+ <%= stage.hiddenCount %> more</a>
        <% } %>
      </section>
      <% }); %>
    </div>
  </div>
</section>
<script src="/js/opportunity-card-actions.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
<script>
  if (typeof window.__adhelloBindOppCardActions === 'function') {
    window.__adhelloBindOppCardActions(document.getElementById('oppBoard'));
  }
</script>
<% } %>
