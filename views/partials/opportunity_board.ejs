<% const _board = typeof opportunityBoard !== 'undefined' && opportunityBoard ? opportunityBoard : null; %>
<% const _compact = typeof opportunityCompact !== 'undefined' && opportunityCompact; %>
<% if (_board && _board.pipeline) { %>
<style>
  .opp-board { display: flex; gap: 0.75rem; overflow-x: auto; align-items: stretch; padding-bottom: 0.15rem; }
  .opp-stage { flex: 1 1 0; min-width: 11.5rem; width: 0; display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(17, 24, 39, 0.08); border-radius: 1.15rem; padding: 0.85rem 0.8rem 0.7rem; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
  html.dark .opp-stage { background: rgba(15, 23, 42, 0.72); border-color: rgba(255, 255, 255, 0.08); }
  .opp-stage-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.65rem; }
  .opp-stage-count { display: inline-flex; align-items: center; justify-content: center; min-width: 1.35rem; height: 1.35rem; padding: 0 0.35rem; border-radius: 999px; background: rgba(250, 204, 21, 0.22); color: #111827; font-size: 0.6875rem; font-weight: 800; }
  html.dark .opp-stage-count { color: #f8fafc; }
  .opp-stage-cards { display: flex; flex-direction: column; gap: 0.45rem; min-height: 7.25rem; min-width: 0; flex: 1; border-radius: 0.85rem; background: rgba(250, 247, 237, 0.72); padding: 0.4rem; }
  html.dark .opp-stage-cards { background: rgba(2, 6, 23, 0.35); }
  .opp-drop { flex: 1 1 auto; min-height: 6.5rem; display: flex; align-items: center; justify-content: center; border: 1px dashed rgba(17, 24, 39, 0.14); border-radius: 0.7rem; color: #9ca3af; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; }
  html.dark .opp-drop { border-color: rgba(255, 255, 255, 0.14); }
  .opp-card { position: relative; width: 100%; min-width: 0; box-sizing: border-box; background: #fff; border: 1px solid rgba(17, 24, 39, 0.08); border-radius: 0.8rem; padding: 0.7rem 0.75rem; cursor: grab; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
  html.dark .opp-card { background: #0f172a; border-color: rgba(255, 255, 255, 0.1); }
  .opp-card.sortable-ghost { opacity: 0.45; }
  .opp-card-head { display: flex; align-items: flex-start; gap: 0.35rem; }
  .opp-card-title { display: block; width: 100%; min-width: 0; border: 0; background: transparent; padding: 0; text-align: left; font-weight: 800; font-size: 0.875rem; line-height: 1.3; color: inherit; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
  .opp-card-title:hover { color: var(--brand-yellow, #ca8a04); }
  .opp-card-pin { flex: none; color: #94a3b8; margin-top: 0.1rem; }
  .opp-card-pin svg { width: 0.85rem; height: 0.85rem; display: block; }
  .opp-card-category { margin: 0.2rem 0 0; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #94a3b8; }
  .opp-card-status { margin: 0.28rem 0 0; font-size: 0.72rem; font-weight: 600; color: #64748b; }
  .opp-card-note {
    margin: 0.2rem 0 0;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.25;
    color: #64748b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  html.dark .opp-card-note { color: #94a3b8; }
  .opp-card-reviews { margin: 0.22rem 0 0; font-size: 0.68rem; font-weight: 600; color: #64748b; }
  .opp-card-reviews span { color: #d97706; }
  .opp-card-value { margin: 0.2rem 0 0; font-size: 0.75rem; font-weight: 800; color: #111827; }
  html.dark .opp-card-value { color: #f8fafc; }
  .opp-card-tools { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.1rem; margin-top: 0.55rem; padding-top: 0.45rem; border-top: 1px solid rgba(17, 24, 39, 0.06); }
  html.dark .opp-card-tools { border-top-color: rgba(255, 255, 255, 0.08); }
  .opp-card-tools a, .opp-card-tools button { display: inline-flex; align-items: center; justify-content: center; width: 1.45rem; height: 1.45rem; border: 0; background: transparent; color: #64748b; border-radius: 0.35rem; padding: 0; cursor: pointer; text-decoration: none; }
  .opp-card-tools a:hover, .opp-card-tools button:hover { color: #a16207; background: rgba(250, 204, 21, 0.22); }
  .opp-card-tools svg { width: 0.95rem; height: 0.95rem; display: block; }
  .opp-card-tools button.is-syncing svg { animation: opp-sync-spin 0.7s linear infinite; }
  .opp-card-tools button[data-opp-action="remove"] { margin-left: auto; }
  .opp-card-tools button[data-opp-action="remove"]:hover { color: #e11d48; background: rgba(244, 63, 94, 0.12); }
  @keyframes opp-sync-spin { to { transform: rotate(360deg); } }
  .opp-pop {
    position: fixed;
    z-index: 240;
    width: min(18rem, calc(100vw - 1.5rem));
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #111827;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 1rem;
    box-shadow: 0 18px 44px rgba(15, 23, 42, 0.28);
    padding: 0.85rem;
    opacity: 1 !important;
    isolation: isolate;
  }
  html.dark .opp-pop {
    background: #0f172a;
    background-color: #0f172a;
    border-color: rgba(255, 255, 255, 0.14);
    color: #f8fafc;
  }
  .opp-pop h4 { margin: 0 0 0.55rem; font-size: 0.8rem; font-weight: 800; }
  .opp-pop-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; max-height: 11rem; overflow: auto; }
  .opp-pop-tag, .opp-pop-add { border: 1px solid rgba(17, 24, 39, 0.12); background: #fff; border-radius: 999px; padding: 0.28rem 0.6rem; font-size: 0.68rem; font-weight: 700; cursor: pointer; }
  html.dark .opp-pop-tag, html.dark .opp-pop-add { background: #1e293b; border-color: rgba(255, 255, 255, 0.14); color: #f8fafc; }
  .opp-pop-tag.is-on { background: rgba(250, 204, 21, 0.35); border-color: rgba(202, 138, 4, 0.45); }
  .opp-pop-row { display: flex; gap: 0.35rem; margin-top: 0.55rem; }
  .opp-pop-row input, .opp-pop-time { flex: 1; min-width: 0; border: 1px solid rgba(17, 24, 39, 0.12); border-radius: 0.7rem; padding: 0.4rem 0.55rem; font-size: 0.75rem; background: #fff; }
  html.dark .opp-pop-row input, html.dark .opp-pop-time { background: #1e293b; border-color: rgba(255, 255, 255, 0.14); color: #f8fafc; }
  .opp-cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.15rem; }
  .opp-cal button, .opp-cal span { height: 1.7rem; border: 0; background: transparent; border-radius: 0.4rem; font-size: 0.68rem; font-weight: 700; color: inherit; }
  .opp-cal button { cursor: pointer; }
  .opp-cal button:hover { background: rgba(17, 24, 39, 0.06); }
  html.dark .opp-cal button:hover { background: rgba(255, 255, 255, 0.08); }
  .opp-cal button.is-today { box-shadow: inset 0 0 0 1px rgba(17, 24, 39, 0.25); }
  .opp-cal button.is-selected { background: #FFDB3A; color: #111827; }
  .opp-cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; font-size: 0.75rem; font-weight: 800; }
  .opp-cal-nav button { border: 0; background: transparent; font-weight: 800; cursor: pointer; padding: 0.15rem 0.4rem; color: inherit; }
  #oppBoardMsg.is-ok { color: #047857; }
  .opp-actions { display: inline-flex; align-items: center; gap: 0.15rem; }
  .opp-actions button { border: 0; background: transparent; padding: 0.1rem 0.3rem; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af; cursor: pointer; }
  .opp-actions .opp-rename:hover { color: #111827; }
  .opp-actions .opp-remove:hover { color: #be123c; }
  #oppBoardMsg.hidden { display: none; }
  .opp-pipeline-select { height: 2.5rem; border-radius: 999px; border: 1px solid rgba(17, 24, 39, 0.12); background: #fff; padding: 0 0.85rem; font-size: 0.75rem; font-weight: 700; color: #111827; }
  html.dark .opp-pipeline-select { background: #0f172a; border-color: rgba(255, 255, 255, 0.12); color: #f8fafc; }
</style>
<section class="mb-8 md:mb-10 rounded-[2rem] border-2 border-brand-yellow/50 dark:border-brand-yellow/35 bg-white dark:bg-slate-900/90 shadow-lg shadow-brand-yellow/10 overflow-hidden <%= _compact ? 'opp-compact' : '' %>" id="oppBoard" data-pipeline-id="<%= _board.pipeline.id %>" data-first-stage-id="<%= _board.stages[0] ? _board.stages[0].id : '' %>" aria-label="Opportunities">
  <div class="px-5 sm:px-6 md:px-8 pt-5 sm:pt-6 pb-4 md:pb-5 border-b border-brand-border/40 dark:border-white/10">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Opportunities</p>
        <% if (_compact) { %>
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight"><%= _board.pipeline.name %></h2>
        <p class="text-xs font-semibold text-brand-muted mt-2">Drag a card between stages. The full board is where you edit stages and pipelines.</p>
        <% } else { %>
        <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight">Opportunities</h1>
        <p class="text-xs font-semibold text-brand-muted mt-2">Same board as Today. Drag cards between stages, or change the stages themselves.</p>
        <% } %>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <% if (_board.pipelines.length > 1 || !_compact) { %>
        <label class="sr-only" for="oppPipelineSelect">Pipeline</label>
        <select id="oppPipelineSelect" class="opp-pipeline-select">
          <% _board.pipelines.forEach(function (pipeline) { %>
          <option value="<%= pipeline.id %>" <%= pipeline.id === _board.pipeline.id ? 'selected' : '' %>><%= pipeline.name %></option>
          <% }); %>
        </select>
        <% } %>
        <% if (_compact) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Open opportunities</a>
        <button type="button" id="oppAddFromMenu" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } else { %>
        <button type="button" id="oppNewPipeline" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">New pipeline</button>
        <button type="button" id="oppRenamePipeline" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Rename</button>
        <button type="button" id="oppAddStage" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Add stage</button>
        <button type="button" id="oppAddCard" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } %>
      </div>
    </div>
    <p id="oppBoardMsg" class="hidden mt-3 text-sm font-semibold text-red-700" role="status"></p>
  </div>
  <div class="px-4 sm:px-5 md:px-6 py-4 md:py-5 bg-brand-cream/40 dark:bg-slate-950/30">
    <div class="opp-board" id="oppStageRow">
      <% _board.stages.forEach(function (stage) { %>
      <section class="opp-stage" data-stage-id="<%= stage.id %>">
        <div class="opp-stage-head">
          <div class="min-w-0">
            <h3 class="text-sm font-extrabold text-brand-dark dark:text-white truncate"><%= stage.name %></h3>
            <p class="opp-stage-meta text-[11px] text-brand-muted mt-0.5"><% if (stage.valueLabel) { %><%= stage.valueLabel %><% } else { %><%= stage.count === 1 ? '1 opportunity' : stage.count + ' opportunities' %><% } %></p>
          </div>
          <span class="opp-stage-count"><%= stage.count %></span>
        </div>
        <% if (!_compact) { %>
        <div class="opp-actions mb-2">
          <button type="button" class="opp-rename" data-stage-id="<%= stage.id %>" data-stage-name="<%= stage.name %>">Edit</button>
          <button type="button" class="opp-remove" data-stage-id="<%= stage.id %>">Remove</button>
        </div>
        <% } %>
        <div class="opp-stage-cards<%= stage.cards.length ? '' : ' is-empty' %>" data-stage-id="<%= stage.id %>">
          <% if (!stage.cards.length) { %><div class="opp-drop">Drop here</div><% } %>
          <% stage.cards.forEach(function (card) { %>
          <article class="opp-card" data-lead-key="<%= card.key %>" data-value="<%= card.value %>">
            <div class="opp-card-head">
              <button type="button" class="opp-card-title" data-opp-action="profile" data-lead-key="<%= card.key %>" title="<%= card.title %>"><%= card.title %></button>
              <% if (card.city) { %>
              <span class="opp-card-pin" title="<%= card.city %>" aria-label="<%= card.city %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.25"/></svg>
              </span>
              <% } %>
            </div>
            <% if (card.category) { %><p class="opp-card-category"><%= card.category %></p><% } %>
            <% if (card.status) { %><p class="opp-card-status"><%= card.status %></p><% } %>
            <% if (card.note) { %><p class="opp-card-note"><%= card.note %></p><% } %>
            <% if (card.reviews) { %><p class="opp-card-reviews"><span aria-hidden="true">★</span> <%= card.reviews %></p><% } else if (card.city && !card.status) { %><p class="opp-card-status"><%= card.city %></p><% } %>
            <% if (card.valueLabel) { %><p class="opp-card-value"><%= card.valueLabel %></p><% } %>
            <div class="opp-card-tools">
              <button type="button" data-opp-action="sms" data-phone="<%= card.phone %>" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="SMS" aria-label="SMS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0z"/></svg></button>
              <button type="button" data-opp-action="email" data-email="<%= card.email %>" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></button>
              <button type="button" data-opp-action="schedule" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Schedule" aria-label="Schedule"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></button>
              <button type="button" data-opp-action="task" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Task" aria-label="Task"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8 12 3 3 5-6"/></svg></button>
              <button type="button" data-opp-action="tags" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" data-tags="<%= JSON.stringify(card.tagKeys || []) %>" title="Tags" aria-label="Tags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.25"/></svg></button>
              <button type="button" data-opp-action="ghl" data-lead-key="<%= card.key %>" title="Sync GHL" aria-label="Sync GHL"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M21 21v-5h-5"/></svg></button>
              <button type="button" data-opp-action="remove" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Remove from opportunities" aria-label="Remove from opportunities"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M8 7l1 12h6l1-12"/><path d="M10 11v5M14 11v5"/></svg></button>
            </div>
          </article>
          <% }); %>
        </div>
        <% if (stage.hiddenCount) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="inline-block mt-2 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">+ <%= stage.hiddenCount %> more</a>
        <% } %>
      </section>
      <% }); %>
    </div>
  </div>
</section>
<script>
(function () {
  var board = document.getElementById('oppBoard');
  if (!board || board.getAttribute('data-opp-icons') === '1') return;
  board.setAttribute('data-opp-icons', '1');
  var press = null;
  var pop = null;

  function status(text, ok) {
    var msg = document.getElementById('oppBoardMsg');
    if (!msg) return;
    msg.textContent = text;
    msg.classList.toggle('is-ok', !!ok);
    msg.classList.remove('hidden');
  }

  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body || {})
    }).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, data: data }; });
    });
  }

  function closePop() {
    if (pop && pop.parentNode) pop.parentNode.removeChild(pop);
    pop = null;
  }

  function placePop(anchor) {
    var rect = anchor.getBoundingClientRect();
    var width = pop.offsetWidth || 280;
    var left = Math.min(rect.left, window.innerWidth - width - 12);
    if (left < 8) left = 8;
    var top = rect.bottom + 8;
    if (top + pop.offsetHeight > window.innerHeight - 8) top = Math.max(8, rect.top - pop.offsetHeight - 8);
    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
  }

  function openPop(anchor) {
    closePop();
    pop = document.createElement('div');
    pop.className = 'opp-pop';
    pop.setAttribute('role', 'dialog');
    // Inline + !important so the panel stays opaque over the board (global CSS was washing it out).
    var dark = document.documentElement.classList.contains('dark');
    pop.style.setProperty('background', dark ? '#0f172a' : '#ffffff', 'important');
    pop.style.setProperty('background-color', dark ? '#0f172a' : '#ffffff', 'important');
    pop.style.setProperty('color', dark ? '#f8fafc' : '#111827', 'important');
    pop.style.setProperty('opacity', '1', 'important');
    pop.style.setProperty('z-index', '240', 'important');
    pop.style.setProperty('box-shadow', '0 18px 44px rgba(15, 23, 42, 0.28)', 'important');
    document.body.appendChild(pop);
    return pop;
  }

  function leadKey(action) {
    return action.getAttribute('data-lead-key') || '';
  }

  function leadTitle(action) {
    return action.getAttribute('data-title') || 'this opportunity';
  }

  function openComposer(kind, action) {
    var key = leadKey(action);
    if (!key) return;
    var opener = kind === 'email'
      ? (window.__openBulkEmailModal || window.__openBulkEmailModalImplFull)
      : (window.__openBulkSmsModalImpl || window.__openBulkSmsModal || window.__openBulkSmsModalImplFull);
    if (typeof opener !== 'function') {
      status(kind === 'email' ? 'Email templates are still loading. Try again.' : 'SMS templates are still loading. Try again.', false);
      return;
    }
    status(kind === 'email' ? 'Opening email templates…' : 'Opening SMS templates…', true);
    Promise.resolve(opener([key])).then(function (result) {
      if (result && result.ok === false) status(result.message || 'Could not open that composer.', false);
    }).catch(function () {
      status('Could not open that composer.', false);
    });
  }

  function openTags(action) {
    var key = leadKey(action);
    if (!key) return;
    var applied = [];
    try { applied = JSON.parse(action.getAttribute('data-tags') || '[]'); } catch (e) { applied = []; }
    if (!Array.isArray(applied)) applied = [];
    var box = openPop(action);
    box.innerHTML = '<h4>Add a tag</h4><div class="opp-pop-tags">Loading tags…</div><form class="opp-pop-row"><input type="text" name="name" placeholder="New tag" maxlength="40" /><button type="submit" class="opp-pop-add">Add</button></form>';
    placePop(action);
    var list = box.querySelector('.opp-pop-tags');
    function paint(tags) {
      list.textContent = '';
      if (!tags.length) {
        list.textContent = 'No tags yet. Create one below.';
        return;
      }
      tags.forEach(function (tag) {
        if (!tag || !tag.key) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'opp-pop-tag' + (applied.indexOf(tag.key) >= 0 ? ' is-on' : '');
        btn.textContent = (applied.indexOf(tag.key) >= 0 ? '' : '+ ') + (tag.name || 'Tag');
        btn.addEventListener('click', function () {
          var on = applied.indexOf(tag.key) >= 0;
          btn.disabled = true;
          post('/tags/assign', { leadKey: key, tagKeys: [tag.key], mode: on ? 'remove' : 'add' }).then(function (result) {
            btn.disabled = false;
            if (!result.ok || !result.data || !result.data.success) {
              status((result.data && result.data.error) || 'Could not update that tag.', false);
              return;
            }
            if (on) applied = applied.filter(function (item) { return item !== tag.key; });
            else applied.push(tag.key);
            action.setAttribute('data-tags', JSON.stringify(applied));
            status(on ? 'Tag removed.' : 'Tag added.', true);
            paint(tags);
          }).catch(function () {
            btn.disabled = false;
            status('Could not update that tag.', false);
          });
        });
        list.appendChild(btn);
      });
    }
    fetch('/tags', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (res) { return res.json(); })
      .then(function (data) { paint((data && data.tags) || []); })
      .catch(function () { list.textContent = 'Could not load tags.'; });
    box.querySelector('form').addEventListener('submit', function (ev) {
      ev.preventDefault();
      var input = box.querySelector('input');
      var name = String(input.value || '').trim();
      if (!name) return;
      input.disabled = true;
      post('/tags', { name: name }).then(function (created) {
        if (!created.ok || !created.data || !created.data.tag) {
          input.disabled = false;
          status((created.data && created.data.error) || 'Could not create that tag.', false);
          return;
        }
        return post('/tags/assign', { leadKey: key, tagKeys: [created.data.tag.key], mode: 'add' }).then(function (assigned) {
          input.disabled = false;
          input.value = '';
          if (!assigned.ok || !assigned.data || !assigned.data.success) {
            status((assigned.data && assigned.data.error) || 'Tag created, but it was not added.', false);
            return;
          }
          applied.push(created.data.tag.key);
          action.setAttribute('data-tags', JSON.stringify(applied));
          status('Tag added.', true);
          return fetch('/tags', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (data) { paint((data && data.tags) || []); });
        });
      }).catch(function () {
        input.disabled = false;
        status('Could not create that tag.', false);
      });
    });
  }

  function openCalendar(action) {
    var key = leadKey(action);
    var title = leadTitle(action);
    var box = openPop(action);
    var view = new Date();
    view.setDate(1);
    var selected = '';
    box.innerHTML = '<h4>Schedule follow-up</h4><div class="opp-cal-nav"><button type="button" data-cal="prev" aria-label="Previous month">‹</button><span data-cal="label"></span><button type="button" data-cal="next" aria-label="Next month">›</button></div><div class="opp-cal" data-cal="grid"></div><div class="opp-pop-row"><select class="opp-pop-time" data-cal="time"></select><button type="button" class="opp-pop-add" data-cal="save">Save</button></div>';
    var time = box.querySelector('[data-cal="time"]');
    for (var hour = 8; hour <= 18; hour++) {
      var opt = document.createElement('option');
      opt.value = String(hour);
      opt.textContent = (hour > 12 ? hour - 12 : hour) + ':00 ' + (hour >= 12 ? 'PM' : 'AM');
      if (hour === 15) opt.selected = true;
      time.appendChild(opt);
    }
    function render() {
      var label = box.querySelector('[data-cal="label"]');
      var grid = box.querySelector('[data-cal="grid"]');
      label.textContent = view.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
      grid.textContent = '';
      ['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(function (day) {
        var span = document.createElement('span');
        span.textContent = day;
        grid.appendChild(span);
      });
      var first = new Date(view.getFullYear(), view.getMonth(), 1);
      for (var i = 0; i < first.getDay(); i++) grid.appendChild(document.createElement('span'));
      var days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      var today = new Date();
      for (var day = 1; day <= days; day++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(day);
        var iso = view.getFullYear() + '-' + String(view.getMonth() + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        btn.setAttribute('data-day', iso);
        if (today.getFullYear() === view.getFullYear() && today.getMonth() === view.getMonth() && today.getDate() === day) btn.classList.add('is-today');
        if (selected === iso) btn.classList.add('is-selected');
        grid.appendChild(btn);
      }
    }
    box.addEventListener('click', function (ev) {
      var prev = ev.target.closest('[data-cal="prev"]');
      var next = ev.target.closest('[data-cal="next"]');
      var day = ev.target.closest('[data-day]');
      var save = ev.target.closest('[data-cal="save"]');
      if (prev || next) {
        view.setMonth(view.getMonth() + (next ? 1 : -1));
        render();
        return;
      }
      if (day) {
        selected = day.getAttribute('data-day');
        render();
        return;
      }
      if (!save) return;
      if (!selected) {
        status('Pick a day first.', false);
        return;
      }
      var when = new Date(selected + 'T' + String(time.value).padStart(2, '0') + ':00:00');
      if (Number.isNaN(when.getTime())) {
        status('Pick a valid day.', false);
        return;
      }
      save.disabled = true;
      post('/tasks/api', {
        title: 'Follow up with ' + title,
        leadKey: key,
        scheduledAt: when.toISOString(),
        remindMinutesBefore: 15
      }).then(function (result) {
        save.disabled = false;
        if (!result.ok || !result.data || !result.data.success) {
          status((result.data && result.data.error) || 'Could not schedule that.', false);
          return;
        }
        closePop();
        status('Scheduled.', true);
      }).catch(function () {
        save.disabled = false;
        status('Could not schedule that.', false);
      });
    });
    render();
    placePop(action);
  }

  function syncGhl(action) {
    var key = leadKey(action);
    if (!key || action.classList.contains('is-syncing')) return;
    action.classList.add('is-syncing');
    action.setAttribute('aria-label', 'Sync in progress');
    status('Sync in progress…', true);
    post('/ghl/push', { leadKeys: [key] }).then(function (result) {
      action.classList.remove('is-syncing');
      action.setAttribute('aria-label', 'Sync GHL');
      if (!result.ok || !result.data || !result.data.success) {
        status((result.data && result.data.error) || 'Could not sync that opportunity.', false);
        return;
      }
      status('Synced to Go High Level.', true);
    }).catch(function () {
      action.classList.remove('is-syncing');
      action.setAttribute('aria-label', 'Sync GHL');
      status('Could not sync that opportunity.', false);
    });
  }

  function run(action) {
    var kind = action.getAttribute('data-opp-action');
    if (kind === 'profile') {
      closePop();
      var profileKey = leadKey(action);
      if (profileKey && typeof window.openLeadDetailFromKey === 'function') window.openLeadDetailFromKey(profileKey);
      else status('Could not open that company.', false);
      return;
    }
    if (kind === 'sms' || kind === 'email') {
      closePop();
      openComposer(kind, action);
      return;
    }
    if (kind === 'schedule') {
      openCalendar(action);
      return;
    }
    if (kind === 'task') {
      closePop();
      var taskKey = leadKey(action);
      window.location.href = '/tasks' + (taskKey ? '?leadKey=' + encodeURIComponent(taskKey) : '');
      return;
    }
    if (kind === 'tags') {
      openTags(action);
      return;
    }
    if (kind === 'ghl') syncGhl(action);
    if (kind === 'remove') removeOpportunity(action);
  }

  function refreshStage(column) {
    if (!column) return;
    var list = column.querySelector('.opp-stage-cards');
    var cards = list ? list.querySelectorAll('.opp-card') : [];
    var count = cards.length;
    var badge = column.querySelector('.opp-stage-count');
    if (badge) badge.textContent = String(count);
    var meta = column.querySelector('.opp-stage-meta');
    if (meta) {
      var total = 0;
      Array.prototype.forEach.call(cards, function (item) {
        total += Number(item.getAttribute('data-value')) || 0;
      });
      if (total > 0) meta.textContent = total.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
      else meta.textContent = count === 1 ? '1 opportunity' : count + ' opportunities';
    }
    if (!list) return;
    var drop = list.querySelector('.opp-drop');
    if (!count && !drop) {
      list.classList.add('is-empty');
      drop = document.createElement('div');
      drop.className = 'opp-drop';
      drop.textContent = 'Drop here';
      list.appendChild(drop);
    }
    if (count && drop) drop.remove();
    list.classList.toggle('is-empty', !count);
  }

  function removeOpportunity(action) {
    var key = leadKey(action);
    var card = action.closest('.opp-card');
    if (!key || !card || action.disabled) return;
    var name = leadTitle(action);
    if (!window.confirm('Remove ' + name + ' from opportunities? The lead stays in your list.')) return;
    action.disabled = true;
    status('Removing…', true);
    post('/opportunities/remove', { leadKey: key }).then(function (result) {
      action.disabled = false;
      if (!result.ok || !result.data || !result.data.success) {
        status((result.data && result.data.error) || 'Could not remove that opportunity.', false);
        return;
      }
      var column = card.closest('.opp-stage');
      card.remove();
      refreshStage(column);
      status('Removed from opportunities.', true);
    }).catch(function () {
      action.disabled = false;
      status('Could not remove that opportunity.', false);
    });
  }

  board.addEventListener('pointerdown', function (ev) {
    var action = ev.target.closest('[data-opp-action]');
    press = action ? { x: ev.clientX, y: ev.clientY, action: action } : null;
  }, true);

  board.addEventListener('pointerup', function (ev) {
    var action = ev.target.closest('[data-opp-action]');
    if (!action || !press || press.action !== action) return;
    var moved = Math.abs(ev.clientX - press.x) > 6 || Math.abs(ev.clientY - press.y) > 6;
    press = null;
    if (moved) return;
    ev.preventDefault();
    ev.stopPropagation();
    run(action);
  }, true);

  document.addEventListener('pointerdown', function (ev) {
    if (!pop) return;
    if (pop.contains(ev.target) || ev.target.closest('[data-opp-action]')) return;
    closePop();
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') closePop();
  });
})();
</script>
<% } %>
