<% const _board = typeof opportunityBoard !== 'undefined' && opportunityBoard ? opportunityBoard : null; %>
<% const _compact = typeof opportunityCompact !== 'undefined' && opportunityCompact; %>
<% if (_board && _board.pipeline) { %>
<style>
  .opp-board { display: flex; gap: 0.75rem; overflow-x: auto; align-items: stretch; padding-bottom: 0.15rem; }
  .opp-stage { flex: 1 1 0; min-width: 11.5rem; width: 0; display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(17, 24, 39, 0.08); border-radius: 1.15rem; padding: 0.85rem 0.8rem 0.7rem; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
  html.dark .opp-stage { background: rgba(15, 23, 42, 0.72); border-color: rgba(255, 255, 255, 0.08); }
  .opp-stage-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.65rem; }
  .opp-stage-count { display: inline-flex; align-items: center; justify-content: center; min-width: 1.35rem; height: 1.35rem; padding: 0 0.35rem; border-radius: 999px; background: rgba(250, 204, 21, 0.22); color: #111827; font-size: 0.6875rem; font-weight: 800; }
  html.dark .opp-stage-count { color: #f8fafc; }
  .opp-stage-cards { display: flex; flex-direction: column; gap: 0.45rem; min-height: 7.25rem; min-width: 0; flex: 1; border-radius: 0.85rem; background: rgba(250, 247, 237, 0.72); padding: 0.4rem; }
  html.dark .opp-stage-cards { background: rgba(2, 6, 23, 0.35); }
  .opp-drop { flex: 1 1 auto; min-height: 6.5rem; display: flex; align-items: center; justify-content: center; border: 1px dashed rgba(17, 24, 39, 0.14); border-radius: 0.7rem; color: #9ca3af; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; }
  html.dark .opp-drop { border-color: rgba(255, 255, 255, 0.14); }
  .opp-card { width: 100%; min-width: 0; box-sizing: border-box; background: #fff; border: 1px solid rgba(17, 24, 39, 0.08); border-radius: 0.8rem; padding: 0.7rem 0.75rem; cursor: grab; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
  html.dark .opp-card { background: #0f172a; border-color: rgba(255, 255, 255, 0.1); }
  .opp-card.sortable-ghost { opacity: 0.45; }
  .opp-card-title { display: block; font-weight: 800; font-size: 0.875rem; line-height: 1.3; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .opp-card-title:hover { color: var(--brand-yellow, #ca8a04); }
  .opp-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.45rem; }
  .opp-card-source { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280; }
  .opp-card-value { font-size: 0.75rem; font-weight: 800; color: #111827; }
  html.dark .opp-card-value { color: #f8fafc; }
  .opp-card-tools { display: flex; align-items: center; gap: 0.1rem; margin-top: 0.55rem; padding-top: 0.45rem; border-top: 1px solid rgba(17, 24, 39, 0.06); }
  html.dark .opp-card-tools { border-top-color: rgba(255, 255, 255, 0.08); }
  .opp-card-tools a, .opp-card-tools button { display: inline-flex; align-items: center; justify-content: center; width: 1.45rem; height: 1.45rem; border: 0; background: transparent; color: #64748b; border-radius: 0.35rem; padding: 0; cursor: pointer; text-decoration: none; }
  .opp-card-tools a:hover, .opp-card-tools button:hover { color: #a16207; background: rgba(250, 204, 21, 0.22); }
  .opp-card-tools svg { width: 0.95rem; height: 0.95rem; display: block; }
  #oppBoardMsg.is-ok { color: #047857; }
  .opp-actions { display: inline-flex; align-items: center; gap: 0.15rem; }
  .opp-actions button { border: 0; background: transparent; padding: 0.1rem 0.3rem; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af; cursor: pointer; }
  .opp-actions .opp-rename:hover { color: #111827; }
  .opp-actions .opp-remove:hover { color: #be123c; }
  #oppBoardMsg.hidden { display: none; }
  .opp-pipeline-select { height: 2.5rem; border-radius: 999px; border: 1px solid rgba(17, 24, 39, 0.12); background: #fff; padding: 0 0.85rem; font-size: 0.75rem; font-weight: 700; color: #111827; }
  html.dark .opp-pipeline-select { background: #0f172a; border-color: rgba(255, 255, 255, 0.12); color: #f8fafc; }
</style>
<section class="mb-8 md:mb-10 rounded-[2rem] border-2 border-brand-yellow/50 dark:border-brand-yellow/35 bg-white dark:bg-slate-900/90 shadow-lg shadow-brand-yellow/10 overflow-hidden <%= _compact ? 'opp-compact' : '' %>" id="oppBoard" data-pipeline-id="<%= _board.pipeline.id %>" data-first-stage-id="<%= _board.stages[0] ? _board.stages[0].id : '' %>" aria-label="Opportunities">
  <div class="px-5 sm:px-6 md:px-8 pt-5 sm:pt-6 pb-4 md:pb-5 border-b border-brand-border/40 dark:border-white/10">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Opportunities</p>
        <% if (_compact) { %>
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight"><%= _board.pipeline.name %></h2>
        <p class="text-xs font-semibold text-brand-muted mt-2">Drag a card between stages. The full board is where you edit stages and pipelines.</p>
        <% } else { %>
        <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight">Opportunities</h1>
        <p class="text-xs font-semibold text-brand-muted mt-2">Same board as Today. Drag cards between stages, or change the stages themselves.</p>
        <% } %>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <% if (_board.pipelines.length > 1 || !_compact) { %>
        <label class="sr-only" for="oppPipelineSelect">Pipeline</label>
        <select id="oppPipelineSelect" class="opp-pipeline-select">
          <% _board.pipelines.forEach(function (pipeline) { %>
          <option value="<%= pipeline.id %>" <%= pipeline.id === _board.pipeline.id ? 'selected' : '' %>><%= pipeline.name %></option>
          <% }); %>
        </select>
        <% } %>
        <% if (_compact) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Open opportunities</a>
        <button type="button" id="oppAddFromMenu" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } else { %>
        <button type="button" id="oppNewPipeline" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">New pipeline</button>
        <button type="button" id="oppRenamePipeline" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Rename</button>
        <button type="button" id="oppAddStage" class="btn-pill border border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Add stage</button>
        <button type="button" id="oppAddCard" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Add opportunity</button>
        <% } %>
      </div>
    </div>
    <p id="oppBoardMsg" class="hidden mt-3 text-sm font-semibold text-red-700" role="status"></p>
  </div>
  <div class="px-4 sm:px-5 md:px-6 py-4 md:py-5 bg-brand-cream/40 dark:bg-slate-950/30">
    <div class="opp-board" id="oppStageRow">
      <% _board.stages.forEach(function (stage) { %>
      <section class="opp-stage" data-stage-id="<%= stage.id %>">
        <div class="opp-stage-head">
          <div class="min-w-0">
            <h3 class="text-sm font-extrabold text-brand-dark dark:text-white truncate"><%= stage.name %></h3>
            <p class="opp-stage-meta text-[11px] text-brand-muted mt-0.5"><% if (stage.valueLabel) { %><%= stage.valueLabel %><% } else { %><%= stage.count === 1 ? '1 opportunity' : stage.count + ' opportunities' %><% } %></p>
          </div>
          <span class="opp-stage-count"><%= stage.count %></span>
        </div>
        <% if (!_compact) { %>
        <div class="opp-actions mb-2">
          <button type="button" class="opp-rename" data-stage-id="<%= stage.id %>" data-stage-name="<%= stage.name %>">Edit</button>
          <button type="button" class="opp-remove" data-stage-id="<%= stage.id %>">Remove</button>
        </div>
        <% } %>
        <div class="opp-stage-cards<%= stage.cards.length ? '' : ' is-empty' %>" data-stage-id="<%= stage.id %>">
          <% if (!stage.cards.length) { %><div class="opp-drop">Drop here</div><% } %>
          <% stage.cards.forEach(function (card) { %>
          <article class="opp-card" data-lead-key="<%= card.key %>" data-value="<%= card.value %>">
            <a class="opp-card-title" href="<%= card.href %>"><%= card.title %></a>
            <% if (card.source || card.valueLabel) { %>
            <div class="opp-card-foot">
              <span class="opp-card-source"><%= card.source || 'Opportunity' %></span>
              <% if (card.valueLabel) { %><span class="opp-card-value"><%= card.valueLabel %></span><% } %>
            </div>
            <% } %>
            <div class="opp-card-tools">
              <button type="button" data-opp-action="call" data-phone="<%= card.phone %>" data-lead-key="<%= card.key %>" data-title="<%= card.title %>" title="Call" aria-label="Call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></button>
              <% if (card.emailHref) { %>
              <a href="<%= card.emailHref %>" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
              <% } else { %>
              <button type="button" data-opp-action="email" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></button>
              <% } %>
              <a href="<%= card.scheduleHref %>" title="Schedule" aria-label="Schedule"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></a>
              <a href="<%= card.taskHref %>" title="Task" aria-label="Task"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8 12 3 3 5-6"/></svg></a>
              <a href="<%= card.tagsHref %>" title="Tags" aria-label="Tags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.25"/></svg></a>
              <button type="button" data-opp-action="ghl" data-lead-key="<%= card.key %>" title="Sync GHL" aria-label="Sync GHL"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M21 21v-5h-5"/></svg></button>
            </div>
          </article>
          <% }); %>
        </div>
        <% if (stage.hiddenCount) { %>
        <a href="/opportunities?pipeline=<%= encodeURIComponent(_board.pipeline.id) %>" class="inline-block mt-2 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">+ <%= stage.hiddenCount %> more</a>
        <% } %>
      </section>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
