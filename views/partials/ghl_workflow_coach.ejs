<%#
  AI GHL workflow generator — brainstorm + copy-paste prompt output.
  Optional: senderOffers [{ key, label }]
%>
<% const _offers = (typeof senderOffers !== 'undefined' && Array.isArray(senderOffers)) ? senderOffers : []; %>
<div id="ghl-workflow-coach" class="ghl-workflow-coach-block rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-4 md:p-6 scroll-mt-28">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <div class="min-w-0">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">AI assistant</p>
      <h3 class="font-bold text-brand-dark dark:text-white text-sm md:text-base">GHL workflow generator</h3>
      <p class="text-xs text-brand-muted leading-relaxed mt-1">Brainstorm your <code class="text-[10px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">auto-outreach</code> automation — then copy the generated setup prompt into GHL or send it to whoever configures your sub-account.</p>
    </div>
    <button type="button" id="ghlCoachResetBtn" class="shrink-0 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:underline">New conversation</button>
  </div>

  <label class="block mb-4">
    <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Focus sender profile (optional)</span>
    <select id="ghlCoachSenderOfferKey" class="mt-1 w-full max-w-md rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm">
      <option value="">Any / multi-business (merge fields)</option>
      <% _offers.forEach(function (o) { if (!o || !o.key) return; %>
      <option value="<%= o.key %>"><%= o.label || o.key %></option>
      <% }); %>
    </select>
    <span class="text-[11px] text-brand-muted mt-1 block">Pick a client business to tailor the workflow — e.g. electrician, flooring, reviews app.</span>
  </label>

  <div class="flex flex-wrap gap-2 mb-4" id="ghlCoachStarters" aria-label="Quick prompts">
    <button type="button" class="ghl-coach-starter px-3 py-1.5 rounded-full text-[10px] font-bold border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800 text-brand-dark dark:text-slate-100 hover:border-brand-yellow/60 transition-colors" data-prompt="I run a local electrician business. Design a 3-touch auto-outreach sequence: day 0 email, day 3 SMS for mobile only, optional day 5 RVM. Use my GHL audit widget for the CTA.">Electrician 3-touch</button>
    <button type="button" class="ghl-coach-starter px-3 py-1.5 rounded-full text-[10px] font-bold border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800 text-brand-dark dark:text-slate-100 hover:border-brand-yellow/60 transition-colors" data-prompt="Create a universal merge-field workflow that works for all my business profiles — email + SMS with landline skip. Include IF branch examples for flooring vs reviews app vs consulting.">Multi-business universal</button>
    <button type="button" class="ghl-coach-starter px-3 py-1.5 rounded-full text-[10px] font-bold border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800 text-brand-dark dark:text-slate-100 hover:border-brand-yellow/60 transition-colors" data-prompt="Write the full copy-paste GHL setup prompt now. Friendly local tone, max 1 email + 1 SMS in 7 days, stop on reply.">Generate full prompt</button>
  </div>

  <div id="ghlCoachMessages" class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/50 px-3 py-3 space-y-3 text-sm min-h-[8rem] max-h-[min(36vh,16rem)] overflow-y-auto custom-scrollbar mb-3" role="log" aria-live="polite">
    <div class="mr-4 rounded-2xl rounded-tl-md border border-brand-border/40 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 px-3 py-2 text-brand-muted text-xs leading-relaxed">
      Tell me about the business you're reaching out as, your ideal prospect, and how aggressive you want the sequence. When you're ready, ask me to <strong class="text-brand-dark dark:text-white">write the full GHL prompt</strong>.
    </div>
  </div>

  <div id="ghlCoachPromptWrap" class="hidden mb-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Generated GHL setup prompt</p>
      <button type="button" id="ghlCoachPromptCopyBtn" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90">Copy prompt</button>
    </div>
    <textarea id="ghlCoachPromptOut" readonly rows="16" class="w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-3 text-[11px] md:text-xs font-mono leading-relaxed text-brand-dark dark:text-slate-100 resize-y min-h-[12rem] custom-scrollbar" aria-label="Generated GHL workflow prompt"></textarea>
    <p id="ghlCoachPromptCopyStatus" class="mt-2 text-[11px] text-emerald-700 dark:text-emerald-300 hidden" role="status"></p>
  </div>

  <div class="flex flex-col sm:flex-row gap-2">
    <textarea id="ghlCoachInput" rows="2" placeholder="e.g. My reviews app targets contractors — 2 emails and 1 SMS, casual founder tone…" class="flex-1 rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 text-brand-dark dark:text-slate-100 text-sm px-3 py-2 resize-none focus:ring-2 focus:ring-brand-yellow outline-none"></textarea>
    <button type="button" id="ghlCoachSendBtn" class="shrink-0 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-[10px] font-black uppercase tracking-widest hover:opacity-90 sm:self-end">Send</button>
  </div>
  <p id="ghlCoachError" class="hidden mt-2 text-xs text-red-600 dark:text-red-400" role="alert"></p>
</div>
<script>
(function () {
  var messagesEl = document.getElementById('ghlCoachMessages');
  var inputEl = document.getElementById('ghlCoachInput');
  var sendBtn = document.getElementById('ghlCoachSendBtn');
  var errEl = document.getElementById('ghlCoachError');
  var promptWrap = document.getElementById('ghlCoachPromptWrap');
  var promptOut = document.getElementById('ghlCoachPromptOut');
  var copyBtn = document.getElementById('ghlCoachPromptCopyBtn');
  var copyStatus = document.getElementById('ghlCoachPromptCopyStatus');
  var senderSelect = document.getElementById('ghlCoachSenderOfferKey');
  var history = [];

  if (!messagesEl || !inputEl || !sendBtn) return;

  function appendBubble(role, text) {
    var wrap = document.createElement('div');
    wrap.className = role === 'user'
      ? 'ml-8 rounded-2xl rounded-tr-md bg-brand-yellow/20 dark:bg-brand-yellow/10 px-3 py-2 text-brand-dark dark:text-slate-100 text-sm leading-relaxed'
      : 'mr-4 rounded-2xl rounded-tl-md border border-brand-border/40 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 px-3 py-2 text-brand-dark dark:text-slate-200 text-sm leading-relaxed whitespace-pre-wrap';
    wrap.textContent = text;
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function showPrompt(text) {
    if (!promptWrap || !promptOut) return;
    if (!text || !String(text).trim()) {
      promptWrap.classList.add('hidden');
      promptOut.value = '';
      return;
    }
    promptOut.value = String(text).trim();
    promptWrap.classList.remove('hidden');
    promptWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function resetConversation() {
    history = [];
    messagesEl.innerHTML = '';
    var welcome = document.createElement('div');
    welcome.className = 'mr-4 rounded-2xl rounded-tl-md border border-brand-border/40 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 px-3 py-2 text-brand-muted text-xs leading-relaxed';
    welcome.innerHTML = 'Tell me about the business you\'re reaching out as, your ideal prospect, and how aggressive you want the sequence. When you\'re ready, ask me to <strong class="text-brand-dark dark:text-white">write the full GHL prompt</strong>.';
    messagesEl.appendChild(welcome);
    showPrompt('');
    if (errEl) errEl.classList.add('hidden');
  }

  async function sendMessage(text) {
    var msg = String(text || '').trim();
    if (!msg) return;
    if (errEl) errEl.classList.add('hidden');
    appendBubble('user', msg);
    inputEl.value = '';
    sendBtn.disabled = true;
    sendBtn.textContent = '…';
    try {
      var res = await fetch('/workspace/ghl/workflow-coach', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          userMessage: msg,
          chatHistory: history,
          senderOfferKey: senderSelect ? senderSelect.value : '',
        }),
      });
      var data = await res.json();
      if (!data || !data.success) {
        if (errEl) {
          errEl.textContent = (data && data.error) || 'Request failed';
          errEl.classList.remove('hidden');
        }
        return;
      }
      appendBubble('assistant', data.reply || '');
      history.push({ role: 'user', content: msg });
      history.push({ role: 'assistant', content: data.reply || '' });
      if (data.workflowPrompt) showPrompt(data.workflowPrompt);
    } catch (e) {
      if (errEl) {
        errEl.textContent = 'Network error';
        errEl.classList.remove('hidden');
      }
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send';
      inputEl.focus();
    }
  }

  sendBtn.addEventListener('click', function () { sendMessage(inputEl.value); });
  inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage(inputEl.value);
    }
  });

  var resetBtn = document.getElementById('ghlCoachResetBtn');
  if (resetBtn) resetBtn.addEventListener('click', resetConversation);

  document.querySelectorAll('.ghl-coach-starter').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var p = btn.getAttribute('data-prompt') || '';
      if (p) sendMessage(p);
    });
  });

  if (copyBtn && promptOut) {
    copyBtn.addEventListener('click', function () {
      var text = promptOut.value || '';
      function done(ok) {
        if (!copyStatus) return;
        copyStatus.textContent = ok ? 'Copied to clipboard.' : 'Copy failed — select the text and copy manually.';
        copyStatus.classList.toggle('text-emerald-700', ok);
        copyStatus.classList.toggle('dark:text-emerald-300', ok);
        copyStatus.classList.toggle('text-amber-700', !ok);
        copyStatus.classList.toggle('dark:text-amber-300', !ok);
        copyStatus.classList.remove('hidden');
        setTimeout(function () { copyStatus.classList.add('hidden'); }, 3500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { done(true); }).catch(function () { done(false); });
      } else {
        promptOut.focus();
        promptOut.select();
        try { done(document.execCommand('copy')); } catch (e) { done(false); }
      }
    });
  }
})();
</script>
