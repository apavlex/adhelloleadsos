<%# Alex chat widget — floating button + panel on every app page (styled like /chat). locals.ceoChatFloatIncluded prevents duplicates. %>
<% if (typeof user !== 'undefined' && user) { %>
<% if (!locals.ceoChatFloatIncluded) { locals.ceoChatFloatIncluded = true; %>
<% const _pavlexWs = locals.workspace || null; const _pavlexWsName = (_pavlexWs && _pavlexWs.name) || ''; %>
<%
  const _acwIcons = {
    users: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
    today: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5',
    bookmark: 'M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z',
    task: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  };
  const _acwChips = [
    { icon: 'users', label: 'Find referral partners for my business', prompt: 'Find referral partners for my business' },
    { icon: 'today', label: 'What should I work on today?', prompt: 'What should I work on today?' },
    { icon: 'bookmark', label: 'Show my bookmarked leads', prompt: 'Show my bookmarked leads' },
    { icon: 'task', label: 'Create a task to call back … tomorrow', prefill: 'Create a task to call back  tomorrow', caret: 29 },
  ];
%>
<div id="ceoChatFloat" class="acw app-floating-layer app-body-portal flex flex-col items-end gap-3" data-workspace-id="<%= locals.workspaceId || (_pavlexWs && _pavlexWs.id) || '' %>">
  <div id="chatWindowBackdrop" class="acw-backdrop" hidden></div>
  <section id="chatWindow" class="acw-panel hidden" role="dialog" aria-label="Chat with Alex" aria-modal="false">
    <header class="acw-header">
      <span class="relative w-10 h-10 shrink-0" aria-hidden="true">
        <span class="acw-avatar block w-10 h-10 rounded-full overflow-hidden bg-white">
          <img src="/img/alex-avatar-96.jpg" alt="" class="w-full h-full rounded-full object-cover" width="40" height="40" decoding="async" />
        </span>
        <span class="acw-online-dot absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-400"></span>
      </span>
      <div class="min-w-0 flex-1">
        <h2 class="font-display font-extrabold text-[15px] leading-tight tracking-tight truncate text-brand-dark dark:text-white">Alex</h2>
        <p class="mt-0.5 text-[11px] font-semibold text-brand-muted dark:text-slate-400 flex items-center gap-1.5 min-w-0">
          <span class="shrink-0">Online</span>
          <% if (_pavlexWsName) { %><span class="shrink-0" aria-hidden="true">·</span><span class="truncate" title="Alex works in this workspace"><%= _pavlexWsName %></span><% } %>
        </p>
      </div>
      <button type="button" id="chatWindowClear" class="acw-icon-btn" aria-label="New chat (clears this chat)" title="New chat" hidden>
        <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
      </button>
      <a href="/chat" id="chatWindowFullLink" class="acw-full-link" title="Open full chat with saved history">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
        <span>Full chat</span>
      </a>
      <button type="button" id="chatWindowClose" class="acw-icon-btn" aria-label="Minimize chat" title="Minimize">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
      </button>
    </header>

    <div id="ceoChatMessagesFloat" class="acw-thread custom-scrollbar" aria-live="polite">
      <div id="ceoChatEmptyFloat" class="acw-empty ceo-chat-welcome">
        <div class="acw-empty-glow" aria-hidden="true"></div>
        <div class="relative">
          <span class="relative inline-block" aria-hidden="true">
            <span class="acw-hero-avatar block w-16 h-16 rounded-full overflow-hidden bg-white">
              <img src="/img/alex-avatar-96.jpg" alt="" class="w-full h-full rounded-full object-cover" width="64" height="64" loading="lazy" decoding="async" />
            </span>
            <span class="acw-online-dot absolute bottom-0.5 right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-400"></span>
          </span>
          <h3 class="font-display font-extrabold text-2xl tracking-tight mt-4 text-brand-dark dark:text-white">Hey, I'm Alex.</h3>
          <p class="text-[13.5px] text-brand-muted dark:text-slate-400 mt-1.5 leading-relaxed">Ask about your leads, pipeline, or tasks from any page<% if (_pavlexWsName) { %> in <strong class="font-semibold text-brand-dark dark:text-white"><%= _pavlexWsName %></strong><% } %>.</p>
          <p class="mt-5 mb-2 text-[10px] font-black uppercase tracking-widest text-brand-muted text-left">Try asking</p>
          <div class="flex flex-col gap-2 text-left">
            <% _acwChips.forEach(function (c) { %>
            <button type="button" class="acw-chip"<% if (c.prompt) { %> data-acw-prompt="<%= c.prompt %>"<% } else { %> data-acw-prefill="<%= c.prefill %>" data-acw-caret="<%= c.caret %>"<% } %>>
              <span class="acw-chip-icon" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= _acwIcons[c.icon] %>" /></svg>
              </span>
              <span class="min-w-0 flex-1"><%= c.label %></span>
            </button>
            <% }); %>
          </div>
        </div>
      </div>
      <div id="ceoChatListFloat" class="acw-list" hidden></div>
      <div id="ceoTypingFloat" class="acw-typing hidden" aria-label="Alex is typing">
        <span class="acw-avatar shrink-0 w-7 h-7 rounded-full overflow-hidden bg-white" aria-hidden="true"><img src="/img/alex-avatar-96.jpg" alt="" class="w-full h-full rounded-full object-cover" width="28" height="28" loading="lazy" decoding="async" /></span>
        <span class="acw-typing-pill">
          <span class="flex items-center gap-1" aria-hidden="true"><span class="acw-dot"></span><span class="acw-dot"></span><span class="acw-dot"></span></span>
          <span class="text-xs font-semibold">Working on it…</span>
        </span>
      </div>
    </div>

    <div class="acw-composer-wrap">
      <form id="ceoChatFormFloat" class="acw-composer" method="POST" action="/api/pavlex/chat" novalidate>
        <label for="ceoChatInputFloat" class="sr-only">Message Alex</label>
        <textarea id="ceoChatInputFloat" rows="1" maxlength="6000" enterkeyhint="send" autocomplete="off" placeholder="Message Alex…" class="acw-input"></textarea>
        <button type="button" id="ceoChatMicFloat" class="alex-voice-btn acw-mic" aria-label="Dictate a message" title="Dictate" hidden></button>
        <button type="submit" id="ceoChatSendFloat" class="btn-primary acw-send" aria-label="Send message" disabled>
          <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" /></svg>
        </button>
      </form>
    </div>
  </section>

  <button id="chatBubble" type="button" aria-label="Open chat with Alex" aria-expanded="false" aria-controls="chatWindow" class="acw-fab">
    <svg id="chatBubbleIcon" class="acw-fab-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
    </svg>
    <svg id="chatBubbleClose" class="acw-fab-icon acw-fab-icon--close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
    <span id="chatBubbleDot" class="acw-fab-dot hidden" aria-hidden="true"></span>
  </button>
</div>
<script src="/js/ceo-chat-float.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '4' %>" defer></script>
<% } %>
<% } %>
