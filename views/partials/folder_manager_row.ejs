<%#
  folder row — f, fc (lead count), indent (bool), compact (bool for system root header actions)
%>
<% const _f = typeof f !== 'undefined' ? f : {}; %>
<% const _fc = typeof fc !== 'undefined' ? fc : 0; %>
<% const _depth = typeof depth !== 'undefined' ? Number(depth) : (typeof indent !== 'undefined' && indent ? 1 : 0); %>
<% const _compact = typeof compact !== 'undefined' && compact; %>
<% const _padClass = _depth <= 0 ? '' : (_depth === 1 ? 'pl-2 sm:pl-3' : (_depth === 2 ? 'pl-2 sm:pl-4' : 'pl-2 sm:pl-5')); %>
<% const _inTree = typeof inTree !== 'undefined' && inTree; %>
<% const _folderTags = Array.isArray(typeof folderTags !== 'undefined' ? folderTags : null) ? folderTags : []; %>
<div class="folder-row flex flex-wrap items-center gap-4 px-4 sm:px-6 py-4 <%= _depth > 0 && !_inTree ? _padClass + ' bg-brand-cream/10 dark:bg-slate-950/20' : '' %>"
  data-folder-row="<%= _f.key %>"
  data-folder-name="<%= _f.name %>"
  data-folder-job-type="<%= _f.jobType || '' %>"
  data-folder-is-default="<%= _f.isPipelineDefault ? '1' : '0' %>"
  data-folder-is-trade="<%= _f.isTradeFolder ? '1' : '0' %>"
  data-folder-parent-key="<%= _f.parentFolderKey || '' %>"
  data-folder-search="<%= (_f.name + ' ' + (_f.jobType || '') + ' ' + (_f.tradeSlug || '')).toLowerCase() %>">
  <div class="min-w-0 flex-1">
    <p class="font-display font-bold <%= _compact ? 'text-base' : 'text-lg' %> text-brand-dark dark:text-white flex flex-wrap items-center gap-2">
      <% if (_depth > 0 && !_inTree) { %><span class="text-brand-muted/60" aria-hidden="true">↳</span><% } %>
      <a href="/prospecting?tab=pipeline&amp;folderKey=<%= encodeURIComponent(_f.key) %>" class="folder-open-link rounded-sm hover:text-brand-yellow dark:hover:text-brand-yellow transition-colors hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow/50" title="Open leads in <%= _f.name.replace(/"/g, '&quot;') %>"><%= _f.name %></a>
      <% if (_f.isPipelineDefault) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted border border-brand-border/50 rounded-full px-2 py-0.5">System</span><% } %>
      <% _folderTags.forEach(function (tag) {
        var _tColor = (tag && tag.color) ? String(tag.color) : '#94a3b8';
        var _tLabel = (tag && tag.name) ? String(tag.name) : '';
        if (!_tLabel) return;
      %><span class="lead-tag-chip inline-flex items-center px-1.5 py-0.5 rounded-md text-[8px] font-black uppercase tracking-wide border border-black/5 dark:border-white/10" style="background:<%= _tColor %>22;color:<%= _tColor %>" title="<%= _tLabel.replace(/"/g, '&quot;') %>"><%= _tLabel %></span><% }); %>
    </p>
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-1"><%= _fc %> lead<%= _fc === 1 ? '' : 's' %> in this folder</p>
  </div>
  <div class="flex flex-wrap items-center gap-2 shrink-0">
    <a href="/leads/find?folderKey=<%= encodeURIComponent(_f.key) %>" class="px-3 py-2 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark border border-brand-dark dark:border-brand-yellow text-[10px] font-black uppercase tracking-widest hover:brightness-110 transition-colors shadow-sm">Run search</a>
    <% if (_f.isPipelineDefault) { %>
    <button type="button" class="folder-search-setup px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" data-folder-key="<%= _f.key %>">Search setup</button>
    <% } %>
    <a href="/prospecting?tab=pipeline&amp;folderKey=<%= encodeURIComponent(_f.key) %>" class="px-3 py-2 rounded-xl bg-brand-yellow text-brand-dark border border-brand-yellow text-[10px] font-black uppercase tracking-widest hover:brightness-105 transition-colors shadow-sm">Open leads</a>
    <% if (!_f.isPipelineDefault) { %>
    <% if (!_f.isTradeFolder) { %>
    <button type="button" class="folder-move px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" data-folder-key="<%= _f.key %>">Move</button>
    <% } %>
    <button type="button" class="folder-rename px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" data-folder-key="<%= _f.key %>">Rename</button>
    <button type="button" class="folder-delete px-3 py-2 rounded-xl bg-white dark:bg-red-950/30 border border-red-200/70 dark:border-red-900/50 text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/50 transition-colors" data-folder-key="<%= _f.key %>">Remove</button>
    <% } else { %>
    <button type="button" class="folder-delete px-3 py-2 rounded-xl bg-white dark:bg-red-950/30 border border-red-200/70 dark:border-red-900/50 text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/50 transition-colors" data-folder-key="<%= _f.key %>">Remove</button>
    <% } %>
  </div>
</div>
