<%
  const _ogTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : ('Review ' + member.companyName);
  const _ogDesc = typeof ogDescription !== 'undefined' && ogDescription
    ? ogDescription
    : ('How was your experience with ' + member.companyName + '? Leave a quick review.');
  const _ogImage = typeof ogImageUrl !== 'undefined' ? ogImageUrl : '';
  const _ogUrl = typeof ogUrl !== 'undefined' ? ogUrl : '';
%>
<meta property="og:type" content="website">
<meta property="og:site_name" content="AdHello.io">
<% if (_ogTitle) { %><meta property="og:title" content="<%= _ogTitle %>"><% } %>
<% if (_ogDesc) { %><meta property="og:description" content="<%= _ogDesc %>"><% } %>
<% if (_ogUrl) { %><meta property="og:url" content="<%= _ogUrl %>"><% } %>
<% if (_ogImage) { %>
<meta property="og:image" content="<%= _ogImage %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/jpeg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= _ogTitle %>">
<meta name="twitter:description" content="<%= _ogDesc %>">
<meta name="twitter:image" content="<%= _ogImage %>">
<% } %>
