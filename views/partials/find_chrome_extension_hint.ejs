<% const _downloadUrl = typeof chromeExtensionDownloadUrl !== 'undefined' && chromeExtensionDownloadUrl
  ? chromeExtensionDownloadUrl
  : '/workspace/integrations/chrome-extension/download'; %>
<% const _downloadReady = typeof chromeExtensionDownloadReady !== 'undefined' ? chromeExtensionDownloadReady : true; %>
<% const _setupUrl = '/workspace/integrations#chrome-extension'; %>

<aside class="find-chrome-ext rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white/90 dark:bg-slate-900/70 p-4 sm:p-5 shadow-sm" aria-labelledby="find-chrome-ext-heading">
  <div class="flex flex-col sm:flex-row sm:items-start gap-4">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-yellow/25 text-brand-dark dark:text-brand-yellow" aria-hidden="true">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <circle cx="12" cy="12" r="3.5"/>
        <path d="M12 3a9 9 0 0 1 8.2 5.2H14.5"/>
        <path d="M4.4 7.3A9 9 0 0 0 12 21a9 9 0 0 0 7.8-4.5H13"/>
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Chrome extension</p>
      <h3 id="find-chrome-ext-heading" class="font-display font-bold text-base sm:text-lg text-brand-dark dark:text-white leading-snug">Browse &amp; save leads yourself</h3>
      <p class="text-sm text-brand-muted mt-1.5 leading-relaxed max-w-2xl">
        Install the AdHello Chrome extension, then search on Google Maps, Yelp, Houzz, Angi, BBB, and more — save listings straight into your pipeline while you browse.
      </p>
      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Suggested sites">
        <% ['Google Maps', 'Yelp', 'Houzz', 'Angi', 'BBB', 'Yellow Pages'].forEach(function (label) { %>
        <li class="rounded-full border border-brand-border/40 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/60 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-brand-dark dark:text-slate-200"><%= label %></li>
        <% }); %>
      </ul>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <% if (_downloadReady) { %>
        <a href="<%= _downloadUrl %>" class="inline-flex items-center justify-center rounded-full bg-brand-yellow px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark hover:brightness-105 transition-colors">
          Download Chrome extension
        </a>
        <% } %>
        <a href="<%= _setupUrl %>" class="inline-flex items-center justify-center rounded-full border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-900/60 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">
          Setup &amp; API key
        </a>
        <a href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand-yellow hover:underline">Open Google Maps ↗</a>
      </div>
    </div>
  </div>
</aside>
