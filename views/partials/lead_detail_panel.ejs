              <button type="button" id="leadPanelCallDockFocus" class="shrink-0 rounded-lg border border-emerald-600/40 bg-white/90 dark:bg-slate-900 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200 hover:bg-emerald-50 dark:hover:bg-slate-800 transition-colors">Open dialer</button>
              <button type="button" id="leadPanelCallDockHangup" class="shrink-0 rounded-lg bg-rose-600 text-white px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest hover:bg-rose-500 transition-colors">Hang up</button>
            </div>
            <%- include('/partials/lead_send_info', { sendInfoId: 'leadPanelSendInfo', sendInfoWrapClass: 'mx-3 my-2', sendInfoCompact: true }) %>
