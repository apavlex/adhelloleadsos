        </div>

        <button type="button" id="mobilePanelRemoveBtn" class="w-full text-center py-3 mt-1 text-xs font-black uppercase tracking-[0.2em] text-red-500 hover:text-red-600 transition-colors border-t border-brand-border/15 dark:border-white/10 pt-3">Discard this Lead</button>
        </div><!-- /leadPanelNotepadBody -->
