        <div class="mt-auto rounded-2xl border border-brand-border/25 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/40 overflow-hidden shadow-sm ring-1 ring-black/[0.03] dark:ring-white/5 flex flex-col-reverse">
          <button type="button" id="leadPanelComposerToggle" aria-expanded="true" aria-controls="leadPanelComposerDrawer" class="w-full flex items-center justify-between gap-3 px-3 py-2.5 text-left hover:bg-brand-cream/50 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
