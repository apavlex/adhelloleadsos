          <div class="relative">
            <label for="leadStatusSelect" class="sr-only">Sales pipeline state</label>
            <select id="leadStatusSelect" class="w-full bg-white dark:bg-slate-900 border border-brand-border/40 dark:border-white/10 rounded-xl px-4 py-2.5 pr-10 font-bold text-xs shadow-sm focus:ring-2 focus:ring-brand-yellow appearance-none transition-all dark:text-white">
              <option value="Not Contacted">Not Contacted</option>
              <option value="Video Recorded">Video Recorded</option>
              <option value="Called Lead">Called Lead</option>
              <option value="Email Sent">Email Sent</option>
              <option value="Follow-up">Follow-up</option>
              <option value="Closed - Won">Closed - Won</option>
              <option value="Closed - Lost">Closed - Lost</option>
            </select>
            <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-brand-muted" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-0.5 border-t border-brand-border/15 dark:border-white/10" id="leadNotepadTagRow">
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="Gatekeeper">Gatekeeper</button>
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="Left VM">Left VM</button>
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="Not interested">Not interested</button>
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="Callback requested">Callback requested</button>
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="DM connected">DM connected</button>
            <button type="button" class="lead-notepad-tag btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border/40 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white hover:border-brand-yellow" data-tag="Send info">Send info</button>
          </div>
        </div>

        <div class="rounded-2xl border border-brand-border/25 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/40 overflow-hidden shadow-sm ring-1 ring-black/[0.03] dark:ring-white/5">
          <button type="button" id="leadPanelOutreachToggle" aria-expanded="true" aria-controls="leadPanelOutreachDrawer" class="w-full flex items-center justify-between gap-3 px-3 py-2.5 text-left hover:bg-brand-cream/50 dark:hover:bg-slate-800/80 transition-colors">
