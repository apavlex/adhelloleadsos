        <p class="lead-panel-widget__lede">Creates a dated task on <a href="/tasks" class="text-brand-yellow font-bold hover:underline">Tasks</a> so warm callbacks do not get lost in sequence-only flows.</p>
        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="leadCallbackDate" class="lead-panel-field-label">Date</label>
              <input type="date" id="leadCallbackDate" class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
            <div>
              <label for="leadCallbackTime" class="lead-panel-field-label">Time</label>
              <input type="time" id="leadCallbackTime" class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
          </div>
          <div>
            <label for="leadCallbackReason" class="lead-panel-field-label">Reason</label>
            <input type="text" id="leadCallbackReason" placeholder="e.g. Call back after 3pm — asked for pricing" class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-brand-dark dark:text-white" />
          </div>
          <label class="inline-flex items-center gap-2 text-[10px] font-bold text-brand-muted cursor-pointer select-none">
            <input type="checkbox" id="leadCallbackRemind15" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow" checked />
            Remind me 15 minutes before (note in task title)
          </label>
          <p id="leadCallbackTaskHint" class="text-[10px] text-emerald-700 dark:text-emerald-300 hidden font-semibold"></p>
          <button type="button" id="leadCallbackSaveBtn" class="btn-pill w-full sm:w-auto bg-sky-600 text-white px-5 py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-sky-700">Create callback task</button>
        </div>
      </section>

      <section class="lead-panel-widget lead-panel-widget--cadence" aria-labelledby="leadCadencePlaybookHeading">
        <div class="lead-panel-widget__block">
          <h3 id="leadCadencePlaybookHeading" class="lead-panel-widget__title lead-panel-widget__title--violet">Cadence</h3>
          <p class="lead-panel-widget__lede">Pick a playbook for this lead and start it here. Voicemail disposition can still auto-attach the default audit sequence. Pause on engagement; snooze for “call me next quarter.”</p>
          <div class="space-y-4">
            <div class="space-y-2">
              <label for="leadCadencePlaybookSelect" class="lead-panel-field-label lead-panel-field-label--violet">Playbook</label>
              <select id="leadCadencePlaybookSelect" class="w-full rounded-xl border border-violet-300/50 dark:border-violet-600/50 bg-white dark:bg-slate-900 px-3 py-2.5 text-xs font-bold text-brand-dark dark:text-white focus:ring-2 focus:ring-violet-500 focus:outline-none" aria-describedby="leadCadencePlaybookDesc" data-playbooks-prerendered="<%= playbookTemplates.length ? '1' : '0' %>">
                <% if (!playbookTemplates.length) { %>
                <option value="">Loading playbooks…</option>
                <% } else { playbookTemplates.forEach(function (t) { if (!t || !t.id) return; var stepN = t.stepCount != null ? t.stepCount : (t.steps && t.steps.length) || 0; %>
                <option value="<%= t.id %>"><%= t.persona || 'Cadence' %> · <%= t.name || t.id %> (<%= stepN %> steps)</option>
                <% }); } %>
              </select>
              <p id="leadCadencePlaybookDesc" class="text-[11px] text-brand-muted dark:text-slate-400 leading-relaxed">—</p>
              <p id="leadCadenceActiveStatus" class="hidden text-[11px] font-semibold text-violet-900 dark:text-violet-100 leading-relaxed rounded-xl bg-white/60 dark:bg-slate-900/50 border border-violet-300/30 dark:border-violet-600/30 px-3 py-2"></p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
              <button type="button" id="sidebarCadenceStartBtn" class="btn-pill bg-violet-600 text-white py-2.5 px-4 text-[10px] font-black uppercase tracking-widest hover:bg-violet-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">Start playbook</button>
              <button type="button" id="sidebarCadenceSnooze90Btn" class="btn-pill bg-white dark:bg-slate-800 border border-violet-300 dark:border-violet-700 py-2.5 px-4 text-[10px] font-black uppercase tracking-widest text-violet-900 dark:text-violet-100 hover:border-violet-500 transition-colors">Snooze 90 days</button>
              <button type="button" id="sidebarCadencePauseBtn" class="btn-pill bg-white dark:bg-slate-800 border border-violet-300 dark:border-violet-700 py-2.5 px-4 text-[10px] font-black uppercase tracking-widest text-violet-900 dark:text-violet-100 hover:border-violet-500 transition-colors">Pause cadence</button>
              <a href="/sequences" class="btn-pill sm:col-span-2 bg-white dark:bg-slate-800 border border-violet-300 dark:border-violet-700 py-2.5 px-4 text-[10px] font-black uppercase tracking-widest text-violet-900 dark:text-violet-100 text-center hover:border-violet-500 transition-colors">All playbooks</a>
            </div>
          </div>
        </div>

        <div class="lead-panel-widget__divider" role="separator" aria-hidden="true"></div>

        <div id="leadCadenceSection" class="lead-panel-widget__block" aria-labelledby="leadCadenceHeading">
          <h3 id="leadCadenceHeading" class="lead-panel-widget__title lead-panel-widget__title--muted">Cadence &amp; touches</h3>
          <div class="lead-panel-widget__inner space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <p class="lead-panel-field-label">Last activity</p>
                <p id="cadenceLastTouchLine" class="text-sm font-bold text-brand-dark dark:text-white mt-1">—</p>
              </div>
              <div>
                <p class="lead-panel-field-label">Last touch channel</p>
                <p id="cadenceChannelLine" class="text-sm font-bold text-brand-dark dark:text-white mt-1">—</p>
              </div>
            </div>
            <div id="cadencePlaybookStepsWrap" class="hidden rounded-2xl border border-violet-300/35 dark:border-violet-600/35 bg-white/70 dark:bg-slate-900/50 p-4 space-y-2">
              <p id="cadencePlaybookStepsHeading" class="lead-panel-field-label lead-panel-field-label--violet mb-0">Touches in this playbook</p>
              <p id="cadencePlaybookStepsHint" class="hidden text-[10px] text-brand-muted dark:text-slate-400 leading-relaxed">Complete each step and log activity on the lead. Your current step is highlighted.</p>
              <ol id="cadencePlaybookStepsList" class="list-none m-0 p-0 space-y-2" role="list" aria-label="Playbook touches"></ol>
            </div>
            <div id="cadenceSequenceWrap" class="hidden rounded-2xl bg-white/50 dark:bg-slate-900/40 border border-brand-border/15 dark:border-white/10 p-4">
              <p class="lead-panel-field-label mb-1">Sequence</p>
              <p id="cadenceSequenceLine" class="text-xs font-semibold text-brand-dark dark:text-slate-200 leading-snug">—</p>
            </div>
            <div class="rounded-2xl bg-brand-yellow/10 dark:bg-brand-yellow/15 border border-brand-yellow/25 p-4">
              <p class="lead-panel-field-label text-brand-yellow mb-1">Recommended next</p>
              <p id="cadenceNextStepLine" class="text-xs font-semibold text-brand-dark dark:text-slate-200 leading-relaxed">Keep outreach steady until you get a reply or meeting. Log each touch so the team sees momentum.</p>
            </div>
            <div id="cadenceLogsWrap" class="hidden space-y-2">
              <p class="lead-panel-field-label mb-0">Recent activity log</p>
              <ul id="cadenceLogList" class="list-none m-0 p-0 space-y-2 max-h-48 overflow-y-auto text-[11px]"></ul>
            </div>
          </div>
        </div>
      </section>

      <section class="lead-panel-widget lead-panel-widget--plain">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <h3 class="lead-panel-widget__title lead-panel-widget__title--muted mb-0">Activity &amp; history</h3>
          <div class="inline-flex rounded-full border border-brand-border/40 dark:border-white/10 p-0.5 bg-brand-cream/40 dark:bg-slate-800/80" role="group" aria-label="Activity filter">
            <button type="button" class="lead-activity-filter px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest bg-white dark:bg-slate-900 text-brand-dark dark:text-white shadow-sm" data-activity-filter="all">All</button>
            <button type="button" class="lead-activity-filter px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white" data-activity-filter="calls">Calls</button>
            <button type="button" class="lead-activity-filter px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white" data-activity-filter="notes">My notes</button>
          </div>
        </div>
        <p id="activityLogCount" class="hidden text-[9px] font-semibold uppercase tracking-widest text-brand-muted dark:text-slate-500 mb-3" aria-live="polite"></p>
        <div id="activityLogScroll" class="max-h-[19rem] overflow-y-auto overflow-x-hidden pr-1 -mr-1 custom-scrollbar relative rounded-2xl border border-brand-border/20 dark:border-white/10 bg-brand-cream/20 dark:bg-white/[0.03] p-3">
          <div id="activityLog" class="space-y-5 relative before:absolute before:left-4 before:top-2 before:bottom-2 before:w-0.5 before:bg-brand-border/40 dark:before:bg-white/10">
            <div class="pl-10 text-xs text-brand-muted italic">Select a lead to load activity.</div>
          </div>
        </div>
      </section>

      <!-- Final Actions -->
      <div class="space-y-4 pt-6 border-t border-brand-border/20 dark:border-white/5">
        <button id="mobilePanelRemoveBtn" class="w-full text-center py-4 text-xs font-black uppercase tracking-[0.2em] text-red-500 hover:text-red-600 transition-colors">Discard this Lead</button>
      </div>

      </div><!-- /lead-tab-history -->
      </div><!-- /leadPanelTabScroll -->

      <div id="leadPanelNotepad" class="shrink-0 border-t border-brand-border/20 dark:border-white/10 pt-3 mt-2 flex flex-col gap-3 bg-white/98 dark:bg-slate-900/98 backdrop-blur-md pb-[max(0.5rem,env(safe-area-inset-bottom,0px))] rounded-t-2xl sm:rounded-t-[1.75rem] shadow-[0_-10px_40px_-18px_rgba(15,23,42,0.18)] dark:shadow-[0_-12px_48px_-16px_rgba(0,0,0,0.55)] -mx-2 px-2 sm:-mx-1 sm:px-1 relative z-[28]">
        <div class="space-y-2.5 rounded-2xl border border-brand-border/25 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-800/50 p-3 ring-1 ring-black/[0.03] dark:ring-white/5">
          <div class="flex items-center justify-between gap-2 min-w-0">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted px-0.5 min-w-0 truncate">Quick log · pipeline <span class="text-brand-muted/60 font-semibold normal-case">(always visible)</span></p>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" id="leadPanelRecordToggle" disabled class="inline-flex items-center justify-center px-2.5 py-1 rounded-lg border border-brand-border/50 dark:border-white/15 bg-white dark:bg-slate-800 text-[9px] font-black uppercase tracking-wider text-brand-dark dark:text-white opacity-40 pointer-events-none" title="Available after your carrier connects the call" aria-pressed="false" aria-label="Toggle call recording">Record</button>
              <label class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-rose-500/35 bg-rose-500/[0.06] dark:bg-rose-950/25 cursor-pointer" title="DNC is compliance only — it does not hang up or block dialers">
