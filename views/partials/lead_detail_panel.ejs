              <button type="button" id="leadPanelCallDockHangup" class="shrink-0 rounded-lg bg-rose-600 text-white px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest hover:bg-rose-500 transition-colors">Hang up</button>
            </div>
            <div class="p-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
              <button type="button" id="clickToCallBtn" class="btn-pill bg-emerald-500 text-white py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-emerald-600 transition-colors">Call</button>
              <button type="button" id="voicemailDropBtn" class="btn-pill bg-violet-600 text-white py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-violet-700 transition-colors">Voicemail</button>
              <button type="button" id="sendSmsBtn" class="btn-pill bg-blue-600 text-white py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-blue-700 transition-colors">SMS</button>
              <button type="button" id="draftEmailBtn" class="btn-pill btn-primary py-2.5 text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-1.5 shadow-md hover:shadow-brand-yellow/25">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                Email
