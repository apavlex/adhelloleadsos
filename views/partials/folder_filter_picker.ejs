<%#
  Collapsible folder tree picker for pipeline filters.
  Locals: folderPickerTree ({ roots, selectedLabel }), selectedFolderKey, inputName
%>
<% const _tree = typeof folderPickerTree !== 'undefined' && folderPickerTree ? folderPickerTree : { roots: [], selectedLabel: 'Main pipeline (unfiled)' }; %>
<% const _selKey = typeof selectedFolderKey !== 'undefined' ? String(selectedFolderKey || '') : ''; %>
<% const _inputName = typeof inputName !== 'undefined' && inputName ? String(inputName) : 'folderKey'; %>
<% const _selLabel = _tree.selectedLabel || 'Main pipeline (unfiled)'; %>
<div class="folder-filter-picker relative" data-folder-picker>
  <input type="hidden" name="<%= _inputName %>" value="<%= _selKey %>" data-folder-picker-value />
  <button type="button" class="folder-filter-picker-trigger w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-bold text-brand-dark dark:text-white text-left flex items-center justify-between gap-2 hover:border-brand-yellow/40 transition-colors" aria-haspopup="listbox" aria-expanded="false">
    <span class="folder-filter-picker-label truncate"><%= _selLabel %></span>
    <span class="text-brand-muted text-xs shrink-0" aria-hidden="true">▾</span>
  </button>
  <div class="folder-filter-picker-panel hidden absolute left-0 right-0 top-full mt-1 z-[500] rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl overflow-hidden" role="listbox">
    <div class="p-2 border-b border-brand-border/30 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40">
      <input type="search" class="folder-filter-picker-search w-full rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60" placeholder="Search folders…" autocomplete="off" aria-label="Search folders" />
    </div>
    <div class="folder-filter-picker-list max-h-64 overflow-y-auto custom-scrollbar p-1">
      <% function renderPickerNodes(nodes, depth) {
        (nodes || []).forEach(function (node) {
          if (!node) return;
          var pad = 4 + (depth || 0) * 14;
      %>
      <div class="folder-filter-picker-node" data-folder-picker-node data-search="<%= node.searchText || node.name %>">
        <div class="flex items-stretch gap-0.5 rounded-lg transition-colors <%= node.selected ? 'bg-brand-yellow/15 dark:bg-brand-yellow/10' : 'hover:bg-brand-cream/50 dark:hover:bg-white/5' %>">
          <% if (node.hasChildren) { %>
          <button type="button" class="folder-filter-picker-expand shrink-0 w-8 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white text-[10px] transition-transform" aria-label="Expand <%= node.name %>" data-expanded="false" title="Show subfolders">▶</button>
          <% } else { %><span class="w-8 shrink-0" aria-hidden="true"></span><% } %>
          <button type="button" class="folder-filter-picker-option flex-1 min-w-0 text-left py-2 pr-3 text-sm font-semibold text-brand-dark dark:text-white truncate"
            data-key="<%= node.key %>"
            data-label="<%= node.name %>"
            data-search="<%= node.searchText || node.name %>"
            style="padding-left: <%= pad %>px"
            title="<%= node.name %>">
            <%= node.name %>
            <% if (node.isSystem) { %><span class="ml-1.5 text-[9px] font-black uppercase tracking-widest text-brand-muted">System</span><% } %>
            <% if (node.isTrade) { %><span class="ml-1.5 text-[9px] font-black uppercase tracking-widest text-sky-600 dark:text-sky-300">Trade</span><% } %>
          </button>
        </div>
        <% if (node.hasChildren) { %>
        <div class="folder-filter-picker-children hidden" data-folder-picker-children>
          <% renderPickerNodes(node.children, (depth || 0) + 1); %>
        </div>
        <% } %>
      </div>
      <% }); } %>
      <% renderPickerNodes(_tree.roots || [], 0); %>
      <p class="folder-filter-picker-empty hidden px-3 py-4 text-sm text-brand-muted text-center">No folders match your search.</p>
    </div>
  </div>
</div>
