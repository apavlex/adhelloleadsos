<% const _planView = typeof actionPlan !== 'undefined' && actionPlan ? actionPlan : null; %>
<% const _planEmbed = typeof hubEmbed !== 'undefined' && hubEmbed; %>
<% if (_planView) { %>
<% const _planViewTag = _planEmbed ? 'div' : 'section'; %>
<% const _planViewClass = _planEmbed
  ? 'text-brand-dark dark:text-white overflow-hidden'
  : 'mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 text-brand-dark dark:text-white shadow-sm overflow-hidden'; %>
<<%= _planViewTag %> class="<%= _planViewClass %>" id="action-plan-tracker" aria-label="Daily action plan tracker" data-year="<%= _planView.year %>" data-month="<%= _planView.month %>">
  <div class="px-5 sm:px-6 pt-5 sm:pt-6 pb-4 <%= _planEmbed ? 'pt-4' : 'border-b border-brand-border/50 dark:border-white/10' %>">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 <%= _planEmbed ? 'mb-4' : 'mb-5' %>">
      <div class="rounded-xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 px-4 py-3">
        <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted"><%= _planView.year %> Client Goal</p>
        <p class="font-display font-black text-3xl text-brand-dark dark:text-white tabular-nums mt-1" id="actionPlanClientGoal"><%= _planView.clientGoal %></p>
      </div>
      <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 dark:bg-emerald-500/15 px-4 py-3">
        <p class="text-[9px] font-black uppercase tracking-widest text-emerald-800/80 dark:text-emerald-300/80">Clients Acquired YTD</p>
        <p class="font-display font-black text-3xl tabular-nums text-emerald-700 dark:text-emerald-400 mt-1" id="actionPlanClientsYtd"><%= _planView.clientsAcquiredYtd %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <% if (!_planEmbed) { %>
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Daily Action Plan Tracker</p>
        <h2 class="font-display font-extrabold text-lg sm:text-xl text-brand-dark dark:text-white"><%= _planView.monthLabel %></h2>
      </div>
      <% } else { %>
      <p class="text-xs text-brand-muted hidden sm:block">Click a cell when you complete an activity for that day.</p>
      <% } %>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 <%= _planEmbed ? 'ml-auto' : '' %>">
        <% if (!_planEmbed) { %>
        <p class="text-xs text-brand-muted hidden sm:block">Click a cell when you complete an activity for that day.</p>
        <% } %>
        <button
          type="button"
          id="actionPlanCustomizeBtn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-800 text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-white/10 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Customize
        </button>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto custom-scrollbar">
    <table class="action-plan-grid w-full min-w-[52rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-brand-border/50 dark:border-white/10">
          <th class="action-plan-sticky-col px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted w-[14rem] min-w-[14rem]">Activity</th>
          <% _planView.days.forEach(function (day) { %>
          <% const _isToday = _planView.isCurrentMonth && day === _planView.todayDay; %>
          <th class="px-0 py-3 text-center text-[11px] font-black tabular-nums <%= _isToday ? 'action-plan-today-col text-brand-dark dark:text-white' : 'text-brand-muted' %>" style="min-width:2.25rem;width:2.25rem"><%= day %></th>
          <% }); %>
        </tr>
      </thead>
    </table>
    <% _planView.categories.forEach(function (cat, catIdx) { %>
    <details class="action-plan-cat-details border-b border-brand-border/30 dark:border-white/5" <%= catIdx === 0 ? 'open' : '' %>>
      <summary class="flex items-center justify-between gap-3 px-4 py-2 text-[9px] font-black uppercase tracking-[0.2em] text-brand-yellow dark:text-brand-yellow/90 bg-brand-cream/50 dark:bg-slate-800/60 [&::-webkit-details-marker]:hidden">
        <span><%= cat.label %></span>
        <span class="flex items-center gap-2 text-brand-muted normal-case tracking-normal font-bold text-[10px]">
          <span><%= cat.activities.length %> activities</span>
          <span class="action-plan-cat-chevron transition-transform inline-block" aria-hidden="true">▼</span>
        </span>
      </summary>
      <table class="action-plan-grid w-full min-w-[52rem] border-collapse text-left">
        <tbody>
        <% cat.activities.forEach(function (act) { %>
        <tr class="border-b border-brand-border/30 dark:border-white/5 hover:bg-brand-cream/20 dark:hover:bg-white/[0.02]">
          <td class="action-plan-sticky-col px-4 py-2.5 text-xs font-semibold text-brand-dark dark:text-slate-200 border-r border-brand-border/30 dark:border-white/5">
            <span class="inline-flex items-center gap-2 flex-wrap">
              <span><%= act.label %></span>
              <% if (act.gen) { %><span class="text-[8px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow bg-brand-yellow/20 dark:bg-brand-yellow/10 border border-brand-yellow/40 dark:border-brand-yellow/30 rounded px-1 py-0.5">Gen</span><% } %>
            </span>
          </td>
          <% _planView.days.forEach(function (day) { %>
          <% const _dk = _planView.year + '-' + String(_planView.month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); %>
          <% const _checked = (_planView.completions[_dk] || []).indexOf(act.id) !== -1; %>
          <% const _isToday = _planView.isCurrentMonth && day === _planView.todayDay; %>
          <td class="p-0 text-center <%= _isToday ? 'action-plan-today-col' : '' %>">
            <button
              type="button"
              class="action-plan-cell w-full h-9 flex items-center justify-center transition-colors hover:bg-brand-cream/60 dark:hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow/50"
              data-date="<%= _dk %>"
              data-activity="<%= act.id %>"
              aria-pressed="<%= _checked ? 'true' : 'false' %>"
              title="<%= act.label %> — <%= _dk %>"
            >
              <% if (_checked) { %>
              <span class="action-plan-check inline-flex w-5 h-5 items-center justify-center rounded bg-emerald-500 text-white text-xs font-black" aria-hidden="true">✓</span>
              <% } else { %>
              <span class="action-plan-dot w-1.5 h-1.5 rounded-full bg-brand-border/80 dark:bg-white/15" aria-hidden="true"></span>
              <% } %>
            </button>
          </td>
          <% }); %>
        </tr>
        <% }); %>
        </tbody>
      </table>
    </details>
    <% }); %>
    <table class="action-plan-grid w-full min-w-[52rem] border-collapse text-left">
      <tbody>
        <tr class="bg-brand-cream/40 dark:bg-slate-800/50 border-t border-brand-border/50 dark:border-white/10">
          <td class="action-plan-sticky-col action-plan-sticky-col--total px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-amber-800 dark:text-amber-300/90">Daily Total</td>
          <% _planView.days.forEach(function (day) { %>
          <% const _dk = _planView.year + '-' + String(_planView.month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); %>
          <% const _tot = _planView.dailyTotals[_dk] || 0; %>
          <% const _isToday = _planView.isCurrentMonth && day === _planView.todayDay; %>
          <td class="text-center py-2 <%= _isToday ? 'action-plan-today-col' : '' %>">
            <% if (_tot > 0) { %>
            <span class="action-plan-day-total action-plan-day-total--filled inline-flex min-w-[1.25rem] h-5 px-1 items-center justify-center rounded bg-brand-yellow dark:bg-amber-500/90 text-brand-dark text-[10px] font-black tabular-nums" data-date="<%= _dk %>"><%= _tot %></span>
            <% } else { %>
            <span class="action-plan-day-total text-brand-muted/50 dark:text-slate-600 text-[10px] font-bold tabular-nums" data-date="<%= _dk %>"></span>
            <% } %>
          </td>
          <% }); %>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="px-5 sm:px-6 py-4 border-t border-brand-border/50 dark:border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <p class="text-sm text-brand-muted dark:text-slate-300">
      Monthly Total: <strong class="text-emerald-700 dark:text-emerald-400 font-black tabular-nums" id="actionPlanMonthlyTotal"><%= _planView.monthlyTotal %></strong> activities completed
    </p>
    <nav class="flex flex-wrap gap-1" aria-label="Select month">
      <% const _months = typeof actionPlanMonthNav !== 'undefined' ? actionPlanMonthNav : []; %>
      <% _months.forEach(function (m) { %>
      <a
        href="/today?actionPlanYear=<%= m.year %>&amp;actionPlanMonth=<%= m.month %>#today-hub-action-plan"
        class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest transition-colors <%= m.active ? 'bg-brand-yellow text-brand-dark shadow-sm' : 'text-brand-muted hover:bg-brand-cream/60 dark:hover:bg-white/10 hover:text-brand-dark dark:hover:text-white' %>"
        <%= m.active ? 'aria-current="page"' : '' %>
      ><%= m.short %></a>
      <% }); %>
    </nav>
  </div>
</<%= _planViewTag %>>

<div
  id="actionPlanEditorModal"
  class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60"
  role="dialog"
  aria-modal="true"
  aria-labelledby="actionPlanEditorTitle"
  aria-hidden="true"
>
  <div class="w-full max-w-2xl max-h-[min(90vh,48rem)] flex flex-col rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
    <div class="px-5 sm:px-6 py-4 border-b border-brand-border/50 dark:border-white/10 flex items-start justify-between gap-3">
      <div>
        <h3 id="actionPlanEditorTitle" class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Customize action plan</h3>
        <p class="text-xs text-brand-muted mt-1">Edit categories, activities, and your annual client goal.</p>
      </div>
      <button type="button" id="actionPlanEditorClose" class="p-1.5 rounded-lg text-brand-muted hover:bg-brand-cream/60 dark:hover:bg-white/10" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto custom-scrollbar px-5 sm:px-6 py-4 space-y-5">
      <div>
        <label for="actionPlanEditorClientGoal" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5"><%= _planView.year %> client goal</label>
        <input
          type="number"
          id="actionPlanEditorClientGoal"
          min="1"
          max="999"
          class="w-24 px-3 py-2 rounded-lg border border-brand-border dark:border-white/15 bg-brand-cream/30 dark:bg-slate-800 text-brand-dark dark:text-white text-sm font-bold tabular-nums"
          value="<%= _planView.clientGoal %>"
        />
      </div>
      <div id="actionPlanEditorCategories" class="space-y-4"></div>
      <button
        type="button"
        id="actionPlanEditorAddCategory"
        class="w-full py-2.5 rounded-xl border border-dashed border-brand-border dark:border-white/20 text-xs font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/60 hover:bg-brand-yellow/5 transition-colors"
      >
        + Add category
      </button>
    </div>
    <div class="px-5 sm:px-6 py-4 border-t border-brand-border/50 dark:border-white/10 flex flex-wrap items-center justify-between gap-3 bg-brand-cream/20 dark:bg-slate-800/40">
      <button type="button" id="actionPlanEditorReset" class="text-xs font-semibold text-brand-muted hover:text-red-600 dark:hover:text-red-400 transition-colors">Reset to defaults</button>
      <div class="flex items-center gap-2">
        <button type="button" id="actionPlanEditorCancel" class="px-4 py-2 rounded-lg text-xs font-black uppercase tracking-widest text-brand-muted hover:bg-brand-cream/60 dark:hover:bg-white/10">Cancel</button>
        <button type="button" id="actionPlanEditorSave" class="px-4 py-2 rounded-lg text-xs font-black uppercase tracking-widest bg-brand-yellow text-brand-dark hover:brightness-95 shadow-sm">Save changes</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="action-plan-catalog-json"><%- JSON.stringify({ categories: _planView.categories, clientGoal: _planView.clientGoal }).replace(/</g, '\\u003c') %></script>
<style>
  .action-plan-sticky-col {
    position: sticky;
    left: 0;
    z-index: 10;
    background: #fff;
  }
  .dark .action-plan-sticky-col {
    background: rgb(15 23 42 / 0.95);
  }
  .action-plan-sticky-col--total {
    background: rgb(250 248 245);
  }
  .dark .action-plan-sticky-col--total {
    background: rgb(30 41 59 / 0.95);
  }
  .action-plan-today-col {
    background: rgb(255 214 68 / 0.12);
  }
  .dark .action-plan-today-col {
    background: rgb(255 214 68 / 0.08);
  }
  .action-plan-cat-details[open] .action-plan-cat-chevron {
    transform: rotate(180deg);
  }
</style>
<script src="/js/action-plan-tracker.js" defer></script>
<% } %>
