<!-- AI personalized email outreach modal -->
<div id="emailIntelModal" class="fixed inset-0 z-[280] hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-brand-dark/75 backdrop-blur-sm email-intel-backdrop" aria-hidden="true"></div>
  <div class="absolute inset-0 flex items-start justify-center p-4 pt-16 md:pt-24 pointer-events-none">
    <div class="pointer-events-auto w-full max-w-lg bg-white dark:bg-slate-900 rounded-[2rem] border border-brand-border/30 dark:border-white/10 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="p-6 border-b border-brand-border/20 dark:border-white/10 flex items-start justify-between gap-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400">AI personalized email</p>
          <h3 id="emailIntelTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mt-1 leading-tight">Company</h3>
          <p id="emailIntelEmailLine" class="text-xs font-semibold text-brand-muted dark:text-slate-400 mt-1 truncate max-w-[18rem]"></p>
        </div>
        <button type="button" class="email-intel-close w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center shrink-0" aria-label="Close">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto custom-scrollbar flex-1 space-y-6">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-3">AI recommended for this lead</p>
          <div id="emailIntelAiBody" class="text-sm text-brand-muted dark:text-slate-400 leading-relaxed min-h-[4rem]">
            Loading…
          </div>
        </div>
        <div id="emailIntelDraftSection" class="hidden">
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-2">Personalized email draft</p>
          <textarea id="emailIntelDraft" readonly rows="8" class="w-full rounded-2xl border border-brand-border/25 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 px-4 py-3 text-sm text-brand-dark dark:text-slate-100 leading-relaxed resize-y min-h-[9rem] focus:outline-none focus:ring-2 focus:ring-brand-yellow/40"></textarea>
          <button type="button" id="emailIntelCopyDraft" class="mt-2 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">Copy draft</button>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-3">Quick offer templates <span class="font-medium normal-case tracking-normal text-brand-muted/70">· tap to open email</span></p>
          <div id="emailIntelOfferList" class="grid grid-cols-1 gap-2 text-xs font-semibold">
            <a href="#" data-offer-idx="0" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Website &amp; conversion (CRO, speed, rebuilds)</a>
            <a href="#" data-offer-idx="1" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Reputation &amp; reviews (GEO, listings)</a>
            <a href="#" data-offer-idx="2" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Social &amp; content systems</a>
            <a href="#" data-offer-idx="3" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Paid ads &amp; media management</a>
            <a href="#" data-offer-idx="4" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> AI automation &amp; agents</a>
            <a href="#" data-offer-idx="5" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Strategy &amp; consulting retainers</a>
          </div>
        </div>
      </div>
      <div class="p-6 pt-0 flex flex-col sm:flex-row gap-3">
        <button type="button" id="emailIntelMailto" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest disabled:opacity-40 disabled:pointer-events-none">
          Open in email app
        </button>
        <button type="button" class="email-intel-close flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
