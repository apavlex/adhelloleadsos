<%#
  Modal shell for Send info (SMS / Email).
  Params: modalId, sendInfoId, sendInfoCompact (optional)
%>
<% var _mid = typeof modalId !== 'undefined' ? modalId : 'sendInfoModal'; %>
<% var _sid = typeof sendInfoId !== 'undefined' ? sendInfoId : 'leadPanelSendInfo'; %>
<% var _compact = typeof sendInfoCompact !== 'undefined' ? sendInfoCompact : true; %>
<dialog
  id="<%= _mid %>"
  class="lead-send-info-dialog m-0 p-0 max-w-none max-h-none w-full h-full bg-transparent open:flex open:items-end open:justify-center sm:open:items-center backdrop:bg-slate-950/55 backdrop:backdrop-blur-[2px]"
  aria-labelledby="<%= _mid %>-title"
  data-send-info-modal
>
  <div class="lead-send-info-dialog__sheet relative w-full sm:max-w-md max-h-[min(92dvh,40rem)] overflow-y-auto custom-scrollbar rounded-t-3xl sm:rounded-3xl border border-brand-border/50 dark:border-white/15 bg-brand-cream dark:bg-slate-900 shadow-2xl mx-0 sm:mx-4 mb-0 sm:mb-0">
    <div class="sticky top-0 z-10 flex items-center justify-between gap-3 px-4 pt-3 pb-2 bg-brand-cream/95 dark:bg-slate-900/95 backdrop-blur border-b border-brand-border/20 dark:border-white/10">
      <div class="min-w-0">
        <p id="<%= _mid %>-title" class="text-[11px] font-black uppercase tracking-[0.14em] text-brand-dark dark:text-white">Send info</p>
        <p class="text-[10px] font-semibold text-brand-muted dark:text-slate-400 truncate">SMS or email while you’re on the call</p>
      </div>
      <button
        type="button"
        class="lead-send-info-modal-close shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl border border-brand-border/50 dark:border-white/15 text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/50 transition-colors"
        aria-label="Close send info"
        data-send-info-modal-close
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-3 pb-4 pt-2">
      <%- include('/partials/lead_send_info', {
        sendInfoId: _sid,
        sendInfoCompact: _compact,
        sendInfoInModal: true,
        sendInfoWrapClass: 'border-0 bg-transparent dark:bg-transparent shadow-none px-0 py-0 rounded-none'
      }) %>
    </div>
  </div>
</dialog>
