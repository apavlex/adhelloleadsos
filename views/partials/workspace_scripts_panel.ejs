<section id="workspace-sales-scripts" class="scroll-mt-28 mb-16" aria-label="Sales scripts workspace">

  <% function composeBlockScript(block) {
    const sections = ['opening', 'discovery', 'valueProp', 'objectionHandling', 'close'];
    const parts = [];
    for (const sec of sections) {
      const t = (block && block[sec] ? String(block[sec]) : '').trim();
      if (t) parts.push(t);
    }
    return parts.join('\n\n');
  } %>

  <div class="grid xl:grid-cols-[minmax(0,1fr)_min(22rem,100%)] gap-8 items-start">
    <div class="flex flex-col gap-6 min-w-0">
      <div class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden min-w-0">
      <div class="px-4 sm:px-6 py-4 border-b border-brand-border dark:border-white/10 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:items-center sm:justify-between">
        <h3 class="font-display font-extrabold text-lg text-brand-dark dark:text-white shrink-0">By offer</h3>
        <div class="flex flex-wrap gap-2" id="pitchTabs" role="tablist" aria-label="Offer">
          <% SCRIPT_LIBRARY_KEYS.forEach((pk, idx) => { %>
            <% const tab = SCRIPT_LIBRARY[pk]; %>
            <button type="button" role="tab" aria-selected="<%= idx === 0 ? 'true' : 'false' %>" data-pitch="<%= pk %>" class="pitch-tab px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest <%= idx === 0 ? 'bg-brand-yellow text-brand-dark shadow-sm' : 'bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-brand-muted' %>"><%= tab.tabLabel || tab.label %></button>
          <% }) %>
        </div>
      </div>

        <% SCRIPT_LIBRARY_KEYS.forEach((pk, idx) => { %>
        <% const block = SCRIPT_LIBRARY[pk]; %>
        <div class="pitch-panel <%= idx === 0 ? '' : 'hidden' %>" data-panel="<%= pk %>" role="tabpanel">
          <p class="text-sm font-bold text-brand-muted px-4 sm:px-6 pt-6 pb-2"><%= block.label %></p>
          <div class="px-4 sm:px-6 pb-6">
            <div class="script-block rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-black/10" data-service="<%= pk %>" data-section="opening">
              <div class="flex flex-wrap items-center justify-between gap-2 py-3 px-4 border-b border-brand-border/40 dark:border-white/10">
                <span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Call script</span>
                <span class="script-autosave-status text-[10px] font-bold text-brand-muted tabular-nums shrink-0" data-snippet-id="snippet-<%= pk %>-opening">Saved</span>
              </div>
              <div class="px-4 pb-4 pt-3">
                <div class="flex flex-wrap gap-2 justify-end mb-3">
                  <button type="button" class="use-in-coach px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-wider bg-brand-dark text-white dark:bg-white dark:text-slate-900 border border-transparent hover:opacity-90 transition-opacity" data-pitch="<%= pk %>" data-section="opening">Coach</button>
                  <button type="button" class="save-to-library px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-wider text-brand-muted hover:text-brand-dark dark:hover:text-white border border-brand-border/60 dark:border-white/10 hover:border-brand-yellow/50 transition-colors" data-snippet="snippet-<%= pk %>-opening">Save</button>
                  <button type="button" class="copy-snippet px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-wider text-brand-muted hover:text-brand-dark dark:hover:text-white border border-brand-border/60 dark:border-white/10 hover:border-brand-yellow/50 transition-colors" data-copy-target="snippet-<%= pk %>-opening">Copy</button>
                </div>
                <textarea id="snippet-<%= pk %>-opening" rows="14" class="script-snippet w-full text-sm leading-relaxed text-brand-dark dark:text-slate-200 bg-white dark:bg-slate-800/80 rounded-2xl p-4 border border-brand-border/50 dark:border-white/10 font-sans resize-y min-h-[12rem] focus:ring-2 focus:ring-brand-yellow focus:border-transparent outline-none"><%= composeBlockScript(block) %></textarea>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <div id="sales-scripts-coach" class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden flex flex-col min-w-0 min-h-0">
        <div class="px-4 py-3 border-b border-brand-border dark:border-white/10 shrink-0">
          <h3 class="font-display font-extrabold text-base text-brand-dark dark:text-white">AI script coach</h3>
          <p class="text-[10px] text-brand-muted mt-1 leading-relaxed">Scoped to the offer script you open with <strong class="text-brand-dark dark:text-white">Coach</strong> on the left.</p>
          <p id="coachContextLabel" class="text-[10px] font-bold text-brand-yellow mt-2 uppercase tracking-wide">Reputation · Script</p>
          <button type="button" id="coachResetBtn" class="mt-2 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:underline">New conversation</button>
        </div>
        <div id="coachMessages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3 text-sm min-h-[10rem] max-h-[min(40vh,18rem)] custom-scrollbar"></div>
        <div id="coachRefinedWrap" class="hidden px-4 pb-2 shrink-0">
          <div class="rounded-xl border border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/5 p-3">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow mb-2">Suggested script</p>
            <pre id="coachRefinedText" class="text-xs text-brand-dark dark:text-slate-200 whitespace-pre-wrap font-sans max-h-32 overflow-y-auto"></pre>
            <button type="button" id="coachApplyBtn" class="mt-2 w-full btn-pill bg-brand-yellow text-brand-dark text-[10px] font-black uppercase tracking-widest py-2">Apply to this section</button>
          </div>
        </div>
        <div class="p-4 border-t border-brand-border dark:border-white/10 shrink-0 mt-auto">
          <textarea id="coachInput" rows="2" placeholder="e.g. Make this shorter and more casual…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 text-brand-dark dark:text-slate-100 text-sm px-3 py-2 resize-none focus:ring-2 focus:ring-brand-yellow outline-none"></textarea>
          <button type="button" id="coachSendBtn" class="mt-2 w-full btn-pill bg-brand-dark dark:bg-white dark:text-slate-900 text-white text-[10px] font-black uppercase tracking-widest py-3">Send</button>
          <p id="coachError" class="hidden mt-2 text-xs text-red-600 dark:text-red-400"></p>
        </div>
      </div>

      <div class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden">
        <div class="px-6 py-4 border-b border-brand-border dark:border-white/10 flex items-center justify-between flex-wrap gap-2">
          <h3 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Saved snippets</h3>
          <p class="text-[10px] font-bold text-brand-muted uppercase tracking-widest">Workspace library (DB)</p>
        </div>
        <div id="scriptLibraryEmpty" class="px-6 py-10 text-center text-sm text-brand-muted">No saved scripts yet. Edit an offer script above and click <strong class="text-brand-dark dark:text-white">Save</strong>.</div>
        <ul id="scriptLibraryList" class="divide-y divide-brand-border/50 dark:divide-white/10 hidden"></ul>
      </div>
    </div>

    <aside class="flex flex-col gap-4 min-w-0 xl:sticky xl:top-24 xl:self-start xl:max-h-[calc(100vh-5.5rem)] xl:overflow-y-auto custom-scrollbar">
      <div class="brand-card dark:bg-slate-900 dark:border-white/10 p-4 shrink-0">
        <h3 class="font-display font-extrabold text-sm text-brand-dark dark:text-white">Merge tags & preview</h3>
        <p class="text-[10px] text-brand-muted font-medium mt-1">Fill a sample lead, then click a tag to insert it at the cursor in the script box (or use preview as-is).</p>
        <div class="mt-3 grid grid-cols-1 gap-2">
          <label class="block text-[10px] font-black uppercase tracking-wider text-brand-muted">Name
            <input type="text" id="mergePreviewName" value="Jordan Lee" autocomplete="off" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 text-sm text-brand-dark dark:text-slate-100 px-3 py-2 focus:ring-2 focus:ring-brand-yellow outline-none" />
          </label>
          <label class="block text-[10px] font-black uppercase tracking-wider text-brand-muted">Company
            <input type="text" id="mergePreviewCompany" value="Northside Home Services" autocomplete="off" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 text-sm text-brand-dark dark:text-slate-100 px-3 py-2 focus:ring-2 focus:ring-brand-yellow outline-none" />
          </label>
          <label class="block text-[10px] font-black uppercase tracking-wider text-brand-muted">City
            <input type="text" id="mergePreviewCity" value="Austin" autocomplete="off" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 text-sm text-brand-dark dark:text-slate-100 px-3 py-2 focus:ring-2 focus:ring-brand-yellow outline-none" />
          </label>
        </div>
        <div class="mt-3 flex flex-wrap gap-2" id="mergeTagPills" aria-label="Insert merge tags">
          <button type="button" class="merge-tag-pill px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide border border-brand-border dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 hover:border-brand-yellow/70 text-brand-dark dark:text-slate-100 transition-colors" data-tag="{{name}}">{{name}}</button>
          <button type="button" class="merge-tag-pill px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide border border-brand-border dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 hover:border-brand-yellow/70 text-brand-dark dark:text-slate-100 transition-colors" data-tag="{{company}}">{{company}}</button>
          <button type="button" class="merge-tag-pill px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide border border-brand-border dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 hover:border-brand-yellow/70 text-brand-dark dark:text-slate-100 transition-colors" data-tag="{{city}}">{{city}}</button>
        </div>
        <div class="mt-4 rounded-xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-black/20 p-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Preview <span id="mergePreviewContext" class="text-brand-dark dark:text-white font-bold normal-case tracking-normal">—</span></p>
          <pre id="mergePreviewOut" class="text-xs leading-relaxed whitespace-pre-wrap font-sans text-brand-dark dark:text-slate-200 max-h-40 overflow-y-auto custom-scrollbar">—</pre>
        </div>
      </div>

      <% if (typeof PERSONAS !== 'undefined' && PERSONAS && PERSONAS.length) { %>
      <div class="brand-card dark:bg-slate-900 dark:border-white/10 p-4 shrink-0" aria-labelledby="persona-lenses-heading">
        <h3 id="persona-lenses-heading" class="font-display font-extrabold text-sm text-brand-dark dark:text-white">Workflow lenses</h3>
        <p class="text-[10px] text-brand-muted font-medium mt-1 leading-relaxed">Optional mental models — jump to the tool each lens maps to. Scripts stay the same.</p>
        <ul class="mt-3 space-y-2">
          <% PERSONAS.forEach((p) => { %>
            <li>
              <a href="<%= p.href %>" class="flex items-center gap-3 rounded-xl border border-brand-border/50 dark:border-white/10 px-3 py-2.5 hover:border-brand-yellow/60 hover:bg-brand-yellow/5 transition-colors group">
                <span class="w-9 h-9 rounded-xl bg-gradient-to-br <%= p.color %> flex items-center justify-center text-white font-display font-black text-sm shadow shrink-0"><%= p.name[0] %></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-xs font-bold text-brand-dark dark:text-white"><%= p.name %> — <%= p.role %></span>
                  <span class="block text-[10px] font-black uppercase tracking-wider text-brand-yellow mt-0.5"><%= p.hrefLabel %></span>
                </span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

    </aside>
  </div>

  <p class="mt-8 text-center text-[11px] text-brand-muted max-w-2xl mx-auto">
    Script coach uses your configured AI provider (same as lead insights). Edited blocks and saved library entries persist on the server for this workspace.
  </p>
</section>

<script>
  (function () {
    var LIB_KEY_LEGACY = 'adhello_persona_script_library_v1';
    var sectionLabels = {
      opening: 'Script',
      discovery: 'Discovery',
      valueProp: 'Value proposition',
      objectionHandling: 'Objection handling',
      close: 'Close',
    };
    var serviceLabels = <%- JSON.stringify(typeof scriptServiceLabels !== 'undefined' ? scriptServiceLabels : {}) %>;
    var libraryItems = <%- JSON.stringify(typeof initialScriptLibraryItems !== 'undefined' && initialScriptLibraryItems ? initialScriptLibraryItems : []) %>;

    var coachFocus = { pitch: '<%= SCRIPT_LIBRARY_KEYS[0] %>', section: 'opening' };
    var coachHistories = {};
    var pendingRefined = null;
    var blockSaveTimer = null;
    var lastFocusedSnippetId = 'snippet-' + coachFocus.pitch + '-' + coachFocus.section;
    var lastServerSaveAt = null;
    var saveStatusTimer = null;

    function coachKey() {
      return coachFocus.pitch + ':' + coachFocus.section;
    }

    function snippetEl() {
      return document.getElementById('snippet-' + coachFocus.pitch + '-' + coachFocus.section);
    }

    function statusElForSnippetId(sid) {
      return document.querySelector('.script-autosave-status[data-snippet-id="' + sid + '"]');
    }

    function setAutosaveTextForAll(text) {
      document.querySelectorAll('.script-autosave-status').forEach(function (el) {
        el.textContent = text;
      });
    }

    function formatSavedAgo() {
      if (!lastServerSaveAt) return 'Saved';
      var s = Math.floor((Date.now() - lastServerSaveAt) / 1000);
      if (s < 2) return 'Saved · just now';
      if (s < 60) return 'Saved · ' + s + 's ago';
      var m = Math.floor(s / 60);
      if (m < 60) return 'Saved · ' + m + 'm ago';
      var h = Math.floor(m / 60);
      return 'Saved · ' + h + 'h ago';
    }

    function refreshSavedAgoLabels() {
      if (!lastServerSaveAt) return;
      setAutosaveTextForAll(formatSavedAgo());
    }

    function scheduleSaveStatusTick() {
      clearInterval(saveStatusTimer);
      saveStatusTimer = setInterval(refreshSavedAgoLabels, 10000);
    }

    function updateCoachLabel() {
      var el = document.getElementById('coachContextLabel');
      if (!el) return;
      var sLab = serviceLabels[coachFocus.pitch] || coachFocus.pitch;
      var pLab = sectionLabels[coachFocus.section] || coachFocus.section;
      el.textContent = sLab + ' · ' + pLab;
    }

    function coachMessagesEl() {
      return document.getElementById('coachMessages');
    }

    function appendCoachBubble(role, text) {
      var box = coachMessagesEl();
      if (!box) return;
      var wrap = document.createElement('div');
      wrap.className = role === 'user'
        ? 'ml-6 rounded-2xl rounded-tr-md bg-brand-cream/80 dark:bg-slate-800 px-3 py-2 text-brand-dark dark:text-slate-100'
        : 'mr-6 rounded-2xl rounded-tl-md bg-brand-dark/5 dark:bg-white/5 border border-brand-border/40 dark:border-white/10 px-3 py-2 text-brand-dark dark:text-slate-200';
      wrap.textContent = text;
      box.appendChild(wrap);
      box.scrollTop = box.scrollHeight;
    }

    function clearCoachMessagesUi() {
      var box = coachMessagesEl();
      if (box) box.innerHTML = '';
    }

    function appendCoachScriptPreview(scriptText) {
      var box = coachMessagesEl();
      if (!box) return;
      var wrap = document.createElement('div');
      wrap.className =
        'mr-2 rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/10 px-3 py-3 text-brand-dark dark:text-slate-100';
      var label = document.createElement('p');
      label.className = 'text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2';
      label.textContent = 'Current script';
      var body = document.createElement('pre');
      body.className =
        'text-xs leading-relaxed whitespace-pre-wrap font-sans text-brand-dark dark:text-slate-200 max-h-52 overflow-y-auto custom-scrollbar';
      body.textContent = (scriptText && String(scriptText).trim()) ? scriptText : '(empty — type in the box on the left)';
      wrap.appendChild(label);
      wrap.appendChild(body);
      box.appendChild(wrap);
      box.scrollTop = box.scrollHeight;
    }

    function hideRefined() {
      pendingRefined = null;
      var w = document.getElementById('coachRefinedWrap');
      if (w) w.classList.add('hidden');
    }

    function showRefined(text) {
      pendingRefined = text;
      var w = document.getElementById('coachRefinedWrap');
      var pre = document.getElementById('coachRefinedText');
      if (w && pre) {
        pre.textContent = text;
        w.classList.remove('hidden');
      }
    }

    function applyMergeToText(raw) {
      var nameEl = document.getElementById('mergePreviewName');
      var coEl = document.getElementById('mergePreviewCompany');
      var cityEl = document.getElementById('mergePreviewCity');
      var name = nameEl ? nameEl.value : '';
      var company = coEl ? coEl.value : '';
      var city = cityEl ? cityEl.value : '';
      var s = String(raw || '');
      s = s.split('{{name}}').join(name);
      s = s.split('{{company}}').join(company);
      s = s.split('{{city}}').join(city);
      return s;
    }

    function updateMergePreview() {
      var out = document.getElementById('mergePreviewOut');
      var ctx = document.getElementById('mergePreviewContext');
      var ta = document.getElementById(lastFocusedSnippetId);
      if (!ta) ta = snippetEl();
      if (ctx && ta && ta.id) {
        var m = /^snippet-(.+)-opening$/.exec(ta.id);
        if (m) {
          var sLab = serviceLabels[m[1]] || m[1];
          ctx.textContent = '— ' + sLab;
        }
      }
      if (!out) return;
      var raw = ta ? ta.value : '';
      out.textContent = raw ? applyMergeToText(raw) : '—';
    }

    function insertAtCursor(textarea, text) {
      if (!textarea) return;
      var start = textarea.selectionStart != null ? textarea.selectionStart : textarea.value.length;
      var end = textarea.selectionEnd != null ? textarea.selectionEnd : textarea.value.length;
      var v = textarea.value;
      textarea.value = v.slice(0, start) + text + v.slice(end);
      var pos = start + text.length;
      if (textarea.setSelectionRange) textarea.setSelectionRange(pos, pos);
      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function composeOfferScriptFromSections(sections) {
      if (!sections || typeof sections !== 'object') return '';
      var parts = [];
      ['opening', 'discovery', 'valueProp', 'objectionHandling', 'close'].forEach(function (section) {
        var t = String(sections[section] || '').trim();
        if (t) parts.push(t);
      });
      return parts.join('\n\n');
    }

    function collectBlocksPayload() {
      var blocks = {};
      document.querySelectorAll('.script-snippet').forEach(function (ta) {
        var id = ta.id || '';
        var m = /^snippet-(.+)-opening$/.exec(id);
        if (!m) return;
        blocks[m[1]] = {
          opening: ta.value,
          discovery: '',
          valueProp: '',
          objectionHandling: '',
          close: '',
        };
      });
      return blocks;
    }

    function scheduleBlocksPersist() {
      clearTimeout(blockSaveTimer);
      blockSaveTimer = setTimeout(function () {
        setAutosaveTextForAll('Saving…');
        fetch('/workspace/scripts/blocks', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ blocks: collectBlocksPayload() }),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.success) {
              console.warn('[scripts] block save failed', d && d.error);
              setAutosaveTextForAll('Save failed — retry by editing');
              return;
            }
            lastServerSaveAt = Date.now();
            setAutosaveTextForAll(formatSavedAgo());
            scheduleSaveStatusTick();
          })
          .catch(function () {
            console.warn('[scripts] block save failed');
            setAutosaveTextForAll('Save failed — retry by editing');
          });
      }, 1500);
    }

    function applyBlockOverridesToEditors(blockOverrides) {
      if (!blockOverrides || typeof blockOverrides !== 'object') return;
      Object.keys(blockOverrides).forEach(function (serviceKey) {
        var sections = blockOverrides[serviceKey];
        if (!sections || typeof sections !== 'object') return;
        var ta = document.getElementById('snippet-' + serviceKey + '-opening');
        if (!ta) return;
        ta.value = composeOfferScriptFromSections(sections);
      });
    }

    function syncScriptsFromServer() {
      return fetch('/workspace/scripts.json', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || !data.success) return;
          applyBlockOverridesToEditors(data.blockOverrides || {});
          if (Array.isArray(data.libraryItems)) {
            libraryItems = data.libraryItems;
            renderLibrary();
          }
          lastServerSaveAt = Date.now();
          setAutosaveTextForAll(formatSavedAgo());
          scheduleSaveStatusTick();
          updateMergePreview();
        })
        .catch(function () {});
    }

    function migrateLegacyLocalLibrary() {
      if (libraryItems.length) return;
      try {
        var raw = localStorage.getItem(LIB_KEY_LEGACY);
        if (!raw) return;
        var data = JSON.parse(raw);
        if (!data || !Array.isArray(data.items) || !data.items.length) return;
        fetch('/workspace/scripts/library/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: data.items }),
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (res && res.success) {
              localStorage.removeItem(LIB_KEY_LEGACY);
              libraryItems = res.libraryItems || libraryItems;
              renderLibrary();
            }
          })
          .catch(function () {});
      } catch (e) {}
    }

    function renderLibrary() {
      var list = document.getElementById('scriptLibraryList');
      var empty = document.getElementById('scriptLibraryEmpty');
      if (!list || !empty) return;
      if (!libraryItems.length) {
        list.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      list.classList.remove('hidden');
      list.innerHTML = '';
      libraryItems.slice().reverse().forEach(function (item) {
        var li = document.createElement('li');
        li.className = 'px-6 py-4 flex flex-col sm:flex-row sm:items-start gap-3';
        var meta = document.createElement('div');
        meta.className = 'flex-1 min-w-0';
        var title = document.createElement('div');
        title.className = 'font-bold text-brand-dark dark:text-white text-sm';
        title.textContent = item.title || 'Saved script';
        var sub = document.createElement('div');
        sub.className = 'text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-1';
        sub.textContent = (item.savedAt || '').slice(0, 16).replace('T', ' ');
        var body = document.createElement('pre');
        body.className = 'mt-2 text-xs text-brand-muted dark:text-slate-300 whitespace-pre-wrap font-sans max-h-24 overflow-y-auto';
        body.textContent = item.text || '';
        meta.appendChild(title);
        meta.appendChild(sub);
        meta.appendChild(body);
        var actions = document.createElement('div');
        actions.className = 'flex flex-row sm:flex-col gap-2 shrink-0';
        var copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'px-3 py-1.5 rounded-lg text-[10px] font-black uppercase border border-brand-border dark:border-white/10 hover:border-brand-yellow/50';
        copyBtn.textContent = 'Copy';
        copyBtn.addEventListener('click', function () {
          navigator.clipboard.writeText(item.text || '');
          copyBtn.textContent = 'Copied';
          setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1500);
        });
        var delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-3 py-1.5 rounded-lg text-[10px] font-black uppercase text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/50';
        delBtn.textContent = 'Delete';
        delBtn.addEventListener('click', function () {
          fetch('/workspace/scripts/library/' + encodeURIComponent(item.id), { method: 'DELETE' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data || !data.success) return;
              libraryItems = data.libraryItems || [];
              renderLibrary();
            })
            .catch(function () {});
        });
        actions.appendChild(copyBtn);
        actions.appendChild(delBtn);
        li.appendChild(meta);
        li.appendChild(actions);
        list.appendChild(li);
      });
    }

    function activatePitchTab(pitch) {
      document.querySelectorAll('.pitch-tab').forEach(function (t) {
        var active = t.getAttribute('data-pitch') === pitch;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.classList.toggle('bg-brand-yellow', active);
        t.classList.toggle('text-brand-dark', active);
        t.classList.toggle('shadow-sm', active);
        t.classList.toggle('bg-white', !active);
        t.classList.toggle('dark:bg-slate-800', !active);
        t.classList.toggle('border', !active);
        t.classList.toggle('border-brand-border', !active);
        t.classList.toggle('dark:border-white/10', !active);
        t.classList.toggle('text-brand-muted', !active);
      });
      document.querySelectorAll('.pitch-panel').forEach(function (p) {
        p.classList.toggle('hidden', p.getAttribute('data-panel') !== pitch);
      });
    }

    document.querySelectorAll('.pitch-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var pitch = tab.getAttribute('data-pitch');
        activatePitchTab(pitch);
        coachFocus.pitch = pitch;
        updateCoachLabel();
        hideRefined();
        lastFocusedSnippetId = 'snippet-' + coachFocus.pitch + '-opening';
        updateMergePreview();
      });
    });

    function openCoachForBlock(pitch, section) {
      coachFocus.pitch = pitch;
      coachFocus.section = section || 'opening';
      lastFocusedSnippetId = 'snippet-' + pitch + '-opening';
      activatePitchTab(pitch);
      updateCoachLabel();
      coachHistories[coachKey()] = [];
      clearCoachMessagesUi();
      var ta = document.getElementById('snippet-' + pitch + '-opening');
      appendCoachScriptPreview(ta ? ta.value : '');
      hideRefined();
      var errEl = document.getElementById('coachError');
      if (errEl) errEl.classList.add('hidden');
      var coachCard = document.getElementById('sales-scripts-coach');
      if (coachCard) coachCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (ta) ta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      var input = document.getElementById('coachInput');
      if (input) setTimeout(function () { input.focus(); }, 250);
      updateMergePreview();
    }

    document.querySelectorAll('.use-in-coach').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openCoachForBlock(btn.getAttribute('data-pitch'), btn.getAttribute('data-section'));
      });
    });

    document.querySelectorAll('.copy-snippet').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-copy-target');
        var el = document.getElementById(id);
        if (!el) return;
        var text = el.value != null ? el.value : el.textContent;
        navigator.clipboard.writeText(text || '').then(function () {
          var t = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = t; }, 1500);
        });
      });
    });

    document.querySelectorAll('.save-to-library').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-snippet');
        var ta = document.getElementById(id);
        if (!ta) return;
        var block = ta.closest('.script-block');
        var sk = block ? block.getAttribute('data-service') : '';
        var sec = block ? block.getAttribute('data-section') : '';
        var text = (ta.value || '').trim();
        if (!text) return alert('Nothing to save.');
        var title = (serviceLabels[sk] || sk) + ' · Script';
        var orig = btn.textContent;
        btn.disabled = true;
        fetch('/workspace/scripts/library', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text, title: title, serviceKey: sk, section: sec }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            btn.disabled = false;
            if (!data || !data.success) {
              alert((data && data.error) || 'Save failed');
              return;
            }
            libraryItems = data.libraryItems || libraryItems;
            renderLibrary();
            btn.textContent = 'Saved';
            setTimeout(function () { btn.textContent = orig; }, 1500);
          })
          .catch(function () {
            btn.disabled = false;
            alert('Save failed');
          });
      });
    });

    function getCoachHistoryArray() {
      var k = coachKey();
      if (!coachHistories[k]) coachHistories[k] = [];
      return coachHistories[k];
    }

    document.getElementById('coachResetBtn').addEventListener('click', function () {
      coachHistories[coachKey()] = [];
      var box = coachMessagesEl();
      if (box) box.innerHTML = '';
      hideRefined();
      document.getElementById('coachError').classList.add('hidden');
    });

    document.getElementById('coachApplyBtn').addEventListener('click', function () {
      if (!pendingRefined) return;
      var ta = snippetEl();
      if (ta) ta.value = pendingRefined;
      hideRefined();
      scheduleBlocksPersist();
      updateMergePreview();
    });

    async function coachSend() {
      var input = document.getElementById('coachInput');
      var errEl = document.getElementById('coachError');
      if (!input || !input.value.trim()) return;
      errEl.classList.add('hidden');
      var msg = input.value.trim();
      input.value = '';
      appendCoachBubble('user', msg);
      var ta = snippetEl();
      var scriptText = ta ? ta.value : '';
      var hist = getCoachHistoryArray().map(function (m) { return { role: m.role, content: m.content }; });
      var btn = document.getElementById('coachSendBtn');
      btn.disabled = true;
      btn.textContent = '…';
      try {
        var res = await fetch('/sales/scripts/refine', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            serviceKey: coachFocus.pitch,
            section: coachFocus.section,
            scriptText: scriptText,
            userMessage: msg,
            chatHistory: hist
          })
        });
        var data = await res.json();
        if (!data.success) {
          errEl.textContent = data.error || 'Request failed';
          errEl.classList.remove('hidden');
          return;
        }
        appendCoachBubble('assistant', data.reply || '');
        getCoachHistoryArray().push({ role: 'user', content: msg });
        getCoachHistoryArray().push({ role: 'assistant', content: data.reply || '' });
        if (data.refinedScript) showRefined(data.refinedScript);
        else hideRefined();
      } catch (e) {
        errEl.textContent = 'Network error';
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send';
      }
    }

    document.getElementById('coachSendBtn').addEventListener('click', coachSend);
    document.getElementById('coachInput').addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        coachSend();
      }
    });

    document.querySelectorAll('.script-snippet').forEach(function (ta) {
      ta.addEventListener('input', function () {
        lastFocusedSnippetId = ta.id;
        var st = statusElForSnippetId(ta.id);
        if (st) st.textContent = 'Unsaved';
        scheduleBlocksPersist();
        updateMergePreview();
      });
      ta.addEventListener('focus', function () {
        lastFocusedSnippetId = ta.id;
        updateMergePreview();
      });
    });

    ['mergePreviewName', 'mergePreviewCompany', 'mergePreviewCity'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', updateMergePreview);
    });

    document.querySelectorAll('.merge-tag-pill').forEach(function (pill) {
      pill.addEventListener('click', function () {
        var tag = pill.getAttribute('data-tag') || '';
        var ta = document.getElementById(lastFocusedSnippetId) || snippetEl();
        insertAtCursor(ta, tag);
        updateMergePreview();
      });
    });

    migrateLegacyLocalLibrary();
    updateCoachLabel();
    updateMergePreview();
    renderLibrary();
    syncScriptsFromServer();
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) syncScriptsFromServer();
    });
  })();
</script>
