<% const _cobrand = !flooring && !joinName; %>
<% if (_cobrand) { %>
<div class="fa-brand fa-brand--cobrand">
  <span class="fa-brand__lockup" role="img" aria-label="AdHello × Homeelk">
    <img class="fa-brand__mark" src="/images/adhello-app-icon.png" alt="" width="40" height="40" />
    <span class="fa-brand__name">AdHello</span>
    <span class="fa-brand__x" aria-hidden="true">×</span>
    <img class="fa-brand__homeelk" src="/images/homeelk-logo.png?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" alt="" />
  </span>
</div>
<% } else { %>
<a class="fa-brand" href="https://adhello.io" rel="noopener">
  <img src="/images/adhello-app-icon.png" alt="Reviews App" width="40" height="40" />
  <div>
    <strong>Reviews App</strong>
    <span><%= joinName ? ('Join ' + joinName) : (flooring ? 'Flooring partners' : 'Pay-per-performance') %></span>
  </div>
</a>
<% } %>
