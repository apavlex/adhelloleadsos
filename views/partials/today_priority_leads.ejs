<% const _pri = typeof priorityLeads !== 'undefined' && priorityLeads ? priorityLeads : null; %>
<% if (_pri) { %>
<% const _cols = [
  { key: 'added', label: 'Added by you', bucket: _pri.added, empty: 'Leads you add yourself show up here.' },
  { key: 'follow', label: 'Needs follow-up', bucket: _pri.followUp, empty: 'Callbacks and follow-ups you scheduled.' },
  { key: 'replied', label: 'Responded', bucket: _pri.responded, empty: 'SMS and email replies.' },
  { key: 'referral', label: 'Referrals', bucket: _pri.referrals, empty: 'Tag a lead referral, or add one yourself.' },
]; %>
<section class="mb-8 md:mb-10 rounded-[2rem] border-2 border-brand-yellow/55 bg-white dark:bg-slate-900/90 shadow-lg shadow-brand-yellow/10 overflow-hidden" aria-label="Important leads">
  <div class="px-5 sm:px-6 md:px-8 pt-5 sm:pt-6 pb-4 border-b border-brand-border/40 dark:border-white/10">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Primary</p>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white leading-tight">Important leads</h2>
    <p class="text-sm text-brand-muted mt-1">People you added, follow-ups, replies, and referrals — ahead of the cadence queue.</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-border/40 dark:bg-white/10">
    <% _cols.forEach(function (col) { %>
    <div class="bg-white dark:bg-slate-900 px-5 sm:px-6 py-5">
      <div class="flex items-baseline justify-between gap-2 mb-3">
        <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white"><%= col.label %></h3>
        <span class="text-xs font-bold tabular-nums text-brand-muted"><%= col.bucket && col.bucket.count ? col.bucket.count : 0 %></span>
      </div>
      <% const _items = col.bucket && col.bucket.items ? col.bucket.items : []; %>
      <% if (!_items.length) { %>
      <p class="text-sm text-brand-muted leading-relaxed"><%= col.empty %></p>
      <% } else { %>
      <ul class="space-y-2.5">
        <% _items.forEach(function (row) { %>
        <li>
          <a href="<%= row.href %>" class="block min-w-0 group">
            <span class="block text-sm font-bold text-brand-dark dark:text-white truncate group-hover:text-brand-yellow"><%= row.title %></span>
            <% if (row.detail) { %><span class="block text-[11px] text-brand-muted truncate"><%= row.detail %></span><% } %>
          </a>
        </li>
        <% }); %>
      </ul>
      <% if (col.bucket.count > _items.length && col.bucket.href) { %>
      <a href="<%= col.bucket.href %>" class="inline-block mt-3 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">See all <%= col.bucket.count %></a>
      <% } %>
      <% } %>
    </div>
    <% }); %>
  </div>
</section>
<% } %>
