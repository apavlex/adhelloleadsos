<% const _isMobileNav = typeof navVariant !== 'undefined' && navVariant === 'mobile'; %>
<% const np = typeof navPrimary !== 'undefined' ? navPrimary : (typeof activePage !== 'undefined' ? activePage : ''); %>
<% const _lt = typeof navLeadsTab !== 'undefined' ? navLeadsTab : ''; %>
<% const _leadsOpen = !!_lt; %>
<% const _can = typeof navCan === 'function' ? navCan : function () { return true; }; %>
  <nav class="<%= _isMobileNav ? 'px-1 pb-2' : 'flex-1 px-2 pb-2' %> sidebar-primary-nav" aria-label="<%= _isMobileNav ? 'Mobile primary' : 'Primary' %>">
    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label sr-only">Quick actions</p>
      <div class="sidebar-nav-group-items">
        <% if (user) { %>
        <div class="sidebar-new" data-sidebar-new>
          <button type="button" class="sidebar-nav-link sidebar-add-lead w-full text-left" data-sidebar-new-toggle aria-expanded="false" aria-controls="sidebarNewMenu<%= _isMobileNav ? 'Mobile' : '' %>" title="Add an opportunity or send a referral">
            <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            <span>Add New</span>
            <svg class="sidebar-new-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="sidebar-new-menu" id="sidebarNewMenu<%= _isMobileNav ? 'Mobile' : '' %>" hidden>
            <button type="button" id="<%= _isMobileNav ? 'manualLeadOpenMobile' : 'manualLeadOpenSidebar' %>" class="sidebar-nav-link sidebar-new-item w-full text-left" title="Add Opportunity">
              <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
              <span>Opportunity</span>
            </button>
            <a href="/network?tab=send" class="sidebar-nav-link sidebar-new-item" title="Send a referral to a network partner" data-open-send-referral>
              <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>
              <span>Referral</span>
            </a>
          </div>
        </div>
        <% } %>
        <% if (_can('chat')) { %>
        <a href="/chat" class="sidebar-nav-link <%= np === 'chat' ? 'active' : '' %>" title="Ask AI — chat with Alex, saved chat history">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>
          <span>Ask AI</span>
        </a>
        <% } %>
        <% if (_can('today')) { %>
        <a href="/today" class="sidebar-nav-link <%= np === 'today' ? 'active' : '' %>" title="Today">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
          <span>Today</span>
        </a>
        <% } %>
      </div>
    </div>

    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label">Sales</p>
      <div class="sidebar-nav-group-items">
        <% if (_can('opportunities')) { %>
        <a href="/opportunities" class="sidebar-nav-link <%= np === 'opportunities' ? 'active' : '' %>" title="Opportunity pipelines">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5M3.75 12h16.5M3.75 18h16.5M6 6v.01M6 12v.01M6 18v.01" /></svg>
          <span>Opportunities</span>
        </a>
        <% } %>
        <% if (_can('leads')) { %>
        <details class="sidebar-leads-details group"<%= _leadsOpen ? ' open' : '' %>>
          <summary class="sidebar-nav-link sidebar-leads-summary list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden <%= _lt ? 'active' : '' %>" title="Leads">
            <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" /></svg>
            <span>Leads</span>
            <svg class="sidebar-leads-chevron w-3.5 h-3.5 shrink-0 text-[#9CA3AF] ml-auto transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <nav class="sidebar-leads-sub mt-0.5 ml-2 pl-3 space-y-0.5 pb-1" aria-label="Leads sections">
            <a href="/leads/find" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'find' ? 'active' : '' %>" title="Find leads">Find</a>
            <a href="/prospecting?tab=queue" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'queue' ? 'active' : '' %>" title="Scheduled queue">Queue</a>
            <a href="/pipeline" data-nav-prefetch="/prospecting?tab=pipeline" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'pipeline' ? 'active' : '' %>" title="Pipeline board">Pipeline</a>
            <a href="/prospecting?tab=folders" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'folders' ? 'active' : '' %>" title="Lead folders">Folders</a>
            <a href="/history" class="sidebar-nav-link sidebar-nav-sub <%= _lt === 'history' ? 'active' : '' %>" title="Search history">Search history</a>
          </nav>
        </details>
        <% } %>
        <% if (_can('automate')) { %>
        <a href="/ceo" class="sidebar-nav-link <%= np === 'ceo' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
          <span>Automate</span>
        </a>
        <% } %>
        <% if (_can('tasks')) { %>
        <a href="/tasks" class="sidebar-nav-link <%= np === 'tasks' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span>Tasks</span>
        </a>
        <% } %>
        <% if (_can('activity')) { %>
        <a href="/activity" class="sidebar-nav-link <%= np === 'activity' || np === 'team-history' || np === 'messages' ? 'active' : '' %>" title="Recent notes, calls, updates, team history and sent messages">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" /></svg>
          <span>Activity</span>
        </a>
        <% } %>
        <% if (_can('engagement')) { %>
        <a href="/engagement" class="sidebar-nav-link <%= np === 'engagement' ? 'active' : '' %>" title="Engagement inbox — warm signals">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          <span>Engagement</span>
        </a>
        <% } %>
      </div>
    </div>

    <% if (_can('network') || _can('referrals') || _can('appointments')) { %>
    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label">Referrals</p>
      <div class="sidebar-nav-group-items">
        <% if (_can('network')) { %>
        <a href="/network" class="sidebar-nav-link <%= np === 'network' ? 'active' : '' %>" title="Referral network — seats, members, referrals">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" /></svg>
          <span>Network</span>
        </a>
        <% } %>
        <% if (_can('referrals')) { %>
        <a href="/referrals" class="sidebar-nav-link <%= np === 'referrals' ? 'active' : '' %>" title="Referral partners">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          <span>Referral Partners</span>
        </a>
        <% } %>
        <% if (_can('appointments')) { %>
        <a href="/appointments" class="sidebar-nav-link <%= np === 'appointments' ? 'active' : '' %>" title="Appointment packages — sell slots, send leads, sync GHL">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
          <span>Appointments</span>
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (_can('direct-mail') || _can('social-posts') || _can('fb-groups')) { %>
    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label">Marketing</p>
      <div class="sidebar-nav-group-items">
        <% if (_can('direct-mail')) { %>
        <a href="/direct-mail" class="sidebar-nav-link <%= np === 'direct-mail' ? 'active' : '' %>" title="Marketing Studio — ads and direct mail">
          <%- include('/partials/icon_postcard', { iconClass: 'sidebar-nav-icon', strokeWidth: '1.75' }) %>
          <span>Marketing Studio</span>
        </a>
        <% } %>
        <% if (_can('social-posts')) { %>
        <a href="/social-posts" class="sidebar-nav-link <%= np === 'social-posts' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
          <span>Social Posts</span>
        </a>
        <% } %>
        <% if (_can('fb-groups')) { %>
        <a href="/fb-groups" class="sidebar-nav-link <%= np === 'fb-groups' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          <span>FB Groups</span>
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label">Insights &amp; tools</p>
      <div class="sidebar-nav-group-items">
        <% if (_can('reports')) { %>
        <a href="/reports" class="sidebar-nav-link <%= np === 'reports' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
          <span>Reports</span>
        </a>
        <% } %>
        <% if (_can('resources')) { %>
        <a href="/resources" class="sidebar-nav-link <%= np === 'resources' ? 'active' : '' %>">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
          <span>Resources</span>
        </a>
        <% } %>
        <% if (typeof ghlDashboardUrl !== 'undefined' && ghlDashboardUrl) { %>
        <a href="<%= ghlDashboardUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          <span>GHL</span>
        </a>
        <% } %>
        <% if (typeof hermesWebUiUrl !== 'undefined' && hermesWebUiUrl) { %>
        <a href="<%= hermesWebUiUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link">
          <svg class="sidebar-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V8.25" /></svg>
          <span>AI Chat</span>
        </a>
        <% } %>
      </div>
    </div>

    <% const _menuLinks = typeof customMenuLinks !== 'undefined' && Array.isArray(customMenuLinks) ? customMenuLinks : []; %>
    <% const _menuPath = typeof requestPath !== 'undefined' ? requestPath : ''; %>
    <% if (_menuLinks.length) { %>
    <div class="sidebar-nav-group">
      <p class="sidebar-nav-group-label sr-only">Links</p>
      <div class="sidebar-nav-group-items">
        <% _menuLinks.forEach(function (link) { %>
        <% if (link.open === 'tab') { %>
        <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link" title="<%= link.label %> (new tab)">
          <%- include('/partials/menu_link_icon', { icon: link.icon, label: link.label }) %>
          <span><%= link.label %></span>
        </a>
        <% } else { %>
        <a href="/menu/<%= link.id %>" class="sidebar-nav-link <%= _menuPath === '/menu/' + link.id ? 'active' : '' %>" title="<%= link.label %>">
          <%- include('/partials/menu_link_icon', { icon: link.icon, label: link.label }) %>
          <span><%= link.label %></span>
        </a>
        <% } %>
        <% }); %>
      </div>
    </div>
    <% } %>
  </nav>
