<% const _fbSeeds = typeof armsReachFacebookSeeds !== 'undefined' && armsReachFacebookSeeds ? armsReachFacebookSeeds : []; %>
<% const _referralSeed = typeof armsReachReferralSeed !== 'undefined' ? armsReachReferralSeed : ''; %>
<% const _ownerPh = typeof armsReachDefaultOwner !== 'undefined' ? armsReachDefaultOwner : 'Russ'; %>
<% const _referrerPh = typeof armsReachDefaultReferrer !== 'undefined' ? armsReachDefaultReferrer : 'Bright Electric'; %>
<% const _refDemo = _referralSeed.replace(/\{\{ownerName\}\}/g, _ownerPh).replace(/\{\{referrerName\}\}/g, _referrerPh); %>

<section id="arms-reach" class="scroll-mt-28 mb-10" aria-label="Arm's Reach scripts">
  <div class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden">
    <div class="px-5 py-4 md:px-6 md:py-5 border-b border-brand-border/30 dark:border-white/10 flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="arms-reach-icon arms-reach-icon--hot" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </span>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">LMV method</p>
        </div>
        <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white">Arm's Reach scripts</h2>
        <p class="text-sm text-brand-muted dark:text-slate-400 mt-1 max-w-2xl">Facebook post scripts + referral follow-up — with AI regeneration. Post on your personal profile, not a business page.</p>
      </div>
    </div>

    <div class="p-4 md:p-6 space-y-8">
      <!-- Facebook posts -->
      <div>
        <div class="flex items-start gap-3 mb-4">
          <span class="arms-reach-icon arms-reach-icon--cold shrink-0 mt-0.5" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </span>
          <div>
            <h3 class="font-display font-bold text-base text-brand-dark dark:text-white">Arm's Reach Facebook post</h3>
            <p class="text-xs text-brand-muted dark:text-slate-400 mt-1">Tap your network for referrals. Hit <strong class="text-brand-dark dark:text-white">Regenerate</strong> for a fresh AI variation in the same voice.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <% [0, 1].forEach(function (vi) {
            var seed = _fbSeeds[vi] || '';
            var versionNum = vi + 1;
          %>
          <article class="arms-reach-version rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-950/40 overflow-hidden" data-fb-version="<%= versionNum %>">
            <div class="flex items-center justify-between gap-2 px-4 py-2.5 border-b border-brand-border/40 dark:border-white/10 bg-white/50 dark:bg-slate-900/50">
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Version <%= versionNum %></span>
              <div class="flex items-center gap-1.5">
                <button type="button" class="js-arms-fb-regen inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider bg-brand-dark text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity" data-version="<%= versionNum %>">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  Regenerate
                </button>
                <button type="button" class="js-arms-fb-copy inline-flex items-center rounded-lg px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/50 transition-colors" data-version="<%= versionNum %>">Copy</button>
              </div>
            </div>
            <textarea id="armsReachFb<%= versionNum %>" rows="6" class="arms-reach-script-input w-full text-sm leading-relaxed text-brand-dark dark:text-slate-200 bg-transparent px-4 py-3 font-sans resize-y min-h-[8rem] border-0 focus:ring-0 outline-none" aria-label="Facebook post version <%= versionNum %>"><%= seed %></textarea>
          </article>
          <% }); %>
        </div>

        <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 dark:bg-amber-950/30 px-4 py-3 flex gap-3 items-start">
          <span class="arms-reach-icon arms-reach-icon--warm shrink-0 w-8 h-8" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 00-5 11.7V17a1 1 0 001 1h8a1 1 0 001-1v-3.3A7 7 0 0012 2z"/></svg>
          </span>
          <p class="text-xs text-amber-950 dark:text-amber-100/90 leading-relaxed"><strong>Tip:</strong> Post one version every 2–3 weeks. To exclude specific people (like your boss), use Facebook's audience selector → <strong>All Friends Except</strong> before posting.</p>
        </div>
      </div>

      <!-- Referral follow-up -->
      <div class="pt-6 border-t border-brand-border/30 dark:border-white/10">
        <div class="flex items-start gap-3 mb-4">
          <span class="arms-reach-icon arms-reach-icon--cold shrink-0 mt-0.5" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </span>
          <div>
            <h3 class="font-display font-bold text-base text-brand-dark dark:text-white">Referral follow-up message</h3>
            <p class="text-xs text-brand-muted dark:text-slate-400 mt-1">When someone from your network refers you to a business owner — fill in the names and let AI craft a natural message.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
          <label class="block">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Business owner name</span>
            <input type="text" id="armsReachOwnerName" autocomplete="off" value="<%= _ownerPh %>" class="mt-1.5 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800/80 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white focus:ring-2 focus:ring-brand-yellow outline-none" placeholder="e.g. Russ" />
          </label>
          <label class="block">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Referrer name</span>
            <input type="text" id="armsReachReferrerName" autocomplete="off" value="<%= _referrerPh %>" class="mt-1.5 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800/80 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white focus:ring-2 focus:ring-brand-yellow outline-none" placeholder="e.g. Bright Electric" />
          </label>
        </div>

        <button type="button" id="armsReachReferralRegen" class="btn-pill btn-primary inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest px-5 py-2.5 mb-4">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Regenerate message
        </button>

        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 dark:bg-emerald-950/20 overflow-hidden">
          <div class="flex items-center justify-between gap-2 px-4 py-2.5 border-b border-emerald-500/20">
            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-700 dark:text-emerald-300">Your message</span>
            <button type="button" id="armsReachReferralCopy" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-muted hover:text-brand-dark dark:hover:text-white transition-colors">Copy</button>
          </div>
          <textarea id="armsReachReferralMessage" rows="3" class="arms-reach-script-input w-full text-sm leading-relaxed text-brand-dark dark:text-slate-200 bg-transparent px-4 py-3 font-sans resize-y min-h-[4.5rem] border-0 focus:ring-0 outline-none" aria-label="Referral follow-up message"><%= _refDemo %></textarea>
        </div>
      </div>

      <p id="armsReachStatus" class="hidden text-[11px] font-semibold" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';
  var LS = {
    fb1: 'adhello_arms_reach_fb1',
    fb2: 'adhello_arms_reach_fb2',
    owner: 'adhello_arms_reach_owner',
    referrer: 'adhello_arms_reach_referrer',
    referral: 'adhello_arms_reach_referral',
  };

  function $(id) { return document.getElementById(id); }
  function fbEl(v) { return $('armsReachFb' + v); }

  function loadSaved() {
    try {
      [1, 2].forEach(function (v) {
        var key = v === 1 ? LS.fb1 : LS.fb2;
        var saved = localStorage.getItem(key);
        var el = fbEl(v);
        if (saved && el) el.value = saved;
      });
      var owner = localStorage.getItem(LS.owner);
      var referrer = localStorage.getItem(LS.referrer);
      var referral = localStorage.getItem(LS.referral);
      if (owner && $('armsReachOwnerName')) $('armsReachOwnerName').value = owner;
      if (referrer && $('armsReachReferrerName')) $('armsReachReferrerName').value = referrer;
      if (referral && $('armsReachReferralMessage')) $('armsReachReferralMessage').value = referral;
    } catch (_) {}
  }

  function persist() {
    try {
      if (fbEl(1)) localStorage.setItem(LS.fb1, fbEl(1).value);
      if (fbEl(2)) localStorage.setItem(LS.fb2, fbEl(2).value);
      if ($('armsReachOwnerName')) localStorage.setItem(LS.owner, $('armsReachOwnerName').value);
      if ($('armsReachReferrerName')) localStorage.setItem(LS.referrer, $('armsReachReferrerName').value);
      if ($('armsReachReferralMessage')) localStorage.setItem(LS.referral, $('armsReachReferralMessage').value);
    } catch (_) {}
  }

  function status(msg, ok) {
    var el = $('armsReachStatus');
    if (!el) return;
    if (!msg) { el.classList.add('hidden'); el.textContent = ''; return; }
    el.textContent = msg;
    el.classList.remove('hidden', 'text-emerald-600', 'text-rose-600', 'dark:text-emerald-300', 'dark:text-rose-300');
    el.classList.add(ok ? 'text-emerald-600' : 'text-rose-600', ok ? 'dark:text-emerald-300' : 'dark:text-rose-300');
    clearTimeout(status._t);
    status._t = setTimeout(function () { status('', true); }, 3200);
  }

  async function apiPost(url, body) {
    var res = await fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body || {}),
    });
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok && !data.error) data.error = 'Request failed';
    return data;
  }

  async function copyText(text) {
    var t = String(text || '').trim();
    if (!t) return false;
    try {
      await navigator.clipboard.writeText(t);
      return true;
    } catch (_) {
      var ta = document.createElement('textarea');
      ta.value = t;
      document.body.appendChild(ta);
      ta.select();
      var ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    }
  }

  document.querySelectorAll('.js-arms-fb-regen').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var v = btn.getAttribute('data-version') || '1';
      var el = fbEl(v);
      if (!el) return;
      btn.disabled = true;
      status('Generating variation…', true);
      try {
        var data = await apiPost('/sales/arms-reach/regenerate-facebook', {
          currentText: el.value,
          versionLabel: 'Version ' + v,
        });
        if (!data.success || !data.script) throw new Error(data.error || 'Could not regenerate');
        el.value = data.script;
        persist();
        status('New variation ready', true);
      } catch (err) {
        status(err.message || 'Regenerate failed', false);
      } finally {
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('.js-arms-fb-copy').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var v = btn.getAttribute('data-version') || '1';
      var el = fbEl(v);
      if (!el) return;
      var ok = await copyText(el.value);
      status(ok ? 'Copied to clipboard' : 'Nothing to copy', ok);
    });
  });

  var refBtn = $('armsReachReferralRegen');
  if (refBtn) {
    refBtn.addEventListener('click', async function () {
      var owner = ($('armsReachOwnerName') && $('armsReachOwnerName').value) || '';
      var referrer = ($('armsReachReferrerName') && $('armsReachReferrerName').value) || '';
      var msgEl = $('armsReachReferralMessage');
      if (!owner.trim() || !referrer.trim()) {
        status('Enter both names first', false);
        return;
      }
      refBtn.disabled = true;
      status('Crafting message…', true);
      try {
        var data = await apiPost('/sales/arms-reach/regenerate-referral', {
          ownerName: owner.trim(),
          referrerName: referrer.trim(),
          currentText: msgEl ? msgEl.value : '',
        });
        if (!data.success || !data.script) throw new Error(data.error || 'Could not regenerate');
        if (msgEl) msgEl.value = data.script;
        persist();
        status('Message updated', true);
      } catch (err) {
        status(err.message || 'Regenerate failed', false);
      } finally {
        refBtn.disabled = false;
      }
    });
  }

  var refCopy = $('armsReachReferralCopy');
  if (refCopy) {
    refCopy.addEventListener('click', async function () {
      var msgEl = $('armsReachReferralMessage');
      var ok = await copyText(msgEl && msgEl.value);
      status(ok ? 'Copied to clipboard' : 'Nothing to copy', ok);
    });
  }

  [1, 2].forEach(function (v) {
    var el = fbEl(v);
    if (el) el.addEventListener('input', persist);
  });
  ['armsReachOwnerName', 'armsReachReferrerName', 'armsReachReferralMessage'].forEach(function (id) {
    var el = $(id);
    if (el) el.addEventListener('input', persist);
  });

  loadSaved();
})();
</script>
