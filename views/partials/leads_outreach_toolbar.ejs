<% const _toolbarLeads = typeof leads !== 'undefined' && leads ? leads : []; %>
<% const _toolbarCount = _toolbarLeads.length; %>
<% if (_toolbarCount > 0) { %>
<% const _tbFolder = typeof activeFolderKey !== 'undefined' && activeFolderKey
  ? (typeof folders !== 'undefined' && folders ? folders.find(function (f) { return f && String(f.key) === String(activeFolderKey); }) : null)
  : null; %>
<% const _tbTitle = _tbFolder && _tbFolder.name ? _tbFolder.name : 'Pipeline leads'; %>
<% const _tbLf = typeof leadListFilters !== 'undefined' && leadListFilters ? leadListFilters : (typeof _lf !== 'undefined' ? _lf : {}); %>
<% const _tbSub = _tbLf.q ? String(_tbLf.q) : (_tbFolder ? 'Outreach folder' : 'Main pipeline (unfiled)'); %>
<div id="leadsOutreachToolbar" class="brand-card dark:bg-slate-900 dark:border-white/10 mb-6 overflow-hidden" data-lead-count="<%= _toolbarCount %>" aria-label="Lead list actions">
  <div class="px-4 py-3 md:px-5 md:py-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="min-w-0 flex items-start gap-3">
      <a href="/prospecting?tab=folders" class="shrink-0 inline-flex items-center gap-1 rounded-lg border border-brand-border/50 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/40 transition-colors" title="Back to vault folders">← Vault</a>
      <div class="min-w-0">
        <h3 class="font-display font-bold text-lg md:text-xl text-brand-dark dark:text-white truncate"><%= _tbTitle %></h3>
        <p class="text-[11px] font-semibold text-brand-muted dark:text-slate-400 truncate mt-0.5"><%= _tbSub %> · <span id="leadsToolbarCount"><%= _toolbarCount %></span> lead<%= _toolbarCount === 1 ? '' : 's' %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <button type="button" class="js-add-outreach-list inline-flex items-center gap-2 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-dark/90 dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:border-brand-yellow/40 transition-colors" data-outreach-list="call" title="Tag selected leads (or all in view) for calling">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        Add to Call List
      </button>
      <button type="button" class="js-add-outreach-list inline-flex items-center gap-2 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-dark/90 dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:border-brand-yellow/40 transition-colors" data-outreach-list="email" title="Tag selected leads (or all in view) for email">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        Add to Email List
      </button>
      <button type="button" class="js-add-outreach-list inline-flex items-center gap-2 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-dark/90 dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:border-brand-yellow/40 transition-colors" data-outreach-list="doubleTap" title="Tag selected leads (or all in view) for double tap">
        <span class="text-sm leading-none" aria-hidden="true">🎯</span>
        Add to Double Tap List
      </button>
      <button type="button" class="js-toolbar-push-ghl inline-flex items-center gap-2 rounded-xl border border-orange-500/50 bg-orange-500/15 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-orange-200 hover:bg-orange-500/25 transition-colors" title="Push selected leads (or all in view) to Go High Level">
        <span aria-hidden="true">⚡</span>
        GHL (<span class="js-toolbar-ghl-count"><%= _toolbarCount %></span>)
      </button>
      <button type="button" class="js-bulk-export-csv inline-flex items-center gap-2 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-dark/90 dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:border-brand-yellow/40 transition-colors" title="Export selected leads (or all in view) as CSV">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
        CSV
      </button>
    </div>
  </div>
  <p id="leadsOutreachToolbarMsg" class="hidden px-5 pb-3 text-[11px] font-semibold" role="status" aria-live="polite"></p>
</div>
<% } %>
