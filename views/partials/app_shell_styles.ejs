<style id="appShellStyles">
  #appSidebar { display: none; }
  :root { --app-sidebar-width: 13.5rem; }
  @media (min-width: 768px) {
    body:has(#appSidebar) {
      display: grid;
      grid-template-columns: var(--app-sidebar-width) minmax(0, 1fr);
      min-height: 100vh;
      transition: grid-template-columns 0.22s ease;
    }
    body:has(#appSidebar).sidebar-collapsed { --app-sidebar-width: 4.25rem; }
    body:has(#appSidebar).sidebar-hidden { --app-sidebar-width: 0px; }
    body:has(#appSidebar) #appSidebar {
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: start;
      display: flex;
      flex-direction: column;
      width: var(--app-sidebar-width);
      min-width: var(--app-sidebar-width);
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow-x: hidden;
      overflow-y: auto;
      z-index: 40;
      flex-shrink: 0;
      border-right: 1px solid var(--brand-border);
      background: rgba(255, 255, 255, 0.95);
    }
    html.dark body:has(#appSidebar) #appSidebar {
      background: rgba(15, 23, 42, 0.95);
      border-right-color: rgba(255, 255, 255, 0.1);
    }
    body:has(#appSidebar).sidebar-hidden #appSidebar {
      opacity: 0;
      pointer-events: none;
      transform: translateX(-100%);
    }
    body:has(#appSidebar) .app-shell-content {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      width: 100%;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }
    body:has(#appSidebar) .app-shell-content > main {
      flex: 1 1 auto;
      width: 100%;
      min-width: 0;
    }
    body:has(#appSidebar) .app-shell-top { width: 100%; flex-shrink: 0; }
    body:has(#appSidebar) #appTopbar { min-width: 0; width: 100%; }
  }
  .sidebar-nav-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-muted);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .sidebar-nav-link:hover {
    background: rgba(253, 224, 71, 0.08);
    color: var(--brand-dark);
  }
  html.dark .sidebar-nav-link:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .sidebar-nav-link.active {
    background: rgba(253, 224, 71, 0.18);
    color: var(--brand-dark);
    font-weight: 700;
  }
  html.dark .sidebar-nav-link.active { color: #fff; background: rgba(253, 224, 71, 0.12); }
  .sidebar-nav-link.sidebar-nav-cta {
    margin: 0.25rem 0;
    background: var(--brand-yellow);
    color: #111827;
    font-weight: 800;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sidebar-nav-link.sidebar-nav-cta:hover { background: #facc15; color: #111827; }
  .sidebar-nav-link.sidebar-nav-sub { font-size: 0.8125rem; padding-left: 0.875rem; }
</style>
