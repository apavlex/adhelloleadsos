<div>
  <label for="findReScraper" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Property scraper</label>
  <select id="findReScraper" name="scraper" class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold">
    <option value="auto"<%= typeof scraper === 'undefined' || !scraper || scraper === 'auto' ? ' selected' : '' %>>Auto (Apify Zillow → Oxylabs fallback)</option>
    <option value="apify_zillow"<%= scraper === 'apify_zillow' ? ' selected' : '' %>>Apify Zillow only</option>
    <option value="oxylabs"<%= scraper === 'oxylabs' ? ' selected' : '' %>>Oxylabs only</option>
  </select>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div>
    <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Min price</label>
    <input type="number" name="minPrice" min="0" step="1000" placeholder="Optional" value="<%= typeof minPrice !== 'undefined' && minPrice !== '' ? minPrice : '' %>"
      class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold" />
  </div>
  <div>
    <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Max price</label>
    <input type="number" name="maxPrice" min="0" step="1000" placeholder="Optional" value="<%= typeof maxPrice !== 'undefined' && maxPrice !== '' ? maxPrice : '' %>"
      class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold" />
  </div>
</div>
<p class="text-[11px] text-brand-muted leading-relaxed">
  Uses Apify Zillow scraper by default, with Oxylabs fallback when configured. Override actor via <code class="text-[10px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">APIFY_REAL_ESTATE_ACTOR_ID</code>.
</p>
