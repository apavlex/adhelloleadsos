<%# Root-relative include: requires app.set('view options', { root: views }) in server.js %>
<%- include('/partials/lead_detail_panel', {
  scriptLibraryOfferPicklist: Array.isArray(locals.scriptLibraryOfferPicklist) ? locals.scriptLibraryOfferPicklist : [],
  sequenceTemplates: (typeof sequenceTemplates !== 'undefined' && Array.isArray(sequenceTemplates))
    ? sequenceTemplates
    : (Array.isArray(locals.sequenceTemplates) ? locals.sequenceTemplates : [])
}) %>

<script>
  window.ADHELLO_SERVICE_OFFERS = <%- JSON.stringify(Array.isArray(locals.scriptLibraryOfferPicklist) ? locals.scriptLibraryOfferPicklist : []) %>;
  window.__ADHELLO_OUTREACH_LIBRARY__ = <%- JSON.stringify(locals.outreachChannelLibrary && typeof locals.outreachChannelLibrary === 'object' ? locals.outreachChannelLibrary : {}) %>;
  window.ADHELLO_SEQUENCE_TEMPLATES = <%- JSON.stringify(
    (typeof sequenceTemplates !== 'undefined' && Array.isArray(sequenceTemplates))
      ? sequenceTemplates
      : (typeof locals !== 'undefined' && Array.isArray(locals.sequenceTemplates) ? locals.sequenceTemplates : [])
  ) %>;
</script>

<script>
  window.INITIAL_SAVED_LEADS = <%- JSON.stringify(leads || []) %>;
  window.PIPELINE_STAGE_LABELS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.name; return m; }, {})) %>;
  window.PIPELINE_STAGE_COLORS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.color || '#94a3b8'; return m; }, {})) %>;
  window.WORKSPACE_FOLDERS = <%- JSON.stringify(typeof folders !== 'undefined' && folders ? folders.map((f) => ({ key: f.key, name: f.name })) : []) %>;
  window.WORKSPACE_TAGS = <%- JSON.stringify(typeof tags !== 'undefined' && tags ? tags.map((t) => ({ key: t.key, name: t.name, color: t.color || '#94a3b8' })) : []) %>;
  window.PROSPECTING_ACTIVE_FOLDER_KEY = <%- JSON.stringify(typeof activeFolderKey !== 'undefined' && activeFolderKey ? String(activeFolderKey) : '') %>;
</script>

<!-- Email outreach: service lines + AI recommendation -->
<%- include('/partials/email_intel_modal') %>

<!-- Cold call war room: high-contrast panel, script tabs, notes, primary dial in footer -->
<div id="warRoomModal" class="fixed inset-0 z-[500] hidden overflow-hidden" role="dialog" aria-modal="true" aria-labelledby="warRoomTitle">
  <div class="absolute inset-0 bg-slate-950/92 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>
  <div class="absolute inset-0 flex flex-col p-3 sm:p-6 md:p-8 text-slate-100">
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-4 sm:mb-5 relative z-10 shrink-0">
          <div class="min-w-0">
              <h2 id="warRoomTitle" class="font-display font-black text-2xl sm:text-3xl md:text-4xl text-white tracking-tight drop-shadow-sm">Cold call war room</h2>
              <p class="text-slate-300 font-bold uppercase tracking-[0.2em] text-xs mt-1">Cold leads only · one business at a time</p>
              <p class="text-slate-400 text-[11px] font-semibold mt-2 normal-case tracking-normal">Keyboard: <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 font-mono text-[10px] border border-slate-600">←</kbd> <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 font-mono text-[10px] border border-slate-600">→</kbd> previous / next · <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 font-mono text-[10px] border border-slate-600">Space</kbd> next (click outside script / notes)</p>
          </div>
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
              <div class="flex items-center gap-2 rounded-2xl border border-slate-600/80 bg-slate-800/90 px-3 py-2 sm:px-4 shadow-lg">
                  <span class="text-[9px] font-black uppercase tracking-widest text-slate-400 shrink-0">Session</span>
                  <span id="warRoomTimerDisplay" class="font-mono text-lg sm:text-xl font-black text-amber-300 tabular-nums shrink-0" aria-live="polite">00:00</span>
                  <button type="button" id="warRoomTimerToggle" class="text-[9px] font-black uppercase tracking-widest px-2.5 py-1.5 rounded-lg bg-slate-700 text-white hover:bg-slate-600 border border-slate-500/50 transition-colors shrink-0">Pause</button>
                  <button type="button" id="warRoomTimerReset" class="text-[9px] font-black uppercase tracking-widest px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-600 transition-colors shrink-0">Reset</button>
              </div>
              <a href="/today" id="warRoomExitDashboard" class="inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-amber-400/70 bg-amber-400 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-900 hover:bg-amber-300 transition-colors shrink-0 shadow-lg shadow-amber-500/20">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                  Exit to dashboard
              </a>
              <button type="button" id="closeWarRoom" class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-800 text-slate-200 flex items-center justify-center hover:bg-rose-600 hover:text-white transition-all border border-slate-600 shrink-0" aria-label="Close war room">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
          </div>
      </div>
      <div id="warRoomStage" class="flex flex-col flex-1 min-h-0 relative z-10 pb-[7.5rem] sm:pb-32">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3 shrink-0">
          <div class="flex items-center gap-2">
            <button type="button" id="warRoomPrev" class="inline-flex items-center gap-2 rounded-xl border-2 border-slate-500 bg-slate-800 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white hover:bg-slate-700 transition-colors disabled:opacity-35 disabled:pointer-events-none shadow-md" aria-label="Previous lead">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
              Previous
            </button>
            <button type="button" id="warRoomNext" class="inline-flex items-center gap-2 rounded-xl border-2 border-slate-500 bg-slate-800 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white hover:bg-slate-700 transition-colors disabled:opacity-35 disabled:pointer-events-none shadow-md" aria-label="Next lead">
              Next
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
          <p id="warRoomPosition" class="text-sm font-black tabular-nums text-amber-300 shrink-0 drop-shadow-sm" aria-live="polite">—</p>
        </div>
        <div id="warRoomGrid" class="overflow-y-auto flex-1 min-h-0 custom-scrollbar pr-1 rounded-2xl border border-slate-700/80 bg-slate-900/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/70 shadow-inner" tabindex="-1">
            <!-- Single card injected via JS -->
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none p-3 sm:p-6 md:p-8 pt-12 bg-gradient-to-t from-slate-950 via-slate-950/95 to-transparent">
          <div class="pointer-events-auto flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:justify-between gap-3 sm:gap-4 rounded-2xl border-2 border-slate-600 bg-slate-900/95 px-4 py-3 sm:px-5 sm:py-4 shadow-2xl backdrop-blur-md">
              <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                  <div class="text-2xl md:text-3xl font-display font-black text-white tabular-nums shrink-0" id="warRoomTotal">0</div>
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-tight">Cold leads<br>in this session</div>
              </div>
              <div class="flex flex-col sm:items-end gap-1 min-w-0 flex-1 sm:flex-initial sm:max-w-[70%]">
                <span class="text-[9px] font-black uppercase tracking-widest text-slate-500 sm:text-right">Primary number — tap to dial</span>
                <a href="#" id="warRoomPrimaryDial" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 px-4 py-3 sm:py-3.5 text-base sm:text-lg font-black tracking-tight shadow-lg shadow-emerald-900/40 border-2 border-emerald-300 transition-colors min-h-[3rem] w-full sm:w-auto text-center">
                  <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  <span id="warRoomPrimaryDialLabel">—</span>
                </a>
                <p id="warRoomAltPhones" class="text-[10px] text-slate-500 sm:text-right hidden"></p>
              </div>
              <div class="flex flex-col gap-2 min-w-0 sm:min-w-[18rem]">
                <div class="flex items-center gap-2">
                  <label for="warRoomDialInterval" class="text-[9px] font-black uppercase tracking-widest text-slate-500">Auto dial sec</label>
                  <input id="warRoomDialInterval" type="number" min="5" max="120" step="1" value="12" class="w-20 rounded-lg bg-slate-800 border border-slate-600 px-2 py-1 text-xs font-bold text-white" />
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" id="warRoomAutoDialStart" class="px-3 py-2 rounded-xl bg-emerald-500 text-slate-950 text-[10px] font-black uppercase tracking-widest hover:bg-emerald-400 transition-colors">Start auto dial</button>
                  <button type="button" id="warRoomAutoDialPause" class="px-3 py-2 rounded-xl bg-slate-700 text-white text-[10px] font-black uppercase tracking-widest hover:bg-slate-600 transition-colors">Pause</button>
                  <button type="button" id="warRoomAutoDialStop" class="px-3 py-2 rounded-xl bg-rose-600 text-white text-[10px] font-black uppercase tracking-widest hover:bg-rose-500 transition-colors">Stop</button>
                </div>
                <p id="warRoomAutoDialStatus" class="text-[10px] text-slate-400 leading-tight">Auto dialer idle.</p>
              </div>
          </div>
          <div class="pointer-events-auto mt-2 rounded-2xl border border-slate-700/90 bg-slate-900/95 px-4 py-3 shadow-2xl">
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-500 mb-2">Session summary</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 text-[10px]">
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Dialed</span><p id="warRoomSumDialed" class="font-black text-white">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Connected</span><p id="warRoomSumConnected" class="font-black text-emerald-300">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">VM drops</span><p id="warRoomSumVm" class="font-black text-violet-300">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">No answer</span><p id="warRoomSumNoAnswer" class="font-black text-slate-200">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Gatekeeper</span><p id="warRoomSumGatekeeper" class="font-black text-amber-300">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Wrong #</span><p id="warRoomSumWrong" class="font-black text-rose-300">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Callbacks</span><p id="warRoomSumCallback" class="font-black text-blue-300">0</p></div>
              <div class="rounded-lg bg-slate-800/90 border border-slate-700 px-2 py-1.5"><span class="text-slate-400">Failures</span><p id="warRoomSumFailures" class="font-black text-rose-300">0</p></div>
            </div>
            <p id="warRoomSummaryHint" class="mt-2 text-[10px] text-slate-500">Running totals for this war room session.</p>
          </div>
      </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 8px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
</style>

<!-- Website Preview Tooltip -->
  <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
    <div class="bg-gray-100 dark:bg-slate-800 px-3 py-2 border-b border-gray-200 dark:border-white/5 flex items-center gap-2">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
      </div>
      <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
      <a id="previewNewTabBtn" href="#" target="_blank" class="text-[10px] text-brand-dark dark:text-slate-100 hover:text-brand-yellow flex items-center gap-1 font-bold tracking-wider transition-colors">
         OPEN <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
    <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
      <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
         <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
      </div>
      <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
    </div>
  </div>

<%- include('/partials/footer') %>
