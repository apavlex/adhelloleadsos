<%# Root-relative include: requires app.set('view options', { root: views }) in server.js %>
<%- include('/partials/lead_detail_panel') %>

<script>
  window.INITIAL_SAVED_LEADS = <%- JSON.stringify(leads || []) %>;
  window.PIPELINE_STAGE_LABELS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.name; return m; }, {})) %>;
  window.WORKSPACE_FOLDERS = <%- JSON.stringify(typeof folders !== 'undefined' && folders ? folders.map((f) => ({ key: f.key, name: f.name })) : []) %>;
</script>

<!-- Email outreach: service lines + AI recommendation -->
<div id="emailIntelModal" class="fixed inset-0 z-[280] hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-brand-dark/75 backdrop-blur-sm email-intel-backdrop" aria-hidden="true"></div>
  <div class="absolute inset-0 flex items-start justify-center p-4 pt-16 md:pt-24 pointer-events-none">
    <div class="pointer-events-auto w-full max-w-md bg-white dark:bg-slate-900 rounded-[2rem] border border-brand-border/30 dark:border-white/10 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="p-6 border-b border-brand-border/20 dark:border-white/10 flex items-start justify-between gap-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400">Outreach intel</p>
          <h3 id="emailIntelTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mt-1 leading-tight">Company</h3>
        </div>
        <button type="button" class="email-intel-close w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center shrink-0" aria-label="Close">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto custom-scrollbar flex-1 space-y-6">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-3">What we offer <span class="font-medium normal-case tracking-normal text-brand-muted/70">· tap to open email</span></p>
          <div id="emailIntelOfferList" class="grid grid-cols-1 gap-2 text-xs font-semibold">
            <a href="#" data-offer-idx="0" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Website &amp; conversion (CRO, speed, rebuilds)</a>
            <a href="#" data-offer-idx="1" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Reputation &amp; reviews (GEO, listings)</a>
            <a href="#" data-offer-idx="2" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Social &amp; content systems</a>
            <a href="#" data-offer-idx="3" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Paid ads &amp; media management</a>
            <a href="#" data-offer-idx="4" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> AI automation &amp; agents</a>
            <a href="#" data-offer-idx="5" class="email-intel-offer-link flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-cream/50 dark:bg-white/5 border border-brand-border/15 hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/10 text-brand-dark dark:text-slate-200 transition-colors cursor-pointer"><span class="text-brand-yellow shrink-0">●</span> Strategy &amp; consulting retainers</a>
          </div>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-3">AI recommended for this lead</p>
          <div id="emailIntelAiBody" class="text-sm text-brand-muted dark:text-slate-400 leading-relaxed min-h-[4rem]">
            Loading…
          </div>
        </div>
      </div>
      <div class="p-6 pt-0 flex flex-col sm:flex-row gap-3">
        <button type="button" id="emailIntelMailto" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest disabled:opacity-40 disabled:pointer-events-none">
          Open email client
        </button>
        <button type="button" class="email-intel-close flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<!-- The War Room: Batch Outreach Modal -->
<div id="warRoomModal" class="fixed inset-0 z-[300] hidden overflow-hidden">
  <div class="absolute inset-0 bg-brand-dark/90 backdrop-blur-md transition-opacity"></div>
  <div class="absolute inset-0 flex flex-col p-4 md:p-8">
      <!-- War Room Header -->
      <div class="flex items-center justify-between mb-8 relative z-10">
          <div>
              <h2 class="font-display font-black text-4xl text-white tracking-tight">The War Room</h2>
              <p class="text-brand-muted font-bold uppercase tracking-[0.2em] text-xs">Batch Personalized Outreach</p>
          </div>
          <button id="closeWarRoom" class="w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-rose-500 transition-all border border-white/10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
      </div>
      <!-- War Room Content (Scrollable Grid) -->
      <div id="warRoomGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 overflow-y-auto pb-20 custom-scrollbar pr-2 relative z-10">
          <!-- Cards will be injected via JS -->
      </div>
      <!-- War Room Footer Stats -->
      <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-brand-dark to-transparent pointer-events-none z-20">
          <div class="flex items-center gap-6 pointer-events-auto">
              <div class="bg-white/5 border border-white/10 rounded-2xl px-6 py-4 flex items-center gap-4">
                  <div class="text-3xl font-display font-black text-white" id="warRoomTotal">0</div>
                  <div class="text-[10px] font-bold text-brand-muted uppercase tracking-widest leading-tight">Leads in<br>Queue</div>
              </div>
          </div>
      </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 8px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
</style>

<!-- Website Preview Tooltip -->
  <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
    <div class="bg-gray-100 dark:bg-slate-800 px-3 py-2 border-b border-gray-200 dark:border-white/5 flex items-center gap-2">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
      </div>
      <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
      <a id="previewNewTabBtn" href="#" target="_blank" class="text-[10px] text-brand-dark dark:text-slate-100 hover:text-brand-yellow flex items-center gap-1 font-bold tracking-wider transition-colors">
         OPEN <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
    <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
      <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
         <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
      </div>
      <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
    </div>
  </div>

<%- include('/partials/footer') %>
