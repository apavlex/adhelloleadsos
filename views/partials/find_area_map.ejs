<% if (typeof googleMapsKey === 'string' && googleMapsKey) { %>
<div class="w-full border-b border-brand-border/15 dark:border-white/10" aria-label="Map area picker">
  <div class="flex flex-col gap-4 px-5 pt-6 pb-4 sm:px-7 sm:pt-7">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Step 1 · Area</p>
        <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white mt-1">Choose the area</h2>
        <p class="text-sm text-brand-muted mt-1 max-w-xl">Pan or zoom the map, then set area from map.</p>
      </div>
      <button type="button" id="applyMapLocationBtn" class="shrink-0 w-full sm:w-auto px-5 py-3 rounded-full text-[10px] font-black uppercase tracking-widest bg-white dark:bg-slate-900 text-brand-dark dark:text-white border-2 border-brand-dark dark:border-brand-yellow shadow-md hover:shadow-lg hover:border-brand-yellow dark:hover:border-brand-yellow ring-2 ring-brand-yellow/70 ring-offset-2 ring-offset-white dark:ring-offset-slate-950 transition-shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2">
        Set area from map
      </button>
    </div>
  </div>
  <div class="relative w-full border-t border-b border-brand-border/20 dark:border-white/10">
    <div id="findAreaMap" class="w-full h-[min(340px,48vh)] min-h-[220px] sm:h-[min(400px,52vh)] sm:min-h-[280px] bg-brand-cream/20 dark:bg-slate-800/40" role="application" aria-label="Google Map — drag to choose search area"></div>
    <div class="pointer-events-none absolute inset-0 z-10 flex flex-col justify-between p-3 sm:p-4">
      <div class="pointer-events-auto flex flex-col gap-2 sm:flex-row sm:items-center sm:max-w-xl">
        <div class="rounded-full border border-brand-border/40 dark:border-white/15 bg-white/90 dark:bg-slate-900/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-muted">
          Pan or zoom here → applies to search
        </div>
        <label for="findAreaMapSearch" class="sr-only">Search city or address on map</label>
        <div class="flex flex-1 min-w-0 rounded-2xl border-2 border-brand-dark/20 dark:border-white/20 bg-white/95 dark:bg-slate-900/95 shadow-lg backdrop-blur-sm overflow-hidden focus-within:border-brand-yellow focus-within:ring-2 focus-within:ring-brand-yellow/40">
          <input type="search" id="findAreaMapSearch" autocomplete="off" placeholder="Search city, neighborhood, or address…" class="min-w-0 flex-1 border-0 bg-transparent px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted focus:outline-none focus:ring-0" />
          <button type="button" id="findAreaMapSearchBtn" class="shrink-0 px-4 py-3 text-[10px] font-black uppercase tracking-widest bg-brand-yellow text-brand-dark hover:brightness-105 active:scale-[0.98] transition-all border-l border-brand-dark/10 dark:border-white/10">
            Go
          </button>
        </div>
      </div>
      <div class="pointer-events-none flex justify-end pb-1">
        <div class="pointer-events-auto flex flex-col overflow-hidden rounded-2xl border-2 border-brand-dark/25 dark:border-white/20 bg-white/95 dark:bg-slate-900/95 shadow-lg">
          <button type="button" id="findAreaMapZoomIn" class="flex h-11 w-11 items-center justify-center text-xl font-black leading-none text-brand-dark dark:text-white hover:bg-brand-yellow/20 border-b border-brand-border/40 dark:border-white/10 transition-colors" aria-label="Zoom in">+</button>
          <button type="button" id="findAreaMapZoomOut" class="flex h-11 w-11 items-center justify-center text-xl font-black leading-none text-brand-dark dark:text-white hover:bg-brand-yellow/20 transition-colors" aria-label="Zoom out">−</button>
        </div>
      </div>
    </div>
  </div>
  <p id="findAreaMapStatus" class="text-[12px] text-brand-muted px-5 sm:px-7 py-3 min-h-[2.75rem] border-b border-brand-border/10 dark:border-white/5" aria-live="polite"></p>
</div>
<script>
  window.__MAP_DEFAULT__ = {
    lat: <%= typeof mapDefaultLat !== 'undefined' ? mapDefaultLat : 45.5152 %>,
    lng: <%= typeof mapDefaultLng !== 'undefined' ? mapDefaultLng : -122.6784 %>,
    zoom: <%= typeof mapDefaultZoom !== 'undefined' ? mapDefaultZoom : 11 %>
  };
  function initFindAreaMap() {
    var el = document.getElementById('findAreaMap');
    var btn = document.getElementById('applyMapLocationBtn');
    var statusEl = document.getElementById('findAreaMapStatus');
    if (!el || !window.google || !google.maps) return;
    var d = window.__MAP_DEFAULT__ || { lat: 45.5152, lng: -122.6784, zoom: 11 };
    var map = new google.maps.Map(el, {
      center: { lat: d.lat, lng: d.lng },
      zoom: d.zoom,
      mapTypeControl: true,
      mapTypeControlOptions: {
        position: google.maps.ControlPosition.TOP_RIGHT
      },
      zoomControl: false,
      streetViewControl: false,
      fullscreenControl: true,
      fullscreenControlOptions: {
        position: google.maps.ControlPosition.TOP_RIGHT
      }
    });
    window.__findAreaMap = map;
    var geocoder = new google.maps.Geocoder();
    var searchInput = document.getElementById('findAreaMapSearch');
    var searchBtn = document.getElementById('findAreaMapSearchBtn');
    var zoomInBtn = document.getElementById('findAreaMapZoomIn');
    var zoomOutBtn = document.getElementById('findAreaMapZoomOut');
    function setStatus(msg) { if (statusEl) statusEl.textContent = msg || ''; }
    function parseCityStateFromGeocodeResult(result) {
      var city = '';
      var state = '';
      var comps = (result && result.address_components) || [];
      for (var i = 0; i < comps.length; i++) {
        var t = comps[i].types || [];
        if (t.indexOf('locality') >= 0) city = comps[i].long_name;
        if (t.indexOf('administrative_area_level_1') >= 0) state = comps[i].short_name || '';
      }
      if (!city) {
        for (var j = 0; j < comps.length; j++) {
          var t2 = comps[j].types || [];
          if (t2.indexOf('sublocality') >= 0 || t2.indexOf('neighborhood') >= 0) {
            city = comps[j].long_name;
            break;
          }
        }
      }
      return {
        city: city || '',
        state: (state || '').slice(0, 2).toUpperCase()
      };
    }
    function writeSearchFormLocation(city, state) {
      var cityIn = document.querySelector('#searchForm input[name="city"]');
      var stateIn = document.querySelector('#searchForm input[name="state"]');
      if (cityIn) cityIn.value = city || '';
      if (stateIn) stateIn.value = state || '';
    }
    function runMapSearch() {
      var q = searchInput && String(searchInput.value || '').trim();
      if (!q) {
        setStatus('Type a city or address, then tap Go.');
        return;
      }
      setStatus('Searching…');
      geocoder.geocode({ address: q }, function (results, gStatus) {
        if (gStatus !== 'OK' || !results || !results[0]) {
          setStatus('No results — try another spelling or be more specific.');
          return;
        }
        var first = results[0];
        var g = first.geometry;
        if (g.viewport) {
          map.fitBounds(g.viewport);
        } else if (g.location) {
          map.setCenter(g.location);
          map.setZoom(11);
        }
        var loc = parseCityStateFromGeocodeResult(first);
        writeSearchFormLocation(loc.city, loc.state);
        setStatus(
          (loc.city || loc.state)
            ? 'Location set to ' + (loc.city || '—') + ', ' + (loc.state || '—') + '. Pan or zoom if needed, then Set area from map to override.'
            : 'Map updated — zoom to a neighborhood or use Set area from map to set city/state.'
        );
      });
    }
    if (searchBtn) searchBtn.addEventListener('click', runMapSearch);
    if (searchInput) {
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          runMapSearch();
        }
      });
    }
    if (zoomInBtn) {
      zoomInBtn.addEventListener('click', function () {
        var z = map.getZoom();
        if (z != null) map.setZoom(Math.min(z + 1, 21));
      });
    }
    if (zoomOutBtn) {
      zoomOutBtn.addEventListener('click', function () {
        var z = map.getZoom();
        if (z != null) map.setZoom(Math.max(z - 1, 2));
      });
    }
    function applyCenter() {
      var c = map.getCenter();
      if (!c) return;
      setStatus('Looking up address…');
      geocoder.geocode({ location: c }, function (results, status) {
        if (status !== 'OK' || !results || !results[0]) {
          setStatus('Could not resolve this spot — try moving the map to a city block.');
          return;
        }
        var loc = parseCityStateFromGeocodeResult(results[0]);
        writeSearchFormLocation(loc.city, loc.state);
        setStatus(
          (loc.city || loc.state)
            ? 'Location updated from map center to ' + (loc.city || '—') + ', ' + (loc.state || '—') + '. Adjust keyword below, then run Find Leads.'
            : 'Could not find city/state — zoom closer to a town.'
        );
        var hub = document.getElementById('searchKeywordField');
        if (hub) hub.focus({ preventScroll: false });
      });
    }
    if (btn) btn.addEventListener('click', applyCenter);
  }
</script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= encodeURIComponent(googleMapsKey) %>&callback=initFindAreaMap"></script>
<% } else { %>
<div class="w-full border-b border-brand-border/15 dark:border-white/10 px-5 py-6 sm:px-7 sm:py-8">
  <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Step 1 · Map (optional)</p>
  <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Pick an area on a map</h2>
  <p class="text-sm text-brand-muted mt-2 max-w-2xl">Add <code class="text-[10px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">GOOGLE_MAPS_API_KEY</code> and enable <strong class="text-brand-dark dark:text-white">Maps JavaScript API</strong> + <strong class="text-brand-dark dark:text-white">Geocoding API</strong>. Until then, type city and state in the location fields below.</p>
</div>
<% } %>
