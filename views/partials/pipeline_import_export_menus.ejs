<% const _driveReady = typeof driveImport !== 'undefined' && driveImport && driveImport.pickerReady; %>
<% const _driveConnected = _driveReady && driveImport.connected; %>
<form action="/leads/import" method="post" enctype="multipart/form-data" id="leadsCsvImportForm" class="hidden" aria-hidden="true">
  <input type="file" id="leadsCsvFile" name="csvfile" accept=".csv,.xlsx,.xls,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="sr-only">
  <button type="submit" id="leadsCsvUploadButton" tabindex="-1" aria-hidden="true">
    <svg id="leadsCsvUploadSpinner" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
      <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
    <span id="leadsCsvUploadButtonText">Upload</span>
  </button>
</form>
<div class="flex flex-nowrap items-center gap-2 shrink-0">
  <div class="relative shrink-0" data-pipeline-menu>
    <button type="button" data-pipeline-menu-trigger class="inline-flex items-center justify-center gap-1.5 rounded-full border-2 border-brand-dark/20 dark:border-white/20 bg-white dark:bg-slate-900 text-brand-dark dark:text-white px-3.5 py-2 text-[10px] font-black uppercase tracking-widest shadow-sm whitespace-nowrap hover:bg-brand-cream/40 dark:hover:bg-white/10 transition-colors" aria-expanded="false" aria-haspopup="true">
      <svg class="w-4 h-4 shrink-0 text-blue-500 dark:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
      Import
      <svg class="w-3.5 h-3.5 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </button>
    <div data-pipeline-menu-panel class="portaled-popover-surface hidden min-w-[13.5rem] rounded-2xl border border-brand-border dark:border-white/10 py-1.5 shadow-xl ring-1 ring-black/5 dark:ring-white/10" role="menu">
      <button type="button" role="menuitem" class="js-import-computer w-full text-left px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-slate-800 transition-colors flex items-center gap-2.5">
        <svg class="w-4 h-4 shrink-0 text-brand-muted dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
        My Computer
      </button>
      <% if (_driveConnected) { %>
      <button type="button" role="menuitem" class="js-drive-import-pick w-full text-left px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors flex items-center gap-2.5">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </button>
      <% } else if (_driveReady) { %>
      <a href="/auth/google/drive-link" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </a>
      <% } else if (typeof driveImport !== 'undefined' && driveImport && driveImport.setupHint) { %>
      <span role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[10px] font-semibold normal-case tracking-normal text-brand-muted dark:text-slate-500 cursor-not-allowed" title="Set GOOGLE_PICKER_API_KEY on the server">
        <svg class="w-4 h-4 shrink-0 opacity-40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive (not configured)
      </span>
      <% } else { %>
      <a href="/auth/google/drive-link" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </a>
      <% } %>
    </div>
  </div>
  <div class="relative shrink-0" data-pipeline-menu>
    <button type="button" data-pipeline-menu-trigger class="inline-flex items-center justify-center gap-1.5 rounded-full border-2 border-brand-dark/20 dark:border-white/20 bg-white dark:bg-slate-900 text-brand-dark dark:text-white px-3.5 py-2 text-[10px] font-black uppercase tracking-widest shadow-sm whitespace-nowrap hover:bg-brand-cream/40 dark:hover:bg-white/10 transition-colors" aria-expanded="false" aria-haspopup="true">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
      Export
      <svg class="w-3.5 h-3.5 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </button>
    <div data-pipeline-menu-panel class="portaled-popover-surface hidden min-w-[13.5rem] rounded-2xl border border-brand-border dark:border-white/10 py-1.5 shadow-xl ring-1 ring-black/5 dark:ring-white/10" role="menu">
      <button type="button" role="menuitem" class="js-bulk-export-csv w-full text-left px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/60 dark:hover:bg-slate-800 transition-colors flex items-center gap-2.5">
        <svg class="w-4 h-4 shrink-0 text-brand-muted dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
        My Computer
      </button>
      <% if (_driveConnected) { %>
      <button type="button" role="menuitem" class="js-bulk-save-drive w-full text-left px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors flex items-center gap-2.5">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </button>
      <% } else if (_driveReady) { %>
      <a href="/auth/google/drive-link" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </a>
      <% } else if (typeof driveImport !== 'undefined' && driveImport && driveImport.setupHint) { %>
      <span role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[10px] font-semibold normal-case tracking-normal text-brand-muted dark:text-slate-500 cursor-not-allowed">
        <svg class="w-4 h-4 shrink-0 opacity-40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive (not configured)
      </span>
      <% } else { %>
      <a href="/auth/google/drive-link" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-bold uppercase tracking-widest text-brand-dark dark:text-white hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors">
        <svg class="w-4 h-4 shrink-0 text-blue-600 dark:text-blue-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.71 3.5L1.15 15l4.21 7.5h13.08l4.21-7.5L16.29 3.5H7.71zm1.07 1.5h6.44l5.57 10-3.5 6.25H6.71l-3.5-6.25 5.57-10z"/></svg>
        My Google Drive
      </a>
      <% } %>
    </div>
  </div>
  <p id="csvFileAttachHint" class="hidden w-full items-center gap-2 text-[10px] font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-widest" role="status" aria-live="polite">
    <svg class="w-3.5 h-3.5 shrink-0 text-emerald-600 dark:text-emerald-400 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
    <span>Importing</span>
    <span id="csvFileNameDisplay" class="font-mono normal-case tracking-normal text-brand-dark dark:text-white truncate"></span>
  </p>
</div>
