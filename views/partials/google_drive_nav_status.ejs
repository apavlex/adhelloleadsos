<% if (typeof driveImport !== 'undefined' && driveImport) { %>
  <% const _gdReady = !!driveImport.pickerReady; %>
  <% const _gdConnected = _gdReady && !!driveImport.connected; %>
  <% const _gdOAuthErr = !!driveImport.driveOAuthError; %>
  <% const _gdAccountEmail = driveImport.googleAccountEmail ? String(driveImport.googleAccountEmail) : ''; %>
  <% const _gdAccountTitle = _gdAccountEmail
    ? 'Google Drive connected as ' + _gdAccountEmail + ' — use Import or Export → My Google Drive'
    : 'Google Drive connected — use Import or Export → My Google Drive'; %>
  <% const _gdPillBase = 'inline-flex items-center gap-1.5 shrink-0 rounded-full border border-brand-border/60 dark:border-white/15 bg-white/80 dark:bg-slate-800 px-2.5 py-1 text-[10px] font-black uppercase tracking-widest transition-colors'; %>
  <div class="flex items-center pb-0" aria-label="Google Drive">
    <% if (_gdConnected) { %>
      <span class="<%= _gdPillBase %> text-brand-muted dark:text-slate-300 whitespace-nowrap" role="status" title="<%= _gdAccountTitle %>">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" aria-hidden="true"></span>
        Google Drive connected
      </span>
    <% } else if (_gdReady && !_gdOAuthErr) { %>
      <a href="/auth/google/drive-link" class="<%= _gdPillBase %> whitespace-nowrap text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-blue-300/80 dark:hover:border-blue-500/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950" title="Connect Google Drive to import and export lead lists">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-500 shrink-0" aria-hidden="true"></span>
        connect google drive
      </a>
    <% } else if (_gdOAuthErr) { %>
      <a href="/auth/google/drive-link" class="<%= _gdPillBase %> text-amber-800 dark:text-amber-200 border-amber-200/80 dark:border-amber-800/60 hover:border-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950" title="Google Drive connection failed — try connecting again">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0" aria-hidden="true"></span>
        reconnect
      </a>
    <% } else if (driveImport.setupHint) { %>
      <span class="<%= _gdPillBase %> text-amber-800/90 dark:text-amber-200/90 border-amber-200/60 dark:border-amber-800/50 cursor-help" title="Google Drive import is not fully configured — set GOOGLE_PICKER_API_KEY on the server">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0" aria-hidden="true"></span>
        drive
      </span>
    <% } %>
  </div>
<% } %>
