<%# Sales coach floating dock. locals.assistantDockIncluded prevents duplicate FAB when included from navbar + footer. %>
<% if (typeof user !== 'undefined' && user) { %>
<% if (!locals.assistantDockIncluded) { locals.assistantDockIncluded = true; %>
<div id="assistantDock" class="fixed bottom-5 right-5 z-[155] flex flex-col items-end gap-3 pointer-events-none [&>*]:pointer-events-auto">
  <div
    id="assistantPanel"
    class="hidden w-[min(calc(100vw-1.5rem),26rem)] h-[min(32rem,calc(100vh-6rem))] flex flex-col rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-2xl overflow-hidden"
    role="dialog"
    aria-label="Sales coach"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span class="shrink-0 w-10 h-10 rounded-full overflow-hidden border border-slate-200/90 dark:border-white/20 bg-white dark:bg-slate-800 shadow-sm ring-2 ring-slate-200/80 dark:ring-white/10" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex AI Assistant">
            <circle cx="24" cy="24" r="22" fill="#FFD644"/>
            <circle cx="24" cy="24" r="20" fill="#FFC107"/>
            <ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
            <ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
            <circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
            <circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
            <path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/>
            <ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
            <ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
          </svg>
        </span>
        <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Pavlex · AI Assistant</p>
        <p class="text-xs font-bold text-brand-dark dark:text-white truncate">Leads, pipeline &amp; operations</p>
        </div>
      </div>
      <button type="button" id="assistantClose" class="w-9 h-9 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center transition-colors" aria-label="Close sales coach">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div id="assistantMessages" class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3 text-sm custom-scrollbar"></div>
    <div id="assistantCitations" class="hidden shrink-0 max-h-28 overflow-y-auto border-t border-brand-border/40 dark:border-white/10 px-3 py-2 bg-brand-cream/20 dark:bg-slate-800/40 text-[11px]"></div>
    <form id="assistantForm" class="shrink-0 flex flex-col gap-1.5 p-3 border-t border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900">
      <p id="assistantVoiceHint" class="hidden text-[10px] text-brand-muted leading-tight" role="status"></p>
      <div class="flex gap-2 items-stretch sm:items-center">
      <label class="sr-only" for="assistantInput">Message</label>
      <input
        id="assistantInput"
        type="text"
        autocomplete="off"
        maxlength="2000"
        placeholder="Ask your coach or search leads…"
        class="flex-1 min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-yellow/50"
      />
      <button type="button" id="assistantMic" class="shrink-0 w-11 rounded-xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-dark dark:text-white flex items-center justify-center hover:bg-brand-cream dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-yellow/50 disabled:opacity-40 disabled:cursor-not-allowed" title="Dictate (Chrome, Edge, Safari 18.1+ on Mac)" aria-label="Dictate with microphone" aria-pressed="false" disabled>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>
      </button>
      <button type="submit" id="assistantSend" class="shrink-0 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50">
        Send
      </button>
      </div>
    </form>
  </div>
  <button
    type="button"
    id="assistantFab"
    class="w-14 h-14 rounded-full bg-brand-yellow text-brand-dark shadow-lg shadow-brand-yellow/35 border-2 border-amber-300/50 flex items-center justify-center overflow-hidden hover:brightness-105 active:scale-[0.97] transition-all p-0.5"
    aria-expanded="false"
    aria-controls="assistantPanel"
    title="Open Pavlex chat"
  >
    <span class="w-full h-full rounded-full overflow-hidden bg-amber-50/90 dark:bg-slate-800 ring-2 ring-amber-200/70 dark:ring-white/30 flex items-center justify-center shadow-inner" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-[85%] h-[85%]" role="img" aria-label="Pavlex AI Assistant">
        <circle cx="24" cy="24" r="22" fill="#FFD644"/>
        <circle cx="24" cy="24" r="20" fill="#FFC107"/>
        <!-- Eyes -->
        <ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
        <ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
        <circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
        <circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
        <!-- Smile -->
        <path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/>
        <!-- Cheeks -->
        <ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
        <ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
      </svg>
    </span>
  </button>
</div>
<script src="/js/assistant-chat.js" defer></script>
<% } %>
<% } %>
