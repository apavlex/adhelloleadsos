<% if (typeof user !== 'undefined' && user) { %>
<div id="assistantDock" class="fixed bottom-5 right-5 z-[155] flex flex-col items-end gap-3 pointer-events-none [&>*]:pointer-events-auto">
  <div
    id="assistantPanel"
    class="hidden w-[min(calc(100vw-1.5rem),26rem)] h-[min(32rem,calc(100vh-6rem))] flex flex-col rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-2xl overflow-hidden"
    role="dialog"
    aria-label="Workspace assistant"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span class="shrink-0 w-10 h-10 rounded-full overflow-hidden border border-brand-border/40 dark:border-white/15 bg-gradient-to-b from-[#f5f0e8] to-[#e8e2d8] shadow-sm ring-2 ring-white/60 dark:ring-slate-700/80" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class="w-full h-full" role="img" aria-label="">
            <defs>
              <linearGradient id="dockAsstHair" x1="8" y1="4" x2="40" y2="28" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FAF8F4"/><stop offset="0.45" stop-color="#E8E2D8"/><stop offset="1" stop-color="#C9C2B8"/>
              </linearGradient>
              <linearGradient id="dockAsstHairSh" x1="24" y1="8" x2="24" y2="32" gradientUnits="userSpaceOnUse">
                <stop stop-color="#DDD6CC" stop-opacity="0"/><stop offset="1" stop-color="#B8B0A6" stop-opacity="0.45"/>
              </linearGradient>
            </defs>
            <path fill="url(#dockAsstHair)" d="M8 22c0-10 6.5-18 16-18s16 8 16 18c0 3-.5 6-1.5 8.5 2 1.2 3.5 3.2 4.5 5.8-1.2.4-2.5.6-3.8.7-.8 2-2.2 3.8-4 5.2-.6-1.4-1.6-2.6-2.8-3.6-.4 2.6-1.4 5-2.8 7.2-1.4-.8-2.8-1.4-4.4-1.8-.6 1.8-1.6 3.4-2.8 4.8C26.4 44 22.8 45 19 45c-4.6 0-8.8-1.8-11.8-4.8 1.4-1.6 2.4-3.5 3-5.6-1.4-.2-2.8-.6-4-1.2 1-2 2.2-3.8 3.6-5.4-1.8-1-3.4-2.4-4.6-4.2C4.8 30.6 4 28.4 4 26c0-1.4.2-2.8.6-4 1.8.8 3.6 1.2 5.4 1.4-.4-1.4-.6-2.8-.6-4.4z"/>
            <path fill="url(#dockAsstHairSh)" d="M8 22c0-10 6.5-18 16-18s16 8 16 18v2c-2 8-8 14-16 14S10 32 8 24v-2z" opacity="0.9"/>
            <path fill="none" stroke="#C4BCB2" stroke-width="0.75" stroke-linecap="round" d="M12 34q2.5 2 5 0t5 0 5 0 5 0" opacity="0.7"/>
            <ellipse cx="24" cy="26" rx="9" ry="10" fill="#F0C8B8"/>
            <ellipse cx="24" cy="27" rx="7.5" ry="8" fill="#F5D4C8" opacity="0.85"/>
            <ellipse cx="20" cy="25" rx="1.1" ry="1.35" fill="#3d3d3d"/>
            <ellipse cx="28" cy="25" rx="1.1" ry="1.35" fill="#3d3d3d"/>
            <path stroke="#3d3d3d" stroke-width="0.9" stroke-linecap="round" d="M19 23.5q1-.6 2 0M27 23.5q1-.6 2 0" opacity="0.5"/>
            <path stroke="#C97B7B" stroke-width="0.85" stroke-linecap="round" d="M21 30q3 2.5 6 0" fill="none"/>
          </svg>
        </span>
        <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Assistant</p>
        <p class="text-xs font-bold text-brand-dark dark:text-white truncate">Leads &amp; resources</p>
        </div>
      </div>
      <button type="button" id="assistantClose" class="w-9 h-9 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center transition-colors" aria-label="Close assistant">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div id="assistantMessages" class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3 text-sm custom-scrollbar"></div>
    <div id="assistantCitations" class="hidden shrink-0 max-h-28 overflow-y-auto border-t border-brand-border/40 dark:border-white/10 px-3 py-2 bg-brand-cream/20 dark:bg-slate-800/40 text-[11px]"></div>
    <form id="assistantForm" class="shrink-0 flex gap-2 p-3 border-t border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900">
      <label class="sr-only" for="assistantInput">Message</label>
      <input
        id="assistantInput"
        type="text"
        autocomplete="off"
        maxlength="2000"
        placeholder="Search leads &amp; resources…"
        class="flex-1 min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-yellow/50"
      />
      <button type="submit" id="assistantSend" class="shrink-0 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50">
        Send
      </button>
    </form>
  </div>
  <button
    type="button"
    id="assistantFab"
    class="w-14 h-14 rounded-full bg-brand-yellow text-brand-dark shadow-lg shadow-brand-yellow/35 border border-amber-400/40 flex items-center justify-center hover:brightness-105 active:scale-[0.97] transition-all"
    aria-expanded="false"
    aria-controls="assistantPanel"
    title="Open assistant"
  >
    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
  </button>
</div>
<script src="/js/assistant-chat.js" defer></script>
<% } %>
