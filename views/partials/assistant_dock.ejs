<%# Sales coach floating dock. locals.assistantDockIncluded prevents duplicate FAB when included from navbar + footer. %>
<% if (typeof user !== 'undefined' && user) { %>
<% if (!locals.assistantDockIncluded) { locals.assistantDockIncluded = true; %>
<div id="assistantDock" class="fixed bottom-5 right-5 z-[155] flex flex-col items-end gap-3 pointer-events-none [&>*]:pointer-events-auto">
  <div
    id="assistantPanel"
    class="hidden w-[min(calc(100vw-1.5rem),26rem)] h-[min(32rem,calc(100vh-6rem))] flex flex-col rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-2xl overflow-hidden"
    role="dialog"
    aria-label="Sales coach"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span class="shrink-0 w-10 h-10 rounded-full overflow-hidden border border-slate-700/30 dark:border-white/20 bg-[#2a2220] shadow-sm ring-2 ring-white/25 dark:ring-white/10" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class="w-full h-full" role="img" aria-label="">
            <defs>
              <linearGradient id="dockCoachHair" x1="6" y1="4" x2="42" y2="22" gradientUnits="userSpaceOnUse">
                <stop stop-color="#3d2a22"/><stop offset="0.55" stop-color="#1c1210"/><stop offset="1" stop-color="#0a0605"/>
              </linearGradient>
              <linearGradient id="dockCoachSkin" x1="16" y1="16" x2="32" y2="42" gradientUnits="userSpaceOnUse">
                <stop stop-color="#f0c4b8"/><stop offset="1" stop-color="#c99588"/>
              </linearGradient>
            </defs>
            <path fill="url(#dockCoachHair)" d="M24 3C12 3 5 12 5 24c0 5 1.2 9.5 3.5 13 0.5-7 4.5-12 11.5-13.5 1.2 0.8 2.5 1.2 4 1.2s2.8-0.4 4-1.2c7 1.5 11 6.5 11.5 13.5 2.3-3.5 3.5-8 3.5-13C43 12 36 3 24 3z"/>
            <path fill="#1a1210" d="M14 19c2.5-7 8.5-11 10-11s7.5 4 10 11c-2-4.5-6-7.5-10-7.5s-8 3-10 7.5z"/>
            <ellipse cx="24" cy="25" rx="9.5" ry="11" fill="url(#dockCoachSkin)"/>
            <path fill="url(#dockCoachHair)" d="M11 24c0-8 5.5-14 13-14s13 6 13 14c0 2-0.5 4-1.5 5.5-1-6-5.5-10-11.5-10s-10.5 4-11.5 10c-1-1.5-1.5-3.5-1.5-5.5z"/>
            <ellipse cx="19.5" cy="23.5" rx="1.7" ry="2.1" fill="#2a1a14"/>
            <ellipse cx="28.5" cy="23.5" rx="1.7" ry="2.1" fill="#2a1a14"/>
            <circle cx="20.3" cy="22.6" r="0.6" fill="#fff" opacity="0.9"/>
            <circle cx="29.3" cy="22.6" r="0.6" fill="#fff" opacity="0.9"/>
            <path stroke="#3d2a22" stroke-width="0.85" stroke-linecap="round" fill="none" d="M16.8 20.2q2.8-1.2 5.6 0M25.6 20.2q2.8-1.2 5.6 0" opacity="0.45"/>
            <path stroke="#a65d52" stroke-width="0.9" stroke-linecap="round" fill="none" d="M24 26.2v2.8" opacity="0.55"/>
            <path stroke="#9a4d42" stroke-width="1.05" stroke-linecap="round" fill="none" d="M19.5 31.2q4.5 3 9 0"/>
            <ellipse cx="17.2" cy="27.5" rx="2.2" ry="1.3" fill="#d9a090" opacity="0.4"/>
            <ellipse cx="30.8" cy="27.5" rx="2.2" ry="1.3" fill="#d9a090" opacity="0.4"/>
            <path fill="url(#dockCoachSkin)" d="M17.5 35.5h13v4.5c0 1.8-2.2 3.5-6.5 3.5s-6.5-1.7-6.5-3.5v-4.5z"/>
          </svg>
        </span>
        <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Sales coach</p>
        <p class="text-xs font-bold text-brand-dark dark:text-white truncate">Leads, pipeline &amp; resources</p>
        </div>
      </div>
      <button type="button" id="assistantClose" class="w-9 h-9 rounded-xl bg-brand-cream dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white flex items-center justify-center transition-colors" aria-label="Close sales coach">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div id="assistantMessages" class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3 text-sm custom-scrollbar"></div>
    <div id="assistantCitations" class="hidden shrink-0 max-h-28 overflow-y-auto border-t border-brand-border/40 dark:border-white/10 px-3 py-2 bg-brand-cream/20 dark:bg-slate-800/40 text-[11px]"></div>
    <form id="assistantForm" class="shrink-0 flex gap-2 p-3 border-t border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900">
      <label class="sr-only" for="assistantInput">Message</label>
      <input
        id="assistantInput"
        type="text"
        autocomplete="off"
        maxlength="2000"
        placeholder="Ask your coach or search leads…"
        class="flex-1 min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-yellow/50"
      />
      <button type="submit" id="assistantSend" class="shrink-0 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50">
        Send
      </button>
    </form>
  </div>
  <button
    type="button"
    id="assistantFab"
    class="w-14 h-14 rounded-full bg-brand-yellow text-brand-dark shadow-lg shadow-brand-yellow/35 border-2 border-amber-300/50 flex items-center justify-center overflow-hidden hover:brightness-105 active:scale-[0.97] transition-all p-0.5"
    aria-expanded="false"
    aria-controls="assistantPanel"
    title="Open sales coach"
  >
    <span class="w-full h-full rounded-full overflow-hidden bg-[#2a2220] ring-2 ring-white/35 flex items-center justify-center" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class="w-[92%] h-[92%]" role="img" aria-label="">
        <defs>
          <linearGradient id="fabCoachHair" x1="6" y1="4" x2="42" y2="22" gradientUnits="userSpaceOnUse">
            <stop stop-color="#3d2a22"/><stop offset="0.55" stop-color="#1c1210"/><stop offset="1" stop-color="#0a0605"/>
          </linearGradient>
          <linearGradient id="fabCoachSkin" x1="16" y1="16" x2="32" y2="42" gradientUnits="userSpaceOnUse">
            <stop stop-color="#f0c4b8"/><stop offset="1" stop-color="#c99588"/>
          </linearGradient>
        </defs>
        <path fill="url(#fabCoachHair)" d="M24 3C12 3 5 12 5 24c0 5 1.2 9.5 3.5 13 0.5-7 4.5-12 11.5-13.5 1.2 0.8 2.5 1.2 4 1.2s2.8-0.4 4-1.2c7 1.5 11 6.5 11.5 13.5 2.3-3.5 3.5-8 3.5-13C43 12 36 3 24 3z"/>
        <path fill="#1a1210" d="M14 19c2.5-7 8.5-11 10-11s7.5 4 10 11c-2-4.5-6-7.5-10-7.5s-8 3-10 7.5z"/>
        <ellipse cx="24" cy="25" rx="9.5" ry="11" fill="url(#fabCoachSkin)"/>
        <path fill="url(#fabCoachHair)" d="M11 24c0-8 5.5-14 13-14s13 6 13 14c0 2-0.5 4-1.5 5.5-1-6-5.5-10-11.5-10s-10.5 4-11.5 10c-1-1.5-1.5-3.5-1.5-5.5z"/>
        <ellipse cx="19.5" cy="23.5" rx="1.7" ry="2.1" fill="#2a1a14"/>
        <ellipse cx="28.5" cy="23.5" rx="1.7" ry="2.1" fill="#2a1a14"/>
        <circle cx="20.3" cy="22.6" r="0.6" fill="#fff" opacity="0.9"/>
        <circle cx="29.3" cy="22.6" r="0.6" fill="#fff" opacity="0.9"/>
        <path stroke="#3d2a22" stroke-width="0.85" stroke-linecap="round" fill="none" d="M16.8 20.2q2.8-1.2 5.6 0M25.6 20.2q2.8-1.2 5.6 0" opacity="0.45"/>
        <path stroke="#a65d52" stroke-width="0.9" stroke-linecap="round" fill="none" d="M24 26.2v2.8" opacity="0.55"/>
        <path stroke="#9a4d42" stroke-width="1.05" stroke-linecap="round" fill="none" d="M19.5 31.2q4.5 3 9 0"/>
        <ellipse cx="17.2" cy="27.5" rx="2.2" ry="1.3" fill="#d9a090" opacity="0.4"/>
        <ellipse cx="30.8" cy="27.5" rx="2.2" ry="1.3" fill="#d9a090" opacity="0.4"/>
        <path fill="url(#fabCoachSkin)" d="M17.5 35.5h13v4.5c0 1.8-2.2 3.5-6.5 3.5s-6.5-1.7-6.5-3.5v-4.5z"/>
      </svg>
    </span>
  </button>
</div>
<script src="/js/assistant-chat.js" defer></script>
<% } %>
<% } %>
