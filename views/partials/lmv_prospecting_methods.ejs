<% const _lmv = typeof lmvProspectingMethods !== 'undefined' && lmvProspectingMethods ? lmvProspectingMethods : []; %>
<% if (_lmv.length) { %>
<details id="lmvPlaybookDetails" class="lmv-playbook brand-card dark:bg-slate-900 dark:border-white/10 mb-8 overflow-hidden group">
  <script>
  (function () {
    var d = document.currentScript && document.currentScript.parentElement;
    if (!d || d.id !== 'lmvPlaybookDetails') return;
    try {
      if (localStorage.getItem('lmvPlaybookOpen') === '1') d.setAttribute('open', '');
    } catch (_) {}
  })();
  </script>
  <summary class="lmv-playbook__summary px-5 py-4 md:px-6 md:py-5 group-open:border-b group-open:border-brand-border/30 dark:group-open:border-white/10 cursor-pointer list-none flex items-start justify-between gap-4 select-none">
    <div class="min-w-0 flex-1">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Outreach playbook</p>
      <h3 class="font-display font-extrabold text-lg md:text-xl text-brand-dark dark:text-white">The 6 LMV prospecting methods</h3>
      <p class="text-sm text-brand-muted dark:text-slate-400 mt-1 max-w-3xl">Pick a method to filter the pipeline — cold email shows leads with email, double tap requires email, phone, and social links.</p>
    </div>
    <span class="lmv-playbook__chevron shrink-0 w-9 h-9 rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/50 dark:bg-slate-800/80 flex items-center justify-center text-brand-muted dark:text-slate-400 mt-0.5" aria-hidden="true">
      <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
    </span>
  </summary>
  <div class="p-4 md:p-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
    <% _lmv.forEach(function (m) {
      var tempClass = m.temperature === 'hot'
        ? 'lmv-temp lmv-temp--hot'
        : m.temperature === 'warm'
          ? 'lmv-temp lmv-temp--warm'
          : 'lmv-temp lmv-temp--cold';
      var iconClass = m.temperature === 'hot'
        ? 'lmv-icon lmv-icon--hot'
        : m.temperature === 'warm'
          ? 'lmv-icon lmv-icon--warm'
          : 'lmv-icon lmv-icon--cold';
    %>
    <article class="lmv-method-card rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4 flex flex-col gap-3 min-h-[11rem]">
      <div class="flex items-start justify-between gap-2">
        <span class="<%= iconClass %>" aria-hidden="true">
          <% if (m.icon === 'flame') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          <% } else if (m.icon === 'monitor') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          <% } else if (m.icon === 'car') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
          <% } else if (m.icon === 'mail') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <% } else if (m.icon === 'phone') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <% } else if (m.icon === 'layers') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/></svg>
          <% } else if (m.icon === 'postcard') { %>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          <% } %>
        </span>
        <div class="flex flex-wrap justify-end gap-1">
          <% if (m.contactHint) { %>
          <span class="lmv-contact-hint"><%= m.contactHint %></span>
          <% } %>
          <span class="<%= tempClass %>"><%= m.temperatureLabel %></span>
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <h4 class="font-display font-bold text-base text-brand-dark dark:text-white leading-snug"><%= m.title %></h4>
        <p class="text-xs text-brand-muted dark:text-slate-400 mt-2 leading-relaxed line-clamp-3"><%= m.description %></p>
      </div>
      <% if (m.actionHref) { %>
      <a href="<%= m.actionHref %>" class="btn-pill lmv-method-btn <%= m.temperature === 'cold' ? 'lmv-method-btn--cold' : 'lmv-method-btn--warm' %> w-full text-[10px] font-black uppercase tracking-widest"><%= m.actionLabel %></a>
      <% } else { %>
      <button type="button" class="btn-pill lmv-method-btn lmv-method-btn--warm w-full text-[10px] font-black uppercase tracking-widest js-lmv-method-action" data-lmv-action="<%= m.actionKind || m.id %>"><%= m.actionLabel %></button>
      <% } %>
    </article>
    <% }); %>
  </div>
</details>
<script>
(function () {
  var details = document.getElementById('lmvPlaybookDetails');
  if (!details) return;
  details.addEventListener('toggle', function () {
    try {
      localStorage.setItem('lmvPlaybookOpen', details.open ? '1' : '0');
    } catch (_) {}
  });
})();
</script>
<% } %>
