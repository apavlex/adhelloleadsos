<%#
  Auto-outreach GHL workflow prompt + one-click build.
  Optional: promptId (default ghlAutoOutreachPrompt), compact (shorter header)
%>
<% const _promptId = typeof promptId !== 'undefined' && promptId ? String(promptId) : 'ghlAutoOutreachPrompt'; %>
<% const _copyBtnId = _promptId + 'CopyBtn'; %>
<% const _buildBtnId = _promptId + 'BuildBtn'; %>
<% const _copyStatusId = _promptId + 'CopyStatus'; %>
<% const _compact = typeof compact !== 'undefined' && compact; %>
<% const _promptText = require(require('path').join(process.cwd(), 'services/ghlAutoOutreachPromptText')).PROMPT; %>
<div class="ghl-workflow-prompt-block rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-950/50 p-4 md:p-5">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
    <div class="min-w-0">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Build in GHL</p>
      <h3 class="font-bold text-brand-dark dark:text-white text-sm md:text-base">Auto-outreach workflow</h3>
      <% if (!_compact) { %>
      <p class="text-xs text-brand-muted leading-relaxed mt-1">Creates a draft workflow in GHL when the Workflows API is enabled. Otherwise copies the setup prompt for Workflow AI Builder. Supports <strong class="text-brand-dark dark:text-white">multiple business profiles</strong> via AdHello sender merge fields.</p>
      <% } else { %>
      <p class="text-xs text-brand-muted leading-relaxed mt-1">Configure the <code class="text-[10px] px-1 rounded bg-white/80 dark:bg-slate-800">auto-outreach</code> tag workflow — one-click when API is on, prompt fallback otherwise.</p>
      <% } %>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <button type="button" id="<%= _buildBtnId %>" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity">Build workflow in GHL</button>
      <button type="button" id="<%= _copyBtnId %>" class="rounded-xl border border-brand-border dark:border-white/20 px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity" data-copy-target="<%= _promptId %>">Copy prompt</button>
    </div>
  </div>
  <textarea id="<%= _promptId %>" readonly rows="<%= _compact ? 16 : 24 %>" class="w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-3 text-[11px] md:text-xs font-mono leading-relaxed text-brand-dark dark:text-slate-100 resize-y min-h-[10rem] custom-scrollbar" aria-label="GHL auto-outreach workflow setup prompt"><%= _promptText %></textarea>
  <p id="<%= _copyStatusId %>" class="mt-2 text-[11px] text-emerald-700 dark:text-emerald-300 hidden" role="status">Copied to clipboard.</p>
</div>
<script>
(function () {
  var btn = document.getElementById('<%= _copyBtnId %>');
  var buildBtn = document.getElementById('<%= _buildBtnId %>');
  var ta = document.getElementById('<%= _promptId %>');
  var status = document.getElementById('<%= _copyStatusId %>');
  function showStatus(text, ok) {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle('text-emerald-700', !!ok);
    status.classList.toggle('dark:text-emerald-300', !!ok);
    status.classList.toggle('text-amber-700', !ok);
    status.classList.toggle('dark:text-amber-300', !ok);
    status.classList.toggle('text-rose-600', !ok && /fail|error|could not/i.test(text));
    status.classList.remove('hidden');
  }
  if (btn && ta) {
    btn.addEventListener('click', function () {
      var text = ta.value || ta.textContent || '';
      function done(ok) {
        showStatus(ok ? 'Copied to clipboard.' : 'Copy failed — select the text and copy manually.', ok);
        setTimeout(function () { status.classList.add('hidden'); }, 3500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { done(true); }).catch(function () { done(false); });
      } else {
        ta.focus();
        ta.select();
        try { done(document.execCommand('copy')); } catch (e) { done(false); }
      }
    });
  }
  if (buildBtn) {
    buildBtn.addEventListener('click', async function () {
      var prev = buildBtn.textContent;
      buildBtn.disabled = true;
      buildBtn.textContent = 'Building…';
      try {
        var res = await fetch('/workspace/ghl/create-auto-outreach-workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: '{}',
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error((data && data.error) || 'Build failed');
        if (data.prompt && navigator.clipboard && navigator.clipboard.writeText) {
          try { await navigator.clipboard.writeText(data.prompt); } catch (_) {}
        }
        showStatus(data.message || 'Done.', data.mode === 'api');
        if (data.openUrl) window.open(data.openUrl, '_blank', 'noopener');
      } catch (err) {
        showStatus(err.message || 'Build failed', false);
      } finally {
        buildBtn.disabled = false;
        buildBtn.textContent = prev;
      }
    });
  }
})();
</script>
