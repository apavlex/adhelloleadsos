<%
  const _inb = typeof inboundItems !== 'undefined' && Array.isArray(inboundItems) ? inboundItems : [];
  const _inbAgo = function (iso) {
    const ms = Date.now() - Date.parse(iso || '');
    if (!Number.isFinite(ms)) return '';
    const m = Math.max(0, Math.round(ms / 60000));
    if (m < 1) return 'just now';
    if (m < 60) return m + 'm ago';
    const h = Math.round(m / 60);
    if (h < 24) return h + 'h ago';
    return Math.round(h / 24) + 'd ago';
  };
  const _inbTone = {
    form: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
    missed_call: 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300',
    voicemail: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    sms: 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-300',
    email: 'bg-violet-100 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300',
  };
  const _inbIcon = {
    form: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 16h4M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>',
    missed_call: '<path stroke-linecap="round" stroke-linejoin="round" d="M16 3l5 5m0-5l-5 5M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
    voicemail: '<circle cx="6.5" cy="12" r="3.5"/><circle cx="17.5" cy="12" r="3.5"/><path stroke-linecap="round" d="M6.5 15.5h11"/>',
    sms: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    email: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4zM4 7l8 6 8-6"/>',
  };
%>
<section id="todayInbound" class="today-viz today-viz-reveal mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-labelledby="todayInboundHeading">
  <div class="flex items-start justify-between gap-3 <%= _inb.length ? 'mb-4' : '' %>">
    <div class="min-w-0">
      <h2 id="todayInboundHeading" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">
        Inbound<% if (_inb.length) { %> <span class="ml-1 inline-flex items-center justify-center h-5 px-1.5 rounded-full bg-brand-yellow text-brand-dark text-[10px] tabular-nums" data-inbound-count style="min-width:1.25rem"><%= _inb.length %></span><% } %>
      </h2>
      <p class="text-sm text-brand-muted"><%= _inb.length ? 'New form and ad leads, missed calls, voicemails, and texts waiting on a reply.' : 'No new inbound. Form and ad leads, missed calls, voicemails, and texts from GHL show up here.' %></p>
    </div>
  </div>
  <% if (_inb.length) { %>
  <ul class="divide-y divide-brand-border/40 dark:divide-white/10" data-inbound-list>
    <% _inb.forEach(function (it) { %>
    <li class="py-3 flex items-start gap-3" data-inbound-row="<%= it.leadKey %>">
      <span class="shrink-0 mt-0.5 grid place-items-center w-9 h-9 rounded-xl <%= _inbTone[it.type] || _inbTone.sms %>" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><%- _inbIcon[it.type] || _inbIcon.sms %></svg>
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2">
          <a href="<%= it.openHref %>" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow truncate min-w-0"><%= it.title %></a>
          <span class="ml-auto text-[10px] font-bold text-brand-muted whitespace-nowrap tabular-nums" title="<%= it.at %>"><%= _inbAgo(it.at) %></span>
        </div>
        <p class="text-[11px] text-brand-muted truncate">
          <span class="font-bold text-brand-dark dark:text-slate-200"><%= it.typeLabel %></span><% if (it.label) { %> · <%= it.label %><% } %><% if (it.count > 1) { %> · <%= it.count %> events<% } %><% if (it.otherTypes.length) { %> (+ <%= it.otherTypes.join(', ').toLowerCase() %>)<% } %>
        </p>
        <% if (it.preview) { %><p class="text-xs text-brand-dark dark:text-slate-300 mt-0.5 line-clamp-2"><%= it.preview %></p><% } %>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <a href="<%= it.callHref %>" class="btn-pill btn-primary px-3 py-1.5 text-[10px] font-black uppercase tracking-widest"><%= (it.type === 'sms' || it.type === 'email') ? 'Reply' : it.type === 'form' ? 'Call now' : 'Call back' %></a>
          <% if (it.phone) { %><a href="tel:<%= it.phone.replace(/[^\d+]/g, '') %>" class="hidden sm:inline text-[11px] font-semibold text-brand-muted hover:text-brand-yellow tabular-nums"><%= it.phone %></a><% } %>
          <a href="<%= it.openHref %>" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow px-2 py-1.5">Open</a>
          <button type="button" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow px-2 py-1.5" data-inbound-done="<%= it.leadKey %>">Done</button>
        </div>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
<script>
  (function () {
    var root = document.getElementById('todayInbound');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-inbound-done]');
      if (!btn) return;
      var key = btn.getAttribute('data-inbound-done');
      btn.disabled = true;
      fetch('/today/inbound/done', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ leadKey: key }),
      })
        .then(function (r) {
          if (!r.ok) throw new Error('failed');
          var row = btn.closest('[data-inbound-row]');
          if (row) row.remove();
          var left = root.querySelectorAll('[data-inbound-row]').length;
          var badge = root.querySelector('[data-inbound-count]');
          if (badge) badge.textContent = String(left);
          if (!left) {
            var list = root.querySelector('[data-inbound-list]');
            if (list) list.remove();
            if (badge) badge.remove();
          }
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = 'Retry';
        });
    });
  })();
</script>
