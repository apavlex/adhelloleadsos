    function googleMapsSocialHrefForLead(lead) {
      var raw = (lead.url && lead.url !== 'N/A') ? String(lead.url).trim() : '';
      function isGmListing(absUrl) {
        try {
          var u = new URL(absUrl);
          var h = u.hostname.replace(/^www\./i, '').toLowerCase();
          if (h === 'maps.app.goo.gl') return true;
          if (h === 'goo.gl' && u.pathname.includes('maps')) return true;
          if (h.endsWith('google.com') || h.endsWith('google.co.uk')) {
            if (u.pathname.includes('/maps/')) return true;
            if (u.search.includes('cid=') || u.search.includes('q=place_id:')) return true;
          }
          return false;
        } catch (e) { return false; }
      }
      if (raw && /^https?:\/\//i.test(raw) && isGmListing(raw)) return raw;
      var title = String(lead.title || '').trim();
      var address = String(lead.address || '').trim();
      var city = String(lead.city || '').trim();
      if (address && address !== 'N/A') {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((address + ' ' + title).trim());
      }
      if (title && city) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((title + ' ' + city).trim());
      }
      if (title) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(title);
      }
      return '';
    }
    function plcEscAttr(v) {
      return String(v == null ? '' : v)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;');
    }
    function plcCategoryInputValue(v) {
      if (v == null || v === 'N/A') return '';
      if (Array.isArray(v)) v = v.filter(Boolean).map(String).join(', ');
      else if (typeof v === 'object') v = JSON.stringify(v);
      else v = String(v);
      v = String(v).trim();
      if (!v || v === 'N/A') return '';
      return plcEscAttr(v);
    }
    function plcEscJson(obj) {
      return JSON.stringify(obj === undefined ? null : obj)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;');
    }
    var _plcWorkspaceTags = typeof tags !== 'undefined' && tags ? tags : [];
    var _plcTagByKey = {};
    _plcWorkspaceTags.forEach(function (tg) {
      if (tg && tg.key) _plcTagByKey[String(tg.key)] = tg;
    });
    function plcTagLabel(tagKey) {
      var tg = _plcTagByKey[String(tagKey || '').trim()];
      if (tg && tg.name) return tg.name;
      return String(tagKey || '').replace(/^tag:[^:]+:/, '') || 'Tag';
    }
    function plcTagColor(tagKey) {
      var tg = _plcTagByKey[String(tagKey || '').trim()];
      var c = tg && tg.color ? String(tg.color) : '#94a3b8';
      return /^#[0-9A-Fa-f]{6}$/.test(c) ? c.toUpperCase() : '#94A3B8';
    }
    function formatListingSourceLabel(raw) {
      if (typeof formatSourceChannelLabel === 'function') {
        return formatSourceChannelLabel(raw);
      }
      var s = String(raw || '').trim();
      if (!s) return '';
      if (s === 'facebook_marketplace') return 'Facebook Marketplace';
      if (s === 'google_maps' || s === 'chrome_extension_maps_bulk') return 'Google Maps';
      if (s === 'csv_import' || s === 'google_drive' || s === 'chrome_extension') return '';
      return s.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
    }
    function plcPermitValueDisplay(v) {
      var n = Number(v);
      if (!Number.isFinite(n) || n <= 0) return '—';
      return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    }
    function plcPermitStatusDate(lead) {
      return String(lead.permitDateIssued || lead.permitDateFiled || '').trim();
    }
    function plcFormatFullAddressLine(lead) {
      var street = String(lead.address || '').trim();
      if (!street || street === 'N/A') street = '';
      var city = String(lead.city || '').trim();
      var state = String(lead.state || '').trim();
      var zip = String(lead.zip || lead.postalCode || '').trim();
      var locParts = [];
      if (city) locParts.push(city);
      if (state) locParts.push(state);
      var loc = locParts.join(', ');
      if (zip) loc = loc ? loc + ' ' + zip : zip;
      if (!street) return loc;
      if (!loc) return street;
      var streetLower = street.toLowerCase();
      var locLower = loc.toLowerCase();
      if (streetLower.endsWith(locLower) || streetLower.indexOf(', ' + locLower) !== -1) {
        return street;
      }
      if (city && state) {
        var cityState = (city + ', ' + state).toLowerCase();
        if (streetLower.indexOf(cityState) !== -1) {
          if (zip && streetLower.indexOf(String(zip).toLowerCase()) === -1) {
            return street + ' ' + zip;
          }
          return street;
        }
      }
      return street + ', ' + loc;
    }
