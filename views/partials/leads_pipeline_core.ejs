        <tbody>
          <% leads.forEach((lead, i) => { %>
            <% const stagesList = (typeof pipelineStages !== 'undefined' && pipelineStages) ? pipelineStages : []; %>
            <% let activeStageId = lead.stageId ? String(lead.stageId) : ''; %>
            <% if (!activeStageId && stagesList.length) { %>
            <%   let _idx = parseInt(lead.pipelineStage, 10); if (Number.isNaN(_idx) || _idx < 1) _idx = 1; const _safe = Math.min(_idx, stagesList.length); %>
            <%   activeStageId = stagesList[_safe - 1] ? String(stagesList[_safe - 1].id) : ''; %>
            <% } %>
            <% const stRow = activeStageId ? stagesList.find((s) => String(s.id) === activeStageId) : null; %>
            <% const psRow = stRow ? (stagesList.findIndex((s) => s.id === stRow.id) + 1) : (parseInt(lead.pipelineStage, 10) || 1); %>
            <% const pipeName = stRow ? stRow.name.replace(/\s*\(.*$/, '').trim() : 'Stage'; %>
            <% const pipeShort = pipeName.length > 26 ? pipeName.slice(0, 26) + '…' : pipeName; %>
            <% const _dot = stRow && stRow.color ? stRow.color : '#94a3b8'; %>
            <% const rawDeliveryStatus = lead.status || 'Not Contacted'; %>
            <% const deliveryStatusDisplay = rawDeliveryStatus === 'Needs Video' ? 'Not Contacted' : rawDeliveryStatus; %>
            <% const rowAnchor = String(lead.key || '').replace(/[^a-z0-9]+/gi, '-'); %>
            <% const _createdRaw = lead.createdAt || lead.savedAt; %>
            <% let _addedShort = ''; let _createdSortMs = 0; if (_createdRaw) { try { const _d = new Date(_createdRaw); _addedShort = _d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }); const _t = _d.getTime(); _createdSortMs = Number.isFinite(_t) ? _t : 0; } catch (e) {} } %>
            <% 
              var _ph = lead.phone && lead.phone !== 'N/A' ? String(lead.phone) : '';
              var _em = lead.email && lead.email !== 'N/A' ? String(lead.email) : '';
              var _ws = lead.website && lead.website !== 'N/A' ? String(lead.website) : '';
              var _wsLabel = _ws ? _ws.replace(/^https?:\/\//i, '').split('?')[0].replace(/\/$/, '') : '';
              var _gm = googleMapsSocialHrefForLead(lead);
              var _fb = lead.facebook && lead.facebook !== 'N/A' ? String(lead.facebook) : '';
              var _ig = lead.instagram && lead.instagram !== 'N/A' ? String(lead.instagram) : '';
              var _tw = lead.twitter && lead.twitter !== 'N/A' ? String(lead.twitter) : '';
              var _rNum = lead.totalScore ? Number(lead.totalScore).toFixed(1) : '';
              var _rc = parseInt(String(lead.reviewsCount || 0), 10) || 0;
              var _claimSt = lead.gbpClaimStatus ? String(lead.gbpClaimStatus).trim() : '';
              var _gbpOpt = lead.gbpOptimizationScore ? String(lead.gbpOptimizationScore).trim() : '';
              var _lastTouchRaw = lead.updatedAt || lead.lastTouchAt || lead.lastContactAt || lead.createdAt || lead.savedAt || '';
              var _lastTouchShort = '—';
              var _lastTouchSortMs = 0;
              if (_lastTouchRaw) {
                try {
                  var _lt = new Date(_lastTouchRaw);
                  if (!Number.isNaN(_lt.getTime())) {
                    _lastTouchShort = _lt.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    _lastTouchSortMs = _lt.getTime();
                  }
                } catch (e) {}
              }
              var _ltc = String(lead.lastTouchChannel || '').trim();
              var _seqSt = lead.sequenceState;
              var _cadShort = '';
              if (_seqSt && _seqSt.templateId) {
                if (_seqSt.status === 'completed') {
                  _cadShort = 'Done';
                } else if (_ltc) {
                  _cadShort = _ltc;
                } else {
                  _cadShort = (_seqSt.status === 'active') ? 'Active' : String(_seqSt.status || '').trim();
                }
              }
              var _psk = '';
              if (lead.primaryServiceKey) _psk = String(lead.primaryServiceKey).trim();
              else if (lead.kieServiceInsight && lead.kieServiceInsight.primaryServiceKey) {
                _psk = String(lead.kieServiceInsight.primaryServiceKey).trim();
              }
            %>
            <tr class="result-row group/row scroll-mt-28 transition-colors duration-150 border-b border-brand-border/15 dark:border-white/[0.07]"
                onclick="if(window.__pipelineRowActivate){window.__pipelineRowActivate(event,this);}"
                id="lead-row-<%= rowAnchor %>"
                data-index="<%= i %>"
                data-lead-key="<%= lead.key %>"
                data-stage-id="<%= plcEscAttr(activeStageId || '') %>"
                data-pipeline-stage="<%= psRow %>"
                data-pipeline-label="<%= plcEscAttr(pipeShort) %>"
                data-title="<%= plcEscAttr(lead.title) %>"
                data-phone="<%= plcEscAttr(lead.phone || 'N/A') %>"
                data-website="<%= plcEscAttr(lead.website || 'N/A') %>"
                data-email="<%= plcEscAttr(lead.email || 'N/A') %>"
                data-category="<%= plcEscAttr(lead.categoryName || 'N/A') %>"
                data-address="<%= plcEscAttr(lead.address || 'N/A') %>"
                data-city="<%= plcEscAttr(lead.city || '') %>"
