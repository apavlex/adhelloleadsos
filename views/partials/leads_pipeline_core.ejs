<% if (leads.length > 0) { %>
  <!-- Bulk Actions Bar (for Leads) -->
  <div id="bulkActions" class="hidden items-center gap-3 mb-6 bg-white dark:bg-slate-900 p-3 rounded-2xl border border-brand-border dark:border-white/10 shadow-sm">
    <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 ml-2"><span id="selectedCount" class="text-brand-dark dark:text-white mr-1 text-sm font-black">0</span> SELECTED</span>
    <button type="button" class="js-bulk-export-csv btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 text-brand-dark dark:text-slate-100 hover:bg-brand-cream dark:hover:bg-slate-800 px-4 py-2 text-sm font-bold shadow-sm flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        Export
    </button>
    <button type="button" class="js-bulk-enhance btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all">
        ✨ Enrich All
    </button>
    <div class="h-6 w-px bg-brand-border/30 mx-2"></div>
    <button id="batchOutreachBtn" class="btn-pill bg-rose-500/10 border border-rose-500/30 text-rose-600 hover:bg-rose-500 hover:text-white px-4 py-2 text-sm font-black uppercase tracking-widest shadow-sm transition-all flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
        War Room
    </button>
  </div>      <!-- Table View Section -->
  <div id="tableView" class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50/50 dark:bg-slate-800/60 border-b border-brand-border dark:border-white/10">
            <th class="pl-6 pr-2 py-3 w-10">
              <div class="flex items-center">
                <input type="checkbox" id="selectAllLeads" class="w-4 h-4 rounded-md border-brand-border dark:border-slate-500 text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer">
              </div>
            </th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Company</th>
            <th class="px-3 py-3 text-[11px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Pipeline</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Phone</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Email</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Website</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Reviews</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300">Status</th>
            <th class="px-3 py-3 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-300 text-right pr-6">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border/50 dark:divide-white/10">
          <% leads.forEach((lead, i) => { %>
            <% const _ps = parseInt(lead.pipelineStage, 10); %>
            <% const psRow = !Number.isNaN(_ps) && _ps >= 1 && _ps <= 10 ? _ps : 1; %>
            <% const stRow = (typeof pipelineStages !== 'undefined' && pipelineStages) ? pipelineStages.find((s) => s.id === psRow) : null; %>
            <% const pipeName = stRow ? stRow.name.replace(/\s*\(.*$/, '').trim() : 'Stage'; %>
            <% const pipeShort = pipeName.length > 26 ? pipeName.slice(0, 26) + '…' : pipeName; %>
            <% const rawDeliveryStatus = lead.status || 'Not Contacted'; %>
            <% const deliveryStatusDisplay = rawDeliveryStatus === 'Needs Video' ? 'Not Contacted' : rawDeliveryStatus; %>
            <% const rowAnchor = String(lead.key || '').replace(/[^a-z0-9]+/gi, '-'); %>
            <% const _createdRaw = lead.createdAt || lead.savedAt; %>
            <% let _addedShort = ''; if (_createdRaw) { try { _addedShort = new Date(_createdRaw).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }); } catch (e) {} } %>
            <tr class="result-row scroll-mt-28"
                id="lead-row-<%= rowAnchor %>"
                data-index="<%= i %>"
                data-lead-key="<%= lead.key %>"
                data-pipeline-stage="<%= psRow %>"
                data-pipeline-label="<%= pipeShort.replace(/"/g, '&quot;') %>"
                data-title="<%= lead.title %>"
                data-phone="<%= lead.phone || 'N/A' %>"
                data-website="<%= lead.website || 'N/A' %>"
                data-email="<%= lead.email || 'N/A' %>"
                data-category="<%= lead.categoryName || 'N/A' %>"
                data-address="<%= lead.address || 'N/A' %>"
                data-city="<%= lead.city || '' %>"
                data-rating="<%= lead.totalScore || 0 %>"
                data-reviews="<%= lead.reviewsCount || 0 %>"
                data-url="<%= lead.url || '' %>"
                data-facebook="<%= lead.facebook || 'N/A' %>"
                data-instagram="<%= lead.instagram || 'N/A' %>"
                data-twitter="<%= lead.twitter || 'N/A' %>"
                data-status="<%= deliveryStatusDisplay %>"
                data-loom-url="<%= lead.loomUrl || '' %>"
                data-outreach-prompt="<%= lead.outreachPrompt || '' %>"
                data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'
                data-has-schema-markup="<%= lead.hasSchemaMarkup %>"
                data-has-chatbot="<%= lead.hasChatbot %>"
                data-has-click-to-call="<%= lead.hasClickToCall %>"
                data-is-mobile-friendly="<%= lead.isMobileFriendly %>"
                data-is-outdated="<%= lead.isOutdated %>"
                data-visual-modernity-score="<%= lead.visualModernityScore %>"
                data-aeo-score="<%= lead.aeoScore %>"
                data-geo-gaps="<%= lead.geoGaps %>"
                data-audit-summary="<%= lead.auditSummary %>"
                data-cms-platform="<%= lead.cmsPlatform || '' %>"
                data-buying-signals='<%= JSON.stringify(lead.buyingSignals || []).replace(/'/g, "&apos;") %>'
                data-source="<%= lead.source || '' %>"
                data-created-at="<%= (_createdRaw || '').toString().replace(/"/g, '&quot;') %>"
                data-audit-data='<%= JSON.stringify(lead.auditData || null).replace(/'/g, "&apos;") %>'
                data-chat-history='<%= JSON.stringify(lead.chatHistory || null).replace(/'/g, "&apos;") %>'
                data-cqi='<%= JSON.stringify(lead.cqi || null).replace(/'/g, "&apos;") %>'
                data-stitch-design-url="<%= lead.stitchDesignUrl || '' %>"
                data-stitch-screenshot-url="<%= lead.stitchScreenshotUrl || '' %>"
                data-stitch-screen-id="<%= lead.stitchScreenId || '' %>">
              <td class="pl-6 pr-2 py-3 align-top">
                <div class="flex items-start">
                  <input type="checkbox" class="lead-checkbox w-4 h-4 mt-1 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer" data-key="<%= lead.key %>">
                </div>
              </td>
              <td class="px-3 py-3 align-top">
                <div class="flex items-start gap-2.5 min-w-0 max-w-[14rem] sm:max-w-[16rem]">
                  <div class="w-8 h-8 shrink-0 bg-brand-yellow/10 dark:bg-brand-yellow/20 rounded-lg flex items-center justify-center font-display font-extrabold text-sm text-brand-dark dark:text-white border border-brand-yellow/20 group-hover:bg-brand-yellow group-hover:border-brand-yellow transition-all duration-300">
                    <%= lead.title.charAt(0).toUpperCase() %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="font-bold text-brand-dark dark:text-white group-hover:text-black dark:group-hover:text-brand-yellow transition-colors text-sm leading-tight truncate" title="<%= lead.title %>"><%= lead.title %></div>
                    <div class="flex items-center gap-1.5 mt-0.5 flex-wrap gap-y-0">
                      <% if (lead.source && lead.source.startsWith('adhello_')) { %>
                        <span class="text-[8px] font-black uppercase tracking-widest text-amber-600 dark:text-amber-400 shrink-0">Warm</span>
                      <% } else { %>
                        <span class="text-[8px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 shrink-0">Cold</span>
                      <% } %>
                      <span class="text-[9px] font-bold text-brand-muted dark:text-slate-400 uppercase tracking-wider truncate max-w-[7rem] sm:max-w-[9rem]" title="<%= lead.categoryName %>"><%= lead.categoryName %></span>
                    </div>
                    <p class="lead-row-address text-[10px] text-brand-muted dark:text-slate-500 mt-1 leading-snug line-clamp-2" title="<%= lead.address && lead.address !== 'N/A' ? lead.address : '' %>"><%= lead.address && lead.address !== 'N/A' ? lead.address : '—' %></p>
                    <% if (_addedShort) { %>
                    <p class="text-[9px] text-brand-muted/90 dark:text-slate-500 mt-0.5">Added <%= _addedShort %></p>
                    <% } %>
                  </div>
                </div>
              </td>
              <td class="px-3 py-3 pipeline-stage-cell align-top max-w-[11rem]" onclick="event.stopPropagation()">
                <% if (typeof pipelineStages !== 'undefined' && pipelineStages && pipelineStages.length) { %>
                <label class="sr-only">Pipeline stage for <%= lead.title %></label>
                <select class="pipeline-inline-select w-full min-w-0 max-w-[10.5rem] text-[12px] font-black text-brand-dark dark:text-white bg-brand-cream/50 dark:bg-slate-800 border border-brand-border/40 dark:border-white/10 rounded-lg px-2.5 py-2.5 shadow-sm focus:ring-2 focus:ring-brand-yellow cursor-pointer" title="Change pipeline stage" data-lead-key="<%= lead.key %>">
                  <% pipelineStages.forEach((st) => { %>
                    <% const optShort = st.name.length > 34 ? st.name.slice(0, 34) + '…' : st.name; %>
                    <option value="<%= st.id %>" <%= psRow === st.id ? 'selected' : '' %>><%= st.id %>. <%= optShort %></option>
                  <% }); %>
                </select>
                <% } else { %>
                <span class="pipeline-stage-label text-[12px] font-black text-brand-yellow"><%= psRow %>. <%= pipeShort %></span>
                <% } %>
              </td>
              <td class="px-3 py-3 text-xs font-medium text-brand-muted dark:text-slate-300 whitespace-nowrap max-w-[7rem] truncate" title="<%= lead.phone %>">
                <%= lead.phone && lead.phone !== 'N/A' ? lead.phone : '-' %>
              </td>
              <td class="px-3 py-3 text-[11px] font-medium text-brand-muted dark:text-slate-300 max-w-[9rem]">
                <% if (lead.email && lead.email !== 'N/A') { %>
                  <a href="mailto:<%= lead.email %>" class="text-brand-yellow hover:underline font-bold truncate block" title="<%= lead.email %>" onclick="event.stopPropagation()"><%= lead.email %></a>
                <% } else { %>
                  <span class="text-brand-muted/50 dark:text-slate-500 font-bold">—</span>
                <% } %>
              </td>
              <td class="px-3 py-3 text-xs font-medium text-brand-muted dark:text-slate-300 max-w-[6.5rem] sm:max-w-[8rem]">
                <% if (lead.website && lead.website !== 'N/A') { %>
                  <a href="<%= lead.website %>" target="_blank" class="website-link text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white transition-colors border-b border-transparent hover:border-brand-dark dark:hover:border-white pb-0.5 inline-block truncate max-w-full" title="<%= lead.website %>" data-url="<%= lead.website %>">
                      <%= lead.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                  </a>
                <% } else { %>
                  <span class="text-brand-muted/50 dark:text-slate-500 font-bold text-sm">-</span>
                <% } %>
              </td>
              <td class="px-3 py-3">
                <div class="flex items-center gap-1.5 min-h-[24px]">
                  <div class="row-stars flex items-center gap-0.5 shrink-0" aria-hidden="true"></div>
                  <div class="text-[10px] font-black text-brand-dark dark:text-slate-200 whitespace-nowrap">
                    <% if (lead.totalScore) { %>
                      <%= Number(lead.totalScore).toFixed(1) %>
                      <span class="text-[8px] font-bold text-brand-muted/60 dark:text-slate-500">(<%= lead.reviewsCount || 0 %>)</span>
                    <% } else { %>
                      <span class="text-brand-muted/50 dark:text-slate-500 font-bold">—<% if (lead.reviewsCount) { %> <span class="text-[8px] font-bold text-brand-muted/50">(<%= lead.reviewsCount %>)</span><% } %></span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td class="px-3 py-3">
                <% 
                  let statusClass = 'bg-gray-100 text-gray-500 dark:bg-slate-700 dark:text-slate-200';
                  if (deliveryStatusDisplay === 'Video Recorded') statusClass = 'bg-brand-yellow text-brand-dark dark:text-slate-900';
                  if (deliveryStatusDisplay === 'Email Sent') statusClass = 'bg-blue-50 text-blue-600 dark:bg-blue-950/50 dark:text-blue-300';
                  if (deliveryStatusDisplay === 'Follow-up') statusClass = 'bg-purple-50 text-purple-600 dark:bg-purple-950/50 dark:text-purple-300';
                  if (deliveryStatusDisplay === 'Closed - Won') statusClass = 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-300';
                  if (deliveryStatusDisplay === 'Closed - Lost') statusClass = 'bg-red-50 text-red-600 dark:bg-red-950/50 dark:text-red-300';
                %>
                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider <%= statusClass %> whitespace-nowrap max-w-[9rem] truncate inline-block align-middle" title="<%= deliveryStatusDisplay %>">
                  <%= deliveryStatusDisplay %>
                </span>
              </td>
              <td class="px-3 py-3 text-right pr-6">
                <div class="flex items-center justify-end gap-2 text-center">
                    <button type="button" class="email-intel-btn w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow hover:text-brand-dark transition-all" 
                      data-lead-key="<%= lead.key %>"
                      data-email="<%= lead.email && lead.email !== 'N/A' ? lead.email : '' %>"
                      data-company="<%= lead.title %>"
                      title="Service offerings &amp; AI recommendation">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </button>
                   <button type="button" class="view-detail-btn w-8 h-8 rounded-lg hover:bg-brand-yellow/10 text-brand-muted dark:text-slate-400 hover:text-brand-yellow dark:hover:text-brand-yellow transition-all flex items-center justify-center border border-transparent hover:border-brand-yellow/20">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
                   </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pipeline board: 10-stage methodology (drag cards between columns to update pipelineStage) -->
  <div id="kanbanView" class="hidden w-full overflow-x-auto pb-12 custom-scrollbar" data-kanban-mode="pipeline">
          <p class="text-xs text-brand-muted mb-4 max-w-3xl">Drag a card to another column to update its <strong class="text-brand-dark dark:text-white">pipeline stage</strong>. Delivery status (Not Contacted, Video Recorded, etc.) stays in table view — use your CRM column for fulfillment.</p>
      <div class="flex gap-4 min-w-max pb-2">
          <% if (typeof pipelineStages !== 'undefined' && pipelineStages) { pipelineStages.forEach((col) => { %>
          <div class="kanban-column w-[min(100vw-2rem,17rem)] shrink-0 flex flex-col gap-3" data-pipeline-stage="<%= col.id %>">
              <div class="flex items-center justify-between px-1 mb-1">
                  <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white leading-tight"><%= col.id %>. <%= col.name %></h3>
                  <span class="px-2 py-0.5 rounded-full bg-brand-cream dark:bg-slate-800 text-[10px] font-bold text-brand-muted dark:text-slate-300 column-count">0</span>
              </div>
              <div class="kanban-list min-h-[480px] flex flex-col gap-3 p-2 bg-brand-cream/20 dark:bg-white/5 rounded-3xl border border-dashed border-brand-border/40 dark:border-white/10"></div>
          </div>
          <% }); } %>
      </div>
  </div>

  <!-- Bulk Action Bar -->
  <div id="bulkActionBar" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-brand-dark text-white px-8 py-5 rounded-[2.5rem] shadow-2xl z-[150] flex flex-col gap-3 max-w-[calc(100vw-2rem)] opacity-0 translate-y-20 pointer-events-none transition-all duration-500 backdrop-blur-xl border border-white/10">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
      <div class="flex items-center gap-4 sm:border-r sm:border-white/10 sm:pr-8">
          <div id="selectedCountCircle" class="w-10 h-10 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-sm shadow-lg">0</div>
          <div class="text-sm font-bold text-white/90">Leads Selected</div>
      </div>
      
      <div class="flex flex-wrap items-center gap-4">
          <button type="button" class="js-bulk-enhance flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-yellow transition-all group overflow-hidden relative">
             <svg class="w-4 h-4 text-brand-yellow group-hover:animate-sparkle" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.25 15L18 16.125l-.25-1.125a1.125 1.125 0 00-.75-.75L15.875 14l1.125-.25a1.125 1.125 0 00.75-.75L18 11.875l.25 1.125a1.125 1.125 0 00.75.75l1.125.25-1.125.25a1.125 1.125 0 00-.75.75z" /></svg>
             <span class="text-xs font-black uppercase tracking-widest">Enhance</span>
          </button>
          <button type="button" class="js-bulk-export-csv flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-400 transition-all group">
             <svg class="w-4 h-4 text-blue-400 group-hover:translate-y-[-2px] transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
             <span class="text-xs font-black uppercase tracking-widest">Export CSV</span>
          </button>
          
          <div class="hidden sm:block w-px h-6 bg-white/10"></div>
          
          <button id="cancelSelectionBtn" class="text-xs font-bold text-white/50 hover:text-white transition-colors uppercase tracking-widest">Cancel</button>
      </div>
    </div>
    <button type="button" id="bulkDeleteBtn" class="w-full text-center pt-2 border-t border-white/10 text-xs font-black uppercase tracking-widest text-rose-400 hover:text-rose-300 transition-colors">
      Delete selected…
    </button>
  </div>
<% } else { %>
  <div class="brand-card p-24 text-center max-wide">
    <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
      <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" /></svg>
    </div>
    <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No saved leads</h2>
    <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">You haven't bookmarked any leads yet. Start searching to build your collection.</p>
    <a href="/" class="btn-pill btn-primary px-10">Start Searching</a>
  </div>
<% } %>
