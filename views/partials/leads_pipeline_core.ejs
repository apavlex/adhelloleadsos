              <td data-plc="actions" class="lead-actions-cell lead-col-tail-tight px-1.5 pr-4 sm:pr-5 align-middle border-b border-brand-border/15 dark:border-white/[0.07] text-right">
                <div class="flex items-center justify-end gap-1">
                    <button type="button" class="ai-analysis-btn w-8 h-8 rounded-lg bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-400/30 flex items-center justify-center hover:bg-sky-500/20 transition-all opacity-0 pointer-events-none group-hover/row:opacity-100 group-hover/row:pointer-events-auto" title="Hunt contacts &amp; reviews" aria-label="Hunt contacts and reviews">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
                    </button>
                    <%- include('quick_outreach_btn') %>
                   <button type="button" class="view-detail-btn w-8 h-8 rounded-lg hover:bg-brand-yellow/10 text-brand-muted dark:text-slate-400 hover:text-brand-yellow dark:hover:text-brand-yellow transition-all flex items-center justify-center border border-transparent hover:border-brand-yellow/20" title="Open lead details" aria-label="Open lead details">
                      <span class="sr-only">Details</span>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
                   </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <script>if (window.__primePipelinePrefsDom) window.__primePipelinePrefsDom();</script>
    </div>
    <div id="pipelineTablePaging" class="hidden flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-t border-brand-border/20 dark:border-white/10 bg-white/50 dark:bg-slate-900/50">
      <p id="pipelineTablePageStatus" class="text-[11px] font-semibold text-brand-muted dark:text-slate-400"></p>
      <div class="flex flex-wrap items-center gap-3">
        <label for="pipelineTablePageSizeSelect" class="flex items-center gap-2 text-[11px] font-semibold text-brand-muted dark:text-slate-400">
          <span>Show</span>
          <select id="pipelineTablePageSizeSelect" class="rounded-lg border border-brand-border/35 dark:border-white/15 bg-white dark:bg-slate-900 text-brand-dark dark:text-white text-[11px] font-bold px-2 py-1.5 focus:ring-2 focus:ring-brand-yellow/40 focus:outline-none" aria-label="Rows per page">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
          <span>per page</span>
        </label>
        <button type="button" id="pipelineTableLoadMore" class="hidden btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/15 text-brand-dark dark:text-white text-[10px] font-black uppercase tracking-widest px-4 py-2 hover:border-brand-yellow/50 transition-colors">Load more</button>
      </div>
    </div>
  </div>
  <script src="/js/pipeline-view-toggle.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
  <script src="/js/pipeline-kanban.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>

  <!-- Pipeline board: workspace stages (drag cards to update stage) -->
  <div id="kanbanView" class="hidden w-full overflow-x-auto pb-12 custom-scrollbar" data-kanban-mode="pipeline">
          <div class="mb-4">
            <%- include('/partials/help/kanban_drag_info') %>
          </div>
      <div class="flex gap-4 min-w-max pb-2">
          <% if (typeof pipelineStages !== 'undefined' && pipelineStages) { pipelineStages.forEach((col) => { %>
          <div class="kanban-column w-[min(100vw-2rem,17rem)] shrink-0 flex flex-col gap-3" data-pipeline-stage="<%= col.id %>">
              <div class="flex items-center justify-between px-1 mb-1">
                  <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white leading-tight<% if (col.description) { %> cursor-help border-b border-dotted border-brand-border/50 dark:border-white/20<% } %>"<% if (col.description) { %> title="<%= String(col.description).replace(/"/g, '&quot;') %>"<% } %>><%= col.name %></h3>
                  <span class="px-2 py-0.5 rounded-full bg-brand-cream dark:bg-slate-800 text-[10px] font-bold text-brand-muted dark:text-slate-300 column-count">0</span>
              </div>
              <div class="kanban-list kanban-drop-zone min-h-[480px] flex flex-col gap-3 p-2 bg-brand-cream/20 dark:bg-white/5 rounded-3xl border border-dashed border-brand-border/40 dark:border-white/10"></div>
          </div>
          <% }); } %>
      </div>
  </div>

  <!-- Bulk Action Bar -->
  <%- include('./bulk_action_bar', { bulkBarMode: 'pipeline' }) %>
<% } else { %>
  <% var _emptyFk = typeof activeFolderKey !== 'undefined' && activeFolderKey ? String(activeFolderKey) : ''; var _emptyFName = ''; if (_emptyFk && typeof folders !== 'undefined' && folders) { folders.forEach(function (fd) { if (fd && String(fd.key) === _emptyFk && !_emptyFName) _emptyFName = fd.name || ''; }); } %>
  <div class="brand-card p-16 md:p-24 text-center max-wide dark:bg-slate-900 dark:border-white/10">
    <div class="w-20 h-20 bg-brand-yellow/15 dark:bg-brand-yellow/10 rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-yellow/30">
      <svg class="w-10 h-10 text-brand-yellow/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" /></svg>
    </div>
    <% if (_emptyFName) { %>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">No leads in “<%= _emptyFName %>”</h2>
    <p class="text-sm text-brand-muted dark:text-slate-300 font-medium mb-2 max-w-lg mx-auto leading-relaxed">Run a search from <a href="/leads/find" class="font-bold text-brand-yellow hover:underline">Find More Leads</a> and save into this folder (or a trade subfolder under it). You can also <strong class="text-brand-dark dark:text-white">Import</strong> CSV/XLSX from the toolbar above, or move unfiled leads from the <a href="/prospecting?tab=pipeline" class="font-bold text-brand-yellow hover:underline">main pipeline</a> with bulk <strong class="text-brand-dark dark:text-white">Move</strong>.</p>
    <p class="text-[11px] text-brand-muted dark:text-slate-400 mb-10 max-w-sm mx-auto">Once leads appear, switch to <strong class="text-brand-dark dark:text-white">Pipeline</strong> view and drag cards between stages — new leads start in <strong class="text-brand-dark dark:text-white">New</strong>.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
      <a href="/leads/find" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">Run a search</a>
      <a href="/prospecting?tab=folders" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-8 py-3 text-xs font-black uppercase tracking-widest hover:border-brand-yellow/60">Folder manager</a>
    </div>
    <p class="text-[11px] text-brand-muted dark:text-slate-400 max-w-sm mx-auto"><a href="/prospecting?tab=pipeline" class="font-bold text-brand-yellow hover:underline">Main pipeline (unfiled)</a></p>
    <% } else { %>
    <% const _folderedCount = typeof folderedLeadCount !== 'undefined' ? Number(folderedLeadCount) : 0; %>
    <% const _totalLeads = typeof totalVisibleLeadCount !== 'undefined' ? Number(totalVisibleLeadCount) : 0; %>
    <% const _csvLeads = typeof csvImportLeadCount !== 'undefined' ? Number(csvImportLeadCount) : 0; %>
    <% if (!_emptyFName && _csvLeads > 0 && _totalLeads > 0) { %>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Imported leads aren’t on the main board</h2>
    <p class="text-brand-muted max-w-lg mx-auto mb-4 leading-relaxed">You have <strong class="text-brand-dark dark:text-white"><%= _csvLeads %></strong> imported lead<%= _csvLeads === 1 ? '' : 's' %> in this workspace<% if (_folderedCount > 0) { %> — <strong class="text-brand-dark dark:text-white"><%= _folderedCount %></strong> are filed in folders<% } %>.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
      <a href="/prospecting?tab=pipeline&amp;origin=csv&amp;includeFoldered=1&amp;source=all" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">View imported leads</a>
      <a href="/prospecting?tab=folders" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-8 py-3 text-xs font-black uppercase tracking-widest hover:border-brand-yellow/60">Open folders</a>
    </div>
    <% } else if (!_emptyFName && _folderedCount > 0 && _totalLeads > 0) { %>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Main pipeline is empty</h2>
    <p class="text-brand-muted max-w-lg mx-auto mb-4 leading-relaxed">You have <strong class="text-brand-dark dark:text-white"><%= _folderedCount %></strong> lead<%= _folderedCount === 1 ? '' : 's' %> in folders — they don’t appear on the unified board until you open that folder or move them here.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
      <a href="/prospecting?tab=folders" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">Open folder manager</a>
      <a href="/prospecting?tab=pipeline&amp;source=all" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-8 py-3 text-xs font-black uppercase tracking-widest hover:border-brand-yellow/60">Reset filters</a>
    </div>
    <% } else { %>
    <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Your Pipeline is empty</h2>
    <p class="text-brand-muted max-w-md mx-auto mb-8">Run a lead search to pull SMBs, or load sample leads to see how stages and cadences look.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="/leads/find" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">Run your first search</a>
      <form method="post" action="/today/seed-demo" class="inline">
        <button type="submit" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-8 py-3 text-xs font-black uppercase tracking-widest hover:border-brand-yellow/60">
          Load sample leads
        </button>
      </form>
    </div>
    <% } %>
    <% } %>
  </div>
<% } %>
