<% const _sec = typeof workspaceSection !== 'undefined' ? workspaceSection : ''; %>
<% const _ws = typeof workspace !== 'undefined' ? workspace : null; %>
<% const _can = typeof canManageWorkspace !== 'undefined' && canManageWorkspace; %>
<% const _hasId = _ws && _ws.id; %>
<% const _wsNavBase = 'ws-nav-item shrink-0 whitespace-nowrap rounded-xl px-3 py-2 border text-[10px] font-black uppercase tracking-widest transition-colors '; %>
<% const _wsNavOn = _wsNavBase + 'ws-nav-item-active bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm shadow-brand-yellow/30'; %>
<% const _wsNavOff = _wsNavBase + 'border-brand-border/40 dark:border-white/10 text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white hover:bg-brand-yellow/15 hover:border-brand-yellow/40'; %>
<section class="ws-settings-nav mb-8 pb-4 border-b border-brand-border/40 dark:border-white/10" aria-label="Workspace settings">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0 flex-1 -mx-1 px-1">
      <nav class="flex flex-nowrap items-center gap-1.5 overflow-x-auto custom-scrollbar pb-0.5" id="wsSettingsNav">
        <% if (_can && _hasId) { %>
        <a href="/workspace/pipeline" data-ws-nav="pipeline stages board" class="<%= _sec === 'pipeline' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'pipeline' ? ' aria-current="page"' : '' %>>Pipeline</a>
        <a href="/workspace/branding" data-ws-nav="brand accent color theme" class="<%= _sec === 'branding' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'branding' ? ' aria-current="page"' : '' %>>Brand accent</a>
        <% } %>
        <a href="/workspace/team" data-ws-nav="team members roles invite" class="<%= _sec === 'team' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'team' ? ' aria-current="page"' : '' %>>Team</a>
        <a href="/workspace/integrations" data-ws-nav="integrations api keys chrome extension lead saver apify outscraper firecrawl rapidapi scrape stack maps crawl4ai cost enrich" class="<%= _sec === 'integrations' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'integrations' ? ' aria-current="page"' : '' %>>Integrations</a>
        <% if (_can) { %>
        <a href="/workspace/phones" data-ws-nav="phone bank numbers cnam signalwire outbound" class="<%= _sec === 'phones' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'phones' ? ' aria-current="page"' : '' %>>Phone bank</a>
        <a href="/workspace/voicemail" data-ws-nav="voicemail weekly drop recording" class="<%= _sec === 'voicemail' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'voicemail' ? ' aria-current="page"' : '' %>>Voicemail</a>
        <% } %>
        <a href="/workspace/routing" data-ws-nav="round robin routing assign inbound sdr" class="<%= _sec === 'routing' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'routing' ? ' aria-current="page"' : '' %>>Round-robin</a>
        <% if (_can) { %>
        <a href="/workspace/revenue" data-ws-nav="revenue deal value timezone brief" class="<%= _sec === 'revenue' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'revenue' ? ' aria-current="page"' : '' %>>Revenue</a>
        <a href="/workspace/info-packs" data-ws-nav="info pack sms email direct mail lob send" class="<%= _sec === 'info-packs' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'info-packs' ? ' aria-current="page"' : '' %>>Info packs</a>
        <% } %>
        <a href="/workspace/advanced" data-ws-nav="advanced workspace id" class="<%= _sec === 'advanced' ? _wsNavOn : _wsNavOff %>"<%= _sec === 'advanced' ? ' aria-current="page"' : '' %>>Advanced</a>
      </nav>
    </div>
    <div class="shrink-0 w-full lg:w-52">
      <label for="wsSettingsSearch" class="sr-only">Search settings</label>
      <input id="wsSettingsSearch" type="search" autocomplete="off" placeholder="Search sections…" class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs text-brand-dark dark:text-white placeholder:text-brand-muted" />
    </div>
  </div>
  <script>
  (function () {
    var input = document.getElementById('wsSettingsSearch');
    var nav = document.getElementById('wsSettingsNav');
    if (!input || !nav) return;
    input.addEventListener('input', function () {
      var q = String(input.value || '').trim().toLowerCase();
      var links = nav.querySelectorAll('a.ws-nav-item');
      for (var i = 0; i < links.length; i++) {
        var a = links[i];
        var hay = (a.textContent + ' ' + (a.getAttribute('data-ws-nav') || '')).toLowerCase();
        a.style.display = !q || hay.indexOf(q) !== -1 ? '' : 'none';
      }
    });
  })();
  </script>
</section>
