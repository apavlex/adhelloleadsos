<%# News & updates — workspace → Reviews-app members (app alert and/or SMS).
    Accepts canManage + totals.members on Referral Leads, or networkMemberTotals on Referral Network. %>
<%
  const newsCanManage = typeof canManage !== 'undefined' ? !!canManage : !!(typeof canShareJoinUrl !== 'undefined' && canShareJoinUrl);
  const newsTotals = (typeof networkMemberTotals !== 'undefined' && networkMemberTotals)
    ? networkMemberTotals
    : (typeof totals !== 'undefined' ? totals : null);
  const newsBusinesses = (typeof newsAudienceMembers !== 'undefined' && Array.isArray(newsAudienceMembers))
    ? newsAudienceMembers
    : ((typeof activeMembers !== 'undefined' && Array.isArray(activeMembers))
      ? activeMembers.filter(function (m) { return m && !m.workspaceStaff; })
      : []);
%>
<% if (newsCanManage && newsTotals && newsTotals.members) { %>
<details class="net-card net-more mb-4" id="net-message-members" <%= typeof notice !== 'undefined' && notice && /Posted news|phone alert|News & updates|text/i.test(String(notice)) ? 'open' : '' %>>
  <summary class="flex items-center justify-between gap-2">
    <span class="font-display font-bold">News &amp; updates</span>
    <span class="net-btn net-btn-ghost">App alert or SMS</span>
  </summary>
  <p class="mt-3 text-[13px] text-brand-muted leading-relaxed">Post news, links, and app updates for people using the Reviews app. They open it from <strong class="text-brand-dark dark:text-white">Notifications → News &amp; updates</strong>. Pick who gets it, then choose app alert and/or SMS next to the send button.</p>
  <form method="post" action="/network/members/broadcast" class="mt-3 space-y-3" id="netBroadcastForm">
    <div>
      <label class="net-label" for="netBroadcastTitle">Title</label>
      <input id="netBroadcastTitle" name="title" type="text" class="net-input" maxlength="120" required placeholder="e.g. New referral bonus this weekend">
    </div>
    <div>
      <label class="net-label" for="netBroadcastMessage">Update</label>
      <textarea id="netBroadcastMessage" name="message" rows="3" class="net-input" maxlength="800" required placeholder="What should partners know? Tips, deadlines, app changes…"></textarea>
    </div>
    <div>
      <label class="net-label" for="netBroadcastLink">Link (optional)</label>
      <input id="netBroadcastLink" name="link" type="url" class="net-input" maxlength="500" placeholder="https://…">
    </div>
    <div>
      <label class="net-label" for="netBroadcastAudience">Audience</label>
      <select id="netBroadcastAudience" name="audience" class="net-input">
        <option value="all">All active members (<%= newsTotals.members %>)</option>
        <option value="free">App trial only (<%= newsTotals.freeMembers || 0 %>)</option>
        <option value="partner">Partners only (<%= newsTotals.partnerMembers || 0 %>)</option>
        <option value="member">One business…</option>
      </select>
    </div>
    <div id="netBroadcastMemberWrap" class="hidden">
      <label class="net-label" for="netBroadcastMemberId">Business</label>
      <select id="netBroadcastMemberId" name="memberId" class="net-input" disabled>
        <option value="">Pick a business…</option>
        <% newsBusinesses.forEach(function (m) { %>
        <option value="<%= m.id %>"><%= m.companyName || m.name || m.id %><%= m.contactName ? ' · ' + m.contactName : '' %></option>
        <% }); %>
      </select>
      <% if (!newsBusinesses.length) { %>
      <p class="mt-1 text-[12px] text-brand-muted">No active businesses yet. Add members on Referral Leads first.</p>
      <% } %>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
      <div>
        <span class="net-label">Notify via</span>
        <div class="net-checks">
          <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-600 px-3 py-1.5 text-[13px] font-semibold cursor-pointer">
            <input type="checkbox" name="channelApp" value="1" checked> Notify by app
          </label>
          <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-600 px-3 py-1.5 text-[13px] font-semibold cursor-pointer">
            <input type="checkbox" name="channelSms" value="1"> Send SMS
          </label>
        </div>
      </div>
      <button type="submit" class="net-btn net-btn-yellow shrink-0" onclick="return confirm('Post this update and notify the selected members?');">Post update</button>
    </div>
  </form>
  <script>
  (function () {
    var form = document.getElementById('netBroadcastForm');
    if (!form || form.getAttribute('data-net-broadcast-ready')) return;
    form.setAttribute('data-net-broadcast-ready', '1');
    var audience = document.getElementById('netBroadcastAudience');
    var wrap = document.getElementById('netBroadcastMemberWrap');
    var member = document.getElementById('netBroadcastMemberId');
    function syncMember() {
      var one = audience && audience.value === 'member';
      if (wrap) wrap.classList.toggle('hidden', !one);
      if (member) {
        member.disabled = !one;
        member.required = !!one;
      }
    }
    if (audience) audience.addEventListener('change', syncMember);
    syncMember();
  })();
  </script>
  <% const newsPosts = typeof networkNewsPosts !== 'undefined' && Array.isArray(networkNewsPosts) ? networkNewsPosts : []; %>
  <% if (newsPosts.length) { %>
  <div class="mt-4 border-t border-slate-200 dark:border-slate-700 pt-3 space-y-2">
    <p class="net-label">Recent posts</p>
    <% newsPosts.forEach(function (p) { %>
    <div class="flex flex-wrap items-start justify-between gap-2 rounded-xl border border-slate-200/80 dark:border-slate-600 px-3 py-2">
      <div class="min-w-0 flex-1">
        <p class="text-[13px] font-bold text-brand-dark dark:text-white"><%= p.title %></p>
        <p class="text-[12px] text-brand-muted mt-0.5 line-clamp-2"><%= p.body %></p>
        <% if (p.link) { %><p class="text-[11px] font-semibold mt-1 truncate"><a class="underline" href="<%= p.link %>" target="_blank" rel="noopener noreferrer"><%= p.link %></a></p><% } %>
      </div>
      <form method="post" action="/network/members/news/<%= encodeURIComponent(p.id) %>/remove" onsubmit="return confirm('Remove this news post from the app feed?');">
        <button type="submit" class="net-btn net-btn-ghost">Remove</button>
      </form>
    </div>
    <% }); %>
  </div>
  <% } %>
</details>
<% } %>
