<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <main class="max-wide mx-auto px-6 pt-10 pb-24">
    <%- include('partials/workspace_sidebar') %>
    <div class="min-w-0">
        <% const _wsSec = typeof workspaceSection !== 'undefined' ? workspaceSection : 'team'; %>
        <nav class="text-xs text-brand-muted mb-3" aria-label="Breadcrumb">
          <a href="/workspace" class="hover:underline">Workspace</a>
          <span class="mx-1.5 opacity-60">/</span>
          <span class="font-semibold text-brand-dark dark:text-white"><%= typeof workspaceSectionTitle !== 'undefined' ? workspaceSectionTitle : 'Settings' %></span>
        </nav>
        <% if (_wsSec !== 'team') { %>
        <header class="mb-8 pb-6 border-b border-brand-border/50 dark:border-white/10">
          <h1 class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white mb-2">
            <%= typeof workspaceSectionTitle !== 'undefined' ? workspaceSectionTitle : 'Workspace' %>
          </h1>
          <p class="text-sm text-brand-muted max-w-2xl leading-relaxed">
            <%= typeof workspaceSectionDescription !== 'undefined' ? workspaceSectionDescription : '' %>
          </p>
          <% if (workspace && workspace.name) { %>
          <p class="mt-3 text-sm font-semibold text-brand-dark dark:text-white"><%= workspace.name %></p>
          <% } %>
          <% if (workspace && workspace.id) { %>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button type="button" id="wsCopyWorkspaceId" class="text-[10px] font-black uppercase tracking-widest rounded-lg border border-brand-border/50 dark:border-white/15 px-3 py-1.5 text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/40 transition-colors">
              Copy workspace ID
            </button>
            <span id="wsCopyWorkspaceIdMsg" class="text-[10px] text-emerald-700 dark:text-emerald-300 hidden" aria-live="polite">Copied</span>
          </div>
          <script>
          (function () {
            var btn = document.getElementById('wsCopyWorkspaceId');
            var msg = document.getElementById('wsCopyWorkspaceIdMsg');
            if (!btn) return;
            btn.addEventListener('click', function () {
              var id = <%- JSON.stringify(workspace && workspace.id ? workspace.id : '') %>;
              function flash() {
                if (msg) { msg.classList.remove('hidden'); window.setTimeout(function () { msg.classList.add('hidden'); }, 1600); }
              }
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(id).then(flash).catch(function () { window.prompt('Workspace ID', id); });
              } else {
                window.prompt('Workspace ID', id);
              }
            });
          })();
          </script>
          <% } %>
        </header>
        <% } %>
        <% if (_wsSec === 'pipeline') { %><%- include('workspace/sections/pipeline') %><% } %>
        <% if (_wsSec === 'branding') { %><%- include('workspace/sections/branding') %><% } %>
        <% if (_wsSec === 'team') { %><%- include('workspace/sections/team') %><% } %>
        <% if (_wsSec === 'integrations') { %><%- include('workspace/sections/integrations') %><% } %>
        <% if (_wsSec === 'ghl-setup') { %><%- include('workspace/sections/ghl_setup') %><% } %>
        <% if (_wsSec === 'lob-setup') { %><%- include('workspace/sections/lob_setup') %><% } %>
        <% if (_wsSec === 'phones') { %><%- include('workspace/sections/phones') %><% } %>
        <% if (_wsSec === 'voicemail') { %><%- include('workspace/sections/voicemail') %><% } %>
        <% if (_wsSec === 'routing') { %><%- include('workspace/sections/routing') %><% } %>
        <% if (_wsSec === 'revenue') { %><%- include('workspace/sections/revenue') %><% } %>
        <% if (_wsSec === 'info-packs') { %><%- include('workspace/sections/info-packs') %><% } %>
        <% if (_wsSec === 'audit-page') { %><%- include('workspace/sections/audit-page') %><% } %>
        <% if (_wsSec === 'advanced') { %><%- include('workspace/sections/advanced') %><% } %>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
