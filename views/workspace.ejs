<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <style>html { scroll-behavior: smooth; }</style>
  <%- include('partials/navbar') %>
  <main class="max-wide mx-auto px-6 pt-12 pb-24">
    <h1 class="font-display font-extrabold text-4xl text-brand-dark dark:text-white mb-2">Workspace</h1>
    <p class="text-brand-muted mb-4"><%= workspace && workspace.name ? workspace.name : 'Main workspace' %> · ID <code class="text-xs bg-brand-cream dark:bg-slate-800 px-2 py-0.5 rounded"><%= workspace && workspace.id ? workspace.id : 'default' %></code></p>

    <nav class="sticky top-[4.75rem] z-30 -mx-6 px-6 py-3 mb-8 flex flex-wrap gap-2 items-center border-b border-brand-border/50 dark:border-white/10 bg-brand-bg/95 dark:bg-slate-950/90 backdrop-blur-md supports-[backdrop-filter]:bg-brand-bg/80 dark:supports-[backdrop-filter]:bg-slate-950/75" aria-label="Jump to workspace section">
      <% if (typeof SCRIPT_LIBRARY_KEYS !== 'undefined' && SCRIPT_LIBRARY_KEYS && SCRIPT_LIBRARY_KEYS.length) { %>
      <a href="#workspace-sales-scripts" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Sales scripts</a>
      <% } %>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && workspace && workspace.id) { %>
      <a href="#workspace-pipeline" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Pipeline</a>
      <a href="#workspace-brand-accent" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Brand accent</a>
      <% } %>
      <a href="#workspace-members" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Team</a>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
      <a href="#workspace-integrations" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">API keys</a>
      <a href="#workspace-phone-bank" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Phone bank</a>
      <% } %>
      <% if (typeof scrapeAdvisor !== 'undefined' && scrapeAdvisor) { %>
      <a href="#workspace-scrape-cost" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Scrape stack</a>
      <% } %>
      <a href="#workspace-round-robin" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Round-robin</a>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
      <a href="#workspace-revenue" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-dark dark:text-white hover:bg-brand-yellow/20 hover:border-brand-yellow/50 transition-colors">Revenue</a>
      <% } %>
      <a href="#workspace-advanced" class="px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-brand-border/60 dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white hover:bg-brand-cream/40 dark:hover:bg-white/5 transition-colors">Advanced</a>
    </nav>

    <% if (typeof SCRIPT_LIBRARY_KEYS !== 'undefined' && SCRIPT_LIBRARY_KEYS && SCRIPT_LIBRARY_KEYS.length) { %>
    <%- include('partials/workspace_scripts_panel') %>
    <% } %>

    <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && workspace && workspace.id) { %>
    <div id="workspace-pipeline" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 mb-8 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="font-bold text-lg text-brand-dark dark:text-white">Pipeline stages</h2>
        <p class="text-sm text-brand-muted mt-1">Reorder stages, apply presets, or redesign with AI. Leads stay mapped when you change the board.</p>
      </div>
      <a href="/workspaces/<%= workspace.id %>/settings/pipeline" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest shrink-0">Edit pipeline</a>
    </div>

    <% const _accentChoices = typeof workspaceAccentChoices !== 'undefined' && workspaceAccentChoices ? workspaceAccentChoices : []; %>
    <% const _accentCur = ((workspace && workspace.accentColor) ? workspace.accentColor : '#CA8A04').toString().toLowerCase(); %>
    <% const _accentIsUiPreset = _accentChoices.some(function (o) { return o.hex.toLowerCase() === _accentCur; }); %>
    <div id="workspace-brand-accent" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">Brand accent</h2>
      <p class="text-sm text-brand-muted mb-4">Primary buttons, nav highlights, and the workspace chip use this color. You can change it anytime after the workspace is created.</p>
      <% if (!_accentIsUiPreset && workspace && workspace.accentColor) { %>
      <p class="text-xs text-brand-muted mb-4 rounded-xl border border-brand-border/60 dark:border-white/10 px-3 py-2">Your saved accent is a custom color from setup. Pick <strong class="text-brand-dark dark:text-white">Amber</strong> or <strong class="text-brand-dark dark:text-white">Bright yellow</strong> below, then save to switch.</p>
      <% } %>
      <div class="flex flex-wrap gap-3 mb-4">
        <% _accentChoices.forEach(function (opt) { %>
        <label class="cursor-pointer flex-1 min-w-[140px] max-w-[220px]">
          <input type="radio" name="wsAccentChoice" value="<%= opt.hex %>" class="sr-only peer" <%= _accentCur === opt.hex.toLowerCase() ? 'checked' : '' %> />
          <span class="flex flex-col gap-2 rounded-2xl border-2 border-transparent peer-checked:border-brand-dark dark:peer-checked:border-white p-4 bg-brand-cream/40 dark:bg-slate-800/50 ring-2 ring-transparent peer-checked:ring-brand-yellow/80 transition-all">
            <span class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg shrink-0 border border-brand-border/50 dark:border-white/10" style="background-color:<%= opt.hex %>"></span>
              <span class="font-display font-bold text-brand-dark dark:text-white"><%= opt.label %></span>
            </span>
            <span class="text-xs text-brand-muted leading-snug"><%= opt.description %></span>
          </span>
        </label>
        <% }); %>
      </div>
      <p id="wsAccentMsg" class="hidden text-sm mb-3"></p>
      <button type="button" id="wsAccentSave" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save accent</button>
    </div>
    <% } %>

    <div id="workspace-members" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-4">Members & roles</h2>
      <% if (workspace && workspace.members) { %>
        <ul class="space-y-3">
          <% Object.entries(workspace.members).forEach(([email, meta]) => { %>
            <li class="flex flex-wrap justify-between gap-2 py-3 border-b border-brand-border/40 last:border-0">
              <span class="font-semibold"><%= email %></span>
              <span class="text-xs font-black uppercase tracking-widest px-2 py-1 rounded-lg bg-brand-yellow/15 text-amber-900 dark:text-amber-200"><%= meta.role %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-brand-muted">No members yet — sign in again to seed your account.</p>
      <% } %>
      <p class="text-xs text-brand-muted mt-6">
        <strong class="text-brand-dark dark:text-white">SDR access</strong> — set <code class="bg-brand-cream dark:bg-slate-800 px-1 rounded">WORKSPACE_SDR_EMAILS</code> (comma-separated) to mark SDRs. SDRs only see leads assigned to them. Admins can assign from the pipeline.
        <%= envHintSdr ? '' : ' Currently using role defaults only.' %>
      </p>
    </div>

    <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
    <div id="workspace-integrations" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">API integrations (this workspace)</h2>
      <p class="text-sm text-brand-muted mb-4 leading-relaxed">
        Keys saved here are used for <strong>everyone</strong> in this workspace (all roles). Non-empty values override server environment variables for that integration only.
      </p>
      <% if (integrationsMessage) { %>
        <p class="text-sm mb-4 rounded-xl px-4 py-3 <%= integrationsMessage.type === 'ok' ? 'bg-emerald-500/10 text-emerald-900 dark:text-emerald-200' : 'bg-amber-500/10 text-amber-900 dark:text-amber-100' %>"><%= integrationsMessage.text %></p>
      <% } %>
      <% if (!integrationsReady) { %>
        <p class="text-sm text-amber-900 dark:text-amber-200 bg-amber-500/10 rounded-xl px-4 py-3">Ask your operator to set <code class="text-xs bg-white/60 dark:bg-black/20 px-1 rounded">WORKSPACE_INTEGRATIONS_SECRET</code> (min 16 characters) on the server. Until then, the app uses only deployment env vars.</p>
      <% } else { %>
      <form method="post" action="/workspace/integrations" class="space-y-6">
        <% const masks = integrationMasks || {}; %>
        <div class="border-b border-brand-border/40 dark:border-white/10 pb-4">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Apify API token</label>
          <% if (masks.apifyApiToken) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.apifyApiToken %></p><% } %>
          <input type="password" name="apifyApiToken" autocomplete="off" placeholder="New token (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.apifyApiToken) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="apifyApiToken_clear" value="1" /> Remove saved token</label><% } %>
        </div>
        <div class="border-b border-brand-border/40 dark:border-white/10 pb-4">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outscraper API key</label>
          <% if (masks.outscraperApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiKey %></p><% } %>
          <input type="password" name="outscraperApiKey" autocomplete="off" placeholder="New key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.outscraperApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiKey_clear" value="1" /> Remove</label><% } %>
        </div>
        <div class="border-b border-brand-border/40 dark:border-white/10 pb-4">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outscraper API base (optional)</label>
          <% if (masks.outscraperApiBase) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiBase %></p><% } %>
          <input type="text" name="outscraperApiBase" autocomplete="off" placeholder="https://api.app.outscraper.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.outscraperApiBase) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiBase_clear" value="1" /> Remove</label><% } %>
        </div>
        <div class="border-b border-brand-border/40 dark:border-white/10 pb-4">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Firecrawl API key</label>
          <% if (masks.firecrawlApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.firecrawlApiKey %></p><% } %>
          <input type="password" name="firecrawlApiKey" autocomplete="off" placeholder="New key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.firecrawlApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="firecrawlApiKey_clear" value="1" /> Remove</label><% } %>
        </div>
        <div class="border-b border-brand-border/40 dark:border-white/10 pb-4">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Crawl4AI base URL</label>
          <% if (masks.crawl4aiBaseUrl) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.crawl4aiBaseUrl %></p><% } %>
          <input type="text" name="crawl4aiBaseUrl" autocomplete="off" placeholder="http://localhost:11235" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.crawl4aiBaseUrl) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="crawl4aiBaseUrl_clear" value="1" /> Remove</label><% } %>
        </div>
        <div class="pb-2">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Crawl4AI API token (optional)</label>
          <% if (masks.crawl4aiApiToken) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.crawl4aiApiToken %></p><% } %>
          <input type="password" name="crawl4aiApiToken" autocomplete="off" placeholder="Bearer token if required" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.crawl4aiApiToken) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="crawl4aiApiToken_clear" value="1" /> Remove</label><% } %>
        </div>
        <button type="submit" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save integrations</button>
      </form>
      <% } %>
    </div>
    <% } %>

    <%- include('partials/scrape_cost_advisor') %>

    <div id="workspace-round-robin" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">Round-robin pool</h2>
      <p class="text-sm text-brand-muted mb-4">Next inbound assignee cycles through admins + SDRs (used by “Round-robin assign”).</p>
      <% if (assignPool && assignPool.length) { %>
        <ol class="list-decimal list-inside text-sm text-brand-dark dark:text-white space-y-1">
          <% assignPool.forEach((e) => { %><li><%= e %></li><% }) %>
        </ol>
      <% } else { %>
        <p class="text-sm italic text-brand-muted">Add at least one admin or SDR member.</p>
      <% } %>
    </div>

    <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
    <% const _tp = workspace && workspace.telephony ? workspace.telephony : {}; %>
    <% const _entryList = Array.isArray(_tp.numberBankEntries) ? _tp.numberBankEntries : []; %>
    <% const _legacyBank = Array.isArray(_tp.numberBank) ? _tp.numberBank : []; %>
    <% const _entries = _entryList.length ? _entryList : _legacyBank.map(function (n) { return { number: n, callerName: '', cnamStatus: 'not_submitted', cnamNotes: '' }; }); %>
    <% const _activeFrom = (_tp.activeFromNumber || '').toString(); %>
    <div id="workspace-phone-bank" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">Phone number bank</h2>
      <p class="text-sm text-brand-muted mb-4">Manage outbound numbers and CNAM request status. Active number is used for call/SMS/voicemail actions.</p>
      <div class="space-y-4">
        <div id="wsPhoneBankList" class="space-y-2">
          <% _entries.forEach(function (entry, idx) { %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-2 items-center p-3 rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 ws-phone-entry" data-entry-index="<%= idx %>">
            <div class="md:col-span-3">
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Number</label>
              <input type="text" class="ws-phone-number w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.number || '').toString() %>" placeholder="+15551234567" />
            </div>
            <div class="md:col-span-3">
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Caller name</label>
              <input type="text" class="ws-phone-caller-name w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.callerName || '').toString() %>" placeholder="ADHELLO AI" />
            </div>
            <div class="md:col-span-3">
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM status</label>
              <select class="ws-phone-cnam-status w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs">
                <% const _st = (entry.cnamStatus || 'not_submitted').toString(); %>
                <% ['not_submitted','submitted','in_review','approved','rejected','live'].forEach(function (opt) { %>
                  <option value="<%= opt %>" <%= _st === opt ? 'selected' : '' %>><%= opt %></option>
                <% }); %>
              </select>
            </div>
            <div class="md:col-span-2">
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Active</label>
              <label class="inline-flex items-center gap-2 text-xs">
                <input type="radio" name="wsActiveCallerRadio" class="ws-phone-active" value="<%= (entry.number || '').toString() %>" <%= _activeFrom && _activeFrom === (entry.number || '').toString() ? 'checked' : '' %> />
                Use
              </label>
            </div>
            <div class="md:col-span-1 flex md:justify-end">
              <button type="button" class="ws-phone-remove text-[10px] font-black uppercase tracking-widest text-rose-600 hover:underline">Remove</button>
            </div>
            <div class="md:col-span-12">
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM notes</label>
              <input type="text" class="ws-phone-cnam-notes w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.cnamNotes || '').toString() %>" placeholder="Carrier ticket / support notes" />
            </div>
          </div>
          <% }); %>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="wsPhoneBankAdd" class="rounded-xl border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest">Add number</button>
          <button type="button" id="wsPhoneBankSubmitCnam" class="rounded-xl border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest">Submit CNAM request</button>
        </div>
        <p id="wsPhoneBankMsg" class="hidden text-sm"></p>
        <button type="button" id="wsPhoneBankSave" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save phone bank</button>
      </div>
    </div>

    <div id="workspace-revenue" class="scroll-mt-28 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mb-8">
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">Revenue defaults</h2>
      <p class="text-sm text-brand-muted mb-4">Used when a lead has no estimated value (pipeline metrics, reporting).</p>
      <div class="space-y-4 max-w-md">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Average deal value (USD)</label>
          <input type="number" id="wsAvgDealValue" min="1" step="100" value="<%= workspace && workspace.avgDealValue != null ? workspace.avgDealValue : 3000 %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Workspace timezone (morning brief)</label>
          <input type="text" id="wsTimezone" placeholder="America/New_York" value="<%= workspace && workspace.timezone ? workspace.timezone : '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <p class="text-[10px] text-brand-muted mt-1">IANA name, e.g. America/Los_Angeles</p>
        </div>
        <p id="wsSettingsMsg" class="hidden text-sm"></p>
        <button type="button" id="wsSettingsSave" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save revenue settings</button>
      </div>
    </div>
    <script>
    (function () {
      var btn = document.getElementById('wsPhoneBankSave');
      var msg = document.getElementById('wsPhoneBankMsg');
      var list = document.getElementById('wsPhoneBankList');
      var addBtn = document.getElementById('wsPhoneBankAdd');
      var submitBtn = document.getElementById('wsPhoneBankSubmitCnam');
      if (!btn) return;
      function bindEntryRow(row) {
        if (!row) return;
        var remove = row.querySelector('.ws-phone-remove');
        if (remove) {
          remove.addEventListener('click', function () {
            row.remove();
          });
        }
      }
      if (list) {
        Array.prototype.forEach.call(list.querySelectorAll('.ws-phone-entry'), bindEntryRow);
      }
      if (addBtn && list) {
        addBtn.addEventListener('click', function () {
          var div = document.createElement('div');
          div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 items-center p-3 rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 ws-phone-entry';
          div.innerHTML = '' +
            '<div class="md:col-span-3"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Number</label><input type="text" class="ws-phone-number w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="+15551234567" /></div>' +
            '<div class="md:col-span-3"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Caller name</label><input type="text" class="ws-phone-caller-name w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="ADHELLO AI" /></div>' +
            '<div class="md:col-span-3"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM status</label><select class="ws-phone-cnam-status w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs"><option value="not_submitted">not_submitted</option><option value="submitted">submitted</option><option value="in_review">in_review</option><option value="approved">approved</option><option value="rejected">rejected</option><option value="live">live</option></select></div>' +
            '<div class="md:col-span-2"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Active</label><label class="inline-flex items-center gap-2 text-xs"><input type="radio" name="wsActiveCallerRadio" class="ws-phone-active" value="" />Use</label></div>' +
            '<div class="md:col-span-1 flex md:justify-end"><button type="button" class="ws-phone-remove text-[10px] font-black uppercase tracking-widest text-rose-600 hover:underline">Remove</button></div>' +
            '<div class="md:col-span-12"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM notes</label><input type="text" class="ws-phone-cnam-notes w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="Carrier ticket / support notes" /></div>';
          list.appendChild(div);
          bindEntryRow(div);
        });
      }
      function collectEntries() {
        if (!list) return [];
        var rows = list.querySelectorAll('.ws-phone-entry');
        return Array.prototype.map.call(rows, function (row) {
          var number = (row.querySelector('.ws-phone-number') || {}).value || '';
          var callerName = (row.querySelector('.ws-phone-caller-name') || {}).value || '';
          var cnamStatus = (row.querySelector('.ws-phone-cnam-status') || {}).value || 'not_submitted';
          var cnamNotes = (row.querySelector('.ws-phone-cnam-notes') || {}).value || '';
          return { number: number, callerName: callerName, cnamStatus: cnamStatus, cnamNotes: cnamNotes };
        }).filter(function (x) { return x.number && x.number.trim(); });
      }
      function activeNumber() {
        var picked = document.querySelector('input[name="wsActiveCallerRadio"]:checked');
        if (!picked) return '';
        return String(picked.value || '').trim();
      }
      if (list) {
        list.addEventListener('input', function (e) {
          if (e.target && e.target.classList.contains('ws-phone-number')) {
            var row = e.target.closest('.ws-phone-entry');
            var active = row ? row.querySelector('.ws-phone-active') : null;
            if (active) active.value = e.target.value;
          }
        });
      }
      btn.addEventListener('click', function () {
        var entries = collectEntries();
        fetch('/workspace/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            phoneBankEntries: entries,
            activeCallerId: activeNumber(),
          }),
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (msg) {
            msg.classList.remove('hidden');
            msg.textContent = data && data.success ? 'Saved.' : (data && data.error) || 'Save failed';
            msg.className = 'text-sm ' + (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
          }
        }).catch(function () {
          if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Save failed'; msg.className = 'text-sm text-rose-600'; }
        });
      });
      if (submitBtn) {
        submitBtn.addEventListener('click', function () {
          var number = activeNumber();
          if (!number) {
            if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Select an active number first.'; msg.className = 'text-sm text-rose-600'; }
            return;
          }
          var row = document.querySelector('.ws-phone-entry input.ws-phone-active:checked');
          row = row ? row.closest('.ws-phone-entry') : null;
          var callerName = row ? ((row.querySelector('.ws-phone-caller-name') || {}).value || '') : '';
          var cnamNotes = row ? ((row.querySelector('.ws-phone-cnam-notes') || {}).value || '') : '';
          fetch('/workspace/phone-bank/cnam-submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ number: number, callerName: callerName, cnamNotes: cnamNotes }),
          }).then(function (r) { return r.json(); }).then(function (data) {
            if (msg) {
              msg.classList.remove('hidden');
              msg.textContent = data && data.success ? 'CNAM request submitted.' : (data && data.error) || 'Submit failed';
              msg.className = 'text-sm ' + (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
            }
          }).catch(function () {
            if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Submit failed'; msg.className = 'text-sm text-rose-600'; }
          });
        });
      }
    })();
    </script>
    <script>
    (function () {
      var btn = document.getElementById('wsSettingsSave');
      var msg = document.getElementById('wsSettingsMsg');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var avg = document.getElementById('wsAvgDealValue');
        var tz = document.getElementById('wsTimezone');
        fetch('/workspace/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            avgDealValue: avg ? avg.value : '',
            timezone: tz ? tz.value : '',
          }),
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (msg) {
            msg.classList.remove('hidden');
            msg.textContent = data && data.success ? 'Saved.' : (data && data.error) || 'Save failed';
            msg.className = 'text-sm ' + (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
          }
        }).catch(function () {
          if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Save failed'; msg.className = 'text-sm text-rose-600'; }
        });
      });
    })();
    </script>
    <script>
    (function () {
      var btn = document.getElementById('wsAccentSave');
      var msg = document.getElementById('wsAccentMsg');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var picked = document.querySelector('input[name="wsAccentChoice"]:checked');
        if (!picked) {
          if (msg) {
            msg.classList.remove('hidden');
            msg.textContent = 'Choose Amber or Bright yellow.';
            msg.className = 'text-sm mb-3 text-rose-600';
          }
          return;
        }
        fetch('/workspace/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ accentColor: picked.value }),
        }).then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); }).then(function (res) {
          if (msg) {
            msg.classList.remove('hidden');
            if (res.ok && res.data && res.data.success) {
              msg.textContent = 'Saved. Refreshing…';
              msg.className = 'text-sm mb-3 text-emerald-700 dark:text-emerald-300';
              window.location.reload();
            } else {
              msg.textContent = (res.data && res.data.error) || 'Save failed';
              msg.className = 'text-sm mb-3 text-rose-600';
            }
          }
        }).catch(function () {
          if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Save failed'; msg.className = 'text-sm mb-3 text-rose-600'; }
        });
      });
    })();
    </script>
    <% } %>

    <form id="workspace-advanced" method="post" action="/workspace/switch" class="scroll-mt-28 rounded-[2rem] border border-dashed border-brand-border dark:border-white/10 p-6">
      <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Workspace ID (advanced)</label>
      <input type="text" name="workspaceId" value="<%= workspace && workspace.id ? workspace.id : 'default' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm mb-3" />
      <button type="submit" class="text-xs font-black uppercase tracking-widest text-brand-yellow hover:underline">Switch session workspace</button>
      <p class="text-[10px] text-brand-muted mt-2">New leads and filters use this ID. Secondary workspaces are stubbed until you add a create-UI.</p>
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
