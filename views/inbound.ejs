<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <!-- SortableJS for Kanban -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Inbound Traffic</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          Inbound <span class="text-brand-muted">Leads</span>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          Showing <%= leads.length %> lead<%= leads.length !== 1 ? 's' : '' %> generated via AdHello.ai tools.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <!-- View Toggle -->
        <div class="flex items-center bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-1 shadow-sm mr-2">
            <button id="showTableView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-brand-yellow text-brand-dark shadow-sm">Table</button>
            <button id="showKanbanView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-brand-muted hover:text-brand-dark">Kanban</button>
        </div>
        <a href="/leads/find" class="btn-pill btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Find More Leads
        </a>
      </div>
    </div>

    <% if (leads.length > 0) { %>
      <!-- Bulk Actions Bar -->
      <div id="bulkActions" class="hidden items-center gap-3 mb-6 bg-white dark:bg-slate-900 p-3 rounded-2xl border border-brand-border dark:border-white/10 shadow-sm">
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-2"><span id="selectedCount" class="text-brand-dark mr-1 text-sm font-black">0</span> SELECTED</span>
        <button type="button" class="js-bulk-export-csv btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 text-brand-dark dark:text-slate-100 hover:bg-brand-cream dark:hover:bg-slate-800 px-4 py-2 text-sm font-bold shadow-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Export
        </button>
        <button type="button" class="js-bulk-enhance btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all">
            ✨ Enrich All
        </button>
      </div>

      <!-- Table View Section -->
      <div id="tableView" class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="pl-8 pr-4 py-5 w-10">
                  <div class="flex items-center">
                    <input type="checkbox" data-select-all-leads class="w-4 h-4 rounded-md border-brand-border dark:border-slate-500 text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer" title="Select all leads on this page" aria-label="Select all leads on this page">
                  </div>
                </th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Inbound Prospect</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Source</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Email</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-center">Score</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Enrichment</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Status</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-right pr-8">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% leads.forEach((lead, i) => { %>
                <tr class="result-row"
                    data-index="<%= i %>"
                    data-lead-key="<%= lead.key %>"
                    data-title="<%= lead.title %>"
                    data-email="<%= lead.email || 'N/A' %>"
                    data-phone="<%= lead.phone || 'N/A' %>"
                    data-website="<%= lead.website || 'N/A' %>"
                    data-source="<%= lead.source || 'adhello_inbound' %>"
                    data-status="<%= lead.status || 'Lead Captured' %>"
                    data-rating="<%= lead.totalScore || 0 %>"
                    data-reviews="<%= lead.reviewsCount || 0 %>"
                    data-audit-url="<%= lead.auditUrl || '' %>"
                    data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'
                    data-chat-history='<%= JSON.stringify(lead.chatHistory || null).replace(/'/g, "&apos;") %>'
                    data-blueprint="<%= lead.blueprint ? 'true' : 'false' %>">
                  <td class="pl-8 pr-4 py-6">
                    <div class="flex items-center">
                      <input type="checkbox" class="lead-checkbox w-4 h-4 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer" data-key="<%= lead.key %>">
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark border border-brand-yellow/20 group-hover:bg-brand-yellow group-hover:border-brand-yellow transition-all duration-300">
                        <%= lead.title.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <div class="font-bold text-brand-dark group-hover:text-black transition-colors text-base"><%= lead.title %></div>
                        <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5"><%= new Date(lead.createdAt).toLocaleDateString() %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest bg-brand-cream dark:bg-slate-800 text-brand-muted border border-brand-border/20">
                      <%= lead.source.replace('adhello_', '').replace('_', ' ') %>
                    </span>
                  </td>
                  <td class="px-6 py-6 text-sm font-bold dark:text-slate-300">
                    <% if (lead.email && lead.email !== 'N/A') { %>
                      <a href="mailto: <%= lead.email %>" class="hover:text-brand-yellow transition-colors underline decoration-brand-yellow/30 underline-offset-4">
                        <%= lead.email %>
                      </a>
                    <% } else { %>
                      <span class="text-brand-muted opacity-40">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-6 text-center">
                    <% if (lead.totalScore || lead.totalScore === 0) { %>
                        <% 
                            let scoreColor = 'text-red-500';
                            if (lead.totalScore >= 80) scoreColor = 'text-green-500';
                            else if (lead.totalScore >= 50) scoreColor = 'text-brand-yellow';
                        %>
                        <div class="flex flex-col items-center">
                            <span class="text-xl font-black <%= scoreColor %>"><%= Number(lead.totalScore).toFixed(0) %></span>
                            <span class="text-[8px] font-bold text-brand-muted uppercase tracking-tighter">Audit Score</span>
                        </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 font-bold">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-6">
                    <div class="flex flex-col gap-1.5">
                        <% if (lead.website && lead.website !== 'N/A') { %>
                            <a href="<%= lead.website %>" target="_blank" class="flex items-center gap-1.5 text-[11px] font-bold text-brand-muted hover:text-brand-dark transition-colors group/web">
                                <svg class="w-3.5 h-3.5 text-brand-muted/40 group-hover/web:text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                                <%= lead.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                            </a>
                        <% } %>
                        <% if (lead.phone && lead.phone !== 'N/A') { %>
                            <div class="flex items-center gap-1.5 text-[11px] font-bold text-brand-muted">
                                <svg class="w-3.5 h-3.5 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                <a href="#" class="js-click-to-call-number hover:text-brand-yellow transition-colors" data-phone="<%= lead.phone %>" data-lead-key="<%= lead.key %>" onclick="event.stopPropagation()"><%= lead.phone %></a>
                            </div>
                        <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <% 
                      let statusClass = 'bg-gray-100 text-gray-500';
                      if (lead.status === 'Blueprint Purchased') statusClass = 'bg-brand-yellow text-brand-dark';
                      if (lead.status === 'Lead Captured') statusClass = 'bg-blue-50 text-blue-600';
                    %>
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= statusClass %> whitespace-nowrap">
                      <%= lead.status %>
                    </span>
                  </td>
                  <td class="px-6 py-6 text-right pr-8">
                    <div class="flex items-center justify-end gap-2">
                       <% if (lead.auditUrl) { %>
                         <a href="<%= lead.auditUrl %>" target="_blank" class="w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-dark border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow transition-all" title="View Audit Report">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                         </a>
                       <% } %>
                       <%- include('partials/quick_outreach_btn') %>
                       <button type="button" class="view-detail-btn w-8 h-8 rounded-lg hover:bg-brand-yellow/10 text-brand-muted hover:text-brand-yellow transition-all flex items-center justify-center border border-transparent hover:border-brand-yellow/20">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
                       </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

       <!-- Kanban View (Reuse standard Kanban structure) -->
       <div id="kanbanView" class="hidden w-full overflow-x-auto pb-12 custom-scrollbar">
           <div class="flex gap-6 min-w-max">
               <div class="kanban-column w-80 flex flex-col gap-4" data-status="Lead Captured">
                   <div class="flex items-center justify-between px-2 mb-2">
                       <h3 class="text-xs font-black uppercase tracking-[0.2em] text-brand-muted">Captured</h3>
                       <span class="px-2 py-0.5 rounded-full bg-brand-cream dark:bg-slate-800 text-[10px] font-bold text-brand-muted column-count">0</span>
                   </div>
                   <div class="kanban-list min-h-[500px] flex flex-col gap-4 p-2 bg-brand-cream/20 dark:bg-white/5 rounded-3xl border border-dashed border-brand-border/30"></div>
               </div>
               <div class="kanban-column w-80 flex flex-col gap-4" data-status="Blueprint Purchased">
                   <div class="flex items-center justify-between px-2 mb-2">
                       <h3 class="text-xs font-black uppercase tracking-[0.2em] text-brand-yellow">Purchased</h3>
                       <span class="px-2 py-0.5 rounded-full bg-brand-yellow/10 text-[10px] font-bold text-brand-yellow column-count">0</span>
                   </div>
                   <div class="kanban-list min-h-[500px] flex flex-col gap-4 p-2 bg-brand-yellow/5 dark:bg-brand-yellow/5 rounded-3xl border border-dashed border-brand-yellow/20"></div>
               </div>
           </div>
       </div>

    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No inbound leads</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">No leads have come in from AdHello.ai yet. Once someone completes an audit or buys a blueprint, they'll appear here.</p>
        <a href="/today" class="btn-pill btn-primary px-10">Check AdHello Stats</a>
      </div>
    <% } %>
  </main>

  <!-- Detail Panel (Reused from leads.ejs) -->
  <%- include('partials/lead_detail_panel') %>
  <%- include('partials/email_intel_modal') %>

  <%- include('partials/footer') %>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
