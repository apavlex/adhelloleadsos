<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 md:py-12">
    <% if (typeof seededNotice !== 'undefined' && seededNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-300/50 bg-emerald-50/90 dark:bg-emerald-950/40 dark:border-emerald-500/30 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Sample leads were added to your Pipeline. You can edit or delete them anytime.
    </div>
    <% } %>
    <% if (typeof trackerSavedNotice !== 'undefined' && trackerSavedNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-400/40 bg-emerald-50/90 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Daily tracker saved. The same numbers appear on Reports → Daily action tracker.
    </div>
    <% } %>
    <% if (typeof scheduleSavedNotice !== 'undefined' && scheduleSavedNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-400/40 bg-emerald-50/90 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Schedule saved. Your lead run will start at the scheduled time.
    </div>
    <% } %>
    <% const _csHeader = typeof conversionSnapshot !== 'undefined' && conversionSnapshot ? conversionSnapshot : {}; %>
    <% const _pvHeader = typeof _csHeader.pipelineValueCreated7d === 'number' ? _csHeader.pipelineValueCreated7d : 0; %>
    <% const _touchesToday = typeof touchesToday !== 'undefined' ? touchesToday : 0; %>
    <% const _touchGoal = typeof touchGoal !== 'undefined' ? touchGoal : 54; %>
    <header class="mb-8 md:mb-10 flex flex-col gap-4">
      <% const _ta = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : ''; %>
      <p class="text-sm md:text-base text-brand-dark dark:text-white font-semibold border-b-2 pb-2 self-start" <% if (_ta) { %>style="border-color: <%= _ta %>"<% } %>>
        <span id="todayDaypart"><%= typeof greetingWord !== 'undefined' ? greetingWord : 'Hello' %></span>, <%= typeof firstName !== 'undefined' ? firstName : 'there' %> — <span id="todayDateLabel"><%= typeof dateLabel !== 'undefined' ? dateLabel : '' %></span>
      </p>
      <% if (typeof outreachCoach !== 'undefined' && outreachCoach) { %>
      <%- include('partials/prospecting_coach_card', { coachCardClass: 'mb-6 md:mb-8 ring-2 ring-brand-yellow/20 shadow-lg shadow-brand-yellow/10' }) %>
      <% } %>
      <%- include('partials/today_contact_queue') %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-4">
        <div class="rounded-xl border border-brand-border/60 dark:border-white/10 bg-white/75 dark:bg-slate-900/65 px-3 py-3">
          <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Replies received</p>
          <p class="font-display font-black text-xl text-brand-dark dark:text-white tabular-nums"><%= typeof repliesWaiting !== 'undefined' ? repliesWaiting : 0 %></p>
        </div>
        <div class="rounded-xl border border-brand-border/60 dark:border-white/10 bg-white/75 dark:bg-slate-900/65 px-3 py-3">
          <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Pipeline value (7d)</p>
          <p class="font-display font-black text-xl text-brand-dark dark:text-white tabular-nums">$<%= Math.round(_pvHeader).toLocaleString() %></p>
        </div>
        <div class="rounded-xl border border-brand-border/60 dark:border-white/10 bg-white/75 dark:bg-slate-900/65 px-3 py-3">
          <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Streak</p>
          <p class="font-display font-black text-xl text-emerald-600 dark:text-emerald-400 tabular-nums"><%= typeof streak !== 'undefined' ? streak : 0 %>d</p>
        </div>
      </div>
    </header>
    <script>
    (function () {
      function greetingWordLocal() {
        var h = new Date().getHours();
        if (h < 12) return 'Morning';
        if (h < 17) return 'Afternoon';
        return 'Evening';
      }
      var dp = document.getElementById('todayDaypart');
      if (dp) dp.textContent = greetingWordLocal();
      var dl = document.getElementById('todayDateLabel');
      if (dl) {
        dl.textContent = new Date().toLocaleDateString(undefined, {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }
    })();
    </script>

    <%- include('partials/review_today_widget', {
      touchesToday: _touchesToday,
      touchGoal: _touchGoal,
      streak: typeof streak !== 'undefined' ? streak : 0,
    }) %>

    <% const _fuTasks = typeof followUpTasksToday !== 'undefined' && followUpTasksToday ? followUpTasksToday : []; %>
    <% if (_fuTasks.length) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-label="Scheduled follow-ups">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Follow-ups</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Due &amp; overdue on your list</h2>
        </div>
        <a href="/tasks" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap shrink-0 self-start">All tasks</a>
      </div>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _fuTasks.forEach((t) => { %>
          <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-brand-dark dark:text-white"><%= t.title %></p>
              <p class="text-[11px] text-amber-800 dark:text-amber-200/90 mt-0.5"><%= t.scheduledAt ? new Date(t.scheduledAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '' %></p>
            </div>
            <% if (t.leadKey) { %>
              <a href="/pipeline?focusLead=<%= encodeURIComponent(t.leadKey) %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0"><%= t.leadTitle || 'Open lead' %></a>
            <% } else { %>
              <span class="text-[10px] font-bold text-brand-muted shrink-0">No lead linked</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% const _reportsOpened = typeof reportsOpened24h !== 'undefined' && reportsOpened24h ? reportsOpened24h : []; %>
    <% if (_reportsOpened.length) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-indigo-500/30 bg-indigo-500/[0.06] dark:bg-indigo-950/40 dark:border-indigo-500/25 px-6 py-6 md:px-8 md:py-7 shadow-sm" aria-label="Reports opened today">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-indigo-700 dark:text-indigo-200 mb-2">Hosted audit</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Reports opened today</h2>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-1">Leads who opened your site audit link in the last 24 hours — most recent first. Row opens Focus Mode.</p>
        </div>
        <a href="/reports?tab=site-audit" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap shrink-0 self-start">Site audit report</a>
      </div>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _reportsOpened.forEach(function (row) { %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
          <a href="/focus?lead=<%= encodeURIComponent(row.focusLeadParam) %>" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow truncate min-w-0"><%= row.leadTitle %></a>
          <span class="text-[11px] text-brand-muted whitespace-nowrap sm:ml-auto tabular-nums"><%= row.lastViewedAt ? new Date(row.lastViewedAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '' %><% if (row.durationSeconds) { %> · <%= row.durationSeconds %>s<% } %></span>
        </li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <% const _tl = typeof totalLeads !== 'undefined' ? totalLeads : 0; %>
    <% const empty = _tl === 0; %>
    <% const _leadTarget = 50; %>
    <% const _underProvisioned = !empty && _tl < _leadTarget; %>
    <% const _leadPct = Math.max(0, Math.min(100, Math.round((_tl / _leadTarget) * 100))); %>
    <% const _showAct = typeof showActivationRibbon !== 'undefined' && showActivationRibbon; %>
    <% const _isDayOne = typeof activation !== 'undefined' && activation && (activation.progress || 0) === 0; %>
    <% const _showDayOneHero = empty && _showAct && _isDayOne; %>

    <% if (empty) { %>
    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 px-6 py-8 md:px-8 md:py-10 mb-10 shadow-sm" aria-label="Get started">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Get started</p>
      <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Let’s pull your first 50 leads — takes about 90 seconds.</h1>
      <p class="text-sm md:text-base text-brand-muted max-w-2xl mb-6">Start with one search, then launch a call session. You can also load sample data to see the full pipeline flow first.</p>
      <div class="flex flex-col sm:flex-row gap-3 mb-4">
        <a href="/leads/find?preset=icp" class="btn-pill btn-primary px-8 py-3.5 text-xs font-black uppercase tracking-widest text-center shadow-lg">Pull first 50 leads</a>
        <% if (typeof icpLabel !== 'undefined') { %>
        <button type="button" id="todayIcpPill" class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-5 py-3 text-[11px] font-bold text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">
          <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted shrink-0">Step 0 · ICP</span>
          <span class="truncate max-w-[14rem]"><%= icpLabel %></span>
        </button>
        <% } %>
      </div>
      <form method="post" action="/today/seed-demo" class="inline">
        <button type="submit" class="text-sm font-bold text-brand-yellow hover:underline">Load sample data</button>
      </form>
    </section>
    <% } %>

    <% if (_underProvisioned) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/5 dark:border-brand-yellow/30 px-6 py-6 md:px-8 md:py-7" role="region" aria-label="Pipeline math">
      <div class="flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
        <div class="flex-1">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Pipeline math</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-1">You need about <%= _leadTarget %> active leads to support daily goals.</h2>
          <p class="text-sm text-brand-muted">At ~54 touches/day and ~3% reply rate, your current lead volume is below target.</p>
        </div>
        <div class="w-full md:w-72">
          <div class="flex items-center justify-between text-[11px] font-bold text-brand-dark dark:text-white mb-1.5">
            <span><%= _tl %> leads</span>
            <span>Target <%= _leadTarget %></span>
          </div>
          <div class="h-3 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= _leadTarget %>" aria-valuenow="<%= _tl %>">
            <div class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width:<%= _leadPct %>%"></div>
          </div>
          <div class="mt-3 flex gap-2">
            <a href="/leads/find?preset=icp" class="btn-pill btn-primary px-5 py-2 text-[10px] font-black uppercase tracking-widest">Add leads</a>
            <a href="/pipeline?action=import" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Import CSV</a>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <% if (_showDayOneHero) { %>
    <div id="dayOneActivationWrap" class="mb-10">
      <details id="dayOneActivationDetails" class="group rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-900/60 shadow-sm overflow-hidden">
        <summary class="cursor-pointer list-none px-4 md:px-6 py-4 flex flex-wrap items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 min-w-0">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow shrink-0">Day 1 activation</span>
            <span class="font-display font-bold text-lg text-brand-dark dark:text-white tabular-nums"><%= activation.progress %>/<%= activation.total %></span>
            <span class="text-xs text-brand-muted hidden sm:inline">Tap to expand checklist</span>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a href="/activation" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline pointer-events-auto" onclick="event.stopPropagation()">Full page</a>
            <button type="button" id="dayOneActivationDismiss" class="w-9 h-9 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white text-lg leading-none flex items-center justify-center" aria-label="Hide activation checklist">×</button>
            <span class="text-brand-muted text-lg transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
          </div>
        </summary>
        <div class="px-3 pb-4 md:px-5 md:pb-6 pt-0 border-t border-brand-border/30 dark:border-white/10">
          <%- include('partials/activation-7day', { activation, activationEmbed: true, activationHideEmbedChrome: true }) %>
        </div>
      </details>
    </div>
    <script>
    (function () {
      var wrap = document.getElementById('dayOneActivationWrap');
      var btn = document.getElementById('dayOneActivationDismiss');
      var KEY = 'todayDayOneActivationDismissed';
      function hideDayOne() {
        if (wrap) wrap.style.display = 'none';
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      }
      if (btn) btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        hideDayOne();
      });
      try {
        if (localStorage.getItem(KEY) === '1' && wrap) wrap.style.display = 'none';
      } catch (e) {}
    })();
    </script>
    <% } %>

    <% if (!empty) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-label="Next 30 minutes">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Next 30 minutes</p>
      <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white mb-2">You have <%= typeof queueNeedingAction !== 'undefined' ? queueNeedingAction : 0 %> leads queued for action today.</h2>
      <p class="text-sm text-brand-muted mb-5">Start a focused calling block and work the queue in order. AdHello will keep wrap-up and next steps aligned.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/focus" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest text-center">Start session</a>
        <a href="/pipeline" class="btn-pill border border-brand-border dark:border-white/20 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center">Open pipeline queue</a>
      </div>
    </section>

    <section aria-labelledby="glance-heading" class="mb-10 md:mb-12">
      <h2 id="glance-heading" class="sr-only">Day at a glance</h2>
      <div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-6">Day at a glance</p>
        <% const _cs = typeof conversionSnapshot !== 'undefined' && conversionSnapshot ? conversionSnapshot : {}; %>
        <% const _pv = typeof _cs.pipelineValueCreated7d === 'number' ? _cs.pipelineValueCreated7d : 0; %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
          <a href="/reports?tab=tracker&amp;metric=reply_rate&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-violet-500/40 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Reply rate (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-brand-dark dark:text-violet-300"><%= _cs.replyRate7dDisplay || '0%' %></p>
            <p class="text-[11px] text-brand-muted mt-2">Replies / touches · rolling week</p>
          </a>
          <a href="/reports?tab=tracker&amp;metric=meetings_booked&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-emerald-500/40 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Meetings booked (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-emerald-600 dark:text-emerald-400"><%= typeof _cs.meetingsBooked7d !== 'undefined' ? _cs.meetingsBooked7d : 0 %></p>
            <p class="text-[11px] text-brand-muted mt-2">From notes &amp; activity keywords</p>
          </a>
          <a href="/reports?tab=tracker&amp;metric=pipeline_created&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-brand-yellow/60 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Pipeline created (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-brand-dark dark:text-white">$<%= Math.round(_pv).toLocaleString() %></p>
            <p class="text-[11px] text-brand-muted mt-2">Stage 3+ moves · est. value</p>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:gap-6 mt-4 md:mt-6 pt-4 md:pt-6 border-t border-brand-border/30 dark:border-white/10">
          <a href="/reports?tab=tracker&amp;metric=outreach_streak&amp;range=30d" class="group rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/30 p-3 md:p-4 hover:border-emerald-500/30 transition-colors text-left">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-0.5">Outreach streak</p>
            <p class="text-lg font-display font-black text-emerald-600 dark:text-emerald-400"><%= typeof streak !== 'undefined' ? streak : 0 %>d</p>
          </a>
          <a href="/reports?tab=tracker&amp;metric=overdue_followups&amp;range=1d" class="group rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/30 p-3 md:p-4 hover:border-rose-500/30 transition-colors text-left">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-0.5">Overdue follow-ups</p>
            <p class="text-lg font-display font-black text-rose-600 dark:text-rose-400"><%= typeof overdueFollowUps !== 'undefined' ? overdueFollowUps : 0 %></p>
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="actions-heading" class="mb-12 md:mb-16">
      <h2 id="actions-heading" class="sr-only">Quick actions</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <div class="flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 shadow-sm overflow-hidden hover:border-brand-yellow/50 transition-colors">
          <a href="/leads/find" class="group flex flex-1 flex-col p-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Find</p>
            <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Start a lead search</h3>
            <p class="text-sm text-brand-muted leading-relaxed flex-1">Keyword + location; Maps via Outscraper first when configured, Apify fallback.</p>
          </a>
          <p class="text-[11px] text-brand-muted px-8 pb-6 pt-0 border-t border-brand-border/30 dark:border-white/10 -mt-1">
            <a href="/workspace/integrations" class="text-brand-yellow font-bold hover:underline">Workspace</a> — API keys &amp; cost-aware stack guide.
          </p>
        </div>
        <a href="/pipeline" class="group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm hover:border-brand-yellow/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Pipeline</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Work your queue — <%= typeof queueNeedingAction !== 'undefined' ? queueNeedingAction : 0 %> leads in early stages</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto">Stages 1–2 need movement or outreach.</p>
        </a>
        <a href="/reports?tab=tracker" class="group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm hover:border-brand-yellow/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Touches</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Review daily tracker</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto">Auto-detected calls and cadence steps plus anything you adjust — streaks and charts in Reports.</p>
        </a>
      </div>
    </section>
    <% } %>

    <% const _wr = typeof weekReview !== 'undefined' && weekReview ? weekReview : null; %>
    <% if (typeof activation !== 'undefined' && activation && typeof activationComplete !== 'undefined' && !activationComplete && _showAct && !_showDayOneHero) { %>
    <div id="activationRibbonWrap" class="mb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">7-day activation</p>
        <div class="flex items-center gap-3">
          <button type="button" id="activationRibbonDismiss" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Dismiss</button>
        </div>
      </div>
      <details class="group rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/50 dark:bg-slate-900/40 open:shadow-md">
        <summary class="cursor-pointer list-none px-6 py-4 font-display font-bold text-brand-dark dark:text-white flex items-center justify-between gap-4">
          <span>Open checklist · <%= activation.progress %>/<%= activation.total %> complete</span>
          <span class="text-brand-muted text-lg group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="px-2 pb-4 md:px-4">
          <%- include('partials/activation-7day', { activation, activationEmbed: true }) %>
        </div>
      </details>
    </div>
    <script>
    (function () {
      var wrap = document.getElementById('activationRibbonWrap');
      var btn = document.getElementById('activationRibbonDismiss');
      var review = document.getElementById('weekReviewCard');
      function showReview() {
        if (review) review.classList.remove('hidden');
      }
      function hide() {
        if (wrap) wrap.style.display = 'none';
        try { localStorage.setItem('todayActivationRibbonDismissed', '1'); } catch (e) {}
        showReview();
      }
      if (btn) btn.addEventListener('click', hide);
      try {
        if (localStorage.getItem('todayActivationRibbonDismissed') === '1') {
          if (wrap) wrap.style.display = 'none';
          showReview();
        }
      } catch (e) {}
    })();
    </script>
    <% } %>
    <% if (_wr) { %>
    <div id="weekReviewCard" class="mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm <%= (_showAct && !_showDayOneHero) ? 'hidden' : '' %>">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-4">This week&apos;s review</p>
      <div class="space-y-6">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Best-performing cadence</p>
          <p class="font-display font-bold text-brand-dark dark:text-white"><%= _wr.cadence && _wr.cadence.label ? _wr.cadence.label : '—' %><% if (_wr.cadence && _wr.cadence.count) { %> <span class="text-brand-muted font-sans font-semibold text-sm">(<%= _wr.cadence.count %> touches logged)</span><% } %></p>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Top leads by engagement</p>
          <ol class="list-decimal list-inside space-y-1 text-sm text-brand-dark dark:text-slate-200">
            <% if (_wr.topLeads && _wr.topLeads.length) { %>
              <% _wr.topLeads.forEach(function (L) { %>
              <li><a href="/focus?lead=<%= encodeURIComponent(String(L.key || '').replace(/^lead:/i, '')) %>" class="font-semibold hover:text-brand-yellow"><%= L.title %></a> <span class="text-brand-muted">· <%= L.touches %> events</span></li>
              <% }); %>
            <% } else { %>
              <li class="text-brand-muted">No activity this week yet — log touches from Focus or the pipeline.</li>
            <% } %>
          </ol>
        </div>
        <div class="rounded-2xl border border-brand-yellow/30 bg-brand-yellow/10 dark:bg-brand-yellow/5 px-4 py-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow mb-1">Suggested experiment</p>
          <p class="text-sm text-brand-dark dark:text-slate-200 leading-relaxed"><%= _wr.experiment || '' %></p>
        </div>
      </div>
    </div>
    <% } %>

    <%- include('partials/cadence_today_block') %>
  </main>

  <% const _eq = typeof outreachCoach !== 'undefined' && outreachCoach && outreachCoach.entrepreneurQuote ? outreachCoach.entrepreneurQuote : null; %>
  <% if (_eq) { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14">
    <blockquote class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-5 py-5 md:px-6 md:py-6 text-brand-dark dark:text-slate-100">
      <p class="font-display font-bold text-base md:text-lg leading-snug">“<%= _eq.text %>”</p>
      <footer class="mt-3 text-sm font-bold text-brand-muted dark:text-slate-400">— <%= _eq.author %></footer>
    </blockquote>
  </footer>
  <% } else { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14"></footer>
  <% } %>

  <% const _icpF = typeof icpForm !== 'undefined' && icpForm ? icpForm : { keyword: '', city: '', state: '', qty: 50 }; %>
  <div id="todayIcpModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="today-icp-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="today-icp-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Ideal customer profile</h2>
      <form id="todayIcpForm" class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Keyword</label>
          <input name="keyword" type="text" value="<%= _icpF.keyword || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">City</label>
            <input name="city" type="text" value="<%= _icpF.city || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">State</label>
            <input name="state" type="text" maxlength="2" value="<%= _icpF.state || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm uppercase" placeholder="OR" />
          </div>
        </div>
        <p id="todayIcpFormErr" class="hidden text-sm text-rose-600 dark:text-rose-400"></p>
        <div class="flex gap-2 justify-end pt-2">
          <button type="button" id="todayIcpCancel" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
          <button type="submit" class="btn-pill btn-primary px-4 py-2 text-xs font-black uppercase tracking-widest">Save</button>
        </div>
      </form>
    </div>
  </div>
  <script>
  (function () {
    var pill = document.getElementById('todayIcpPill');
    var modal = document.getElementById('todayIcpModal');
    var form = document.getElementById('todayIcpForm');
    var cancel = document.getElementById('todayIcpCancel');
    var err = document.getElementById('todayIcpFormErr');
    function openM() { if (modal) modal.classList.remove('hidden'); if (err) { err.classList.add('hidden'); err.textContent = ''; } }
    function closeM() { if (modal) modal.classList.add('hidden'); }
    if (pill) pill.addEventListener('click', openM);
    if (cancel) cancel.addEventListener('click', closeM);
    if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeM(); });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var body = {
        keyword: fd.get('keyword'),
        city: fd.get('city'),
        state: fd.get('state'),
      };
      fetch('/workspace/icp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (data && data.success) {
          closeM();
          window.location.reload();
        } else {
          if (err) { err.textContent = (data && data.error) || 'Could not save'; err.classList.remove('hidden'); }
        }
      }).catch(function () {
        if (err) { err.textContent = 'Could not save'; err.classList.remove('hidden'); }
      });
    });
  })();
  </script>
  <%- include('partials/app_shell_close') %>
</body>
</html>
