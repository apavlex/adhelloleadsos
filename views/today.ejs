<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 md:py-12">
    <% if (typeof seededNotice !== 'undefined' && seededNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-300/50 bg-emerald-50/90 dark:bg-emerald-950/40 dark:border-emerald-500/30 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Sample leads were added to your Pipeline. You can edit or delete them anytime.
    </div>
    <% } %>

    <header class="mb-8 md:mb-10 flex flex-col gap-4">
      <% const _ta = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : ''; %>
      <p class="text-sm md:text-base text-brand-dark dark:text-white font-semibold border-b-2 pb-2 self-start" <% if (_ta) { %>style="border-color: <%= _ta %>"<% } %>>
        <span id="todayDaypart"><%= typeof greetingWord !== 'undefined' ? greetingWord : 'Hello' %></span>, <%= typeof firstName !== 'undefined' ? firstName : 'there' %> — <span id="todayDateLabel"><%= typeof dateLabel !== 'undefined' ? dateLabel : '' %></span>
      </p>
      <% if (typeof icpLabel !== 'undefined') { %>
      <button type="button" id="todayIcpPill" class="self-start inline-flex items-center gap-2 rounded-full border border-brand-border dark:border-white/15 bg-white/80 dark:bg-slate-900/70 px-4 py-2 text-left text-[11px] font-bold text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors max-w-full">
        <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted shrink-0">Targeting</span>
        <span class="truncate"><%= icpLabel %></span>
      </button>
      <% } %>
    </header>
    <script>
    (function () {
      function greetingWordLocal() {
        var h = new Date().getHours();
        if (h < 12) return 'Morning';
        if (h < 17) return 'Afternoon';
        return 'Evening';
      }
      var dp = document.getElementById('todayDaypart');
      if (dp) dp.textContent = greetingWordLocal();
      var dl = document.getElementById('todayDateLabel');
      if (dl) {
        dl.textContent = new Date().toLocaleDateString(undefined, {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }
    })();
    </script>

    <% const _tl = typeof totalLeads !== 'undefined' ? totalLeads : 0; %>
    <% if (_tl < 20) { %>
    <div class="mb-8 md:mb-10 rounded-[2rem] border-2 border-brand-yellow/50 bg-brand-yellow/15 dark:bg-brand-yellow/10 dark:border-brand-yellow/40 px-6 py-6 md:px-8 md:py-8 shadow-md" role="region" aria-label="Pipeline size">
      <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white mb-2">Your pipeline is too small to hit your goal</h2>
      <p class="text-sm md:text-base text-brand-muted dark:text-slate-300 font-medium max-w-3xl leading-relaxed mb-6">Realistic math: 54 touches/day × ~3% reply rate needs 50+ active leads. You have <strong class="text-brand-dark dark:text-white"><%= _tl %></strong>.</p>
      <div class="flex flex-col sm:flex-row flex-wrap gap-3">
        <a href="/find?preset=icp" class="btn-pill btn-primary px-8 py-3.5 text-xs font-black uppercase tracking-widest text-center shadow-lg">Pull 50 leads now</a>
        <a href="/prospecting?tab=pipeline&amp;action=import" class="inline-flex items-center justify-center rounded-full border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 px-8 py-3.5 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/50 dark:hover:bg-slate-800 transition-colors text-center">Import CSV</a>
      </div>
    </div>
    <% } %>

    <% const empty = typeof totalLeads !== 'undefined' && totalLeads === 0; %>
    <% if (empty) { %>
    <div class="rounded-[2rem] border-2 border-dashed border-brand-border dark:border-white/15 bg-white/60 dark:bg-slate-900/50 px-8 py-16 text-center mb-12">
      <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Your Pipeline is empty</h1>
      <p class="text-brand-muted max-w-md mx-auto mb-8">Run a lead search to pull SMBs, or load sample leads to see how stages and cadences look.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/find" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest">Run your first search</a>
        <form method="post" action="/today/seed-demo" class="inline">
          <button type="submit" class="btn-pill bg-brand-cream dark:bg-slate-800 text-brand-dark dark:text-white border border-brand-border dark:border-white/10 px-8 py-3 text-xs font-black uppercase tracking-widest hover:border-brand-yellow/60">
            Load sample leads
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (!empty) { %>
    <%- include('partials/prospecting_coach_card', { coachCardClass: 'mb-10 md:mb-12' }) %>

    <section aria-labelledby="glance-heading" class="mb-10 md:mb-12">
      <h2 id="glance-heading" class="sr-only">Day at a glance</h2>
      <div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-6">Day at a glance</p>
        <% const _cs = typeof conversionSnapshot !== 'undefined' && conversionSnapshot ? conversionSnapshot : {}; %>
        <% const _pv = typeof _cs.pipelineValueCreated7d === 'number' ? _cs.pipelineValueCreated7d : 0; %>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          <a href="/analytics?tab=tracker&amp;metric=touches_today&amp;range=1d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-brand-yellow/50 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1 group-hover:text-brand-dark dark:group-hover:text-white">Touches today</p>
            <p class="text-2xl md:text-3xl font-display font-black text-brand-yellow"><%= typeof touchesToday !== 'undefined' ? touchesToday : 0 %><span class="text-sm font-bold text-brand-muted"> / <%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %></span></p>
            <p class="text-[11px] text-brand-muted mt-2">Unique leads touched today</p>
          </a>
          <a href="/analytics?tab=tracker&amp;metric=reply_rate&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-violet-500/40 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Reply rate (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-brand-dark dark:text-violet-300"><%= _cs.replyRate7dDisplay || '0%' %></p>
            <p class="text-[11px] text-brand-muted mt-2">Replies / touches · rolling week</p>
          </a>
          <a href="/analytics?tab=tracker&amp;metric=meetings_booked&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-emerald-500/40 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Meetings booked (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-emerald-600 dark:text-emerald-400"><%= typeof _cs.meetingsBooked7d !== 'undefined' ? _cs.meetingsBooked7d : 0 %></p>
            <p class="text-[11px] text-brand-muted mt-2">From notes &amp; activity keywords</p>
          </a>
          <a href="/analytics?tab=tracker&amp;metric=pipeline_created&amp;range=7d" class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 p-4 md:p-5 hover:border-brand-yellow/60 transition-colors text-left">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Pipeline created (7d)</p>
            <p class="text-2xl md:text-3xl font-display font-black text-brand-dark dark:text-white">$<%= Math.round(_pv).toLocaleString() %></p>
            <p class="text-[11px] text-brand-muted mt-2">Stage 3+ moves · est. value</p>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:gap-6 mt-4 md:mt-6 pt-4 md:pt-6 border-t border-brand-border/30 dark:border-white/10">
          <a href="/analytics?tab=tracker&amp;metric=outreach_streak&amp;range=30d" class="group rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/30 p-3 md:p-4 hover:border-emerald-500/30 transition-colors text-left">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-0.5">Outreach streak</p>
            <p class="text-lg font-display font-black text-emerald-600 dark:text-emerald-400"><%= typeof streak !== 'undefined' ? streak : 0 %>d</p>
          </a>
          <a href="/analytics?tab=tracker&amp;metric=overdue_followups&amp;range=1d" class="group rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/30 p-3 md:p-4 hover:border-rose-500/30 transition-colors text-left">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-0.5">Overdue follow-ups</p>
            <p class="text-lg font-display font-black text-rose-600 dark:text-rose-400"><%= typeof overdueFollowUps !== 'undefined' ? overdueFollowUps : 0 %></p>
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="actions-heading" class="mb-12 md:mb-16">
      <h2 id="actions-heading" class="sr-only">Quick actions</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <div class="flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 shadow-sm overflow-hidden hover:border-brand-yellow/50 transition-colors">
          <a href="/find" class="group flex flex-1 flex-col p-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Find</p>
            <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Start a lead search</h3>
            <p class="text-sm text-brand-muted leading-relaxed flex-1">Keyword + location; Maps via Outscraper first when configured, Apify fallback.</p>
          </a>
          <p class="text-[11px] text-brand-muted px-8 pb-6 pt-0 border-t border-brand-border/30 dark:border-white/10 -mt-1">
            <a href="/workspace" class="text-brand-yellow font-bold hover:underline">Workspace</a> — API keys &amp; cost-aware stack guide.
          </p>
        </div>
        <a href="/prospecting?tab=pipeline" class="group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm hover:border-brand-yellow/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Pipeline</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Work your queue — <%= typeof queueNeedingAction !== 'undefined' ? queueNeedingAction : 0 %> leads in early stages</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto">Stages 1–2 need movement or outreach.</p>
        </a>
        <a href="/sales/tracker#tracker" class="group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm hover:border-brand-yellow/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Touches</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Log today’s outreach</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto">Cold emails, DMs, calls — keep the streak.</p>
        </a>
      </div>
    </section>
    <% } %>

    <% const _wr = typeof weekReview !== 'undefined' && weekReview ? weekReview : null; %>
    <% const _showAct = typeof showActivationRibbon !== 'undefined' && showActivationRibbon; %>
    <% if (typeof activation !== 'undefined' && activation && typeof activationComplete !== 'undefined' && !activationComplete && _showAct) { %>
    <div id="activationRibbonWrap" class="mb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">7-day activation</p>
        <div class="flex items-center gap-3">
          <button type="button" id="activationRibbonDismiss" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Dismiss</button>
        </div>
      </div>
      <details class="group rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/50 dark:bg-slate-900/40 open:shadow-md">
        <summary class="cursor-pointer list-none px-6 py-4 font-display font-bold text-brand-dark dark:text-white flex items-center justify-between gap-4">
          <span>Open checklist · <%= activation.progress %>/<%= activation.total %> complete</span>
          <span class="text-brand-muted text-lg group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="px-2 pb-4 md:px-4">
          <%- include('partials/activation-7day', { activation, activationEmbed: true }) %>
        </div>
      </details>
    </div>
    <script>
    (function () {
      var wrap = document.getElementById('activationRibbonWrap');
      var btn = document.getElementById('activationRibbonDismiss');
      var review = document.getElementById('weekReviewCard');
      function showReview() {
        if (review) review.classList.remove('hidden');
      }
      function hide() {
        if (wrap) wrap.style.display = 'none';
        try { localStorage.setItem('todayActivationRibbonDismissed', '1'); } catch (e) {}
        showReview();
      }
      if (btn) btn.addEventListener('click', hide);
      try {
        if (localStorage.getItem('todayActivationRibbonDismissed') === '1') {
          if (wrap) wrap.style.display = 'none';
          showReview();
        }
      } catch (e) {}
    })();
    </script>
    <% } %>
    <% if (_wr) { %>
    <div id="weekReviewCard" class="mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm <%= _showAct ? 'hidden' : '' %>">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-4">This week&apos;s review</p>
      <div class="space-y-6">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Best-performing cadence</p>
          <p class="font-display font-bold text-brand-dark dark:text-white"><%= _wr.cadence && _wr.cadence.label ? _wr.cadence.label : '—' %><% if (_wr.cadence && _wr.cadence.count) { %> <span class="text-brand-muted font-sans font-semibold text-sm">(<%= _wr.cadence.count %> touches logged)</span><% } %></p>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Top leads by engagement</p>
          <ol class="list-decimal list-inside space-y-1 text-sm text-brand-dark dark:text-slate-200">
            <% if (_wr.topLeads && _wr.topLeads.length) { %>
              <% _wr.topLeads.forEach(function (L) { %>
              <li><a href="/focus?lead=<%= encodeURIComponent(String(L.key || '').replace(/^lead:/i, '')) %>" class="font-semibold hover:text-brand-yellow"><%= L.title %></a> <span class="text-brand-muted">· <%= L.touches %> events</span></li>
              <% }); %>
            <% } else { %>
              <li class="text-brand-muted">No activity this week yet — log touches from Focus or the pipeline.</li>
            <% } %>
          </ol>
        </div>
        <div class="rounded-2xl border border-brand-yellow/30 bg-brand-yellow/10 dark:bg-brand-yellow/5 px-4 py-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow mb-1">Suggested experiment</p>
          <p class="text-sm text-brand-dark dark:text-slate-200 leading-relaxed"><%= _wr.experiment || '' %></p>
        </div>
      </div>
    </div>
    <% } %>
  </main>

  <% const _eq = typeof outreachCoach !== 'undefined' && outreachCoach && outreachCoach.entrepreneurQuote ? outreachCoach.entrepreneurQuote : null; %>
  <% if (_eq) { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14">
    <details class="group rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-4 py-3">
      <summary class="cursor-pointer list-none text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white flex items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
        <span>Show quote</span>
        <span class="text-brand-muted group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
      </summary>
      <blockquote class="mt-4 pt-4 border-t border-brand-border/30 dark:border-white/10 text-brand-dark dark:text-slate-100">
        <p class="font-display font-bold text-base leading-snug">“<%= _eq.text %>”</p>
        <footer class="mt-3 text-sm font-bold text-brand-muted dark:text-slate-400">— <%= _eq.author %></footer>
      </blockquote>
    </details>
    <div class="mt-4 pt-4 border-t border-brand-border/30 dark:border-white/10">
      <a href="/focus" class="btn-pill btn-primary inline-flex items-center justify-center px-8 py-3.5 text-xs font-black uppercase tracking-widest shadow-lg w-full sm:w-auto text-center">Start my 54 →</a>
    </div>
  </footer>
  <% } else { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14">
    <a href="/focus" class="btn-pill btn-primary inline-flex items-center justify-center px-8 py-3.5 text-xs font-black uppercase tracking-widest shadow-lg w-full sm:w-auto text-center">Start my 54 →</a>
  </footer>
  <% } %>

  <% const _icpF = typeof icpForm !== 'undefined' && icpForm ? icpForm : { keyword: '', city: '', state: '', qty: 50 }; %>
  <div id="todayIcpModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="today-icp-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="today-icp-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Ideal customer profile</h2>
      <form id="todayIcpForm" class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Keyword</label>
          <input name="keyword" type="text" value="<%= _icpF.keyword || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">City</label>
            <input name="city" type="text" value="<%= _icpF.city || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">State</label>
            <input name="state" type="text" maxlength="2" value="<%= _icpF.state || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm uppercase" placeholder="OR" />
          </div>
        </div>
        <p id="todayIcpFormErr" class="hidden text-sm text-rose-600 dark:text-rose-400"></p>
        <div class="flex gap-2 justify-end pt-2">
          <button type="button" id="todayIcpCancel" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
          <button type="submit" class="btn-pill btn-primary px-4 py-2 text-xs font-black uppercase tracking-widest">Save</button>
        </div>
      </form>
    </div>
  </div>
  <script>
  (function () {
    var pill = document.getElementById('todayIcpPill');
    var modal = document.getElementById('todayIcpModal');
    var form = document.getElementById('todayIcpForm');
    var cancel = document.getElementById('todayIcpCancel');
    var err = document.getElementById('todayIcpFormErr');
    function openM() { if (modal) modal.classList.remove('hidden'); if (err) { err.classList.add('hidden'); err.textContent = ''; } }
    function closeM() { if (modal) modal.classList.add('hidden'); }
    if (pill) pill.addEventListener('click', openM);
    if (cancel) cancel.addEventListener('click', closeM);
    if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeM(); });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var body = {
        keyword: fd.get('keyword'),
        city: fd.get('city'),
        state: fd.get('state'),
      };
      fetch('/workspace/icp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (data && data.success) {
          closeM();
          window.location.reload();
        } else {
          if (err) { err.textContent = (data && data.error) || 'Could not save'; err.classList.remove('hidden'); }
        }
      }).catch(function () {
        if (err) { err.textContent = 'Could not save'; err.classList.remove('hidden'); }
      });
    });
  })();
  </script>
</body>
</html>
