  <% const _eq = typeof outreachCoach !== 'undefined' && outreachCoach && outreachCoach.entrepreneurQuote ? outreachCoach.entrepreneurQuote : null; %>
  <footer id="todayQuoteFooter" class="max-wide mx-auto px-6 pb-10 md:pb-14">
  <% if (_eq) { %>
    <blockquote class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-5 py-5 md:px-6 md:py-6 text-brand-dark dark:text-slate-100">
      <p class="font-display font-bold text-base md:text-lg leading-snug">“<%= _eq.text %>”</p>
      <footer class="mt-3 text-sm font-bold text-brand-muted dark:text-slate-400">— <%= _eq.author %></footer>
    </blockquote>
  <% } %>
  </footer>

  <% const _icpF = typeof icpForm !== 'undefined' && icpForm ? icpForm : { keyword: '', city: '', state: '', qty: 50 }; %>
  <div id="todayIcpModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="today-icp-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="today-icp-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Ideal customer profile</h2>
      <form id="todayIcpForm" class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Keyword</label>
          <input name="keyword" type="text" value="<%= _icpF.keyword || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">City</label>
            <input name="city" type="text" value="<%= _icpF.city || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">State</label>
            <input name="state" type="text" maxlength="2" value="<%= _icpF.state || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm uppercase" placeholder="OR" />
          </div>
        </div>
        <p id="todayIcpFormErr" class="hidden text-sm text-rose-600 dark:text-rose-400"></p>
        <div class="flex gap-2 justify-end pt-2">
          <button type="button" id="todayIcpCancel" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
          <button type="submit" class="btn-pill btn-primary px-4 py-2 text-xs font-black uppercase tracking-widest">Save</button>
        </div>
      </form>
    </div>
  </div>
  <script>
  (function () {
    var pill = document.getElementById('todayIcpPill');
    var modal = document.getElementById('todayIcpModal');
    var form = document.getElementById('todayIcpForm');
    var cancel = document.getElementById('todayIcpCancel');
    var err = document.getElementById('todayIcpFormErr');
    function openM() { if (modal) modal.classList.remove('hidden'); if (err) { err.classList.add('hidden'); err.textContent = ''; } }
    function closeM() { if (modal) modal.classList.add('hidden'); }
    if (pill) pill.addEventListener('click', openM);
    if (cancel) cancel.addEventListener('click', closeM);
    if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeM(); });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var body = {
        keyword: fd.get('keyword'),
        city: fd.get('city'),
        state: fd.get('state'),
      };
      fetch('/workspace/icp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (data && data.success) {
          closeM();
          window.location.reload();
        } else {
          if (err) { err.textContent = (data && data.error) || 'Could not save'; err.classList.remove('hidden'); }
        }
      }).catch(function () {
        if (err) { err.textContent = 'Could not save'; err.classList.remove('hidden'); }
      });
    });
  })();
  </script>
  <%- include('/partials/opportunity_company_panel') %>
  <% if (typeof todayExtrasDeferred !== 'undefined' && todayExtrasDeferred) { %>
  <script>
  (function () {
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function setText(id, text) {
      var el = document.getElementById(id);
      if (el && text != null) el.textContent = text;
    }
    function setHref(id, href) {
      var el = document.getElementById(id);
      if (el && href) {
        el.setAttribute('href', href);
        el.setAttribute('data-nav-prefetch', href);
      }
    }
    function applyRoi(roi) {
      if (!roi) return;
      setText('todayRoiEyebrow', roi.eyebrow || 'Best ROI · next 30 min');
      setText('todayRoiHeadline', roi.headline || '');
      setText('todayRoiDetail', roi.detail || '');
      setHref('todayRoiPrimary', roi.primaryHref);
      setText('todayRoiPrimaryLabel', roi.primaryLabel || 'Start session');
      setHref('todayRoiSecondary', roi.secondaryHref);
      setText('todayRoiSecondaryLabel', roi.secondaryLabel || 'Network leads');
    }
    function sourcesHtml(leadSources, fieldWorkHome) {
      var srcList = leadSources && Array.isArray(leadSources.sources) ? leadSources.sources : [];
      var fwSrc = fieldWorkHome && Array.isArray(fieldWorkHome.sources) ? fieldWorkHome.sources : [];
      var combined = srcList.map(function (s) {
        return { kind: 'lead', count: s.count, label: s.label, hint: s.hint, href: s.href, hot: false };
      }).concat(fwSrc.map(function (s) {
        return { kind: 'team', count: s.count, label: s.label, hint: s.hint, href: s.href, hot: !!(s.id === 'overdue' && s.count) };
      }));
      if (!combined.length) return '';
      var need = (Number(leadSources && leadSources.needYou) || 0) + (Number(fieldWorkHome && fieldWorkHome.needAttention) || 0);
      var cards = combined.map(function (s) {
        return (
          '<a href="' + esc(s.href) + '" class="group rounded-2xl border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 px-3.5 py-3.5 shadow-sm hover:border-brand-yellow/50 hover:shadow-md transition-all min-w-0' +
          (s.hot ? ' border-rose-300/60 dark:border-rose-400/30' : '') + '">' +
          '<p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">' + (s.kind === 'lead' ? 'Lead' : 'Team') + '</p>' +
          '<p class="font-display font-extrabold text-2xl tabular-nums text-brand-dark dark:text-white leading-none mb-1">' + esc(s.count) + '</p>' +
          '<p class="text-[11px] font-black uppercase tracking-widest text-brand-dark dark:text-white">' + esc(s.label) + '</p>' +
          '<p class="text-[11px] font-semibold text-brand-muted truncate mt-0.5">' + esc(s.hint) + '</p></a>'
        );
      }).join('');
      return (
        '<section class="today-viz today-viz-reveal mb-8 md:mb-10" aria-label="Lead and team sources">' +
        '<div class="flex items-baseline justify-between gap-3 mb-3"><div>' +
        '<p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Active numbers</p>' +
        '<h2 class="font-display font-extrabold text-lg md:text-xl text-brand-dark dark:text-white leading-tight">' +
        '<span class="tabular-nums">' + esc(need) + '</span> need attention' +
        '<span class="text-brand-muted font-semibold text-sm md:text-base"> · leads &amp; field work</span></h2></div>' +
        '<a href="/network?tab=calendar" class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:underline shrink-0">Calendar</a></div>' +
        '<div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">' + cards + '</div></section>'
      );
    }
    function weekReviewHtml(wr) {
      if (!wr) return '';
      var leads = Array.isArray(wr.topLeads) ? wr.topLeads.slice(0, 5) : [];
      var lis = leads.length
        ? leads.map(function (L) {
            var short = String(L.key || '').replace(/^lead:/i, '');
            return '<li><a href="/focus?lead=' + encodeURIComponent(short) + '" class="font-semibold hover:text-brand-yellow">' +
              esc(L.title) + '</a> <span class="text-brand-muted">· ' + esc(L.touches) + ' events</span></li>';
          }).join('')
        : '<li class="text-brand-muted">No activity this week yet — log touches from Focus or the pipeline.</li>';
      var cadence = wr.cadence && wr.cadence.label ? esc(wr.cadence.label) : '—';
      var cadenceCount = wr.cadence && wr.cadence.count
        ? ' <span class="text-brand-muted font-sans font-semibold text-sm">(' + esc(wr.cadence.count) + ' touches logged)</span>'
        : '';
      return (
        '<div id="weekReviewCard" class="today-viz today-viz-reveal mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm">' +
        '<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5"><div>' +
        '<p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">This week\'s review</p>' +
        '<p class="text-sm text-brand-muted">Cadence performance and who engaged most.</p></div></div>' +
        '<div class="space-y-5 max-w-3xl"><div>' +
        '<p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Best-performing cadence</p>' +
        '<p class="font-display font-bold text-brand-dark dark:text-white">' + cadence + cadenceCount + '</p></div>' +
        '<div><p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Top leads by engagement</p>' +
        '<ol class="list-decimal list-inside space-y-1.5 text-sm text-brand-dark dark:text-slate-200">' + lis + '</ol></div>' +
        '<div class="rounded-2xl border border-brand-yellow/30 bg-brand-yellow/10 dark:bg-brand-yellow/5 px-4 py-3">' +
        '<p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow mb-1">Suggested experiment</p>' +
        '<p class="text-sm text-brand-dark dark:text-slate-200 leading-relaxed">' + esc(wr.experiment || '') + '</p></div></div></div>'
      );
    }
    fetch('/today/extras.json', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.success) return;
        applyRoi(data.bestRoiActivity);
        var oppSlot = document.getElementById('todayOppBoardSlot');
        if (oppSlot && data.opportunityBoardHtml) oppSlot.innerHTML = data.opportunityBoardHtml;
        else {
          var sk = document.getElementById('todayOppBoardSkeleton');
          if (sk) sk.remove();
        }
        var srcSlot = document.getElementById('todaySourcesSlot');
        if (srcSlot && !srcSlot.querySelector('section')) {
          srcSlot.innerHTML = sourcesHtml(data.leadSources, data.fieldWorkHome);
        }
        var wrSlot = document.getElementById('todayWeekReviewSlot');
        if (wrSlot && !document.getElementById('weekReviewCard')) {
          wrSlot.innerHTML = weekReviewHtml(data.weekReview);
        }
        if (data.actionPlanHtml) {
          var hub = document.getElementById('today-touches-hub');
          var host = hub && hub.querySelector('.divide-y');
          if (host && !document.getElementById('today-hub-action-plan')) {
            var wrap = document.createElement('details');
            wrap.id = 'today-hub-action-plan';
            wrap.className = 'today-hub-panel group bg-white dark:bg-slate-900/90';
            wrap.innerHTML =
              '<summary class="today-hub-panel-summary bg-white dark:bg-slate-900/90">' +
              '<span class="min-w-0"><span class="block text-[10px] font-black uppercase tracking-widest text-brand-yellow">Daily action plan tracker</span>' +
              '<span class="block font-display font-bold text-base text-brand-dark dark:text-white mt-0.5">' +
              esc(data.actionPlan && data.actionPlan.monthLabel) + '</span></span>' +
              '<span class="flex items-center gap-2 shrink-0"><span class="text-[10px] font-black uppercase tracking-wider text-brand-muted tabular-nums">' +
              esc(data.actionPlan && data.actionPlan.monthlyTotal) + ' this month</span>' +
              '<span class="today-hub-chevron text-brand-muted" aria-hidden="true">▼</span></span></summary>' +
              '<div class="today-hub-panel-body today-hub-panel-body--flush"><div class="today-hub-panel-inner today-hub-panel-inner--flush">' +
              data.actionPlanHtml + '</div></div>';
            host.appendChild(wrap);
          }
        }
        if (data.entrepreneurQuote && data.entrepreneurQuote.text) {
          var foot = document.getElementById('todayQuoteFooter');
          if (foot && !foot.querySelector('blockquote')) {
            foot.innerHTML =
              '<blockquote class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-5 py-5 md:px-6 md:py-6 text-brand-dark dark:text-slate-100">' +
              '<p class="font-display font-bold text-base md:text-lg leading-snug">“' + esc(data.entrepreneurQuote.text) + '”</p>' +
              '<footer class="mt-3 text-sm font-bold text-brand-muted dark:text-slate-400">— ' + esc(data.entrepreneurQuote.author) + '</footer></blockquote>';
          }
        }
      })
      .catch(function () {
        var sk = document.getElementById('todayOppBoardSkeleton');
        if (sk) sk.remove();
      });
  })();
  </script>
  <% } %>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
