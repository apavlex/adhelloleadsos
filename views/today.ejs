<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 md:py-12">
    <% if (typeof seededNotice !== 'undefined' && seededNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-300/50 bg-emerald-50/90 dark:bg-emerald-950/40 dark:border-emerald-500/30 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Sample leads were added to your Pipeline. You can edit or delete them anytime.
    </div>
    <% } %>
    <% if (typeof scheduleSavedNotice !== 'undefined' && scheduleSavedNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-400/40 bg-emerald-50/90 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Schedule saved. Your lead run will start at the scheduled time.
    </div>
    <% } %>
    <% const _ta = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : ''; %>
    <p class="mb-6 md:mb-8 text-sm md:text-base text-brand-dark dark:text-white font-semibold border-b-2 pb-2 self-start" <% if (_ta) { %>style="border-color: <%= _ta %>"<% } %>>
      <span id="todayDaypart"><%= typeof greetingWord !== 'undefined' ? greetingWord : 'Hello' %></span>, <%= typeof firstName !== 'undefined' ? firstName : 'there' %> — <span id="todayDateLabel"><%= typeof dateLabel !== 'undefined' ? dateLabel : '' %></span>
    </p>
    <script>
    (function () {
      function greetingWordLocal() {
        var h = new Date().getHours();
        if (h < 12) return 'Morning';
        if (h < 17) return 'Afternoon';
        return 'Evening';
      }
      var dp = document.getElementById('todayDaypart');
      if (dp) dp.textContent = greetingWordLocal();
      var dl = document.getElementById('todayDateLabel');
      if (dl) {
        dl.textContent = new Date().toLocaleDateString(undefined, {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }
    })();
    </script>
    <script>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var el = document.querySelector('[data-today-count]');
      if (!el) return;
      var target = parseInt(el.getAttribute('data-today-count'), 10);
      if (!Number.isFinite(target) || target <= 0) return;
      var start = 0;
      var duration = 700;
      var t0 = null;
      function frame(ts) {
        if (t0 == null) t0 = ts;
        var p = Math.min(1, (ts - t0) / duration);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(start + (target - start) * eased));
        if (p < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    })();
    </script>

    <% const _tl = typeof totalLeads !== 'undefined' ? totalLeads : 0; %>
    <% const empty = _tl === 0; %>
    <% const _leadTarget = 50; %>
    <% const _underProvisioned = !empty && _tl < _leadTarget; %>
    <% const _leadPct = Math.max(0, Math.min(100, Math.round((_tl / _leadTarget) * 100))); %>
    <% const _showAct = typeof showActivationRibbon !== 'undefined' && showActivationRibbon; %>
    <% const _isDayOne = typeof activation !== 'undefined' && activation && (activation.progress || 0) === 0; %>
    <% const _showDayOneHero = empty && _showAct && _isDayOne; %>
    <% const _todayTasks = typeof todayTasks !== 'undefined' && todayTasks ? todayTasks : []; %>
    <% const _q = typeof queueNeedingAction !== 'undefined' ? Number(queueNeedingAction) || 0 : 0; %>
    <% const _tt = typeof touchesToday !== 'undefined' ? Number(touchesToday) || 0 : 0; %>
    <% const _tg = typeof touchGoal !== 'undefined' ? Math.max(1, Number(touchGoal) || 54) : 54; %>
    <% const _st = typeof streak !== 'undefined' ? Number(streak) || 0 : 0; %>
    <% const _rw = typeof repliesWaiting !== 'undefined' ? Number(repliesWaiting) || 0 : 0; %>
    <% const _touchPct = Math.max(0, Math.min(100, Math.round((_tt / _tg) * 100))); %>
    <% const _sessionGoal = 30; %>
    <% const _sessionPct = Math.max(0, Math.min(100, Math.round((_q / Math.max(_sessionGoal, 1)) * 100))); %>
    <% const _ringC = 2 * Math.PI * 42; %>
    <% const _ringOffset = _ringC * (1 - _sessionPct / 100); %>
    <% const _touchRingOffset = _ringC * (1 - _touchPct / 100); %>

    <style>
      .today-viz { --today-ink: #0f2747; --today-mute: #64748b; }
      .today-viz-hero {
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(120% 80% at 100% 0%, rgba(255, 219, 58, 0.22), transparent 55%),
          radial-gradient(90% 70% at 0% 100%, rgba(15, 39, 71, 0.06), transparent 50%),
          #fff;
      }
      html.dark .today-viz-hero {
        background:
          radial-gradient(120% 80% at 100% 0%, rgba(255, 219, 58, 0.12), transparent 55%),
          radial-gradient(90% 70% at 0% 100%, rgba(255, 255, 255, 0.04), transparent 50%),
          rgba(15, 23, 42, 0.92);
      }
      .today-viz-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(15, 39, 71, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15, 39, 71, 0.035) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        pointer-events: none;
      }
      html.dark .today-viz-grid {
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      }
      .today-viz-ring { transform: rotate(-90deg); }
      .today-viz-ring-track { stroke: rgba(15, 39, 71, 0.1); }
      html.dark .today-viz-ring-track { stroke: rgba(255, 255, 255, 0.12); }
      .today-viz-ring-progress {
        stroke: #0f2747;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1);
      }
      html.dark .today-viz-ring-progress { stroke: #FFDB3A; }
      .today-viz-metric {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        border-radius: 1rem;
        border: 1px solid rgba(17, 24, 39, 0.1);
        background: rgba(255, 255, 255, 0.72);
        padding: 0.55rem 0.75rem;
        min-width: 0;
      }
      html.dark .today-viz-metric {
        background: rgba(30, 41, 59, 0.75);
        border-color: rgba(255, 255, 255, 0.12);
      }
      .today-viz-metric svg { width: 1.05rem; height: 1.05rem; flex: none; color: #0f2747; }
      html.dark .today-viz-metric svg { color: #FFDB3A; }
      .today-viz-action {
        position: relative;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .today-viz-action:hover {
        transform: translateY(-3px);
        border-color: rgba(202, 138, 4, 0.45);
        box-shadow: 0 12px 28px rgba(15, 39, 71, 0.08);
      }
      .today-viz-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 219, 58, 0.22);
        color: #0f2747;
        margin-bottom: 0.85rem;
      }
      html.dark .today-viz-icon {
        background: rgba(255, 219, 58, 0.14);
        color: #FFDB3A;
      }
      .today-viz-icon svg { width: 1.2rem; height: 1.2rem; }
      .today-viz-bars { display: flex; align-items: flex-end; gap: 0.35rem; height: 3.25rem; }
      .today-viz-bar {
        flex: 1;
        min-width: 0;
        border-radius: 0.35rem 0.35rem 0.15rem 0.15rem;
        background: linear-gradient(180deg, #FFDB3A, rgba(15, 39, 71, 0.85));
        transform-origin: bottom;
        animation: today-bar-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      html.dark .today-viz-bar {
        background: linear-gradient(180deg, #FFDB3A, rgba(255, 255, 255, 0.35));
      }
      .today-viz-spark {
        display: block;
        width: 100%;
        height: 2.25rem;
        margin-top: 0.75rem;
      }
      .today-viz-spark path {
        fill: none;
        stroke: #0f2747;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 180;
        stroke-dashoffset: 180;
        animation: today-draw 1.2s ease forwards 0.2s;
      }
      html.dark .today-viz-spark path { stroke: #FFDB3A; }
      .today-viz-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.75rem;
        padding: 1.5rem 1rem;
        border-radius: 1.25rem;
        border: 1px dashed rgba(17, 24, 39, 0.14);
        background: rgba(250, 247, 237, 0.55);
      }
      html.dark .today-viz-empty {
        border-color: rgba(255, 255, 255, 0.14);
        background: rgba(2, 6, 23, 0.35);
      }
      .today-viz-empty-art {
        width: 4.5rem;
        height: 4.5rem;
        border-radius: 1.25rem;
        display: grid;
        place-items: center;
        background: rgba(255, 219, 58, 0.2);
        color: #0f2747;
        animation: today-float 3.2s ease-in-out infinite;
      }
      html.dark .today-viz-empty-art { color: #FFDB3A; }
      .today-viz-reveal {
        animation: today-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .today-viz-reveal-delay-1 { animation-delay: 0.08s; }
      .today-viz-reveal-delay-2 { animation-delay: 0.16s; }
      .today-viz-reveal-delay-3 { animation-delay: 0.24s; }
      @keyframes today-rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes today-draw {
        to { stroke-dashoffset: 0; }
      }
      @keyframes today-bar-rise {
        from { transform: scaleY(0.15); opacity: 0.4; }
        to { transform: scaleY(1); opacity: 1; }
      }
      @keyframes today-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .today-viz-reveal,
        .today-viz-bar,
        .today-viz-spark path,
        .today-viz-empty-art,
        .today-viz-action:hover {
          animation: none !important;
          transition: none !important;
          transform: none !important;
        }
        .today-viz-spark path { stroke-dashoffset: 0; }
      }
    </style>

    <% if (!empty) { %>
    <section class="today-viz today-viz-hero today-viz-reveal mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 p-6 md:p-8 shadow-sm" aria-label="Next 30 minutes">
      <div class="today-viz-grid" aria-hidden="true"></div>
      <div class="relative z-[1] flex flex-col lg:flex-row lg:items-center gap-8">
        <div class="flex-1 min-w-0">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Next 30 minutes</p>
          <h2 class="font-display font-extrabold text-xl md:text-3xl text-brand-dark dark:text-white mb-2 leading-tight">
            You have <span class="tabular-nums" data-today-count="<%= _q %>"><%= _q %></span> leads queued for action today.
          </h2>
          <p class="text-sm text-brand-muted mb-5 max-w-xl">Start a focused calling block and work the queue in order. AdHello will keep wrap-up and next steps aligned.</p>
          <div class="flex flex-col sm:flex-row gap-3 mb-5">
            <a href="/focus" data-nav-prefetch="/focus" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest text-center inline-flex items-center justify-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3l14 9-14 9V3z"/></svg>
              Start session
            </a>
            <a href="/prospecting?tab=pipeline" data-nav-prefetch="/prospecting?tab=pipeline" class="btn-pill border border-brand-border dark:border-white/20 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center inline-flex items-center justify-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7"/></svg>
              Open pipeline queue
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div class="today-viz-metric">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
              <div class="min-w-0">
                <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Daily goal</p>
                <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _tt %>/<%= _tg %></p>
              </div>
            </div>
            <div class="today-viz-metric">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2L4 14h7l-1 8 10-14h-7l1-6z"/></svg>
              <div class="min-w-0">
                <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Streak</p>
                <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _st %>d</p>
              </div>
            </div>
            <div class="today-viz-metric">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
              <div class="min-w-0">
                <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Replies</p>
                <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _rw %></p>
              </div>
            </div>
          </div>
        </div>
        <div class="shrink-0 mx-auto lg:mx-0 relative w-[9.5rem] h-[9.5rem]" aria-hidden="true">
          <svg class="today-viz-ring w-full h-full" viewBox="0 0 100 100">
            <circle class="today-viz-ring-track" cx="50" cy="50" r="42" fill="none" stroke-width="8"></circle>
            <circle class="today-viz-ring-progress" cx="50" cy="50" r="42" fill="none" stroke-width="8"
              stroke-dasharray="<%= _ringC.toFixed(2) %>"
              stroke-dashoffset="<%= _ringOffset.toFixed(2) %>"></circle>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Queue</p>
            <p class="font-display font-black text-2xl text-brand-dark dark:text-white tabular-nums leading-none"><%= _q %></p>
            <p class="text-[10px] font-bold text-brand-muted mt-1"><%= _sessionPct %>% of <%= _sessionGoal %></p>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="actions-heading" class="mb-8 md:mb-10">
      <h2 id="actions-heading" class="sr-only">Quick actions</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <a href="/leads/find" class="today-viz-action today-viz-reveal today-viz-reveal-delay-1 group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <span class="today-viz-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
          </span>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Find</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Start a lead search</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto">Search for businesses, real estate, permits, and more by keyword and location.</p>
        </a>
        <a href="/prospecting?tab=pipeline" class="today-viz-action today-viz-reveal today-viz-reveal-delay-2 group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <span class="today-viz-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h6v12H4zM14 6h6v7h-6zM14 16h6v2h-6z"/></svg>
          </span>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Pipeline</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Work your queue — <%= _q %> leads in early stages</h3>
          <p class="text-sm text-brand-muted leading-relaxed">Stages 1–2 need movement or outreach.</p>
          <div class="mt-4 h-2 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= _sessionGoal %>" aria-valuenow="<%= Math.min(_q, _sessionGoal) %>">
            <div class="h-full rounded-full bg-brand-yellow transition-[width] duration-700" style="width:<%= _sessionPct %>%"></div>
          </div>
          <p class="text-[10px] font-bold text-brand-muted mt-2 tabular-nums"><%= _q %> early-stage · <%= _tl %> total</p>
        </a>
        <a href="/reports?tab=tracker" class="today-viz-action today-viz-reveal today-viz-reveal-delay-3 group flex min-w-0 flex-col rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-8 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
          <div class="flex items-start justify-between gap-3 mb-1">
            <span class="today-viz-icon !mb-0" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5M4 19h16M8 16V9m4 7V6m4 10v-4"/></svg>
            </span>
            <div class="relative w-14 h-14 shrink-0" aria-hidden="true">
              <svg class="today-viz-ring w-full h-full" viewBox="0 0 100 100">
                <circle class="today-viz-ring-track" cx="50" cy="50" r="42" fill="none" stroke-width="10"></circle>
                <circle class="today-viz-ring-progress" cx="50" cy="50" r="42" fill="none" stroke-width="10"
                  stroke-dasharray="<%= _ringC.toFixed(2) %>"
                  stroke-dashoffset="<%= _touchRingOffset.toFixed(2) %>"></circle>
              </svg>
              <span class="absolute inset-0 grid place-items-center text-[10px] font-black tabular-nums text-brand-dark dark:text-white"><%= _touchPct %>%</span>
            </div>
          </div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2 mt-3">Touches</p>
          <h3 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2 group-hover:text-brand-yellow transition-colors">Review daily tracker</h3>
          <p class="text-sm text-brand-muted leading-relaxed mt-auto"><%= _tt %> of <%= _tg %> today · streak <%= _st %>d. Auto-detected calls plus anything you adjust.</p>
        </a>
      </div>
    </section>
    <% } %>

    <%- include('/partials/opportunity_board') %>

    <% const _wr = typeof weekReview !== 'undefined' && weekReview ? weekReview : null; %>
    <% if (_wr) { %>
    <% const _wrLeads = Array.isArray(_wr.topLeads) ? _wr.topLeads.slice(0, 5) : []; %>
    <div id="weekReviewCard" class="today-viz today-viz-reveal mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-6 md:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">This week&apos;s review</p>
          <p class="text-sm text-brand-muted">Cadence performance and who engaged most.</p>
        </div>
        <span class="today-viz-icon !mb-0 !w-10 !h-10" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18M7 15l3-3 3 2 5-6"/></svg>
        </span>
      </div>
      <div class="space-y-5 max-w-3xl">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Best-performing cadence</p>
          <p class="font-display font-bold text-brand-dark dark:text-white"><%= _wr.cadence && _wr.cadence.label ? _wr.cadence.label : '—' %><% if (_wr.cadence && _wr.cadence.count) { %> <span class="text-brand-muted font-sans font-semibold text-sm">(<%= _wr.cadence.count %> touches logged)</span><% } %></p>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Top leads by engagement</p>
          <ol class="list-decimal list-inside space-y-1.5 text-sm text-brand-dark dark:text-slate-200">
            <% if (_wrLeads.length) { %>
              <% _wrLeads.forEach(function (L) { %>
              <li><a href="/focus?lead=<%= encodeURIComponent(String(L.key || '').replace(/^lead:/i, '')) %>" class="font-semibold hover:text-brand-yellow"><%= L.title %></a> <span class="text-brand-muted">· <%= L.touches %> events</span></li>
              <% }); %>
            <% } else { %>
              <li class="text-brand-muted">No activity this week yet — log touches from Focus or the pipeline.</li>
            <% } %>
          </ol>
        </div>
        <div class="rounded-2xl border border-brand-yellow/30 bg-brand-yellow/10 dark:bg-brand-yellow/5 px-4 py-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow mb-1">Suggested experiment</p>
          <p class="text-sm text-brand-dark dark:text-slate-200 leading-relaxed"><%= _wr.experiment || '' %></p>
        </div>
      </div>
    </div>
    <% } %>

    <%- include('/partials/today_touches_hub') %>

    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-label="Tasks">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Tasks</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Due &amp; overdue</h2>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-1">Same checklist as <a href="/tasks?filter=due" class="text-brand-yellow hover:underline">Tasks → Due &amp; overdue</a>. Cadence steps stay in Today’s work above; warm replies in <a href="/engagement" class="text-brand-yellow hover:underline">Engagement</a>.</p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0 self-start">
          <a href="/engagement" class="btn-pill border border-emerald-500/40 bg-emerald-500/10 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-emerald-900 dark:text-emerald-100 whitespace-nowrap">Engagement inbox</a>
          <a href="/tasks" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap">All tasks</a>
          <a href="/tasks" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest whitespace-nowrap">Add task</a>
        </div>
      </div>
      <% if (_todayTasks.length) { %>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _todayTasks.forEach((item) => { %>
          <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-0.5">
                <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border border-brand-border/60 dark:border-white/15 text-brand-muted"><%= item.kindLabel || 'Task' %></span>
                <% if (item.overdue) { %><span class="text-[9px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-300">Overdue</span><% } %>
              </div>
              <p class="text-sm font-bold text-brand-dark dark:text-white"><%= item.title %></p>
              <p class="text-[11px] text-brand-muted mt-0.5"><%= item.scheduledAt ? new Date(item.scheduledAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '' %></p>
            </div>
            <div class="flex flex-col sm:items-end gap-1 shrink-0">
              <% if (item.leadTitle) { %>
                <span class="text-[11px] font-semibold text-brand-dark dark:text-white truncate max-w-[14rem]"><%= item.leadTitle %></span>
              <% } %>
              <a href="<%= item.href %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">Open</a>
            </div>
          </li>
        <% }) %>
      </ul>
      <% } else { %>
      <div class="today-viz-empty">
        <div class="today-viz-empty-art" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 11l3 3L22 4"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <p class="text-sm font-semibold text-brand-dark dark:text-white">No due tasks yet</p>
        <p class="text-sm text-brand-muted max-w-md">Add one on <a href="/tasks" class="text-brand-yellow font-bold hover:underline">Tasks</a> with a reminder time — scheduled follow-ups on leads stay in Focus / Pipeline until you turn them into a task.</p>
      </div>
      <% } %>
    </section>

    <% const _callWarm = typeof callWarmQueue !== 'undefined' && callWarmQueue ? callWarmQueue : []; %>
    <% if (false && _callWarm.length) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-emerald-500/30 bg-emerald-500/[0.06] dark:bg-emerald-950/40 dark:border-emerald-500/25 px-6 py-6 md:px-8 md:py-7 shadow-sm" aria-label="Call warm leads">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-emerald-700 dark:text-emerald-200 mb-2">Auto outreach</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Call warm leads (<%= _callWarm.length %>)</h2>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-1">Replied, clicked, or opened your audit/email in the last 7 days — sorted by engagement strength.</p>
        </div>
        <a href="/focus?channel=call" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap shrink-0 self-start">Open Focus</a>
      </div>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _callWarm.forEach(function (row) { %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-0.5">
              <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border border-emerald-500/40 text-emerald-800 dark:text-emerald-200"><%= row.signalLabel || 'Engaged' %></span>
            </div>
            <p class="text-sm font-bold text-brand-dark dark:text-white"><%= row.leadTitle %></p>
            <p class="text-[11px] text-brand-muted mt-0.5"><%= row.signalAt ? new Date(row.signalAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '' %></p>
          </div>
          <a href="<%= row.href %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Call in Focus</a>
        </li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <% const _fuTasks = typeof followUpTasksToday !== 'undefined' && followUpTasksToday ? followUpTasksToday : []; %>
    <% if (false && _fuTasks.length) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-6 md:p-8 shadow-sm" aria-label="Scheduled follow-ups">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Follow-ups</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Due &amp; overdue on your list</h2>
        </div>
        <a href="/tasks" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap shrink-0 self-start">All tasks</a>
      </div>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _fuTasks.forEach((t) => { %>
          <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-brand-dark dark:text-white"><%= t.title %></p>
              <p class="text-[11px] text-amber-800 dark:text-amber-200/90 mt-0.5"><%= t.scheduledAt ? new Date(t.scheduledAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '' %></p>
            </div>
            <% if (t.leadKey) { %>
              <a href="/pipeline?focusLead=<%= encodeURIComponent(t.leadKey) %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0"><%= t.leadTitle || 'Open lead' %></a>
            <% } else { %>
              <span class="text-[10px] font-bold text-brand-muted shrink-0">No lead linked</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% const _reportsOpened = typeof reportsOpened24h !== 'undefined' && reportsOpened24h ? reportsOpened24h : []; %>
    <% if (false && _reportsOpened.length) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-indigo-500/30 bg-indigo-500/[0.06] dark:bg-indigo-950/40 dark:border-indigo-500/25 px-6 py-6 md:px-8 md:py-7 shadow-sm" aria-label="Reports opened today">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-indigo-700 dark:text-indigo-200 mb-2">Hosted audit</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white">Reports opened today</h2>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-1">Leads who opened your site audit link in the last 24 hours — most recent first. Row opens Focus Mode.</p>
        </div>
        <a href="/reports?tab=site-audit" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap shrink-0 self-start">Site audit report</a>
      </div>
      <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
        <% _reportsOpened.forEach(function (row) { %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
          <a href="/focus?lead=<%= encodeURIComponent(row.focusLeadParam) %>" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow truncate min-w-0"><%= row.leadTitle %></a>
          <span class="text-[11px] text-brand-muted whitespace-nowrap sm:ml-auto tabular-nums"><%= row.lastViewedAt ? new Date(row.lastViewedAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '' %><% if (row.durationSeconds) { %> · <%= row.durationSeconds %>s<% } %></span>
        </li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <% if (empty) { %>
    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 px-6 py-8 md:px-8 md:py-10 mb-10 shadow-sm" aria-label="Get started">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Get started</p>
      <h1 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white mb-3">Let’s pull your first 50 leads — takes about 90 seconds.</h1>
      <p class="text-sm md:text-base text-brand-muted max-w-2xl mb-6">Start with one search, then launch a call session. You can also load sample data to see the full pipeline flow first.</p>
      <div class="flex flex-col sm:flex-row gap-3 mb-4">
        <a href="/leads/find?preset=icp" class="btn-pill btn-primary px-8 py-3.5 text-xs font-black uppercase tracking-widest text-center shadow-lg">Pull first 50 leads</a>
        <% if (typeof icpLabel !== 'undefined') { %>
        <button type="button" id="todayIcpPill" class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-5 py-3 text-[11px] font-bold text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">
          <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted shrink-0">Step 0 · ICP</span>
          <span class="truncate max-w-[14rem]"><%= icpLabel %></span>
        </button>
        <% } %>
      </div>
      <form method="post" action="/today/seed-demo" class="inline">
        <button type="submit" class="text-sm font-bold text-brand-yellow hover:underline">Load sample data</button>
      </form>
    </section>
    <% } %>

    <% if (_underProvisioned) { %>
    <section class="mb-8 md:mb-10 rounded-[2rem] border border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/5 dark:border-brand-yellow/30 px-6 py-6 md:px-8 md:py-7" role="region" aria-label="Pipeline math">
      <div class="flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
        <div class="flex-1">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Pipeline math</p>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-1">You need about <%= _leadTarget %> active leads to support daily goals.</h2>
          <p class="text-sm text-brand-muted">At ~54 touches/day and ~3% reply rate, your current lead volume is below target.</p>
        </div>
        <div class="w-full md:w-72">
          <div class="flex items-center justify-between text-[11px] font-bold text-brand-dark dark:text-white mb-1.5">
            <span><%= _tl %> leads</span>
            <span>Target <%= _leadTarget %></span>
          </div>
          <div class="h-3 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= _leadTarget %>" aria-valuenow="<%= _tl %>">
            <div class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width:<%= _leadPct %>%"></div>
          </div>
          <div class="mt-3 flex gap-2">
            <a href="/leads/find?preset=icp" class="btn-pill btn-primary px-5 py-2 text-[10px] font-black uppercase tracking-widest">Add leads</a>
            <a href="/pipeline?action=import" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Import CSV</a>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <% if (_showDayOneHero) { %>
    <div id="dayOneActivationWrap" class="mb-10">
      <details id="dayOneActivationDetails" class="group rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-900/60 shadow-sm overflow-hidden">
        <summary class="cursor-pointer list-none px-4 md:px-6 py-4 flex flex-wrap items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 min-w-0">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow shrink-0">Day 1 activation</span>
            <span class="font-display font-bold text-lg text-brand-dark dark:text-white tabular-nums"><%= activation.progress %>/<%= activation.total %></span>
            <span class="text-xs text-brand-muted hidden sm:inline">Tap to expand checklist</span>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a href="/activation" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline pointer-events-auto" onclick="event.stopPropagation()">Full page</a>
            <button type="button" id="dayOneActivationDismiss" class="w-9 h-9 rounded-xl border border-brand-border/60 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-muted hover:text-brand-dark dark:hover:text-white text-lg leading-none flex items-center justify-center" aria-label="Hide activation checklist">×</button>
            <span class="text-brand-muted text-lg transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
          </div>
        </summary>
        <div class="px-3 pb-4 md:px-5 md:pb-6 pt-0 border-t border-brand-border/30 dark:border-white/10">
          <%- include('partials/activation-7day', { activation, activationEmbed: true, activationHideEmbedChrome: true }) %>
        </div>
      </details>
    </div>
    <script>
    (function () {
      var wrap = document.getElementById('dayOneActivationWrap');
      var btn = document.getElementById('dayOneActivationDismiss');
      var KEY = 'todayDayOneActivationDismissed';
      function hideDayOne() {
        if (wrap) wrap.style.display = 'none';
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      }
      if (btn) btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        hideDayOne();
      });
      try {
        if (localStorage.getItem(KEY) === '1' && wrap) wrap.style.display = 'none';
      } catch (e) {}
    })();
    </script>
    <% } %>

    <% if (typeof activation !== 'undefined' && activation && typeof activationComplete !== 'undefined' && !activationComplete && _showAct && !_showDayOneHero) { %>
    <div id="activationRibbonWrap" class="mb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">7-day activation</p>
        <div class="flex items-center gap-3">
          <button type="button" id="activationRibbonDismiss" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Dismiss</button>
        </div>
      </div>
      <details class="group rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/50 dark:bg-slate-900/40 open:shadow-md">
        <summary class="cursor-pointer list-none px-6 py-4 font-display font-bold text-brand-dark dark:text-white flex items-center justify-between gap-4">
          <span>Open checklist · <%= activation.progress %>/<%= activation.total %> complete</span>
          <span class="text-brand-muted text-lg group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="px-2 pb-4 md:px-4">
          <%- include('partials/activation-7day', { activation, activationEmbed: true }) %>
        </div>
      </details>
    </div>
    <script>
    (function () {
      var wrap = document.getElementById('activationRibbonWrap');
      var btn = document.getElementById('activationRibbonDismiss');
      function hide() {
        if (wrap) wrap.style.display = 'none';
        try { localStorage.setItem('todayActivationRibbonDismissed', '1'); } catch (e) {}
      }
      if (btn) btn.addEventListener('click', hide);
      try {
        if (localStorage.getItem('todayActivationRibbonDismissed') === '1') {
          if (wrap) wrap.style.display = 'none';
        }
      } catch (e) {}
    })();
    </script>
    <% } %>

  </main>

  <% const _eq = typeof outreachCoach !== 'undefined' && outreachCoach && outreachCoach.entrepreneurQuote ? outreachCoach.entrepreneurQuote : null; %>
  <% if (_eq) { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14">
    <blockquote class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-5 py-5 md:px-6 md:py-6 text-brand-dark dark:text-slate-100">
      <p class="font-display font-bold text-base md:text-lg leading-snug">“<%= _eq.text %>”</p>
      <footer class="mt-3 text-sm font-bold text-brand-muted dark:text-slate-400">— <%= _eq.author %></footer>
    </blockquote>
  </footer>
  <% } else { %>
  <footer class="max-wide mx-auto px-6 pb-10 md:pb-14"></footer>
  <% } %>

  <% const _icpF = typeof icpForm !== 'undefined' && icpForm ? icpForm : { keyword: '', city: '', state: '', qty: 50 }; %>
  <div id="todayIcpModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="today-icp-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="today-icp-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Ideal customer profile</h2>
      <form id="todayIcpForm" class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Keyword</label>
          <input name="keyword" type="text" value="<%= _icpF.keyword || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">City</label>
            <input name="city" type="text" value="<%= _icpF.city || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">State</label>
            <input name="state" type="text" maxlength="2" value="<%= _icpF.state || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm uppercase" placeholder="OR" />
          </div>
        </div>
        <p id="todayIcpFormErr" class="hidden text-sm text-rose-600 dark:text-rose-400"></p>
        <div class="flex gap-2 justify-end pt-2">
          <button type="button" id="todayIcpCancel" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
          <button type="submit" class="btn-pill btn-primary px-4 py-2 text-xs font-black uppercase tracking-widest">Save</button>
        </div>
      </form>
    </div>
  </div>
  <script>
  (function () {
    var pill = document.getElementById('todayIcpPill');
    var modal = document.getElementById('todayIcpModal');
    var form = document.getElementById('todayIcpForm');
    var cancel = document.getElementById('todayIcpCancel');
    var err = document.getElementById('todayIcpFormErr');
    function openM() { if (modal) modal.classList.remove('hidden'); if (err) { err.classList.add('hidden'); err.textContent = ''; } }
    function closeM() { if (modal) modal.classList.add('hidden'); }
    if (pill) pill.addEventListener('click', openM);
    if (cancel) cancel.addEventListener('click', closeM);
    if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeM(); });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var body = {
        keyword: fd.get('keyword'),
        city: fd.get('city'),
        state: fd.get('state'),
      };
      fetch('/workspace/icp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (data && data.success) {
          closeM();
          window.location.reload();
        } else {
          if (err) { err.textContent = (data && data.error) || 'Could not save'; err.classList.remove('hidden'); }
        }
      }).catch(function () {
        if (err) { err.textContent = 'Could not save'; err.classList.remove('hidden'); }
      });
    });
  })();
  </script>
  <%- include('/partials/opportunity_company_panel') %>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
