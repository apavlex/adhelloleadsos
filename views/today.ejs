<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 md:py-12">
    <% if (typeof seededNotice !== 'undefined' && seededNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-300/50 bg-emerald-50/90 dark:bg-emerald-950/40 dark:border-emerald-500/30 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Sample leads were added to your Pipeline. You can edit or delete them anytime.
    </div>
    <% } %>
    <% if (typeof scheduleSavedNotice !== 'undefined' && scheduleSavedNotice) { %>
    <div class="mb-6 rounded-2xl border border-emerald-400/40 bg-emerald-50/90 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-950 dark:text-emerald-100">
      Schedule saved. Your lead run will start at the scheduled time.
    </div>
    <% } %>
    <% const _ta = typeof workspaceAccent !== 'undefined' && workspaceAccent ? workspaceAccent : ''; %>
    <p class="mb-6 md:mb-8 text-sm md:text-base text-brand-dark dark:text-white font-semibold border-b-2 pb-2 self-start" <% if (_ta) { %>style="border-color: <%= _ta %>"<% } %>>
      <span id="todayDaypart"><%= typeof greetingWord !== 'undefined' ? greetingWord : 'Hello' %></span>, <%= typeof firstName !== 'undefined' ? firstName : 'there' %> — <span id="todayDateLabel"><%= typeof dateLabel !== 'undefined' ? dateLabel : '' %></span>
    </p>
    <script>
    (function () {
      function greetingWordLocal() {
        var h = new Date().getHours();
        if (h < 12) return 'Morning';
        if (h < 17) return 'Afternoon';
        return 'Evening';
      }
      var dp = document.getElementById('todayDaypart');
      if (dp) dp.textContent = greetingWordLocal();
      var dl = document.getElementById('todayDateLabel');
      if (dl) {
        dl.textContent = new Date().toLocaleDateString(undefined, {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }
    })();
    </script>
    <script>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var el = document.querySelector('[data-today-count]');
      if (!el) return;
      var target = parseInt(el.getAttribute('data-today-count'), 10);
      if (!Number.isFinite(target) || target <= 0) return;
      var start = 0;
      var duration = 700;
      var t0 = null;
      function frame(ts) {
        if (t0 == null) t0 = ts;
        var p = Math.min(1, (ts - t0) / duration);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(start + (target - start) * eased));
        if (p < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    })();
    </script>

    <% const _tl = typeof totalLeads !== 'undefined' ? totalLeads : 0; %>
    <% const empty = _tl === 0; %>
    <% const _leadTarget = 50; %>
    <% const _underProvisioned = !empty && _tl < _leadTarget; %>
    <% const _leadPct = Math.max(0, Math.min(100, Math.round((_tl / _leadTarget) * 100))); %>
    <% const _showAct = typeof showActivationRibbon !== 'undefined' && showActivationRibbon; %>
    <% const _isDayOne = typeof activation !== 'undefined' && activation && (activation.progress || 0) === 0; %>
    <% const _showDayOneHero = empty && _showAct && _isDayOne; %>
    <% const _todayTasks = typeof todayTasks !== 'undefined' && todayTasks ? todayTasks : []; %>
    <% const _q = typeof queueNeedingAction !== 'undefined' ? Number(queueNeedingAction) || 0 : 0; %>
    <% const _tt = typeof touchesToday !== 'undefined' ? Number(touchesToday) || 0 : 0; %>
    <% const _tg = typeof touchGoal !== 'undefined' ? Math.max(1, Number(touchGoal) || 54) : 54; %>
    <% const _st = typeof streak !== 'undefined' ? Number(streak) || 0 : 0; %>
    <% const _rw = typeof repliesWaiting !== 'undefined' ? Number(repliesWaiting) || 0 : 0; %>
    <% const _roi = typeof bestRoiActivity !== 'undefined' && bestRoiActivity ? bestRoiActivity : null; %>
    <% const _roiCount = _roi ? (Number(_roi.count) || 0) : _q; %>
    <% const _touchPct = Math.max(0, Math.min(100, Math.round((_tt / _tg) * 100))); %>
    <% const _sessionGoal = 30; %>
    <% const _sessionPct = Math.max(0, Math.min(100, Math.round((_roiCount / Math.max(_sessionGoal, 1)) * 100))); %>
    <% const _ringC = 2 * Math.PI * 42; %>
    <% const _ringOffset = _ringC * (1 - _sessionPct / 100); %>
    <% const _touchRingOffset = _ringC * (1 - _touchPct / 100); %>

    <style>
      .today-viz { --today-ink: #0f2747; --today-mute: #64748b; }
      .today-viz-hero {
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(120% 80% at 100% 0%, rgba(255, 219, 58, 0.22), transparent 55%),
          radial-gradient(90% 70% at 0% 100%, rgba(15, 39, 71, 0.06), transparent 50%),
          #fff;
      }
      html.dark .today-viz-hero {
        background:
          radial-gradient(120% 80% at 100% 0%, rgba(255, 219, 58, 0.12), transparent 55%),
          radial-gradient(90% 70% at 0% 100%, rgba(255, 255, 255, 0.04), transparent 50%),
          rgba(15, 23, 42, 0.92);
      }
      .today-viz-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(15, 39, 71, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15, 39, 71, 0.035) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        pointer-events: none;
      }
      html.dark .today-viz-grid {
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      }
      .today-viz-ring { transform: rotate(-90deg); }
      .today-viz-ring-track { stroke: rgba(15, 39, 71, 0.1); }
      html.dark .today-viz-ring-track { stroke: rgba(255, 255, 255, 0.12); }
      .today-viz-ring-progress {
        stroke: #0f2747;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1);
      }
      html.dark .today-viz-ring-progress { stroke: #FFDB3A; }
      .today-viz-metric {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        border-radius: 1rem;
        border: 1px solid rgba(17, 24, 39, 0.1);
        background: rgba(255, 255, 255, 0.72);
        padding: 0.55rem 0.75rem;
        min-width: 0;
      }
      html.dark .today-viz-metric {
        background: rgba(30, 41, 59, 0.75);
        border-color: rgba(255, 255, 255, 0.12);
      }
      .today-viz-metric svg { width: 1.05rem; height: 1.05rem; flex: none; color: #0f2747; }
      html.dark .today-viz-metric svg { color: #FFDB3A; }
      .today-viz-action {
        position: relative;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .today-viz-action:hover {
        transform: translateY(-3px);
        border-color: rgba(202, 138, 4, 0.45);
        box-shadow: 0 12px 28px rgba(15, 39, 71, 0.08);
      }
      .today-viz-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 219, 58, 0.22);
        color: #0f2747;
        margin-bottom: 0.85rem;
      }
      html.dark .today-viz-icon {
        background: rgba(255, 219, 58, 0.14);
        color: #FFDB3A;
      }
      .today-viz-icon svg { width: 1.2rem; height: 1.2rem; }
      .today-viz-bars { display: flex; align-items: flex-end; gap: 0.35rem; height: 3.25rem; }
      .today-viz-bar {
        flex: 1;
        min-width: 0;
        border-radius: 0.35rem 0.35rem 0.15rem 0.15rem;
        background: linear-gradient(180deg, #FFDB3A, rgba(15, 39, 71, 0.85));
        transform-origin: bottom;
        animation: today-bar-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      html.dark .today-viz-bar {
        background: linear-gradient(180deg, #FFDB3A, rgba(255, 255, 255, 0.35));
      }
      .today-viz-spark {
        display: block;
        width: 100%;
        height: 2.25rem;
        margin-top: 0.75rem;
      }
      .today-viz-spark path {
        fill: none;
        stroke: #0f2747;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 180;
        stroke-dashoffset: 180;
        animation: today-draw 1.2s ease forwards 0.2s;
      }
      html.dark .today-viz-spark path { stroke: #FFDB3A; }
      .today-viz-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.75rem;
        padding: 1.5rem 1rem;
        border-radius: 1.25rem;
        border: 1px dashed rgba(17, 24, 39, 0.14);
        background: rgba(250, 247, 237, 0.55);
      }
      html.dark .today-viz-empty {
        border-color: rgba(255, 255, 255, 0.14);
        background: rgba(2, 6, 23, 0.35);
      }
      .today-viz-empty-art {
        width: 4.5rem;
        height: 4.5rem;
        border-radius: 1.25rem;
        display: grid;
        place-items: center;
        background: rgba(255, 219, 58, 0.2);
        color: #0f2747;
        animation: today-float 3.2s ease-in-out infinite;
      }
      html.dark .today-viz-empty-art { color: #FFDB3A; }
      .today-viz-reveal {
        animation: today-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .today-viz-reveal-delay-1 { animation-delay: 0.08s; }
      .today-viz-reveal-delay-2 { animation-delay: 0.16s; }
      .today-viz-reveal-delay-3 { animation-delay: 0.24s; }
      @keyframes today-rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes today-draw {
        to { stroke-dashoffset: 0; }
      }
      @keyframes today-bar-rise {
        from { transform: scaleY(0.15); opacity: 0.4; }
        to { transform: scaleY(1); opacity: 1; }
      }
      @keyframes today-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .today-viz-reveal,
        .today-viz-bar,
        .today-viz-spark path,
        .today-viz-empty-art,
        .today-viz-action:hover {
          animation: none !important;
          transition: none !important;
          transform: none !important;
        }
        .today-viz-spark path { stroke-dashoffset: 0; }
      }
      .today-resume > summary { list-style: none; cursor: pointer; }
      .today-resume > summary::-webkit-details-marker { display: none; }
      .today-resume-chevron { transition: transform 0.2s ease; }
      .today-resume[open] .today-resume-chevron { transform: rotate(180deg); }
      .today-resume:not([open]) .today-resume-when-open,
      .today-resume[open] .today-resume-when-closed { display: none; }
    </style>

    <% const _agentOps = typeof agentOpsDash !== 'undefined' && agentOpsDash ? agentOpsDash : null; %>
    <% const _hasAgentOps = !!( _agentOps && _agentOps.roles && _agentOps.roles.length ); %>
    <% const _leadSources = typeof leadSources !== 'undefined' && leadSources ? leadSources : null; %>
    <% const _srcList = _leadSources && Array.isArray(_leadSources.sources) ? _leadSources.sources : []; %>
    <% const _fwHome = typeof fieldWorkHome !== 'undefined' && fieldWorkHome ? fieldWorkHome : null; %>
    <% const _fwSrc = _fwHome && Array.isArray(_fwHome.sources) ? _fwHome.sources : []; %>
    <% const _combinedHome = _srcList.map(function (s) {
      return { kind: 'lead', count: s.count, label: s.label, hint: s.hint, href: s.href, hot: false };
    }).concat(_fwSrc.map(function (s) {
      return { kind: 'team', count: s.count, label: s.label, hint: s.hint, href: s.href, hot: !!(s.id === 'overdue' && s.count) };
    })); %>
    <% const _combinedNeed = (Number(_leadSources && _leadSources.needYou) || 0) + (Number(_fwHome && _fwHome.needAttention) || 0); %>
    <% if (!empty) { %>
    <section id="todayMainTabs" class="today-viz today-viz-hero today-viz-reveal mb-8 md:mb-10 rounded-[2rem] border border-brand-border dark:border-white/10 p-6 md:p-8 shadow-sm" aria-label="Today main">
      <div class="today-viz-grid" aria-hidden="true"></div>
      <div class="relative z-[1]">
        <% if (_hasAgentOps) { %>
        <div class="inline-flex rounded-2xl border border-brand-border/60 dark:border-white/15 bg-white/70 dark:bg-slate-900/60 p-1 mb-5" role="tablist" aria-label="Today main">
          <button type="button" id="todayTabNext30" role="tab" aria-controls="todayPanelNext30" aria-selected="true" data-today-tab="next30" class="today-main-tab rounded-xl px-4 py-2.5 text-[10px] font-black uppercase tracking-widest transition-all bg-brand-dark text-white dark:bg-white dark:text-slate-900">Next 30 min</button>
          <button type="button" id="todayTabOpsAgents" role="tab" aria-controls="todayPanelOpsAgents" aria-selected="false" data-today-tab="ops" class="today-main-tab rounded-xl px-4 py-2.5 text-[10px] font-black uppercase tracking-widest transition-all text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white">Ops agents</button>
        </div>
        <% } %>

        <div id="todayPanelNext30" role="tabpanel" aria-labelledby="<%= _hasAgentOps ? 'todayTabNext30' : '' %>" data-today-panel="next30" class="today-main-panel">
          <div class="flex flex-col lg:flex-row lg:items-center gap-8">
            <div class="flex-1 min-w-0" id="todayRoiHero">
              <p id="todayRoiEyebrow" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3"><%= _roi && _roi.eyebrow ? _roi.eyebrow : 'Best ROI · next 30 min' %></p>
              <h2 id="todayRoiHeadline" class="font-display font-extrabold text-xl md:text-3xl text-brand-dark dark:text-white mb-2 leading-tight">
                <% if (_roi && _roi.headline) { %>
                <%= _roi.headline %>
                <% } else { %>
                You have <span class="tabular-nums" data-today-count="<%= _q %>"><%= _q %></span> prospects queued for action today.
                <% } %>
              </h2>
              <p id="todayRoiDetail" class="text-sm text-brand-muted mb-5 max-w-xl"><%= _roi && _roi.detail ? _roi.detail : 'Start a focused calling block and work the queue in order. AdHello will keep wrap-up and next steps aligned.' %></p>
              <div class="flex flex-col sm:flex-row flex-wrap gap-3 mb-5">
                <a id="todayRoiPrimary" href="<%= _roi && _roi.primaryHref ? _roi.primaryHref : '/focus' %>" data-nav-prefetch="<%= _roi && _roi.primaryHref ? _roi.primaryHref : '/focus' %>" class="btn-pill btn-primary px-8 py-3 text-xs font-black uppercase tracking-widest text-center inline-flex items-center justify-center gap-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3l14 9-14 9V3z"/></svg>
                  <span id="todayRoiPrimaryLabel"><%= _roi && _roi.primaryLabel ? _roi.primaryLabel : 'Start session' %></span>
                </a>
                <a id="todayRoiSecondary" href="<%= _roi && _roi.secondaryHref ? _roi.secondaryHref : '/network?tab=referrals' %>" data-nav-prefetch="<%= _roi && _roi.secondaryHref ? _roi.secondaryHref : '/network?tab=referrals' %>" class="btn-pill border border-brand-border dark:border-white/20 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center inline-flex items-center justify-center gap-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7"/></svg>
                  <span id="todayRoiSecondaryLabel"><%= _roi && _roi.secondaryLabel ? _roi.secondaryLabel : 'Network leads' %></span>
                </a>
                <% if (_roi && _roi.altHref && _roi.altLabel) { %>
                <a href="<%= _roi.altHref %>" data-nav-prefetch="<%= _roi.altHref %>" class="btn-pill border border-brand-border dark:border-white/20 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center inline-flex items-center justify-center gap-2">
                  <%= _roi.altLabel %>
                </a>
                <% } %>
                <% if (_hasAgentOps) { %>
                <button type="button" id="todayJumpOpsAgents" class="btn-pill border border-brand-yellow/50 bg-brand-yellow/15 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center inline-flex items-center justify-center gap-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3M3 12h3m12 0h3M6.3 6.3l2.1 2.1m7.2 7.2 2.1 2.1m0-11.4-2.1 2.1M8.4 15.6l-2.1 2.1"/></svg>
                  Ops agents
                </button>
                <% } %>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <div class="today-viz-metric">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
                  <div class="min-w-0">
                    <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Daily goal</p>
                    <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _tt %>/<%= _tg %></p>
                  </div>
                </div>
                <div class="today-viz-metric">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2L4 14h7l-1 8 10-14h-7l1-6z"/></svg>
                  <div class="min-w-0">
                    <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Streak</p>
                    <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _st %>d</p>
                  </div>
                </div>
                <div class="today-viz-metric">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
                  <div class="min-w-0">
                    <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Replies</p>
                    <p class="text-sm font-extrabold text-brand-dark dark:text-white tabular-nums"><%= _rw %></p>
                  </div>
                </div>
              </div>
            </div>
            <div class="shrink-0 mx-auto lg:mx-0 relative w-[9.5rem] h-[9.5rem]" aria-hidden="true">
              <svg class="today-viz-ring w-full h-full" viewBox="0 0 100 100">
                <circle class="today-viz-ring-track" cx="50" cy="50" r="42" fill="none" stroke-width="8"></circle>
                <circle class="today-viz-ring-progress" cx="50" cy="50" r="42" fill="none" stroke-width="8"
                  stroke-dasharray="<%= _ringC.toFixed(2) %>"
                  stroke-dashoffset="<%= _ringOffset.toFixed(2) %>"></circle>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
                <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted"><%= _roi && _roi.ringLabel ? _roi.ringLabel : 'Queue' %></p>
                <p class="font-display font-black text-2xl text-brand-dark dark:text-white tabular-nums leading-none" data-today-count="<%= _roiCount %>"><%= _roiCount %></p>
                <p class="text-[10px] font-bold text-brand-muted mt-1"><%= _sessionPct %>% of <%= _sessionGoal %></p>
              </div>
            </div>
          </div>
        </div>

        <% if (_hasAgentOps) { %>
        <div id="todayPanelOpsAgents" role="tabpanel" aria-labelledby="todayTabOpsAgents" data-today-panel="ops" class="today-main-panel hidden" hidden>
          <div id="agentOpsPanel" class="relative z-[1]" aria-label="Ops agents">
            <% const _runningRoles = Array.isArray(_agentOps.runningRoles) ? _agentOps.runningRoles : (_agentOps.roles || []).filter((r) => r.running); %>
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-5">
              <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Ops agents</p>
                <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white">Your role bots</h2>
                <p class="text-sm text-brand-muted dark:text-slate-400 mt-1">Prospect SDR, Opportunity SDR, Dispatcher, Network Coach, and Ops scan AdHello and leave the next move here. Auto-runs about hourly — hit <span class="font-semibold text-brand-dark dark:text-white">Pause</span> on a card (or Pause all) to stop AI credit use while you’re away.</p>
                <p id="agentOpsRunningLine" class="text-sm font-semibold text-amber-700 dark:text-amber-300 mt-2 <%= _runningRoles.length ? '' : 'hidden' %>" <%= _runningRoles.length ? '' : 'hidden' %> aria-live="polite">
                  <% if (_runningRoles.length === 1) { %>
                    <span class="inline-flex items-center gap-2"><span class="agent-ops-pulse" aria-hidden="true"></span><%= _runningRoles[0].title %> is running…</span>
                  <% } else if (_runningRoles.length > 1) { %>
                    <span class="inline-flex items-center gap-2"><span class="agent-ops-pulse" aria-hidden="true"></span><%= _runningRoles.map((r) => r.title).join(', ') %> are running…</span>
                  <% } %>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2 shrink-0 self-start">
                <button type="button" id="agentOpsPauseAll" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap" data-ops-enabled="<%= _agentOps.enabled !== false ? '1' : '0' %>" title="<%= _agentOps.enabled !== false ? 'Stop hourly auto-runs for every bot (saves AI credits)' : 'Turn hourly auto-runs back on for every bot' %>"><%= _agentOps.enabled !== false ? 'Pause all' : 'Resume all' %></button>
                <button type="button" id="agentOpsTickAll" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white whitespace-nowrap">Run all</button>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
              <% _agentOps.roles.forEach((role) => { %>
                <% const insight = role.insight; %>
                <% const items = Array.isArray(role.items) ? role.items : []; %>
                <% const _roleState = role.running ? 'running' : ((items.length || (insight && insight.body)) ? 'ready' : 'idle'); %>
                <% const _roleAutoOn = role.autoTick !== false && role.enabled !== false && _agentOps.enabled !== false; %>
                <article class="agent-ops-card rounded-2xl border border-brand-border/70 dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-4 md:p-5 flex flex-col gap-3 <%= role.running ? 'opacity-80' : '' %>" data-agent-role="<%= role.id %>" data-job="<%= role.defaultJob %>" data-enabled="<%= role.enabled !== false ? '1' : '0' %>" data-auto-tick="<%= role.autoTick !== false ? '1' : '0' %>" style="border-left: 3px solid <%= role.color || '#94a3b8' %>;">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-[10px] font-black uppercase tracking-widest" style="color: <%= role.color || '#64748b' %>"><%= role.name %></p>
                        <span class="agent-ops-state text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border <%= _roleState === 'running' ? 'border-amber-500/50 text-amber-700 dark:text-amber-300' : (_roleState === 'ready' ? 'border-emerald-500/40 text-emerald-700 dark:text-emerald-300' : 'border-brand-border/60 dark:border-white/15 text-brand-muted') %>" data-state="<%= _roleState %>"><%= _roleState === 'running' ? 'Running' : (_roleState === 'ready' ? 'Ready' : 'Idle') %></span>
                        <span class="agent-ops-auto text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border border-emerald-500/40 text-emerald-700 dark:text-emerald-300 dark:border-emerald-500/30 <%= _roleAutoOn ? '' : 'hidden' %>" title="Auto-runs about hourly" <%= _roleAutoOn ? '' : 'hidden' %>>Auto</span>
                        <span class="agent-ops-paused text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border border-slate-300 text-slate-600 dark:border-white/20 dark:text-slate-300 <%= _roleAutoOn ? 'hidden' : '' %>" title="Hourly auto-run is off — no AI credit burn until you resume" <%= _roleAutoOn ? 'hidden' : '' %>>Paused</span>
                      </div>
                      <h3 class="font-display font-extrabold text-base text-brand-dark dark:text-white mt-0.5"><%= role.title %></h3>
                      <p class="text-xs text-brand-muted dark:text-slate-400 mt-1"><%= role.blurb %></p>
                    </div>
                    <div class="flex flex-col items-stretch gap-1.5 shrink-0">
                      <button type="button" class="agent-ops-run btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest whitespace-nowrap" data-job="<%= role.defaultJob %>" <%= role.running || role.enabled === false || _agentOps.enabled === false ? 'disabled' : '' %>><%= role.running ? 'Running…' : 'Run' %></button>
                      <button type="button" class="agent-ops-pause btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-[10px] font-black uppercase tracking-widest whitespace-nowrap text-brand-dark dark:text-white" data-agent-role="<%= role.id %>" title="<%= _roleAutoOn ? 'Pause hourly auto-run (saves AI credits)' : 'Resume hourly auto-run' %>"><%= _roleAutoOn ? 'Pause' : 'Resume' %></button>
                    </div>
                  </div>
                  <div class="agent-ops-insight text-sm text-brand-dark dark:text-slate-200">
                    <% if (insight && insight.body) { %>
                      <p class="font-semibold agent-ops-title"><%= insight.title %></p>
                      <p class="text-xs text-brand-muted dark:text-slate-400 mt-1 agent-ops-body"><%= insight.body %></p>
                    <% } else { %>
                      <p class="text-xs text-brand-muted agent-ops-empty">Not run yet — hit Run to scan.</p>
                    <% } %>
                  </div>
                  <details class="agent-ops-details group rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/30 <%= items.length ? '' : 'hidden' %>" <%= items.length ? '' : 'hidden' %>>
                    <summary class="cursor-pointer list-none flex items-center justify-between gap-2 px-3 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">
                      <span class="agent-ops-details-label"><%= items.length %> <%= items.some((i) => i.kind === 'task') && !items.some((i) => i.kind === 'lead') ? (items.length === 1 ? 'task' : 'tasks') : (items.length === 1 ? 'item' : 'items') %></span>
                      <span class="text-brand-muted group-open:hidden">Open</span>
                      <span class="text-brand-muted hidden group-open:inline">Close</span>
                    </summary>
                    <ul class="agent-ops-items divide-y divide-brand-border/40 dark:divide-white/10 px-3 pb-2">
                      <% items.forEach((item) => { %>
                        <li class="py-2.5 flex items-start gap-3">
                          <div class="min-w-0 flex-1">
                            <% if (item.badge) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted"><%= item.badge %></span><% } %>
                            <p class="text-sm font-bold text-brand-dark dark:text-white"><%= item.title %></p>
                            <% if (item.subtitle) { %><p class="text-[11px] text-brand-muted mt-0.5"><%= item.subtitle %></p><% } %>
                          </div>
                          <% if (item.href) { %>
                            <a href="<%= item.href %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0 mt-1">Open</a>
                          <% } %>
                        </li>
                      <% }) %>
                    </ul>
                  </details>
                  <% if (insight && (insight.href || (insight.meta && insight.meta.items && insight.meta.items.length))) { %>
                    <a href="/focus?from=today" class="agent-ops-href text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline w-fit">Contact leads</a>
                  <% } else { %>
                    <a href="/focus?from=today" class="agent-ops-href text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline w-fit hidden" hidden>Contact leads</a>
                  <% } %>
                </article>
              <% }) %>
            </div>
            <p id="agentOpsStatus" class="text-xs text-brand-muted mt-4 min-h-[1rem]" aria-live="polite"></p>
          </div>
        </div>
        <script>
          (function () {
            var root = document.getElementById('todayMainTabs');
            if (!root) return;
            var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-today-tab]'));
            var panels = Array.prototype.slice.call(root.querySelectorAll('[data-today-panel]'));
            var onOpsTabChange = function () {};
            function setTab(id) {
              var want = id === 'ops' ? 'ops' : 'next30';
              tabs.forEach(function (tab) {
                var active = tab.getAttribute('data-today-tab') === want;
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
                tab.classList.toggle('bg-brand-dark', active);
                tab.classList.toggle('text-white', active);
                tab.classList.toggle('dark:bg-white', active);
                tab.classList.toggle('dark:text-slate-900', active);
                tab.classList.toggle('text-brand-muted', !active);
                tab.classList.toggle('dark:text-slate-400', !active);
              });
              panels.forEach(function (panel) {
                var active = panel.getAttribute('data-today-panel') === want;
                panel.classList.toggle('hidden', !active);
                if (active) panel.removeAttribute('hidden');
                else panel.setAttribute('hidden', '');
              });
              try {
                if (want === 'ops') history.replaceState(null, '', '#ops-agents');
                else if (location.hash === '#ops-agents' || location.hash === '#ops') history.replaceState(null, '', location.pathname + location.search);
              } catch (_) {}
              onOpsTabChange(want);
            }
            tabs.forEach(function (tab) {
              tab.addEventListener('click', function () { setTab(tab.getAttribute('data-today-tab')); });
            });
            var jump = document.getElementById('todayJumpOpsAgents');
            if (jump) jump.addEventListener('click', function () { setTab('ops'); });
            var hash = String(location.hash || '').toLowerCase();
            var params = new URLSearchParams(location.search || '');
            if (hash === '#ops-agents' || hash === '#ops' || params.get('tab') === 'ops') setTab('ops');

            var panel = document.getElementById('agentOpsPanel');
            if (!panel) return;
            var statusEl = document.getElementById('agentOpsStatus');
            function setStatus(msg) { if (statusEl) statusEl.textContent = msg || ''; }
            function esc(s) {
              return String(s == null ? '' : s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
            }
            var opsMasterEnabled = <%- JSON.stringify(_agentOps.enabled !== false) %>;
            function roleAutoOn(card) {
              if (!card) return false;
              if (!opsMasterEnabled) return false;
              if (card.getAttribute('data-enabled') === '0') return false;
              return card.getAttribute('data-auto-tick') !== '0';
            }
            function paintPauseControls(card) {
              if (!card) return;
              var autoOn = roleAutoOn(card);
              var autoBadge = card.querySelector('.agent-ops-auto');
              var pausedBadge = card.querySelector('.agent-ops-paused');
              var pauseBtn = card.querySelector('.agent-ops-pause');
              if (autoBadge) {
                autoBadge.classList.toggle('hidden', !autoOn);
                if (autoOn) autoBadge.removeAttribute('hidden');
                else autoBadge.setAttribute('hidden', '');
              }
              if (pausedBadge) {
                pausedBadge.classList.toggle('hidden', autoOn);
                if (autoOn) pausedBadge.setAttribute('hidden', '');
                else pausedBadge.removeAttribute('hidden');
              }
              if (pauseBtn) {
                pauseBtn.textContent = autoOn ? 'Pause' : 'Resume';
                pauseBtn.title = autoOn
                  ? 'Pause hourly auto-run (saves AI credits)'
                  : 'Resume hourly auto-run';
                // When master ops is off, Resume on a card re-enables master + that role's auto.
                pauseBtn.setAttribute('data-mode', autoOn ? 'pause' : 'resume');
              }
            }
            function paintPauseAllBtn() {
              var btn = document.getElementById('agentOpsPauseAll');
              if (!btn) return;
              btn.setAttribute('data-ops-enabled', opsMasterEnabled ? '1' : '0');
              btn.textContent = opsMasterEnabled ? 'Pause all' : 'Resume all';
              btn.title = opsMasterEnabled
                ? 'Stop hourly auto-runs for every bot (saves AI credits)'
                : 'Turn hourly auto-runs back on for every bot';
            }
            function setCardState(card, state) {
              if (!card) return;
              var badge = card.querySelector('.agent-ops-state');
              var btn = card.querySelector('.agent-ops-run');
              var label = state === 'running' ? 'Running' : (state === 'ready' ? 'Ready' : 'Idle');
              if (badge) {
                badge.textContent = label;
                badge.setAttribute('data-state', state || 'idle');
                badge.classList.toggle('border-amber-500/50', state === 'running');
                badge.classList.toggle('text-amber-700', state === 'running');
                badge.classList.toggle('dark:text-amber-300', state === 'running');
                badge.classList.toggle('border-emerald-500/40', state === 'ready');
                badge.classList.toggle('text-emerald-700', state === 'ready');
                badge.classList.toggle('dark:text-emerald-300', state === 'ready');
                badge.classList.toggle('border-brand-border/60', state !== 'running' && state !== 'ready');
                badge.classList.toggle('text-brand-muted', state !== 'running' && state !== 'ready');
              }
              if (btn) {
                var blocked = state === 'running' || !opsMasterEnabled || card.getAttribute('data-enabled') === '0';
                btn.disabled = blocked;
                btn.textContent = state === 'running' ? 'Running…' : 'Run';
              }
              card.classList.toggle('opacity-80', state === 'running');
              card.setAttribute('data-running', state === 'running' ? '1' : '0');
              paintPauseControls(card);
            }
            function paintRunningLine(roles) {
              var line = document.getElementById('agentOpsRunningLine');
              if (!line) return;
              var running = (Array.isArray(roles) ? roles : []).filter(function (r) { return r && r.running; });
              if (!running.length) {
                line.classList.add('hidden');
                line.setAttribute('hidden', '');
                line.textContent = '';
                return;
              }
              var names = running.map(function (r) { return r.title || r.id; });
              var text = names.length === 1
                ? names[0] + ' is running…'
                : names.join(', ') + ' are running…';
              line.innerHTML = '<span class="inline-flex items-center gap-2"><span class="agent-ops-pulse" aria-hidden="true"></span>' + esc(text) + '</span>';
              line.classList.remove('hidden');
              line.removeAttribute('hidden');
            }
            function itemsLabel(items) {
              var list = Array.isArray(items) ? items : [];
              var onlyTasks = list.length && list.every(function (i) { return i.kind === 'task' || i.kind === 'issue'; });
              var noun = onlyTasks ? (list.length === 1 ? 'task' : 'tasks') : (list.length === 1 ? 'item' : 'items');
              return list.length + ' ' + noun;
            }
            function paintItems(card, items) {
              var details = card.querySelector('.agent-ops-details');
              var listEl = card.querySelector('.agent-ops-items');
              var label = card.querySelector('.agent-ops-details-label');
              if (!details || !listEl) return;
              var rows = Array.isArray(items) ? items : [];
              if (!rows.length) {
                details.classList.add('hidden');
                details.setAttribute('hidden', '');
                details.open = false;
                listEl.innerHTML = '';
                return;
              }
              details.classList.remove('hidden');
              details.removeAttribute('hidden');
              if (label) label.textContent = itemsLabel(rows);
              listEl.innerHTML = rows.map(function (item) {
                var badge = item.badge
                  ? '<span class="text-[9px] font-black uppercase tracking-widest text-brand-muted">' + esc(item.badge) + '</span>'
                  : '';
                var sub = item.subtitle
                  ? '<p class="text-[11px] text-brand-muted mt-0.5">' + esc(item.subtitle) + '</p>'
                  : '';
                var link = item.href
                  ? '<a href="' + esc(item.href) + '" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0 mt-1">Open</a>'
                  : '';
                return '<li class="py-2.5 flex items-start gap-3"><div class="min-w-0 flex-1">' + badge +
                  '<p class="text-sm font-bold text-brand-dark dark:text-white">' + esc(item.title || 'Item') + '</p>' +
                  sub + '</div>' + link + '</li>';
              }).join('');
            }
            function paintRole(role) {
              if (!role) return;
              var card = panel.querySelector('[data-agent-role="' + role.id + '"]');
              if (!card) return;
              card.setAttribute('data-enabled', role.enabled === false ? '0' : '1');
              card.setAttribute('data-auto-tick', role.autoTick === false ? '0' : '1');
              var box = card.querySelector('.agent-ops-insight');
              var hrefEl = card.querySelector('.agent-ops-href');
              var insight = role.insight;
              if (box) {
                if (insight && insight.body) {
                  box.innerHTML = '<p class="font-semibold agent-ops-title"></p><p class="text-xs text-brand-muted dark:text-slate-400 mt-1 agent-ops-body"></p>';
                  box.querySelector('.agent-ops-title').textContent = insight.title || '';
                  box.querySelector('.agent-ops-body').textContent = insight.body || '';
                } else {
                  box.innerHTML = '<p class="text-xs text-brand-muted agent-ops-empty">Not run yet — hit Run to scan.</p>';
                }
              }
              if (hrefEl) {
                var hasLeads = insight && (
                  insight.href
                  || (insight.meta && insight.meta.items && insight.meta.items.length)
                  || (role.items && role.items.length)
                );
                if (hasLeads) {
                  hrefEl.href = '/focus?from=today';
                  hrefEl.classList.remove('hidden');
                  hrefEl.removeAttribute('hidden');
                  hrefEl.textContent = 'Contact leads';
                } else {
                  hrefEl.classList.add('hidden');
                  hrefEl.setAttribute('hidden', '');
                }
              }
              paintItems(card, role.items || (insight && insight.meta && insight.meta.items) || []);
              if (role.running) setCardState(card, 'running');
              else setCardState(card, (role.items && role.items.length) || (insight && insight.body) ? 'ready' : 'idle');
            }
            function paintDashboard(dash) {
              if (!dash || !Array.isArray(dash.roles)) return;
              if (typeof dash.enabled === 'boolean') opsMasterEnabled = dash.enabled;
              paintPauseAllBtn();
              dash.roles.forEach(paintRole);
              paintRunningLine(dash.runningRoles && dash.runningRoles.length
                ? dash.runningRoles
                : dash.roles.filter(function (r) { return r.running; }));
            }
            var pollTimer = null;
            async function refreshStatus() {
              try {
                var res = await fetch('/agent-ops/status', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok || data.success === false) return;
                paintDashboard(data);
              } catch (_) { /* ignore */ }
            }
            function stopPoll() {
              if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            }
            function startPoll() {
              stopPoll();
              refreshStatus();
              pollTimer = setInterval(refreshStatus, 3000);
            }
            async function postJson(url, body) {
              var res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(body || {}),
              });
              var data = await res.json().catch(function () { return {}; });
              if (!res.ok || data.success === false) {
                throw new Error((data && data.error) || ('Request failed (' + res.status + ')'));
              }
              return data;
            }
            panel.querySelectorAll('.agent-ops-run').forEach(function (btn) {
              btn.addEventListener('click', async function () {
                var job = btn.getAttribute('data-job');
                var card = btn.closest('.agent-ops-card');
                if (!job) return;
                var title = card && card.querySelector('h3') ? card.querySelector('h3').textContent : job;
                setCardState(card, 'running');
                paintRunningLine([{ title: title }]);
                setStatus('Running ' + title + '…');
                try {
                  var data = await postJson('/agent-ops/run', { type: job });
                  if (data.dashboard) paintDashboard(data.dashboard);
                  else setCardState(card, 'ready');
                  setStatus((data.result && data.result.summary) || 'Done.');
                  if (card) {
                    var details = card.querySelector('.agent-ops-details');
                    if (details && !details.hasAttribute('hidden')) details.open = true;
                  }
                } catch (err) {
                  setCardState(card, 'idle');
                  paintRunningLine([]);
                  setStatus(err.message || 'Failed.');
                }
              });
            });
            panel.querySelectorAll('.agent-ops-pause').forEach(function (btn) {
              btn.addEventListener('click', async function () {
                var card = btn.closest('.agent-ops-card');
                var roleId = btn.getAttribute('data-agent-role') || (card && card.getAttribute('data-agent-role'));
                if (!roleId) return;
                var wantAuto = !roleAutoOn(card);
                btn.disabled = true;
                var title = card && card.querySelector('h3') ? card.querySelector('h3').textContent : roleId;
                setStatus((wantAuto ? 'Resuming ' : 'Pausing ') + title + '…');
                try {
                  var body = { roles: {} };
                  body.roles[roleId] = { autoTick: wantAuto, enabled: true };
                  // Resuming a single bot while master is off turns the fleet back on.
                  if (wantAuto && !opsMasterEnabled) body.enabled = true;
                  var data = await postJson('/agent-ops/settings', body);
                  if (data.dashboard) paintDashboard(data.dashboard);
                  else {
                    if (typeof data.settings === 'object' && data.settings && typeof data.settings.enabled === 'boolean') {
                      opsMasterEnabled = data.settings.enabled;
                    }
                    if (card) {
                      card.setAttribute('data-auto-tick', wantAuto ? '1' : '0');
                      card.setAttribute('data-enabled', '1');
                      paintPauseControls(card);
                      paintPauseAllBtn();
                    }
                  }
                  setStatus(wantAuto
                    ? (title + ' auto-run is back on.')
                    : (title + ' paused — no hourly AI runs until you resume.'));
                } catch (err) {
                  setStatus(err.message || 'Could not update bot.');
                } finally {
                  btn.disabled = false;
                }
              });
            });
            var pauseAll = document.getElementById('agentOpsPauseAll');
            if (pauseAll) {
              pauseAll.addEventListener('click', async function () {
                var wantOn = !opsMasterEnabled;
                pauseAll.disabled = true;
                setStatus(wantOn ? 'Resuming all bots…' : 'Pausing all bots…');
                try {
                  var data = await postJson('/agent-ops/settings', { enabled: wantOn });
                  if (data.dashboard) paintDashboard(data.dashboard);
                  else {
                    opsMasterEnabled = wantOn;
                    paintPauseAllBtn();
                    panel.querySelectorAll('.agent-ops-card').forEach(paintPauseControls);
                  }
                  setStatus(wantOn
                    ? 'All bots resumed — hourly auto-runs are on.'
                    : 'All bots paused — no hourly AI credit use until you resume.');
                } catch (err) {
                  setStatus(err.message || 'Could not update bots.');
                } finally {
                  pauseAll.disabled = false;
                }
              });
            }
            var tickAll = document.getElementById('agentOpsTickAll');
            if (tickAll) {
              tickAll.addEventListener('click', async function () {
                tickAll.disabled = true;
                tickAll.textContent = 'Running…';
                var allCards = panel.querySelectorAll('.agent-ops-card');
                var titles = [];
                allCards.forEach(function (card) {
                  setCardState(card, 'running');
                  var h = card.querySelector('h3');
                  if (h) titles.push(h.textContent);
                });
                paintRunningLine(titles.map(function (t) { return { title: t }; }));
                setStatus('Running all agents…');
                try {
                  var data = await postJson('/agent-ops/tick', { force: true });
                  if (data.dashboard) paintDashboard(data.dashboard);
                  setStatus('All agents finished.');
                } catch (err) {
                  allCards.forEach(function (card) { setCardState(card, 'idle'); });
                  paintRunningLine([]);
                  setStatus(err.message || 'Failed.');
                } finally {
                  tickAll.disabled = false;
                  tickAll.textContent = 'Run all';
                }
              });
            }
            // Keep Running badges in sync with background auto-ticks while Ops tab is open.
            onOpsTabChange = function (want) {
              if (want === 'ops') startPoll();
              else stopPoll();
            };
            var opsTab = document.getElementById('todayTabOpsAgents');
            if (opsTab && opsTab.getAttribute('aria-selected') === 'true') startPoll();
            document.addEventListener('visibilitychange', function () {
              if (document.hidden) stopPoll();
              else if (opsTab && opsTab.getAttribute('aria-selected') === 'true') startPoll();
            });
          })();
        </script>
        <style>
          .agent-ops-pulse {
            width: 0.55rem; height: 0.55rem; border-radius: 999px;
            background: #d97706; box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.55);
            animation: agent-ops-pulse 1.4s ease-out infinite;
            flex-shrink: 0;
          }
          .agent-ops-state[data-state="running"] {
            position: relative;
          }
          .dark .agent-ops-pulse { background: #fbbf24; box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.45); }
          @keyframes agent-ops-pulse {
            0% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.5); }
            70% { box-shadow: 0 0 0 8px rgba(217, 119, 6, 0); }
            100% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0); }
          }
        </style>
        <% } %>
      </div>
    </section>

    <div id="todaySourcesSlot">
    <% if (_combinedHome.length) { %>
    <section class="today-viz today-viz-reveal mb-8 md:mb-10" aria-label="Lead and team sources">
      <div class="flex items-baseline justify-between gap-3 mb-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Active numbers</p>
          <h2 class="font-display font-extrabold text-lg md:text-xl text-brand-dark dark:text-white leading-tight">
            <span class="tabular-nums"><%= _combinedNeed %></span> need attention
            <span class="text-brand-muted font-semibold text-sm md:text-base"> · leads &amp; field work</span>
          </h2>
        </div>
        <a href="/network?tab=calendar" class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:underline shrink-0">Calendar</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
        <% _combinedHome.forEach(function (s) { %>
