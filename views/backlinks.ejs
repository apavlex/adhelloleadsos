<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <main class="max-wide px-6 py-8 md:py-12">
    <header class="mb-6 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">SEO / Local Rank · DataForSEO</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight">Backlinks</h1>
        <p class="text-sm text-brand-muted dark:text-slate-400 mt-2 max-w-2xl">
          Your site and competitors — totals, referring domains, anchors, new/lost, and link gaps. Research is saved on this workspace.
        </p>
      </div>
    </header>

    <%- include('partials/seo_local_rank_nav') %>

    <% if (!dfsReady) { %>
    <div class="mb-6 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-950 dark:text-amber-100">
      Connect DataForSEO under <a class="underline font-semibold" href="/workspace/integrations#integration-dataforseo">Workspace → Integrations</a> before syncing.
    </div>
    <% } else { %>
    <div class="mb-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-900 dark:text-emerald-100">
      DataForSEO connected. Create a project and sync to pull backlink research.
    </div>
    <% } %>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <section class="xl:col-span-1 space-y-4">
        <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/70 p-5">
          <h2 class="font-display font-bold text-lg mb-3">New project</h2>
          <form id="blCreate" class="space-y-3">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Your domain</label>
              <input name="seedDomain" required placeholder="acmeflooring.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
            </div>
            <button type="submit" class="btn-pill btn-primary w-full py-2.5 text-[10px] font-black uppercase tracking-widest" <%= dfsReady ? '' : 'disabled' %>>Create project</button>
          </form>
          <p id="blCreateErr" class="text-sm text-rose-600 dark:text-rose-400 mt-3 hidden"></p>
        </div>

        <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/70 p-5">
          <h2 class="font-display font-bold text-lg mb-3">Saved research</h2>
          <% const _projects = Array.isArray(projects) ? projects : []; %>
          <% if (!_projects.length) { %>
          <p class="text-sm text-brand-muted">No projects yet.</p>
          <% } else { %>
          <ul class="space-y-2">
            <% _projects.forEach(function (p) { %>
            <li class="flex items-center gap-2">
              <a href="/backlinks/<%= encodeURIComponent(p.id) %>" class="flex-1 block rounded-xl border <%= project && project.id === p.id ? 'border-brand-yellow/50 bg-brand-yellow/10' : 'border-brand-border/50 dark:border-white/10' %> px-3 py-2 hover:border-brand-yellow/40 transition-colors">
                <div class="font-semibold text-sm"><%= p.seedDomain %></div>
                <div class="text-[11px] text-brand-muted">
                  <%= p.syncStatus || 'new' %><% if (p.lastSyncedAt) { %> · <%= new Date(p.lastSyncedAt).toLocaleString('en-US', { timeZone: 'America/Los_Angeles' }) %> PT<% } %>
                </div>
              </a>
              <button type="button" data-bl-delete="<%= p.id %>" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-rose-500 px-2">Del</button>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>
      </section>

      <section class="xl:col-span-2 space-y-4">
        <% if (!project) { %>
        <div class="rounded-2xl border border-dashed border-brand-border/70 dark:border-white/15 p-10 text-center text-brand-muted">
          Select or create a project to sync DataForSEO backlink research.
        </div>
        <% } else { %>
          <% const you = project.you || {}; const sum = you.summary || {}; const sm = project.summary || {}; %>
          <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/70 p-5" id="blProject" data-id="<%= project.id %>">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <h2 class="font-display font-bold text-xl"><%= project.seedDomain %></h2>
                <p class="text-xs text-brand-muted mt-1">
                  <%= project.syncStatus || 'new' %>
                  <% if (project.lastSyncedAt) { %> · Synced <%= new Date(project.lastSyncedAt).toLocaleString('en-US', { timeZone: 'America/Los_Angeles' }) %> PT<% } %>
                </p>
              </div>
              <button type="button" id="blSyncBtn" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest" <%= !dfsReady ? 'disabled' : '' %>>Update from DataForSEO</button>
            </div>
            <p id="blSyncErr" class="text-sm text-rose-600 dark:text-rose-400 mb-3 hidden"></p>

            <% if ((project.warnings || []).length) { %>
            <details class="mb-4 text-xs text-amber-700 dark:text-amber-200">
              <summary><%= project.warnings.length %> sync warning(s)</summary>
              <ul class="mt-2 list-disc pl-5 space-y-1"><% project.warnings.forEach(function (w) { %><li><%= w %></li><% }) %></ul>
            </details>
            <% } %>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
              <div class="rounded-xl border border-brand-border/50 dark:border-white/10 p-3">
                <p class="text-[10px] uppercase tracking-widest text-brand-muted">Backlinks</p>
                <p class="font-display font-black text-2xl mt-1"><%= sm.yourBacklinks != null ? sm.yourBacklinks : (sum.backlinks || 0) %></p>
              </div>
              <div class="rounded-xl border border-brand-border/50 dark:border-white/10 p-3">
                <p class="text-[10px] uppercase tracking-widest text-brand-muted">Referring domains</p>
                <p class="font-display font-black text-2xl mt-1"><%= sm.yourReferringDomains != null ? sm.yourReferringDomains : (sum.referringDomains || 0) %></p>
              </div>
              <div class="rounded-xl border border-brand-border/50 dark:border-white/10 p-3">
                <p class="text-[10px] uppercase tracking-widest text-brand-muted">Domain rank</p>
                <p class="font-display font-black text-2xl mt-1"><%= sum.rank != null ? sum.rank : '—' %></p>
              </div>
              <div class="rounded-xl border border-brand-border/50 dark:border-white/10 p-3">
                <p class="text-[10px] uppercase tracking-widest text-brand-muted">Link gaps</p>
                <p class="font-display font-black text-2xl mt-1"><%= sm.linkGapCount != null ? sm.linkGapCount : ((project.linkGaps || []).length) %></p>
              </div>
            </div>

            <% const _ls = typeof localSearchDefaults !== 'undefined' && localSearchDefaults ? localSearchDefaults : { keyword: '', city: '', state: '', businessName: '' }; %>
            <% const _comps = Array.isArray(project.competitors) ? project.competitors : []; %>
            <section class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4 mb-6" aria-labelledby="blCompTitle">
              <h3 id="blCompTitle" class="font-semibold text-sm mb-1">Local competitors</h3>
              <p class="text-xs text-brand-muted mb-3">Search Google Maps locally and pick real rivals — not Facebook or Yelp. Selected domains are used for comparison and link gaps.</p>
              <div class="flex flex-wrap gap-2 mb-3" id="blSelectedComps">
                <% if (!_comps.length) { %>
                <p class="text-xs text-amber-800 dark:text-amber-200" id="blSelectedEmpty">No competitors selected yet.</p>
                <% } else { %>
                <% _comps.forEach(function (c) { %>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-1 text-xs font-semibold" data-comp-chip="<%= c.domain %>">
                  <%= c.title ? (c.title + ' · ') : '' %><%= c.domain %>
                  <button type="button" class="text-brand-muted hover:text-rose-500" data-comp-remove="<%= c.domain %>" aria-label="Remove <%= c.domain %>">×</button>
                </span>
                <% }) %>
                <% } %>
              </div>
              <div class="grid gap-2 sm:grid-cols-4 mb-3">
                <label class="sm:col-span-2 block">
                  <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Local search</span>
                  <input id="blCompKeyword" type="text" value="<%= _ls.keyword %>" placeholder="flooring Camas WA" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                  <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">City</span>
                  <input id="blCompCity" type="text" value="<%= _ls.city %>" placeholder="Camas" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                  <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">State</span>
                  <input id="blCompState" type="text" value="<%= _ls.state %>" placeholder="WA" class="mt-1 w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                </label>
              </div>
              <div class="flex flex-wrap gap-2 mb-3">
                <button type="button" id="blCompSearchBtn" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest" <%= !dfsReady ? 'disabled' : '' %>>Search Google Maps</button>
                <button type="button" id="blCompSaveBtn" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-[10px] font-black uppercase tracking-widest">Save selection</button>
                <label class="inline-flex items-center gap-2 text-xs text-brand-muted ml-auto">
                  <span>Or add domain</span>
                  <input id="blCompManual" type="text" placeholder="rivalflooring.com" class="rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-950 px-2 py-1.5 text-xs w-40" />
                  <button type="button" id="blCompAddManual" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Add</button>
                </label>
              </div>
              <p id="blCompStatus" class="text-xs font-semibold text-brand-muted min-h-[1rem] mb-2" role="status" aria-live="polite"></p>
              <div id="blCompResults" class="space-y-1.5 max-h-64 overflow-y-auto hidden"></div>
            </section>

            <% if (project.comparison && project.comparison.length) { %>
            <h3 class="font-semibold text-sm mb-2">Competitor comparison</h3>
            <div class="overflow-x-auto rounded-xl border border-brand-border/50 dark:border-white/10 mb-6">
              <table class="min-w-full text-sm">
                <thead class="bg-brand-cream/40 dark:bg-slate-950 text-left text-[10px] uppercase tracking-widest text-brand-muted">
                  <tr>
                    <th class="px-3 py-2">Domain</th>
                    <th class="px-3 py-2">Backlinks</th>
                    <th class="px-3 py-2">Ref. domains</th>
                    <th class="px-3 py-2">Rank</th>
                    <th class="px-3 py-2">vs you</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
                  <tr class="bg-brand-yellow/10">
                    <td class="px-3 py-2 font-semibold"><%= project.seedDomain %> (you)</td>
                    <td class="px-3 py-2"><%= sum.backlinks || 0 %></td>
                    <td class="px-3 py-2"><%= sum.referringDomains || 0 %></td>
                    <td class="px-3 py-2"><%= sum.rank != null ? sum.rank : '—' %></td>
                    <td class="px-3 py-2">—</td>
                  </tr>
                  <% project.comparison.forEach(function (c) { %>
                  <tr>
                    <td class="px-3 py-2"><%= c.domain %></td>
                    <td class="px-3 py-2"><%= c.backlinks %></td>
                    <td class="px-3 py-2"><%= c.referringDomains %></td>
                    <td class="px-3 py-2"><%= c.rank != null ? c.rank : '—' %></td>
                    <td class="px-3 py-2 <%= c.vsYouBacklinks > 0 ? 'text-rose-600 dark:text-rose-300' : 'text-emerald-700 dark:text-emerald-300' %>"><%= c.vsYouBacklinks > 0 ? '+' : '' %><%= c.vsYouBacklinks %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } else if (!_comps.length) { %>
            <p class="text-sm text-brand-muted mb-6">Select local competitors above, save, then update from DataForSEO to compare backlinks and find link gaps.</p>
            <% } %>

            <% if (you.referringDomains && you.referringDomains.length) { %>
            <h3 class="font-semibold text-sm mb-2">Your top referring domains</h3>
            <div class="overflow-x-auto rounded-xl border border-brand-border/50 dark:border-white/10 max-h-80 overflow-y-auto mb-6">
              <table class="min-w-full text-sm">
                <thead class="sticky top-0 bg-brand-cream/40 dark:bg-slate-950 text-left text-[10px] uppercase tracking-widest text-brand-muted">
                  <tr><th class="px-3 py-2">Domain</th><th class="px-3 py-2">Rank</th><th class="px-3 py-2">Backlinks</th><th class="px-3 py-2">Pages</th></tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
                  <% you.referringDomains.slice(0, 50).forEach(function (r) { %>
                  <tr>
                    <td class="px-3 py-2"><%= r.domain %></td>
                    <td class="px-3 py-2"><%= r.rank != null ? r.rank : '—' %></td>
                    <td class="px-3 py-2"><%= r.backlinks %></td>
                    <td class="px-3 py-2"><%= r.referringPages %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>

            <% if (you.anchors && you.anchors.length) { %>
            <h3 class="font-semibold text-sm mb-2">Anchor text</h3>
            <div class="overflow-x-auto rounded-xl border border-brand-border/50 dark:border-white/10 max-h-64 overflow-y-auto mb-6">
              <table class="min-w-full text-sm">
                <thead class="sticky top-0 bg-brand-cream/40 dark:bg-slate-950 text-left text-[10px] uppercase tracking-widest text-brand-muted">
                  <tr><th class="px-3 py-2">Anchor</th><th class="px-3 py-2">Backlinks</th><th class="px-3 py-2">Ref. domains</th></tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
                  <% you.anchors.slice(0, 40).forEach(function (a) { %>
                  <tr>
                    <td class="px-3 py-2 max-w-md truncate"><%= a.anchor %></td>
                    <td class="px-3 py-2"><%= a.backlinks %></td>
                    <td class="px-3 py-2"><%= a.referringDomains %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>

            <% if (you.timeseries && you.timeseries.length) { %>
            <h3 class="font-semibold text-sm mb-2">New / lost (monthly)</h3>
            <div class="overflow-x-auto rounded-xl border border-brand-border/50 dark:border-white/10 mb-6">
              <table class="min-w-full text-sm">
                <thead class="bg-brand-cream/40 dark:bg-slate-950 text-left text-[10px] uppercase tracking-widest text-brand-muted">
                  <tr>
                    <th class="px-3 py-2">Date</th>
                    <th class="px-3 py-2">New links</th>
                    <th class="px-3 py-2">Lost links</th>
                    <th class="px-3 py-2">New ref. domains</th>
                    <th class="px-3 py-2">Lost ref. domains</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
                  <% you.timeseries.forEach(function (t) { %>
                  <tr>
                    <td class="px-3 py-2"><%= t.date || '—' %></td>
                    <td class="px-3 py-2 text-emerald-700 dark:text-emerald-300"><%= t.newBacklinks %></td>
                    <td class="px-3 py-2 text-rose-600 dark:text-rose-300"><%= t.lostBacklinks %></td>
                    <td class="px-3 py-2 text-emerald-700 dark:text-emerald-300"><%= t.newReferringDomains %></td>
                    <td class="px-3 py-2 text-rose-600 dark:text-rose-300"><%= t.lostReferringDomains %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>

            <% if (project.linkGaps && project.linkGaps.length) { %>
            <h3 class="font-semibold text-sm mb-2">Competitor link gaps</h3>
            <p class="text-xs text-brand-muted mb-2">Referring domains that link to a competitor but not to you.</p>
            <div class="overflow-x-auto rounded-xl border border-brand-border/50 dark:border-white/10 max-h-96 overflow-y-auto">
              <table class="min-w-full text-sm">
                <thead class="sticky top-0 bg-brand-cream/40 dark:bg-slate-950 text-left text-[10px] uppercase tracking-widest text-brand-muted">
                  <tr>
                    <th class="px-3 py-2">Referring domain</th>
                    <th class="px-3 py-2">Seen on</th>
                    <th class="px-3 py-2">Max rank</th>
                    <th class="px-3 py-2">Score</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 dark:divide-white/10">
                  <% project.linkGaps.slice(0, 80).forEach(function (g) { %>
                  <tr>
                    <td class="px-3 py-2"><%= g.domain %></td>
                    <td class="px-3 py-2 text-brand-muted"><%= (g.competitors || []).join(', ') %></td>
                    <td class="px-3 py-2"><%= g.maxRank != null ? g.maxRank : '—' %></td>
                    <td class="px-3 py-2"><%= g.opportunityScore %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          </div>
        <% } %>
      </section>
    </div>
  </main>
  <script>
    (function () {
      var createForm = document.getElementById('blCreate');
      var createErr = document.getElementById('blCreateErr');
      if (createForm) {
        createForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          createErr.classList.add('hidden');
          var fd = new FormData(createForm);
          try {
            var res = await fetch('/backlinks/projects', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ seedDomain: fd.get('seedDomain'), autoDiscoverCompetitors: false }),
            });
            var data = await res.json();
            if (!res.ok || !data.success) throw new Error((data && data.error) || 'Create failed');
            window.location.href = data.url || ('/backlinks/' + encodeURIComponent(data.project.id));
          } catch (err) {
            createErr.textContent = err.message || 'Create failed';
            createErr.classList.remove('hidden');
          }
        });
      }

      document.querySelectorAll('[data-bl-delete]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var id = btn.getAttribute('data-bl-delete');
          if (!id || !confirm('Delete this backlinks project?')) return;
          var res = await fetch('/backlinks/' + encodeURIComponent(id), { method: 'DELETE' });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.success) window.location.href = '/backlinks';
          else alert((data && data.error) || 'Delete failed');
        });
      });

      var syncBtn = document.getElementById('blSyncBtn');
      var syncErr = document.getElementById('blSyncErr');
      var projectEl = document.getElementById('blProject');
      if (syncBtn && projectEl) {
        syncBtn.addEventListener('click', async function () {
          syncErr.classList.add('hidden');
          syncBtn.disabled = true;
          syncBtn.textContent = 'Syncing…';
          if (typeof window.showNavLoading === 'function') window.showNavLoading({ failSafeMs: 120000 });
          try {
            var res = await fetch('/backlinks/' + encodeURIComponent(projectEl.dataset.id) + '/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ rediscoverCompetitors: false }),
            });
            var data = await res.json();
            if (!res.ok || !data.success) throw new Error((data && data.error) || 'Sync failed');
            window.location.reload();
          } catch (err) {
            if (typeof window.hideNavLoading === 'function') window.hideNavLoading();
            syncErr.textContent = err.message || 'Sync failed';
            syncErr.classList.remove('hidden');
            syncBtn.disabled = false;
            syncBtn.textContent = 'Update from DataForSEO';
          }
        });
      }

      if (!projectEl) return;
      var projectId = projectEl.dataset.id;
      var selected = {};
      <% (Array.isArray(project && project.competitors) ? project.competitors : []).forEach(function (c) { %>
      selected[<%= JSON.stringify(c.domain) %>] = { domain: <%= JSON.stringify(c.domain) %>, title: <%= JSON.stringify(c.title || null) %>, source: <%= JSON.stringify(c.source || 'manual') %> };
      <% }) %>

      var statusEl = document.getElementById('blCompStatus');
      var resultsEl = document.getElementById('blCompResults');
      var chipsEl = document.getElementById('blSelectedComps');

      function setStatus(msg, isErr) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.classList.toggle('text-rose-600', !!isErr);
        statusEl.classList.toggle('dark:text-rose-300', !!isErr);
      }

      function renderChips() {
        if (!chipsEl) return;
        var keys = Object.keys(selected);
        if (!keys.length) {
          chipsEl.innerHTML = '<p class="text-xs text-amber-800 dark:text-amber-200" id="blSelectedEmpty">No competitors selected yet.</p>';
          return;
        }
        chipsEl.innerHTML = keys.map(function (d) {
          var c = selected[d];
          var label = (c.title ? c.title + ' · ' : '') + c.domain;
          return '<span class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-1 text-xs font-semibold" data-comp-chip="' +
            c.domain.replace(/"/g, '&quot;') + '">' + label.replace(/</g, '&lt;') +
            '<button type="button" class="text-brand-muted hover:text-rose-500" data-comp-remove="' +
            c.domain.replace(/"/g, '&quot;') + '" aria-label="Remove">×</button></span>';
        }).join('');
      }

      function toggleSelect(row, on) {
        if (!row || !row.domain) return;
        if (on) {
          if (Object.keys(selected).length >= 5 && !selected[row.domain]) {
            setStatus('Pick up to 5 competitors.', true);
            return false;
          }
          selected[row.domain] = { domain: row.domain, title: row.title || null, source: row.source || 'google_maps' };
        } else {
          delete selected[row.domain];
        }
        renderChips();
        return true;
      }

      chipsEl && chipsEl.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-comp-remove]');
        if (!btn) return;
        delete selected[btn.getAttribute('data-comp-remove')];
        renderChips();
        var cb = resultsEl && resultsEl.querySelector('input[data-domain="' + btn.getAttribute('data-comp-remove') + '"]');
        if (cb) cb.checked = false;
      });

      var searchBtn = document.getElementById('blCompSearchBtn');
      if (searchBtn) {
        searchBtn.addEventListener('click', async function () {
          setStatus('Searching Google Maps…');
          searchBtn.disabled = true;
          if (typeof window.showNavLoading === 'function') window.showNavLoading({ failSafeMs: 90000 });
          try {
            var res = await fetch('/backlinks/' + encodeURIComponent(projectId) + '/local-competitors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({
                keyword: (document.getElementById('blCompKeyword') || {}).value || '',
                city: (document.getElementById('blCompCity') || {}).value || '',
                state: (document.getElementById('blCompState') || {}).value || '',
              }),
            });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok || !data.success) throw new Error((data && data.error) || 'Search failed');
            var rows = Array.isArray(data.results) ? data.results : [];
            if (!resultsEl) return;
            if (!rows.length) {
              resultsEl.classList.remove('hidden');
              resultsEl.innerHTML = '<p class="text-xs text-brand-muted">No local businesses with websites found. Try a more specific search (trade + city).</p>';
              setStatus('No results — try another local search.');
              return;
            }
            resultsEl.classList.remove('hidden');
            resultsEl.innerHTML = rows.map(function (r) {
              var checked = selected[r.domain] ? ' checked' : '';
              var meta = [r.rating != null ? (r.rating + '★') : '', r.category || ''].filter(Boolean).join(' · ');
              return '<label class="flex items-start gap-3 rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 cursor-pointer hover:border-brand-yellow/40">' +
                '<input type="checkbox" class="mt-1" data-domain="' + r.domain.replace(/"/g, '&quot;') + '"' + checked + ' />' +
                '<span class="min-w-0"><span class="block text-sm font-semibold text-brand-dark dark:text-white">' +
                String(r.title || r.domain).replace(/</g, '&lt;') + '</span>' +
                '<span class="block text-xs text-brand-muted">' + r.domain.replace(/</g, '&lt;') +
                (meta ? ' · ' + meta.replace(/</g, '&lt;') : '') + '</span></span></label>';
            }).join('');
            resultsEl.querySelectorAll('input[data-domain]').forEach(function (input) {
              input.addEventListener('change', function () {
                var domain = input.getAttribute('data-domain');
                var row = rows.find(function (x) { return x.domain === domain; }) || { domain: domain };
                if (!toggleSelect(row, input.checked)) input.checked = false;
              });
            });
            setStatus(rows.length + ' local businesses — check the ones to compare (max 5).');
          } catch (err) {
            setStatus(err.message || 'Search failed', true);
          } finally {
            if (typeof window.hideNavLoading === 'function') window.hideNavLoading();
            searchBtn.disabled = false;
          }
        });
      }

      var saveBtn = document.getElementById('blCompSaveBtn');
      if (saveBtn) {
        saveBtn.addEventListener('click', async function () {
          setStatus('Saving competitors…');
          saveBtn.disabled = true;
          try {
            var res = await fetch('/backlinks/' + encodeURIComponent(projectId) + '/competitors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ competitors: Object.keys(selected).map(function (k) { return selected[k]; }) }),
            });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok || !data.success) throw new Error((data && data.error) || 'Save failed');
            setStatus('Saved. Click Update from DataForSEO to refresh comparison.');
          } catch (err) {
            setStatus(err.message || 'Save failed', true);
          } finally {
            saveBtn.disabled = false;
          }
        });
      }

      var addManual = document.getElementById('blCompAddManual');
      var manualInput = document.getElementById('blCompManual');
      if (addManual && manualInput) {
        addManual.addEventListener('click', function () {
          var raw = String(manualInput.value || '').trim().toLowerCase()
            .replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];
          if (!raw || raw.indexOf('.') < 0) {
            setStatus('Enter a domain like rivalflooring.com', true);
            return;
          }
          if (!toggleSelect({ domain: raw, title: null, source: 'manual' }, true)) return;
          manualInput.value = '';
          setStatus('Added ' + raw + ' — Save selection, then update.');
        });
      }
    })();
  </script>
</body>
</html>
