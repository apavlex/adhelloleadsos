<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Library</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Resources</h1>
      </div>
    </div>

    <% if (typeof saveError !== 'undefined' && saveError) { %>
    <div class="mb-6 rounded-2xl border border-red-300/60 bg-red-50/90 dark:bg-red-950/40 dark:border-red-500/30 px-4 py-3 text-sm text-red-900 dark:text-red-100">
      Could not save that URL. Use a valid <code class="text-xs">http://</code> or <code class="text-xs">https://</code> link (we’ll add https if you omit it).
    </div>
    <% } %>
    <% if (typeof uploadError !== 'undefined' && uploadError) { %>
    <div class="mb-6 rounded-2xl border border-red-300/60 bg-red-50/90 dark:bg-red-950/40 dark:border-red-500/30 px-4 py-3 text-sm text-red-900 dark:text-red-100">
      Could not upload that file. Try a smaller file (up to 8MB).
    </div>
    <% } %>

    <div class="brand-card p-6 md:p-8 dark:bg-slate-900 dark:border-white/10 mb-8">
      <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Add knowledge</h2>
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <form action="/resources/add" method="post" class="space-y-4" id="resourceAddForm">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Option A · Add a link</p>
        <input type="hidden" name="kind" id="resKindSubmit" value="auto" />
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
          <div class="lg:col-span-7">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resUrl">URL</label>
            <input id="resUrl" name="url" type="text" required maxlength="2048" placeholder="youtube.com/watch…, docs.google.com/…, x.com/…" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50" />
          </div>
          <div class="lg:col-span-5">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resTitle">Title (optional)</label>
            <input id="resTitle" name="title" type="text" maxlength="200" placeholder="Defaults to URL" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <button type="button" id="resAdvancedToggle" class="text-xs font-bold text-brand-yellow hover:underline bg-transparent border-0 p-0 cursor-pointer" aria-expanded="false" aria-controls="resKindAdvancedPanel">Advanced: specify link type</button>
          <span class="text-[11px] text-brand-muted">We auto-detect YouTube, Drive, and X from the URL.</span>
        </div>
        <div id="resKindAdvancedPanel" class="hidden rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-white/5 px-4 py-3">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resKindSelect">Type</label>
          <select id="resKindSelect" disabled class="w-full max-w-md rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-xs font-bold text-brand-dark dark:text-white disabled:opacity-60">
            <% kindOptions.forEach((opt) => { %>
            <option value="<%= opt.id %>"><%= opt.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resNote">Note (optional)</label>
          <textarea id="resNote" name="note" rows="2" maxlength="2000" placeholder="Why this matters, timestamp, cohort…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm text-brand-dark dark:text-white resize-y"></textarea>
        </div>
        <button type="submit" class="btn-pill btn-primary px-8 py-3 text-[10px] font-black uppercase tracking-widest">Save resource</button>
      </form>
      <form action="/resources/upload" method="post" enctype="multipart/form-data" class="space-y-4" id="resourceUploadForm">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Option B · Upload a file</p>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resourceFile">File</label>
          <input id="resourceFile" name="resourceFile" type="file" required class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white file:mr-3 file:rounded-lg file:border-0 file:bg-brand-yellow file:px-3 file:py-1.5 file:text-xs file:font-black file:uppercase file:tracking-widest file:text-brand-dark" />
          <p class="mt-1 text-[11px] text-brand-muted">Supports text/PDF/docs and other files up to 8MB.</p>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resUploadTitle">Title (optional)</label>
          <input id="resUploadTitle" name="title" type="text" maxlength="200" placeholder="Defaults to filename" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resUploadNote">Note (optional)</label>
          <textarea id="resUploadNote" name="note" rows="2" maxlength="2000" placeholder="Why this file matters…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm text-brand-dark dark:text-white resize-y"></textarea>
        </div>
        <button type="submit" class="btn-pill border border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-8 py-3 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50">Upload file</button>
      </form>
      </div>
    </div>

    <% const _kc = typeof resourceKindCounts !== 'undefined' && resourceKindCounts ? resourceKindCounts : { all: 0, youtube: 0, drive: 0, x: 0, link: 0 }; %>
    <div class="flex flex-wrap items-center gap-2 mb-6" role="tablist" aria-label="Filter by kind">
      <% const pills = [
        { id: 'all', label: 'All' },
        { id: 'youtube', label: 'YouTube' },
        { id: 'drive', label: 'Drive / Docs' },
        { id: 'x', label: 'X' },
        { id: 'link', label: 'Links' },
      ]; %>
      <% pills.forEach((p) => { %>
      <% const cnt = _kc[p.id] != null ? _kc[p.id] : 0; %>
      <% const emptyTab = p.id !== 'all' && cnt === 0; %>
      <% const active = kindFilter === p.id; %>
      <% const basePill = 'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors'; %>
      <% if (emptyTab) { %>
      <span class="<%= basePill %> <%= active ? 'bg-brand-yellow/90 text-brand-dark border-brand-yellow shadow-sm ring-2 ring-brand-yellow/30 cursor-default' : 'border-brand-border/40 dark:border-white/10 text-brand-muted/50 dark:text-slate-600 bg-white/40 dark:bg-slate-900/40 cursor-not-allowed' %> select-none" title="<%= active ? 'Filtered to this category — nothing saved yet' : 'Nothing saved in this category yet' %>" <%= active ? 'aria-current="page"' : '' %> aria-disabled="true"><%= p.label %> <span class="tabular-nums opacity-80" aria-hidden="true">· 0</span></span>
      <% } else { %>
      <a href="/resources<%= p.id === 'all' ? '' : ('?kind=' + encodeURIComponent(p.id)) %>"
         class="<%= basePill %> <%= active ? 'bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm' : 'border-brand-border dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white bg-white/60 dark:bg-slate-900/60' %>"
         <%= active ? 'aria-current="page"' : '' %>><%= p.label %> <span class="tabular-nums opacity-90" aria-hidden="true">· <%= cnt %></span></a>
      <% } %>
      <% }); %>
    </div>

    <% const kindLabels = { youtube: 'YouTube', drive: 'Drive / Docs', x: 'X / Twitter', link: 'Link' }; %>
    <% function extractYoutubeId(urlStr) {
      try {
        var u = new URL(urlStr);
        var h = u.hostname.replace(/^www\./, '').toLowerCase();
        if (h === 'youtu.be') return u.pathname.slice(1).split('/')[0];
        if (h.endsWith('youtube.com')) {
          var p = u.searchParams;
          if (p.get('v')) return p.get('v');
          var m = u.pathname.match(/^\/(?:embed|v|shorts)\/([^/?]+)/);
          if (m) return m[1];
        }
      } catch (_) {}
      return '';
    } %>
    <% function formatResourceBytes(b) {
      var n = Number(b);
      if (!Number.isFinite(n) || n < 0) return '';
      var units = ['B', 'KB', 'MB', 'GB'];
      var i = 0;
      while (n >= 1024 && i < units.length - 1) { n /= 1024; i++; }
      var rounded = i === 0 ? Math.round(n) : Math.round(n * 10) / 10;
      return rounded + ' ' + units[i];
    } %>

    <% if (!resources.length) { %>
    <%- include('partials/empty_state', {
      emptyHeadline: 'Library · 0',
      emptyBody: 'Paste any URL above — we spot YouTube, Drive, and X automatically.',
      emptyCtaHref: '/leads/find',
      emptyCtaLabel: 'Find leads',
      emptySecondaryHref: '/today?demo=1',
      emptySecondaryLabel: 'See Today with demo data',
    }) %>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <% resources.forEach((r) => { %>
      <% const isUpload = String(r.sourceType || '') === 'upload' || !!r.storagePath; %>
      <% const sizeLabel = isUpload && r.sizeBytes != null ? formatResourceBytes(r.sizeBytes) : ''; %>
      <article class="brand-card p-5 dark:bg-slate-900 dark:border-white/10 flex flex-col gap-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 min-w-0">
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 text-brand-dark dark:text-slate-200 border border-brand-border/40 dark:border-white/10 shrink-0">
              <%= kindLabels[r.kind] || 'Link' %>
            </span>
            <% if (isUpload) { %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-emerald-50/90 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-100/95 border border-emerald-200/55 dark:border-emerald-800/45 shrink-0">
              Upload
            </span>
            <% } else { %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-slate-100/95 dark:bg-slate-800/55 text-slate-700 dark:text-slate-200 border border-slate-200/75 dark:border-slate-600/40 shrink-0">
              Link
            </span>
            <% } %>
          </div>
        </div>
        <% var ytId = r.kind === 'youtube' ? extractYoutubeId(r.url) : ''; %>
        <% if (ytId) { %>
        <div class="relative w-full rounded-xl overflow-hidden bg-black aspect-video">
          <iframe
            src="https://www.youtube.com/embed/<%= ytId %>"
            class="absolute inset-0 w-full h-full border-0"
            title="YouTube video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <% } %>
        <div class="min-w-0" data-res-card-content="<%= r.id %>">
          <div class="res-preview" data-res-preview="<%= r.id %>">
          <h3 class="font-display font-bold text-base text-brand-dark dark:text-white leading-snug break-words"><%= r.title %></h3>
          <% if (isUpload && r.fileName) { %>
          <p class="text-[10px] text-brand-muted dark:text-slate-500 mt-1 break-all"><%= r.fileName %></p>
          <% } %>
          <div class="res-url-reveal w-full min-w-0" data-res-url-hover>
            <button type="button" class="res-url-trigger inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-cream/55 dark:bg-slate-800/90 text-brand-dark dark:text-slate-100 border border-brand-border/55 dark:border-white/12 hover:border-brand-yellow/45 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow/50 shrink-0"
              aria-expanded="false"
              aria-controls="res-url-tip-<%= r.id %>"
              aria-label="Address — hold pointer or focus here to show full link">
              <svg class="w-3 h-3 opacity-70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>
              URL
            </button>
            <div id="res-url-tip-<%= r.id %>" class="res-url-tip" role="tooltip">
              <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand-dark dark:text-white hover:text-brand-yellow break-all"><%= r.url %></a>
            </div>
          </div>
          <% if (sizeLabel) { %>
          <p class="text-[10px] font-bold text-brand-muted dark:text-slate-500 mt-1">Size · <%= sizeLabel %></p>
          <% } %>
          </div>
          <div class="res-edit hidden" data-res-edit="<%= r.id %>">
            <label class="block text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Title</label>
            <input type="text" class="js-res-edit-title w-full rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white mb-3" value="<%= r.title %>" data-res-id="<%= r.id %>" />
            <label class="block text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Note</label>
            <textarea class="js-res-edit-note w-full rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-brand-dark dark:text-white resize-y mb-3" rows="3" data-res-id="<%= r.id %>"><%= r.note || '' %></textarea>
            <div class="flex gap-2">
              <button type="button" class="js-res-save-btn text-[10px] font-black uppercase tracking-widest bg-brand-yellow text-slate-900 px-4 py-1.5 rounded-lg hover:brightness-105" data-res-id="<%= r.id %>">Save</button>
              <button type="button" class="js-res-cancel-btn text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white px-3 py-1.5" data-res-id="<%= r.id %>">Cancel</button>
            </div>
          </div>
        </div>
        <% if (r.note) { %>
        <p class="text-sm text-brand-muted dark:text-slate-400 leading-relaxed whitespace-pre-wrap res-note-preview" data-res-note-preview="<%= r.id %>"><%= r.note %></p>
        <% } else { %>
        <p class="text-sm text-brand-muted dark:text-slate-400 leading-relaxed whitespace-pre-wrap res-note-preview hidden" data-res-note-preview="<%= r.id %>"></p>
        <% } %>
        <div class="mt-auto pt-2 flex flex-wrap items-center gap-3">
          <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="btn-pill bg-brand-dark text-white dark:bg-white dark:text-slate-900 text-[10px] font-black uppercase tracking-widest px-4 py-2.5"><%= ytId ? 'Watch on YouTube' : 'Open' %></a>
          <button type="button" class="js-res-edit-btn text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow" data-res-id="<%= r.id %>" title="Edit resource">Edit</button>
          <form action="/resources/remove" method="post" class="inline-flex" onsubmit="return confirm('Remove this resource?');">
            <input type="hidden" name="id" value="<%= r.id %>" />
            <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-400 hover:underline">Remove</button>
          </form>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script>
  (function () {
    var btn = document.getElementById('resAdvancedToggle');
    var panel = document.getElementById('resKindAdvancedPanel');
    var hidden = document.getElementById('resKindSubmit');
    var sel = document.getElementById('resKindSelect');
    if (!btn || !panel || !hidden || !sel) return;
    var open = false;
    function setOpen(v) {
      open = v;
      panel.classList.toggle('hidden', !open);
      sel.disabled = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? 'Hide type options' : 'Advanced: specify link type';
      if (!open) {
        hidden.value = 'auto';
        sel.value = 'auto';
      } else {
        hidden.value = sel.value || 'auto';
      }
    }
    btn.addEventListener('click', function () {
      setOpen(!open);
    });
    sel.addEventListener('change', function () {
      hidden.value = sel.value || 'auto';
    });
  })();
  (function () {
    var DWELL_MS = 3000;
    document.querySelectorAll('[data-res-url-hover]').forEach(function (wrap) {
      var btn = wrap.querySelector('.res-url-trigger');
      var tip = wrap.querySelector('.res-url-tip');
      if (!btn || !tip) return;
      var t = null;
      function openNow() {
        wrap.classList.add('res-url-open');
        btn.setAttribute('aria-expanded', 'true');
      }
      function closeNow() {
        if (t) { clearTimeout(t); t = null; }
        wrap.classList.remove('res-url-open');
        btn.setAttribute('aria-expanded', 'false');
      }
      function arm() {
        if (t) clearTimeout(t);
        t = setTimeout(openNow, DWELL_MS);
      }
      function disarm() {
        if (t) { clearTimeout(t); t = null; }
        closeNow();
      }
      wrap.addEventListener('mouseenter', arm);
      wrap.addEventListener('mouseleave', disarm);
      wrap.addEventListener('focusin', arm);
      wrap.addEventListener('focusout', function (ev) {
        if (!wrap.contains(ev.relatedTarget)) disarm();
      });
    });
  })();
  // ── Inline resource editing ──────────────────────────────────────────────
  (function () {
    document.querySelectorAll('.js-res-edit-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-res-id');
        var preview = document.querySelector('[data-res-preview=\"' + id + '\"]');
        var edit = document.querySelector('[data-res-edit=\"' + id + '\"]');
        var notePreview = document.querySelector('[data-res-note-preview=\"' + id + '\"]');
        if (preview) preview.classList.add('hidden');
        if (edit) edit.classList.remove('hidden');
        if (notePreview) notePreview.classList.add('hidden');
      });
    });
    document.querySelectorAll('.js-res-cancel-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-res-id');
        var preview = document.querySelector('[data-res-preview=\"' + id + '\"]');
        var edit = document.querySelector('[data-res-edit=\"' + id + '\"]');
        var notePreview = document.querySelector('[data-res-note-preview=\"' + id + '\"]');
        if (preview) preview.classList.remove('hidden');
        if (edit) edit.classList.add('hidden');
        if (notePreview) notePreview.classList.remove('hidden');
      });
    });
    document.querySelectorAll('.js-res-save-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-res-id');
        var titleEl = document.querySelector('.js-res-edit-title[data-res-id=\"' + id + '\"]');
        var noteEl = document.querySelector('.js-res-edit-note[data-res-id=\"' + id + '\"]');
        var title = titleEl ? titleEl.value.trim() : '';
        var note = noteEl ? noteEl.value.trim() : '';
        var preview = document.querySelector('[data-res-preview=\"' + id + '\"]');
        var edit = document.querySelector('[data-res-edit=\"' + id + '\"]');
        var notePreview = document.querySelector('[data-res-note-preview=\"' + id + '\"]');
        var titleH3 = preview ? preview.querySelector('h3') : null;
        btn.disabled = true;
        btn.textContent = 'Saving…';
        fetch('/resources/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: id, title: title, note: note }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data.success) throw new Error(data.error || 'Update failed');
            if (titleH3) titleH3.textContent = title || id;
            if (notePreview) {
              notePreview.textContent = note;
              notePreview.classList.toggle('hidden', !note);
            }
            if (preview) preview.classList.remove('hidden');
            if (edit) edit.classList.add('hidden');
          })
          .catch(function (err) {
            alert(err.message || 'Could not save.');
          })
          .finally(function () {
            btn.disabled = false;
            btn.textContent = 'Save';
          });
      });
    });
  })();
  </script>
</body>
</html>
