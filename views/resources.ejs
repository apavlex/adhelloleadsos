<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Library</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Resources</h1>
      </div>
    </div>

    <% if (typeof saveError !== 'undefined' && saveError) { %>
    <div class="mb-6 rounded-2xl border border-red-300/60 bg-red-50/90 dark:bg-red-950/40 dark:border-red-500/30 px-4 py-3 text-sm text-red-900 dark:text-red-100">
      Could not save that URL. Use a valid <code class="text-xs">http://</code> or <code class="text-xs">https://</code> link (we’ll add https if you omit it).
    </div>
    <% } %>

    <div class="brand-card p-6 md:p-8 dark:bg-slate-900 dark:border-white/10 mb-8">
      <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Add a link</h2>
      <form action="/resources/add" method="post" class="space-y-4" id="resourceAddForm">
        <input type="hidden" name="kind" id="resKindSubmit" value="auto" />
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
          <div class="lg:col-span-7">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resUrl">URL</label>
            <input id="resUrl" name="url" type="text" required maxlength="2048" placeholder="youtube.com/watch…, docs.google.com/…, x.com/…" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50" />
          </div>
          <div class="lg:col-span-5">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resTitle">Title (optional)</label>
            <input id="resTitle" name="title" type="text" maxlength="200" placeholder="Defaults to URL" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <button type="button" id="resAdvancedToggle" class="text-xs font-bold text-brand-yellow hover:underline bg-transparent border-0 p-0 cursor-pointer" aria-expanded="false" aria-controls="resKindAdvancedPanel">Advanced: specify link type</button>
          <span class="text-[11px] text-brand-muted">We auto-detect YouTube, Drive, and X from the URL.</span>
        </div>
        <div id="resKindAdvancedPanel" class="hidden rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-white/5 px-4 py-3">
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resKindSelect">Type</label>
          <select id="resKindSelect" disabled class="w-full max-w-md rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-xs font-bold text-brand-dark dark:text-white disabled:opacity-60">
            <% kindOptions.forEach((opt) => { %>
            <option value="<%= opt.id %>"><%= opt.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="resNote">Note (optional)</label>
          <textarea id="resNote" name="note" rows="2" maxlength="2000" placeholder="Why this matters, timestamp, cohort…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm text-brand-dark dark:text-white resize-y"></textarea>
        </div>
        <button type="submit" class="btn-pill btn-primary px-8 py-3 text-[10px] font-black uppercase tracking-widest">Save resource</button>
      </form>
    </div>

    <% const _kc = typeof resourceKindCounts !== 'undefined' && resourceKindCounts ? resourceKindCounts : { all: 0, youtube: 0, drive: 0, x: 0, link: 0 }; %>
    <div class="flex flex-wrap items-center gap-2 mb-6" role="tablist" aria-label="Filter by kind">
      <% const pills = [
        { id: 'all', label: 'All' },
        { id: 'youtube', label: 'YouTube' },
        { id: 'drive', label: 'Drive / Docs' },
        { id: 'x', label: 'X' },
        { id: 'link', label: 'Links' },
      ]; %>
      <% pills.forEach((p) => { %>
      <% const cnt = _kc[p.id] != null ? _kc[p.id] : 0; %>
      <% const emptyTab = p.id !== 'all' && cnt === 0; %>
      <% const active = kindFilter === p.id; %>
      <% const basePill = 'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors'; %>
      <% if (emptyTab) { %>
      <span class="<%= basePill %> <%= active ? 'bg-brand-yellow/90 text-brand-dark border-brand-yellow shadow-sm ring-2 ring-brand-yellow/30 cursor-default' : 'border-brand-border/40 dark:border-white/10 text-brand-muted/50 dark:text-slate-600 bg-white/40 dark:bg-slate-900/40 cursor-not-allowed' %> select-none" title="<%= active ? 'Filtered to this category — nothing saved yet' : 'Nothing saved in this category yet' %>" <%= active ? 'aria-current="page"' : '' %> aria-disabled="true"><%= p.label %> <span class="tabular-nums opacity-80" aria-hidden="true">· 0</span></span>
      <% } else { %>
      <a href="/resources<%= p.id === 'all' ? '' : ('?kind=' + encodeURIComponent(p.id)) %>"
         class="<%= basePill %> <%= active ? 'bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm' : 'border-brand-border dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white bg-white/60 dark:bg-slate-900/60' %>"
         <%= active ? 'aria-current="page"' : '' %>><%= p.label %> <span class="tabular-nums opacity-90" aria-hidden="true">· <%= cnt %></span></a>
      <% } %>
      <% }); %>
    </div>

    <% const kindLabels = { youtube: 'YouTube', drive: 'Drive / Docs', x: 'X / Twitter', link: 'Link' }; %>

    <% if (!resources.length) { %>
    <%- include('partials/empty_state', {
      emptyHeadline: 'Library · 0',
      emptyBody: 'Paste any URL above — we spot YouTube, Drive, and X automatically.',
      emptyCtaHref: '/leads/find',
      emptyCtaLabel: 'Find leads',
      emptySecondaryHref: '/today?demo=1',
      emptySecondaryLabel: 'See Today with demo data',
    }) %>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <% resources.forEach((r) => { %>
      <article class="brand-card p-5 dark:bg-slate-900 dark:border-white/10 flex flex-col gap-3">
        <div class="flex items-start justify-between gap-3">
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 text-brand-dark dark:text-slate-200 border border-brand-border/40 dark:border-white/10 shrink-0">
            <%= kindLabels[r.kind] || 'Link' %>
          </span>
          <form action="/resources/remove" method="post" class="shrink-0" onsubmit="return confirm('Remove this resource?');">
            <input type="hidden" name="id" value="<%= r.id %>" />
            <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-400 hover:underline">Remove</button>
          </form>
        </div>
        <div class="min-w-0">
          <h3 class="font-display font-bold text-base text-brand-dark dark:text-white leading-snug break-words"><%= r.title %></h3>
          <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-brand-muted hover:text-brand-yellow break-all mt-1 inline-block"><%= r.url %></a>
        </div>
        <% if (r.note) { %>
        <p class="text-sm text-brand-muted dark:text-slate-400 leading-relaxed whitespace-pre-wrap"><%= r.note %></p>
        <% } %>
        <div class="mt-auto pt-2 flex flex-wrap gap-3">
          <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="btn-pill bg-brand-dark text-white dark:bg-white dark:text-slate-900 text-[10px] font-black uppercase tracking-widest px-4 py-2.5">Open</a>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script>
  (function () {
    var btn = document.getElementById('resAdvancedToggle');
    var panel = document.getElementById('resKindAdvancedPanel');
    var hidden = document.getElementById('resKindSubmit');
    var sel = document.getElementById('resKindSelect');
    if (!btn || !panel || !hidden || !sel) return;
    var open = false;
    function setOpen(v) {
      open = v;
      panel.classList.toggle('hidden', !open);
      sel.disabled = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? 'Hide type options' : 'Advanced: specify link type';
      if (!open) {
        hidden.value = 'auto';
        sel.value = 'auto';
      } else {
        hidden.value = sel.value || 'auto';
      }
    }
    btn.addEventListener('click', function () {
      setOpen(!open);
    });
    sel.addEventListener('change', function () {
      hidden.value = sel.value || 'auto';
    });
  })();
  </script>
</body>
</html>
