<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Referrals' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Referrals' }) %>
    <h1 class="ma-page-title">Referrals</h1>
    <p class="ma-page-sub">Accept new referrals, then mark them booked, won or lost.</p>

    <nav class="ma-seg" aria-label="Referral lists">
      <a href="<%= base %>/referrals" class="<%= view === 'received' ? 'is-on' : '' %>">Received (<%= received.length %>)</a>
      <a href="<%= base %>/referrals?view=sent" class="<%= view === 'sent' ? 'is-on' : '' %>">Sent (<%= sent.length %>)</a>
    </nav>

    <%- include('_flash') %>

    <% if (view === 'received') { %>
      <% if (!received.length) { %>
      <div class="ma-card ma-empty"><%- icons.referrals %><p>No referrals yet. You'll get a text when one comes in.</p></div>
      <% } %>
      <% received.forEach(function (r) { const c = r.customer || {}; %>
      <article class="ma-card" id="ref-<%= r.id %>">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= c.name || 'Customer' %></p>
            <p class="ma-card__meta"><%= r.trade %> · from <%= r.from %> · <%= r.when %></p>
          </div>
          <span class="ma-pill ma-pill--<%= r.status %>"><%= r.statusLabel %><%= r.value ? ' · ' + r.value : '' %></span>
        </div>
        <% if (r.status !== 'declined') { %>
        <p class="ma-card__meta" style="margin-top:8px">
          <% if (c.phone) { %><a href="tel:<%= String(c.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= c.phone %></a><%= (c.email || c.address || c.city || c.zip) ? ' · ' : '' %><% } %>
          <%= [c.email, c.address, [c.city, c.zip].filter(Boolean).join(' ')].filter(Boolean).join(' · ') %>
        </p>
        <% } %>
        <% if (c.note) { %><p class="ma-card__note"><%= c.note %></p><% } %>
        <% r.notes.forEach(function (n) { %><p class="ma-card__meta" style="margin-top:6px">Note: <%= n.text %></p><% }); %>

        <div class="ma-actions">
          <% if (r.jobHref) { %>
          <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= r.jobHref %>"><%- icons.customers %> View job</a>
          <% } else if (r.convertible) { %>
          <form method="post" action="<%= base %>/customers/from-referral/<%= r.id %>">
            <input type="hidden" name="back" value="<%= base %>/referrals">
            <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft"><%- icons.customers %> Add to Customers</button>
          </form>
          <% } %>
          <% r.actions.forEach(function (a) { if (a === 'win') return; %>
          <form method="post" action="<%= base %>/referrals/<%= r.id %>">
            <input type="hidden" name="action" value="<%= a %>">
            <button type="submit" class="ma-btn ma-btn--sm <%= a === 'accept' ? '' : (a === 'decline' || a === 'lose' ? 'ma-btn--danger' : 'ma-btn--soft') %>" <%- a === 'decline' ? 'onclick="return confirm(\'Decline this referral?\')"' : '' %>><%= { accept: 'Accept', decline: 'Decline', book: 'Booked', lose: 'Lost' }[a] %></button>
          </form>
          <% }); %>
        </div>
        <% if (r.actions.indexOf('win') >= 0) { %>
        <form method="post" action="<%= base %>/referrals/<%= r.id %>" class="ma-inline" style="margin-top:8px">
          <input type="hidden" name="action" value="win">
          <input class="ma-input" name="value" inputmode="decimal" placeholder="Job value $" required aria-label="Job value">
          <button type="submit" class="ma-btn ma-btn--sm">Won</button>
        </form>
        <% } %>
        <details style="margin-top:8px">
          <summary class="ma-card__meta" style="cursor:pointer;font-weight:700">Add a note</summary>
          <form method="post" action="<%= base %>/referrals/<%= r.id %>" class="ma-inline" style="margin-top:8px">
            <input type="hidden" name="action" value="note">
            <input class="ma-input" name="text" maxlength="500" placeholder="e.g. Left a voicemail" required aria-label="Note">
            <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft">Save</button>
          </form>
        </details>
      </article>
      <% }); %>
    <% } else { %>
      <% if (!sent.length) { %>
      <div class="ma-card ma-empty"><%- icons.send %><p>You haven't sent a referral yet.</p><a class="ma-btn ma-btn--sm" href="<%= base %>/send" style="margin-top:8px">Send one</a></div>
      <% } %>
      <% sent.forEach(function (r) { const c = r.customer || {}; %>
      <article class="ma-card">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= c.name || 'Customer' %></p>
            <p class="ma-card__meta"><%= r.trade %> · to <%= r.to %> · <%= r.when %></p>
          </div>
          <span class="ma-pill ma-pill--<%= r.status === 'unrouted' ? 'pending' : r.status %>"><%= r.statusLabel %><%= r.value ? ' · ' + r.value : '' %></span>
        </div>
      </article>
      <% }); %>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
