<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Leads & Referrals' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Leads & Referrals' }) %>
    <h1 class="ma-page-title">Leads &amp; Referrals</h1>
    <%
      const _locked = typeof referralsLocked !== 'undefined' && referralsLocked;
      const _formLeads = typeof formLeads !== 'undefined' && Array.isArray(formLeads) ? formLeads : [];
      const _contactLeads = typeof contactLeads !== 'undefined' && Array.isArray(contactLeads) ? contactLeads : [];
      const _contactQuotesTop = typeof contactQuotes !== 'undefined' && Array.isArray(contactQuotes) ? contactQuotes : [];
      const _hasAppt = typeof appointment !== 'undefined' && appointment;
      const _inboxCount = received.length
        + _formLeads.filter(function (l) { return l.status !== 'closed'; }).length
        + _contactLeads.length
        + _contactQuotesTop.length;
    %>
    <% if (_locked) { %>
    <p class="ma-page-sub">See new project names as they come in — upgrade to unlock contact details and claim jobs. Contacts you mark as leads<% if (typeof isFlooringPartner !== 'undefined' && isFlooringPartner) { %> or quote requests<% } %> still show below.</p>
    <%- include('_flash') %>
    <%- include('_upgrade_gate', {
      upgradeTitle: 'Unlock lead details',
      upgradeBody: 'Free and trial accounts only see the project name. Join on a paid plan to get phones, notes, and claim buttons.',
      upgradeHref: typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup',
      upgradeIcon: 'referrals',
    }) %>
    <% } else { %>
    <p class="ma-page-sub">Website forms, contacts you mark as leads, and network referrals you receive, claim, or send.</p>
    <% } %>

    <nav class="ma-seg ma-seg--3" aria-label="Lead and referral lists">
      <a href="<%= base %>/referrals?view=pool" class="<%= view === 'pool' ? 'is-on' : '' %>">Pool (<%= pool.length %>)</a>
      <a href="<%= base %>/referrals" class="<%= view === 'received' ? 'is-on' : '' %>">Received (<%= _inboxCount %>)</a>
      <a href="<%= base %>/referrals?view=sent" class="<%= view === 'sent' ? 'is-on' : '' %>">Sent (<%= sent.length %>)</a>
    </nav>

    <% if (!_locked) { %><%- include('_flash') %><% } %>

    <%- include('_lead_request_callout', { leadRequest: typeof leadRequest !== 'undefined' ? leadRequest : null, back: 'referrals', base: base, icons: icons }) %>

    <% if (view === 'pool') { %>
      <% if (!pool.length) { %>
      <div class="ma-card ma-empty"><%- icons.referrals %><p>No open referrals in the pool for your trades right now. When one comes in unmatched, you’ll get a text and can claim it here.</p></div>
      <% } %>
      <% pool.forEach(function (r) { const c = r.customer || {}; %>
      <article class="ma-card" id="ref-<%= r.id %>">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= c.name || 'Customer' %></p>
            <p class="ma-card__meta"><%= r.trade %> · from <%= r.from %> · <%= r.when %></p>
          </div>
          <span class="ma-pill ma-pill--pending"><%= r.statusLabel %></span>
        </div>
        <% if (!_locked) { %>
        <p class="ma-card__meta" style="margin-top:8px">
          <% if (c.phone) { %><a href="tel:<%= String(c.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= c.phone %></a><%= (c.email || c.address || c.city || c.zip || c.replyUrl) ? ' · ' : '' %><% } %>
          <%= [c.email, c.address, [c.city, c.zip].filter(Boolean).join(' ')].filter(Boolean).join(' · ') %>
          <% if (c.replyUrl) { %><% if (c.phone || c.email || c.address || c.city || c.zip) { %> · <% } %><a href="<%= c.replyUrl %>" target="_blank" rel="noopener noreferrer" style="font-weight:700;color:var(--acc)">Open reply link</a><% } %>
        </p>
        <% if (c.note) { %><p class="ma-card__note"><%= c.note %></p><% } %>
        <div class="ma-actions">
          <form method="post" action="<%= base %>/referrals/<%= r.id %>">
            <input type="hidden" name="action" value="claim">
            <button type="submit" class="ma-btn ma-btn--sm">Claim this lead</button>
          </form>
          <% if (c.replyUrl) { %><a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= c.replyUrl %>" target="_blank" rel="noopener noreferrer">Reply link</a><% } %>
        </div>
        <% } else { %>
        <p class="ma-card__meta" style="margin-top:8px">Contact details locked — upgrade to claim.</p>
        <div class="ma-actions">
          <a class="ma-btn ma-btn--sm" href="<%= typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup' %>">Upgrade to unlock</a>
        </div>
        <% } %>
      </article>
      <% }); %>
    <% } else if (view === 'received') { %>
      <% if (!_locked) { %>
      <section class="ma-card" id="maPushRoot" data-base="<%= base %>" style="margin-bottom:12px">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title">Phone alerts</p>
            <p class="ma-card__meta" data-ma-push-status>Turn on phone or desktop alerts so agency messages, leads, and referrals wake you up.</p>
          </div>
        </div>
        <div class="ma-actions" style="margin-top:10px">
          <button type="button" class="ma-btn ma-btn--sm" data-ma-push-enable>Turn on alerts</button>
          <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-push-off hidden>Turn off</button>
        </div>
      </section>
      <% if (_hasAppt && typeof openLeadCount !== 'undefined') { %>
      <p class="ma-page-sub" style="margin-top:0"><%= openLeadCount %> open website/agency · <%= typeof leadCredits !== 'undefined' && leadCredits ? leadCredits.remaining : 0 %> credits left</p>
      <% } %>
      <% } %>

      <% if (_formLeads.length) { %>
      <section class="ma-section ma-section--first" aria-label="Website and agency leads">
        <div class="ma-section__head">
          <h2>Website &amp; agency</h2>
        </div>
        <% _formLeads.forEach(function (lead) { %>
        <article class="ma-card" id="lead-<%= lead.id %>">
          <div class="ma-card__row">
            <div style="min-width:0">
              <p class="ma-card__title"><%= lead.name %></p>
              <p class="ma-card__meta">
                <% if (lead.source === 'agency') { %>Sent by agency<% } else { %><%= lead.formName || 'Website form' %><% } %>
                <% if (lead.at) { %> · <%= new Date(lead.at).toLocaleString() %><% } %>
              </p>
              <% if (_locked || lead.detailsLocked) { %>
              <p class="ma-card__meta" style="margin-top:6px">Details locked — upgrade to see phone, email, and notes.</p>
              <% } else { %>
              <% if (lead.phone || lead.email) { %>
              <p class="ma-card__meta" style="margin-top:6px">
                <% if (lead.phone) { %><a href="tel:<%= String(lead.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= lead.phone %></a><% } %>
                <% if (lead.phone && lead.email) { %> · <% } %>
                <% if (lead.email) { %><a href="mailto:<%= lead.email %>" style="color:inherit"><%= lead.email %></a><% } %>
              </p>
              <% } %>
              <% if (lead.preview) { %><p class="ma-card__note"><%= lead.preview %></p><% } %>
              <% } %>
            </div>
            <span class="ma-pill <%= lead.status === 'closed' ? 'ma-pill--lost' : 'ma-pill--accepted' %>"><%= lead.status === 'closed' ? 'Closed' : (lead.source === 'agency' ? 'Agency' : 'Open') %></span>
          </div>
          <% if (lead.status !== 'closed') { %>
          <div class="ma-actions">
            <% if (_locked || lead.detailsLocked) { %>
            <a class="ma-btn ma-btn--sm" href="<%= typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup' %>">Upgrade to unlock</a>
            <% } else { %>
            <% if (lead.phone) { %><a class="ma-btn ma-btn--sm" href="tel:<%= String(lead.phone).replace(/[^0-9+]/g, '') %>">Call</a><% } %>
            <form method="post" action="<%= base %>/leads/<%= encodeURIComponent(lead.id) %>/to-customer">
              <button type="submit" class="ma-btn ma-btn--sm"><%- icons.customers %> Mark as customer</button>
            </form>
            <form method="post" action="<%= base %>/leads/<%= encodeURIComponent(lead.id) %>/close">
              <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft">Mark closed</button>
            </form>
            <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= base %>/review">Request review</a>
            <% } %>
          </div>
          <%
            const _canRefer = !_locked
              && (lead.phone || lead.email)
              && (
                (typeof partnerMembers !== 'undefined' && partnerMembers && partnerMembers.length)
                || (typeof partnerDirectory !== 'undefined' && partnerDirectory && partnerDirectory.length)
              );
          %>
          <% if (_canRefer) { %>
          <details class="ma-card" style="margin-top:10px;padding:12px 14px" id="lead-refer-<%= lead.id %>">
            <summary style="cursor:pointer;font-weight:800;font-size:14px;list-style:none;display:flex;align-items:center;gap:8px">
              <%- icons.send %> Send to a partner
            </summary>
            <p class="ma-hint" style="margin:10px 0 12px">Pushes this lead to a teammate or referral partner — no copy/paste. They get the details and a text.</p>
            <form method="post" action="<%= base %>/leads/<%= encodeURIComponent(lead.id) %>/refer" autocomplete="off" data-ma-loading="Sending…">
              <% if (typeof partnerMembers !== 'undefined' && partnerMembers && partnerMembers.length) { %>
              <div class="ma-field">
                <label class="ma-label" for="flPartner-<%= lead.id %>">Partner</label>
                <select id="flPartner-<%= lead.id %>" name="toMemberId" class="ma-select">
                  <option value="">Route by trade (auto-match)</option>
                  <% partnerMembers.forEach(function (p) { %>
                  <option value="<%= p.id %>"><%= p.label %><%= p.tradeLabel ? ' · ' + p.tradeLabel : '' %></option>
                  <% }); %>
                </select>
              </div>
              <% } %>
              <div class="ma-field">
                <label class="ma-label" for="flTrade-<%= lead.id %>">Trade they need</label>
                <select id="flTrade-<%= lead.id %>" name="tradeSlug" class="ma-select">
                  <option value="">Pick a trade…</option>
                  <% (typeof partnerDirectory !== 'undefined' && partnerDirectory ? partnerDirectory : []).forEach(function (t) { %>
                  <option value="<%= t.slug %>"><%= t.name %><%= t.holders && t.holders.length ? ' · ' + t.holders.slice(0, 2).join(', ') : '' %></option>
                  <% }); %>
                </select>
              </div>
              <p class="ma-hint" style="margin:0 0 12px">Pick a partner <em>or</em> a trade. Partner wins when both are set.</p>
              <button type="submit" class="ma-btn ma-btn--block ma-btn--sm"><%- icons.send %> Send lead to partner</button>
            </form>
            <%
              const _sendQs = new URLSearchParams({
                name: lead.name || '',
                phone: lead.phone || '',
                email: lead.email || '',
                note: lead.preview || '',
                consent: '1',
              }).toString();
            %>
            <p class="ma-hint" style="margin:10px 0 0"><a href="<%= base %>/send?<%= _sendQs %>">Edit details on Send first</a></p>
          </details>
          <% } else if (!_locked && (lead.phone || lead.email)) { %>
          <p class="ma-hint" style="margin:10px 0 0">Add referral partners to your network to push this lead with one tap.</p>
          <% } %>
          <% } %>
        </article>
        <% }); %>
      </section>
      <% } %>

      <% const _contactQuotes = _contactQuotesTop; %>
      <% if (_contactQuotes.length) { %>
      <section class="ma-section<%= _formLeads.length ? '' : ' ma-section--first' %>" aria-label="Contacts marked as quote requests">
        <div class="ma-section__head">
          <h2>Quote requests</h2>
        </div>
        <% _contactQuotes.forEach(function (row) { %>
        <article class="ma-card" id="contact-quote-<%= row.id %>">
          <div class="ma-card__row">
            <div style="min-width:0">
              <p class="ma-card__title"><%= row.name %></p>
              <p class="ma-card__meta">
                Material quote from contacts
                <% if (row.at) { %> · <%= new Date(row.at).toLocaleString() %><% } %>
              </p>
              <% if (row.phone || row.email || row.address) { %>
              <p class="ma-card__meta" style="margin-top:6px">
                <% if (row.phone) { %><a href="tel:<%= String(row.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= row.phone %></a><% } %>
                <% if (row.phone && row.email) { %> · <% } %>
                <% if (row.email) { %><a href="mailto:<%= row.email %>" style="color:inherit"><%= row.email %></a><% } %>
                <% if ((row.phone || row.email) && row.address) { %> · <% } %>
                <% if (row.address) { %><%= row.address %><% } %>
              </p>
              <% } %>
              <% if (row.preview) { %><p class="ma-card__note"><%= row.preview %></p><% } %>
            </div>
            <span class="ma-pill ma-pill--job-estimate">Quote</span>
          </div>
          <div class="ma-actions">
            <a class="ma-btn ma-btn--sm" href="<%= row.quoteHref || (base + '/quote?customer=' + encodeURIComponent(row.id)) %>"><%- icons.send %> Request quote</a>
            <form method="post" action="<%= base %>/customers/c/<%= encodeURIComponent(row.id) %>/mark-customer">
              <button type="submit" class="ma-btn ma-btn--sm"><%- icons.customers %> Mark as customer</button>
            </form>
            <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= row.href %>">Open</a>
          </div>
        </article>
        <% }); %>
      </section>
      <% } %>

      <% if (_contactLeads.length) { %>
      <section class="ma-section<%= (_formLeads.length || _contactQuotes.length) ? '' : ' ma-section--first' %>" aria-label="Contacts marked as leads">
        <div class="ma-section__head">
          <h2>Leads from contacts and online forms</h2>
        </div>
        <% _contactLeads.forEach(function (lead) { %>
        <article class="ma-card" id="contact-lead-<%= lead.id %>">
          <div class="ma-card__row">
            <div style="min-width:0">
              <p class="ma-card__title"><%= lead.name %></p>
              <p class="ma-card__meta">
                <%= (lead.sourceLabel && lead.sourceLabel !== 'Manual') ? lead.sourceLabel : 'Marked from contacts' %>
                <% if (lead.at) { %> · <%= new Date(lead.at).toLocaleString() %><% } %>
              </p>
              <% if (lead.phone || lead.email || lead.address) { %>
              <p class="ma-card__meta" style="margin-top:6px">
                <% if (lead.phone) { %><a href="tel:<%= String(lead.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= lead.phone %></a><% } %>
                <% if (lead.phone && lead.email) { %> · <% } %>
                <% if (lead.email) { %><a href="mailto:<%= lead.email %>" style="color:inherit"><%= lead.email %></a><% } %>
                <% if ((lead.phone || lead.email) && lead.address) { %> · <% } %>
                <% if (lead.address) { %><%= lead.address %><% } %>
              </p>
              <% } %>
              <% if (lead.preview) { %><p class="ma-card__note"><%= lead.preview %></p><% } %>
            </div>
            <span class="ma-pill ma-pill--accepted">Lead</span>
          </div>
          <div class="ma-actions">
            <% if (lead.phone) { %><a class="ma-btn ma-btn--sm" href="tel:<%= String(lead.phone).replace(/[^0-9+]/g, '') %>">Call</a><% } %>
            <% if (typeof isFlooringPartner !== 'undefined' && isFlooringPartner) { %>
            <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= lead.quoteHref || (base + '/quote?customer=' + encodeURIComponent(lead.id)) %>">Quote</a>
            <% } %>
            <form method="post" action="<%= base %>/customers/c/<%= encodeURIComponent(lead.id) %>/mark-customer">
              <button type="submit" class="ma-btn ma-btn--sm"><%- icons.customers %> Mark as customer</button>
            </form>
            <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= lead.href %>">Open</a>
            <form method="post" action="<%= base %>/customers/c/<%= encodeURIComponent(lead.id) %>/remove-lead" data-ma-confirm="Remove <%= lead.name %> from Leads? They’ll stay in Customers.">
              <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft">Remove</button>
            </form>
            <form method="post" action="<%= base %>/customers/c/<%= encodeURIComponent(lead.id) %>/delete-lead" data-ma-confirm="Delete <%= lead.name %> permanently from your book?">
              <button type="submit" class="ma-btn ma-btn--sm ma-btn--danger">Delete</button>
            </form>
          </div>
        </article>
        <% }); %>
      </section>
      <% } %>

      <% if (received.length) { %>
      <section class="ma-section<%= (_formLeads.length || _contactLeads.length || _contactQuotes.length) ? '' : ' ma-section--first' %>" aria-label="Network referrals">
        <% if (_formLeads.length || _contactLeads.length || _contactQuotes.length) { %>
        <div class="ma-section__head">
          <h2>Network referrals</h2>
        </div>
        <% } %>
        <% received.forEach(function (r) { const c = r.customer || {}; %>
        <article class="ma-card" id="ref-<%= r.id %>">
          <div class="ma-card__row">
            <div style="min-width:0">
              <p class="ma-card__title"><%= c.name || 'Customer' %></p>
              <p class="ma-card__meta"><%= r.trade %> · from <%= r.from %> · <%= r.when %></p>
            </div>
            <span class="ma-pill ma-pill--<%= r.status %>"><%= r.statusLabel %><%= r.value ? ' · ' + r.value : '' %></span>
          </div>
          <% if (_locked) { %>
          <p class="ma-card__meta" style="margin-top:8px">Contact details locked — upgrade to open this lead.</p>
          <div class="ma-actions">
            <a class="ma-btn ma-btn--sm" href="<%= typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup' %>">Upgrade to unlock</a>
          </div>
          <% } else { %>
          <% if (r.status !== 'declined') { %>
          <p class="ma-card__meta" style="margin-top:8px">
            <% if (c.phone) { %><a href="tel:<%= String(c.phone).replace(/[^0-9+]/g, '') %>" style="font-weight:700;color:var(--acc);text-decoration:none"><%= c.phone %></a><%= (c.email || c.address || c.city || c.zip) ? ' · ' : '' %><% } %>
            <%= [c.email, c.address, [c.city, c.zip].filter(Boolean).join(' ')].filter(Boolean).join(' · ') %>
          </p>
          <% } %>
          <% if (c.note) { %><p class="ma-card__note"><%= c.note %></p><% } %>
          <% r.notes.forEach(function (n) { %><p class="ma-card__meta" style="margin-top:6px">Note: <%= n.text %></p><% }); %>

          <div class="ma-actions">
            <% if (r.jobHref) { %>
            <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= r.jobHref %>"><%- icons.customers %> View job</a>
            <% } else if (r.convertible) { %>
            <form method="post" action="<%= base %>/customers/from-referral/<%= r.id %>">
              <input type="hidden" name="back" value="<%= base %>/referrals">
              <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft"><%- icons.customers %> Add to Customers</button>
            </form>
            <% } %>
            <% r.actions.forEach(function (a) { if (a === 'win') return; %>
            <form method="post" action="<%= base %>/referrals/<%= r.id %>">
              <input type="hidden" name="action" value="<%= a %>">
              <button type="submit" class="ma-btn ma-btn--sm <%= a === 'accept' ? '' : (a === 'decline' || a === 'lose' ? 'ma-btn--danger' : 'ma-btn--soft') %>" <%- a === 'decline' ? 'onclick="return confirm(\'Decline this referral?\')"' : '' %>><%= { accept: 'Accept', decline: 'Decline', book: 'Booked', lose: 'Lost' }[a] %></button>
            </form>
            <% }); %>
          </div>
          <% if (r.actions.indexOf('win') >= 0) { %>
          <form method="post" action="<%= base %>/referrals/<%= r.id %>" class="ma-inline" style="margin-top:8px">
            <input type="hidden" name="action" value="win">
            <input class="ma-input" name="value" inputmode="decimal" placeholder="Job value $" required aria-label="Job value">
            <button type="submit" class="ma-btn ma-btn--sm">Won</button>
          </form>
          <% } %>
          <details style="margin-top:8px">
            <summary class="ma-card__meta" style="cursor:pointer;font-weight:700">Add a note</summary>
            <form method="post" action="<%= base %>/referrals/<%= r.id %>" class="ma-inline" style="margin-top:8px">
              <input type="hidden" name="action" value="note">
              <input class="ma-input" name="text" maxlength="500" placeholder="e.g. Left a voicemail" required aria-label="Note">
              <button type="submit" class="ma-btn ma-btn--sm ma-btn--soft">Save</button>
            </form>
          </details>
          <% } %>
        </article>
        <% }); %>
      </section>
      <% } %>

      <% if (!_formLeads.length && !_contactLeads.length && !received.length) { %>
      <div class="ma-card ma-empty">
        <%- icons.leads %>
        <p><% if (_hasAppt) { %>No website, agency, contact, or network leads yet. Form submissions and leads your agency sends show here with an alert. Mark a contact as a lead from Customers when someone texts or calls.<% } else { %>No leads yet. Mark a contact as a lead from Customers when someone texts or calls, or check the Pool for open network jobs.<% } %></p>
        <div class="ma-actions" style="margin-top:8px;justify-content:center">
          <a class="ma-btn ma-btn--sm" href="<%= base %>/customers">Open contacts</a>
          <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= base %>/referrals?view=pool">Open pool</a>
        </div>
      </div>
      <% } %>
    <% } else { %>
      <% if (!sent.length) { %>
      <div class="ma-card ma-empty"><%- icons.send %><p>You haven't sent a referral yet.</p><% if (!_locked) { %><a class="ma-btn ma-btn--sm" href="<%= base %>/send" style="margin-top:8px">Send one</a><% } %></div>
      <% } %>
      <% sent.forEach(function (r) { const c = r.customer || {}; %>
      <article class="ma-card">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= c.name || 'Customer' %></p>
            <p class="ma-card__meta"><%= r.trade %> · to <%= r.to %> · <%= r.when %></p>
          </div>
          <span class="ma-pill ma-pill--<%= r.status === 'unrouted' ? 'pending' : r.status %>"><%= r.statusLabel %><%= r.value ? ' · ' + r.value : '' %></span>
        </div>
      </article>
      <% }); %>
    <% } %>
  </main>
  <%- include('_tabbar') %>
  <% if (!_locked) { %>
  <script src="/js/member-app-push.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
  <% } %>
</body>
</html>
