<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Packages' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', {
      topTitle: 'Packages',
      topBack: { href: base + '/leads', label: 'Leads' },
    }) %>
    <%- include('_flash') %>

    <section class="ma-appt">
      <p class="ma-appt__kicker">Inventory</p>
      <h2 class="ma-appt__title">Stock up when you’re running low</h2>
      <p class="ma-appt__sub">Request more website leads or appointment slots. Your agency gets a task and can fulfill the package.</p>
      <div class="ma-appt__stats">
        <div><b><%= leadCredits.remaining %></b><span>Lead credits</span></div>
        <div><b><%= tracker.counts.remaining %></b><span>Appts left</span></div>
        <div><b><%= pendingRequests.length %></b><span>Pending</span></div>
      </div>
    </section>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Purchase lead package</h2></div>
      <form method="post" action="<%= base %>/packages/request" class="ma-card" autocomplete="off">
        <p class="ma-card__meta">Buy a block of website/form lead credits. Delivered leads show up on your Leads tab.</p>
        <input type="hidden" name="type" value="leads" />
        <input type="hidden" name="intent" value="purchase" />
        <label class="ma-field" style="margin-top:12px">
          <span class="ma-label">Package size</span>
          <select name="quantity" class="ma-select">
            <option value="10">10 leads</option>
            <option value="25" selected>25 leads</option>
            <option value="50">50 leads</option>
            <option value="100">100 leads</option>
          </select>
        </label>
        <label class="ma-field">
          <span class="ma-label">Note (optional)</span>
          <textarea name="note" class="ma-textarea" rows="2" placeholder="Need more leads in Austin this month"></textarea>
        </label>
        <button type="submit" class="ma-btn ma-btn--block">Request purchase</button>
      </form>
    </section>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Request more appointments</h2></div>
      <form method="post" action="<%= base %>/packages/request" class="ma-card" autocomplete="off">
        <p class="ma-card__meta">Add appointment slots to your tracker when the calendar is filling up.</p>
        <input type="hidden" name="type" value="appointments" />
        <label class="ma-field" style="margin-top:12px">
          <span class="ma-label">How many appointments?</span>
          <input type="number" name="quantity" class="ma-input" min="1" max="500" value="10" required />
        </label>
        <label class="ma-field">
          <span class="ma-label">Note (optional)</span>
          <textarea name="note" class="ma-textarea" rows="2" placeholder="Sold a 10-pack upsell — please add slots"></textarea>
        </label>
        <button type="submit" class="ma-btn ma-btn--block ma-btn--soft">Request appointments</button>
      </form>
    </section>

    <% if ((package.requests || []).length) { %>
    <section class="ma-section">
      <div class="ma-section__head"><h2>Request history</h2></div>
      <% package.requests.slice(0, 12).forEach(function (req) { %>
      <div class="ma-card">
        <div class="ma-card__row">
          <div>
            <p class="ma-card__title"><%= req.quantity %> <%= req.type %></p>
            <p class="ma-card__meta"><%= new Date(req.createdAt).toLocaleString() %><% if (req.note) { %> · <%= req.note %><% } %></p>
          </div>
          <span class="ma-pill <%= req.status === 'pending' ? 'ma-pill--pending' : (req.status === 'fulfilled' ? 'ma-pill--won' : '') %>"><%= req.status %></span>
        </div>
      </div>
      <% }); %>
    </section>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
