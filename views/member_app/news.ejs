<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'News & updates' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'News & updates', topBack: typeof topBack !== 'undefined' ? topBack : { href: base, label: 'Home' } }) %>
    <h1 class="ma-page-title">News &amp; updates</h1>
    <p class="ma-page-sub">Announcements, links, and app updates from your network.</p>

    <%- include('_flash') %>

    <% const rows = Array.isArray(posts) ? posts : []; %>
    <% const highlightId = typeof highlightId !== 'undefined' ? String(highlightId || '') : ''; %>
    <% if (!rows.length) { %>
    <p class="ma-empty">No news yet. When your network posts an update, it shows up here and in Notifications.</p>
    <% } else { %>
    <div class="ma-list ma-news-list" role="list">
      <% rows.forEach(function (item) { %>
      <%
        const when = item && item.at || '';
        let whenLabel = '';
        if (when) {
          const ms = Date.now() - Date.parse(when);
          if (Number.isFinite(ms)) {
            const m = Math.max(0, Math.round(ms / 60000));
            if (m < 60) whenLabel = m < 1 ? 'just now' : (m + 'm ago');
            else if (m < 60 * 24) whenLabel = Math.round(m / 60) + 'h ago';
            else whenLabel = Math.round(m / (60 * 24)) + 'd ago';
          }
        }
        const isOn = highlightId && item && item.id === highlightId;
        const link = item && item.link ? item.link : '';
        const linkLabel = (item && item.linkLabel) || (link ? 'Open link' : '');
      %>
      <article class="ma-card ma-news-card<%= isOn ? ' is-highlight' : '' %>" id="news-<%= item.id %>" role="listitem">
        <p class="ma-news-card__when"><%= whenLabel || 'Update' %></p>
        <h2 class="ma-news-card__title"><%= item.title %></h2>
        <p class="ma-news-card__body"><%= item.body %></p>
        <% if (link) { %>
        <div class="ma-actions" style="margin-top:12px">
          <a class="ma-btn ma-btn--sm" href="<%= link %>" target="_blank" rel="noopener noreferrer"><%= linkLabel %></a>
        </div>
        <% } %>
      </article>
      <% }); %>
    </div>
    <% } %>
  </main>
  <%- include('_tabbar', { active: 'home' }) %>
</body>
</html>
