<%
  const _v = typeof assetVersion !== 'undefined' ? assetVersion : '1';
  const _base = typeof base !== 'undefined' && base && !(typeof preview !== 'undefined' && preview) ? base : '';
  const _title = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · ' + brand.appName : brand.appName;
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="<%= typeof robots !== 'undefined' && robots ? robots : 'noindex' %>">
<meta name="theme-color" content="#ffffff" id="maThemeColor">
<title><%= _title %></title>
<script>
/* Appearance before CSS paint.
   Workspace → White label light/dark wins over stale ma-theme / pins.
   Profile pins only stick if set AFTER the latest White-label appearance save. */
(function () {
  try {
    var workspacePref = <%- JSON.stringify((typeof brand !== 'undefined' && brand && brand.preferredTheme) ? brand.preferredTheme : 'system') %>;
    if (workspacePref !== 'light' && workspacePref !== 'dark' && workspacePref !== 'system') workspacePref = 'system';
    var workspaceAt = <%- JSON.stringify((typeof brand !== 'undefined' && brand && brand.preferredThemeAt) ? String(brand.preferredThemeAt) : '') %>;
    document.documentElement.setAttribute('data-ma-workspace-theme', workspacePref);
    if (workspaceAt) document.documentElement.setAttribute('data-ma-workspace-theme-at', workspaceAt);
    var stored = null;
    var pinned = false;
    var pinnedAt = '';
    try {
      stored = localStorage.getItem('ma-theme');
      pinned = localStorage.getItem('ma-theme-pinned') === '1';
      pinnedAt = String(localStorage.getItem('ma-theme-pinned-at') || '');
    } catch (e) { /* private mode */ }
    var pinValid = false;
    if (pinned && (stored === 'light' || stored === 'dark' || stored === 'system')) {
      if (workspacePref === 'light' || workspacePref === 'dark') {
        // No stamp, or pin older than White-label save → workspace wins.
        pinValid = !!(workspaceAt && pinnedAt && Number(pinnedAt) >= Number(workspaceAt));
      } else {
        pinValid = true;
      }
    }
    var pref;
    if (pinValid) {
      pref = stored;
    } else if (workspacePref === 'light' || workspacePref === 'dark') {
      pref = workspacePref;
      try {
        localStorage.setItem('ma-theme', pref);
        localStorage.removeItem('ma-theme-pinned');
        localStorage.removeItem('ma-theme-pinned-at');
      } catch (e2) { /* ignore */ }
    } else if (stored === 'light' || stored === 'dark' || stored === 'system') {
      pref = stored;
    } else {
      pref = 'system';
    }
    var theme = pref;
    if (pref !== 'light' && pref !== 'dark') {
      theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      pref = 'system';
    }
    document.documentElement.setAttribute('data-ma-theme', theme);
    document.documentElement.setAttribute('data-ma-theme-pref', pref);
    var meta = document.getElementById('maThemeColor');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#1c1c1e' : '#ffffff');
  } catch (e) {
    document.documentElement.setAttribute('data-ma-theme', 'light');
    document.documentElement.setAttribute('data-ma-theme-pref', 'system');
    document.documentElement.setAttribute('data-ma-workspace-theme', 'system');
  }
})();
</script>
<% if (_base) { %>
<% const _iconV = encodeURIComponent(typeof appIconVersion !== 'undefined' && appIconVersion ? appIconVersion : _v); %>
<link rel="manifest" href="<%= _base %>/manifest.webmanifest?v=<%= _iconV %>">
<link rel="apple-touch-icon" href="<%= _base %>/icon-180.png?v=<%= _iconV %>">
<link rel="icon" type="image/png" href="<%= _base %>/icon-192.png?v=<%= _iconV %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="<%= brand.shortName %>">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Manrope:wght@700;800&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Manrope:wght@700;800&display=swap"></noscript>
<% const _cssAsync = typeof cssAsync !== 'undefined' && cssAsync; %>
<% if (_cssAsync) { %>
<link rel="stylesheet" href="/css/member-app.css?v=<%= _v %>" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="/css/member-app.css?v=<%= _v %>"></noscript>
<% } else { %>
<link rel="stylesheet" href="/css/member-app.css?v=<%= _v %>">
<% } %>
<style>:root { --acc: <%= brand.accent %>; --on: <%= brand.onAccent %>; --bg:#f2f2f7; --card:#fff; --ink:#000; --muted:#6e6e73; --line:rgba(60,60,67,.12); --font-text:-apple-system,BlinkMacSystemFont,"SF Pro Text",Inter,ui-sans-serif,system-ui,sans-serif; --font-display:-apple-system,BlinkMacSystemFont,"SF Pro Display",Manrope,Inter,ui-sans-serif,system-ui,sans-serif; }
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font-text);font-size:15px;line-height:1.4;-webkit-font-smoothing:antialiased;min-height:100svh}
h1,h2,h3{font-family:var(--font-display);letter-spacing:-.02em}
.rv-wrap{max-width:440px;margin:0 auto;padding:calc(env(safe-area-inset-top,0px) + 28px) 20px calc(env(safe-area-inset-bottom,0px) + 32px);text-align:center}
.rv-logo{width:84px;height:84px;border-radius:50%;object-fit:cover;background:#fff;box-shadow:0 6px 20px rgba(15,23,42,.1);margin:0 auto 14px;display:block}
.rv-initials{width:84px;height:84px;border-radius:50%;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;background:var(--acc);color:var(--on);font-family:var(--font-display);font-weight:900;font-size:30px}
.rv-wrap h1{font-size:24px;font-weight:800;margin:0}
.rv-sub{color:var(--muted);margin:6px 0 22px;font-size:15px}
.rv-stars{display:flex;justify-content:center;gap:6px;margin:4px 0 8px}
.rv-star{display:inline-block;width:52px;height:52px;border:0;background:transparent;padding:0;color:color-mix(in srgb,var(--muted) 40%,transparent)}
.rv-star svg{width:100%;height:100%;display:block}
.rv-star.is-on{color:#fbbf24}
.rv-panel{margin-top:18px;text-align:left}
.rv-links{display:grid;gap:10px;margin-top:12px}
.rv-foot{margin-top:28px;font-size:12px;color:var(--muted)}
</style>
<% /* Critical layout — ships with HTML (network-first) so a stale SW-cached stylesheet can't blow up settings icons or leave a gap under the tab bar. */ %>
<style id="ma-critical">
a.ma-settings-row,button.ma-settings-row,summary.ma-settings-row{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;align-items:center;gap:10px;width:100%;max-width:100%;min-height:44px;padding:10px 2px;margin:0;border:0;background:transparent;font:inherit;color:inherit;text-align:left;text-decoration:none;-webkit-appearance:none;appearance:none;box-sizing:border-box;list-style:none}
summary.ma-settings-row::-webkit-details-marker,summary.ma-settings-row::marker{display:none;content:""}
.ma-settings-row__icon{flex:0 0 28px;width:28px!important;height:28px!important;max-width:28px;max-height:28px;border-radius:8px;display:inline-flex!important;align-items:center;justify-content:center;overflow:hidden}
.ma-settings-row__icon svg{width:14px!important;height:14px!important;max-width:14px;max-height:14px;display:block}
.ma-settings-row__text{flex:1 1 auto;min-width:0}
.ma-settings-row__text strong{font-size:14px;font-weight:700;display:block}
.ma-settings-row__text span{font-size:12px;font-weight:600;display:block;line-height:1.3}
.ma-settings-row__chev{flex:0 0 16px;width:16px;height:16px;display:inline-flex!important}
.ma-settings-row__chev svg{width:16px!important;height:16px!important;display:block}
.ma-empty--tap{display:flex!important;flex-direction:row!important;align-items:center;gap:12px;text-align:left;padding:16px;text-decoration:none}
.ma-empty--tap>svg{width:22px;height:22px;flex:0 0 22px;margin:0;color:var(--acc)}
.ma-empty--tap>p{margin:0;flex:1 1 auto;min-width:0;line-height:1.35}
.rv-field-label{display:flex!important;align-items:center;gap:8px}
.rv-field-badge{flex:0 0 22px;width:22px!important;height:22px!important;max-width:22px;max-height:22px;aspect-ratio:1/1;border-radius:6px;display:inline-flex!important;align-items:center;justify-content:center;align-self:center;overflow:hidden;box-sizing:border-box;border:1px solid var(--line);background:#fff}
.rv-field-badge svg{width:14px!important;height:14px!important;max-width:14px;max-height:14px;aspect-ratio:1/1;flex:0 0 14px;display:block}
.rv-link__icon{flex:0 0 36px;width:36px!important;height:36px!important;aspect-ratio:1/1;display:inline-flex!important;align-items:center;justify-content:center;overflow:hidden}
.rv-link__icon svg{width:22px!important;height:22px!important;aspect-ratio:1/1;flex:0 0 22px;display:block}
.ma-tabbar{position:fixed!important;left:0;right:0;bottom:0!important;width:100%;margin:0;z-index:40;box-sizing:border-box;padding:0;padding-bottom:env(safe-area-inset-bottom,0px);overflow:visible;border:0;box-shadow:none;background:rgba(255,255,255,.82)!important;-webkit-backdrop-filter:saturate(140%) blur(10px)!important;backdrop-filter:saturate(140%) blur(10px)!important}
.ma-tabbar::before{content:"";position:absolute;left:0;right:0;bottom:100%;height:28px;pointer-events:none;background:linear-gradient(to top,rgba(255,255,255,.82) 0%,rgba(255,255,255,.42) 45%,rgba(255,255,255,0) 100%)}
.ma-tabbar__inner{position:relative;z-index:1;height:50px;background:transparent}
.ma-tab{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:1px;height:100%;padding-bottom:4px;box-sizing:border-box;text-decoration:none;font-family:var(--font-text,-apple-system,BlinkMacSystemFont,Inter,sans-serif);font-size:10px;font-weight:600;letter-spacing:.01em;line-height:1.1}
.ma-tab svg{width:24px;height:24px;display:block}
.ma-tab__label{display:block;font-family:inherit;font-size:10px;font-weight:600;letter-spacing:.01em;line-height:1.1;white-space:nowrap}
.ma-tab__slot{display:block;width:24px;height:24px;flex:0 0 24px}
.ma-tab--fab .ma-tab__slot{display:none}
.ma-tab--fab .ma-tab__fab{width:52px;height:52px;border-radius:999px;background:var(--acc);color:var(--on);display:inline-flex;align-items:center;justify-content:center;margin-top:-26px;margin-bottom:1px;position:relative;z-index:2;flex:0 0 52px}
.ma-tab--fab .ma-tab__label{position:relative;z-index:3}
.ma-shell{padding-bottom:calc(50px + 26px + 20px + env(safe-area-inset-bottom,0px))!important;scroll-padding-bottom:calc(50px + 26px + 20px + env(safe-area-inset-bottom,0px))!important}
.ma-fold__body form.ma-card--flush{display:flex;flex-direction:column;gap:12px;overflow:visible}
.ma-script-link{display:flex;flex-direction:column;gap:6px}
.ma-script-link__url{display:block;font-size:12px;line-height:1.35;overflow-wrap:anywhere;word-break:break-all}
.ma-script-save{margin-bottom:28px}
.ma-fold[open]>.ma-fold__body{padding-bottom:28px}
html[data-ma-theme="dark"] .ma-tabbar{background:rgba(28,28,30,.62)!important}
html[data-ma-theme="dark"] .ma-tabbar::before{background:linear-gradient(to top,rgba(28,28,30,.62) 0%,rgba(28,28,30,.34) 45%,rgba(28,28,30,0) 100%)}
.ma-quick__btn span{color:var(--ink)!important;font-weight:700}
.ma-quick__btn svg{color:var(--acc)!important}
/* Customer tags — critical so stale SW CSS can't leave plain text + tiny × */
.ma-tags__list{display:flex!important;flex-wrap:wrap;gap:8px;align-items:center;min-height:0}
.ma-tags__list:has(.ma-tags__chip){min-height:44px}
.ma-tags__chip{--ma-tag:var(--acc);display:inline-flex!important;flex-direction:row!important;align-items:center;gap:2px;min-height:44px;max-width:100%;border:1px solid color-mix(in srgb,var(--ma-tag) 55%,#0000);background:color-mix(in srgb,var(--ma-tag) 22%,var(--card,#fff));border-radius:999px!important;padding:4px 4px 4px 14px;box-sizing:border-box}
.ma-tags__chip-name{font-size:14px;font-weight:800;color:var(--ink,#0f172a);line-height:1.2;padding-right:4px}
.ma-tags__chip-remove{display:inline-flex!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important}
.ma-tags__chip-x{display:inline-flex!important;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:999px;background:color-mix(in srgb,var(--ma-tag) 28%,var(--card,#fff));color:var(--ink,#0f172a);font:inherit;font-size:22px;font-weight:700;line-height:1;cursor:pointer}
.ma-tags__search{margin-top:12px}
.ma-tags__submit{margin-top:12px!important}
.ma-tags__suggest{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0;padding:0;list-style:none}
.ma-tags__suggest-item form{margin:0;display:inline-flex}
.ma-tags__suggest-btn{display:inline-flex;align-items:center;min-height:44px;padding:10px 14px;border-radius:999px;border:1.5px dashed color-mix(in srgb,var(--ma-tag,var(--acc)) 55%,var(--muted,#94a3b8));background:var(--card,#fff);color:var(--ink,#0f172a);font:inherit;font-size:14px;font-weight:800;cursor:pointer}
html[data-ma-theme="dark"] .ma-tags__chip{background:color-mix(in srgb,var(--ma-tag) 36%,var(--card,#1c1c1e))}
html[data-ma-theme="dark"] .ma-tags__chip-x{background:color-mix(in srgb,var(--ma-tag) 42%,var(--card,#1c1c1e))}
html[data-ma-theme="dark"] .ma-tags__suggest-btn{background:color-mix(in srgb,var(--ma-tag) 22%,var(--card,#1c1c1e))}
.ma-tags__suggest[hidden]{display:none!important}
.ma-tags__chip.is-pending{opacity:.72}
.ma-tags .ma-typeahead{position:relative;overflow:visible}
.ma-tags .ma-typeahead__list{position:static!important;left:auto;right:auto;top:auto;margin:10px 0 0;max-height:min(240px,40vh);box-shadow:none}
.ma-share-mate-pick .ma-typeahead{position:relative;overflow:visible}
.ma-share-mate-pick .ma-typeahead__list{position:static!important;left:auto;right:auto;top:auto;margin:10px 0 0;max-height:min(240px,40vh);overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;touch-action:pan-y;box-shadow:none}
.ma-input::placeholder,.ma-textarea::placeholder{color:var(--muted);opacity:1}
/* Field mics — critical so stale SW CSS can't show stop/spin as random squares */
.ma-voice-btn,.alex-voice-btn.ma-voice-btn{position:relative;display:inline-flex!important;align-items:center;justify-content:center;width:36px!important;height:36px!important;margin:0;padding:0;border:1.5px solid var(--line,#e2e8f0);border-radius:999px!important;background:var(--card,#fff);color:var(--ink,#0f172a);cursor:pointer;flex:0 0 36px;-webkit-appearance:none;appearance:none;box-sizing:border-box}
.ma-voice-btn .alex-voice-icon,.alex-voice-btn.ma-voice-btn .alex-voice-icon{width:20px!important;height:20px!important;flex:0 0 20px;display:block}
.ma-voice-btn .alex-voice-icon--stop,.ma-voice-btn .alex-voice-icon--spin,.alex-voice-btn.ma-voice-btn .alex-voice-icon--stop,.alex-voice-btn.ma-voice-btn .alex-voice-icon--spin{display:none!important}
.ma-voice-btn[data-state=listening] .alex-voice-icon--mic,.ma-voice-btn[data-state=transcribing] .alex-voice-icon--mic{display:none!important}
.ma-voice-btn[data-state=listening] .alex-voice-icon--stop{display:block!important;width:14px!important;height:14px!important}
.ma-voice-btn[data-state=transcribing] .alex-voice-icon--spin{display:block!important;width:16px!important;height:16px!important;border:2px solid currentColor;border-right-color:transparent;border-radius:9999px}
/* New-customer speak-once: one big centered mic (never the tiny field style) */
.ma-voice-add{display:flex;flex-direction:column;align-items:center;text-align:center}
.ma-voice-add__mic-wrap{display:flex;justify-content:center;align-items:center;width:100%}
.ma-voice-add__mic,.alex-voice-btn.ma-voice-add__mic{position:relative;display:inline-flex!important;align-items:center;justify-content:center;width:88px!important;height:88px!important;margin:0 auto;padding:0;border:3px solid color-mix(in srgb,var(--acc,#2563eb) 70%,var(--line,#e2e8f0));border-radius:999px!important;background:var(--card,#fff);color:var(--acc,#2563eb);cursor:pointer;flex:0 0 88px!important;-webkit-appearance:none;appearance:none;box-sizing:border-box;overflow:hidden}
.ma-voice-add__mic .alex-voice-icon,.alex-voice-btn.ma-voice-add__mic .alex-voice-icon{position:absolute!important;left:50%!important;top:50%!important;width:40px!important;height:40px!important;margin:0!important;transform:translate(-50%,-50%)!important;flex:none!important;display:none!important}
.ma-voice-add__mic .alex-voice-icon--mic,.alex-voice-btn.ma-voice-add__mic .alex-voice-icon--mic{display:block!important}
.ma-voice-add__mic .alex-voice-icon--stop,.ma-voice-add__mic .alex-voice-icon--spin,.alex-voice-btn.ma-voice-add__mic .alex-voice-icon--stop,.alex-voice-btn.ma-voice-add__mic .alex-voice-icon--spin{display:none!important}
.ma-voice-add__mic[data-state=listening],.alex-voice-btn.ma-voice-add__mic[data-state=listening]{background:#ef4444!important;border-color:#ef4444!important;color:#fff!important;animation:maVoiceMicPulseCritical 1.1s ease-out infinite}
.ma-voice-add__status[hidden],.ma-voice-add__status:empty{display:none!important;margin:0!important}
@keyframes maVoiceMicPulseCritical{0%{box-shadow:0 0 0 0 rgb(239 68 68 / .55)}55%{box-shadow:0 0 0 18px rgb(239 68 68 / 0)}100%{box-shadow:0 0 0 0 rgb(239 68 68 / 0)}}
.ma-mark-lead{flex:0 0 auto;min-height:32px;padding:6px 10px;font-size:12px}
.ma-label-actions{display:inline-flex;align-items:center;gap:8px;flex-shrink:0}
/* Bring in customers — thin strip even if SW serves a stale member-app.css */
.ma-cust-tools.ma-fold{margin:0 0 8px!important;border-radius:10px!important}
.ma-cust-tools.ma-fold>summary{box-sizing:border-box!important;height:36px!important;min-height:36px!important;max-height:36px!important;padding:0 12px!important;font-size:13px!important;font-weight:800!important;line-height:1!important;gap:8px!important}
.ma-cust-tools.ma-fold[open]>summary{height:auto!important;max-height:none!important;min-height:36px!important;padding:8px 12px!important}
/* Referrals Board — critical so a stale SW CSS never collapses Top referrers into one link line */
.ma-refdash__stats{display:grid!important;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 14px}
.ma-refdash__stat{display:grid!important;gap:8px;justify-items:center;text-align:center;padding:14px 12px;border:1px solid var(--line,#e2e8f0);border-radius:16px;background:var(--card,#fff)}
.ma-refdash__stat-label{font-size:12px;font-weight:700;color:var(--muted,#64748b)}
.ma-refdash__stat-pill{display:inline-flex;align-items:center;justify-content:center;padding:6px 12px;border-radius:999px;font-size:12px;font-weight:800;text-transform:uppercase;background:color-mix(in srgb,var(--acc,#2563eb) 22%,var(--card,#fff))}
.ma-refdash__table{display:grid!important;gap:4px}
.ma-refdash__thead,.ma-refdash__row{display:grid!important;grid-template-columns:36px minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px 4px;width:100%;box-sizing:border-box}
.ma-refdash__thead{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted,#64748b);border-bottom:1px solid var(--line,#e2e8f0);padding-bottom:10px}
.ma-refdash__row{padding:10px 6px;border-radius:12px}
.ma-refdash__rank{width:28px;height:28px;border-radius:999px;background:var(--ink,#0f172a);color:var(--bg,#fff);display:inline-flex!important;align-items:center;justify-content:center;font-size:12px;font-weight:800}
a.ma-refdash__who{display:flex!important;align-items:center;gap:10px;min-width:0;text-decoration:none;color:inherit}
.ma-refdash__who-text{display:grid!important;gap:2px;min-width:0}
.ma-refdash__who-text strong{display:block;font-size:14px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ma-refdash__who-text small{display:block;font-size:12px;color:var(--muted,#64748b);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ma-refdash__avatar{width:34px;height:34px;border-radius:999px;background:color-mix(in srgb,var(--acc,#2563eb) 24%,var(--card,#fff));display:inline-flex!important;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0}
.ma-refdash__count{display:inline-flex!important;min-width:2rem;justify-content:center;padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--acc,#2563eb) 18%,var(--card,#fff));font-size:12px;font-weight:800}
/* Nav progress — critical so a tap on a slow customer page shows feedback immediately */
#maNavLoading{position:fixed;inset:0;z-index:9998;pointer-events:none;opacity:0;transition:opacity 120ms ease;background:rgba(0,0,0,.18);display:flex;align-items:center;justify-content:center;width:100vw;height:100vh;height:100dvh}
#maNavLoading.is-on{opacity:1}
#maNavLoading .ma-nav-loader{position:relative;width:72px;height:72px;display:flex;align-items:center;justify-content:center}
#maNavLoading .ma-nav-loader-ring{position:absolute;inset:0;width:100%;height:100%;animation:ma-nav-loader-spin .9s linear infinite}
#maNavLoading .ma-nav-loader-track{stroke:color-mix(in srgb,var(--acc) 18%,transparent);stroke-width:3;fill:none}
#maNavLoading .ma-nav-loader-arc{stroke:var(--acc);stroke-width:3.25;stroke-linecap:round;stroke-dasharray:62 128;fill:none}
#maNavLoading .ma-nav-loader-dot{width:14px;height:14px;border-radius:999px;background:var(--acc);box-shadow:0 0 0 6px color-mix(in srgb,var(--acc) 18%,transparent)}
@keyframes ma-nav-loader-spin{to{transform:rotate(360deg)}}
html.ma-nav-loading{cursor:progress}
</style>
