<%
  const _v = typeof assetVersion !== 'undefined' ? assetVersion : '1';
  const _base = typeof base !== 'undefined' && base && !(typeof preview !== 'undefined' && preview) ? base : '';
  const _title = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · ' + brand.appName : brand.appName;
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)">
<title><%= _title %></title>
<% if (_base) { %>
<% const _iconV = encodeURIComponent(typeof appIconVersion !== 'undefined' && appIconVersion ? appIconVersion : _v); %>
<link rel="manifest" href="<%= _base %>/manifest.webmanifest?v=<%= _iconV %>">
<link rel="apple-touch-icon" href="<%= _base %>/icon-180.png?v=<%= _iconV %>">
<link rel="icon" type="image/png" href="<%= _base %>/icon-192.png?v=<%= _iconV %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="<%= brand.shortName %>">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Manrope:wght@700;800&display=swap">
<link rel="stylesheet" href="/css/member-app.css?v=<%= _v %>">
<style>:root { --acc: <%= brand.accent %>; --on: <%= brand.onAccent %>; }</style>
<% /* Critical layout — ships with HTML (network-first) so a stale SW-cached stylesheet can't blow up settings icons or leave a gap under the tab bar. */ %>
<style id="ma-critical">
a.ma-settings-row,button.ma-settings-row,summary.ma-settings-row{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;align-items:center;gap:10px;width:100%;max-width:100%;min-height:44px;padding:10px 2px;margin:0;border:0;background:transparent;font:inherit;color:inherit;text-align:left;text-decoration:none;-webkit-appearance:none;appearance:none;box-sizing:border-box;list-style:none}
summary.ma-settings-row::-webkit-details-marker,summary.ma-settings-row::marker{display:none;content:""}
.ma-settings-row__icon{flex:0 0 28px;width:28px!important;height:28px!important;max-width:28px;max-height:28px;border-radius:8px;display:inline-flex!important;align-items:center;justify-content:center;overflow:hidden}
.ma-settings-row__icon svg{width:14px!important;height:14px!important;max-width:14px;max-height:14px;display:block}
.ma-settings-row__text{flex:1 1 auto;min-width:0}
.ma-settings-row__text strong{font-size:14px;font-weight:700;display:block}
.ma-settings-row__text span{font-size:12px;font-weight:600;display:block;line-height:1.3}
.ma-settings-row__chev{flex:0 0 16px;width:16px;height:16px;display:inline-flex!important}
.ma-settings-row__chev svg{width:16px!important;height:16px!important;display:block}
.ma-empty--tap{display:flex!important;flex-direction:row!important;align-items:center;gap:12px;text-align:left;padding:16px;text-decoration:none}
.ma-empty--tap>svg{width:22px;height:22px;flex:0 0 22px;margin:0;color:var(--acc)}
.ma-empty--tap>p{margin:0;flex:1 1 auto;min-width:0;line-height:1.35}
.rv-field-label{display:flex!important;align-items:center;gap:8px}
.rv-field-badge{flex:0 0 22px;width:22px!important;height:22px!important;max-width:22px;max-height:22px;aspect-ratio:1/1;border-radius:6px;display:inline-flex!important;align-items:center;justify-content:center;align-self:center;overflow:hidden;box-sizing:border-box;border:1px solid var(--line);background:#fff}
.rv-field-badge svg{width:14px!important;height:14px!important;max-width:14px;max-height:14px;aspect-ratio:1/1;flex:0 0 14px;display:block}
.rv-link__icon{flex:0 0 36px;width:36px!important;height:36px!important;aspect-ratio:1/1;display:inline-flex!important;align-items:center;justify-content:center;overflow:hidden}
.rv-link__icon svg{width:22px!important;height:22px!important;aspect-ratio:1/1;flex:0 0 22px;display:block}
.ma-tabbar{position:fixed!important;left:0;right:0;bottom:0!important;width:100%;margin:0;z-index:40;box-sizing:border-box;padding:0;padding-bottom:env(safe-area-inset-bottom,0px);overflow:visible;border:0;box-shadow:none;background:rgba(255,255,255,.58)!important;-webkit-backdrop-filter:saturate(180%) blur(22px)!important;backdrop-filter:saturate(180%) blur(22px)!important}
.ma-tabbar::before{content:"";position:absolute;left:0;right:0;bottom:100%;height:28px;pointer-events:none;background:linear-gradient(to top,rgba(255,255,255,.58) 0%,rgba(255,255,255,.32) 45%,rgba(255,255,255,0) 100%)}
.ma-tabbar__inner{position:relative;z-index:1;height:50px;background:transparent}
.ma-tab--send .ma-tab__fab{margin-top:-26px;position:relative;z-index:2}
.ma-shell{padding-bottom:calc(50px + 36px + 72px + env(safe-area-inset-bottom,0px))!important}
@media (prefers-color-scheme:dark){.ma-tabbar{background:rgba(28,28,30,.62)!important}.ma-tabbar::before{background:linear-gradient(to top,rgba(28,28,30,.62) 0%,rgba(28,28,30,.34) 45%,rgba(28,28,30,0) 100%)}}
/* Customer tags — critical so stale SW CSS can't leave plain text + tiny × */
.ma-tags__list{display:flex!important;flex-wrap:wrap;gap:10px;align-items:center;min-height:44px}
.ma-tags__chip{--ma-tag:var(--acc);display:inline-flex!important;flex-direction:row!important;align-items:center;gap:2px;min-height:44px;max-width:100%;border:1px solid color-mix(in srgb,var(--ma-tag) 55%,#0000);background:color-mix(in srgb,var(--ma-tag) 22%,#fff);border-radius:999px!important;padding:4px 4px 4px 14px;box-sizing:border-box}
.ma-tags__chip-name{font-size:14px;font-weight:800;color:var(--ink,#0f172a);line-height:1.2;padding-right:4px}
.ma-tags__chip-remove{display:inline-flex!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important}
.ma-tags__chip-x{display:inline-flex!important;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:999px;background:color-mix(in srgb,var(--ma-tag) 28%,#fff);color:var(--ink,#0f172a);font:inherit;font-size:22px;font-weight:700;line-height:1;cursor:pointer}
.ma-tags__search{margin-top:18px}
.ma-tags__submit{margin-top:20px!important}
.ma-tags__suggest{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0;padding:0;list-style:none}
.ma-tags__suggest-item form{margin:0;display:inline-flex}
.ma-tags__suggest-btn{display:inline-flex;align-items:center;min-height:44px;padding:10px 14px;border-radius:999px;border:1.5px dashed color-mix(in srgb,var(--ma-tag,var(--acc)) 55%,#94a3b8);background:#fff;color:var(--ink,#0f172a);font:inherit;font-size:14px;font-weight:800;cursor:pointer}
.ma-tags__suggest[hidden]{display:none!important}
.ma-tags .ma-typeahead{position:relative;overflow:visible}
.ma-tags .ma-typeahead__list{position:static!important;left:auto;right:auto;top:auto;margin:10px 0 0;max-height:min(240px,40vh);box-shadow:none}
</style>
