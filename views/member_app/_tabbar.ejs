<%
  const _hasAppt = typeof appointment !== 'undefined' && appointment;
  // Center FAB = Request a review (share review link). Send referral stays a regular tab.
  const _tabs = _hasAppt
    ? [
        { id: 'home', label: 'Home', href: base, icon: icons.home },
        { id: 'referrals', label: 'Referrals', href: base + '/referrals', icon: icons.referrals },
        { id: 'review', label: 'Request', href: base + '/review?ask=1', icon: icons.review, fab: true },
        { id: 'leads', label: 'Leads', href: appointment.portalLeadsPath || (base + '/leads'), icon: icons.leads },
        { id: 'send', label: 'Send', href: base + '/send', icon: icons.send },
      ]
    : [
        { id: 'home', label: 'Home', href: base, icon: icons.home },
        { id: 'referrals', label: 'Referrals', href: base + '/referrals', icon: icons.referrals },
        { id: 'review', label: 'Request', href: base + '/review?ask=1', icon: icons.review, fab: true },
        { id: 'customers', label: 'Customers', href: base + '/customers', icon: icons.customers },
        { id: 'send', label: 'Send', href: base + '/send', icon: icons.send },
      ];
%>
<nav class="ma-tabbar" aria-label="App sections">
  <div class="ma-tabbar__inner">
    <% _tabs.forEach(function (t) { %>
    <a href="<%= t.href %>" class="ma-tab <%= t.fab ? 'ma-tab--send' : '' %> <%= active === t.id ? 'is-on' : '' %>" <%= active === t.id ? 'aria-current=page' : '' %>>
      <% if (t.fab) { %><span class="ma-tab__fab"><%- t.icon %></span><% } else { %><%- t.icon %><% } %>
      <span><%= t.label %></span>
    </a>
    <% }); %>
  </div>
</nav>
<div class="ma-install" id="maInstall" hidden>
  Add <b><%= brand.appName %></b> to your Home Screen: tap <b>Share</b>, then <b>Add to Home Screen</b>.
  <button type="button" aria-label="Dismiss" data-ma-install-close>&times;</button>
</div>
<script src="/js/member-app.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
