<%
  const _hasAppt = typeof appointment !== 'undefined' && appointment;
  const _isFree = typeof isAppFree !== 'undefined' ? !!isAppFree : (member && member.plan === 'app_free');
  // Review tab always lands on QR / share — not the GHL send form (?ask=1).
  const _reviewHref = base + '/review';
  // Same inline icon+label style for every tab (including Review).
  // Free members: Join replaces Send (upgrade path).
  const _tabs = _hasAppt
    ? [
        { id: 'home', label: 'Home', href: base, icon: icons.home },
        { id: 'customers', label: 'Customers', href: base + '/customers', icon: icons.customers },
        { id: 'review', label: 'Review', href: _reviewHref, icon: icons.review },
        { id: 'leads', label: 'Leads', href: base + '/leads', icon: icons.leads },
        { id: 'referrals', label: 'Referrals', href: base + '/referrals', icon: icons.referrals },
      ]
    : [
        { id: 'home', label: 'Home', href: base, icon: icons.home },
        { id: 'customers', label: 'Customers', href: base + '/customers', icon: icons.customers },
        { id: 'review', label: 'Review', href: _reviewHref, icon: icons.review },
        { id: 'referrals', label: 'Referrals', href: base + '/referrals', icon: icons.referrals },
        _isFree
          ? { id: 'join', label: 'Join', href: base + '/join', icon: icons.enroll }
          : { id: 'send', label: 'Send', href: base + '/send', icon: icons.send },
      ];
  const _appName = (brand && brand.appName) ? brand.appName : 'this app';
%>
<nav class="ma-tabbar" aria-label="App sections">
  <div class="ma-tabbar__inner">
    <% _tabs.forEach(function (t) { %>
    <a href="<%= t.href %>" class="ma-tab <%= active === t.id ? 'is-on' : '' %>" <%= active === t.id ? 'aria-current=page' : '' %>>
      <%- t.icon %>
      <span><%= t.label %></span>
    </a>
    <% }); %>
  </div>
</nav>

<div class="ma-install-modal" id="maInstall" hidden role="dialog" aria-modal="true" aria-labelledby="maInstallTitle">
  <div class="ma-install-sheet">
    <button type="button" class="ma-install-close-x" aria-label="Close" data-ma-install-close>&times;</button>
    <h2 id="maInstallTitle">Save as a phone app</h2>
    <p class="ma-install-lead" data-ma-install-lead>
      Add <b><%= _appName %></b> to your Home Screen for one-tap reviews, customers, and referrals.
    </p>

    <div data-ma-install-panel="browser-ios" hidden>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap the <b>Share</b> button in Safari (square with an arrow).</span></li>
        <li><span class="ma-install-n">2</span><span>Scroll and tap <b>Add to Home Screen</b>.</span></li>
        <li><span class="ma-install-n">3</span><span>Tap <b>Add</b> — open it from your Home Screen next time.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="browser-android" hidden>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap the <b>⋮</b> menu in Chrome.</span></li>
        <li><span class="ma-install-n">2</span><span>Tap <b>Install app</b> or <b>Add to Home screen</b>.</span></li>
        <li><span class="ma-install-n">3</span><span>Tap <b>Install</b> or <b>Add</b>.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="workspace" hidden>
      <p class="ma-install-lead">You’re inside the workspace app. To put <b><%= _appName %></b> on your Home Screen as its own icon:</p>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap <b>Copy link</b> below.</span></li>
        <li><span class="ma-install-n">2</span><span>Open <b>Safari</b> (iPhone) or <b>Chrome</b> (Android) and paste the link.</span></li>
        <li><span class="ma-install-n">3</span><span>Then use <b>Share → Add to Home Screen</b> (iPhone) or <b>⋮ → Install app</b> (Android).</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="installed" hidden>
      <p class="ma-install-lead">This app is already on your Home Screen. You’re all set.</p>
    </div>

    <div class="ma-install-actions">
      <% /* Copy/Share only when stuck inside the workspace shell — Safari/Chrome can Add to Home Screen directly. */ %>
      <button type="button" class="ma-btn" data-ma-install-copy data-ma-install-workspace-only hidden>Copy link</button>
      <button type="button" class="ma-btn ma-btn--soft" data-ma-install-share data-ma-install-workspace-only hidden>Share link</button>
      <button type="button" class="ma-btn" data-ma-install-close data-ma-install-browser-done hidden>Got it</button>
      <button type="button" class="ma-btn ma-btn--ghost" data-ma-install-close>Not now</button>
    </div>
  </div>
</div>
<script src="/js/member-customer-search.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<script src="/js/member-app.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
