<%
  const _isFree = typeof isAppFree !== 'undefined' ? !!isAppFree : (member && (member.plan === 'app_free' || member.plan === 'app_flooring'));
  // Review tab always lands on QR / share — not the GHL send form (?ask=1).
  const _reviewHref = base + '/review';
  // Review keeps the raised round FAB; label font/baseline match every other tab.
  // Free members: Join replaces Send (upgrade path).
  // Leads tab → /referrals (website + agency + network referrals in one place).
  const _tabs = [
    { id: 'home', label: 'Home', href: base, icon: icons.home },
    { id: 'customers', label: 'Customers', href: base + '/customers', icon: icons.customers },
    { id: 'review', label: 'Review', href: _reviewHref, icon: icons.review, fab: true },
    { id: 'referrals', label: 'Leads', href: base + '/referrals', icon: icons.referrals },
    _isFree
      ? { id: 'join', label: 'Join', href: base + '/join', icon: icons.enroll }
      : { id: 'send', label: 'Send', href: base + '/send', icon: icons.send },
  ];
  const _appName = (brand && brand.appName) ? brand.appName : 'this app';
%>
<nav class="ma-tabbar" aria-label="App sections">
  <div class="ma-tabbar__inner">
    <% _tabs.forEach(function (t) { %>
    <a href="<%= t.href %>" class="ma-tab <%= t.fab ? 'ma-tab--fab' : '' %> <%= active === t.id ? 'is-on' : '' %>" <%= active === t.id ? 'aria-current=page' : '' %>>
      <% if (t.fab) { %>
      <span class="ma-tab__slot" aria-hidden="true"></span>
      <span class="ma-tab__fab"><%- t.icon %></span>
      <% } else { %>
      <%- t.icon %>
      <% } %>
      <span class="ma-tab__label"><%= t.label %></span>
    </a>
    <% }); %>
  </div>
</nav>

<div class="ma-install-modal" id="maInstall" hidden role="dialog" aria-modal="true" aria-labelledby="maInstallTitle" data-ma-install-app-name="<%= _appName %>">
  <div class="ma-install-sheet">
    <button type="button" class="ma-install-close-x" aria-label="Close" data-ma-install-close>&times;</button>
    <h2 id="maInstallTitle">Save as a phone app</h2>
    <p class="ma-install-kicker" style="margin:0 0 6px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--acc,#FFDB3A)">Save this app to your phone</p>
    <p class="ma-install-lead" data-ma-install-lead>
      Add <b><%= _appName %></b> to your Home Screen for one-tap reviews, customers, and referrals.
    </p>

    <div data-ma-install-panel="browser-ios" hidden>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap the <b>Share</b> button in Safari (square with an arrow).</span></li>
        <li><span class="ma-install-n">2</span><span>Scroll and tap <b>Add to Home Screen</b>.</span></li>
        <li><span class="ma-install-n">3</span><span>Tap <b>Add</b> — open it from your Home Screen next time.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="browser-android" hidden>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap the <b>⋮</b> menu in Chrome.</span></li>
        <li><span class="ma-install-n">2</span><span>Tap <b>Install app</b> or <b>Add to Home screen</b>.</span></li>
        <li><span class="ma-install-n">3</span><span>Tap <b>Install</b> or <b>Add</b>.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="workspace-ios" hidden>
      <p class="ma-install-lead">You’re inside the workspace app on <b>iPhone</b>. Safari won’t open from here with a normal link — use Share instead:</p>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap <b>Share to Safari</b> below.</span></li>
        <li><span class="ma-install-n">2</span><span>In the share sheet, tap <b>Safari</b> (or <b>Open in Safari</b>).</span></li>
        <li><span class="ma-install-n">3</span><span>In Safari: <b>Share → Add to Home Screen → Add</b>.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="workspace-android" hidden>
      <p class="ma-install-lead">You’re inside the workspace app on <b>Android</b>. Open <b><%= _appName %></b> in Chrome to install it:</p>
      <ol class="ma-install-steps">
        <li><span class="ma-install-n">1</span><span>Tap <b>Open in Chrome</b> below.</span></li>
        <li><span class="ma-install-n">2</span><span>In Chrome, tap the <b>⋮</b> menu.</span></li>
        <li><span class="ma-install-n">3</span><span>Tap <b>Install app</b> or <b>Add to Home screen</b>.</span></li>
      </ol>
    </div>

    <div data-ma-install-panel="installed" hidden>
      <p class="ma-install-lead">This app is already on your Home Screen. You’re all set.</p>
    </div>

    <div class="ma-install-actions">
      <% /* Workspace shell: open Safari/Chrome first; copy/share as backup. */ %>
      <button type="button" class="ma-btn" data-ma-install-open-browser data-ma-install-workspace-only hidden>Share to Safari</button>
      <button type="button" class="ma-btn ma-btn--soft" data-ma-install-copy data-ma-install-workspace-only hidden>Copy link</button>
      <button type="button" class="ma-btn ma-btn--soft" data-ma-install-share data-ma-install-workspace-only hidden>Share link</button>
      <button type="button" class="ma-btn" data-ma-install-close data-ma-install-browser-done hidden>Got it</button>
      <button type="button" class="ma-btn ma-btn--ghost" data-ma-install-close>Not now</button>
    </div>
  </div>
</div>

<%
  const _pushBase = typeof base !== 'undefined' ? base : '';
  const _joinedAt = (typeof member !== 'undefined' && member && member.joinedAt) ? member.joinedAt : '';
%>
<div
  class="ma-install-modal ma-push-nudge-modal"
  id="maPushNudge"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="maPushNudgeTitle"
  data-ma-push-base="<%= _pushBase %>"
  data-ma-push-joined="<%= _joinedAt %>"
  data-ma-push-app="<%= _appName %>"
>
  <div class="ma-install-sheet ma-push-nudge-sheet">
    <button type="button" class="ma-install-close-x" aria-label="Close" data-ma-push-nudge-close>&times;</button>
    <p class="ma-install-kicker" style="margin:0 0 6px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--acc,#FFDB3A)">Don’t miss leads &amp; updates</p>
    <h2 id="maPushNudgeTitle">Turn on phone alerts</h2>
    <p class="ma-install-lead">
      New <b>leads</b>, <b>referrals</b>, and <b>News &amp; updates</b> from your network pop up on this phone — even when the app is closed. Turn alerts on now so you never miss a job.
    </p>
    <ol class="ma-install-steps" data-ma-push-nudge-steps>
      <li><span class="ma-install-n">1</span><span>Tap <b>Turn on alerts</b> below.</span></li>
      <li><span class="ma-install-n">2</span><span>Allow notifications when your phone asks.</span></li>
      <li><span class="ma-install-n">3</span><span>You’re set — leads and network updates wake you up.</span></li>
    </ol>
    <p class="ma-install-lead" data-ma-push-nudge-status hidden></p>
    <div class="ma-install-actions">
      <button type="button" class="ma-btn" data-ma-push-nudge-enable>Turn on alerts</button>
      <button type="button" class="ma-btn ma-btn--ghost" data-ma-push-nudge-close>Not now</button>
    </div>
  </div>
</div>
<script>window.__maVoiceEndpoint = <%- JSON.stringify((typeof base !== 'undefined' && base ? base : '') + '/voice/transcribe') %>;</script>
