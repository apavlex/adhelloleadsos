<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Profile' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Profile' }) %>
    <h1 class="ma-page-title">Profile &amp; settings</h1>
    <p class="ma-page-sub">Your photo, contact info, and app settings.</p>

    <%- include('_flash') %>

    <% const _fv = typeof formValues !== 'undefined' && formValues ? formValues : member; %>
    <% const _initial = (greetingName || member.companyName || '?').trim().charAt(0).toUpperCase(); %>

    <section class="ma-profile-hero" aria-label="Profile photo">
      <div class="ma-avatar ma-avatar--lg" aria-hidden="true">
        <% if (typeof profilePhotoUrl !== 'undefined' && profilePhotoUrl) { %>
        <img src="<%= profilePhotoUrl %>" alt="">
        <% } else { %>
        <%= _initial %>
        <% } %>
      </div>
      <div class="ma-profile-hero__meta">
        <p class="ma-profile-hero__name"><%= member.companyName %></p>
        <p class="ma-profile-hero__sub"><%= member.contactName || 'Add your name' %></p>
      </div>
    </section>

    <section class="ma-card">
      <h2 style="font-size:16px;margin:0 0 6px">Profile photo</h2>
      <p class="ma-hint" style="margin-top:0">Shown in the top bar. The Home Screen app icon uses your business logo from App branding below.</p>
      <form method="post" action="<%= base %>/profile/photo" enctype="multipart/form-data" autocomplete="off" data-ma-loading="Saving photo…">
        <div class="ma-field">
          <label class="ma-label" for="maProfilePhoto">Upload photo</label>
          <input id="maProfilePhoto" name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,image/*" class="ma-input" required>
        </div>
        <button type="submit" class="ma-btn ma-btn--soft ma-btn--block">Save photo</button>
      </form>
      <% if (typeof hasProfilePhoto !== 'undefined' && hasProfilePhoto) { %>
      <form method="post" action="<%= base %>/profile/photo" style="margin-top:8px" data-ma-confirm="Remove your profile photo?">
        <input type="hidden" name="remove" value="1">
        <button type="submit" class="ma-btn ma-btn--ghost ma-btn--block">Remove photo</button>
      </form>
      <% } %>
    </section>

    <% if (typeof canEditWorkspaceBrand !== 'undefined' && canEditWorkspaceBrand && workspaceBrand) { %>
    <section class="ma-card" id="maAppBranding" aria-label="App branding">
      <h2 style="font-size:16px;margin:0 0 6px">App branding</h2>
      <p class="ma-hint" style="margin-top:0">Same as <strong>Workspace → White label</strong>. Logo shows on Home, in the desktop app, and as the icon when you Save as a phone app.</p>
      <% if (workspaceBrand.hasLogo && workspaceBrand.logoUrl) { %>
      <img class="rv-logo" src="<%= workspaceBrand.logoUrl %>" alt="<%= workspaceBrand.appName %> logo" style="margin:8px auto 12px;max-width:96px;max-height:96px;object-fit:cover;border-radius:50%;background:#f1f5f9">
      <% } else if (brand.logoUrl) { %>
      <img class="rv-logo" src="<%= brand.logoUrl %>" alt="<%= brand.appName %> logo" style="margin:8px auto 12px;max-width:96px;max-height:96px;object-fit:cover;border-radius:50%;background:#f1f5f9">
      <% } else { %>
      <div class="rv-initials" aria-hidden="true" style="margin:8px auto 12px"><%= (workspaceBrand.appName || brand.appName || '?').trim().charAt(0).toUpperCase() %></div>
      <% } %>
      <form method="post" action="<%= base %>/profile/branding" enctype="multipart/form-data" autocomplete="off" data-ma-loading="Saving branding…">
        <div class="ma-field">
          <label class="ma-label" for="maWlAppName">App name</label>
          <input id="maWlAppName" name="appName" class="ma-input" value="<%= workspaceBrand.customName || brand.appName || '' %>" maxlength="30" autocapitalize="words" placeholder="<%= brand.appName || 'Your business' %>">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="maWlLogo">Business logo</label>
          <input id="maWlLogo" name="logo" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,image/*" class="ma-input">
        </div>
        <button type="submit" class="ma-btn ma-btn--soft ma-btn--block">Save branding</button>
      </form>
      <% if (workspaceBrand.hasLogo) { %>
      <form method="post" action="<%= base %>/profile/branding" style="margin-top:8px" data-ma-confirm="Remove the Workspace white-label logo?">
        <input type="hidden" name="remove_logo" value="1">
        <input type="hidden" name="appName" value="<%= workspaceBrand.customName || '' %>">
        <button type="submit" class="ma-btn ma-btn--ghost ma-btn--block">Remove logo</button>
      </form>
      <% } %>
    </section>
    <% } %>

    <section class="ma-card">
      <h2 style="font-size:16px;margin:0 0 6px">Your details</h2>
      <form method="post" action="<%= base %>/profile" autocomplete="off">
        <div class="ma-field">
          <label class="ma-label" for="maCompany">Business name</label>
          <input id="maCompany" name="companyName" class="ma-input" value="<%= _fv.companyName || '' %>" required maxlength="160" autocapitalize="words">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="maContact">Your name</label>
          <input id="maContact" name="contactName" class="ma-input" value="<%= _fv.contactName || '' %>" maxlength="120" autocapitalize="words" autocomplete="name">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="maPhone">Phone <span class="ma-label__hint">(saved on your contact card)</span></label>
          <input id="maPhone" name="phone" type="tel" inputmode="tel" class="ma-input<%= (_fv.phone || '').trim() ? '' : ' ma-input--unset' %>" value="<%= _fv.phone || '' %>" maxlength="40" autocomplete="tel" placeholder="Business mobile or main line">
          <% if (!(String(_fv.phone || '').trim())) { %>
          <p class="ma-flash ma-flash--err" style="margin:8px 0 0">Add a phone and tap Save details — without it, customers who save your contact card get email only.</p>
          <% } %>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="maEmail">Email</label>
          <input id="maEmail" name="email" type="email" inputmode="email" class="ma-input" value="<%= _fv.email || '' %>" maxlength="200" autocomplete="email">
        </div>
        <button type="submit" class="ma-btn ma-btn--block">Save details</button>
      </form>
    </section>

    <% if (typeof vcardUrl !== 'undefined' && vcardUrl) { %>
    <section class="ma-card" aria-label="Contact card">
      <h2 style="font-size:16px;margin:0 0 6px">Contact card (vCard)</h2>
      <p class="ma-hint" style="margin-top:0">One link customers can tap to save your business to their phone. Uses your <strong>profile photo / logo</strong>, business name, phone, email, website, and review page. The link stays the same as long as your review page slug does.</p>
      <% if (typeof vcardHasPhone !== 'undefined' && !vcardHasPhone) { %>
      <p class="ma-flash ma-flash--err" style="margin:0 0 10px">No phone on this card yet — save a Phone under Your details above, then preview again.</p>
      <% } %>
      <label class="ma-label" for="maVcardUrl">Your vCard link</label>
      <div class="ma-link-box">
        <code id="maVcardUrl"><%= vcardUrl %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= vcardUrl %>"><%- icons.copy %> Copy</button>
      </div>
      <p class="ma-hint" style="margin-bottom:0">Open to preview: <a href="<%= vcardUrl %>?t=<%= Date.now() %>" rel="noopener"><%= vcardUrl.replace(/^https?:\/\//, '') %></a></p>
    </section>
    <% } %>

    <section class="ma-card" aria-label="Appearance">
      <h2 style="font-size:16px;margin:0 0 6px">Appearance</h2>
      <p class="ma-hint" style="margin-top:0">Light or dark for this device. Workspace → White label light/dark wins again the next time appearance is saved there. Labels under Call / Text / Review / Map follow this.</p>
      <div class="ma-seg ma-seg--3" data-ma-theme-seg role="radiogroup" aria-label="Appearance">
        <button type="button" class="ma-seg__btn" data-ma-theme-set="light" aria-pressed="false">Light</button>
        <button type="button" class="ma-seg__btn" data-ma-theme-set="dark" aria-pressed="false">Dark</button>
        <button type="button" class="ma-seg__btn" data-ma-theme-set="system" aria-pressed="false">System</button>
      </div>
    </section>

    <section class="ma-card" aria-label="Settings">
      <h2 style="font-size:16px;margin:0 0 10px">Settings</h2>
      <div class="ma-settings-list">
        <button type="button" class="ma-settings-row" data-ma-install-open>
          <span class="ma-settings-row__icon"><%- icons.download %></span>
          <span class="ma-settings-row__text">
            <strong>Save as a phone app</strong>
            <span>Add <%= brand.appName %> to your Home Screen</span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </button>
        <a class="ma-settings-row" href="<%= base %>/review/settings">
          <span class="ma-settings-row__icon"><%- icons.settings %></span>
          <span class="ma-settings-row__text">
            <strong>Review settings</strong>
            <span>Review links and share preview image</span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </a>
        <% if (typeof canEditWorkspaceBrand !== 'undefined' && canEditWorkspaceBrand) { %>
        <a class="ma-settings-row" href="#maAppBranding">
          <span class="ma-settings-row__icon"><%- icons.building %></span>
          <span class="ma-settings-row__text">
            <strong>App branding</strong>
            <span>Business logo &amp; name (Workspace white label)</span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </a>
        <% } %>
        <a class="ma-settings-row" href="<%= base %>/customers">
          <span class="ma-settings-row__icon"><%- icons.people %></span>
          <span class="ma-settings-row__text">
            <strong>Customers &amp; CRM sync</strong>
            <span>Import a list or sync via your workspace CRM</span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </a>
        <a class="ma-settings-row" href="<%= base %>/enroll">
          <span class="ma-settings-row__icon"><%- icons.enroll %></span>
          <span class="ma-settings-row__text">
            <strong>Invite a business</strong>
            <span>Recommend someone to join <%= brand.appName %></span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </a>
        <a class="ma-settings-row" href="<%= base %>/review">
          <span class="ma-settings-row__icon"><%- icons.review %></span>
          <span class="ma-settings-row__text">
            <strong>Request a review</strong>
            <span>QR code, share link, and send requests</span>
          </span>
          <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
        </a>
      </div>
    </section>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
