<header class="ma-top">
  <div class="ma-top__brand">
    <% if (typeof topBack !== 'undefined' && topBack) { %>
    <a class="ma-top__back" href="<%= topBack.href %>"><%- icons.chevronLeft %><span><%= topBack.label %></span></a>
    <% } else { %>
    <% if (brand.logoUrl) {
      const _topLogoSrc = (typeof base !== 'undefined' && base && !(typeof preview !== 'undefined' && preview))
        ? (base + '/icon-192.png?v=' + encodeURIComponent(String(brand.logoUrl)))
        : brand.logoUrl;
    %><img class="ma-top__logo" src="<%= _topLogoSrc %>" alt="" width="28" height="28"><% } %>
    <p class="ma-top__title"><%= typeof topTitle !== 'undefined' && topTitle ? topTitle : brand.appName %></p>
    <% } %>
  </div>
  <div class="ma-top__actions">
    <% if (typeof topSettings !== 'undefined' && topSettings && topSettings.href) { %>
    <a class="ma-iconbtn <%= topSettings.on ? 'is-on' : '' %>" href="<%= topSettings.href %>" aria-label="<%= topSettings.label || 'Settings' %>" title="<%= topSettings.label || 'Settings' %>" <%= topSettings.on ? 'aria-current=page' : '' %>><%- icons.settings %></a>
    <% } %>
    <a class="ma-iconbtn" href="<%= base %>/customers/new" aria-label="Add a customer" title="Add a customer"><%- icons.plus %></a>
    <div class="ma-bell" id="maBellRoot" data-base="<%= base %>" data-push="<%= typeof appointment !== 'undefined' && appointment ? '1' : '0' %>">
      <button type="button" class="ma-iconbtn ma-bell__btn" data-ma-bell-open aria-label="Lead notifications" title="Lead notifications" aria-expanded="false" aria-controls="maBellPanel">
        <%- icons.bell %>
        <span class="ma-bell__ping" data-ma-bell-ping hidden></span>
      </button>
      <div class="ma-bell__scrim" data-ma-bell-scrim hidden></div>
      <div class="ma-bell__panel" id="maBellPanel" hidden role="dialog" aria-label="Lead notifications" aria-modal="true">
        <div class="ma-bell__head">
          <h2>Notifications</h2>
          <button type="button" class="ma-bell__close" data-ma-bell-close aria-label="Close">✕</button>
        </div>
        <div class="ma-bell__list" data-ma-bell-list>
          <p class="ma-bell__empty">No new lead alerts</p>
        </div>
        <div class="ma-bell__ghl" data-ma-bell-ghl hidden>
          <label class="ma-bell__ghl-row">
            <span class="ma-bell__ghl-copy">
              <strong>GHL calls &amp; texts</strong>
              <span data-ma-bell-ghl-status>Show missed calls and texts from Lead Connector in this app.</span>
            </span>
            <input type="checkbox" data-ma-bell-ghl-toggle aria-label="Show GHL call and text notifications">
          </label>
        </div>
        <div class="ma-bell__push" data-ma-bell-push>
          <button type="button" class="ma-bell__push-btn" data-ma-bell-push-enable>Turn on phone alerts</button>
          <p class="ma-bell__push-status" data-ma-bell-push-status>New website leads, agency leads, and referrals arrive on this device — even when the app is closed.</p>
          <button type="button" class="ma-bell__push-off" data-ma-bell-push-off hidden>Turn off on this device</button>
        </div>
        <div class="ma-bell__foot">
          <a href="<%= base %>/referrals" data-ma-bell-all>All leads &amp; referrals</a>
        </div>
      </div>
    </div>
    <%
      const _avatarInitial = (greetingName || member.companyName || '?').trim().charAt(0).toUpperCase();
      const _avatarHref = base + '/profile';
      const _avatarOn = typeof active !== 'undefined' && active === 'profile';
      const _avatarPhoto = typeof profilePhotoUrl !== 'undefined' && profilePhotoUrl ? profilePhotoUrl : '';
    %>
    <a
      class="ma-avatar <%= _avatarOn ? 'is-on' : '' %>"
      href="<%= _avatarHref %>"
      aria-label="Profile and settings"
      title="Profile and settings"
      <%= _avatarOn ? 'aria-current=page' : '' %>
    ><% if (_avatarPhoto) { %><img src="<%= _avatarPhoto %>" alt=""><% } else { %><%= _avatarInitial %><% } %></a>
  </div>
</header>
<% if (member.status !== 'active') { %>
<p class="ma-flash ma-flash--err">Your membership is paused. You can still see reviews and referrals; contact the network to reactivate.</p>
<% } %>
