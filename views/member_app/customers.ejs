<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: view === 'pending' ? 'Projects' : 'Customers' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: view === 'pending' ? 'Projects' : 'Customers' }) %>
    <div class="ma-titlebar">
      <h1 class="ma-page-title"><%= view === 'pending' ? 'Projects' : 'Customers' %></h1>
      <a class="ma-iconbtn ma-iconbtn--fill" href="<%= base %>/customers/<%= view === 'calendar' ? 'jobs/new?date=' + selected : (view === 'pending' ? 'jobs/new' : 'new') %>" aria-label="<%= view === 'list' ? 'Add a customer' : 'Add a job' %>"><%- icons.plus %></a>
    </div>
    <p class="ma-page-sub"><%= view === 'list' ? 'Contacts by latest touch — texts, calls, and updates first.' : (view === 'pending' ? 'Open projects to review and move forward.' : 'Your customers, jobs and schedule in one place.') %></p>

    <%- include('_flash') %>

    <% if (view === 'list') { %>
      <details class="ma-fold ma-cust-tools" id="maCustTools">
        <summary>Bring in customers</summary>
        <div class="ma-fold__body">
          <% if (typeof crmSyncLocked !== 'undefined' && crmSyncLocked) { %>
          <p class="ma-hint ma-cust-tools__lead">Upload a list or add customers manually. CRM sync unlocks with a monthly workspace plan.</p>
          <% } else { %>
          <p class="ma-hint ma-cust-tools__lead">Uses your workspace’s CRM connection (Workspace → Integrations). Sync imports homeowners; contacts tagged <strong>Referral partner</strong> or <strong>GB: Referral Network</strong> stay out of this list.</p>
          <% } %>
          <div class="ma-settings-list">
            <% if (typeof crmSyncLocked !== 'undefined' && crmSyncLocked) { %>
            <a class="ma-settings-row is-locked" href="<%= typeof upgradeHref !== 'undefined' && upgradeHref ? upgradeHref : '/signup' %>">
              <span class="ma-settings-row__icon"><%- icons.download %></span>
              <span class="ma-settings-row__text">
                <strong>Sync from CRM</strong>
                <span>Upgrade to activate</span>
              </span>
              <span class="ma-settings-row__upgrade">Upgrade</span>
            </a>
            <% } else { %>
            <form method="post" action="<%= base %>/customers/sync-ghl" class="ma-cust-tools__form">
              <button type="submit" class="ma-settings-row">
                <span class="ma-settings-row__icon"><%- icons.download %></span>
                <span class="ma-settings-row__text">
                  <strong>Sync from CRM</strong>
                  <span>Same CRM location as your workspace</span>
                </span>
                <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
              </button>
            </form>
            <% } %>
            <details class="ma-cust-tools__import">
              <summary class="ma-settings-row">
                <span class="ma-settings-row__icon"><%- icons.people %></span>
                <span class="ma-settings-row__text">
                  <strong>Upload a customer list</strong>
                  <span>CSV or Excel with name, phone, email</span>
                </span>
                <span class="ma-settings-row__chev" aria-hidden="true"><%- icons.chevronRight %></span>
              </summary>
              <form class="ma-cust-tools__body" method="post" action="<%= base %>/customers/import" enctype="multipart/form-data">
                <div class="ma-field" style="margin:0">
                  <label class="ma-label" for="maCustImport">Choose file</label>
                  <input id="maCustImport" name="file" type="file" accept=".csv,.xlsx,.xls,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="ma-input" required>
                </div>
                <p class="ma-hint" style="margin:0">Columns: Name (or First / Last), Phone, Email, Address, Notes.<% if (!(typeof crmSyncLocked !== 'undefined' && crmSyncLocked)) { %> Imports sync to your CRM when connected.<% } %> <a href="<%= base %>/customers/import-template.csv">Download CSV template</a>.</p>
                <button type="submit" class="ma-btn ma-btn--block">Import list</button>
              </form>
            </details>
          </div>
        </div>
      </details>
    <% } %>

    <nav class="ma-seg ma-seg--3" aria-label="Customer views">
      <a href="<%= hrefFor({}) %>" class="<%= view === 'list' ? 'is-on' : '' %>" <%= view === 'list' ? 'aria-current=page' : '' %>><%- icons.list %><span>List</span></a>
      <a href="<%= hrefFor({ view: 'calendar' }) %>" class="<%= view === 'calendar' ? 'is-on' : '' %>" <%= view === 'calendar' ? 'aria-current=page' : '' %>><%- icons.calendar %><span>Calendar</span></a>
      <a href="<%= hrefFor({ view: 'pending' }) %>" class="<%= view === 'pending' ? 'is-on' : '' %>" <%= view === 'pending' ? 'aria-current=page' : '' %>><%- icons.pending %><span>Projects</span></a>
    </nav>

    <% if (view === 'list') { %>
      <% if (customerCount) { %>
      <form class="ma-search" method="get" action="<%= base %>/customers" role="search" data-ma-customer-list-search>
        <%- icons.search %>
        <input class="ma-input" type="search" name="q" value="<%= q %>" placeholder="Search by name or phone…" aria-label="Search customers" autocomplete="off" autocorrect="off" spellcheck="false">
        <% if (typeof showPartners !== 'undefined' && showPartners) { %><input type="hidden" name="partners" value="1"><% } %>
        <% if (typeof showLeads !== 'undefined' && showLeads) { %><input type="hidden" name="leads" value="1"><% } %>
      </form>
      <% if (typeof partnerCount === 'number' && partnerCount > 0) { %>
      <p class="ma-hint ma-cust-partner-filter" style="margin:10px 0 0">
        <% if (showPartners) { %>
          Showing <%= partnerCount %> referral partner<%= partnerCount === 1 ? '' : 's' %> from CRM.
          <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, leads: (typeof showLeads !== 'undefined' && showLeads) ? '1' : undefined }) %>">Hide partners</a>
        <% } else { %>
          <%= hiddenPartnerCount %> referral partner<%= hiddenPartnerCount === 1 ? '' : 's' %> hidden (tagged in CRM).
          <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, partners: '1', leads: (typeof showLeads !== 'undefined' && showLeads) ? '1' : undefined }) %>">Show partners</a>
        <% } %>
      </p>
      <% } %>
      <% if (typeof leadCount === 'number' && leadCount > 0) { %>
      <p class="ma-hint ma-cust-lead-filter" style="margin:10px 0 0">
        <% if (typeof showLeads !== 'undefined' && showLeads) { %>
          Showing <%= leadCount %> lead<%= leadCount === 1 ? '' : 's' %> in this list.
          <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, partners: (typeof showPartners !== 'undefined' && showPartners) ? '1' : undefined, quotes: (typeof showQuotes !== 'undefined' && showQuotes) ? '1' : undefined }) %>">Hide leads</a>
          · <a class="ma-label-link" href="<%= base %>/referrals">Open Leads</a>
        <% } else { %>
          <%= typeof hiddenLeadCount === 'number' ? hiddenLeadCount : leadCount %> lead<%= (typeof hiddenLeadCount === 'number' ? hiddenLeadCount : leadCount) === 1 ? '' : 's' %> in your Leads folder.
          <a class="ma-label-link" href="<%= base %>/referrals">Open Leads</a>
          · <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, partners: (typeof showPartners !== 'undefined' && showPartners) ? '1' : undefined, leads: '1', quotes: (typeof showQuotes !== 'undefined' && showQuotes) ? '1' : undefined }) %>">Show here</a>
        <% } %>
      </p>
      <% } %>
      <% if (typeof quoteCount === 'number' && quoteCount > 0 && typeof isFlooringPartner !== 'undefined' && isFlooringPartner) { %>
      <p class="ma-hint ma-cust-lead-filter" style="margin:10px 0 0">
        <% if (typeof showQuotes !== 'undefined' && showQuotes) { %>
          Showing <%= quoteCount %> quote request<%= quoteCount === 1 ? '' : 's' %> in this list.
          <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, partners: (typeof showPartners !== 'undefined' && showPartners) ? '1' : undefined, leads: (typeof showLeads !== 'undefined' && showLeads) ? '1' : undefined }) %>">Hide quotes</a>
          · <a class="ma-label-link" href="<%= base %>/referrals">Open quote requests</a>
        <% } else { %>
          <%= quoteCount %> quote request<%= quoteCount === 1 ? '' : 's' %> in Leads.
          <a class="ma-label-link" href="<%= base %>/referrals">Open Leads</a>
          · <a class="ma-label-link" href="<%= hrefFor({ q: q || undefined, partners: (typeof showPartners !== 'undefined' && showPartners) ? '1' : undefined, leads: (typeof showLeads !== 'undefined' && showLeads) ? '1' : undefined, quotes: '1' }) %>">Show here</a>
        <% } %>
      </p>
      <% } %>
      <% } %>
      <% if (!rows.length) { %>
      <div class="ma-card ma-empty">
        <%- icons.people %>
        <% if (typeof leadCount === 'number' && leadCount > 0 && !(typeof showLeads !== 'undefined' && showLeads)) { %>
        <p>No customers in this list — <%= leadCount %> lead<%= leadCount === 1 ? '' : 's' %> <%= leadCount === 1 ? 'is' : 'are' %> in Leads. Mark one as customer to move it here.</p>
        <a class="ma-btn ma-btn--block" href="<%= base %>/referrals" style="margin-top:12px;max-width:240px"><%- icons.leads %> Open Leads</a>
        <% } else if (typeof partnerCount === 'number' && partnerCount > 0 && !(typeof showPartners !== 'undefined' && showPartners)) { %>
        <p>No homeowners in this list — <%= partnerCount %> referral partner<%= partnerCount === 1 ? '' : 's' %> <%= partnerCount === 1 ? 'is' : 'are' %> hidden.</p>
        <a class="ma-btn ma-btn--block" href="<%= hrefFor({ partners: '1' }) %>" style="margin-top:12px;max-width:240px">Show partners</a>
        <% } else { %>
        <p>No customers yet.<% if (typeof crmSyncLocked !== 'undefined' && crmSyncLocked) { %> Upload a list or add one with the + button.<% } else { %> Sync from CRM above, upload a list, or add one with the + button.<% } %></p>
        <a class="ma-btn ma-btn--block" href="<%= base %>/customers/new" style="margin-top:12px;max-width:220px"><%- icons.plus %> Add customer</a>
        <% } %>
      </div>
      <% } else { %>
      <div class="ma-card ma-empty" data-ma-customer-list-empty hidden>
        <%- icons.people %>
        <p data-ma-customer-list-empty-msg>No customers match.</p>
      </div>
      <div class="ma-list" data-ma-customer-list>
        <% rows.forEach(function (c) { %>
        <a
          class="ma-row"
          href="<%= c.href %>"
          data-ma-customer-row
          data-id="<%= c.id %>"
          data-name="<%= c.name || '' %>"
          data-phone="<%= c.phone || '' %>"
          data-email="<%= c.email || '' %>"
          data-address="<%= c.address || '' %>"
          data-updated="<%= c.lastTouchAt || c.updatedAt || c.createdAt || '' %>"
          data-touch-ms="<%= c.lastTouchMs || 0 %>"
          <% if (c.isPartner) { %>data-partner="1"<% } %>
        >
          <span class="ma-row__avatar"><%= c.name.charAt(0).toUpperCase() %></span>
          <span class="ma-row__body">
            <span class="ma-row__title"><%= c.name %></span>
            <span class="ma-row__meta"><%= c.top ? [c.top.title, c.top.whenLabel].filter(Boolean).join(' · ') : (c.phone || c.email || c.address || 'No jobs yet') %><% if (c.isPartner) { %> · Partner<% } %></span>
          </span>
          <span class="ma-row__end">
            <% if (c.isLead) { %><span class="ma-pill ma-pill--accepted">Lead</span><% } %>
            <% if (c.isQuoteRequest) { %><span class="ma-pill ma-pill--job-estimate">Quote</span><% } %>
            <% if (c.isPartner) { %><span class="ma-pill">Partner</span><% } %>
            <% if (c.top) { %><span class="ma-pill ma-pill--job-<%= c.top.status %>"><%= c.top.statusLabel %></span><% } %>
            <% if (c.openCount > 1) { %><small><%= c.openCount %> open</small><% } %>
          </span>
        </a>
        <% }); %>
      </div>
      <% } %>

    <% } else if (view === 'calendar') { %>
      <section class="ma-card ma-cal" aria-label="<%= grid.label %>">
        <div class="ma-cal__head">
          <a class="ma-iconbtn" href="<%= hrefFor({ view: 'calendar', m: grid.prev }) %>" aria-label="Previous month"><%- icons.chevronLeft %></a>
          <h2><%= grid.label %></h2>
          <a class="ma-iconbtn" href="<%= hrefFor({ view: 'calendar', m: grid.next }) %>" aria-label="Next month"><%- icons.chevronRight %></a>
        </div>
        <div class="ma-cal__grid" role="grid">
          <% ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(function (d) { %><span class="ma-cal__dow" aria-hidden="true"><%= d %></span><% }); %>
          <% grid.weeks.forEach(function (week) { week.forEach(function (d) { %>
          <a class="ma-cal__day<%= d.inMonth ? '' : ' is-out' %><%= d.isToday ? ' is-today' : '' %><%= d.isSelected ? ' is-sel' : '' %>"
             href="<%= hrefFor({ view: 'calendar', m: d.date.slice(0, 7), d: d.date }) %>"
             aria-label="<%= d.date %><%= d.count ? ', ' + d.count + ' job' + (d.count === 1 ? '' : 's') : '' %>" <%= d.isSelected ? 'aria-current=date' : '' %>>
            <span><%= d.day %></span>
            <% if (d.count) { %><i class="ma-cal__dots<%= d.open ? '' : ' is-done' %>"><% for (var k = 0; k < Math.min(d.count, 3); k++) { %><b></b><% } %></i><% } %>
          </a>
          <% }); }); %>
        </div>
      </section>

      <section class="ma-section">
        <div class="ma-section__head">
          <h2><%= selectedLabel %></h2>
          <a href="<%= base %>/customers/jobs/new?date=<%= selected %>">+ Schedule</a>
        </div>
        <% if (dayJobs.length) { %>
        <div class="ma-list">
          <% dayJobs.forEach(function (j) { %><%- include('_job_row', { j: j, hideWhen: true }) %><% }); %>
        </div>
        <% } else { %>
        <a class="ma-card ma-empty ma-empty--tap" href="<%= base %>/customers/jobs/new?date=<%= selected %>"><%- icons.calendar %><p>Nothing scheduled. Tap to schedule work on this day.</p></a>
        <% } %>
      </section>

    <% } else { %>
      <% if (pendingRefs.length) { %>
      <section class="ma-section ma-section--first" id="referrals">
        <div class="ma-section__head">
          <h2>Referrals to work</h2>
          <a href="<%= base %>/referrals">Referrals</a>
        </div>
        <div class="ma-list">
          <% pendingRefs.forEach(function (r) { %>
          <div class="ma-row ma-row--static">
            <span class="ma-row__avatar ma-row__avatar--soft"><%- icons.referrals %></span>
            <span class="ma-row__body">
              <span class="ma-row__title"><%= (r.customer && r.customer.name) || 'Customer' %></span>
              <span class="ma-row__meta"><%= r.trade %> · from <%= r.from %> · <%= r.statusLabel %></span>
            </span>
            <span class="ma-row__end">
              <% if (r.jobHref) { %>
              <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= r.jobHref %>">View job</a>
              <% } else { %>
              <form method="post" action="<%= base %>/customers/from-referral/<%= r.id %>">
                <input type="hidden" name="back" value="<%= base %>/customers?view=pending">
                <button type="submit" class="ma-btn ma-btn--sm"><%= r.status === 'sent' ? 'Accept + add' : 'Add job' %></button>
              </form>
              <% } %>
            </span>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (!groups.length) { %>
      <div class="ma-card ma-empty" style="margin-top:<%= pendingRefs.length ? '22px' : '0' %>">
        <%- icons.completed %>
        <p>No open jobs. Everything's wrapped up.</p>
        <a class="ma-btn ma-btn--sm" href="<%= base %>/customers/jobs/new" style="margin-top:8px"><%- icons.plus %> Add a job</a>
      </div>
      <% } %>
      <% groups.forEach(function (g, gi) { %>
      <section class="ma-section<%= gi === 0 && !pendingRefs.length ? ' ma-section--first' : '' %>">
        <div class="ma-section__head"><h2><%= g.label %> <span class="ma-count"><%= g.jobs.length %></span></h2></div>
        <div class="ma-list">
          <% g.jobs.forEach(function (j) { %>
          <div class="ma-row ma-row--split">
            <%- include('_job_row', { j: j, hideStatus: !!j.next, wrapTitle: true }) %>
            <% if (j.next) { %>
            <form method="post" action="<%= base %>/customers/jobs/<%= j.id %>/status" class="ma-row__quick" data-ma-status-advance>
              <input type="hidden" name="status" value="<%= j.next %>">
              <input type="hidden" name="back" value="<%= base %>/customers?view=pending">
              <button type="submit" class="ma-btn ma-btn--soft ma-btn--block" aria-label="Move <%= j.customerName %> to <%= j.nextLabel %>">Mark <%= j.nextLabel.toLowerCase() %> <%- icons.chevronRight %></button>
            </form>
            <% } %>
          </div>
          <% }); %>
        </div>
      </section>
      <% }); %>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
