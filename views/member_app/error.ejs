<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Something went wrong' }) %>
</head>
<body>
  <main class="ma-shell ma-shell--plain">
    <div class="ma-card ma-empty" style="margin-top:18vh;text-align:center">
      <h1 class="ma-page-title" style="margin-top:4px">Something went wrong</h1>
      <p><%= typeof message !== 'undefined' && message ? message : 'Please try again.' %></p>
      <a class="ma-btn" href="<%= typeof base !== 'undefined' && base ? base : '/' %>" style="margin-top:12px">Back to Reviews app</a>
    </div>
  </main>
</body>
</html>
