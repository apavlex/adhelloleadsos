<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: job ? job.title : 'New job' }) %>
</head>
<body>
  <main class="ma-shell">
    <%
      const fv = formValues || {};
      const back = job && customer
        ? { href: base + '/customers/c/' + customer.id, label: customer.name }
        : (fv.date ? { href: base + '/customers?view=calendar&m=' + fv.date.slice(0, 7) + '&d=' + fv.date, label: 'Calendar' } : { href: base + '/customers', label: 'Customers' });
      const selectedCustomer = String(fv.customerId || (customers.length ? '' : 'new'));
    %>
    <%- include('_top', { topBack: back }) %>

    <% if (job) { %>
    <div class="ma-titlebar">
      <h1 class="ma-page-title"><%= job.title %></h1>
      <span class="ma-pill ma-pill--job-<%= job.status %>" data-ma-job-status-pill><%= job.statusLabel %></span>
    </div>
    <p class="ma-page-sub"><%= [job.customerName, job.whenLabel, job.durationLabel, job.valueLabel].filter(Boolean).join(' · ') %></p>
    <% } else { %>
    <h1 class="ma-page-title"><%= fv.date ? 'Schedule work' : 'New job' %></h1>
    <p class="ma-page-sub">Track it from estimate to done. Add a date to put it on your calendar.</p>
    <% } %>

    <%- include('_flash') %>

    <% if (job) { %>
    <form method="post" action="<%= base %>/customers/jobs/<%= job.id %>/status" class="ma-steps" aria-label="Job status" data-ma-status-steps>
      <% statuses.forEach(function (s) { %>
      <button type="submit" name="status" value="<%= s.value %>" class="ma-step<%= s.value === job.status ? ' is-on' : '' %> ma-step--<%= s.value %>" <%= s.value === job.status ? 'aria-pressed=true' : '' %>><%= s.label %></button>
      <% }); %>
    </form>
    <% if (job.sharedFromMemberId) { %>
    <p class="ma-hint" style="margin:10px 0 0">Shared onto your calendar by a teammate. Your other jobs stay private to you.</p>
    <% } %>
    <% } %>

    <section class="ma-section">
      <form method="post" action="<%= base %>/customers/jobs/<%= job ? job.id : 'new' %>" class="ma-card" autocomplete="off">
        <div class="ma-field">
          <label class="ma-label" for="jbCustomer">Customer</label>
          <select id="jbCustomer" name="customerId" class="ma-select" required data-ma-newcust>
            <% if (!job) { %><option value="" <%= selectedCustomer ? '' : 'selected' %> disabled>Pick a customer</option><% } %>
            <% customers.forEach(function (c) { %><option value="<%= c.id %>" <%= selectedCustomer === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
            <% if (!job) { %><option value="new" <%= selectedCustomer === 'new' ? 'selected' : '' %>>+ New customer</option><% } %>
          </select>
        </div>
        <% if (!job) { %>
        <div class="ma-grid2 ma-newcust" id="maNewCustomer" <%= selectedCustomer === 'new' ? '' : 'hidden' %>>
          <div class="ma-field">
            <label class="ma-label" for="jbNewName">Customer name</label>
            <input id="jbNewName" name="newCustomerName" class="ma-input" maxlength="120" value="<%= fv.newCustomerName || '' %>" autocapitalize="words">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="jbNewPhone">Phone</label>
            <input id="jbNewPhone" name="newCustomerPhone" type="tel" inputmode="tel" maxlength="40" class="ma-input" value="<%= fv.newCustomerPhone || '' %>">
          </div>
        </div>
        <% } %>
        <div class="ma-field">
          <label class="ma-label" for="jbTitle">Job</label>
          <input id="jbTitle" name="title" class="ma-input" maxlength="120" value="<%= fv.title || '' %>" placeholder="e.g. Kitchen floor install" required>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="jbStatus">Status</label>
            <select id="jbStatus" name="status" class="ma-select">
              <% statuses.forEach(function (s) { %><option value="<%= s.value %>" <%= (fv.status || 'lead') === s.value ? 'selected' : '' %>><%= s.label %></option><% }); %>
            </select>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="jbValue">Value $</label>
            <input id="jbValue" name="value" class="ma-input" inputmode="decimal" maxlength="14" value="<%= fv.value ? fv.value : '' %>" placeholder="0">
          </div>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="jbDate">Date</label>
            <input id="jbDate" name="date" type="date" class="ma-input" value="<%= fv.date || '' %>" min="2000-01-01" max="2100-12-31">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="jbTime">Start time</label>
            <input id="jbTime" name="time" type="time" class="ma-input" value="<%= fv.time || '' %>" step="900">
          </div>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="jbDuration">Duration</label>
          <select id="jbDuration" name="durationMins" class="ma-select">
            <option value="">Not set</option>
            <% durations.forEach(function (d) { %><option value="<%= d.value %>" <%= Number(fv.durationMins) === d.value ? 'selected' : '' %>><%= d.label %></option><% }); %>
          </select>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="jbNotes">Notes</label>
          <textarea id="jbNotes" name="notes" class="ma-textarea" maxlength="2000" placeholder="Scope, materials, access, what you found on site…"><%= fv.notes || '' %></textarea>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="jbRemindOwner">Remind me</label>
            <select id="jbRemindOwner" name="remindOwnerBeforeMins" class="ma-select">
              <% (remindOptions || []).forEach(function (o) { %><option value="<%= o.value %>" <%= Number(fv.remindOwnerBeforeMins || 0) === o.value ? 'selected' : '' %>><%= o.label %></option><% }); %>
            </select>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="jbRemindCustomer">Remind customer</label>
            <select id="jbRemindCustomer" name="remindCustomerBeforeMins" class="ma-select">
              <% (remindOptions || []).forEach(function (o) { %><option value="<%= o.value %>" <%= Number(fv.remindCustomerBeforeMins || 0) === o.value ? 'selected' : '' %>><%= o.label %></option><% }); %>
            </select>
          </div>
        </div>
        <p class="ma-hint">Texts go through GHL CRM before the visit. Needs a date<%= fv.time ? '' : ' (and ideally a start time)' %>.</p>
        <button type="submit" class="ma-btn ma-btn--block"><%- icons.completed %> <%= job ? 'Save job' : (fv.date ? 'Schedule job' : 'Add job') %></button>
      </form>
    </section>

    <% if (job) { %>
    <%
      const _mates = typeof teammates !== 'undefined' && Array.isArray(teammates) ? teammates : [];
      const _shared = typeof sharedWithLabels !== 'undefined' && Array.isArray(sharedWithLabels) ? sharedWithLabels : [];
    %>
    <% if (!job.sharedFromMemberId) { %>
    <section class="ma-card" id="maJobShare" aria-label="Share contact">
      <h2 style="font-size:16px;margin:0 0 4px">Share contact &amp; projects</h2>
      <p class="ma-hint" style="margin:0 0 12px">Shares this contact <strong>and all their projects</strong> — your books stay separate. Teammates get a link; outsiders join on the spot.</p>
      <% if (_shared.length) { %>
      <p class="ma-hint" style="margin:0 0 10px">Already shared with: <strong><%= _shared.map(function (s) { return s.label; }).join(', ') %></strong></p>
      <% } %>
      <% if (typeof inviteUrl !== 'undefined' && inviteUrl) { %>
      <p class="ma-hint" style="margin:0 0 12px;overflow-wrap:anywhere">Invite link: <a href="<%= inviteUrl %>"><%= inviteUrl %></a></p>
      <% } %>
      <% if (_mates.length) { %>
      <form method="post" action="<%= base %>/customers/jobs/<%= job.id %>/share" autocomplete="off" data-ma-loading="Sharing…" data-ma-share-mate-form>
        <%- include('_share_mate_pick', { mates: _mates, idPrefix: 'jb' }) %>
        <button type="submit" class="ma-btn ma-btn--block ma-btn--soft" data-ma-share-submit disabled><%- icons.send %> Share with teammate</button>
      </form>
      <% } %>
      <%
        const _jobInviteOpen = !_mates.length || !!(typeof inviteUrl !== 'undefined' && inviteUrl);
      %>
      <details class="ma-fold ma-fold--inset" id="maJobShareInvite"<%= _jobInviteOpen ? ' open' : '' %>>
        <summary>Invite someone new</summary>
        <div class="ma-fold__body">
          <p class="ma-hint" style="margin:0 0 12px">Text or email a join link — they get this contact and projects when they open it.</p>
          <form method="post" action="<%= base %>/customers/jobs/<%= job.id %>/share" class="ma-card--flush" autocomplete="off" data-ma-loading="Sending invite…">
            <div class="ma-field">
              <label class="ma-label" for="jbInviteName">Their name <span style="font-weight:600;text-transform:none;letter-spacing:0;color:var(--muted)">optional</span></label>
              <input id="jbInviteName" name="inviteName" class="ma-input" maxlength="120" autocomplete="name">
            </div>
            <div class="ma-field">
              <label class="ma-label" for="jbInviteCompany">Their business <span style="font-weight:600;text-transform:none;letter-spacing:0;color:var(--muted)">optional</span></label>
              <input id="jbInviteCompany" name="inviteCompany" class="ma-input" maxlength="160" autocomplete="organization">
            </div>
            <div class="ma-grid2">
              <div class="ma-field">
                <label class="ma-label" for="jbInvitePhone">Mobile</label>
                <input id="jbInvitePhone" name="invitePhone" type="tel" inputmode="tel" class="ma-input" maxlength="40" autocomplete="tel" placeholder="Text the join link">
              </div>
              <div class="ma-field">
                <label class="ma-label" for="jbInviteEmail">Email</label>
                <input id="jbInviteEmail" name="inviteEmail" type="email" inputmode="email" class="ma-input" maxlength="200" autocomplete="email">
              </div>
            </div>
            <button type="submit" class="ma-btn ma-btn--block"><%- icons.send %> Invite outside network</button>
          </form>
        </div>
      </details>
    </section>
    <% } %>

    <section class="ma-section" id="maJobPhotos">
      <div class="ma-section__head">
        <h2>Job photos</h2>
        <span class="ma-count"><%= (job.photos || []).length %>/<%= maxJobPhotos || 12 %></span>
      </div>
      <% if (job.photos && job.photos.length) { %>
      <div class="ma-photos" data-ma-lr-gallery>
        <% job.photos.forEach(function (p, pi) { %>
        <figure class="ma-photos__item" data-ma-photo-item>
          <a href="<%= p.href %>" class="ma-photos__thumb" data-ma-lr-open data-ma-lr-index="<%= pi %>" data-ma-lr-src="<%= p.href %>" data-ma-lr-caption="<%= String(p.caption || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>" aria-label="View photo<%= p.caption ? ': ' + String(p.caption).replace(/"/g, '') : '' %>"><img src="<%= p.href %>" alt="<%= p.caption || 'Job photo' %>" loading="lazy"></a>
          <figcaption data-ma-photo-caption><%= p.caption || 'Add a note' %></figcaption>
          <button
            type="button"
            class="ma-photos__note<%= p.caption ? ' has-note' : '' %>"
            data-ma-photo-note-open
            data-action="<%= base %>/customers/jobs/<%= job.id %>/photos/<%= p.id %>/caption"
            data-return="<%= base %>/customers/jobs/<%= job.id %>"
            data-caption="<%= String(p.caption || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/\r?\n/g, '&#10;') %>"
            aria-label="<%= p.caption ? 'Edit photo note' : 'Add photo note' %>"
          ><%- icons.note %></button>
          <form method="post" action="<%= base %>/customers/jobs/<%= job.id %>/photos/<%= p.id %>/delete" data-ma-confirm="Remove this photo?">
            <button type="submit" class="ma-photos__del" aria-label="Remove photo">×</button>
          </form>
        </figure>
        <% }); %>
      </div>
      <% } else { %>
      <p class="ma-hint" style="margin:0 0 12px">Document the job site with pictures — before, during, or after.</p>
      <% } %>
      <% if ((job.photos || []).length < (maxJobPhotos || 12)) { %>
      <%- include('_photo_capture', {
        formId: 'jbPhoto',
        action: base + '/customers/jobs/' + job.id + '/photos',
        returnTo: base + '/customers/jobs/' + job.id,
        hint: '',
        open: false,
      }) %>
      <% } %>
      <%- include('_photo_note_sheet') %>
      <%- include('_photo_viewer') %>
    </section>

    <form method="post" action="<%= base %>/customers/jobs/<%= job.id %>/delete" class="ma-section" data-ma-confirm="Delete this job?">
      <button type="submit" class="ma-btn ma-btn--danger ma-btn--block">Delete job</button>
    </form>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
