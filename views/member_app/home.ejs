<!DOCTYPE html>
<html lang="en"<%- typeof preview !== 'undefined' && preview ? ' class="ma-preview"' : '' %>>
<head>
  <%- include('_head', { pageTitle: '' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Home' }) %>

    <% const _appt = typeof appointment !== 'undefined' && appointment ? appointment : null; %>
    <% const _upcoming = typeof upcoming !== 'undefined' ? upcoming : []; %>
    <% const _overview = typeof overview !== 'undefined' && overview ? overview : null; %>
    <% const _sources = _overview && Array.isArray(_overview.sources) ? _overview.sources : []; %>
    <% const _attention = _overview && Array.isArray(_overview.attention) ? _overview.attention : []; %>
    <% const _needYou = _overview ? (Number(_overview.needYou) || 0) : 0; %>
    <% const _reviewViews = typeof reviewViews !== 'undefined' ? reviewViews : 0; %>
    <% const _customerCount = typeof customerCount !== 'undefined' ? customerCount : 0; %>
    <% const _openJobs = typeof openJobCount !== 'undefined' ? openJobCount : 0; %>
    <% const _leadsHref = _overview && _overview.leadsHref ? _overview.leadsHref : (base + '/referrals'); %>

    <section class="ma-hello">
      <h1>Hi, <%= greetingName %></h1>
      <% if (_appt) { %>
      <p>Ask for <em>reviews</em>, manage jobs, then work your leads.</p>
      <% } else { %>
      <p><%
        const words = brand.tagline.split(' ');
        const accentCount = words.length >= 5 ? 3 : (words.length > 2 ? 2 : 0);
        const tail = accentCount ? words.slice(-accentCount).join(' ') : '';
        const head = tail ? words.slice(0, -accentCount).join(' ') : brand.tagline;
      %><%= head %><% if (tail) { %> <em><%= tail %></em><% } %></p>
      <% } %>
    </section>

    <%- include('_flash') %>

    <section class="ma-hero<%= _appt ? ' ma-hero--dash' : '' %>" aria-label="<%= brand.appName %>">
      <% if (brand.heroUrl) { %><img class="ma-hero__img" src="<%= brand.heroUrl %>" alt=""><% } %>
      <% if (!(typeof preview !== 'undefined' && preview)) { %>
      <form class="ma-hero__upload" method="post" action="<%= base %>/brand/hero" enctype="multipart/form-data" autocomplete="off">
        <label class="ma-hero__upload-btn" title="Upload banner image" aria-label="Upload banner image">
          <input type="file" name="hero" accept="image/jpeg,image/png,image/webp,image/gif" required onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
          <%- icons.camera %>
        </label>
      </form>
      <% } %>
      <div class="ma-hero__card">
        <div class="ma-hero__row">
          <span class="ma-hero__badge"><% if (brand.logoUrl) { %><img src="<%= brand.logoUrl %>" alt=""><% } else { %><%- icons.building %><% } %></span>
          <div>
            <p class="ma-hero__name"><%= brand.heroName || brand.appName %></p>
            <p class="ma-hero__sub"><%= _appt ? 'Reviews · jobs · leads' : brand.subtitle %></p>
          </div>
        </div>
        <% if (_appt || _needYou) { %>
        <p class="ma-hero__stat"><%= _needYou %><small>need you</small></p>
        <p class="ma-hero__label">
          <%= (_overview && _overview.websiteCount) || 0 %> website · <%= (_overview && _overview.agencyCount) || 0 %> agency · <%= (_overview && _overview.referralCount) || 0 %> referrals
          <% if (wonValue) { %> · <%= wonValue %> won<% } %>
        </p>
        <% } else if (brand.statValueLabel) { %>
        <p class="ma-hero__stat"><%= brand.statValueLabel %><% if (brand.statSuffix) { %><small><%= brand.statSuffix %></small><% } %></p>
        <% if (brand.statLabel) { %><p class="ma-hero__label"><%= brand.statLabel %></p><% } %>
        <% } else { %>
        <p class="ma-hero__stat"><%= _reviewViews %><small>review page visits</small></p>
        <% if (_customerCount || _openJobs) { %><p class="ma-hero__label"><%= _customerCount %> customers · <%= _openJobs %> open jobs</p><% } %>
        <% } %>
      </div>
    </section>

    <% if (_sources.length) { %>
    <section class="ma-sources" aria-label="Lead sources">
      <% _sources.forEach(function (s) { %>
      <a class="ma-source<%= s.count ? ' ma-source--hot' : '' %>" href="<%= s.href %>">
        <span class="ma-source__count"><%= s.count %></span>
        <span class="ma-source__label"><%= s.label %></span>
        <span class="ma-source__hint"><%= s.hint %></span>
      </a>
      <% }); %>
    </section>
    <% } %>

    <section class="ma-tiles<%= _appt ? ' ma-tiles--4' : '' %>" aria-label="Reviews, customers, and network">
      <% const _reviewHref = base + '/review'; %>
      <% if (_appt) { %>
      <a class="ma-tile" href="<%= _reviewHref %>">
        <span class="ma-tile__icon"><%- icons.review %></span>
        <p class="ma-tile__value"><%= _reviewViews %></p>
        <p class="ma-tile__label">Review visits</p>
      </a>
      <a class="ma-tile" href="<%= base %>/customers">
        <span class="ma-tile__icon"><%- icons.customers %></span>
        <p class="ma-tile__value"><%= _customerCount %></p>
        <p class="ma-tile__label">Customers</p>
      </a>
      <a class="ma-tile" href="<%= _appt.portalPath %>">
        <span class="ma-tile__icon"><%- icons.calendar %></span>
        <p class="ma-tile__value"><%= _appt.tracker.counts.remaining %></p>
        <p class="ma-tile__label">Appts left</p>
      </a>
      <a class="ma-tile" href="<%= _appt.portalPackagesPath %>">
        <span class="ma-tile__icon"><%- icons.packages %></span>
        <p class="ma-tile__value"><%= _appt.leadCredits.remaining %></p>
        <p class="ma-tile__label">Lead credits</p>
      </a>
      <% } else { %>
      <% tiles.forEach(function (t) { %>
      <a class="ma-tile" href="<%= t.href %>">
        <span class="ma-tile__icon"><%- icons[t.icon || (t.key === 'sent' ? 'send' : t.key)] || icons.review %></span>
        <p class="ma-tile__value"><%= t.value %></p>
        <p class="ma-tile__label"><%= t.label %></p>
      </a>
      <% }); %>
      <% } %>
    </section>

    <section class="ma-section" style="margin-top:14px">
      <div class="ma-dash-actions">
        <a class="ma-btn" href="<%= _reviewHref %>"><%- icons.review %> Request review</a>
        <a class="ma-btn ma-btn--soft" href="<%= base %>/customers/new"><%- icons.customers %> Add customer</a>
      </div>
    </section>

    <% if (_attention.length) { %>
    <section class="ma-section">
      <div class="ma-section__head">
        <h2>Needs attention</h2>
        <a href="<%= _leadsHref %>">Leads</a>
      </div>
      <% _attention.forEach(function (item) { %>
      <a class="ma-card" style="display:block;text-decoration:none" href="<%= item.href %>">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= item.title %></p>
            <p class="ma-card__meta"><%= item.body %></p>
          </div>
          <span class="ma-pill <%= item.pillClass || 'ma-pill--sent' %>"><%= item.pill || 'New' %></span>
        </div>
      </a>
      <% }); %>
    </section>
    <% } %>

    <% if (_upcoming.length) { %>
    <section class="ma-section">
      <div class="ma-section__head">
        <h2>Up next</h2>
        <a href="<%= base %>/customers?view=calendar">Schedule</a>
      </div>
      <div class="ma-list">
        <% _upcoming.forEach(function (j) { %>
        <%- include('_job_row', { j: j }) %>
        <% }); %>
      </div>
    </section>
    <% } %>

    <section class="ma-section">
      <div class="ma-section__head">
        <h2>Network</h2>
      </div>
      <%- include('_lead_request_callout', { leadRequest: typeof leadRequest !== 'undefined' ? leadRequest : null, back: 'home', base: base, icons: icons }) %>
      <div class="ma-dash-actions">
        <a class="ma-btn ma-btn--soft" href="<%= _leadsHref %>"><%- icons.leads %> Leads</a>
        <a class="ma-btn ma-btn--soft" href="<%= base %>/send"><%- icons.send %> Send referral</a>
      </div>
    </section>
  </main>
  <%- include('_tabbar') %>
  <% if (typeof preview !== 'undefined' && preview) { %><template id="maBadgeIcon"><%- icons.building %></template><% } %>
</body>
</html>
