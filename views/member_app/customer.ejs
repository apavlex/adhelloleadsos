<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: customer ? customer.name : 'New customer' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topBack: { href: base + '/customers', label: 'Customers' } }) %>
    <% const fv = formValues || {}; %>
    <% if (customer) { %>
    <div class="ma-titlebar">
      <h1 class="ma-page-title"><%= customer.name %></h1>
      <% if (customer.referralId) { %><span class="ma-pill ma-pill--sent">From referral</span><% } %>
    </div>
    <% const tel = String(customer.phone || '').replace(/[^0-9+]/g, ''); %>
    <div class="ma-quick">
      <a class="ma-quick__btn<%= tel ? '' : ' is-off' %>" <%- tel ? 'href="tel:' + tel + '"' : 'aria-disabled="true"' %>><%- icons.phone %><span>Call</span></a>
      <a class="ma-quick__btn<%= tel ? '' : ' is-off' %>" <%- tel ? 'href="sms:' + tel + '"' : 'aria-disabled="true"' %>><%- icons.send %><span>Text</span></a>
      <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/request-review" class="ma-quick__form">
        <button type="submit" class="ma-quick__btn<%= (customer.phone || customer.email) ? '' : ' is-off' %>" <%= (customer.phone || customer.email) ? '' : 'disabled' %>><%- icons.review %><span>Review</span></button>
      </form>
      <a class="ma-quick__btn<%= customer.address ? '' : ' is-off' %>" <%- customer.address ? 'href="https://maps.apple.com/?q=' + encodeURIComponent(customer.address) + '" target="_blank" rel="noopener"' : 'aria-disabled="true"' %>><%- icons.mapPin %><span>Map</span></a>
    </div>
    <% if (typeof reviewAskStatus !== 'undefined' && reviewAskStatus) { %>
    <div class="ma-askstatus ma-askstatus--<%= reviewAskStatus.status %>" role="status">
      <%- icons.review %>
      <div>
        <strong><%= reviewAskStatus.label %></strong>
        <% if (reviewAskStatus.detail) { %><span><%= reviewAskStatus.detail %></span><% } %>
      </div>
    </div>
    <% } else { %>
    <p class="ma-hint" style="margin:8px 0 0">Review texts/emails go through your workspace’s GHL CRM connection with your review link. We’ll track opens and nudge once if they don’t click.</p>
    <% } %>
    <% } else { %>
    <h1 class="ma-page-title">New customer</h1>
    <p class="ma-page-sub">Add their details, then schedule a job for them.</p>
    <% } %>

    <%- include('_flash') %>

    <% if (customer) { %>
    <%
      const sitePhotos = [];
      (jobs || []).forEach(function (j) {
        (j.photos || []).forEach(function (p) {
          sitePhotos.push({
            id: p.id,
            href: p.href,
            caption: p.caption || '',
            displayCaption: p.caption || j.title,
            jobId: j.id,
            jobHref: j.href,
            jobTitle: j.title,
            noteAction: base + '/customers/jobs/' + j.id + '/photos/' + p.id + '/caption',
          });
        });
      });
      const openJob = (jobs || []).find(function (j) { return j.status !== 'completed' && j.status !== 'cancelled'; }) || (jobs || [])[0];
    %>
    <section class="ma-section">
      <div class="ma-section__head">
        <h2>Jobs</h2>
        <a href="<%= base %>/customers/jobs/new?customer=<%= customer.id %>">+ Add job</a>
      </div>
      <% if (jobs.length) { %>
      <div class="ma-list">
        <% jobs.forEach(function (j) { %><%- include('_job_row', { j: j, titleIsJob: true }) %><% }); %>
      </div>
      <% } else { %>
      <a class="ma-card ma-empty ma-empty--tap" href="<%= base %>/customers/jobs/new?customer=<%= customer.id %>"><%- icons.customers %><p>No jobs yet. Tap to add an estimate or schedule work.</p></a>
      <% } %>
    </section>

    <section class="ma-section" id="maCustomerPhotos">
      <div class="ma-section__head">
        <h2>Photos &amp; notes</h2>
        <% if (openJob) { %><a href="<%= openJob.href %>#maJobPhotos">Job album</a><% } %>
      </div>
      <% if (sitePhotos.length) { %>
      <div class="ma-photos">
        <% sitePhotos.slice(0, 8).forEach(function (p) { %>
        <figure class="ma-photos__item" data-ma-photo-item>
          <a href="<%= p.jobHref %>"><img src="<%= p.href %>" alt="<%= p.displayCaption || 'Job photo' %>" loading="lazy"></a>
          <figcaption data-ma-photo-caption><%= p.displayCaption || 'Add a note' %></figcaption>
          <button
            type="button"
            class="ma-photos__note<%= p.caption ? ' has-note' : '' %>"
            data-ma-photo-note-open
            data-action="<%= p.noteAction %>"
            data-return="<%= base %>/customers/c/<%= customer.id %>"
            data-caption="<%= String(p.caption || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/\r?\n/g, '&#10;') %>"
            aria-label="<%= p.caption ? 'Edit photo note' : 'Add photo note' %>"
          ><%- icons.note %></button>
        </figure>
        <% }); %>
      </div>
      <% } else { %>
      <p class="ma-hint" style="margin:0 0 12px">Document the job site with pictures — before, during, or after.</p>
      <% } %>
      <%- include('_photo_capture', {
        formId: 'cuPhoto',
        action: base + '/customers/c/' + customer.id + '/photos',
        returnTo: base + '/customers/c/' + customer.id,
        hint: openJob
          ? ('Photos save on ' + (openJob.title || 'this job') + '.')
          : 'No job yet — we’ll start a Site visit when you add the first photo.',
        open: false,
      }) %>
      <%- include('_photo_note_sheet') %>
    </section>
    <% } %>

    <section class="ma-section">
      <% if (customer) { %><div class="ma-section__head"><h2>Details</h2></div><% } %>
      <form method="post" action="<%= base %>/customers/<%= customer ? 'c/' + customer.id : 'new' %>" class="ma-card" autocomplete="off">
        <div class="ma-field">
          <label class="ma-label" for="cuName">Name</label>
          <input id="cuName" name="name" class="ma-input" maxlength="120" value="<%= fv.name || '' %>" required autocapitalize="words" <%= customer ? '' : 'autofocus' %>>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="cuPhone">Phone</label>
            <input id="cuPhone" name="phone" type="tel" inputmode="tel" maxlength="40" class="ma-input" value="<%= fv.phone || '' %>">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="cuEmail">Email</label>
            <input id="cuEmail" name="email" type="email" inputmode="email" maxlength="200" class="ma-input" value="<%= fv.email || '' %>">
          </div>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="cuAddress">Address</label>
          <input id="cuAddress" name="address" maxlength="200" class="ma-input" value="<%= fv.address || '' %>" autocomplete="street-address">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="cuNotes">Notes</label>
          <textarea id="cuNotes" name="notes" class="ma-textarea" maxlength="2000" placeholder="Gate code, preferences, history…"><%= fv.notes || '' %></textarea>
        </div>
        <button type="submit" class="ma-btn ma-btn--block"><%- icons.completed %> <%= customer ? 'Save changes' : 'Add customer' %></button>
      </form>
    </section>

    <% if (customer) { %>
    <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/delete" class="ma-section" data-ma-confirm="Delete <%= customer.name %><%= jobs.length ? ' and their ' + jobs.length + ' job' + (jobs.length === 1 ? '' : 's') : '' %>?">
      <button type="submit" class="ma-btn ma-btn--danger ma-btn--block">Delete customer</button>
    </form>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
