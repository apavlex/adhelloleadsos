<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: customer ? customer.name : 'New customer' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topBack: { href: base + '/customers', label: 'Customers' } }) %>
    <% const fv = formValues || {}; %>
    <% if (customer) { %>
    <%
      const _flooring = typeof isFlooringPartner !== 'undefined' ? !!isFlooringPartner : false;
      const _kind = typeof contactKind !== 'undefined' ? contactKind : (customer.isLead ? 'lead' : (customer.isQuoteRequest ? 'quote' : 'customer'));
    %>
    <form id="maMarkCustomerForm" method="post" action="<%= base %>/customers/c/<%= customer.id %>/mark-customer" hidden>
      <input type="hidden" name="stay" value="1">
    </form>
    <form id="maMarkLeadForm" method="post" action="<%= base %>/customers/c/<%= customer.id %>/mark-lead" hidden>
      <input type="hidden" name="stay" value="1">
    </form>
    <% if (_flooring) { %>
    <form id="maMarkQuoteForm" method="post" action="<%= base %>/customers/c/<%= customer.id %>/mark-quote" hidden>
      <input type="hidden" name="stay" value="1">
    </form>
    <% } %>
    <%
      const _isReferralStage = !!(
        customer.isReferralPartner
        || customer.referralId
        || customer.source === 'referral'
      );
      // One stage label by the name: Referral → Lead → Quote → Customer.
      const _stage = _isReferralStage ? 'referral'
        : (_kind === 'lead' ? 'lead'
          : (_kind === 'quote' ? 'quote' : 'customer'));
      const _stageLabel = _stage === 'referral' ? 'Referral'
        : (_stage === 'lead' ? 'Lead'
          : (_stage === 'quote' ? 'Quote' : 'Customer'));
    %>
    <div class="ma-titlebar">
      <h1 class="ma-page-title"><%= customer.name %></h1>
      <div class="ma-titlebar__actions">
        <% if (_flooring) { %>
        <% /* Stage is the Customer / Lead / Quote control below — no extra chips by the name. */ %>
        <% } else if (_stage === 'referral') { %>
        <span class="ma-btn ma-btn--sm ma-stage-btn ma-stage-btn--referral" title="Referral contact"><%= _stageLabel %></span>
        <% } else if (_stage === 'lead') { %>
        <button
          type="submit"
          form="maMarkCustomerForm"
          class="ma-btn ma-btn--sm ma-btn--ghost ma-mark-lead"
          title="Mark as customer"
        ><%- icons.customers %> Mark as customer</button>
        <% } else { %>
        <button
          type="submit"
          form="maMarkLeadForm"
          class="ma-btn ma-btn--sm ma-btn--ghost ma-mark-lead"
          title="Mark as lead"
        ><%- icons.leads %> Mark as lead</button>
        <% } %>
      </div>
    </div>
    <% if (_flooring) { %>
    <nav class="ma-seg ma-seg--3" aria-label="Contact type" style="margin:0 0 12px">
      <button type="submit" form="maMarkCustomerForm" class="<%= _kind === 'customer' ? 'is-on' : '' %>" <%= _kind === 'customer' ? 'aria-current=page' : '' %>><%- icons.customers %><span>Customer</span></button>
      <button type="submit" form="maMarkLeadForm" class="<%= _kind === 'lead' ? 'is-on' : '' %>" <%= _kind === 'lead' ? 'aria-current=page' : '' %>><%- icons.leads %><span>Lead</span></button>
      <button type="submit" form="maMarkQuoteForm" class="<%= _kind === 'quote' ? 'is-on' : '' %>" <%= _kind === 'quote' ? 'aria-current=page' : '' %>><%- icons.send %><span>Quote</span></button>
    </nav>
    <% } %>
    <% const tel = String(customer.phone || '').replace(/[^0-9+]/g, ''); %>
    <% const mapsHref = googleMapsSearchUrl({ name: customer.name, address: customer.address }); %>
    <div class="ma-quick">
      <a class="ma-quick__btn<%= tel ? '' : ' is-off' %>" <%- tel ? 'href="tel:' + tel + '"' : 'aria-disabled="true"' %>><%- icons.phone %><span>Call</span></a>
      <a class="ma-quick__btn<%= tel ? '' : ' is-off' %>" <%- tel ? 'href="sms:' + tel + '"' : 'aria-disabled="true"' %>><%- icons.send %><span>Text</span></a>
      <% if (typeof reviewSendLocked !== 'undefined' && reviewSendLocked) { %>
      <a class="ma-quick__btn is-off" href="<%= typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup' %>" aria-label="Upgrade to send review texts"><%- icons.review %><span>Review</span></a>
      <% } else { %>
      <a
        class="ma-quick__btn"
        href="<%= base %>/review?ask=1&amp;customer=<%= encodeURIComponent(customer.id) %>"
        aria-label="Request a review — review message before sending"
      ><%- icons.review %><span>Review</span></a>
      <% } %>
      <% if (_flooring) { %>
      <form class="ma-quick__form" method="post" action="<%= base %>/customers/c/<%= customer.id %>/mark-quote">
        <input type="hidden" name="openQuote" value="1">
        <button type="submit" class="ma-quick__btn" aria-label="Request a material quote for this contact">
          <%- icons.packages %><span>Quote</span>
        </button>
      </form>
      <% } else { %>
      <a class="ma-quick__btn<%= mapsHref ? '' : ' is-off' %>" <%- mapsHref ? 'href="' + mapsHref + '" target="_blank" rel="noopener"' : 'aria-disabled="true"' %>><%- icons.mapPin %><span>Map</span></a>
      <% } %>
    </div>
    <% if (_flooring) { %>
    <p class="ma-hint" style="margin:8px 0 0">Tap <strong>Quote</strong> to mark this contact as a material quote request and open the quote form with their details filled in. Or use Customer / Lead / Quote above.</p>
    <% } %>
    <% if (typeof reviewSendLocked !== 'undefined' && reviewSendLocked) { %>
    <p class="ma-hint" style="margin:8px 0 0">Text/email review sends need a GHL CRM account on the monthly plan. Share your QR from the Review tab for free, or <a href="<%= typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup' %>">upgrade</a>.</p>
    <% } else if (typeof reviewAskStatus !== 'undefined' && reviewAskStatus) { %>
    <div class="ma-askstatus ma-askstatus--<%= reviewAskStatus.status %>" role="status">
      <%- icons.review %>
      <div>
        <strong><%= reviewAskStatus.label %></strong>
        <% if (reviewAskStatus.detail) { %><span><%= reviewAskStatus.detail %></span><% } %>
      </div>
    </div>
    <% if (reviewAskStatus.canConfirm && reviewAskStatus.askId) { %>
    <%- include('_review_reward_confirm', {
      rewardCompact: true,
      rewardConfirm: { askId: reviewAskStatus.askId },
      rewardReturnTo: base + '/customers/c/' + encodeURIComponent(customer.id),
    }) %>
    <% } %>
    <% } else { %>
    <p class="ma-hint" style="margin:8px 0 0">Opens Review with this customer selected so you can confirm the message before it sends via GHL CRM. We’ll track opens and nudge once if they don’t click.</p>
    <% } %>

    <% } else { %>
    <h1 class="ma-page-title">New customer</h1>
    <p class="ma-page-sub">Speak the details once, confirm, and create — or type / upload a list.</p>
    <% } %>

    <%- include('_flash') %>

    <% const _custTab = !customer && typeof customerTab !== 'undefined' && customerTab === 'bulk' ? 'bulk' : 'one'; %>
    <% if (!customer) { %>
    <nav class="ma-seg ma-seg--2" aria-label="How to add customers" style="margin-top:4px">
      <a href="<%= base %>/customers/new" class="<%= _custTab === 'one' ? 'is-on' : '' %>" <%= _custTab === 'one' ? 'aria-current=page' : '' %>><%- icons.customers %><span>One customer</span></a>
      <a href="<%= base %>/customers/new?tab=bulk" class="<%= _custTab === 'bulk' ? 'is-on' : '' %>" <%= _custTab === 'bulk' ? 'aria-current=page' : '' %>><%- icons.people %><span>Bulk upload</span></a>
    </nav>
    <% if (_custTab === 'bulk') { %>
    <section class="ma-section">
      <form method="post" action="<%= base %>/customers/import" enctype="multipart/form-data" class="ma-card" autocomplete="off" data-ma-loading="Importing…">
        <input type="hidden" name="from" value="new">
        <p class="ma-hint" style="margin:0 0 12px">Upload a CSV or Excel file. Columns: <strong>Name</strong> (or First / Last), <strong>Phone</strong>, <strong>Email</strong>, <strong>Address</strong>, <strong>Notes</strong>.</p>
        <p class="ma-hint" style="margin:0 0 14px">
          <a href="<%= base %>/customers/import-template.csv">Download CSV template</a>
          — fill it in, then upload below.
        </p>
        <div class="ma-field" style="margin:0 0 14px">
          <label class="ma-label" for="cuBulkImport">Choose file</label>
          <input id="cuBulkImport" name="file" type="file" accept=".csv,.xlsx,.xls,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="ma-input" required>
        </div>
        <button type="submit" class="ma-btn ma-btn--block"><%- icons.people %> Import list</button>
      </form>
    </section>
    <% } %>
    <% } %>

    <% if (customer) { %>
    <%
      const sitePhotos = [];
      (jobs || []).forEach(function (j) {
        (j.photos || []).forEach(function (p) {
          sitePhotos.push({
            id: p.id,
            href: p.href,
            caption: p.caption || '',
            displayCaption: p.caption || j.title,
            jobId: j.id,
            jobHref: j.href,
            jobTitle: j.title,
            noteAction: base + '/customers/jobs/' + j.id + '/photos/' + p.id + '/caption',
          });
        });
      });
      const openJob = (jobs || []).find(function (j) { return j.status !== 'completed' && j.status !== 'cancelled'; }) || (jobs || [])[0];
    %>
    <% if (customer.sharedFromMemberId || (typeof addedByLabel !== 'undefined' && addedByLabel)) { %>
    <p class="ma-hint" style="margin:0 0 12px">
      <% if (customer.sharedFromMemberId) { %>
      Shared onto your book<% if (typeof addedByLabel !== 'undefined' && addedByLabel) { %> by <strong><%= addedByLabel %></strong><% } else { %> by a teammate<% } %> — including their projects. Your other customers stay private.
      <% } else if (typeof addedByLabel !== 'undefined' && addedByLabel) { %>
      Added by <strong><%= addedByLabel %></strong>
      <% } %>
    </p>
    <% } %>
    <section class="ma-section">
      <div class="ma-section__head">
        <h2>Jobs</h2>
        <a href="<%= base %>/customers/jobs/new?customer=<%= customer.id %>">+ Add job</a>
      </div>
      <% if (jobs.length) { %>
      <div class="ma-list">
        <% jobs.forEach(function (j) { %><%- include('_job_row', { j: j, titleIsJob: true }) %><% }); %>
      </div>
      <% } else { %>
      <a class="ma-card ma-empty ma-empty--tap" href="<%= base %>/customers/jobs/new?customer=<%= customer.id %>"><%- icons.customers %><p>No jobs yet. Tap to add an estimate or schedule work.</p></a>
      <% } %>
    </section>

    <section class="ma-section" id="maCustomerPhotos">
      <div class="ma-section__head">
        <h2>Photos &amp; notes</h2>
        <% if (openJob) { %><a href="<%= openJob.href %>#maJobPhotos">Job album</a><% } %>
      </div>
      <% if (sitePhotos.length) { %>
      <div class="ma-photos" data-ma-lr-gallery>
        <% sitePhotos.slice(0, 8).forEach(function (p, pi) { %>
        <figure class="ma-photos__item" data-ma-photo-item>
          <a href="<%= p.href %>" class="ma-photos__thumb" data-ma-lr-open data-ma-lr-index="<%= pi %>" data-ma-lr-src="<%= p.href %>" data-ma-lr-caption="<%= String(p.displayCaption || p.caption || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>" aria-label="View photo"><img src="<%= p.href %>" alt="<%= p.displayCaption || 'Job photo' %>" loading="lazy"></a>
          <figcaption data-ma-photo-caption><%= p.displayCaption || 'Add a note' %></figcaption>
          <button
            type="button"
            class="ma-photos__note<%= p.caption ? ' has-note' : '' %>"
            data-ma-photo-note-open
            data-action="<%= p.noteAction %>"
            data-return="<%= base %>/customers/c/<%= customer.id %>"
            data-caption="<%= String(p.caption || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/\r?\n/g, '&#10;') %>"
            aria-label="<%= p.caption ? 'Edit photo note' : 'Add photo note' %>"
          ><%- icons.note %></button>
        </figure>
        <% }); %>
      </div>
      <% } else { %>
      <p class="ma-hint" style="margin:0 0 12px">Document the job site with pictures — before, during, or after.</p>
      <% } %>
      <%- include('_photo_capture', {
        formId: 'cuPhoto',
        action: base + '/customers/c/' + customer.id + '/photos',
        returnTo: base + '/customers/c/' + customer.id,
        hint: openJob
          ? ('Photos save on ' + (openJob.title || 'this job') + '.')
          : 'No job yet — we’ll start a Site visit when you add the first photo.',
        open: false,
      }) %>
      <%- include('_photo_note_sheet') %>
      <%- include('_photo_viewer') %>
    </section>
    <% } %>

    <% if (customer) { %>
    <% const _applied = typeof customerTags !== 'undefined' && Array.isArray(customerTags) ? customerTags : []; %>
    <% const _available = typeof availableTags !== 'undefined' && Array.isArray(availableTags) ? availableTags : []; %>
    <section class="ma-section ma-tags-section">
      <div class="ma-section__head"><h2>Tags</h2></div>
      <div class="ma-card ma-tags" data-ma-tag-pick>
        <p class="ma-hint" style="margin:0 0 14px">Search an existing tag or create a new one. Active tags sync both ways with GHL CRM.</p>

        <div class="ma-tags__list" role="list" data-ma-tag-applied data-remove-action="<%= base %>/customers/c/<%= customer.id %>/tags/remove">
          <% if (_applied.length) { %>
            <% _applied.forEach(function (t) { %>
            <div class="ma-tags__chip" role="listitem" style="--ma-tag:<%= t.color || 'var(--acc)' %>" data-key="<%= t.key %>">
              <span class="ma-tags__chip-name"><%= t.name %></span>
              <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/tags/remove" class="ma-tags__chip-remove" data-ma-tag-remove-form>
                <input type="hidden" name="tagKey" value="<%= t.key %>">
                <button type="submit" class="ma-tags__chip-x" aria-label="Remove <%= t.name %> tag">×</button>
              </form>
            </div>
            <% }); %>
          <% } else { %>
            <p class="ma-hint ma-tags__empty" style="margin:0" data-ma-tag-empty>No tags on this customer yet.</p>
          <% } %>
        </div>

        <div class="ma-tags__search">
          <form
            id="cuTagAddForm"
            method="post"
            action="<%= base %>/customers/c/<%= customer.id %>/tags/add"
            class="ma-tags__search-form"
            autocomplete="off"
            data-ma-tag-form
          >
            <label class="ma-label" for="cuTagSearch">Add tag</label>
            <div class="ma-typeahead">
              <input
                id="cuTagSearch"
                class="ma-input"
                type="search"
                name="tagName"
                enterkeyhint="done"
                maxlength="60"
                placeholder="Search tags or create new…"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="cuTagList"
                data-ma-tag-input
              >
              <input type="hidden" name="tagKey" value="" data-ma-tag-key>
              <ul id="cuTagList" class="ma-typeahead__list" role="listbox" hidden data-ma-tag-list></ul>
            </div>
          </form>

          <% if (_available.length) { %>
          <ul class="ma-tags__suggest" data-ma-tag-suggest aria-label="Available tags" hidden>
            <% _available.forEach(function (t) { %>
            <li class="ma-tags__suggest-item" data-ma-tag-suggest-item data-key="<%= t.key %>" data-name="<%= String(t.name || '').toLowerCase() %>" data-color="<%= t.color || '' %>">
              <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/tags/add" data-ma-tag-suggest-form>
                <input type="hidden" name="tagKey" value="<%= t.key %>">
                <button type="submit" class="ma-tags__suggest-btn" style="--ma-tag:<%= t.color || 'var(--acc)' %>">+ <%= t.name %></button>
              </form>
            </li>
            <% }); %>
          </ul>
          <% } else { %>
          <p class="ma-hint" style="margin:12px 0 0">Type a name above to create a new tag.</p>
          <% } %>

          <button type="submit" form="cuTagAddForm" class="ma-btn ma-btn--block ma-tags__submit" data-ma-tag-submit>Add tag</button>
        </div>
        <script type="application/json" data-ma-tag-catalog><%- JSON.stringify(_available.map(function (t) { return { key: t.key, name: t.name, color: t.color || '' }; })) %></script>
      </div>
    </section>
    <% } %>

    <% if (customer) {
      const _ghlAct = typeof ghlActivity !== 'undefined' && ghlActivity ? ghlActivity : null;
      const _ghlItems = _ghlAct && Array.isArray(_ghlAct.items) ? _ghlAct.items : [];
      const _ghlLinked = !!(customer.ghlContactId);
      const _ghlNeedsFetch = _ghlLinked && !_ghlAct;
    %>
    <% if (_ghlLinked) { %>
    <section
      class="ma-section"
      id="maCustomerGhlActivity"
      <% if (_ghlNeedsFetch) { %>data-ma-ghl-activity-url="<%= base %>/customers/c/<%= encodeURIComponent(customer.id) %>/ghl-activity.json"<% } %>
    >
      <div class="ma-section__head">
        <h2>Calls &amp; texts</h2>
        <a
          class="ma-ghl-open"
          href="<%= (_ghlAct && _ghlAct.openHref) ? _ghlAct.openHref : '#' %>"
          target="_blank"
          rel="noopener noreferrer"
          <% if (!(_ghlAct && _ghlAct.openHref)) { %>hidden<% } %>
          data-ma-ghl-open
        >Open in GHL</a>
      </div>
      <div data-ma-ghl-activity-body>
      <% if (_ghlNeedsFetch) { %>
      <p class="ma-hint ma-ghl-loading" style="margin:0" data-ma-ghl-status>Loading calls &amp; texts…</p>
      <% } else if (_ghlAct && _ghlAct.error && !_ghlItems.length) { %>
      <p class="ma-hint" style="margin:0"><%= _ghlAct.error %></p>
      <% } else if (!_ghlItems.length) { %>
      <p class="ma-hint" style="margin:0">No calls or texts in GHL for this contact yet.</p>
      <% } else {
        const _ghlPreview = 2;
        const _ghlRest = Math.max(0, _ghlItems.length - _ghlPreview);
      %>
      <ul class="ma-ghl-feed" aria-label="GHL calls and texts" data-ma-ghl-feed>
        <% _ghlItems.forEach(function (m, i) {
          const when = m.at ? new Date(m.at) : null;
          const ago = when && !isNaN(when.getTime())
            ? (function () {
                const mins = Math.max(0, Math.round((Date.now() - when.getTime()) / 60000));
                if (mins < 1) return 'just now';
                if (mins < 60) return mins + 'm ago';
                const hrs = Math.round(mins / 60);
                if (hrs < 24) return hrs + 'h ago';
                return Math.round(hrs / 24) + 'd ago';
              })()
            : '';
          const dir = m.direction === 'inbound' ? 'In' : 'Out';
          const _extra = i >= _ghlPreview;
        %>
        <li class="ma-ghl-feed__item ma-ghl-feed__item--<%= m.kind %> ma-ghl-feed__item--<%= m.direction %><%= _extra ? ' ma-ghl-feed__item--more' : '' %>"<%= _extra ? ' hidden' : '' %>>
          <div class="ma-ghl-feed__meta">
            <strong><%= m.title %></strong>
            <span><%= dir %><% if (ago) { %> · <%= ago %><% } %></span>
          </div>
          <% if (m.kind === 'sms' && m.body) { %><p class="ma-ghl-feed__body"><%= m.body %></p><% } %>
          <% if (m.openHref) { %>
          <a class="ma-ghl-feed__open" href="<%= m.openHref %>" target="_blank" rel="noopener noreferrer"><%= m.kind === 'call' ? 'Open in LC' : 'Reply in LC' %></a>
          <% } %>
        </li>
        <% }); %>
      </ul>
      <% if (_ghlRest > 0) { %>
      <button type="button" class="ma-ghl-feed__more" data-ma-ghl-feed-more>More · <%= _ghlRest %> older</button>
      <% } %>
      <% } %>
      </div>
    </section>
    <% } %>
    <% } %>

    <% if (customer) {
      const _formAnswers = Array.isArray(typeof formAnswers !== 'undefined' ? formAnswers : customer.formAnswers)
        ? (typeof formAnswers !== 'undefined' ? formAnswers : customer.formAnswers)
        : [];
      const _showFormBlock = _formAnswers.length || customer.source === 'website_form';
      const _isLeadContact = (typeof contactKind !== 'undefined' ? contactKind : (customer.isLead ? 'lead' : 'customer')) === 'lead';
    %>
    <% if (_showFormBlock) { %>
    <section class="ma-section" id="maFormAnswers">
      <div class="ma-section__head"><h2>Form answers</h2></div>
      <% if (_formAnswers.length) { %>
      <div class="ma-card ma-form-answers" aria-label="Website form answers">
        <dl class="ma-form-answers__list">
          <% _formAnswers.forEach(function (row) { %>
          <div class="ma-form-answers__row">
            <dt><%= row.q %></dt>
            <dd><%= row.a %></dd>
          </div>
          <% }); %>
        </dl>
      </div>
      <% } else { %>
      <p class="ma-hint" style="margin:0">No extra form fields yet — name, phone, and email are in Details below. Pulling from GHL may need the <strong>forms</strong> scope on your CRM connection.</p>
      <% } %>
    </section>
    <% } %>
    <% if (_isLeadContact) { %>
    <div class="ma-actions" style="margin:0 0 14px;flex-wrap:wrap">
      <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/remove-lead" data-ma-confirm="Remove <%= customer.name %> from Leads? They’ll stay in Customers.">
        <input type="hidden" name="stay" value="1">
        <button type="submit" class="ma-btn ma-btn--soft">Remove from Leads</button>
      </form>
    </div>
    <% } %>
    <% } %>

    <% if (customer || _custTab === 'one') { %>
    <section class="ma-section">
      <% if (customer) { %><div class="ma-section__head"><h2>Details</h2></div><% } %>
      <% if (!customer) { %>
      <div class="ma-card ma-voice-add" id="maVoiceAddCustomer" data-ma-voice-add-customer style="margin-bottom:12px">
        <div class="ma-voice-add__mic-wrap">
          <button type="button" class="ma-voice-add__mic alex-voice-btn" id="maVoiceAddCustomerBtn" aria-label="Speak customer info" title="Tap to speak — say name, phone, address, notes" aria-pressed="false">
            <svg class="alex-voice-icon alex-voice-icon--mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"/></svg>
          </button>
        </div>
        <p class="ma-hint ma-voice-hint ma-voice-add__hint">Tap the mic and say it all at once — name, phone, email, address, notes.</p>
        <p class="ma-hint ma-voice-add__status" id="maVoiceAddCustomerStatus" role="status" aria-live="polite" hidden></p>
        <textarea id="maVoiceAddCustomerCapture" class="ma-sr-only" maxlength="4000" tabindex="-1" aria-hidden="true" readonly></textarea>
      </div>
      <p class="ma-hint" style="margin:0 0 12px;text-align:center;font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:11px;color:var(--muted)">Or fill in manually</p>
      <% } %>
      <form method="post" action="<%= base %>/customers/<%= customer ? 'c/' + customer.id : 'new' %>" class="ma-card" autocomplete="off" id="<%= customer ? 'maCustomerEditForm' : 'maCustomerNewForm' %>" data-ma-voice-customer-form="<%= customer ? '0' : '1' %>" data-lpignore="true" data-1p-ignore="true">
        <% /* Safari Contact Autofill sinks — real fields below keep what you type. */ %>
        <div class="ma-sr-only" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;overflow:hidden">
          <label>Name<input tabindex="-1" autocomplete="name" name="safari_name_sink" type="text" value=""></label>
          <label>Phone<input tabindex="-1" autocomplete="tel" name="safari_tel_sink" type="tel" value=""></label>
          <label>Email<input tabindex="-1" autocomplete="email" name="safari_email_sink" type="email" value=""></label>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="cuName">Name</label>
          <input id="cuName" name="name" class="ma-input" maxlength="120" value="<%= fv.name || '' %>" required autocapitalize="words" autocomplete="nope" autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" <%= customer ? '' : 'autofocus' %>>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="cuPhone">Phone</label>
            <% /* type=text + numeric pad: type=tel lets iOS Contact Autofill fight keystrokes when Name matches a contact. */ %>
            <input id="cuPhone" name="phone" type="text" inputmode="numeric" maxlength="40" class="ma-input" value="<%= fv.phone || '' %>" autocomplete="nope" autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-ma-phone-guard="1">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="cuEmail">Email</label>
            <input id="cuEmail" name="email" type="text" inputmode="email" maxlength="200" class="ma-input" value="<%= fv.email || '' %>" autocomplete="nope" spellcheck="false" data-lpignore="true" data-1p-ignore="true">
          </div>
        </div>
        <div class="ma-field">
          <% const addressMapsHref = googleMapsSearchUrl({
            name: (customer && customer.name) || fv.name,
            address: fv.address || (customer && customer.address) || '',
          }); %>
          <div class="ma-label-row">
            <label class="ma-label" for="cuAddress">Address</label>
            <% if (addressMapsHref) { %><a class="ma-label-link" href="<%= addressMapsHref %>" target="_blank" rel="noopener">Google Maps</a><% } %>
          </div>
          <input id="cuAddress" name="address" maxlength="200" class="ma-input" value="<%= fv.address || '' %>" autocomplete="nope" placeholder="Street, city…">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="cuNotes">Notes</label>
          <textarea id="cuNotes" name="notes" class="ma-textarea" maxlength="2000" placeholder="Gate code, preferences, history…" autocomplete="nope"><%= fv.notes || '' %></textarea>
        </div>
        <button type="submit" class="ma-btn ma-btn--block" id="maCustomerSubmitBtn"><%- icons.completed %> <%= customer ? 'Save changes' : 'Add customer' %></button>
      </form>
      <% if (!customer) { %>
      <div class="ma-photo-modal" id="maVoiceCustomerConfirm" data-ma-voice-customer-confirm hidden role="dialog" aria-modal="true" aria-labelledby="maVoiceCustomerConfirmTitle">
        <div class="ma-photo-sheet">
          <button type="button" class="ma-install-close-x" aria-label="Close" data-ma-voice-customer-edit>&times;</button>
          <h2 id="maVoiceCustomerConfirmTitle">Confirm customer</h2>
          <p class="ma-photo-lead">Here’s what I heard. Create this contact, or edit the form first.</p>
          <p class="ma-hint" id="maVoiceCustomerConfirmWarning" hidden style="margin:0 0 10px;color:#b91c1c"></p>
          <dl class="ma-voice-preview" id="maVoiceCustomerPreview">
            <div><dt>Name</dt><dd data-field="name">—</dd></div>
            <div><dt>Phone</dt><dd data-field="phone">—</dd></div>
            <div><dt>Email</dt><dd data-field="email">—</dd></div>
            <div><dt>Address</dt><dd data-field="address">—</dd></div>
            <div><dt>Notes</dt><dd data-field="notes">—</dd></div>
          </dl>
          <div class="ma-photo-actions">
            <button type="button" class="ma-btn ma-btn--block" id="maVoiceCustomerCreateBtn" data-ma-voice-customer-create><%- icons.completed %> Confirm &amp; create</button>
            <button type="button" class="ma-btn ma-btn--soft ma-btn--block" data-ma-voice-customer-edit>Edit form</button>
          </div>
        </div>
      </div>
      <% } %>
    </section>
    <% } %>

    <% if (customer && !customer.sharedFromMemberId) { %>
    <%
      const _shareMates = typeof teammates !== 'undefined' && Array.isArray(teammates) ? teammates : [];
      const _shareShared = typeof sharedWithLabels !== 'undefined' && Array.isArray(sharedWithLabels) ? sharedWithLabels : [];
    %>
    <section class="ma-card" id="maCustomerShare" aria-label="Share contact" style="margin-top:16px">
      <h2 style="font-size:16px;margin:0 0 4px">Share contact &amp; projects</h2>
      <p class="ma-hint" style="margin:0 0 12px">Sends this contact <strong>and all their projects/jobs</strong>. Books stay separate. Teammates get it instantly; outsiders get a join link by text/email.</p>
      <% if (_shareShared.length) { %>
      <p class="ma-hint" style="margin:0 0 10px">Already shared with: <strong><%= _shareShared.map(function (s) { return s.label; }).join(', ') %></strong></p>
      <% } %>
      <% if (typeof inviteUrl !== 'undefined' && inviteUrl) { %>
      <p class="ma-hint" style="margin:0 0 12px;overflow-wrap:anywhere">Invite link: <a href="<%= inviteUrl %>"><%= inviteUrl %></a></p>
      <% } %>
      <% if (_shareMates.length) { %>
      <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/share" autocomplete="off" data-ma-loading="Sharing…" data-ma-share-mate-form>
        <%- include('_share_mate_pick', { mates: _shareMates, idPrefix: 'cu' }) %>
        <button type="submit" class="ma-btn ma-btn--block ma-btn--soft" data-ma-share-submit disabled><%- icons.send %> Share with teammate</button>
      </form>
      <% } %>
      <%
        const _inviteOpen = !_shareMates.length || !!(typeof inviteUrl !== 'undefined' && inviteUrl);
      %>
      <details class="ma-fold ma-fold--inset" id="maShareInvite"<%= _inviteOpen ? ' open' : '' %>>
        <summary>Invite someone new</summary>
        <div class="ma-fold__body">
          <p class="ma-hint" style="margin:0 0 12px">Text or email a join link — they get this contact and projects when they open it.</p>
          <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/share" class="ma-card--flush" autocomplete="off" data-ma-loading="Sending invite…">
            <div class="ma-field">
              <label class="ma-label" for="cuInviteName">Their name <span style="font-weight:600;text-transform:none;letter-spacing:0;color:var(--muted)">optional</span></label>
              <input id="cuInviteName" name="inviteName" class="ma-input" maxlength="120" autocomplete="name">
            </div>
            <div class="ma-field">
              <label class="ma-label" for="cuInviteCompany">Their business <span style="font-weight:600;text-transform:none;letter-spacing:0;color:var(--muted)">optional</span></label>
              <input id="cuInviteCompany" name="inviteCompany" class="ma-input" maxlength="160" autocomplete="organization">
            </div>
            <div class="ma-grid2">
              <div class="ma-field">
                <label class="ma-label" for="cuInvitePhone">Mobile</label>
                <input id="cuInvitePhone" name="invitePhone" type="tel" inputmode="tel" class="ma-input" maxlength="40" autocomplete="tel" placeholder="Text the join link">
              </div>
              <div class="ma-field">
                <label class="ma-label" for="cuInviteEmail">Email</label>
                <input id="cuInviteEmail" name="inviteEmail" type="email" inputmode="email" class="ma-input" maxlength="200" autocomplete="email">
              </div>
            </div>
            <button type="submit" class="ma-btn ma-btn--block"><%- icons.send %> Invite outside network</button>
          </form>
        </div>
      </details>
    </section>
    <% } %>

    <% if (customer) { %>
    <form method="post" action="<%= base %>/customers/c/<%= customer.id %>/delete" class="ma-section" data-ma-confirm="Delete <%= customer.name %><%= jobs.length ? ' and their ' + jobs.length + ' job' + (jobs.length === 1 ? '' : 's') : '' %>?">
      <button type="submit" class="ma-btn ma-btn--danger ma-btn--block">Delete customer</button>
    </form>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
