<!DOCTYPE html>
<html lang="en">
<head>
  <%
    const _viewHead = typeof sendView !== 'undefined' ? sendView : 'lead';
    const _pageTitle = (_viewHead === 'link' || _viewHead === 'board') ? 'Request a referral' : 'Send a referral';
  %>
  <%- include('_head', { pageTitle: _pageTitle }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Referrals' }) %>
    <% if (typeof referralsLocked !== 'undefined' && referralsLocked) { %>
    <h1 class="ma-page-title">Send a referral</h1>
    <p class="ma-page-sub">Pass jobs to trusted partners in the network.</p>
    <%- include('_flash') %>
    <%- include('_upgrade_gate', {
      upgradeTitle: 'Start getting referrals',
      upgradeBody: 'Upgrade to activate referrals for your business — send jobs to partners and get work sent back to you.',
      upgradeHref: typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup',
      upgradeIcon: 'send',
    }) %>
    <% } else { %>
    <%
      const _view = typeof sendView !== 'undefined' ? sendView : 'lead';
      const _dash = typeof referralDash !== 'undefined' && referralDash ? referralDash : { totalAdvocates: 0, totalReferrals: 0, totalClicks: 0, awaitingRewardCount: 0, top: [], all: [], awaitingReward: [], rewarded: [] };
      const _awaiting = Array.isArray(_dash.awaitingReward) ? _dash.awaitingReward : [];
      const _rewarded = Array.isArray(_dash.rewarded) ? _dash.rewarded : [];
      const _custs = typeof customers !== 'undefined' && Array.isArray(customers) ? customers : [];
      const _picked = typeof pickedAdvocate !== 'undefined' && pickedAdvocate ? pickedAdvocate : null;
      const _pickId = typeof pickCustomerId !== 'undefined' ? pickCustomerId : '';
      const _pickCust = _pickId ? (_custs.find(function (c) { return c.id === _pickId; }) || (_picked ? { id: _picked.customerId, name: _picked.name, phone: _picked.phone, email: _picked.email } : null)) : null;
      const _custPayload = _custs.map(function (c) {
        return { id: c.id, name: c.name || '', phone: c.phone || '', email: c.email || '' };
      });
    %>
    <h1 class="ma-page-title"><%= (_view === 'link' || _view === 'board') ? 'Request a referral' : 'Send a referral' %></h1>
    <nav class="ma-seg ma-seg--3" aria-label="Send referral options">
      <a href="<%= base %>/send" class="<%= _view === 'lead' ? 'is-on' : '' %>">Lead</a>
      <a href="<%= base %>/send?view=link" class="<%= _view === 'link' ? 'is-on' : '' %>">Link</a>
      <a href="<%= base %>/send?view=board" class="<%= _view === 'board' ? 'is-on' : '' %>">Board<% if (_view !== 'board' && (_dash.awaitingRewardCount || 0) > 0) { %> (<%= _dash.awaitingRewardCount %>)<% } %></a>
    </nav>

    <%- include('_flash') %>

    <% if (_view === 'board') { %>
    <p class="ma-page-sub">See who brought you leads — reward the customers who shared their unique links.</p>

    <div class="ma-refdash__stats" aria-label="Referral summary">
      <div class="ma-refdash__stat">
        <span class="ma-refdash__stat-label">Referrals</span>
        <strong class="ma-refdash__stat-pill ma-refdash__stat-pill--refs"><%= _dash.totalReferrals %> referrals</strong>
      </div>
      <div class="ma-refdash__stat">
        <span class="ma-refdash__stat-label">To reward</span>
        <strong class="ma-refdash__stat-pill ma-refdash__stat-pill--pos"><%= _dash.awaitingRewardCount || 0 %> waiting</strong>
      </div>
    </div>

    <% if (_picked && _picked.url) { %>
    <section class="ma-card ma-refdash__share" aria-label="Share a referral link">
      <h2 class="ma-refdash__share-title">Share a unique link</h2>
      <p class="ma-hint" style="margin-top:0">For <strong><%= _picked.name || 'customer' %></strong> — copy or text their personal link.</p>
      <label class="ma-label" for="maRefLinkUrl">Their unique referral link</label>
      <div class="ma-link-box">
        <code id="maRefLinkUrl"><%= _picked.url %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= _picked.url %>"><%- icons.copy %> Copy</button>
      </div>
      <div class="ma-refdash__share-row">
        <% if (_picked.phone) { %>
        <a class="ma-btn ma-btn--sm" href="sms:<%= String(_picked.phone).replace(/[^0-9+]/g, '') %>?&body=<%= encodeURIComponent(_picked.smsText || _picked.url) %>"><%- icons.sms %> Text link</a>
        <% } %>
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= base %>/send?view=link<%= _picked.customerId ? ('&customer=' + encodeURIComponent(_picked.customerId)) : '' %>">Change customer</a>
      </div>
    </section>
    <% } else { %>
    <p class="ma-hint" style="margin-top:0">Pick a customer on the <a href="<%= base %>/send?view=link">Link</a> tab to copy their unique URL.</p>
    <% } %>

    <section class="ma-card ma-refdash__rewards" aria-label="Reward customers">
      <div class="ma-section__head" style="margin:0 0 10px">
        <h2 style="font-size:15px;margin:0">Reward customers</h2>
      </div>
      <% if (!_awaiting.length) { %>
      <p class="ma-hint" style="margin:0">No open referrals waiting on a thank-you. When a friend uses someone’s unique link, they show up here so you can mark the reward paid.</p>
      <% } else { %>
      <% _awaiting.forEach(function (row) { %>
      <article class="ma-refdash__reward-row">
        <div class="ma-refdash__who" style="min-width:0">
          <span class="ma-refdash__avatar" aria-hidden="true"><%= String(row.advocateName || 'C').charAt(0).toUpperCase() %></span>
          <span>
            <strong><%= row.advocateName || 'Customer' %></strong>
            <small>Brought <strong><%= row.name || 'a friend' %></strong><% if (row.phone) { %> · <%= row.phone %><% } %></small>
          </span>
        </div>
        <div class="ma-refdash__reward-actions">
          <% if (row.leadCustomerId) { %>
          <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= base %>/customers/c/<%= encodeURIComponent(row.leadCustomerId) %>">Lead</a>
          <% } %>
          <% if (row.advocatePhone) { %>
          <a class="ma-btn ma-btn--sm ma-btn--soft" href="sms:<%= String(row.advocatePhone).replace(/[^0-9+]/g, '') %>?&body=<%= encodeURIComponent('Thanks for the referral — your reward is on the way!') %>"><%- icons.sms %></a>
          <% } %>
          <form method="post" action="<%= base %>/send/referral/<%= encodeURIComponent(row.code) %>/<%= encodeURIComponent(row.conversionId) %>">
            <input type="hidden" name="action" value="rewarded">
            <button type="submit" class="ma-btn ma-btn--sm">Mark rewarded</button>
          </form>
        </div>
      </article>
      <% }); %>
      <% } %>
      <% if (_rewarded.length) { %>
      <p class="ma-hint" style="margin:14px 0 6px">Recently rewarded</p>
      <% _rewarded.slice(0, 5).forEach(function (row) { %>
      <p class="ma-card__meta" style="margin:0 0 6px"><strong><%= row.advocateName %></strong> · brought <%= row.name || 'a friend' %></p>
      <% }); %>
      <% } %>
    </section>

    <section class="ma-card ma-refdash__board" aria-label="Top referrers">
      <div class="ma-section__head" style="margin:0 0 10px">
        <h2 style="font-size:15px;margin:0">Top referrers</h2>
      </div>
      <% if (!_dash.top.length) { %>
      <p class="ma-hint" style="margin:0">No unique links yet. Open <strong>Link</strong>, pick a happy customer, and share their URL — or confirm a 4–5★ review to text them one automatically.</p>
      <% } else { %>
      <div class="ma-refdash__table" role="table">
        <div class="ma-refdash__thead" role="row">
          <span role="columnheader">#</span>
          <span role="columnheader">Name</span>
          <span role="columnheader">Refs</span>
        </div>
        <% _dash.top.forEach(function (row) { %>
        <a class="ma-refdash__row" role="row" href="<%= base %>/send?view=link&customer=<%= encodeURIComponent(row.customerId) %>">
          <span class="ma-refdash__rank" aria-label="Position <%= row.rank %>"><%= row.rank %></span>
          <span class="ma-refdash__who">
            <span class="ma-refdash__avatar" aria-hidden="true"><%= row.initial %></span>
            <span>
              <strong><%= row.name %></strong>
              <% if (row.email || row.phone) { %><small><%= row.email || row.phone %></small><% } %>
            </span>
          </span>
          <span class="ma-refdash__count"><%= row.referrals %></span>
        </a>
        <% }); %>
      </div>
      <% } %>
    </section>

    <% } else if (_view === 'link') { %>
    <p class="ma-page-sub">Your customer shares their unique link so a friend can reach you — and they earn a giveaway or your reward when that referral comes through.</p>

    <% if (!_custs.length) { %>
    <div class="ma-card ma-empty"><%- icons.customers %><p>Add a customer first, then come back to request a referral with their unique link.</p></div>
    <% } else { %>
    <form method="get" action="<%= base %>/send" class="ma-card" autocomplete="off" id="maRefLinkForm">
      <input type="hidden" name="view" value="link">
      <div class="ma-field" data-ma-customer-pick data-ma-pick-mode="saved">
        <input type="hidden" name="customer" id="sdRefCustomerId" value="<%= _pickCust ? _pickCust.id : '' %>" required>
        <div data-ma-ask-search <%= _pickCust ? 'hidden' : '' %>>
          <label class="ma-label" for="sdRefCustomer">Customer</label>
          <div class="ma-typeahead">
            <input
              id="sdRefCustomer"
              type="text"
              inputmode="search"
              class="ma-input"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="sdRefCustomerList"
              placeholder="Search by name or phone…"
              autocomplete="off"
              autocorrect="off"
              spellcheck="false"
              value=""
            >
            <ul id="sdRefCustomerList" class="ma-typeahead__list" role="listbox" hidden></ul>
          </div>
          <p class="ma-hint">Usually someone who left a great review. <a href="<%= base %>/customers">Manage customers</a></p>
        </div>
        <div class="ma-ask-selected" data-ma-ask-selected <%= _pickCust ? '' : 'hidden' %>>
          <span class="ma-ask-selected__avatar" aria-hidden="true" data-ma-ask-selected-avatar><%= _pickCust && _pickCust.name ? String(_pickCust.name).charAt(0).toUpperCase() : '?' %></span>
          <span class="ma-ask-selected__body">
            <strong data-ma-ask-selected-name><%= _pickCust ? (_pickCust.name || 'Customer') : '' %></strong>
            <span data-ma-ask-selected-meta><%= _pickCust ? (_pickCust.phone || _pickCust.email || 'Saved customer') : '' %></span>
          </span>
          <button type="button" class="ma-btn ma-btn--sm ma-btn--ghost" data-ma-ask-clear>Change</button>
        </div>
        <script type="application/json" id="sdRefCustomerData"><%- JSON.stringify(_custPayload).replace(/</g, '\\u003c') %></script>
      </div>
      <button type="submit" class="ma-btn ma-btn--block" data-ma-needs-customer <%= _pickCust ? '' : 'disabled' %>><%- icons.share %> Get unique link</button>
    </form>
    <% } %>

    <% if (_picked && _picked.url) { %>
    <section class="ma-card ma-refdash__share" style="margin-top:12px" aria-label="Unique referral link">
      <h2 class="ma-refdash__share-title">Unique link ready</h2>
      <p class="ma-hint" style="margin-top:0">For <strong><%= _picked.name || 'customer' %></strong>. They share this to earn a giveaway or your reward — you see who they bring.</p>
      <label class="ma-label" for="maRefLinkUrl2">Their unique referral link</label>
      <div class="ma-link-box">
        <code id="maRefLinkUrl2"><%= _picked.url %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= _picked.url %>"><%- icons.copy %> Copy</button>
      </div>
      <div class="ma-refdash__share-row">
        <% if (_picked.phone) { %>
        <a class="ma-btn ma-btn--sm" href="sms:<%= String(_picked.phone).replace(/[^0-9+]/g, '') %>?&body=<%= encodeURIComponent(_picked.smsText || ('Share this link: ' + _picked.url)) %>"><%- icons.sms %> Text link</a>
        <% } %>
        <a class="ma-btn ma-btn--sm ma-btn--soft" href="<%= base %>/send?view=board&customer=<%= encodeURIComponent(_picked.customerId) %>">See board</a>
      </div>
      <p class="ma-hint" style="margin-bottom:0">Clicks: <strong><%= _picked.clicks || 0 %></strong> · Referrals: <strong><%= _picked.referrals || 0 %></strong></p>
    </section>
    <% } else if (_pickId) { %>
    <p class="ma-flash ma-flash--err">Could not build a link for that customer. Try another contact.</p>
    <% } %>

    <% } else { %>
    <p class="ma-page-sub">It goes to the network member for that trade in the customer's area, and they get a text right away. When they close the job, you earn credits on your ads account.</p>

    <% const fv = formValues || {}; %>
    <form method="post" action="<%= base %>/send" class="ma-card" autocomplete="off">
      <div class="ma-field">
        <label class="ma-label" for="sdTrade">What do they need?</label>
        <select id="sdTrade" name="tradeSlug" class="ma-select" required>
          <option value="">Pick a trade…</option>
          <% directory.forEach(function (t) { %>
          <option value="<%= t.slug %>" <%= fv.tradeSlug === t.slug ? 'selected' : '' %>><%= t.name %><%= t.holders.length ? ' · ' + t.holders.slice(0, 2).join(', ') : '' %></option>
          <% }); %>
        </select>
      </div>
      <div class="ma-field">
        <label class="ma-label" for="sdName">Customer name</label>
        <input id="sdName" name="name" class="ma-input" value="<%= fv.name || '' %>" required autocomplete="off" autocapitalize="words">
      </div>
      <div class="ma-grid2">
        <div class="ma-field">
          <label class="ma-label" for="sdPhone">Phone</label>
          <input id="sdPhone" name="phone" type="tel" inputmode="tel" class="ma-input" value="<%= fv.phone || '' %>" autocomplete="off">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="sdZip">ZIP</label>
          <input id="sdZip" name="zip" inputmode="numeric" maxlength="10" class="ma-input" value="<%= fv.zip || '' %>" autocomplete="off">
        </div>
      </div>
      <div class="ma-field">
        <label class="ma-label" for="sdAddress">Street address</label>
        <input id="sdAddress" name="address" class="ma-input" value="<%= fv.address || '' %>" autocomplete="off">
      </div>
      <div class="ma-grid2">
        <div class="ma-field">
          <label class="ma-label" for="sdCity">City</label>
          <input id="sdCity" name="city" class="ma-input" value="<%= fv.city || '' %>" autocomplete="off">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="sdEmail">Email</label>
          <input id="sdEmail" name="email" type="email" inputmode="email" class="ma-input" value="<%= fv.email || '' %>" autocomplete="off">
        </div>
      </div>
      <div class="ma-field">
        <label class="ma-label" for="sdNote">Notes</label>
        <textarea id="sdNote" name="note" class="ma-textarea" maxlength="1000" placeholder="e.g. Water heater leaking, wants a quote this week"><%= fv.note || '' %></textarea>
      </div>
      <label class="ma-check">
        <input type="checkbox" name="consent" value="on" required <%= fv.consent ? 'checked' : '' %>>
        <span>The customer agreed to be contacted by a network member.</span>
      </label>
      <button type="submit" class="ma-btn ma-btn--block" <%= member.status !== 'active' ? 'disabled' : '' %>><%- icons.send %> Send referral</button>
    </form>
    <% } %>
    <% } %>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
