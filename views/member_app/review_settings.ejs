<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Review settings' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', {
      topBack: { href: base + '/review', label: 'Review' },
      topSettings: { href: base + '/review/settings', label: 'Review settings', on: true }
    }) %>
    <h1 class="ma-page-title">Review settings</h1>
    <p class="ma-page-sub">Logo, review links, and the photo shown when your link is shared.</p>

    <%- include('_flash') %>

    <% const _needLinks = !linkCount; %>
    <% const _hasLogo = typeof hasCustomLogo !== 'undefined' && hasCustomLogo; %>

    <section class="ma-card" id="maReviewReward">
      <h2 style="font-size:16px;margin:0 0 6px">Referral SMS &amp; reward</h2>
      <p class="ma-hint" style="margin-top:0">Edit the unique-link SMS script and reward offer under Referrals → <strong>Request</strong> (SMS script fold).</p>
      <a class="ma-btn ma-btn--block ma-btn--soft" href="<%= base %>/send?view=request&amp;setup=1"><%- icons.send %> Open SMS script &amp; reward</a>
    </section>

    <section class="ma-card" id="maReviewAi">
      <h2 style="font-size:16px;margin:0 0 6px">AI review requests</h2>
      <p class="ma-hint" style="margin-top:0">Connect ChatGPT, Muse, or Grok so you can ask them to text customers for a review — plus GHL job-complete automation.</p>
      <a class="ma-btn ma-btn--block ma-btn--soft" href="<%= base %>/review/ai"><%- icons.review %> Set up AI reviews</a>
    </section>

    <section class="ma-card" id="maReviewLogo">
      <h2 style="font-size:16px;margin:0 0 6px">Request page profile</h2>
      <p class="ma-hint" style="margin-top:0">Same image as your <a href="<%= base %>/profile">Profile photo</a> in the top bar — shown when customers open your review link.</p>
      <% const _hasProfile = typeof hasProfilePhoto !== 'undefined' && hasProfilePhoto; %>
      <% const _previewLogo = typeof requestLogoUrl !== 'undefined' && requestLogoUrl ? requestLogoUrl : ''; %>
      <% if (_previewLogo) { %>
      <img class="rv-logo" src="<%= _previewLogo %>" alt="<%= member.companyName %> logo" style="margin:8px auto 12px">
      <% } else { %>
      <div class="rv-initials" aria-hidden="true" style="margin:8px auto 12px"><%= (member.companyName || '?').trim().charAt(0).toUpperCase() %></div>
      <% } %>
      <% if (_hasProfile) { %>
      <p class="ma-hint" style="text-align:center">Change it anytime under <a href="<%= base %>/profile">Profile &amp; settings</a>.</p>
      <% } else { %>
      <p class="ma-hint" style="text-align:center">No Profile photo yet — add one on Profile, or upload a logo here as a fallback.</p>
      <form method="post" action="<%= base %>/review/logo" enctype="multipart/form-data" autocomplete="off">
        <div class="ma-field">
          <label class="ma-label" for="rvRequestLogo">Upload logo</label>
          <input id="rvRequestLogo" name="logo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="ma-input" required>
        </div>
        <button type="submit" class="ma-btn ma-btn--soft ma-btn--block">Save logo</button>
      </form>
      <% if (_hasLogo) { %>
      <form method="post" action="<%= base %>/review/logo" style="margin-top:8px" data-ma-confirm="Remove your custom logo from the review request page?">
        <input type="hidden" name="remove" value="1">
        <button type="submit" class="ma-btn ma-btn--ghost ma-btn--block">Remove logo</button>
      </form>
      <% } %>
      <% } %>
    </section>

    <section class="ma-card" id="maReviewLinks">
      <h2 style="font-size:16px;margin:0 0 6px">Your review links</h2>
      <form method="post" action="<%= base %>/review" autocomplete="off">
        <input type="hidden" name="next" value="settings">
        <p class="ma-hint" style="margin-top:0">Fill in the sites you're on. Leave the rest blank.</p>
        <% if (_needLinks) { %>
        <p class="ma-flash ma-flash--err">Add at least one link so customers can leave a review after scanning your QR.</p>
        <% } %>
        <% platforms.forEach(function (p) { %>
        <div class="ma-field">
          <label class="ma-label rv-field-label" for="rv-<%= p.key %>">
            <span class="rv-field-badge" style="background: <%= p.tile || '#fff' %>" aria-hidden="true">
              <% if (p.icon) { %><%- p.icon %><% } else { %><%= p.letter %><% } %>
            </span><%= p.field %>
          </label>
          <input id="rv-<%= p.key %>" name="<%= p.key %>" type="url" inputmode="url" class="ma-input" value="<%= member.reviewLinks[p.key] || '' %>" placeholder="<%= p.placeholder %>">
          <% if (p.hint) { %><p class="ma-hint"><%= p.hint %></p><% } %>
        </div>
        <% }); %>
        <div class="ma-section__head" style="margin-top:8px"><h2 style="font-size:15px">Other review sites</h2></div>
        <% otherRows.forEach(function (o, i) { %>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="rvOtherLabel<%= i %>">Site name</label>
            <input id="rvOtherLabel<%= i %>" name="otherLabel" class="ma-input" value="<%= o.label %>" placeholder="e.g. HomeAdvisor" maxlength="40">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvOtherUrl<%= i %>">Link</label>
            <input id="rvOtherUrl<%= i %>" name="otherUrl" type="url" inputmode="url" class="ma-input" value="<%= o.url %>" placeholder="https://">
          </div>
        </div>
        <% }); %>
        <button type="submit" class="ma-btn ma-btn--block">Save links</button>
      </form>
    </section>

    <section class="ma-card" id="maPreviewImage">
      <h2 style="font-size:16px;margin:0 0 6px">Default preview image</h2>
      <p class="ma-hint" style="margin-top:0">Shown when your review link is shared in Messages. Uses your Home banner (van / photo) unless you upload a custom preview. <span class="ma-fold__hint" style="display:inline;margin:0"><%= typeof hasCustomShareImage !== 'undefined' && hasCustomShareImage ? 'custom' : 'Home banner' %></span></p>
      <img class="ma-share-preview" src="<%= typeof shareImagePath !== 'undefined' ? shareImagePath : (reviewPath + '/og.jpg') %>" alt="Link preview" width="600" height="315" style="width:100%;max-width:100%;height:auto;border-radius:14px;display:block;background:#0f172a">
      <form method="post" action="<%= base %>/review/share-image" enctype="multipart/form-data" autocomplete="off" style="margin-top:12px">
        <input type="hidden" name="next" value="settings">
        <div class="ma-field">
          <label class="ma-label" for="rvDefaultShareImage">Upload default photo</label>
          <input id="rvDefaultShareImage" name="shareImage" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="ma-input" required>
        </div>
        <button type="submit" class="ma-btn ma-btn--soft ma-btn--block">Save as default preview</button>
      </form>
      <% if (typeof hasCustomShareImage !== 'undefined' && hasCustomShareImage) { %>
      <form method="post" action="<%= base %>/review/share-image" style="margin-top:8px" data-ma-confirm="Remove your custom preview image and use your Home banner instead?">
        <input type="hidden" name="next" value="settings">
        <input type="hidden" name="remove" value="1">
        <button type="submit" class="ma-btn ma-btn--ghost ma-btn--block">Use Home banner instead</button>
      </form>
      <% } %>
    </section>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
