<%
  const _grPaid = typeof googleReviewsPaid !== 'undefined' && googleReviewsPaid;
  const _grLocked = typeof googleReviewsLocked !== 'undefined' ? googleReviewsLocked : !_grPaid;
  const _grSummary = typeof googleReviewsSummary !== 'undefined' && googleReviewsSummary
    ? googleReviewsSummary
    : { total: 0, newCount: 0, unreplied: 0, placeRating: null, lastSyncedAt: null, lastError: null, placeName: '' };
  const _grSettings = typeof googleReviewsSettings !== 'undefined' && googleReviewsSettings
    ? googleReviewsSettings
    : { query: '', businessName: '', autoSync: true };
  const _grReviews = Array.isArray(typeof googleReviews !== 'undefined' ? googleReviews : null) ? googleReviews : [];
  const _grOut = typeof googleReviewsOutscraper !== 'undefined' && googleReviewsOutscraper;
  const _grFocus = typeof googleReviewFocusId !== 'undefined' ? String(googleReviewFocusId || '') : '';
  const _grRequestLink = typeof googleReviewsRequestLink !== 'undefined'
    ? String(googleReviewsRequestLink || '')
    : '';
  const _yelpRequestLink = typeof yelpReviewsRequestLink !== 'undefined'
    ? String(yelpReviewsRequestLink || '')
    : '';
  const _grHasGoogleSite = !!_grRequestLink;
  const _grHasYelpSite = !!_yelpRequestLink;
  const _grHasAnySite = _grHasGoogleSite || _grHasYelpSite;
  // Tab mode (Reviews page) skips the fold; legacy fold auto-opens for upgrade/focus/new.
  const _grTab = typeof googleReviewsTabMode !== 'undefined' && googleReviewsTabMode;
  const _grOpen = _grFocus || _grLocked || (_grPaid && _grSummary.newCount > 0);
  const _pageStats = typeof reviewPageStats !== 'undefined' && reviewPageStats
    ? reviewPageStats
    : { views: 0, clicks: 0, stars: {}, totalStars: 0, feedback: [] };
  const _pageViews = Number(_pageStats.views || 0) || 0;
  const _pageClicks = Number(_pageStats.clicks || 0) || 0;
  const _pageStars = _pageStats.stars && typeof _pageStats.stars === 'object' ? _pageStats.stars : {};
  const _pageTotalStars = Number(_pageStats.totalStars || 0) || 0;
  const _pageFeedback = Array.isArray(_pageStats.feedback) ? _pageStats.feedback : [];
  const _showCombinedStats = _grTab || _grSummary.placeRating != null || _grSummary.total;
%>
<% if (!_grTab) { %>
<details class="ma-fold" id="maGoogleReviews" <%= _grOpen ? 'open' : '' %>>
  <summary>
    Google &amp; Yelp reviews
    <span class="ma-fold__hint">
      <% if (_grLocked) { %>monthly plan
      <% } else if (!_grHasAnySite) { %>add Google or Yelp link
      <% } else if (_grSummary.newCount) { %><%= _grSummary.newCount %> new
      <% } else if (_grSummary.total) { %><%= _grSummary.total %> synced
      <% } else { %>Outscraper inbox<% } %>
    </span>
  </summary>
  <div class="ma-fold__body">
<% } else { %>
<section id="maGoogleReviews" class="ma-gr-tab" aria-label="Google and Yelp reviews">
<% } %>
    <% if (_grLocked) { %>
    <% if (_grTab) { %>
    <div class="ma-card ma-card--flush" style="margin-bottom:10px" aria-label="Review results">
      <p class="ma-hint" style="margin-top:0"><%= _pageViews %> visits · <%= _pageClicks %> clicks from your request page</p>
      <div class="ma-kpis" style="margin-bottom:10px">
        <div class="ma-kpi"><strong><%= _pageViews %></strong><span>Page visits</span></div>
        <div class="ma-kpi"><strong><%= _pageClicks %></strong><span>Went to review</span></div>
        <div class="ma-kpi"><strong><%= _pageFeedback.length %></strong><span>Private notes</span></div>
      </div>
      <div class="ma-bars">
        <% [5, 4, 3, 2, 1].forEach(function (s) { const n = _pageStars[s] || 0; %>
        <div class="ma-bar">
          <span><%= s %> ★</span>
          <span class="ma-bar__track"><span class="ma-bar__fill" style="width: <%= _pageTotalStars ? Math.round((n / _pageTotalStars) * 100) : 0 %>%"></span></span>
          <span style="text-align:right"><%= n %></span>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="ma-card ma-card--flush" style="margin-bottom:10px" id="maSeoRankCta" aria-label="Google Business Rank">
      <h2 style="font-size:16px;margin:0 0 6px">Google Business Rank</h2>
      <p class="ma-hint" style="margin:0 0 12px">See where you stand on Google Maps and get a plan to climb.</p>
      <a class="ma-btn ma-btn--block" href="https://adhello.io/seo-rank" target="_blank" rel="noopener noreferrer">Get Google Business Rank <span aria-hidden="true">↗</span></a>
    </div>
    <% } %>
    <%- include('_upgrade_gate', {
      upgradeTitle: 'See Google & Yelp reviews & reply with AI',
      upgradeBody: 'On the monthly plan we pull your Google and Yelp reviews with Outscraper, notify you when a new one lands, and draft a reply you can copy into Google or Yelp.',
      upgradeHref: base + '/join',
      upgradeIcon: 'review',
    }) %>
    <% } else { %>
    <div class="ma-card ma-card--flush" style="margin-bottom:10px"<%= _grTab ? ' aria-label="Review results"' : '' %>>
      <p class="ma-hint" style="margin-top:0">We sync from your <strong>Google</strong> and <strong>Yelp</strong> links under Review → Settings (request sites). New reviews ping your bell — then draft an AI reply and copy it back to that site.</p>
      <% if (_grSummary.placeName) { %>
      <p class="ma-gr-place">For <strong><%= _grSummary.placeName %></strong></p>
      <% } %>
      <% if (_showCombinedStats) { %>
      <div class="ma-kpis" style="margin-bottom:10px" aria-label="Review stats">
        <% if (_grTab) { %>
        <div class="ma-kpi"><strong><%= _pageViews %></strong><span>Page visits</span></div>
        <div class="ma-kpi"><strong><%= _pageClicks %></strong><span>Went to review</span></div>
        <div class="ma-kpi"><strong><%= _pageFeedback.length %></strong><span>Private notes</span></div>
        <% } %>
        <div class="ma-kpi"><strong><%= _grSummary.total %></strong><span>In inbox</span></div>
        <div class="ma-kpi"><strong><%= _grSummary.newCount %></strong><span>New</span></div>
        <div class="ma-kpi"><strong><% if (_grSummary.placeRating != null) { %><%= Number(_grSummary.placeRating).toFixed(1) %>★<% } else { %>—<% } %></strong><span>Rating</span></div>
      </div>
      <% if (_grTab) { %>
      <div class="ma-bars" style="margin-bottom:12px">
        <% [5, 4, 3, 2, 1].forEach(function (s) { const n = _pageStars[s] || 0; %>
        <div class="ma-bar">
          <span><%= s %> ★</span>
          <span class="ma-bar__track"><span class="ma-bar__fill" style="width: <%= _pageTotalStars ? Math.round((n / _pageTotalStars) * 100) : 0 %>%"></span></span>
          <span style="text-align:right"><%= n %></span>
        </div>
        <% }); %>
      </div>
      <div style="margin:0 0 12px" id="maSeoRankCta" aria-label="Google Business Rank">
        <a class="ma-btn ma-btn--block" href="https://adhello.io/seo-rank" target="_blank" rel="noopener noreferrer">Get Google Business Rank <span aria-hidden="true">↗</span></a>
        <p class="ma-hint" style="margin:8px 0 0;text-align:center">See where you stand on Google Maps and how to climb.</p>
      </div>
      <% if (_pageFeedback.length) { %>
      <div class="ma-section__head" style="margin:0 0 8px"><h2 style="font-size:15px;margin:0">Private feedback</h2></div>
      <% _pageFeedback.forEach(function (f) { %>
      <div class="ma-card ma-card--flush" style="margin-bottom:8px;border:1px solid var(--line)">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= f.name || 'Customer' %> · <%= '★'.repeat(f.rating || 0) %></p>
            <p class="ma-card__meta"><% if (f.phone) { %><a href="tel:<%= String(f.phone).replace(/[^0-9+]/g, '') %>" style="color:var(--acc);font-weight:700;text-decoration:none"><%= f.phone %></a> · <% } %><%= f.email ? f.email + ' · ' : '' %><%= f.when %></p>
          </div>
        </div>
        <p class="ma-card__note"><%= f.message %></p>
      </div>
      <% }); %>
      <% } %>
      <% } %>
      <% } %>
      <% if (!_grOut) { %>
      <p class="ma-flash ma-flash--err" style="margin:0 0 10px">AdHello Outscraper isn’t ready yet. Try again shortly or contact support.</p>
      <% } %>
      <% if (_grSummary.lastError) { %>
      <p class="ma-flash ma-flash--err" style="margin:0 0 10px"><%= _grSummary.lastError %></p>
      <% } %>
      <form id="maGrSettings" autocomplete="off">
        <div class="ma-field">
          <label class="ma-label">Google request-site link</label>
          <% if (_grHasGoogleSite) { %>
          <p class="ma-gr-link"><%= _grRequestLink %></p>
          <% } else { %>
          <p class="ma-hint">Not set — add it in <a href="<%= base %>/review/settings">Review settings</a>.</p>
          <% } %>
        </div>
        <div class="ma-field">
          <label class="ma-label">Yelp request-site link</label>
          <% if (_grHasYelpSite) { %>
          <p class="ma-gr-link"><%= _yelpRequestLink %></p>
          <% } else { %>
          <p class="ma-hint">Not set — add it in <a href="<%= base %>/review/settings">Review settings</a>.</p>
          <% } %>
        </div>
        <% if (!_grHasAnySite) { %>
        <p class="ma-flash ma-flash--err" id="maGrNeedSitesNag" style="margin:0 0 8px">Add a Google and/or Yelp review link in <a href="<%= base %>/review/settings">Review settings</a> (request sites) first.</p>
        <% } else { %>
        <p class="ma-hint">Change links in <a href="<%= base %>/review/settings">Review settings</a> if the wrong business shows up.</p>
        <% } %>
        <label class="ma-check" style="display:flex;gap:10px;align-items:flex-start;margin:4px 0 12px">
          <input type="checkbox" name="autoSync" value="1" <%= _grSettings.autoSync !== false ? 'checked' : '' %> style="margin-top:3px">
          <span>Auto-sync &amp; notify me on new reviews</span>
        </label>
        <div class="ma-actions" style="margin:0">
          <button type="button" class="ma-btn ma-btn--soft" id="maGrSave">Save</button>
          <button type="button" class="ma-btn" id="maGrSync" <%= _grOut && _grHasAnySite ? '' : 'disabled' %>>Sync now</button>
        </div>
        <p class="ma-hint" id="maGrStatus" role="status" style="margin:8px 0 0;min-height:1.2em">
          <% if (_grSummary.lastSyncedAt) { %>Last sync · <%= _grSummary.lastSyncedAt.slice(0, 16).replace('T', ' ') %> UTC<% } %>
        </p>
      </form>
    </div>

    <% if (!_grReviews.length) { %>
    <div class="ma-card ma-card--flush ma-empty">
      <p>No reviews synced yet. Confirm your Google and/or Yelp request-site links, then tap <strong>Sync now</strong>.</p>
    </div>
    <% } else { %>
    <div id="maGrList">
      <% _grReviews.forEach(function (r) {
        var _focus = _grFocus && _grFocus === r.id;
        var _src = String(r.source || 'google').toLowerCase() === 'yelp' ? 'yelp' : 'google';
        var _srcLabel = _src === 'yelp' ? 'Yelp' : 'Google';
        var _pasteWhere = _src === 'yelp' ? 'Yelp' : 'Google';
      %>
      <div class="ma-card ma-card--flush ma-gr-card" style="margin-bottom:8px<%= r.isNew ? ';border-color:rgba(16,185,129,.45)' : '' %><%= _focus ? ';box-shadow:0 0 0 2px var(--acc)' : '' %>" data-gr-id="<%= r.id %>" id="gr-<%= r.id %>">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title ma-gr-author">
              <span class="ma-gr-source ma-gr-source--<%= _src %>"><%= _srcLabel %></span>
              <%= r.rating != null ? r.rating + '★' : 'Review' %> · <%= r.author || (_srcLabel + ' reviewer') %>
              <% if (r.isNew) { %> <span class="ma-fold__hint" style="color:#059669;font-weight:800">NEW</span><% } %>
            </p>
            <% if (r.reviewedAt) { %><p class="ma-card__meta"><%= String(r.reviewedAt).slice(0, 10) %></p><% } %>
          </div>
          <% if (!r.ownerResponse) { %>
          <span class="ma-fold__hint" style="margin:0;color:#b45309;font-weight:800">Needs reply</span>
          <% } %>
        </div>
        <% if (r.text) { %>
        <p class="ma-gr-review"><%= r.text %></p>
        <% } else { %>
        <p class="ma-card__meta" style="font-style:italic">Rating only — no written comment.</p>
        <% } %>
        <div style="margin-top:10px" data-gr-reply>
          <label class="ma-label" for="gr-draft-<%= r.id %>">AI reply draft</label>
          <textarea id="gr-draft-<%= r.id %>" class="ma-textarea ma-gr-draft" rows="3" data-gr-draft maxlength="3500" placeholder="Generate a reply, tweak it, then copy into <%= _pasteWhere %>."><%= r.replyDraft || '' %></textarea>
          <div class="ma-actions" style="margin:8px 0 0">
            <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-gr-generate="<%= r.id %>">Generate with AI</button>
            <button type="button" class="ma-btn ma-btn--sm" data-gr-copy="<%= r.id %>" data-gr-platform="<%= _pasteWhere %>" <%= r.replyDraft ? '' : 'disabled' %>><%- icons.copy %> Copy reply</button>
          </div>
          <p class="ma-hint" data-gr-msg role="status" aria-live="polite" style="margin:6px 0 0;min-height:1.1em"></p>
        </div>
      </div>
      <% }); %>
    </div>
    <% if (_grSummary.newCount) { %>
    <button type="button" class="ma-btn ma-btn--ghost ma-btn--block" id="maGrMarkSeen" style="margin-top:4px">Mark all seen</button>
    <% } %>
    <% } %>

    <script>
    (function () {
      var base = <%- JSON.stringify(base) %>;
      var statusEl = document.getElementById('maGrStatus');
      function setStatus(msg, isErr) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.style.color = isErr ? '#b91c1c' : '';
      }
      function payload() {
        var a = document.querySelector('#maGrSettings [name=autoSync]');
        return {
          autoSync: !!(a && a.checked),
          force: true
        };
      }
      async function post(path, body) {
        var res = await fetch(base + path, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: body ? JSON.stringify(body) : '{}'
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || data.success === false) throw new Error(data.error || 'Request failed');
        return data;
      }
      var needSitesKey = 'ma-gr-need-sites-nag:' + base;
      var needSitesNag = document.getElementById('maGrNeedSitesNag');
      function hideNeedSitesNag(persist) {
        if (!needSitesNag) return;
        needSitesNag.hidden = true;
        if (persist) {
          try { localStorage.setItem(needSitesKey, '1'); } catch (e) {}
        }
      }
      function restoreNeedSitesNagDismiss() {
        if (!needSitesNag) return;
        try {
          if (localStorage.getItem(needSitesKey) === '1') needSitesNag.hidden = true;
        } catch (e) {}
      }
      restoreNeedSitesNagDismiss();
      var saveBtn = document.getElementById('maGrSave');
      if (saveBtn) saveBtn.addEventListener('click', async function () {
        saveBtn.disabled = true;
        try {
          await post('/review/google-reviews/settings', payload());
          setStatus('Saved.');
          // Hide the request-site nag after saving notify prefs; it returns when they open Review settings.
          hideNeedSitesNag(true);
        } catch (e) { setStatus(e.message || 'Save failed', true); }
        saveBtn.disabled = false;
      });
      var syncBtn = document.getElementById('maGrSync');
      if (syncBtn) syncBtn.addEventListener('click', async function () {
        syncBtn.disabled = true;
        setStatus('Syncing Google & Yelp from your request-site links…');
        try {
          var data = await post('/review/google-reviews/sync', payload());
          setStatus(data.newCount ? (data.newCount + ' new review' + (data.newCount === 1 ? '' : 's')) : (data.skipped ? 'Already up to date' : 'Synced'));
          location.reload();
        } catch (e) {
          setStatus(e.message || 'Sync failed', true);
          syncBtn.disabled = false;
        }
      });
      var seenBtn = document.getElementById('maGrMarkSeen');
      if (seenBtn) seenBtn.addEventListener('click', async function () {
        seenBtn.disabled = true;
        try {
          await post('/review/google-reviews/mark-all-seen');
          location.reload();
        } catch (e) {
          setStatus(e.message || 'Failed', true);
          seenBtn.disabled = false;
        }
      });
      document.querySelectorAll('[data-gr-generate]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          if (btn.getAttribute('aria-busy') === 'true') return;
          var id = btn.getAttribute('data-gr-generate');
          var box = btn.closest('[data-gr-reply]');
          var ta = box && box.querySelector('[data-gr-draft]');
          var msg = box && box.querySelector('[data-gr-msg]');
          var copy = box && box.querySelector('[data-gr-copy]');
          var platform = (copy && copy.getAttribute('data-gr-platform')) || 'Google';
          var label = btn.textContent;
          btn.setAttribute('aria-busy', 'true');
          btn.disabled = true;
          btn.textContent = 'Generating…';
          if (ta) {
            ta.readOnly = true;
            ta.setAttribute('aria-busy', 'true');
          }
          if (msg) {
            msg.textContent = 'Writing reply…';
            msg.classList.add('ma-gr-msg--busy');
            msg.removeAttribute('data-err');
          }
          try {
            var data = await post('/review/google-reviews/' + encodeURIComponent(id) + '/draft-reply', {});
            if (ta) ta.value = data.reply || '';
            if (copy) copy.disabled = !data.reply;
            if (msg) {
              msg.textContent = data.reply
                ? ('Draft ready — copy and paste into ' + platform + '.')
                : 'No draft returned — try again.';
              msg.classList.remove('ma-gr-msg--busy');
            }
          } catch (e) {
            if (msg) {
              msg.textContent = e.message || 'AI draft failed';
              msg.classList.remove('ma-gr-msg--busy');
              msg.setAttribute('data-err', '1');
            }
          } finally {
            btn.removeAttribute('aria-busy');
            btn.disabled = false;
            btn.textContent = label;
            if (ta) {
              ta.readOnly = false;
              ta.removeAttribute('aria-busy');
            }
          }
        });
      });
      document.querySelectorAll('[data-gr-copy]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var box = btn.closest('[data-gr-reply]');
          var ta = box && box.querySelector('[data-gr-draft]');
          var msg = box && box.querySelector('[data-gr-msg]');
          var text = ta ? String(ta.value || '').trim() : '';
          if (!text) return;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(text);
            else { ta.focus(); ta.select(); document.execCommand('copy'); }
            var platform = btn.getAttribute('data-gr-platform') || 'Google';
            if (msg) msg.textContent = 'Copied — paste into your ' + platform + ' reply.';
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.innerHTML = btn.getAttribute('data-label') || 'Copy reply'; }, 1600);
          } catch (e) {
            if (msg) msg.textContent = 'Copy failed — select the text and copy manually.';
          }
        });
      });
      var focusId = <%- JSON.stringify(_grFocus) %>;
      if (focusId) {
        var node = document.getElementById('gr-' + focusId);
        if (node) setTimeout(function () { node.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 120);
      }
    })();
    </script>
    <% } %>
<% if (!_grTab) { %>
  </div>
</details>
<% } else { %>
</section>
<% } %>
