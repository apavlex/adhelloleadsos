<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Reviews' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Review', topSettings: { href: base + '/review/settings', label: 'Review settings' } }) %>
    <h1 class="ma-page-title">Show your QR</h1>
    <p class="ma-page-sub">Let the customer scan to leave a review — or text them a link below.</p>

    <%- include('_flash') %>

    <% const _msg = typeof messaging !== 'undefined' && messaging ? messaging : { configured: false, smsReady: false, emailReady: false }; %>
    <% const _fv = typeof formValues !== 'undefined' && formValues ? formValues : { phone: '', email: '', name: '', channel: 'auto', useAi: true }; %>
    <% const _script = typeof smsScript !== 'undefined' ? smsScript : ''; %>
    <% const _needLinks = !linkCount; %>
    <% const _askOpen = typeof askShare !== 'undefined' && askShare; %>

    <% if (!(typeof rewardLocked !== 'undefined' && rewardLocked)) { %>
    <%- include('_review_reward_confirm', {
      pendingRewards: typeof pendingRewards !== 'undefined' ? pendingRewards : [],
      rewardReturnTo: base + '/review',
    }) %>
    <% } %>

    <section class="ma-card ma-qr" style="margin-top:4px" aria-label="Share and QR code">
      <% if (_needLinks) { %>
      <p class="ma-flash ma-flash--err" style="margin:0 0 12px;width:100%;text-align:left">Add your review links in <a href="<%= base %>/review/settings" style="color:inherit;font-weight:800">Settings</a> so the QR can send customers to the right places.</p>
      <% } %>
      <%
        const _shareText = typeof shareSmsText !== 'undefined' && shareSmsText
          ? shareSmsText
          : ('Hi — thanks for choosing ' + (member.companyName || 'us') + '! Leave a quick review.');
        const _scriptWantsLink = /{{\s*(review_link|review_url|link)\s*}}/i.test(_script || '') || /https?:\/\/\S+/i.test(_script || '');
        const _kwShare = typeof keywordDefaults !== 'undefined' && keywordDefaults
          ? keywordDefaults
          : { jobTitle: '', city: '', keywords: '' };
        const _sharePayload = {
          // Only expose the review URL when the script asks for it — keeps stale
          // clients from attaching a Messages preview the author did not want.
          url: _scriptWantsLink ? reviewUrl : '',
          title: 'Leave ' + (member.companyName || 'us') + ' a review',
          text: _shareText,
          company: member.companyName || 'us',
          script: _script,
          // Defaults for Request-a-review (Messages) when no customer is picked.
          jobTitle: (typeof keywordJobTitle !== 'undefined' && keywordJobTitle) || _kwShare.jobTitle || '',
          city: (typeof keywordCity !== 'undefined' && keywordCity) || _kwShare.city || '',
          keywords: (typeof keywordHint !== 'undefined' && keywordHint) || _kwShare.keywords || '',
        };
      %>
      <script type="application/json" id="maRequestReviewPayload"><%- JSON.stringify(_sharePayload).replace(/</g, '\\u003c') %></script>
      <button
        type="button"
        class="ma-btn ma-btn--block ma-qr__ask"
        id="maAskReview"
        data-ma-request-review
        data-ma-request-review-payload="maRequestReviewPayload"
        aria-label="Request a review — opens Messages"
      >
        <%- icons.sms %> Request a review
      </button>
      <p class="ma-hint ma-qr__ask-hint">Uses your SMS script (keywords filled from defaults above). The review link is placed at the end so Messages can show the preview image.</p>
      <img src="<%= reviewPath %>/qr.png" alt="QR code for your review page" width="220" height="220" style="margin-top:14px">
      <div class="ma-link-box">
        <code id="rvLink"><%= reviewUrl %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= reviewUrl %>"><%- icons.copy %> Copy</button>
      </div>
      <div class="ma-actions" style="justify-content:center;width:100%">
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= reviewPath %>/qr.png?download=1" download><%- icons.download %> Download QR</a>
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= base %>/review/preview">Preview</a>
      </div>
    </section>

    <%- include('_google_reviews') %>

    <% const _sendLocked = typeof reviewSendLocked !== 'undefined' && reviewSendLocked; %>
    <% /* Only open when ?ask=1 (customer deep-link). Default Review landing stays on QR. */ %>
    <details class="ma-fold" id="maAskForm" <%= !_sendLocked && _askOpen ? 'open' : '' %>>
      <summary>Send review request <span class="ma-fold__hint">text or email · GHL CRM</span></summary>
      <div class="ma-fold__body">
        <% if (_sendLocked) { %>
        <%- include('_upgrade_gate', {
          upgradeTitle: 'Send reviews by text or email',
          upgradeBody: 'Free members can share their link or QR. Upgrade and connect GHL CRM to text or email review requests from the app.',
          upgradeHref: typeof upgradeHref !== 'undefined' ? upgradeHref : '/signup',
          upgradeIcon: 'review',
        }) %>
        <% } else { %>
        <form method="post" action="<%= base %>/review/send" enctype="multipart/form-data" class="ma-card ma-card--flush" autocomplete="off">
          <% if (!_msg.configured) { %>
          <p class="ma-flash ma-flash--err">GHL CRM isn’t connected on this workspace yet. Connect it in Workspace → Integrations (this app uses that same connection).</p>
          <% } else if (!_msg.smsReady && !_msg.emailReady) { %>
          <p class="ma-flash ma-flash--err">Your workspace GHL CRM is connected, but SMS from number and outbound email still need to be set in Workspace → Integrations.</p>
          <% } %>
          <% if (_needLinks) { %>
          <p class="ma-flash ma-flash--err">Add at least one review link in Settings before sending.</p>
          <% } %>
          <%
            const _custs = typeof customers !== 'undefined' && Array.isArray(customers) ? customers : [];
            const _pickCust = _custs.find(function (c) { return c.id === _fv.customerId; }) || null;
            const _custPayload = _custs.map(function (c) {
              return { id: c.id, name: c.name || '', phone: c.phone || '', email: c.email || '' };
            });
          %>
          <% if (_custs.length) { %>
          <div class="ma-field" data-ma-customer-pick>
            <input type="hidden" name="customerId" id="rvAskCustomerId" value="<%= _pickCust ? _pickCust.id : '' %>">
            <div data-ma-ask-search <%= _pickCust ? 'hidden' : '' %>>
              <label class="ma-label" for="rvAskCustomer">Who should we ask?</label>
              <div class="ma-typeahead">
                <input
                  id="rvAskCustomer"
                  type="text"
                  inputmode="search"
                  class="ma-input"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="rvAskCustomerList"
                  placeholder="Search customers or type a new name…"
                  autocomplete="off"
                  autocorrect="off"
                  spellcheck="false"
                  value=""
                >
                <ul id="rvAskCustomerList" class="ma-typeahead__list" role="listbox" hidden></ul>
              </div>
              <p class="ma-hint">Pick a saved customer, or type someone new. <a href="<%= base %>/customers">Manage customers</a></p>
            </div>
            <div class="ma-ask-selected" data-ma-ask-selected <%= _pickCust ? '' : 'hidden' %>>
              <span class="ma-ask-selected__avatar" aria-hidden="true" data-ma-ask-selected-avatar><%= _pickCust && _pickCust.name ? String(_pickCust.name).charAt(0).toUpperCase() : '?' %></span>
              <span class="ma-ask-selected__body">
                <strong data-ma-ask-selected-name><%= _pickCust ? _pickCust.name : '' %></strong>
                <span data-ma-ask-selected-meta><%= _pickCust ? (_pickCust.phone || _pickCust.email || 'Saved customer') : '' %></span>
              </span>
              <button type="button" class="ma-btn ma-btn--sm ma-btn--ghost" data-ma-ask-clear>Change</button>
            </div>
            <script type="application/json" id="rvAskCustomerData"><%- JSON.stringify(_custPayload).replace(/</g, '\\u003c') %></script>
          </div>
          <% } else { %>
          <p class="ma-hint" style="margin-top:0">No saved customers yet. <a href="<%= base %>/customers">Sync from CRM or import a list</a> to pick from your contacts.</p>
          <% } %>
          <div class="ma-field" data-ma-ask-manual <%= _pickCust ? 'hidden' : '' %>>
            <label class="ma-label" for="rvAskName">Name <span class="ma-label__hint">(new person)</span></label>
            <input id="rvAskName" name="name" class="ma-input" maxlength="120" value="<%= _fv.name || (_pickCust && _pickCust.name) || '' %>" autocapitalize="words" <%= !_pickCust && !_needLinks && (_msg.smsReady || _msg.emailReady) ? 'autofocus' : '' %>>
          </div>
          <div class="ma-grid2">
            <div class="ma-field">
              <label class="ma-label" for="rvAskPhone">Mobile</label>
              <input id="rvAskPhone" name="phone" type="tel" inputmode="tel" maxlength="40" class="ma-input" value="<%= _fv.phone || (_pickCust && _pickCust.phone) || '' %>" <%= _msg.smsReady ? '' : 'disabled' %>>
            </div>
            <div class="ma-field">
              <label class="ma-label" for="rvAskEmail">Email</label>
              <input id="rvAskEmail" name="email" type="email" inputmode="email" maxlength="200" class="ma-input" value="<%= _fv.email || (_pickCust && _pickCust.email) || '' %>" <%= _msg.emailReady ? '' : 'disabled' %>>
            </div>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvAskChannel">Send by</label>
            <select id="rvAskChannel" name="channel" class="ma-input">
              <option value="auto" <%= _fv.channel === 'auto' ? 'selected' : '' %>>Text first, then email</option>
              <option value="sms" <%= _fv.channel === 'sms' ? 'selected' : '' %> <%= _msg.smsReady ? '' : 'disabled' %>>Text (GHL CRM SMS)</option>
              <option value="email" <%= _fv.channel === 'email' ? 'selected' : '' %> <%= _msg.emailReady ? '' : 'disabled' %>>Email (GHL CRM)</option>
            </select>
          </div>

          <details class="ma-fold ma-fold--inset">
            <summary>Options <span class="ma-fold__hint">keywords · AI · photo</span></summary>
            <div class="ma-fold__body">
              <%
                const _sendKw = typeof keywordDefaults !== 'undefined' && keywordDefaults ? keywordDefaults : { jobTitle: '', city: '', keywords: '' };
                const _sendJob = _fv.keywordJob != null ? _fv.keywordJob : (typeof keywordJobTitle !== 'undefined' ? keywordJobTitle : _sendKw.jobTitle);
                const _sendCity = _fv.keywordCity != null ? _fv.keywordCity : (typeof keywordCity !== 'undefined' ? keywordCity : _sendKw.city);
                const _sendKeywords = _fv.keywords != null ? _fv.keywords : (_sendKw.keywords || '');
              %>
              <div class="ma-grid2" style="margin-bottom:8px">
                <div class="ma-field" style="margin:0">
                  <label class="ma-label" for="rvAskKeywordJob">Project / job</label>
                  <input id="rvAskKeywordJob" name="keywordJob" class="ma-input<%= _sendJob ? '' : ' ma-input--unset' %>" maxlength="80" placeholder="Type here… e.g. cabinet install" value="<%= _sendJob || '' %>">
                </div>
                <div class="ma-field" style="margin:0">
                  <label class="ma-label" for="rvAskKeywordCity">City</label>
                  <input id="rvAskKeywordCity" name="keywordCity" class="ma-input<%= _sendCity ? '' : ' ma-input--unset' %>" maxlength="40" placeholder="Type here… e.g. Camas" value="<%= _sendCity || '' %>">
                </div>
              </div>
              <div class="ma-field">
                <label class="ma-label" for="rvAskKeywords">Keywords for this send <span class="ma-label__hint">(optional)</span></label>
                <input id="rvAskKeywords" name="keywords" class="ma-input<%= _sendKeywords ? '' : ' ma-input--unset' %>" maxlength="100" placeholder="Leave blank to use job + city" value="<%= _sendKeywords || '' %>">
                <p class="ma-hint">Fills <code>{{keywords}}</code>. Prefills from the customer’s latest job + city, or your SMS script defaults — edit anytime.</p>
              </div>
              <div class="ma-field">
                <label class="ma-label" for="rvAskShareImage">Preview image for this text</label>
                <input id="rvAskShareImage" name="shareImage" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="ma-input">
                <p class="ma-hint">Optional. Leave blank to use your default (or AdHello’s).</p>
              </div>
              <label class="ma-check" style="display:flex;gap:10px;align-items:flex-start;margin:4px 0 10px">
                <input type="checkbox" name="keepShareImage" value="1" style="margin-top:3px">
                <span>Also save this photo as my default preview</span>
              </label>
              <label class="ma-check" style="display:flex;gap:10px;align-items:flex-start;margin:4px 0 4px">
                <input type="hidden" name="useAi" value="0">
                <input type="checkbox" name="useAi" value="1" <%= _fv.useAi === false ? '' : 'checked' %> style="margin-top:3px">
                <span><strong>Use AI</strong> to personalize the script (keeps your review link)</span>
              </label>
            </div>
          </details>

          <button type="submit" class="ma-btn ma-btn--block" id="maAskReviewGhl" style="margin-top:14px" <%= !_needLinks && (_msg.smsReady || _msg.emailReady) && member.status === 'active' ? '' : 'disabled' %>>
            <%- icons.review %> Send review request
          </button>
        </form>
        <% } %>
      </div>
    </details>

    <details class="ma-fold">
      <summary>SMS script <span class="ma-fold__hint">AI starting text</span></summary>
      <div class="ma-fold__body">
        <form method="post" action="<%= base %>/review/script" class="ma-card ma-card--flush" autocomplete="off" data-ma-loading="Saving…">
          <%
            const _kwDefs = typeof keywordDefaults !== 'undefined' && keywordDefaults ? keywordDefaults : { jobTitle: '', city: '', keywords: '' };
            const _kwHint = typeof keywordHint !== 'undefined' && keywordHint ? String(keywordHint) : '';
            const _kwSnippet = typeof keywordsSnippet !== 'undefined' ? String(keywordsSnippet) : ' If you mention {{keywords}}, that helps neighbors find us.';
            const _kwPreview = _kwHint || (
              _kwDefs.keywords ||
              (_kwDefs.jobTitle && _kwDefs.city ? (_kwDefs.jobTitle + ' in ' + _kwDefs.city) : (_kwDefs.jobTitle || (_kwDefs.city ? ('work in ' + _kwDefs.city) : '')))
            );
          %>
          <p class="ma-hint" style="margin-top:0">Request a review uses this text as-is (even before Save). Placeholders: <code>{{name}}</code>, <code>{{company}}</code>, <code>{{review_link}}</code>, <code>{{job}}</code>, <code>{{city}}</code>, <code>{{keywords}}</code>.</p>
          <p class="ma-hint"><strong>How keywords are found:</strong> when you pick a customer we use their latest completed job title + city from their address. Set defaults below for everyone else — then tap <strong>Save script</strong>.</p>
          <p id="rvKeywordsEmptyHint" class="ma-flash ma-flash--err" style="margin:0 0 10px<%= _kwPreview ? ';display:none' : '' %>">Not set yet — type a project and city below (gray example text is only a hint until you type).</p>
          <div class="ma-grid2" style="margin-bottom:10px">
            <div class="ma-field" style="margin:0">
              <label class="ma-label" for="rvKeywordJob">Default project / job</label>
              <input id="rvKeywordJob" name="keywordJob" class="ma-input<%= _kwDefs.jobTitle ? '' : ' ma-input--unset' %>" maxlength="80" placeholder="Type here… e.g. cabinet install" value="<%= _kwDefs.jobTitle || '' %>" autocomplete="off" data-ma-kw-field>
            </div>
            <div class="ma-field" style="margin:0">
              <label class="ma-label" for="rvKeywordCity">Default city</label>
              <input id="rvKeywordCity" name="keywordCity" class="ma-input<%= _kwDefs.city ? '' : ' ma-input--unset' %>" maxlength="40" placeholder="Type here… e.g. Camas" value="<%= _kwDefs.city || '' %>" autocomplete="off" data-ma-kw-field>
            </div>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvKeywords">Keywords phrase <span class="ma-label__hint">(optional override)</span></label>
            <input id="rvKeywords" name="keywords" class="ma-input<%= _kwDefs.keywords ? '' : ' ma-input--unset' %>" maxlength="100" placeholder="Leave blank to use job + city" value="<%= _kwDefs.keywords || '' %>" autocomplete="off" data-ma-kw-field>
            <p class="ma-hint" style="margin:6px 0 0">Preview of <code>{{keywords}}</code>: <strong id="rvKeywordsPreview" data-empty="<%= _kwPreview ? '0' : '1' %>"><%= _kwPreview || 'Not set — type a project + city above' %></strong></p>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvSmsScript">Review request text</label>
            <textarea id="rvSmsScript" name="smsScript" class="ma-textarea" rows="4" maxlength="800" required><%= _script %></textarea>
          </div>
          <div class="ma-actions" style="margin:0 0 10px;flex-wrap:wrap">
            <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" id="rvInsertKeywords"
              data-snippet="<%= _kwSnippet.replace(/"/g, '&quot;') %>">Insert project keywords</button>
          </div>
          <script>
          (function () {
            var btn = document.getElementById('rvInsertKeywords');
            var ta = document.getElementById('rvSmsScript');
            var jobEl = document.getElementById('rvKeywordJob');
            var cityEl = document.getElementById('rvKeywordCity');
            var kwEl = document.getElementById('rvKeywords');
            var preview = document.getElementById('rvKeywordsPreview');
            var emptyHint = document.getElementById('rvKeywordsEmptyHint');
            function phrase() {
              var explicit = kwEl && kwEl.value ? String(kwEl.value).replace(/\s+/g, ' ').trim() : '';
              if (explicit) return explicit.slice(0, 100);
              var job = jobEl && jobEl.value ? String(jobEl.value).replace(/\s+/g, ' ').trim() : '';
              var city = cityEl && cityEl.value ? String(cityEl.value).replace(/\s+/g, ' ').trim() : '';
              if (job && city) return job + ' in ' + city;
              if (job) return job;
              if (city) return 'work in ' + city;
              return '';
            }
            function syncPreview() {
              var p = phrase();
              [jobEl, cityEl, kwEl].forEach(function (el) {
                if (!el) return;
                el.classList.toggle('ma-input--unset', !String(el.value || '').trim());
              });
              if (preview) {
                preview.textContent = p || 'Not set — type a project + city above';
                preview.setAttribute('data-empty', p ? '0' : '1');
              }
              if (emptyHint) emptyHint.style.display = p ? 'none' : '';
            }
            [jobEl, cityEl, kwEl].forEach(function (el) {
              if (el) {
                el.addEventListener('input', syncPreview);
                el.addEventListener('change', syncPreview);
              }
            });
            syncPreview();
            window.addEventListener('pageshow', syncPreview);
            setTimeout(syncPreview, 0);
            if (!btn || !ta) return;
            btn.addEventListener('click', function () {
              var snip = btn.getAttribute('data-snippet') || '';
              if (!snip) return;
              if (/\{\{\s*(job|city|keywords)\s*\}\}/i.test(ta.value)) {
                btn.textContent = 'Already in script';
                return;
              }
              if (!phrase()) {
                syncPreview();
                if (jobEl) jobEl.focus();
                btn.textContent = 'Add job + city first';
                return;
              }
              var base = ta.value.replace(/\s+$/, '');
              ta.value = (base + snip).slice(0, 800);
              ta.focus();
              btn.textContent = 'Added — Save script';
            });
          })();
          </script>
          <div class="ma-script-link">
            <p class="ma-hint" style="margin:0">Your review link (only inserted when the script includes <code>{{review_link}}</code>):</p>
            <code class="ma-script-link__url"><%= typeof reviewUrl !== 'undefined' ? reviewUrl : '' %></code>
          </div>
          <button type="submit" class="ma-btn ma-btn--block ma-script-save">Save script</button>
        </form>
        <% if (typeof ghlWorkflowPrompt !== 'undefined' && ghlWorkflowPrompt) { %>
        <div class="ma-card ma-card--flush" style="margin-top:10px">
          <p class="ma-hint" style="margin-top:0">Paste into GHL CRM Workflow AI to automate post-job review texts.</p>
          <div class="ma-link-box">
            <code id="rvGhlPrompt" style="white-space:pre-wrap;font-size:12px;max-height:140px;overflow:auto"><%= ghlWorkflowPrompt %></code>
            <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy-from="rvGhlPrompt"><%- icons.copy %> Copy for GHL CRM</button>
          </div>
        </div>
        <% } %>
      </div>
    </details>

    <details class="ma-fold">
      <summary>Results <span class="ma-fold__hint"><%= stats.views %> visits · <%= totalClicks %> clicks</span></summary>
      <div class="ma-fold__body">
        <div class="ma-card ma-card--flush">
          <div class="ma-kpis">
            <div class="ma-kpi"><strong><%= stats.views %></strong><span>Page visits</span></div>
            <div class="ma-kpi"><strong><%= totalClicks %></strong><span>Went to review</span></div>
            <div class="ma-kpi"><strong><%= feedback.length %></strong><span>Private notes</span></div>
          </div>
          <div class="ma-bars">
            <% [5, 4, 3, 2, 1].forEach(function (s) { const n = stats.stars[s] || 0; %>
            <div class="ma-bar">
              <span><%= s %> ★</span>
              <span class="ma-bar__track"><span class="ma-bar__fill" style="width: <%= totalStars ? Math.round((n / totalStars) * 100) : 0 %>%"></span></span>
              <span style="text-align:right"><%= n %></span>
            </div>
            <% }); %>
          </div>
        </div>
        <% if (feedback.length) { %>
        <div class="ma-section__head" style="margin-top:14px"><h2 style="font-size:15px">Private feedback</h2></div>
        <% feedback.forEach(function (f) { %>
        <div class="ma-card ma-card--flush" style="margin-bottom:8px">
          <div class="ma-card__row">
            <div style="min-width:0">
              <p class="ma-card__title"><%= f.name || 'Customer' %> · <%= '★'.repeat(f.rating || 0) %></p>
              <p class="ma-card__meta"><% if (f.phone) { %><a href="tel:<%= String(f.phone).replace(/[^0-9+]/g, '') %>" style="color:var(--acc);font-weight:700;text-decoration:none"><%= f.phone %></a> · <% } %><%= f.email ? f.email + ' · ' : '' %><%= f.when %></p>
            </div>
          </div>
          <p class="ma-card__note"><%= f.message %></p>
        </div>
        <% }); %>
        <% } %>
      </div>
    </details>
  </main>
  <%- include('_tabbar') %>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var name = document.getElementById('rvAskName');
    var phone = document.getElementById('rvAskPhone');
    <% if (_askOpen) { %>
    var form = document.getElementById('maAskForm');
    if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    var focusEl = (phone && !phone.disabled && !phone.value) ? phone : name;
    if (focusEl && !focusEl.disabled) setTimeout(function () { focusEl.focus(); }, 200);
    <% } %>
  });
  </script>
</body>
</html>
