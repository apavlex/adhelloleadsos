<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Reviews' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Review' }) %>
    <h1 class="ma-page-title">Request a review</h1>
    <p class="ma-page-sub">Text or share your link with a happy customer. They pick stars, then go to Google, Yelp, or any site you add below.</p>

    <%- include('_flash') %>

    <section class="ma-card ma-qr">
      <button type="button" class="ma-btn ma-btn--block" id="maAskReview" data-ma-share="<%= reviewUrl %>" data-ma-share-title="Leave <%= member.companyName %> a review" <%= linkCount ? '' : 'disabled' %>>
        <%- icons.review %> Request a review
      </button>
      <p class="ma-hint" style="text-align:center;margin:10px 0 0">Opens your phone’s share sheet so you can text or message the customer.</p>
      <img src="<%= reviewPath %>/qr.png" alt="QR code for your review page" width="220" height="220" style="margin-top:18px">
      <div class="ma-link-box">
        <code id="rvLink"><%= reviewUrl %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= reviewUrl %>"><%- icons.copy %> Copy</button>
      </div>
      <div class="ma-actions" style="justify-content:center;width:100%">
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= reviewPath %>/qr.png?download=1" download><%- icons.download %> Download QR</a>
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= reviewPath %>" target="_blank" rel="noopener">Preview</a>
      </div>
      <% if (!linkCount) { %>
      <p class="ma-flash ma-flash--err" style="width:100%">Add at least one review link below so customers have somewhere to post.</p>
      <% } %>
    </section>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Results</h2></div>
      <div class="ma-card">
        <div class="ma-kpis">
          <div class="ma-kpi"><strong><%= stats.views %></strong><span>Page visits</span></div>
          <div class="ma-kpi"><strong><%= totalClicks %></strong><span>Went to review</span></div>
          <div class="ma-kpi"><strong><%= feedback.length %></strong><span>Private notes</span></div>
        </div>
        <div class="ma-bars">
          <% [5, 4, 3, 2, 1].forEach(function (s) { const n = stats.stars[s] || 0; %>
          <div class="ma-bar">
            <span><%= s %> ★</span>
            <span class="ma-bar__track"><span class="ma-bar__fill" style="width: <%= totalStars ? Math.round((n / totalStars) * 100) : 0 %>%"></span></span>
            <span style="text-align:right"><%= n %></span>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <% if (feedback.length) { %>
    <section class="ma-section">
      <div class="ma-section__head"><h2>Private feedback</h2></div>
      <% feedback.forEach(function (f) { %>
      <div class="ma-card">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= f.name || 'Customer' %> · <%= '★'.repeat(f.rating || 0) %></p>
            <p class="ma-card__meta"><% if (f.phone) { %><a href="tel:<%= String(f.phone).replace(/[^0-9+]/g, '') %>" style="color:var(--acc);font-weight:700;text-decoration:none"><%= f.phone %></a> · <% } %><%= f.email ? f.email + ' · ' : '' %><%= f.when %></p>
          </div>
        </div>
        <p class="ma-card__note"><%= f.message %></p>
      </div>
      <% }); %>
    </section>
    <% } %>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Your review links</h2></div>
      <form method="post" action="<%= base %>/review" class="ma-card" autocomplete="off">
        <p class="ma-hint" style="margin-top:0">Fill in the sites you're on. Leave the rest blank.</p>
        <% platforms.forEach(function (p) { %>
        <div class="ma-field">
          <label class="ma-label rv-field-label" for="rv-<%= p.key %>"><span class="rv-field-badge" style="background: <%= p.color %>" aria-hidden="true"><%= p.letter %></span><%= p.field %></label>
          <input id="rv-<%= p.key %>" name="<%= p.key %>" type="url" inputmode="url" class="ma-input" value="<%= member.reviewLinks[p.key] || '' %>" placeholder="<%= p.placeholder %>">
          <% if (p.hint) { %><p class="ma-hint"><%= p.hint %></p><% } %>
        </div>
        <% }); %>
        <div class="ma-section__head" style="margin-top:8px"><h2 style="font-size:15px">Other review sites</h2></div>
        <% otherRows.forEach(function (o, i) { %>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="rvOtherLabel<%= i %>">Site name</label>
            <input id="rvOtherLabel<%= i %>" name="otherLabel" class="ma-input" value="<%= o.label %>" placeholder="e.g. HomeAdvisor" maxlength="40">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvOtherUrl<%= i %>">Link</label>
            <input id="rvOtherUrl<%= i %>" name="otherUrl" type="url" inputmode="url" class="ma-input" value="<%= o.url %>" placeholder="https://">
          </div>
        </div>
        <% }); %>
        <button type="submit" class="ma-btn ma-btn--block">Save links</button>
      </form>
    </section>
  </main>
  <%- include('_tabbar') %>
  <% if (typeof askShare !== 'undefined' && askShare && linkCount) { %>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('maAskReview');
    if (btn) setTimeout(function () { btn.click(); }, 350);
  });
  </script>
  <% } %>
</body>
</html>
