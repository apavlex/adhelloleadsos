<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Reviews' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Review' }) %>
    <h1 class="ma-page-title">Request a review</h1>
    <p class="ma-page-sub">AI writes a short text from your script, includes your review link, and sends it through Go High Level.</p>

    <%- include('_flash') %>

    <% const _msg = typeof messaging !== 'undefined' && messaging ? messaging : { configured: false, smsReady: false, emailReady: false }; %>
    <% const _fv = typeof formValues !== 'undefined' && formValues ? formValues : { phone: '', email: '', name: '', channel: 'auto', useAi: true }; %>
    <% const _script = typeof smsScript !== 'undefined' ? smsScript : ''; %>
    <section class="ma-card" id="maAskForm">
      <form method="post" action="<%= base %>/review/send" autocomplete="off">
        <p class="ma-hint" style="margin-top:0">Sends from your network’s Go High Level number / email. Your review link is always included.</p>
        <% if (!_msg.configured) { %>
        <p class="ma-flash ma-flash--err">Go High Level isn’t connected yet. Ask your agency to connect GHL (API key, Location ID, SMS from number, and outbound email) in Workspace → Integrations.</p>
        <% } else if (!_msg.smsReady && !_msg.emailReady) { %>
        <p class="ma-flash ma-flash--err">GHL is connected, but SMS from number and outbound email still need to be set in Workspace → Integrations.</p>
        <% } %>
        <div class="ma-field">
          <label class="ma-label" for="rvAskName">Customer name</label>
          <input id="rvAskName" name="name" class="ma-input" maxlength="120" value="<%= _fv.name || '' %>" autocapitalize="words" <%= linkCount && (_msg.smsReady || _msg.emailReady) ? 'autofocus' : '' %>>
        </div>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="rvAskPhone">Mobile</label>
            <input id="rvAskPhone" name="phone" type="tel" inputmode="tel" maxlength="40" class="ma-input" value="<%= _fv.phone || '' %>" <%= _msg.smsReady ? '' : 'disabled' %>>
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvAskEmail">Email</label>
            <input id="rvAskEmail" name="email" type="email" inputmode="email" maxlength="200" class="ma-input" value="<%= _fv.email || '' %>" <%= _msg.emailReady ? '' : 'disabled' %>>
          </div>
        </div>
        <div class="ma-field">
          <label class="ma-label" for="rvAskChannel">Send by</label>
          <select id="rvAskChannel" name="channel" class="ma-input">
            <option value="auto" <%= _fv.channel === 'auto' ? 'selected' : '' %>>Text first, then email</option>
            <option value="sms" <%= _fv.channel === 'sms' ? 'selected' : '' %> <%= _msg.smsReady ? '' : 'disabled' %>>Text (GHL SMS)</option>
            <option value="email" <%= _fv.channel === 'email' ? 'selected' : '' %> <%= _msg.emailReady ? '' : 'disabled' %>>Email (GHL)</option>
          </select>
        </div>
        <label class="ma-check" style="display:flex;gap:10px;align-items:flex-start;margin:4px 0 14px">
          <input type="hidden" name="useAi" value="0">
          <input type="checkbox" name="useAi" value="1" <%= _fv.useAi === false ? '' : 'checked' %> style="margin-top:3px">
          <span><strong>Use AI</strong> to personalize the script for this customer (keeps your review link).</span>
        </label>
        <button type="submit" class="ma-btn ma-btn--block" id="maAskReviewGhl" <%= linkCount && (_msg.smsReady || _msg.emailReady) && member.status === 'active' ? '' : 'disabled' %>>
          <%- icons.review %> Send review request
        </button>
      </form>
      <% if (!linkCount) { %>
      <p class="ma-flash ma-flash--err" style="width:100%;margin-top:12px">Add at least one review link below so customers have somewhere to post.</p>
      <% } %>
    </section>

    <section class="ma-section">
      <div class="ma-section__head"><h2>SMS script</h2></div>
      <form method="post" action="<%= base %>/review/script" class="ma-card" autocomplete="off">
        <p class="ma-hint" style="margin-top:0">AI starts from this script. Use <code>{{name}}</code>, <code>{{company}}</code>, and <code>{{review_link}}</code>.</p>
        <div class="ma-field">
          <label class="ma-label" for="rvSmsScript">Review request text</label>
          <textarea id="rvSmsScript" name="smsScript" class="ma-textarea" rows="4" maxlength="800" required><%= _script %></textarea>
        </div>
        <p class="ma-hint">Your live link: <code><%= typeof reviewUrl !== 'undefined' ? reviewUrl : '' %></code></p>
        <button type="submit" class="ma-btn ma-btn--soft ma-btn--block">Save script</button>
      </form>
      <% if (typeof ghlWorkflowPrompt !== 'undefined' && ghlWorkflowPrompt) { %>
      <div class="ma-card" style="margin-top:10px">
        <p class="ma-hint" style="margin-top:0">Paste into GHL Workflow AI to automate post-job review texts with the same script + link.</p>
        <div class="ma-link-box">
          <code id="rvGhlPrompt" style="white-space:pre-wrap;font-size:12px;max-height:140px;overflow:auto"><%= ghlWorkflowPrompt %></code>
          <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy-from="rvGhlPrompt"><%- icons.copy %> Copy for GHL</button>
        </div>
      </div>
      <% } %>
    </section>

    <section class="ma-card ma-qr">
      <button type="button" class="ma-btn ma-btn--soft ma-btn--block" id="maAskReview" data-ma-share="<%= reviewUrl %>" data-ma-share-title="Leave <%= member.companyName %> a review" <%= linkCount ? '' : 'disabled' %>>
        <%- icons.share %> Share from this phone
      </button>
      <p class="ma-hint" style="text-align:center;margin:10px 0 0">Optional: opens your phone’s share sheet instead of GHL.</p>
      <img src="<%= reviewPath %>/qr.png" alt="QR code for your review page" width="220" height="220" style="margin-top:18px">
      <div class="ma-link-box">
        <code id="rvLink"><%= reviewUrl %></code>
        <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" data-ma-copy="<%= reviewUrl %>"><%- icons.copy %> Copy</button>
      </div>
      <div class="ma-actions" style="justify-content:center;width:100%">
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= reviewPath %>/qr.png?download=1" download><%- icons.download %> Download QR</a>
        <a class="ma-btn ma-btn--sm ma-btn--ghost" href="<%= reviewPath %>" target="_blank" rel="noopener">Preview</a>
      </div>
    </section>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Results</h2></div>
      <div class="ma-card">
        <div class="ma-kpis">
          <div class="ma-kpi"><strong><%= stats.views %></strong><span>Page visits</span></div>
          <div class="ma-kpi"><strong><%= totalClicks %></strong><span>Went to review</span></div>
          <div class="ma-kpi"><strong><%= feedback.length %></strong><span>Private notes</span></div>
        </div>
        <div class="ma-bars">
          <% [5, 4, 3, 2, 1].forEach(function (s) { const n = stats.stars[s] || 0; %>
          <div class="ma-bar">
            <span><%= s %> ★</span>
            <span class="ma-bar__track"><span class="ma-bar__fill" style="width: <%= totalStars ? Math.round((n / totalStars) * 100) : 0 %>%"></span></span>
            <span style="text-align:right"><%= n %></span>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <% if (feedback.length) { %>
    <section class="ma-section">
      <div class="ma-section__head"><h2>Private feedback</h2></div>
      <% feedback.forEach(function (f) { %>
      <div class="ma-card">
        <div class="ma-card__row">
          <div style="min-width:0">
            <p class="ma-card__title"><%= f.name || 'Customer' %> · <%= '★'.repeat(f.rating || 0) %></p>
            <p class="ma-card__meta"><% if (f.phone) { %><a href="tel:<%= String(f.phone).replace(/[^0-9+]/g, '') %>" style="color:var(--acc);font-weight:700;text-decoration:none"><%= f.phone %></a> · <% } %><%= f.email ? f.email + ' · ' : '' %><%= f.when %></p>
          </div>
        </div>
        <p class="ma-card__note"><%= f.message %></p>
      </div>
      <% }); %>
    </section>
    <% } %>

    <section class="ma-section">
      <div class="ma-section__head"><h2>Your review links</h2></div>
      <form method="post" action="<%= base %>/review" class="ma-card" autocomplete="off">
        <p class="ma-hint" style="margin-top:0">Fill in the sites you're on. Leave the rest blank.</p>
        <% platforms.forEach(function (p) { %>
        <div class="ma-field">
          <label class="ma-label rv-field-label" for="rv-<%= p.key %>"><span class="rv-field-badge" style="background: <%= p.color %>" aria-hidden="true"><%= p.letter %></span><%= p.field %></label>
          <input id="rv-<%= p.key %>" name="<%= p.key %>" type="url" inputmode="url" class="ma-input" value="<%= member.reviewLinks[p.key] || '' %>" placeholder="<%= p.placeholder %>">
          <% if (p.hint) { %><p class="ma-hint"><%= p.hint %></p><% } %>
        </div>
        <% }); %>
        <div class="ma-section__head" style="margin-top:8px"><h2 style="font-size:15px">Other review sites</h2></div>
        <% otherRows.forEach(function (o, i) { %>
        <div class="ma-grid2">
          <div class="ma-field">
            <label class="ma-label" for="rvOtherLabel<%= i %>">Site name</label>
            <input id="rvOtherLabel<%= i %>" name="otherLabel" class="ma-input" value="<%= o.label %>" placeholder="e.g. HomeAdvisor" maxlength="40">
          </div>
          <div class="ma-field">
            <label class="ma-label" for="rvOtherUrl<%= i %>">Link</label>
            <input id="rvOtherUrl<%= i %>" name="otherUrl" type="url" inputmode="url" class="ma-input" value="<%= o.url %>" placeholder="https://">
          </div>
        </div>
        <% }); %>
        <button type="submit" class="ma-btn ma-btn--block">Save links</button>
      </form>
    </section>
  </main>
  <%- include('_tabbar') %>
  <% if (typeof askShare !== 'undefined' && askShare) { %>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('maAskForm');
    if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    var name = document.getElementById('rvAskName');
    var phone = document.getElementById('rvAskPhone');
    var focusEl = (phone && !phone.disabled && !phone.value) ? phone : name;
    if (focusEl && !focusEl.disabled) setTimeout(function () { focusEl.focus(); }, 200);
  });
  </script>
  <% } %>
</body>
</html>
