<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { pageTitle: 'Material quote' }) %>
</head>
<body>
  <main class="ma-shell">
    <%- include('_top', { topTitle: 'Quote' }) %>
    <h1 class="ma-page-title">Request a material quote</h1>
    <p class="ma-page-sub">Send measure, photos, notes, and materials to your <strong>network owner</strong> (your material supplier). They’ll quote what you need for the job.</p>

    <%- include('_flash') %>

    <% const fv = formValues || {}; %>
    <form method="post" action="<%= base %>/quote" class="ma-card" enctype="multipart/form-data" autocomplete="off" data-ma-loading="Sending quote…">
      <div class="ma-field">
        <label class="ma-label" for="mqName">Job site / customer</label>
        <input id="mqName" name="name" class="ma-input" value="<%= fv.name || '' %>" required autocomplete="off" autocapitalize="words" placeholder="e.g. Smith residence">
      </div>
      <div class="ma-grid2">
        <div class="ma-field">
          <label class="ma-label" for="mqPhone">Phone <span class="ma-optional">(optional)</span></label>
          <input id="mqPhone" name="phone" type="tel" inputmode="tel" class="ma-input" value="<%= fv.phone || '' %>" autocomplete="off">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="mqZip">ZIP</label>
          <input id="mqZip" name="zip" inputmode="numeric" maxlength="10" class="ma-input" value="<%= fv.zip || '' %>" autocomplete="off">
        </div>
      </div>
      <div class="ma-field">
        <label class="ma-label" for="mqAddress">Street address</label>
        <input id="mqAddress" name="address" class="ma-input" value="<%= fv.address || '' %>" autocomplete="off">
      </div>
      <div class="ma-grid2">
        <div class="ma-field">
          <label class="ma-label" for="mqCity">City</label>
          <input id="mqCity" name="city" class="ma-input" value="<%= fv.city || '' %>" autocomplete="off">
        </div>
        <div class="ma-field">
          <label class="ma-label" for="mqEmail">Email <span class="ma-optional">(optional)</span></label>
          <input id="mqEmail" name="email" type="email" inputmode="email" class="ma-input" value="<%= fv.email || '' %>" autocomplete="off">
        </div>
      </div>

      <div class="ma-field">
        <div class="ma-label-row">
          <label class="ma-label" for="mqMaterials">Materials needed</label>
          <button type="button" class="ma-voice-btn" data-ma-voice-for="mqMaterials" aria-label="Dictate materials" title="Tap to speak" hidden></button>
        </div>
        <textarea id="mqMaterials" name="materials" class="ma-textarea" required maxlength="2000" rows="3" placeholder="e.g. ¾&quot; oak hardwood, underlayment, stair nosing — color TBD"><%= fv.materials || '' %></textarea>
      </div>

      <div class="ma-field">
        <div class="ma-label-row">
          <label class="ma-label" for="mqMeasure">Measure</label>
          <button type="button" class="ma-voice-btn" data-ma-voice-for="mqMeasure" aria-label="Dictate measure" title="Tap to speak" hidden></button>
        </div>
        <textarea id="mqMeasure" name="measure" class="ma-textarea" required maxlength="2000" rows="3" placeholder="e.g. Living 18×14, hall 4×20 — ~340 sq ft net; stairs 13 risers"><%= fv.measure || '' %></textarea>
      </div>

      <div class="ma-field">
        <div class="ma-label-row">
          <label class="ma-label" for="mqNotes">Notes <span class="ma-optional">(optional)</span></label>
          <button type="button" class="ma-voice-btn" data-ma-voice-for="mqNotes" aria-label="Dictate notes" title="Tap to speak" hidden></button>
        </div>
        <textarea id="mqNotes" name="notes" class="ma-textarea" maxlength="2000" rows="3" placeholder="Access, timing, waste factor, glue-down vs float…"><%= fv.notes || '' %></textarea>
      </div>

      <div class="ma-field">
        <label class="ma-label" for="mqPhotos">Photos <span class="ma-optional">(optional, up to 8)</span></label>
        <input id="mqPhotos" name="photos" type="file" accept="image/*,.heic,.heif" multiple class="ma-input" style="padding:10px">
        <p class="ma-hint" style="margin-top:8px">Room shots, transitions, stairs — helps us quote accurately.</p>
      </div>

      <label class="ma-check">
        <input type="checkbox" name="confirm" value="on" required <%= fv.confirm ? 'checked' : '' %>>
        <span>These details are ready for a material quote from my network owner (supplier).</span>
      </label>
      <button type="submit" class="ma-btn ma-btn--block" <%= member.status !== 'active' ? 'disabled' : '' %>><%- icons.send %> Request quote</button>
    </form>
  </main>
  <%- include('_tabbar') %>
</body>
</html>
