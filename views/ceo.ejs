<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Automate Prospecting | AdHello' }) %>
<body class="bg-brand-bg text-brand-dark overflow-x-hidden selection:bg-brand-yellow/30">

<%- include('partials/navbar') %>

<% 
  const stats = typeof reportStats !== 'undefined' && reportStats ? reportStats : {};
  function formatAutoWhen(iso) {
    if (!iso) return '—';
    try {
      return new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch (e) { return '—'; }
  }
%>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
    <div>
      <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Automation reports</span>
      </div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark dark:text-white">
        Automate <span class="text-brand-muted dark:text-slate-500">prospecting</span>
      </h1>
      <p class="text-sm font-bold text-brand-muted dark:text-slate-400 mt-2">Folder outreach, scheduled searches, and cadence messages</p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <% if (stats.running > 0) { %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 text-[10px] font-black uppercase tracking-widest">
        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span><%= stats.running %> running
      </span>
      <% } else { %>
      <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">No automations running</span>
      <% } %>
    </div>
  </div>

  <!-- Automation KPIs -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-10">
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Running</div>
      <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400"><%= stats.running != null ? stats.running : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted"><%= stats.totalAutomations != null ? stats.totalAutomations : 0 %> total</div>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Paused</div>
      <div class="text-2xl font-black text-amber-600 dark:text-amber-400"><%= stats.paused != null ? stats.paused : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted">Outreach &amp; searches</div>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">GHL outreach</div>
      <div class="text-2xl font-black text-brand-dark dark:text-white"><%= stats.ghlOutreachEnrolled != null ? stats.ghlOutreachEnrolled : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted">Leads in auto-outreach</div>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Cadences</div>
      <div class="text-2xl font-black text-brand-dark dark:text-white"><%= stats.cadenceEnrolled != null ? stats.cadenceEnrolled : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted">Active sequences</div>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Last run enrolled</div>
      <div class="text-2xl font-black text-brand-dark dark:text-white"><%= stats.lastRunEnrolled != null ? stats.lastRunEnrolled : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted"><%= formatAutoWhen(stats.lastRunAt) %></div>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Scheduled searches</div>
      <div class="text-2xl font-black text-brand-dark dark:text-white"><%= stats.scheduledSearches != null ? stats.scheduledSearches : 0 %></div>
      <div class="text-[10px] font-bold text-brand-muted">Prospecting jobs</div>
    </div>
  </div>

  <!-- Automations table -->
  <%- include('partials/automations_table') %>

  <!-- Recent automation activity -->
  <% if (typeof recentAutomationActivity !== 'undefined' && recentAutomationActivity.length) { %>
  <div class="mb-10">
    <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted mb-4">Recent automation activity</h3>
    <div class="bg-white dark:bg-slate-900 rounded-[2rem] p-6 border border-brand-border/40 dark:border-white/10 shadow-sm">
      <div class="space-y-3">
        <% recentAutomationActivity.forEach(function(item) { %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 rounded-xl bg-brand-cream/40 dark:bg-white/5 border border-brand-border/20 dark:border-white/10">
          <div class="min-w-0">
            <div class="font-bold text-sm text-brand-dark dark:text-white truncate"><%= item.name %></div>
            <div class="text-[10px] text-brand-muted mt-0.5"><%= item.detail %></div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full <%= item.type === 'outreach' ? 'bg-brand-yellow/15 text-brand-dark dark:text-brand-yellow' : item.type === 'prospecting' ? 'bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300' : 'bg-purple-50 dark:bg-purple-950/50 text-purple-700 dark:text-purple-300' %>"><%= item.type %></span>
            <span class="text-[10px] font-bold text-brand-muted tabular-nums"><%= formatAutoWhen(item.lastActivity) %></span>
            <% if (item.link) { %><a href="<%= item.link %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">Open →</a><% } %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Quick links -->
  <div class="bg-brand-dark rounded-[2rem] p-8 text-white shadow-xl mb-8">
    <h2 class="text-xl font-black mb-2">Automation shortcuts</h2>
    <p class="text-sm text-white/60 mb-6">Manage outreach folders, view enrolled leads, or check messages in GHL.</p>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <a href="/prospecting?tab=folders" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">Folder outreach</div>
      </a>
      <a href="/prospecting?tab=queue" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">Schedule search</div>
      </a>
      <a href="/sequences" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">Cadences</div>
      </a>
      <a href="/today" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">Today queue</div>
      </a>
      <% if (typeof ghlDashboardUrl !== 'undefined' && ghlDashboardUrl) { %>
      <a href="<%= ghlDashboardUrl %>" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">GHL messages</div>
      </a>
      <% } else if (typeof ghlConfigured !== 'undefined' && !ghlConfigured) { %>
      <a href="/workspace/integrations/ghl-setup" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all">
        <div class="text-xs font-black uppercase tracking-widest">Connect GHL</div>
      </a>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
