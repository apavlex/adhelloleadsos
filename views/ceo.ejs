<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'CEO Dashboard | AdHello' }) %>
<body class="bg-brand-bg text-brand-dark overflow-x-hidden selection:bg-brand-yellow/30">

<%- include('partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 pt-24">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-10 h-10 bg-brand-dark rounded-xl flex items-center justify-center text-brand-yellow shadow-lg">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
          </svg>
        </div>
        <h1 class="text-3xl font-black tracking-tight text-brand-dark uppercase">CEO Command Center</h1>
      </div>
      <p class="text-sm font-semibold text-brand-muted ml-1">All ventures at a glance</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
      <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Live</span>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-10">
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Total Leads</div>
      <div class="text-2xl font-black text-brand-dark"><%= totalLeads %></div>
      <div class="text-[10px] font-bold text-emerald-600"><%= leadsThisWeek %> this week</div>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Active Clients</div>
      <div class="text-2xl font-black text-brand-dark"><%= activeClients %></div>
      <div class="text-[10px] font-bold text-brand-muted"><%= pipelineLeads %> in pipeline</div>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Traffic (IPs)</div>
      <div class="text-2xl font-black text-brand-dark"><%= uniqueIPs %></div>
      <div class="text-[10px] font-bold text-brand-muted"><%= conversionRate %>% → lead</div>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Visits Today</div>
      <div class="text-2xl font-black text-brand-dark"><%= visitsToday %></div>
      <div class="text-[10px] font-bold text-brand-muted"><%= leadsToday %> new leads</div>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Open Tasks</div>
      <div class="text-2xl font-black text-brand-dark"><%= openTasks %></div>
      <div class="text-[10px] font-bold text-amber-600"><%= doneTasks %> done</div>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-brand-border/40 shadow-sm hover:border-brand-yellow/50 transition-all">
      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Total Visits</div>
      <div class="text-2xl font-black text-brand-dark"><%= totalVisits %></div>
      <div class="text-[10px] font-bold text-brand-muted">All time</div>
    </div>
  </div>

  <!-- Row 1: Pipeline + Chart + Top Cities -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">

    <!-- Pipeline Stages -->
    <div class="bg-white rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted mb-4">Pipeline Stages</h3>
      <div class="space-y-3">
        <% if (typeof stages !== 'undefined' && stages.length) { %>
          <% stages.forEach(function(s) { %>
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm font-bold text-brand-dark capitalize"><%= s[0].replace(/_/g, ' ') %></span>
              <span class="text-lg font-black text-brand-dark"><%= s[1] %></span>
            </div>
            <div class="h-1.5 rounded-full bg-brand-border/20 overflow-hidden">
              <div class="h-full rounded-full bg-brand-yellow" style="width: <%= pipelineLeads > 0 ? (s[1] / pipelineLeads * 100).toFixed(0) : 0 %>%"></div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div class="text-sm text-brand-muted italic py-8 text-center">No pipeline data yet — start adding leads with stages!</div>
        <% } %>
      </div>
    </div>

    <!-- Traffic Trend -->
    <div class="bg-white rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted mb-4">14-Day Traffic</h3>
      <div id="trafficSpark" class="h-40 w-full"></div>
    </div>

    <!-- Top Cities -->
    <div class="bg-white rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted mb-4">Top Markets</h3>
      <div class="space-y-3">
        <% if (typeof topCities !== 'undefined' && topCities.length) { %>
          <% topCities.forEach(function(c) { %>
          <div class="flex items-center justify-between p-2 rounded-xl hover:bg-brand-cream/30 transition-all">
            <span class="text-sm font-bold text-brand-dark"><%= c.name %></span>
            <span class="text-sm font-black text-brand-muted"><%= c.count %> leads</span>
          </div>
          <% }); %>
        <% } else { %>
          <p class="text-sm text-brand-muted italic py-8 text-center">No geo data yet — add leads with cities!</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Row 2: Kanban Board (full width) -->
  <div class="mb-10">

    <!-- Kanban Board -->
    <div class="bg-white rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted">Task Board</h3>
        <div class="flex items-center gap-3">
          <span class="text-[10px] font-bold text-brand-muted"><%= openTasks %> open · <%= doneTasks %> done</span>
          <a href="/ceo/tasks" class="text-[10px] font-black uppercase tracking-widest text-brand-dark bg-brand-cream hover:bg-brand-yellow/20 px-3 py-1.5 rounded-full transition-colors" title="Full-page task manager">⛶ Full Page</a>
        </div>
      </div>

      <!-- Add task form -->
      <form id="ceoTaskForm" class="mb-4 flex gap-2">
        <input id="ceoTaskInput" type="text" placeholder="Add a task…" class="flex-1 rounded-xl border border-brand-border/40 bg-brand-cream/30 px-3 py-2 text-sm font-semibold text-brand-dark placeholder:text-brand-muted/50 focus:outline-none focus:border-brand-yellow" />
        <select id="ceoTaskCol" class="rounded-xl border border-brand-border/40 bg-white px-2 py-2 text-[10px] font-bold text-brand-dark">
          <% taskColumns.forEach(function(c) { %>
          <option value="<%= c.id %>"><%= c.label %></option>
          <% }); %>
        </select>
        <button type="submit" class="bg-brand-dark text-brand-yellow px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-black transition-colors">Add</button>
      </form>

      <!-- Kanban columns -->
      <div class="flex gap-3 overflow-x-auto pb-2">
        <% taskColumns.forEach(function(col) { %>
        <div class="ceo-kanban-col w-[14rem] shrink-0 flex flex-col gap-2" data-column="<%= col.id %>">
          <div class="flex items-center justify-between px-1">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-dark"><%= col.label %></span>
            <span class="ceo-col-count px-2 py-0.5 rounded-full bg-brand-cream text-[10px] font-bold text-brand-muted"><%= (tasksByColumn[col.id] || []).length %></span>
          </div>
          <ul class="ceo-kanban-list min-h-[120px] flex flex-col gap-2 p-2 bg-brand-cream/20 rounded-xl border border-dashed border-brand-border/30">
            <% (tasksByColumn[col.id] || []).forEach(function(t) { %>
            <li class="ceo-task-card p-3 bg-white rounded-lg border border-brand-border/20 shadow-sm cursor-grab active:cursor-grabbing group" data-task-id="<%= t.id %>">
              <p class="text-xs font-bold text-brand-dark leading-snug"><%= t.title %></p>
              <div class="flex items-center justify-between mt-2">
                <span class="text-[9px] font-bold text-brand-muted"><%= t.column %></span>
                <button type="button" class="ceo-task-del text-[9px] font-black uppercase text-rose-500 opacity-0 group-hover:opacity-100 transition-opacity hover:underline">✕</button>
              </div>
            </li>
            <% }); %>
          </ul>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Row 2b: Recent Leads + System Status -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <!-- Recent Leads -->
    <div class="space-y-4">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted">Recent Leads</h3>
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
        <div class="space-y-3 max-h-[400px] overflow-y-auto pr-1">
          <% if (typeof recentLeads !== 'undefined' && recentLeads.length) { %>
            <% recentLeads.forEach(function(l) { %>
            <div class="p-3 rounded-xl bg-brand-cream/40 border border-brand-border/20 hover:border-brand-yellow/30 transition-all">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-sm text-brand-dark truncate"><%= l.title %></span>
                <span class="text-[9px] font-black uppercase tracking-widest text-brand-yellow bg-brand-yellow/10 px-2 py-0.5 rounded-full capitalize"><%= (l.stage || 'new').replace(/_/g, ' ') %></span>
              </div>
              <div class="flex items-center gap-3 mt-1 text-[10px] text-brand-muted font-bold">
                <% if (l.city) { %><span><%= l.city %></span><% } %>
                <span><%= new Date(l.created).toLocaleDateString([], { month: 'short', day: 'numeric' }) %></span>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div class="py-10 text-center text-sm text-brand-muted italic">No leads yet. Import some to get started!</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- System Status -->
    <div class="space-y-4">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted">System Status</h3>
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm">
        <div class="space-y-2">
          <% (typeof systems !== 'undefined' ? systems : []).forEach(function(s) { %>
          <div class="flex items-center justify-between">
            <span class="text-sm font-bold text-brand-dark"><%= s.name %></span>
            <span class="inline-flex items-center gap-1.5 text-[9px] font-black uppercase tracking-widest <%= s.status === 'live' || s.status === 'active' ? 'text-emerald-600' : s.status === 'pending' ? 'text-amber-500' : 'text-red-500' %>">
              <span class="w-1.5 h-1.5 rounded-full <%= s.status === 'live' || s.status === 'active' ? 'bg-emerald-500' : s.status === 'pending' ? 'bg-amber-400' : 'bg-red-500' %>"></span>
              <%= s.status %>
            </span>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 3: Ventures + AI Chat Widget -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">

    <!-- Venture Cards -->
    <div class="space-y-4">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted">Ventures</h3>

      <!-- AdHello Agency -->
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm hover:border-brand-yellow/30 transition-all">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div>
            <h4 class="font-black text-lg text-brand-dark">AdHello Agency</h4>
            <p class="text-xs text-brand-muted font-bold">Home Service Marketing</p>
          </div>
          <a href="<%= leadsUrl %>/reports" target="_blank" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Reports →</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Leads</div><div class="text-xl font-black text-brand-dark"><%= totalLeads %></div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Traffic</div><div class="text-xl font-black text-brand-dark"><%= totalVisits %></div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Conversion</div><div class="text-xl font-black text-brand-dark"><%= conversionRate %>%</div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Clients</div><div class="text-xl font-black text-brand-dark"><%= activeClients %></div></div>
        </div>
        <div class="mt-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
          <span class="text-[10px] font-bold text-brand-muted">Site live · GBP audits active · Chatbot online</span>
        </div>
      </div>

      <!-- Personal Brand -->
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm hover:border-amber-300 transition-all opacity-80">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div>
            <h4 class="font-black text-lg text-brand-dark">Personal Brand</h4>
            <p class="text-xs text-brand-muted font-bold">X / LinkedIn / YouTube</p>
          </div>
          <span class="text-[10px] font-black uppercase tracking-widest text-amber-500 bg-amber-50 px-3 py-1 rounded-full">Setup needed</span>
        </div>
        <div class="grid grid-cols-3 gap-3 text-center">
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">X Followers</div><div class="text-lg font-black text-brand-dark">—</div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Posts</div><div class="text-lg font-black text-brand-dark">0</div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Impressions</div><div class="text-lg font-black text-brand-dark">—</div></div>
        </div>
        <p class="mt-3 text-[10px] text-brand-muted italic">Connect your X developer account to populate this.</p>
      </div>

      <!-- Trading Coach -->
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm hover:border-violet-300 transition-all opacity-60">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div>
            <h4 class="font-black text-lg text-brand-dark">Trading Coach</h4>
            <p class="text-xs text-brand-muted font-bold">Futures Education</p>
          </div>
          <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 bg-slate-100 px-3 py-1 rounded-full">Coming Soon</span>
        </div>
        <p class="text-xs text-brand-muted italic">Tell me your offer and I'll build this out.</p>
      </div>

      <!-- Presso Coffee Co. -->
      <div class="bg-white/80 backdrop-blur rounded-[2rem] p-6 border border-brand-border/40 shadow-sm hover:border-amber-300 transition-all">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div>
            <h4 class="font-black text-lg text-brand-dark">Presso Coffee Co.</h4>
            <p class="text-xs text-brand-muted font-bold">Camas, WA · Local Coffee Shop</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a href="/newsletter" class="text-[10px] font-black uppercase tracking-widest text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full hover:bg-amber-200 transition-colors">📰 Newsletter</a>
            <a href="https://www.pressocoffee.co" target="_blank" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">Site →</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Locations</div><div class="text-xl font-black text-brand-dark">3</div></div>
          <div><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">GBP Audit</div><div class="text-xl font-black text-brand-dark bg-amber-100 px-2 py-0.5 rounded inline-block text-amber-700">Pending</div></div>
          <div class="col-span-2"><div class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Next Steps</div><div class="text-sm font-bold text-brand-dark mt-1">GBP optimization · Google Maps listing · Local SEO · Review system</div></div>
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <span class="text-[9px] font-black px-2 py-1 rounded-full bg-amber-100 text-amber-700">GBP Setup</span>
          <span class="text-[9px] font-black px-2 py-1 rounded-full bg-blue-100 text-blue-700">Local SEO</span>
          <span class="text-[9px] font-black px-2 py-1 rounded-full bg-green-100 text-green-700">Review System</span>
        </div>
      </div>
    </div>

    <!-- AI Chat Widget -->
    <div class="space-y-4">
      <h3 class="text-sm font-black uppercase tracking-widest text-brand-muted">AI Assistant</h3>
      <div class="bg-white rounded-[2rem] border border-brand-border/40 shadow-sm flex flex-col h-[600px] overflow-hidden">
        <!-- Chat header -->
        <div class="px-6 py-4 border-b border-brand-border/20 flex items-center gap-3">
          <span class="shrink-0 w-10 h-10 rounded-full overflow-hidden border border-slate-200/90 bg-white shadow-sm ring-2 ring-slate-200/80" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex AI Assistant">
              <circle cx="24" cy="24" r="22" fill="#FFD644"/>
              <circle cx="24" cy="24" r="20" fill="#FFC107"/>
              <ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
              <ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
              <circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
              <circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
              <path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/>
              <ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
              <ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
            </svg>
          </span>
          <div>
            <div class="text-sm font-black text-brand-dark">Pavlex · CEO Assistant</div>
            <div class="text-[10px] font-bold text-emerald-600 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Online</div>
          </div>
        </div>

        <!-- Chat messages -->
        <div id="ceoChatMessages" class="flex-1 overflow-y-auto p-4 space-y-3">
          <div class="flex gap-2">
            <span class="shrink-0 w-6 h-6 rounded-full overflow-hidden border border-slate-200/60 bg-white shadow-sm ring-1 ring-slate-200/60 flex items-center justify-center" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex">
                <circle cx="24" cy="24" r="22" fill="#FFD644"/>
                <circle cx="24" cy="24" r="20" fill="#FFC107"/>
                <ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
                <ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
                <circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
                <circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
                <path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/>
                <ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
                <ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
              </svg>
            </span>
            <div class="bg-brand-cream/60 rounded-2xl rounded-tl-sm px-4 py-3 text-sm text-brand-dark leading-relaxed">
              Hey Alex! I'm your CEO assistant. Ask me about your leads, pipeline, tasks, or any business decisions.
            </div>
          </div>
        </div>

        <!-- Typing indicator (outside scrollable area, shown/hidden via JS) -->
        <div id="ceoTypingInline" class="hidden px-4 py-2 border-t border-brand-border/10 bg-brand-cream/30">
          <div class="flex items-center gap-2">
            <span class="shrink-0 w-5 h-5 rounded-full overflow-hidden border border-slate-200/60 bg-white shadow-sm ring-1 ring-slate-200/60 flex items-center justify-center" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex"><circle cx="24" cy="24" r="22" fill="#FFD644"/><circle cx="24" cy="24" r="20" fill="#FFC107"/><ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/><ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/><circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/><circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/><path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/><ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/><ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/></svg></span>
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce"></span>
              <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce" style="animation-delay:0.15s"></span>
              <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce" style="animation-delay:0.3s"></span>
            </div>
            <span class="text-[10px] font-bold text-brand-muted ml-1" id="ceoTypingStatus">Thinking…</span>
          </div>
        </div>

        <!-- Chat input -->
        <div class="px-4 py-3 border-t border-brand-border/20">
          <form id="ceoChatForm" class="flex gap-2" method="POST" action="/ceo/chat" novalidate>
            <input id="ceoChatInput" type="text" placeholder="Ask me anything…" class="flex-1 rounded-xl border border-brand-border/40 bg-brand-cream/30 px-4 py-2.5 text-sm font-semibold text-brand-dark placeholder:text-brand-muted/50 focus:outline-none focus:border-brand-yellow" />
            <button type="submit" class="bg-brand-dark text-brand-yellow px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-black transition-colors">Send</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-brand-dark rounded-[2rem] p-8 text-white shadow-xl mb-8">
    <h2 class="text-xl font-black mb-6">Quick Actions</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="<%= leadsUrl %>/today" target="_blank" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all group">
        <div class="text-2xl mb-2">📋</div>
        <div class="text-xs font-black uppercase tracking-widest">Today</div>
      </a>
      <a href="<%= leadsUrl %>/pipeline" target="_blank" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all group">
        <div class="text-2xl mb-2">📊</div>
        <div class="text-xs font-black uppercase tracking-widest">Pipeline</div>
      </a>
      <a href="<%= leadsUrl %>/reports" target="_blank" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all group">
        <div class="text-2xl mb-2">📈</div>
        <div class="text-xs font-black uppercase tracking-widest">Reports</div>
      </a>
      <a href="<%= leadsUrl %>/tasks" target="_blank" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all group">
        <div class="text-2xl mb-2">✅</div>
        <div class="text-xs font-black uppercase tracking-widest">Full Tasks</div>
      </a>
      <% if (typeof ghlDashboardUrl !== 'undefined' && ghlDashboardUrl) { %>
      <a href="<%= ghlDashboardUrl %>" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 rounded-2xl p-5 text-center transition-all group">
        <div class="text-2xl mb-2">💬</div>
        <div class="text-xs font-black uppercase tracking-widest">GHL</div>
      </a>
      <% } %>
    </div>
  </div>

</main>

<!-- ── Floating Chat Bubble ─────────────────────────────────────────────────── -->
<button id="chatBubble" type="button" aria-label="Open chat" class="fixed bottom-6 right-6 z-50 w-16 h-16 rounded-full bg-brand-dark text-brand-yellow shadow-2xl shadow-brand-dark/30 flex items-center justify-center hover:scale-110 hover:shadow-brand-dark/50 transition-all duration-200 group cursor-pointer">
  <svg id="chatBubbleIcon" class="w-7 h-7 group-hover:scale-105 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
  </svg>
  <svg id="chatBubbleClose" class="w-7 h-7 hidden group-hover:scale-105 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
  </svg>
  <span id="chatBubbleDot" class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full border-2 border-white hidden"></span>
</button>

<!-- ── Floating Chat Window ─────────────────────────────────────────────────── -->
<div id="chatWindow" class="fixed bottom-24 right-6 z-50 w-[380px] max-w-[calc(100vw-2rem)] bg-white rounded-[1.5rem] border border-brand-border/40 shadow-2xl shadow-brand-dark/20 flex flex-col hidden overflow-hidden" style="height: 520px;">
  <div class="px-5 py-3.5 border-b border-brand-border/20 flex items-center justify-between gap-3 bg-brand-dark rounded-t-[1.5rem]">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full overflow-hidden border border-slate-200/60 bg-white shadow-sm ring-2 ring-slate-200/60 flex items-center justify-center" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex">
          <circle cx="24" cy="24" r="22" fill="#FFD644"/>
          <circle cx="24" cy="24" r="20" fill="#FFC107"/>
          <ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
          <ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/>
          <circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
          <circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/>
          <path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/>
          <ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
          <ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/>
        </svg>
      </div>
      <div>
        <div class="text-sm font-black text-white leading-tight">Pavlex</div>
        <div class="text-[10px] font-bold text-emerald-400 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span> Online</div>
      </div>
    </div>
    <button id="chatWindowClose" type="button" aria-label="Close chat" class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors text-white/70 hover:text-white">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
      </svg>
    </button>
  </div>
  <div id="ceoChatMessagesFloat" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
  <div id="ceoTypingFloat" class="px-4 pb-2 hidden">
    <div class="flex gap-2">
      <span class="shrink-0 w-6 h-6 rounded-full overflow-hidden border border-slate-200/60 bg-white shadow-sm ring-1 ring-slate-200/60 flex items-center justify-center" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex"><circle cx="24" cy="24" r="22" fill="#FFD644"/><circle cx="24" cy="24" r="20" fill="#FFC107"/><ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/><ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/><circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/><circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/><path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/><ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/><ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/></svg></span>
      <div class="bg-brand-cream/60 rounded-2xl rounded-tl-sm px-4 py-3">
        <div class="flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce"></span>
          <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce" style="animation-delay:0.15s"></span>
          <span class="inline-block w-1.5 h-1.5 bg-brand-muted rounded-full animate-bounce" style="animation-delay:0.3s"></span>
        </div>
      </div>
    </div>
  </div>
  <div class="px-3 py-2.5 border-t border-brand-border/20">
    <form id="ceoChatFormFloat" class="flex gap-2" method="POST" action="/ceo/chat" novalidate>
      <input id="ceoChatInputFloat" type="text" placeholder="Ask me anything…" class="flex-1 rounded-xl border border-brand-border/40 bg-brand-cream/30 px-3.5 py-2 text-sm font-semibold text-brand-dark placeholder:text-brand-muted/50 focus:outline-none focus:border-brand-yellow" />
      <button type="submit" class="bg-brand-dark text-brand-yellow px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-black transition-colors">Send</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<!-- Chart Script -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // ── Traffic Chart ──
  const chartData = <%- JSON.stringify(chartData) %>;
  if (chartData && chartData.labels && chartData.labels.length) {
    const options = {
      series: [{ name: 'Visits', data: chartData.values }],
      chart: { type: 'area', height: 160, toolbar: { show: false }, sparkline: { enabled: true }, fontFamily: 'Inter, sans-serif' },
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 3, colors: ['#FFD644'] },
      fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.5, opacityTo: 0.05, stops: [0, 100], colorStops: [{ offset: 0, color: '#FFD644', opacity: 0.4 }, { offset: 100, color: '#FFD644', opacity: 0 }] } },
      markers: { size: 0 },
      tooltip: { theme: 'dark', x: { show: true }, y: { formatter: v => v + ' visits' } },
      grid: { show: false },
      xaxis: { labels: { show: false }, axisBorder: { show: false }, axisTicks: { show: false } },
      yaxis: { labels: { show: false }, axisBorder: { show: false }, axisTicks: { show: false } },
    };
    const chart = new ApexCharts(document.querySelector("#trafficSpark"), options);
    chart.render();
  }

  // ── Kanban Drag & Drop ──
  if (typeof Sortable !== 'undefined') {
    document.querySelectorAll('.ceo-kanban-list').forEach(function(ul) {
      Sortable.create(ul, {
        group: 'ceo-tasks',
        animation: 150,
        ghostClass: 'opacity-40',
        onEnd: function(evt) {
          var card = evt.item;
          var taskId = card.getAttribute('data-task-id');
          var toCol = evt.to.closest('.ceo-kanban-col');
          if (!taskId || !toCol) return;
          var newColumn = toCol.getAttribute('data-column');
          // Update via API
          fetch('/tasks/api/' + encodeURIComponent(taskId), {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ column: newColumn }),
          }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) {
              // Update column counts
              document.querySelectorAll('.ceo-kanban-col').forEach(function(col) {
                var count = col.querySelectorAll('.ceo-task-card').length;
                var badge = col.querySelector('.ceo-col-count');
                if (badge) badge.textContent = count;
              });
            }
          }).catch(function(e) { console.error('Task move failed:', e); });
        }
      });
    });
  }

  // ── Add Task ──
  var taskForm = document.getElementById('ceoTaskForm');
  if (taskForm) {
    taskForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var input = document.getElementById('ceoTaskInput');
      var colSelect = document.getElementById('ceoTaskCol');
      var title = (input.value || '').trim();
      if (!title) return;
      fetch('/tasks/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: title, column: colSelect.value || 'todo' }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success && d.task) {
          input.value = '';
          // Add card to the right column
          var col = document.querySelector('.ceo-kanban-col[data-column="' + d.task.column + '"] .ceo-kanban-list');
          if (col) {
            var li = document.createElement('li');
            li.className = 'ceo-task-card p-3 bg-white rounded-lg border border-brand-border/20 shadow-sm cursor-grab active:cursor-grabbing group';
            li.setAttribute('data-task-id', d.task.id);
            li.innerHTML = '<p class="text-xs font-bold text-brand-dark leading-snug">' + escapeHtml(d.task.title) + '</p><div class="flex items-center justify-between mt-2"><span class="text-[9px] font-bold text-brand-muted">' + d.task.column + '</span><button type="button" class="ceo-task-del text-[9px] font-black uppercase text-rose-500 opacity-0 group-hover:opacity-100 transition-opacity hover:underline">✕</button></div>';
            col.appendChild(li);
            // Update count
            var badge = col.closest('.ceo-kanban-col').querySelector('.ceo-col-count');
            if (badge) badge.textContent = col.querySelectorAll('.ceo-task-card').length;
            // Attach delete handler
            attachDelHandler(li.querySelector('.ceo-task-del'));
          }
        }
      }).catch(function(e) { console.error('Add task failed:', e); });
    });
  }

  // ── Delete Task ──
  function attachDelHandler(btn) {
    btn.addEventListener('click', function() {
      var card = btn.closest('.ceo-task-card');
      var taskId = card.getAttribute('data-task-id');
      if (!taskId) return;
      fetch('/tasks/api/' + encodeURIComponent(taskId), { method: 'DELETE' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success) {
            var col = card.closest('.ceo-kanban-col');
            card.remove();
            if (col) {
              var badge = col.querySelector('.ceo-col-count');
              if (badge) badge.textContent = col.querySelectorAll('.ceo-task-card').length;
            }
          }
        }).catch(function(e) { console.error('Delete task failed:', e); });
    });
  }
  document.querySelectorAll('.ceo-task-del').forEach(attachDelHandler);

  // ── AI Chat — Inline Widget + Floating Bubble ──────────────────────────────
  var chatForm = document.getElementById('ceoChatForm');
  var chatInput = document.getElementById('ceoChatInput');
  var chatMessages = document.getElementById('ceoChatMessages');
  var chatFormFloat = document.getElementById('ceoChatFormFloat');
  var chatInputFloat = document.getElementById('ceoChatInputFloat');
  var chatMessagesFloat = document.getElementById('ceoChatMessagesFloat');
  var chatBubble = document.getElementById('chatBubble');
  var chatWindow = document.getElementById('chatWindow');
  var chatWindowClose = document.getElementById('chatWindowClose');
  var chatBubbleIcon = document.getElementById('chatBubbleIcon');
  var chatBubbleClose = document.getElementById('chatBubbleClose');
  var chatBubbleDot = document.getElementById('chatBubbleDot');
  var typingFloat = document.getElementById('ceoTypingFloat');
  var typingInline = document.getElementById('ceoTypingInline');
  var typingStatus = document.getElementById('ceoTypingStatus');
  var chatHistory = [];
  var chatBusy = false;
  var chatOpen = false;

  function renderMsgTo(container, role, text) {
    var div = document.createElement('div');
    div.className = 'flex gap-2' + (role === 'user' ? ' flex-row-reverse' : '');
    if (role === 'assistant') {
      div.innerHTML = '<span class="shrink-0 w-6 h-6 rounded-full overflow-hidden border border-slate-200/60 bg-white shadow-sm ring-1 ring-slate-200/60 flex items-center justify-center" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-full h-full" role="img" aria-label="Pavlex"><circle cx="24" cy="24" r="22" fill="#FFD644"/><circle cx="24" cy="24" r="20" fill="#FFC107"/><ellipse cx="17" cy="20" rx="2.5" ry="3" fill="#5C4033"/><ellipse cx="31" cy="20" rx="2.5" ry="3" fill="#5C4033"/><circle cx="17.8" cy="19" r="1" fill="#fff" opacity="0.9"/><circle cx="31.8" cy="19" r="1" fill="#fff" opacity="0.9"/><path d="M15 28 Q24 38 33 28" stroke="#5C4033" stroke-width="2.2" stroke-linecap="round" fill="none"/><ellipse cx="12" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/><ellipse cx="36" cy="26" rx="3" ry="2" fill="#FF9800" opacity="0.35"/></svg></span><div class="bg-brand-cream/60 rounded-2xl rounded-tl-sm px-4 py-3 text-sm text-brand-dark max-w-[85%]">' + renderMd(text) + '</div>';
    } else {
      div.innerHTML = '<div class="bg-brand-dark rounded-2xl rounded-tr-sm px-4 py-3 text-sm text-white max-w-[85%]">' + renderMd(text) + '</div>';
    }
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  }

  function loadChatHistory() {
    fetch('/ceo/chat/history?limit=50')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success && d.messages && d.messages.length > 0) {
          if (chatMessages) chatMessages.innerHTML = '';
          if (chatMessagesFloat) chatMessagesFloat.innerHTML = '';
          chatHistory = [];
          d.messages.forEach(function(m) {
            if (m.role === 'user' || m.role === 'assistant') {
              if (chatMessages) renderMsgTo(chatMessages, m.role, m.content);
              if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, m.role, m.content);
              chatHistory.push({ role: m.role, content: m.content });
            }
          });
        }
      })
      .catch(function(e) { console.error('Failed to load chat history:', e); });
  }
  loadChatHistory();

  function renderMd(text) {
    if (!text) return '';
    var s = String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    s = s.replace(/```([\s\S]*?)```/g, '<pre class="bg-black/10 rounded-lg p-3 my-2 text-xs font-mono overflow-x-auto whitespace-pre-wrap"><code>$1</code></pre>');
    s = s.replace(/`([^`]+)`/g, '<code class="bg-black/10 rounded px-1 py-0.5 text-xs font-mono">$1</code>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold">$1</strong>');
    s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    s = s.replace(/^### (.+)$/gm, '<h4 class="font-black text-sm mt-3 mb-1">$1</h4>');
    s = s.replace(/^## (.+)$/gm, '<h3 class="font-black text-base mt-3 mb-1">$1</h3>');
    s = s.replace(/^[\-\*] (.+)$/gm, '<li class="ml-4 list-disc text-sm leading-relaxed">$1</li>');
    s = s.replace(/((?:<li[^>]*>.*<\/li>\n?)+)/g, '<ul class="space-y-1 my-2">$1</ul>');
    s = s.replace(/\n\n/g, '</p><p class="mt-2">');
    s = s.replace(/\n/g, '<br>');
    return '<p>' + s + '</p>';
  }

  function sendChatMessage(msg) {
    if (chatBusy) return;
    msg = (msg || '').trim();
    if (!msg) return;
    chatBusy = true;
    if (chatInput) { chatInput.disabled = true; chatInput.value = ''; }
    if (chatInputFloat) { chatInputFloat.disabled = true; chatInputFloat.value = ''; }
    if (chatMessages) renderMsgTo(chatMessages, 'user', msg);
    if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, 'user', msg);
    chatHistory.push({ role: 'user', content: msg });
    if (typingFloat) typingFloat.classList.remove('hidden');
    if (typingInline) typingInline.classList.remove('hidden');
    if (typingStatus) typingStatus.textContent = 'Thinking…';
    // Animate status text to show progress
    var statusMsgs = ['Thinking…', 'Thinking….', 'Thinking…..', 'Thinking…...'];
    var statusIdx = 0;
    var statusInterval = setInterval(function() {
      if (typingStatus) typingStatus.textContent = statusMsgs[statusIdx % statusMsgs.length];
      statusIdx++;
    }, 400);
    var timedOut = false;
    var timeoutId = setTimeout(function() {
      timedOut = true;
      clearInterval(statusInterval);
      if (typingFloat) typingFloat.classList.add('hidden');
      if (typingInline) typingInline.classList.add('hidden');
      var errMsg = '⏱ Request timed out. Try again in a moment.';
      if (chatMessages) renderMsgTo(chatMessages, 'assistant', errMsg);
      if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, 'assistant', errMsg);
      chatBusy = false;
      if (chatInput) { chatInput.disabled = false; chatInput.focus(); }
      if (chatInputFloat) { chatInputFloat.disabled = false; chatInputFloat.focus(); }
    }, 30000);
    fetch('/ceo/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg, history: chatHistory.slice(-10) }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (timedOut) return;
      clearTimeout(timeoutId);
      clearInterval(statusInterval);
      if (typingFloat) typingFloat.classList.add('hidden');
      if (typingInline) typingInline.classList.add('hidden');
      if (d.success && d.reply) {
        if (chatMessages) renderMsgTo(chatMessages, 'assistant', d.reply);
        if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, 'assistant', d.reply);
        chatHistory.push({ role: 'assistant', content: d.reply });
        if (!chatOpen && chatBubbleDot) chatBubbleDot.classList.remove('hidden');
      } else {
        var errMsg = d.error || 'Something went wrong. Try again.';
        if (chatMessages) renderMsgTo(chatMessages, 'assistant', errMsg);
        if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, 'assistant', errMsg);
      }
      chatBusy = false;
      if (chatInput) { chatInput.disabled = false; chatInput.focus(); }
      if (chatInputFloat) { chatInputFloat.disabled = false; chatInputFloat.focus(); }
    }).catch(function() {
      if (timedOut) return;
      clearTimeout(timeoutId);
      clearInterval(statusInterval);
      if (typingFloat) typingFloat.classList.add('hidden');
      if (typingInline) typingInline.classList.add('hidden');
      var errMsg = 'Connection error. Check your internet and try again.';
      if (chatMessages) renderMsgTo(chatMessages, 'assistant', errMsg);
      if (chatMessagesFloat) renderMsgTo(chatMessagesFloat, 'assistant', errMsg);
      chatBusy = false;
      if (chatInput) { chatInput.disabled = false; chatInput.focus(); }
      if (chatInputFloat) { chatInputFloat.disabled = false; chatInputFloat.focus(); }
    });
  }

  if (chatForm) {
    chatForm.addEventListener('submit', function(e) {
      e.preventDefault();
      sendChatMessage(chatInput.value);
    });
  }
  if (chatFormFloat) {
    chatFormFloat.addEventListener('submit', function(e) {
      e.preventDefault();
      sendChatMessage(chatInputFloat.value);
    });
  }
  if (chatBubble) {
    chatBubble.addEventListener('click', function() {
      chatOpen = !chatOpen;
      if (chatOpen) {
        chatWindow.classList.remove('hidden');
        chatBubbleIcon.classList.add('hidden');
        chatBubbleClose.classList.remove('hidden');
        chatBubbleDot.classList.add('hidden');
        setTimeout(function() {
          if (chatMessagesFloat) chatMessagesFloat.scrollTop = chatMessagesFloat.scrollHeight;
          if (chatInputFloat) chatInputFloat.focus();
        }, 100);
      } else {
        chatWindow.classList.add('hidden');
        chatBubbleIcon.classList.remove('hidden');
        chatBubbleClose.classList.add('hidden');
      }
    });
  }
  if (chatWindowClose) {
    chatWindowClose.addEventListener('click', function() {
      chatOpen = false;
      chatWindow.classList.add('hidden');
      chatBubbleIcon.classList.remove('hidden');
      chatBubbleClose.classList.add('hidden');
    });
  }

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

}); // ── end DOMContentLoaded ──
</script>
</body>
</html>
