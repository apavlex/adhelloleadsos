<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - AdHello.ai | Leads</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<!-- Leads Background Color -->
<body class="bg-[#FDFBF7] min-h-screen w-full flex items-center justify-center p-6 relative overflow-hidden font-sans">
    
    <!-- Login Card -->
    <div class="brand-card max-w-lg w-full p-16 text-center bg-white shadow-[0_32px_64px_-16px_rgba(0,0,0,0.08)] relative z-10 border-none rounded-[3.5rem]">
        
        <!-- Lock icon container -->
        <div class="w-24 h-24 bg-white rounded-3xl flex items-center justify-center mx-auto mb-10 border border-slate-100 shadow-sm">
            <svg class="w-10 h-10 text-slate-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        
        <h1 class="font-display font-extrabold text-[2.75rem] text-[#0F172A] mb-4 tracking-tight leading-tight">Welcome Back</h1>
        <p class="text-[11px] font-bold tracking-[0.15em] uppercase text-slate-500 mb-14 px-4 leading-relaxed line-height-1">Access is restricted to authorized @adhello.ai workspace members.</p>

        <% if (error === 'unauthorized') { %>
            <div class="bg-red-50 text-red-600 p-5 rounded-2xl text-[10px] uppercase tracking-widest font-black mb-10 border border-red-100/50 animate-shake flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                Access Denied: Use an @adhello.ai email
            </div>
        <% } %>

        <a href="/auth/google" class="w-full h-16 flex items-center justify-center gap-4 bg-[#FFDB3A] hover:bg-[#FFD600] active:scale-[0.98] transition-all rounded-full text-lg font-bold text-[#111827] shadow-lg shadow-yellow-400/20">
            <svg class="w-6 h-6" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19.982 10.23c0-.7-.063-1.371-.18-2.02H10.194v3.82h5.485c-.237 1.275-.956 2.356-2.036 3.078v2.558h3.298c1.93-1.776 3.04-4.39 3.04-7.436z" fill="#4285F4"/>
                <path d="M10.194 20c2.7 0 4.964-.896 6.619-2.422l-3.298-2.559c-.914.613-2.084.976-3.321.976-2.554 0-4.714-1.725-5.487-4.04H1.309v2.624C2.973 17.842 6.36 20 10.194 20z" fill="#34A853"/>
                <path d="M4.707 11.955c-.2-.596-.313-1.233-.313-1.895s.114-1.3.313-1.895V5.541H1.31C.647 6.865.269 8.358.269 9.94c0 1.583.378 3.076 1.041 4.401l3.397-2.624z" fill="#FBBC05"/>
                <path d="M10.194 3.918c1.47 0 2.788.505 3.825 1.49l2.868-2.868C15.153 1.066 12.89 0 10.194 0 6.36 0 2.973 2.158 1.309 5.541l3.397 2.624c.773-2.315 2.933-4.04 5.487-4.04z" fill="#EA4335"/>
            </svg>
            Sign in with Google
        </a>
        
        <div class="mt-14 pt-10 border-t border-slate-100 text-slate-400 text-[10px] font-black uppercase tracking-[0.25em] flex items-center justify-center gap-4">
            <span>AdHello.ai | Leads</span>
        </div>
    </div>

    <!-- Background Decorative Elements -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-yellow-100/30 rounded-full blur-3xl -z-0"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-orange-50/40 rounded-full blur-3xl -z-0"></div>

</body>
</html>
