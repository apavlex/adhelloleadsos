<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Agency OS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-brand-cream min-h-screen w-full relative">
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="brand-card max-w-md w-full p-12 text-center shadow-2xl relative z-10 bg-white">
        <div class="w-20 h-20 bg-brand-yellow rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-brutal border-2 border-brand-dark">
            <svg class="w-10 h-10 text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        
        <h1 class="font-display font-extrabold text-3xl text-brand-dark mb-4">Welcome Back</h1>
        <p class="text-brand-muted font-medium mb-10">Access is restricted to authorized workspace members.</p>

        <% if (error === 'unauthorized') { %>
            <div class="bg-red-50 text-red-600 p-4 rounded-2xl text-sm font-bold mb-8 border border-red-100 animate-shake">
                Access denied. Please use an @adhello.ai email.
            </div>
        <% } %>

        <a href="/auth/google" class="btn-pill btn-primary w-full py-5 text-lg flex items-center justify-center gap-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign in with Google
        </a>
        
        <div class="mt-8 pt-8 border-t border-brand-border/50 text-brand-muted text-[10px] font-bold uppercase tracking-widest">
            Agency OS • Google Maps Lead Agent
        </div>
    </div>
</body>
</html>
