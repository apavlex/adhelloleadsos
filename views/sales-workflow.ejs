<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-14">
    <%- include('partials/sales-nav') %>

    <style>.workflow-filtered-out{display:none!important}</style>
    <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10 mb-10">
      <div class="px-6 py-4 border-b border-brand-border dark:border-white/10 bg-gray-50/50 dark:bg-white/5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Lead pipeline</h2>
          <p class="text-xs text-brand-muted mt-1">All leads in one pipeline. Warm (AdHello) defaults to CQI when ingested.</p>
        </div>
        <% if (leads.length > 0) { %>
          <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:items-end">
            <div class="min-w-[10rem]">
              <label for="workflowStageFilter" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Stage</label>
              <select id="workflowStageFilter" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-xs font-semibold px-3 py-2.5 text-brand-dark dark:text-white">
                <option value="">All stages</option>
                <% stages.forEach((s) => { %>
                  <option value="<%= s.id %>"><%= s.id %>. <%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="min-w-[12rem] sm:min-w-[16rem] flex-1 max-w-md">
              <label for="workflowLeadSearch" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Search</label>
              <input id="workflowLeadSearch" type="search" autocomplete="off" placeholder="Company, email, phone, domain…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-xs font-semibold px-3 py-2.5 text-brand-dark dark:text-white placeholder:text-brand-muted/60" />
            </div>
          </div>
        <% } %>
      </div>
      <div class="overflow-x-auto">
        <% if (leads.length === 0) { %>
          <p class="p-8 text-sm text-brand-muted">No leads yet. <a href="/" class="text-brand-yellow font-bold underline">Run a search</a> or <a href="/leads" class="text-brand-yellow font-bold underline">import a CSV</a>.</p>
        <% } else { %>
          <table class="w-full text-left text-sm" id="workflowPipelineTable">
            <thead>
              <tr class="border-b border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-muted">
                <th class="px-6 py-4">Company</th>
                <th class="px-6 py-4">Domain</th>
                <th class="px-6 py-4">Email</th>
                <th class="px-6 py-4">Phone</th>
                <th class="px-6 py-4">Stage</th>
                <th class="px-6 py-4">CQI</th>
                <th class="px-6 py-4 text-right">More detail</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50 dark:divide-white/5">
              <% leads.forEach((lead, i) => { %>
                <% const _ps = parseInt(lead.pipelineStage, 10); %>
                <% const psRow = !Number.isNaN(_ps) && _ps >= 1 && _ps <= 10 ? _ps : 1; %>
                <% const stRow = stages.find((s) => s.id === psRow); %>
                <% const pipeName = stRow ? stRow.name.replace(/\s*\(.*$/, '').trim() : 'Stage'; %>
                <% const pipeShort = pipeName.length > 26 ? pipeName.slice(0, 26) + '…' : pipeName; %>
                <% const rowAnchor = String(lead.key || '').replace(/[^a-z0-9]+/gi, '-'); %>
                <% const rawSite = lead.website || ''; %>
                <% let domainLabel = '—'; %>
                <% if (rawSite && rawSite !== 'N/A') { %>
                  <% try { const u = new URL(rawSite.indexOf('http') === 0 ? rawSite : 'https://' + rawSite); domainLabel = u.hostname.replace(/^www\./i, ''); } catch (e) { domainLabel = String(rawSite).replace(/^https?:\/\//i, '').split('/')[0].replace(/^www\./i, '') || '—'; } %>
                <% } %>
                <% const searchHaystack = [lead.title, lead.email, lead.phone, lead.website, lead.city, lead.state, lead.address, lead.categoryName].filter((x) => x && String(x).trim()).join(' ').replace(/&/g, '&amp;').replace(/"/g, '&quot;'); %>
                <% const emailDisp = (lead.email && lead.email !== 'N/A') ? lead.email : '—'; %>
                <% const phoneDisp = (lead.phone && lead.phone !== 'N/A') ? lead.phone : '—'; %>
                <tr class="result-row scroll-mt-28 group hover:bg-brand-cream/30 dark:hover:bg-white/5 transition-colors"
                    id="lead-row-<%= rowAnchor %>"
                    data-index="<%= i %>"
                    data-lead-key="<%= lead.key %>"
                    data-pipeline-stage="<%= psRow %>"
                    data-pipeline-label="<%= pipeShort.replace(/"/g, '&quot;') %>"
                    data-title="<%= lead.title %>"
                    data-phone="<%= lead.phone || 'N/A' %>"
                    data-website="<%= lead.website || 'N/A' %>"
                    data-email="<%= lead.email || 'N/A' %>"
                    data-category="<%= lead.categoryName || 'N/A' %>"
                    data-address="<%= lead.address || 'N/A' %>"
                    data-city="<%= lead.city || '' %>"
                    data-rating="<%= lead.totalScore || 0 %>"
                    data-reviews="<%= lead.reviewsCount || 0 %>"
                    data-url="<%= lead.url || '' %>"
                    data-facebook="<%= lead.facebook || 'N/A' %>"
                    data-instagram="<%= lead.instagram || 'N/A' %>"
                    data-twitter="<%= lead.twitter || 'N/A' %>"
                    data-status="<%= (lead.status || 'Not Contacted') === 'Needs Video' ? 'Not Contacted' : (lead.status || 'Not Contacted') %>"
                    data-loom-url="<%= lead.loomUrl || '' %>"
                    data-outreach-prompt="<%= lead.outreachPrompt || '' %>"
                    data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'
                    data-has-schema-markup="<%= lead.hasSchemaMarkup %>"
                    data-has-chatbot="<%= lead.hasChatbot %>"
                    data-has-click-to-call="<%= lead.hasClickToCall %>"
                    data-is-mobile-friendly="<%= lead.isMobileFriendly %>"
                    data-is-outdated="<%= lead.isOutdated %>"
                    data-visual-modernity-score="<%= lead.visualModernityScore %>"
                    data-aeo-score="<%= lead.aeoScore %>"
                    data-geo-gaps="<%= lead.geoGaps %>"
                    data-audit-summary="<%= lead.auditSummary %>"
                    data-cms-platform="<%= lead.cmsPlatform || '' %>"
                    data-buying-signals='<%= JSON.stringify(lead.buyingSignals || []).replace(/'/g, "&apos;") %>'
                    data-source="<%= lead.source || 'manual' %>"
                    data-audit-data='<%= JSON.stringify(lead.auditData || null).replace(/'/g, "&apos;") %>'
                    data-chat-history='<%= JSON.stringify(lead.chatHistory || null).replace(/'/g, "&apos;") %>'
                    data-cqi='<%= JSON.stringify(lead.cqi || null).replace(/'/g, "&apos;") %>'
                    data-stitch-design-url="<%= lead.stitchDesignUrl || '' %>"
                    data-stitch-screenshot-url="<%= lead.stitchScreenshotUrl || '' %>"
                    data-stitch-screen-id="<%= lead.stitchScreenId || '' %>"
                    data-workflow-search="<%= searchHaystack %>">
                  <td class="px-6 py-4">
                    <div class="font-bold text-brand-dark dark:text-white"><%= lead.title %></div>
                    <div class="text-[11px] text-brand-muted"><%= lead.city || '' %><% if (lead.state) { %>, <%= lead.state %><% } %></div>
                  </td>
                  <td class="px-6 py-4 align-top max-w-[10rem] sm:max-w-[14rem]">
                    <% if (domainLabel !== '—') { %>
                      <span class="text-xs font-medium text-brand-dark dark:text-slate-200 truncate block" title="<%= domainLabel %>"><%= domainLabel %></span>
                    <% } else { %>
                      <span class="text-brand-muted">—</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 align-top max-w-[12rem]">
                    <% if (emailDisp !== '—') { %>
                      <span class="text-xs font-medium text-brand-dark dark:text-slate-200 truncate block" title="<%= emailDisp %>"><%= emailDisp %></span>
                    <% } else { %>
                      <span class="text-brand-muted">—</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 align-top max-w-[9rem]">
                    <% if (phoneDisp !== '—') { %>
                      <span class="text-xs font-medium text-brand-dark dark:text-slate-200 truncate block" title="<%= phoneDisp %>"><%= phoneDisp %></span>
                    <% } else { %>
                      <span class="text-brand-muted">—</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 align-top">
                    <form action="/sales/workflow/stage" method="post" class="flex flex-col sm:flex-row gap-2 items-start">
                      <input type="hidden" name="leadKey" value="<%= lead.key %>" />
                      <% const ps = (typeof lead.pipelineStage === 'number' && lead.pipelineStage >= 1 && lead.pipelineStage <= 10) ? lead.pipelineStage : 1; %>
                      <select name="pipelineStage" class="rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-xs font-semibold px-3 py-2 text-brand-dark dark:text-white max-w-[220px]">
                        <% stages.forEach((s) => { %>
                          <option value="<%= s.id %>" <%= (ps === s.id) ? 'selected' : '' %>><%= s.id %>. <%= s.name %></option>
                        <% }) %>
                      </select>
                      <button type="submit" class="btn-pill bg-brand-yellow text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest shrink-0">Save</button>
                    </form>
                  </td>
                  <td class="px-6 py-4 align-top text-[11px] text-brand-muted max-w-xs">
                    <% if (lead.cqi && (lead.cqi.monthlyRevenue || lead.cqi.marketingSpend || lead.cqi.notes)) { %>
                      <span class="text-emerald-600 dark:text-emerald-400 font-bold">Logged</span>
                      <% if (lead.cqi.recordedAt) { %><br><span class="opacity-70"><%= new Date(lead.cqi.recordedAt).toLocaleDateString() %></span><% } %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td class="px-6 py-4 align-top text-right">
                    <button type="button" class="view-detail-btn text-[10px] font-black uppercase text-brand-yellow underline decoration-brand-yellow/40 hover:decoration-brand-yellow bg-transparent border-0 cursor-pointer p-0">More detail</button>
                  </td>
                </tr>
              <% }) %>
              <tr id="workflow-filter-empty" class="hidden">
                <td colspan="7" class="px-6 py-10 text-center text-sm text-brand-muted">No leads match this filter.</td>
              </tr>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="brand-card p-8 dark:bg-slate-900 dark:border-white/10 mb-10">
      <h2 class="font-display font-extrabold text-lg mb-2 text-brand-dark dark:text-white">Client Qualification Interview (CQI)</h2>
      <p class="text-sm text-brand-muted mb-6">Saves to the lead as <code class="text-xs bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">cqi</code> — revenue, spend, and notes.</p>
      <% if (leads.length === 0) { %>
        <p class="text-sm text-brand-muted">Add leads first to log CQI.</p>
      <% } else { %>
        <form action="/sales/workflow/cqi" method="post" class="grid gap-4 max-w-xl">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Lead</label>
            <select name="leadKey" required class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white">
              <% leads.forEach((lead) => { %>
                <option value="<%= lead.key %>"><%= lead.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Monthly revenue (approx)</label>
              <input name="monthlyRevenue" type="text" placeholder="$ e.g. 45k/mo" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white" />
            </div>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Marketing spend</label>
              <input name="marketingSpend" type="text" placeholder="$ e.g. 2k/mo ads" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white" />
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Discovery notes</label>
            <textarea name="cqiNotes" rows="4" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white" placeholder="Pain, stack, decision maker, timeline…"></textarea>
          </div>
          <button type="submit" class="btn-pill btn-primary w-fit px-8 py-3 text-xs font-black uppercase tracking-widest">Save CQI</button>
        </form>
      <% } %>
    </div>

    <details class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden group/blueprint">
      <summary class="px-6 py-4 cursor-pointer list-none flex flex-wrap items-center justify-between gap-3 border-b border-brand-border dark:border-white/10 bg-gray-50/50 dark:bg-white/5 [&::-webkit-details-marker]:hidden">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Reference only</p>
          <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white mt-0.5">10-stage methodology</h2>
          <p class="text-xs text-brand-muted dark:text-slate-400 mt-1 max-w-2xl">Definitions for each stage — informational. Use the table above to change stages.</p>
        </div>
        <span class="text-brand-muted dark:text-slate-400 text-lg shrink-0 group-open/blueprint:rotate-180 transition-transform" aria-hidden="true">▼</span>
      </summary>
      <div class="p-6 pt-4 space-y-8">
        <div class="flex flex-wrap gap-2">
          <% stages.forEach((s) => { %>
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-cream/40 dark:bg-white/5 border border-brand-border dark:border-white/10 text-[11px] font-bold text-brand-dark dark:text-white">
              <span class="text-brand-muted font-black"><%= s.id %></span>
              <%= s.name %>
              <span class="text-brand-yellow font-black">(<%= counts[s.id] || 0 %>)</span>
            </span>
          <% }) %>
        </div>
        <div class="space-y-4">
          <% stages.forEach((s) => { %>
            <details class="rounded-2xl border border-brand-border dark:border-white/10 bg-white/60 dark:bg-slate-950/40 group/stage">
              <summary class="px-5 py-3 cursor-pointer font-display font-bold text-brand-dark dark:text-white list-none flex justify-between items-center text-sm [&::-webkit-details-marker]:hidden">
                <span><span class="text-brand-yellow mr-2"><%= s.id %>.</span> <%= s.name %></span>
                <span class="text-[10px] font-black uppercase text-brand-muted group-open/stage:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="px-5 pb-4 pt-0 text-sm text-brand-muted dark:text-slate-400 border-t border-brand-border/40 dark:border-white/5">
                <%= s.summary %>
              </div>
            </details>
          <% }) %>
        </div>
      </div>
    </details>
  </main>

  <%- include('partials/lead_detail_panel') %>

  <script>
    window.INITIAL_SAVED_LEADS = <%- JSON.stringify(leads || []) %>;
    window.PIPELINE_STAGE_LABELS = <%- JSON.stringify(stages.reduce((m, s) => { m[s.id] = s.name; return m; }, {})) %>;
  </script>
  <script>
  (function () {
    var stageSel = document.getElementById('workflowStageFilter');
    var searchInp = document.getElementById('workflowLeadSearch');
    var emptyRow = document.getElementById('workflow-filter-empty');
    if (!stageSel && !searchInp) return;

    function workflowDataRows() {
      return document.querySelectorAll('#workflowPipelineTable tbody tr.result-row');
    }

    function applyWorkflowFilters() {
      var st = stageSel ? String(stageSel.value) : '';
      var q = (searchInp && searchInp.value) ? searchInp.value.trim().toLowerCase() : '';
      var rows = workflowDataRows();
      var anyVisible = false;
      rows.forEach(function (tr) {
        var matchStage = !st || String(tr.getAttribute('data-pipeline-stage') || '') === st;
        var hay = (tr.getAttribute('data-workflow-search') || '').toLowerCase();
        var matchSearch = !q || hay.indexOf(q) !== -1;
        var show = matchStage && matchSearch;
        if (show) anyVisible = true;
        tr.classList.toggle('workflow-filtered-out', !show);
      });
      if (emptyRow) emptyRow.classList.toggle('hidden', anyVisible || rows.length === 0);
      var sel = document.querySelector('#workflowPipelineTable tr.result-row.selected');
      if (sel && sel.classList.contains('workflow-filtered-out')) {
        var closeBtn = document.getElementById('closeMobilePanel');
        if (closeBtn) closeBtn.click();
      }
    }

    if (stageSel) stageSel.addEventListener('change', applyWorkflowFilters);
    if (searchInp) searchInp.addEventListener('input', applyWorkflowFilters);
  })();
  </script>
  <script src="/js/app.js"></script>
</body>
</html>
