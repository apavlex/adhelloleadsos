<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#FFDB3A">
  <title>Start your free trial - AdHello.ai | Leads</title>
  <link rel="icon" href="/images/adhello-app-icon.png" type="image/png">
  <link rel="stylesheet" href="/css/custom.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <%- include('partials/tailwind_css', { twVariant: 'standalone' }) %>
  <style>
    .su-card { max-width: 34rem; width: 100%; background: #fff; border-radius: 2rem; box-shadow: 0 32px 64px -16px rgba(0,0,0,0.08); padding: 2rem; }
    @media (min-width: 640px) { .su-card { padding: 2.5rem 2.75rem; } }
    .su-grid { display: grid; grid-template-columns: 1fr; gap: 0.9rem 1rem; }
    @media (min-width: 640px) { .su-grid { grid-template-columns: 1fr 1fr; } .su-span { grid-column: span 2; } }
    .su-field label { display: block; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 0.35rem; }
    .su-field label .opt { font-weight: 600; text-transform: none; letter-spacing: 0; color: #94a3b8; }
    .su-field input, .su-field select { width: 100%; height: 2.9rem; border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #fbfaf6; padding: 0 0.9rem; font-size: 15px; color: #0f172a; outline: none; }
    .su-field input:focus, .su-field select:focus { border-color: #eab308; box-shadow: 0 0 0 3px rgba(250, 204, 21, 0.25); background: #fff; }
    .su-perks { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 12px; color: #475569; }
    .su-perks span::before { content: '✓'; color: #16a34a; font-weight: 900; margin-right: 0.35rem; }
    .su-btn { width: 100%; height: 3.5rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem; border-radius: 9999px; background: #FFDB3A; color: #111827; font-weight: 800; font-size: 16px; box-shadow: 0 10px 20px -8px rgba(250, 204, 21, 0.5); transition: background 0.15s; }
    .su-btn:hover { background: #FFD600; }
    .su-btn[disabled] { opacity: 0.7; cursor: progress; }
    .su-errors { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 1rem; padding: 0.75rem 1rem; font-size: 13px; }
    .su-errors li + li { margin-top: 0.2rem; }
  </style>
</head>
<body class="bg-[#FDFBF7] min-h-screen w-full font-sans">
  <% const _f = form || {}; %>
  <main class="min-h-screen w-full flex flex-col items-center justify-center px-5 py-10">
    <div class="su-card">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/adhello-app-icon.png" alt="AdHello" width="40" height="40" class="w-10 h-10 rounded-xl border border-slate-100" />
        <span class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-500">AdHello Leads &middot; Agency OS</span>
      </div>

      <% if (typeof connectClient !== 'undefined' && connectClient) { %>
        <p class="mb-5 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-800 leading-relaxed"><strong><%= connectClient %></strong> wants to connect to AdHello. Create your free workspace and you'll go right back to finish connecting.</p>
      <% } else if (typeof aiSetup !== 'undefined' && aiSetup) { %>
        <p class="mb-5 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-800 leading-relaxed">After you sign up you'll land on <strong>AI Connector</strong> with your connector URL and a one-click token for ChatGPT, Claude, Grok, Muse or any MCP agent.</p>
      <% } %>
      <h1 class="font-display font-extrabold text-2xl text-[#0F172A] leading-tight">Start your <%= trialDays %>-day free trial</h1>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">Find local businesses, see who needs reviews or a website, and work every lead from one pipeline.</p>
      <div class="su-perks mt-4"><span>No credit card</span><span>Your own private workspace</span><span>Nothing is charged when it ends</span></div>

      <% if (signedInAs) { %>
        <p class="mt-5 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-800 leading-relaxed">Signed in as <strong><%= signedInAs %></strong>. Add your details to set up your workspace. <span class="block mt-1">Were you invited to a team? Open the invite link from your email instead.</span></p>
      <% } %>

      <% if (errors && errors.length) { %>
        <ul class="su-errors mt-5" role="alert">
          <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
        </ul>
      <% } %>

      <form id="signupForm" method="post" action="/signup" class="mt-5" novalidate>
        <div class="su-grid">
          <div class="su-field">
            <label for="su-name">Full name</label>
            <input id="su-name" name="name" autocomplete="name" required maxlength="80" value="<%= _f.name || '' %>">
          </div>
          <div class="su-field">
            <label for="su-phone">Phone</label>
            <input id="su-phone" name="phone" type="tel" autocomplete="tel" required maxlength="30" value="<%= _f.phone || '' %>">
          </div>
          <div class="su-field">
            <label for="su-company">Company / agency</label>
            <input id="su-company" name="company" autocomplete="organization" required maxlength="100" value="<%= _f.company || '' %>">
          </div>
          <div class="su-field">
            <label for="su-website">Website <span class="opt">(optional)</span></label>
            <input id="su-website" name="website" inputmode="url" autocomplete="url" maxlength="200" placeholder="yourcompany.com" value="<%= _f.website || '' %>">
          </div>
          <div class="su-field su-span">
            <label for="su-niche">Niche / industry you target</label>
            <input id="su-niche" name="niche" required maxlength="120" placeholder="e.g. roofers, med spas, HVAC" value="<%= _f.niche || '' %>">
          </div>
          <div class="su-field">
            <label for="su-team">Team size</label>
            <select id="su-team" name="teamSize" required>
              <option value="">Choose…</option>
              <% TEAM_SIZES.forEach(function (t) { %><option value="<%= t %>"<%= _f.teamSize === t ? ' selected' : '' %>><%= t %></option><% }) %>
            </select>
          </div>
          <div class="su-field">
            <label for="su-source">How did you hear about us?</label>
            <select id="su-source" name="source" required>
              <option value="">Choose…</option>
              <% SOURCES.forEach(function (s) { %><option value="<%= s %>"<%= _f.source === s ? ' selected' : '' %>><%= s %></option><% }) %>
            </select>
          </div>
          <div class="su-field su-span" id="su-other-wrap"<%= _f.source === 'Other' ? '' : ' hidden' %>>
            <label for="su-other">Where? <span class="opt">(optional)</span></label>
            <input id="su-other" name="sourceOther" maxlength="120" value="<%= _f.sourceOther || '' %>">
          </div>
        </div>

        <button id="signupGo" type="submit" class="su-btn mt-7"<%= googleAuthConfigured || signedInAs ? '' : ' disabled' %>>
          <% if (!signedInAs) { %>
          <svg width="22" height="22" viewBox="0 0 21 20" fill="none" aria-hidden="true">
            <path d="M19.982 10.23c0-.7-.063-1.371-.18-2.02H10.194v3.82h5.485c-.237 1.275-.956 2.356-2.036 3.078v2.558h3.298c1.93-1.776 3.04-4.39 3.04-7.436z" fill="#4285F4"/>
            <path d="M10.194 20c2.7 0 4.964-.896 6.619-2.422l-3.298-2.559c-.914.613-2.084.976-3.321.976-2.554 0-4.714-1.725-5.487-4.04H1.309v2.624C2.973 17.842 6.36 20 10.194 20z" fill="#34A853"/>
            <path d="M4.707 11.955c-.2-.596-.313-1.233-.313-1.895s.114-1.3.313-1.895V5.541H1.31C.647 6.865.269 8.358.269 9.94c0 1.583.378 3.076 1.041 4.401l3.397-2.624z" fill="#FBBC05"/>
            <path d="M10.194 3.918c1.47 0 2.788.505 3.825 1.49l2.868-2.868C15.153 1.066 12.89 0 10.194 0 6.36 0 2.973 2.158 1.309 5.541l3.397 2.624c.773-2.315 2.933-4.04 5.487-4.04z" fill="#EA4335"/>
          </svg>
          <span>Continue with Google</span>
          <% } else { %>
          <span>Start my free trial</span>
          <% } %>
        </button>
        <% if (!googleAuthConfigured && !signedInAs) { %>
          <p class="mt-3 text-center text-xs text-amber-700">Google sign-in isn't configured on this server yet.</p>
        <% } %>
      </form>

      <p class="mt-5 text-center text-xs text-slate-500">Already have an account? <a href="/auth/login" class="font-bold text-slate-800 underline underline-offset-2">Sign in</a></p>
    </div>
  </main>
  <script>
  (function () {
    var form = document.getElementById('signupForm');
    var btn = document.getElementById('signupGo');
    var source = document.getElementById('su-source');
    var otherWrap = document.getElementById('su-other-wrap');
    source.addEventListener('change', function () { otherWrap.hidden = source.value !== 'Other'; });
    form.addEventListener('submit', function () {
      btn.disabled = true;
      var label = btn.querySelector('span');
      if (label) label.textContent = 'One moment…';
    });
    window.addEventListener('pageshow', function (e) { if (e.persisted) btn.disabled = false; });
  })();
  </script>
</body>
</html>
