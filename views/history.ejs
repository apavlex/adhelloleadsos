<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Search Records</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          Search <span class="text-brand-muted">History</span>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          Review your previous <%= searches.length %> search activit<%= searches.length === 1 ? 'y' : 'ies' %>.
        </p>
      </div>
      <a href="/leads/find" class="btn-pill btn-primary">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New Search
      </a>
    </div>

    <% if (typeof showSearchProgress !== 'undefined' && showSearchProgress) { %>
      <div class="brand-card p-8 md:p-10 mb-8 border border-brand-yellow/30 bg-brand-yellow/5 dark:bg-slate-900/80 dark:border-brand-yellow/25" role="status" aria-live="polite" aria-busy="true">
        <div class="flex flex-col sm:flex-row sm:items-center gap-6">
          <div class="shrink-0 flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-yellow/20 border border-brand-yellow/30">
            <div class="animate-spin rounded-full h-8 w-8 border-[3px] border-brand-yellow/35 border-t-brand-yellow" aria-hidden="true"></div>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1">Scraping in progress</p>
            <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white tracking-tight">
              Finding &amp; enriching leads
            </h2>
            <p class="text-sm text-brand-muted dark:text-slate-400 mt-2 max-w-2xl leading-relaxed">
              <% if (activeJob && activeJob.keyword) { %>
                <strong class="text-brand-dark dark:text-white"><%= activeJob.keyword %></strong>
                <% if (activeJob.city || activeJob.state) { %>
                  <span class="text-brand-muted"> · <%= activeJob.city %><%= activeJob.city && activeJob.state ? ', ' : '' %><%= activeJob.state %></span>
                <% } %>
                — maps search and enrichment can take a few minutes. This page refreshes when the run completes.
              <% } else { %>
                Your search is running on the server. Maps pull plus social enrichment can take a few minutes. This page refreshes automatically when the run completes.
              <% } %>
            </p>
          </div>
        </div>
      </div>
    <% } %>

    <% if (searches.length > 0) { %>
      <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Search Query</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Location</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Results</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Date</th>
                <th class="px-8 py-5 text-right text-[10px] font-bold uppercase tracking-widest text-brand-muted">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% searches.forEach((search) => { %>
                <tr class="group hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-colors">
                  <td class="px-8 py-6">
                    <a href="/search/<%= encodeURIComponent(search.key) %>"
                       class="font-display font-bold text-brand-dark hover:text-black transition-colors">
                      <%= search.keyword %>
                    </a>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= search.city %>, <%= search.state %>
                  </td>
                  <td class="px-6 py-6">
                    <% const _found = search.resultCount != null ? search.resultCount : 0; %>
                    <% const _asked = search.maxResults != null ? search.maxResults : _found; %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-brand-yellow/10 text-brand-dark border border-brand-yellow/20"
                          title="<%= _found < _asked ? 'Requested up to ' + _asked + '; Google Maps had ' + _found + ' matching businesses in this area.' : '' %>">
                      <%= _found %> lead<%= _found === 1 ? '' : 's' %><% if (_found < _asked) { %> <span class="font-semibold normal-case text-brand-muted">/ <%= _asked %></span><% } %>
                    </span>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= new Date(search.timestamp).toLocaleDateString() %>
                  </td>
                  <td class="px-8 py-6 text-right">
                    <div class="flex items-center justify-end gap-3">
                      <a href="/search/<%= encodeURIComponent(search.key) %>"
                         class="btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] dark:text-slate-100">
                        View
                      </a>
                      <form action="/history/<%= encodeURIComponent(search.key) %>/delete"
                            method="POST"
                            onsubmit="return confirm('Delete this search?')">
                        <button type="submit"
                                class="btn-pill bg-red-50 text-red-600 border border-red-100 px-4 py-2 text-[10px] hover:bg-red-100">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else if (!(typeof showSearchProgress !== 'undefined' && showSearchProgress)) { %>
      <div class="brand-card p-24 text-center max-w-2xl mx-auto">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="font-display font-extrabold text-2xl mb-2">No history found</h2>
        <p class="text-brand-muted font-medium mb-8">Your search history will appear here once you start searching.</p>
        <a href="/leads/find" class="btn-pill btn-primary px-10">Start Searching</a>
      </div>
    <% } %>
  </main>

  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <% if (typeof showSearchProgress !== 'undefined' && showSearchProgress) { %>
  <script>
  (function () {
    function poll() {
      fetch('/api/status', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || !data.isProcessing) {
            window.location.replace('/history');
            return;
          }
          setTimeout(poll, 2000);
        })
        .catch(function () { setTimeout(poll, 3000); });
    }
    setTimeout(poll, 1200);
  })();
  </script>
  <% } %>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
