<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/navbar') %>

  <div class="ml-56 min-h-screen flex flex-col">

    <!-- Top bar -->
    <div class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-lg font-semibold text-gray-800">Search History</h1>
        <p class="text-sm text-gray-500"><%= searches.length %> saved search<%= searches.length !== 1 ? 'es' : '' %></p>
      </div>
      <a href="/"
        class="px-4 py-2 bg-sidebar text-white rounded-lg text-sm font-medium hover:bg-sidebar-active transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New Search
      </a>
    </div>

    <% if (searches.length > 0) { %>
      <div class="flex-1 overflow-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200 sticky top-0">
            <tr>
              <th class="px-8 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Search Query</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Results</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider pr-8">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% searches.forEach((search) => { %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-8 py-3.5">
                  <a href="/search/<%= encodeURIComponent(search.key) %>"
                     class="text-sm font-medium text-gray-900 hover:text-accent">
                    <%= search.keyword %>
                  </a>
                </td>
                <td class="px-4 py-3.5 text-sm text-gray-600">
                  <%= search.city %>, <%= search.state %>
                </td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-accent-light text-accent">
                    <%= search.resultCount %> leads
                  </span>
                </td>
                <td class="px-4 py-3.5 text-sm text-gray-500">
                  <%= new Date(search.timestamp).toLocaleDateString() %>
                </td>
                <td class="px-4 py-3.5 text-right pr-8">
                  <div class="flex items-center justify-end gap-2">
                    <a href="/search/<%= encodeURIComponent(search.key) %>"
                       class="px-3 py-1.5 text-xs font-medium bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">
                      View
                    </a>
                    <form action="/history/<%= encodeURIComponent(search.key) %>/delete"
                          method="POST"
                          onsubmit="return confirm('Delete this search?')">
                      <button type="submit"
                              class="px-3 py-1.5 text-xs font-medium bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="flex-1 flex items-center justify-center">
        <div class="text-center">
          <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-gray-800 mb-1">No searches yet</h2>
          <p class="text-gray-500 text-sm mb-4">Your search history will appear here.</p>
          <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-sidebar text-white rounded-lg text-sm font-medium hover:bg-sidebar-active transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Start your first search
          </a>
        </div>
      </div>
    <% } %>

  </div>
</body>
</html>
