<!DOCTYPE html>
<html lang="en" class="h-full bg-brand-cream/30 dark:bg-slate-950">
<%- include('partials/head', { title: 'Analytics | AdHello Leads' }) %>
<body class="h-full font-sans text-brand-dark dark:text-slate-200 antialiased selection:bg-brand-yellow/30">
    <div class="min-h-full flex flex-col">
        <%- include('partials/navbar') %>

        <main class="flex-1 py-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Header -->
                <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                          <div class="w-12 h-12 bg-brand-yellow rounded-2xl flex items-center justify-center text-brand-dark shadow-xl shadow-brand-yellow/20">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                          </div>
                          <h1 class="text-4xl font-black tracking-tight text-brand-dark dark:text-white uppercase">Analytics</h1>
                        </div>
                        <p class="text-brand-muted font-bold text-lg">Real-time traffic from adhello.ai</p>
                    </div>
                </div>

                <!-- KPI Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
                    <div class="bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Total Visits</div>
                        <div class="text-4xl font-black text-brand-dark dark:text-white mb-1"><%= totalVisits %></div>
                        <div class="text-xs font-bold text-brand-yellow">All Time Data</div>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Unique Visitors</div>
                        <div class="text-4xl font-black text-brand-dark dark:text-white mb-1"><%= uniqueIPs %></div>
                        <div class="text-xs font-bold text-brand-yellow">Based on IP</div>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Conversion Rate</div>
                        <div class="text-4xl font-black text-brand-dark dark:text-white mb-1"><%= totalVisits > 0 ? ((leadCount / totalVisits) * 100).toFixed(1) : 0 %>%</div>
                        <div class="text-xs font-bold text-brand-yellow">Visits to Leads</div>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Top Region</div>
                        <div class="text-2xl font-black text-brand-dark dark:text-white mb-1 truncate"><%= topRegions[0] ? topRegions[0].name : '-' %></div>
                        <div class="text-xs font-bold text-brand-yellow">Highest Volume</div>
                    </div>
                </div>

                <!-- Main Chart -->
                <div class="bg-white dark:bg-slate-900 p-8 rounded-[3rem] border border-brand-border/40 dark:border-white/5 shadow-sm mb-10 overflow-hidden">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="text-xl font-black text-brand-dark dark:text-white tracking-tight uppercase">Daily Traffic Volume</h3>
                            <p class="text-xs font-bold text-brand-muted uppercase tracking-widest mt-1">Past 30 Days Activity</p>
                        </div>
                    </div>
                    <div id="trafficChart" class="h-80 w-full"></div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                    <!-- Top Regions -->
                    <div class="bg-white dark:bg-slate-900 p-8 rounded-[3rem] border border-brand-border/40 dark:border-white/5 shadow-sm h-full">
                        <h3 class="text-xl font-black text-brand-dark dark:text-white tracking-tight uppercase mb-8">Top Areas</h3>
                        <div class="space-y-6">
                            <% topRegions.forEach((region, i) => { %>
                                <div class="flex items-center justify-between group">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-xl bg-brand-yellow/10 flex items-center justify-center font-black text-brand-yellow text-sm border border-brand-yellow/20">
                                            <%= i + 1 %>
                                        </div>
                                        <div class="font-bold text-brand-dark dark:text-white"><%= region.name %></div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div class="w-32 bg-brand-border/10 h-2 rounded-full overflow-hidden">
                                            <div class="bg-brand-yellow h-full" style="width: <%= (region.count / totalVisits) * 100 %>%"></div>
                                        </div>
                                        <div class="font-black text-brand-dark dark:text-white w-8 text-right"><%= region.count %></div>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (topRegions.length === 0) { %>
                                <div class="text-center py-10 text-brand-muted font-bold italic">Waiting for traffic...</div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-black dark:bg-slate-900 p-8 rounded-[3rem] text-white shadow-2xl relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-8 opacity-10">
                            <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
                        </div>
                        <h3 class="text-xl font-black text-white tracking-tight uppercase mb-8 relative z-10">Real-time Feed</h3>
                        <div class="space-y-4 relative z-10 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                            <% recentVisits.forEach(visit => { %>
                                <div class="p-4 bg-white/5 rounded-2xl border border-white/5 hover:bg-white/10 transition-all flex items-center justify-between">
                                    <div>
                                        <div class="font-black text-sm text-brand-yellow"><%= visit.city %>, <%= visit.region %></div>
                                        <div class="text-[10px] text-white/50 font-bold uppercase tracking-widest mt-1"><%= visit.ip %> • <%= visit.path %></div>
                                    </div>
                                    <div class="text-[10px] font-black text-white/40 uppercase">
                                        <%= new Date(visit.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (recentVisits.length === 0) { %>
                                <div class="text-center py-10 text-white/30 font-bold italic">Monitoring live data...</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        
        <%- include('partials/footer') %>
    </div>

    <!-- Chart Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chartData = <%- JSON.stringify(chartData) %>;
            
            const options = {
                series: [{
                    name: 'Visits',
                    data: chartData.values
                }],
                chart: {
                    type: 'area',
                    height: 320,
                    toolbar: { show: false },
                    zoom: { enabled: false },
                    fontFamily: 'Inter, sans-serif',
                    background: 'transparent'
                },
                dataLabels: { enabled: false },
                stroke: {
                    curve: 'smooth',
                    width: 4,
                    colors: ['#FFD644']
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.45,
                        opacityTo: 0.05,
                        stops: [20, 100, 100, 100],
                        colorStops: [
                            { offset: 0, color: '#FFD644', opacity: 0.4 },
                            { offset: 100, color: '#FFD644', opacity: 0 }
                        ]
                    }
                },
                markers: {
                    size: 5,
                    colors: ['#FFD644'],
                    strokeColors: '#fff',
                    strokeWidth: 3,
                    hover: { size: 7 }
                },
                xaxis: {
                    categories: chartData.labels,
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' },
                        formatter: function(val) {
                            if (!val) return '';
                            const d = new Date(val);
                            return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
                        }
                    },
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' }
                    }
                },
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4,
                    padding: { left: 20, right: 20 }
                },
                theme: { mode: document.documentElement.classList.contains('dark') ? 'dark' : 'light' }
            };

            const chart = new ApexCharts(document.querySelector("#trafficChart"), options);
            chart.render();
        });
    </script>
</body>
</html>
