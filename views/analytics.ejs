<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Analytics | Leads' }) %>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden transition-colors duration-400 selection:bg-brand-yellow/30">
    <%- include('partials/navbar') %>

    <main class="max-wide px-6 py-12 relative">
        <!-- Subtle Background Pattern -->
        <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none select-none dark:opacity-[0.05]" 
             style="background-image: radial-gradient(#111827 1px, transparent 1px); background-size: 24px 24px;"></div>

        <div class="relative z-10">
                <!-- Header -->
                <% if (typeof isDemo !== 'undefined' && isDemo) { %>
                <div class="mb-6 rounded-2xl border border-amber-300/50 bg-amber-50/90 dark:bg-amber-950/40 dark:border-amber-500/30 px-4 py-3 text-sm text-amber-950 dark:text-amber-100">
                  <strong class="font-black uppercase tracking-widest text-[10px]">Sample data</strong>
                  — No visits recorded yet. This preview shows what the dashboard looks like once <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">/api/track</code> fires from adhello.ai (or remove <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">?preview=1</code> / disable <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">ANALYTICS_UI_DEMO</code>).
                </div>
                <% } %>
                <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                          <div class="w-10 h-10 bg-brand-yellow rounded-xl flex items-center justify-center text-brand-dark shadow-lg shadow-brand-yellow/20">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                          </div>
                          <h1 class="text-3xl font-black tracking-tight text-brand-dark dark:text-white uppercase">Analytics</h1>
                        </div>
                        <p class="text-brand-muted font-bold text-sm">Real-time traffic performance from adhello.ai</p>
                    </div>
                </div>

                <!-- KPI Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Total Visits</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= totalVisits %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">All Time</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Unique Visitors</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= uniqueIPs %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">IP Filtered</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Conversion</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= totalVisits > 0 ? ((leadCount / totalVisits) * 100).toFixed(1) : 0 %>%</div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">Visits to Leads</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Top Area</div>
                        <div class="text-xl font-black text-brand-dark dark:text-white mb-0.5 truncate"><%= topRegions[0] ? topRegions[0].name.split(',')[0] : '-' %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">Hot Spot</div>
                    </div>
                </div>

                <!-- Main Chart -->
                <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm mb-8 overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-black text-brand-dark dark:text-white tracking-tight uppercase leading-none">Traffic Momentum</h3>
                            <p class="text-[9px] font-bold text-brand-muted uppercase tracking-[0.15em] mt-1">30-Day Rolling Window</p>
                        </div>
                    </div>
                    <div id="trafficChart" class="h-64 w-full"></div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
                    <!-- Top Regions -->
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm min-h-[360px]">
                        <h3 class="text-lg font-black text-brand-dark dark:text-white tracking-tight uppercase mb-6">Regional Distribution</h3>
                        <div class="space-y-4">
                            <% topRegions.forEach((region, i) => { %>
                                <div class="flex items-center justify-between group p-3 hover:bg-brand-cream/40 dark:hover:bg-white/5 rounded-2xl transition-all">
                                    <div class="flex items-center gap-4">
                                        <div class="w-8 h-8 rounded-lg bg-brand-yellow/10 flex items-center justify-center font-black text-brand-yellow text-xs border border-brand-yellow/20">
                                            <%= i + 1 %>
                                        </div>
                                        <div class="font-bold text-sm text-brand-dark dark:text-white"><%= region.name %></div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div class="w-24 bg-brand-border/10 h-1.5 rounded-full overflow-hidden hidden sm:block">
                                            <div class="bg-brand-yellow h-full" style="width: <%= (region.count / totalVisits) * 100 %>%"></div>
                                        </div>
                                        <div class="font-black text-sm text-brand-dark dark:text-white w-6 text-right"><%= region.count %></div>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (topRegions.length === 0) { %>
                                <div class="flex flex-col items-center justify-center py-16 opacity-30">
                                    <svg class="w-12 h-12 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <p class="text-sm font-bold uppercase tracking-widest italic">Awaiting Global Signals...</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-[#0B0F1A] p-6 rounded-[2.5rem] text-white shadow-xl relative overflow-hidden min-h-[360px]">
                        <div class="absolute -top-10 -right-10 pointer-events-none opacity-5">
                            <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
                        </div>
                        <h3 class="text-lg font-black text-white tracking-tight uppercase mb-6 relative z-10 flex items-center gap-2">
                           <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> Live Stream
                        </h3>
                        <div class="space-y-3 relative z-10 max-h-[320px] overflow-y-auto pr-1 customized-scrollbar">
                            <% recentVisits.forEach(visit => { %>
                                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5 hover:bg-white/10 transition-all flex items-center justify-between group">
                                    <div>
                                        <div class="font-black text-xs text-brand-yellow group-hover:text-white transition-colors"><%= visit.city %>, <%= visit.region %></div>
                                        <div class="text-[9px] text-white/40 font-bold uppercase tracking-widest mt-0.5"><%= visit.ip %> • <%= visit.path %></div>
                                    </div>
                                    <div class="text-[9px] font-black text-white/20 uppercase">
                                        <%= new Date(visit.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (recentVisits.length === 0) { %>
                                <div class="flex flex-col items-center justify-center py-16 opacity-20">
                                    <svg class="w-12 h-12 mb-3 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
                                    <p class="text-sm font-bold uppercase tracking-widest italic">Scanning Frequency...</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <%- include('partials/footer') %>

    <!-- Chart Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chartData = <%- JSON.stringify(chartData) %>;
            
            const options = {
                series: [{
                    name: 'Visits',
                    data: chartData.values
                }],
                chart: {
                    type: 'area',
                    height: 320,
                    toolbar: { show: false },
                    zoom: { enabled: false },
                    fontFamily: 'Inter, sans-serif',
                    background: 'transparent'
                },
                dataLabels: { enabled: false },
                stroke: {
                    curve: 'smooth',
                    width: 4,
                    colors: ['#FFD644']
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.45,
                        opacityTo: 0.05,
                        stops: [20, 100, 100, 100],
                        colorStops: [
                            { offset: 0, color: '#FFD644', opacity: 0.4 },
                            { offset: 100, color: '#FFD644', opacity: 0 }
                        ]
                    }
                },
                markers: {
                    size: 5,
                    colors: ['#FFD644'],
                    strokeColors: '#fff',
                    strokeWidth: 3,
                    hover: { size: 7 }
                },
                xaxis: {
                    categories: chartData.labels,
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' },
                        formatter: function(val) {
                            if (!val) return '';
                            const d = new Date(val);
                            return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
                        }
                    },
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' }
                    }
                },
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4,
                    padding: { left: 20, right: 20 }
                },
                theme: { mode: document.documentElement.classList.contains('dark') ? 'dark' : 'light' }
            };

            const chart = new ApexCharts(document.querySelector("#trafficChart"), options);
            chart.render();
        });
    </script>
</body>
</html>
