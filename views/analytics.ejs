<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Reports | Leads' }) %>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden selection:bg-brand-yellow/30">
    <%- include('partials/navbar') %>

    <main class="max-wide px-6 py-12 relative">
        <!-- Subtle Background Pattern -->
        <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none select-none dark:opacity-[0.05]" 
             style="background-image: radial-gradient(#111827 1px, transparent 1px); background-size: 24px 24px;"></div>

        <div class="relative z-10">
                <!-- Header -->
                <% if (typeof isDemo !== 'undefined' && isDemo) { %>
                <div class="mb-6 rounded-2xl border border-amber-300/50 bg-amber-50/90 dark:bg-amber-950/40 dark:border-amber-500/30 px-4 py-3 text-sm text-amber-950 dark:text-amber-100">
                  <strong class="font-black uppercase tracking-widest text-[10px]">Sample data</strong>
                  — No visits recorded yet. This preview shows what the dashboard looks like once <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">/api/track</code> fires from adhello.ai (or remove <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">?preview=1</code> / disable <code class="text-[10px] px-1 rounded bg-white/60 dark:bg-black/30">ANALYTICS_UI_DEMO</code>).
                </div>
                <% } %>
                <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                          <div class="w-10 h-10 bg-brand-yellow rounded-xl flex items-center justify-center text-brand-dark shadow-lg shadow-brand-yellow/20">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                          </div>
                          <h1 class="text-3xl font-black tracking-tight text-brand-dark dark:text-white uppercase">Reports</h1>
                        </div>
                    </div>
                </div>

                <% const rt = typeof reportsTab !== 'undefined' ? reportsTab : 'tracker'; %>
                <% const _rs = typeof reportsScope !== 'undefined' ? reportsScope : 'workspace'; %>
                <nav class="mb-8 w-full max-w-4xl rounded-2xl border-2 border-brand-border dark:border-white/15 bg-brand-cream/40 dark:bg-slate-900/95 p-1.5 shadow-md ring-1 ring-black/5 dark:ring-white/10" aria-label="Reports tabs">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-1">
                    <a href="/reports?tab=tracker&amp;scope=<%= encodeURIComponent(_rs) %>" class="flex items-center justify-center px-3 py-3.5 rounded-xl text-[10px] sm:text-[11px] font-black uppercase tracking-widest text-center transition-all <%= rt === 'tracker' ? 'bg-brand-yellow text-brand-dark shadow-lg border border-brand-yellow' : 'text-brand-muted dark:text-slate-400 border border-transparent hover:bg-white/60 dark:hover:bg-white/5 hover:text-brand-dark dark:hover:text-white' %>">Daily tracker</a>
                    <a href="/reports?tab=analytics&amp;scope=<%= encodeURIComponent(_rs) %>" class="flex items-center justify-center px-3 py-3.5 rounded-xl text-[10px] sm:text-[11px] font-black uppercase tracking-widest text-center transition-all <%= rt === 'analytics' ? 'bg-brand-yellow text-brand-dark shadow-lg border border-brand-yellow' : 'text-brand-muted dark:text-slate-400 border border-transparent hover:bg-white/60 dark:hover:bg-white/5 hover:text-brand-dark dark:hover:text-white' %>">Traffic analytics</a>
                    <a href="/reports?tab=site-audit&amp;scope=<%= encodeURIComponent(_rs) %>" class="flex items-center justify-center px-3 py-3.5 rounded-xl text-[10px] sm:text-[11px] font-black uppercase tracking-widest text-center transition-all <%= rt === 'site-audit' ? 'bg-brand-yellow text-brand-dark shadow-lg border border-brand-yellow' : 'text-brand-muted dark:text-slate-400 border border-transparent hover:bg-white/60 dark:hover:bg-white/5 hover:text-brand-dark dark:hover:text-white' %>">Site audit report</a>
                    </div>
                </nav>
                <% if (rt === 'tracker') { %>
                <nav class="mb-8 w-full max-w-xl rounded-2xl border-2 border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 p-1.5 shadow-md" aria-label="Workspace scope">
                    <div class="grid grid-cols-2 gap-1">
                    <a href="/reports?tab=tracker&amp;scope=workspace" class="flex items-center justify-center px-4 py-3.5 rounded-xl text-[11px] font-black uppercase tracking-widest text-center transition-all <%= _rs !== 'all' ? 'bg-brand-dark text-white dark:bg-white dark:text-slate-900 shadow-md border border-brand-dark dark:border-white' : 'text-brand-muted dark:text-slate-400 border border-transparent hover:bg-brand-cream/50 dark:hover:bg-white/5' %>">This workspace</a>
                    <a href="/reports?tab=tracker&amp;scope=all" class="flex items-center justify-center px-4 py-3.5 rounded-xl text-[11px] font-black uppercase tracking-widest text-center transition-all <%= _rs === 'all' ? 'bg-brand-dark text-white dark:bg-white dark:text-slate-900 shadow-md border border-brand-dark dark:border-white' : 'text-brand-muted dark:text-slate-400 border border-transparent hover:bg-brand-cream/50 dark:hover:bg-white/5' %>">All workspaces</a>
                    </div>
                </nav>
                <% if (_rs === 'all' && typeof workspaceCompare !== 'undefined' && workspaceCompare.length) { %>
                <div class="mb-10 overflow-x-auto rounded-2xl border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/80">
                  <table class="w-full text-left text-sm min-w-[640px]">
                    <thead>
                      <tr class="border-b border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-muted">
                        <th class="px-4 py-3">Workspace</th>
                        <th class="px-4 py-3 text-right">Touches (7d)</th>
                        <th class="px-4 py-3 text-right">Reply rate</th>
                        <th class="px-4 py-3 text-right">Meetings</th>
                        <th class="px-4 py-3 text-right">Pipeline $</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% workspaceCompare.forEach(function (row) {
                        var s = row.snapshot || {};
                      %>
                      <tr class="border-b border-brand-border/50 dark:border-white/5">
                        <td class="px-4 py-3 font-bold text-brand-dark dark:text-white flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= row.accentColor %>"></span>
                          <%= row.name %>
                        </td>
                        <td class="px-4 py-3 text-right tabular-nums"><%= s.touches7d != null ? s.touches7d : 0 %></td>
                        <td class="px-4 py-3 text-right tabular-nums"><%= s.replyRate7dDisplay || '0%' %></td>
                        <td class="px-4 py-3 text-right tabular-nums"><%= s.meetingsBooked7d != null ? s.meetingsBooked7d : 0 %></td>
                        <td class="px-4 py-3 text-right tabular-nums"><%= s.pipelineValueCreated7d != null ? Math.round(s.pipelineValueCreated7d) : 0 %></td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
                <% } %>
                <% } %>

                <% const _am = typeof analyticsMetric !== 'undefined' ? analyticsMetric : ''; const _ar = typeof analyticsRange !== 'undefined' ? analyticsRange : ''; %>
                <% if (_am && rt === 'tracker') { %>
                <% const _labels = { touches_today: 'Touches today', reply_rate: 'Reply rate', meetings_booked: 'Meetings booked', pipeline_created: 'Pipeline value created', outreach_streak: 'Outreach streak', overdue_followups: 'Overdue follow-ups' }; %>
                <div id="analytics-metric-banner" class="mb-6 rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/10 px-4 py-3 text-sm text-brand-dark dark:text-slate-100">
                  <strong class="font-black uppercase tracking-widest text-[10px] text-brand-yellow">Context</strong>
                  — Showing <strong><%= _labels[_am] || _am.replace(/_/g, ' ') %></strong><% if (_ar) { %> · range <strong><%= _ar %></strong><% } %>. Use the daily tracker below to review and adjust.
                </div>
                <script>try { var el = document.getElementById('analytics-metric-banner'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {}</script>
                <% } %>

                <% if (rt === 'analytics') { %>
                <!-- KPI Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Total Visits</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= totalVisits %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">All Time</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Unique Visitors</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= uniqueIPs %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">IP Filtered</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Conversion</div>
                        <div class="text-3xl font-black text-brand-dark dark:text-white mb-0.5"><%= totalVisits > 0 ? ((leadCount / totalVisits) * 100).toFixed(1) : 0 %>%</div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">Visits to Leads</div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm group hover:border-brand-yellow transition-all duration-300">
                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Top Area</div>
                        <div class="text-xl font-black text-brand-dark dark:text-white mb-0.5 truncate"><%= topRegions[0] ? topRegions[0].name.split(',')[0] : '-' %></div>
                        <div class="text-[10px] font-bold text-brand-yellow/80">Hot Spot</div>
                    </div>
                </div>

                <!-- Main Chart -->
                <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm mb-8 overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-black text-brand-dark dark:text-white tracking-tight uppercase leading-none">Traffic Momentum</h3>
                            <p class="text-[9px] font-bold text-brand-muted uppercase tracking-[0.15em] mt-1">30-Day Rolling Window</p>
                        </div>
                    </div>
                    <div id="trafficChart" class="h-64 w-full"></div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
                    <!-- Top Regions -->
                    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-6 rounded-[2.5rem] border border-brand-border/40 dark:border-white/5 shadow-sm min-h-[360px]">
                        <h3 class="text-lg font-black text-brand-dark dark:text-white tracking-tight uppercase mb-6">Regional Distribution</h3>
                        <div class="space-y-4">
                            <% topRegions.forEach((region, i) => { %>
                                <div class="flex items-center justify-between group p-3 hover:bg-brand-cream/40 dark:hover:bg-white/5 rounded-2xl transition-all">
                                    <div class="flex items-center gap-4">
                                        <div class="w-8 h-8 rounded-lg bg-brand-yellow/10 flex items-center justify-center font-black text-brand-yellow text-xs border border-brand-yellow/20">
                                            <%= i + 1 %>
                                        </div>
                                        <div class="font-bold text-sm text-brand-dark dark:text-white"><%= region.name %></div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div class="w-24 bg-brand-border/10 h-1.5 rounded-full overflow-hidden hidden sm:block">
                                            <div class="bg-brand-yellow h-full" style="width: <%= (region.count / totalVisits) * 100 %>%"></div>
                                        </div>
                                        <div class="font-black text-sm text-brand-dark dark:text-white w-6 text-right"><%= region.count %></div>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (topRegions.length === 0) { %>
                                <div class="flex flex-col items-center justify-center py-16 opacity-30">
                                    <svg class="w-12 h-12 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <p class="text-sm font-bold uppercase tracking-widest italic">Awaiting Global Signals...</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-[#0B0F1A] p-6 rounded-[2.5rem] text-white shadow-xl relative overflow-hidden min-h-[360px]">
                        <div class="absolute -top-10 -right-10 pointer-events-none opacity-5">
                            <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
                        </div>
                        <h3 class="text-lg font-black text-white tracking-tight uppercase mb-6 relative z-10 flex items-center gap-2">
                           <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> Live Stream
                        </h3>
                        <div class="space-y-3 relative z-10 max-h-[320px] overflow-y-auto pr-1 customized-scrollbar">
                            <% recentVisits.forEach(visit => { %>
                                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5 hover:bg-white/10 transition-all flex items-center justify-between group">
                                    <div>
                                        <div class="font-black text-xs text-brand-yellow group-hover:text-white transition-colors"><%= visit.city %>, <%= visit.region %></div>
                                        <div class="text-[9px] text-white/40 font-bold uppercase tracking-widest mt-0.5"><%= visit.ip %> • <%= visit.path %></div>
                                    </div>
                                    <div class="text-[9px] font-black text-white/20 uppercase">
                                        <%= new Date(visit.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (recentVisits.length === 0) { %>
                                <div class="flex flex-col items-center justify-center py-16 opacity-20">
                                    <svg class="w-12 h-12 mb-3 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
                                    <p class="text-sm font-bold uppercase tracking-widest italic">Scanning Frequency...</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>

                <% if (rt === 'site-audit') { %>
                <% const _rav = typeof reportAuditViews !== 'undefined' && reportAuditViews ? reportAuditViews : []; %>
                <% const _leg = typeof reportAuditRubricLegend !== 'undefined' && reportAuditRubricLegend ? reportAuditRubricLegend : []; %>
                <section class="mb-10 scroll-mt-24" aria-labelledby="reports-site-audit-heading">
                  <div class="mb-6">
                    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Hosted report</p>
                    <h2 id="reports-site-audit-heading" class="text-xl md:text-2xl font-black text-brand-dark dark:text-white tracking-tight">Site audit opens (last 24 hours)</h2>
                    <p class="text-sm text-brand-muted dark:text-slate-400 mt-2 max-w-2xl">Each time someone loads a signed audit link we log a row. Pings every 15s while the tab stays visible build session duration. Matches the hosted report scoring rubric below.</p>
                  </div>
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white/80 dark:bg-slate-900/80 p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm">
                      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Opens (24h)</div>
                      <div class="text-3xl font-black text-brand-dark dark:text-white tabular-nums"><%= typeof reportAuditViews24h !== 'undefined' ? reportAuditViews24h : 0 %></div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm">
                      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Unique leads</div>
                      <div class="text-3xl font-black text-brand-dark dark:text-white tabular-nums"><%= typeof reportAuditUniqueLeads24h !== 'undefined' ? reportAuditUniqueLeads24h : 0 %></div>
                    </div>
                    <div class="bg-white/80 dark:bg-slate-900/80 p-6 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm md:col-span-2">
                      <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Avg. session time</div>
                      <div class="text-3xl font-black text-brand-dark dark:text-white tabular-nums"><%= typeof reportAuditAvgDuration24h !== 'undefined' ? reportAuditAvgDuration24h : 0 %>s</div>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
                    <div class="lg:col-span-2 overflow-x-auto rounded-2xl border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/80">
                      <table class="w-full text-left text-sm min-w-[640px]">
                        <thead>
                          <tr class="border-b border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-muted">
                            <th class="px-4 py-3">Lead</th>
                            <th class="px-4 py-3">Opened</th>
                            <th class="px-4 py-3 text-right">Duration</th>
                            <th class="px-4 py-3">IP hash</th>
                            <th class="px-4 py-3">User agent</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% _rav.forEach(function (row) { %>
                          <tr class="border-b border-brand-border/50 dark:border-white/5">
                            <td class="px-4 py-3 font-bold text-brand-dark dark:text-white"><%= row.leadTitle %></td>
                            <td class="px-4 py-3 text-xs text-brand-muted whitespace-nowrap"><%= row.viewed_at ? new Date(row.viewed_at).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '—' %></td>
                            <td class="px-4 py-3 text-right tabular-nums"><%= row.duration_seconds != null ? row.duration_seconds : 0 %>s</td>
                            <td class="px-4 py-3 font-mono text-[10px] text-brand-muted"><%= row.ip_hash || '—' %></td>
                            <td class="px-4 py-3 text-[10px] text-brand-muted max-w-[200px] truncate"><%= (row.user_agent || '').slice(0, 80) %></td>
                          </tr>
                          <% }); %>
                          <% if (!_rav.length) { %>
                          <tr><td colspan="5" class="px-4 py-10 text-center text-sm text-brand-muted">No opens in the last 24 hours yet. Copy a report link from a lead, open it once, and refresh this tab.</td></tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                    <div class="rounded-2xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-900/80 p-6">
                      <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-4">Rubric (max points)</h3>
                      <p class="text-xs text-brand-muted dark:text-slate-400 mb-4">Same category weights as the hosted audit PDF/HTML. Per-lead bars use saved AI analysis when present.</p>
                      <ul class="space-y-3">
                        <% _leg.forEach(function (cat) { %>
                        <li class="flex items-center justify-between text-sm font-bold text-brand-dark dark:text-white">
                          <span><%= cat.name %></span>
                          <span class="tabular-nums text-brand-yellow"><%= cat.max %></span>
                        </li>
                        <% }); %>
                      </ul>
                      <% if (_rav.length && _rav[0].categories && _rav[0].categories.length) { %>
                      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-6 mb-2">Latest open — <%= _rav[0].leadTitle %></p>
                      <ul class="space-y-2">
                        <% _rav[0].categories.forEach(function (c) { %>
                        <li>
                          <div class="flex justify-between text-[10px] font-bold text-brand-dark dark:text-white mb-0.5"><span><%= c.name %></span><span><%= c.score %> / <%= c.max %></span></div>
                          <div class="h-1.5 rounded-full bg-brand-border/30 overflow-hidden"><div class="h-full rounded-full" style="width: <%= c.pct %>%; background: <%= c.barColor %>"></div></div>
                        </li>
                        <% }); %>
                      </ul>
                      <% } %>
                    </div>
                  </div>
                </section>
                <% } %>

                <% if (rt === 'tracker') { %>
                <section class="mb-10 scroll-mt-24" aria-labelledby="reports-tracker-heading">
                    <div class="mb-6">
                        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Daily hustle</p>
                        <h2 id="reports-tracker-heading" class="text-xl md:text-2xl font-black text-brand-dark dark:text-white tracking-tight">Daily action tracker</h2>
                    </div>
                    <%- include('partials/sales_tracker_content', { hideSalesTrackerHeading: true }) %>
                </section>
                <% } %>
        </div>
    </main>
    
    <%- include('partials/footer') %>

    <% if (typeof reportsTab !== 'undefined' && reportsTab === 'analytics') { %>
    <!-- Chart Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chartData = <%- JSON.stringify(chartData) %>;
            
            const options = {
                series: [{
                    name: 'Visits',
                    data: chartData.values
                }],
                chart: {
                    type: 'area',
                    height: 320,
                    toolbar: { show: false },
                    zoom: { enabled: false },
                    fontFamily: 'Inter, sans-serif',
                    background: 'transparent'
                },
                dataLabels: { enabled: false },
                stroke: {
                    curve: 'smooth',
                    width: 4,
                    colors: ['#FFD644']
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.45,
                        opacityTo: 0.05,
                        stops: [20, 100, 100, 100],
                        colorStops: [
                            { offset: 0, color: '#FFD644', opacity: 0.4 },
                            { offset: 100, color: '#FFD644', opacity: 0 }
                        ]
                    }
                },
                markers: {
                    size: 5,
                    colors: ['#FFD644'],
                    strokeColors: '#fff',
                    strokeWidth: 3,
                    hover: { size: 7 }
                },
                xaxis: {
                    categories: chartData.labels,
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' },
                        formatter: function(val) {
                            if (!val) return '';
                            const d = new Date(val);
                            return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
                        }
                    },
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: {
                        style: { colors: '#64748b', fontWeight: 600, fontSize: '10px' }
                    }
                },
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4,
                    padding: { left: 20, right: 20 }
                },
                theme: { mode: document.documentElement.classList.contains('dark') ? 'dark' : 'light' }
            };

            const chart = new ApexCharts(document.querySelector("#trafficChart"), options);
            chart.render();
        });
    </script>
    <% } %>
</body>
</html>
