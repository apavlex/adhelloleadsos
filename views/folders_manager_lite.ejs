<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide w-full min-w-0 px-6 py-10 md:py-14">
    <section class="space-y-8" aria-label="Folder manager" id="folderManagerSection">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
            <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
            <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Outreach folders</span>
          </div>
          <h1 class="font-display font-black text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Folder manager</h1>
          <p class="text-sm text-brand-muted mt-2 max-w-xl">Folders with leads are listed first. Share a folder’s leads to another workspace, rename or move custom folders, or delete ones you no longer need — then open Pipeline.</p>
        </div>
        <a href="/prospecting?tab=pipeline" class="btn-pill btn-primary px-6 py-3.5 text-[10px] font-black uppercase tracking-widest shrink-0">Open pipeline</a>
      </div>

      <div class="relative max-w-xl">
        <label for="folderSearchFilter" class="sr-only">Search folders</label>
        <div class="flex items-center gap-3 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 focus-within:border-brand-yellow focus-within:ring-2 focus-within:ring-brand-yellow/25 transition-all">
          <svg class="shrink-0 w-4 h-4 text-brand-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
          <input type="search" id="folderSearchFilter" autocomplete="off" placeholder="Search folders…"
            class="folder-search-input flex-1 min-w-0 border-0 bg-transparent py-3 pr-1 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:outline-none focus:ring-0" />
        </div>
        <p id="folderSearchEmpty" class="hidden text-sm text-brand-muted mt-2">No folders match your search.</p>
      </div>

      <% const _folderShell = typeof folderShell !== 'undefined' && !!folderShell; %>
      <div id="folderTreeHost" data-folder-shell="<%= _folderShell ? '1' : '0' %>">
        <div id="folderTreeLoading" class="brand-card p-14 text-center dark:bg-slate-900 dark:border-white/10" role="status">
          <p class="text-brand-muted font-medium">Loading folders…</p>
          <p class="text-[11px] text-brand-muted mt-2">Pulling your folder list — hang tight.</p>
          <button type="button" id="folderTreeRetry" class="hidden mt-4 btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-[10px] font-black uppercase tracking-widest">Retry</button>
        </div>
        <div id="folderTreeEmpty" class="hidden brand-card p-14 text-center dark:bg-slate-900 dark:border-white/10">
          <p class="text-brand-muted">No folders yet. Create one from Pipeline or after your next search.</p>
        </div>
        <div class="hidden space-y-4" id="folderTreeRoot" data-folder-counts-pending="1"></div>
      </div>
    </section>
  </main>

  <div id="folderLiteRenameModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderLiteRenameTitle">
    <div id="folderLiteRenameBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderLiteRenameTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">Rename folder</h2>
      <p class="text-sm text-brand-muted mb-5">Update the folder name. Leads stay in place.</p>
      <input type="hidden" id="folderLiteRenameKey" value="" />
      <label for="folderLiteRenameName" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Folder name</label>
      <input id="folderLiteRenameName" type="text" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Folder name" />
      <p id="folderLiteRenameError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderLiteRenameSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Save name</button>
        <button id="folderLiteRenameCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <div id="folderLiteMoveModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderLiteMoveTitle">
    <div id="folderLiteMoveBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderLiteMoveTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">Move folder</h2>
      <p class="text-sm text-brand-muted mb-5">Nest this folder under a system category or another folder.</p>
      <input type="hidden" id="folderLiteMoveKey" value="" />
      <label for="folderLiteMoveParent" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Move to</label>
      <select id="folderLiteMoveParent" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white mb-3"></select>
      <p id="folderLiteMoveError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderLiteMoveSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Move folder</button>
        <button id="folderLiteMoveCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var host = document.getElementById('folderTreeHost');
    var loading = document.getElementById('folderTreeLoading');
    var empty = document.getElementById('folderTreeEmpty');
    var root = document.getElementById('folderTreeRoot');
    var retryBtn = document.getElementById('folderTreeRetry');
    var input = document.getElementById('folderSearchFilter');
    var searchEmpty = document.getElementById('folderSearchEmpty');
    var hydrateAttempts = 0;
    var hydrateMax = 8;
    var inboxFolders = [];
    var inboxGroups = [];
    var jsonHeaders = { Accept: 'application/json', 'Content-Type': 'application/json' };

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showRetry(msg) {
      if (!loading) return;
      loading.classList.remove('hidden');
      var p = loading.querySelector('p');
      if (p) p.textContent = msg || 'Could not load folders.';
      if (retryBtn) retryBtn.classList.remove('hidden');
    }

    function bindSearch() {
      if (!input || !root) return;
      input.addEventListener('input', function () {
        var q = String(input.value || '').trim().toLowerCase();
        var any = false;
        root.querySelectorAll('details.folder-group').forEach(function (group) {
          var gMatch = !q || (group.getAttribute('data-folder-group-search') || '').indexOf(q) !== -1;
          var rowHit = false;
          group.querySelectorAll('.folder-lite-row').forEach(function (row) {
            var show = !q || gMatch || (row.getAttribute('data-folder-search') || '').indexOf(q) !== -1;
            row.classList.toggle('hidden', !show);
            if (show) rowHit = true;
          });
          var showGroup = !q || gMatch || rowHit;
          group.classList.toggle('hidden', !showGroup);
          if (showGroup) any = true;
          if (q && showGroup) group.open = true;
        });
        if (searchEmpty) searchEmpty.classList.toggle('hidden', !q || any);
      });
    }

    function rowMetaAttrs(f) {
      return ' data-folder-key="' + esc(f.key) + '"' +
        ' data-folder-name="' + esc(f.name || 'Folder') + '"' +
        ' data-folder-parent="' + esc(f.parentFolderKey || '') + '"' +
        ' data-folder-is-default="' + (f.isPipelineDefault ? '1' : '0') + '"' +
        ' data-folder-is-trade="' + (f.isTradeFolder ? '1' : '0') + '"';
    }

    function actionButtonsHtml(f, isSystemRoot) {
      var openHref = '/prospecting?tab=pipeline&folderKey=' + encodeURIComponent(f.key);
      var name = f.name || 'Folder';
      var moreItems = '';
      moreItems += '<button type="button" class="folder-lite-share js-folder-share folder-lite-more-btn text-sky-700 dark:text-sky-300" data-folder-key="' + esc(f.key) + '" data-folder-name="' + esc(name) + '" title="Copy all leads in this folder into another workspace">Share</button>';
      if (!isSystemRoot && !f.isPipelineDefault) {
        moreItems += '<button type="button" class="folder-lite-rename folder-lite-more-btn text-brand-muted hover:text-brand-dark dark:hover:text-white" data-folder-key="' + esc(f.key) + '">Rename</button>';
        if (!f.isTradeFolder) {
          moreItems += '<button type="button" class="folder-lite-move folder-lite-more-btn text-brand-muted hover:text-brand-dark dark:hover:text-white" data-folder-key="' + esc(f.key) + '">Move</button>';
        }
        moreItems += '<button type="button" class="folder-lite-delete folder-lite-more-btn text-red-600/90 dark:text-red-400" data-folder-key="' + esc(f.key) + '" title="Delete this folder (leads stay, unassigned)">Delete</button>';
      }

      var html = '<div class="folder-lite-actions-wrap flex flex-col items-stretch sm:items-end gap-2 shrink-0 w-full sm:w-auto">';
      /* Mobile: Open + More pull-down — keeps long names from overlapping action links */
      html += '<div class="folder-lite-phonebar flex sm:hidden items-center gap-2 w-full">';
      html += '<a href="' + openHref + '" class="js-folder-row-cta flex-1 text-center px-3 py-2.5 rounded-xl bg-brand-yellow text-brand-dark border border-brand-yellow text-[11px] font-black uppercase tracking-widest shadow-sm">Open →</a>';
      html += '<button type="button" class="folder-lite-more-toggle inline-flex items-center justify-center gap-1 px-3 py-2.5 rounded-xl border border-brand-border dark:border-white/20 text-[11px] font-black uppercase tracking-widest text-brand-dark dark:text-white shrink-0" aria-expanded="false" aria-label="More actions for ' + esc(name) + '">More<svg class="folder-lite-more-chevron w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>';
      html += '</div>';
      html += '<div class="folder-lite-more flex flex-wrap items-center justify-start sm:justify-end gap-1">';
      html += moreItems;
      html += '<a href="' + openHref + '" class="js-folder-row-cta hidden sm:inline-flex px-2.5 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Open →</a>';
      html += '</div></div>';
      return html;
    }

    function folderRowShell(f, opts) {
      opts = opts || {};
      var openHref = '/prospecting?tab=pipeline&folderKey=' + encodeURIComponent(f.key);
      var depth = opts.depth || 0;
      var pad = depth <= 0 ? '' : (depth === 1 ? 'pl-8' : (depth === 2 ? 'pl-12' : 'pl-16'));
      var py = depth <= 0 ? 'py-4' : 'py-3.5';
      var titleClass = depth <= 0
        ? 'font-display font-bold text-brand-dark dark:text-white'
        : 'font-semibold text-brand-dark dark:text-white';
      var title = depth <= 0
        ? esc(f.name || 'Folder')
        : '<span class="text-brand-muted/50 mr-1" aria-hidden="true">↳</span>' + esc(f.name || 'Folder');
      var countPad = depth === 1 ? ' pl-4' : '';
      var html = '<li class="folder-lite-row list-none"' + rowMetaAttrs(f) + ' data-folder-search="' + esc((f.name + ' ' + (f.jobType || '') + ' ' + (f.tradeSlug || '')).toLowerCase()) + '">';
      html += '<div class="folder-lite-row-inner flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3 px-4 sm:px-6 ' + py + ' ' + pad + ' hover:bg-brand-cream/30 dark:hover:bg-white/5 transition-colors">';
      html += '<a href="' + openHref + '" class="folder-lite-name min-w-0 w-full sm:flex-1 sm:pr-2">';
      html += '<span class="' + titleClass + ' break-words">' + title + '</span>';
      html += '<span class="js-folder-row-count block text-[10px] font-black uppercase tracking-widest text-brand-muted mt-0.5' + countPad + '">…</span></a>';
      html += actionButtonsHtml(f, !!opts.isSystemRoot);
      html += '</div></li>';
      return html;
    }

    function renderGroups(groups) {
      if (!root) return;
      var html = '';
      (groups || []).forEach(function (group) {
        var gName = group.name || 'Folders';
        var gSearch = (gName + ' ' + (group.jobType || '')).toLowerCase();
        var childRows = group.childRows || [];
        var rootFolder = group.folder;
        html += '<details class="folder-group brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10" open data-folder-group-search="' + esc(gSearch) + '"' +
          (rootFolder && rootFolder.key ? (' data-folder-key="' + esc(rootFolder.key) + '"') : '') + '>';
        html += '<summary class="cursor-pointer list-none flex flex-wrap items-center justify-between gap-3 px-6 py-4 bg-brand-cream/30 dark:bg-slate-950/40 border-b border-brand-border/30 dark:border-white/10 [&::-webkit-details-marker]:hidden">';
        html += '<div class="min-w-0"><p class="font-display font-black text-lg text-brand-dark dark:text-white flex flex-wrap items-center gap-2">' + esc(gName);
        if (group.isSystem) html += '<span class="text-[9px] font-black uppercase tracking-widest text-brand-muted border border-brand-border/50 rounded-full px-2 py-0.5">System</span>';
        html += '<span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">' + childRows.length + ' subfolder' + (childRows.length === 1 ? '' : 's') + '</span></p>';
        html += '<p class="js-folder-group-count text-[10px] font-black uppercase tracking-widest text-brand-muted mt-1" data-folder-key="' + esc(rootFolder && rootFolder.key ? rootFolder.key : '') + '">Counting…</p></div>';
        html += '<span class="text-brand-muted text-xs font-bold" aria-hidden="true">▾</span></summary>';
        html += '<ul class="m-0 p-0 list-none divide-y divide-brand-border/20 dark:divide-white/5">';
        if (rootFolder && rootFolder.key) {
          html += folderRowShell(Object.assign({}, rootFolder, { isPipelineDefault: true }), { depth: 0, isSystemRoot: true });
        }
        childRows.forEach(function (row) {
          var f = row.folder || {};
          if (!f.key) return;
          html += folderRowShell(f, { depth: row.depth || 1, isSystemRoot: false });
        });
        html += '</ul></details>';
      });
      root.innerHTML = html;
      root.classList.remove('hidden');
      if (loading) loading.classList.add('hidden');
      if (empty) empty.classList.add('hidden');
      bindRowActions();
    }

    function applyFolderCounts(counts) {
      if (!root || !counts || typeof counts !== 'object') return;
      root.querySelectorAll('.js-folder-group-count').forEach(function (el) {
        var key = el.getAttribute('data-folder-key') || '';
        var n = key && counts[key] != null ? Number(counts[key]) || 0 : 0;
        if (!key) {
          var group = el.closest('details.folder-group');
          if (group) {
            n = 0;
            group.querySelectorAll('.folder-lite-row[data-folder-key]').forEach(function (row) {
              var rk = row.getAttribute('data-folder-key') || '';
              n += rk && counts[rk] != null ? Number(counts[rk]) || 0 : 0;
            });
          }
        }
        el.textContent = n + ' lead' + (n === 1 ? '' : 's') + ' total';
      });
      root.querySelectorAll('.folder-lite-row[data-folder-key]').forEach(function (row) {
        var key = row.getAttribute('data-folder-key') || '';
        var n = key && counts[key] != null ? Number(counts[key]) || 0 : 0;
        var countEl = row.querySelector('.js-folder-row-count');
        if (countEl) {
          countEl.textContent = n + ' lead' + (n === 1 ? '' : 's');
          countEl.classList.toggle('text-brand-dark', !!n);
          countEl.classList.toggle('dark:text-white', !!n);
          countEl.classList.toggle('text-brand-muted', !n);
        }
        var isRoot = !!row.querySelector('.font-display');
        var openLabel = n ? (isRoot ? 'Open leads →' : 'Open →') : (isRoot ? 'Open →' : 'Empty');
        row.querySelectorAll('.js-folder-row-cta').forEach(function (cta) {
          cta.textContent = openLabel;
        });
      });
      root.setAttribute('data-folder-counts-pending', '0');
    }

    function fetchCounts(attempt) {
      var n = attempt || 1;
      fetch('/prospecting/folder-counts.json', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, status: res.status, data: data }; }); })
        .then(function (parsed) {
          if (parsed.data && parsed.data.pending && n < 6) {
            setTimeout(function () { fetchCounts(n + 1); }, Math.min(900, 250 * n));
            return;
          }
          if (!parsed.ok || !parsed.data || !parsed.data.success) {
            if (parsed.status === 503 && n < 6) {
              setTimeout(function () { fetchCounts(n + 1); }, Math.min(900, 250 * n));
              return;
            }
            return;
          }
          applyFolderCounts(parsed.data.counts || {});
        })
        .catch(function () { /* keep Counting… */ });
    }

    function collectDescendantKeys(folderKey) {
      var blocked = {};
      var rootKey = String(folderKey || '').trim();
      if (!rootKey) return blocked;
      var byParent = {};
      (inboxFolders || []).forEach(function (f) {
        if (!f || !f.key) return;
        var parent = String(f.parentFolderKey || '').trim();
        if (!parent) return;
        if (!byParent[parent]) byParent[parent] = [];
        byParent[parent].push(String(f.key));
      });
      var queue = [rootKey];
      while (queue.length) {
        var k = queue.shift();
        (byParent[k] || []).forEach(function (child) {
          if (blocked[child]) return;
          blocked[child] = true;
          queue.push(child);
        });
      }
      return blocked;
    }

    function populateMoveSelect(movingKey, currentParentKey) {
      var select = document.getElementById('folderLiteMoveParent');
      if (!select) return;
      var blocked = collectDescendantKeys(movingKey);
      blocked[String(movingKey || '').trim()] = true;
      select.innerHTML = '';

      var topOpt = document.createElement('option');
      topOpt.value = '';
      topOpt.textContent = 'Other folders (top-level)';
      select.appendChild(topOpt);

      (inboxGroups || []).forEach(function (group) {
        var og = document.createElement('optgroup');
        og.label = String(group.name || 'Folders');
        if (group.isSystem && group.folder && group.folder.key && !blocked[group.folder.key]) {
          var rootOpt = document.createElement('option');
          rootOpt.value = group.folder.key;
          rootOpt.textContent = group.folder.name || group.name;
          og.appendChild(rootOpt);
        }
        (group.childRows || []).forEach(function (row) {
          var f = row.folder || {};
          if (!f.key || blocked[f.key]) return;
          var opt = document.createElement('option');
          opt.value = f.key;
          var depth = row.depth || 1;
          var prefix = depth > 1 ? '\u21b3 '.repeat(depth) : '\u21b3 ';
          opt.textContent = prefix + (f.name || 'Folder');
          og.appendChild(opt);
        });
        if (og.children.length) select.appendChild(og);
      });

      var desired = String(currentParentKey || '').trim();
      select.value = desired;
      if (select.value !== desired && desired) {
        var fallback = document.createElement('option');
        fallback.value = desired;
        fallback.textContent = 'Current parent';
        select.insertBefore(fallback, select.firstChild.nextSibling);
        select.value = desired;
      }
    }

    function openRenameModal(folderKey, folderName) {
      var modal = document.getElementById('folderLiteRenameModal');
      if (!modal) return;
      document.getElementById('folderLiteRenameKey').value = folderKey || '';
      document.getElementById('folderLiteRenameName').value = folderName || '';
      document.getElementById('folderLiteRenameTitle').textContent = 'Rename “' + (folderName || 'Folder') + '”';
      var err = document.getElementById('folderLiteRenameError');
      if (err) { err.classList.add('hidden'); err.textContent = ''; }
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      var inputEl = document.getElementById('folderLiteRenameName');
      if (inputEl) { inputEl.focus(); inputEl.select(); }
    }

    function closeRenameModal() {
      var modal = document.getElementById('folderLiteRenameModal');
      if (!modal) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    function openMoveModal(folderKey, folderName, parentKey) {
      var modal = document.getElementById('folderLiteMoveModal');
      if (!modal) return;
      document.getElementById('folderLiteMoveKey').value = folderKey || '';
      document.getElementById('folderLiteMoveTitle').textContent = 'Move “' + (folderName || 'Folder') + '”';
      populateMoveSelect(folderKey, parentKey);
      var err = document.getElementById('folderLiteMoveError');
      if (err) { err.classList.add('hidden'); err.textContent = ''; }
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      var select = document.getElementById('folderLiteMoveParent');
      if (select) select.focus();
    }

    function closeMoveModal() {
      var modal = document.getElementById('folderLiteMoveModal');
      if (!modal) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    function reloadInbox() {
      hydrateAttempts = 0;
      if (loading) {
        loading.classList.remove('hidden');
        var p = loading.querySelector('p');
        if (p) p.textContent = 'Updating folders…';
      }
      if (root) root.classList.add('hidden');
      runHydrate();
    }

    function closeAllLiteMore(exceptRow) {
      if (!root) return;
      root.querySelectorAll('.folder-lite-row.is-more-open').forEach(function (other) {
        if (exceptRow && other === exceptRow) return;
        other.classList.remove('is-more-open');
        var t = other.querySelector('.folder-lite-more-toggle');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
    }

    function bindRowActions() {
      if (!root) return;
      root.querySelectorAll('.folder-lite-more-toggle').forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var row = btn.closest('.folder-lite-row');
          if (!row) return;
          var open = !row.classList.contains('is-more-open');
          closeAllLiteMore(row);
          row.classList.toggle('is-more-open', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
      });
      root.querySelectorAll('.folder-lite-more-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          closeAllLiteMore();
        });
      });
      root.querySelectorAll('.folder-lite-rename').forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var row = btn.closest('.folder-lite-row');
          openRenameModal(
            btn.getAttribute('data-folder-key') || (row && row.getAttribute('data-folder-key')) || '',
            row && row.getAttribute('data-folder-name')
          );
        };
      });
      root.querySelectorAll('.folder-lite-move').forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var row = btn.closest('.folder-lite-row');
          openMoveModal(
            btn.getAttribute('data-folder-key') || (row && row.getAttribute('data-folder-key')) || '',
            row && row.getAttribute('data-folder-name'),
            row && row.getAttribute('data-folder-parent')
          );
        };
      });
      root.querySelectorAll('.folder-lite-delete').forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var row = btn.closest('.folder-lite-row');
          var key = btn.getAttribute('data-folder-key') || (row && row.getAttribute('data-folder-key')) || '';
          var name = (row && row.getAttribute('data-folder-name')) || 'this folder';
          if (!key || btn.disabled) return;
          if (!window.confirm('Delete “' + name + '”? Leads stay in the workspace but leave this folder.')) return;
          btn.disabled = true;
          var prev = btn.textContent;
          btn.textContent = 'Deleting…';
          fetch('/folders/delete', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not delete folder.');
              }
              reloadInbox();
            })
            .catch(function (err) {
              btn.disabled = false;
              btn.textContent = prev || 'Delete';
              window.alert((err && err.message) || 'Could not delete folder.');
            });
        };
      });
    }

    function bindModals() {
      var renameBd = document.getElementById('folderLiteRenameBackdrop');
      var renameCancel = document.getElementById('folderLiteRenameCancel');
      var renameSave = document.getElementById('folderLiteRenameSave');
      var renameInput = document.getElementById('folderLiteRenameName');
      if (renameBd) renameBd.addEventListener('click', closeRenameModal);
      if (renameCancel) renameCancel.addEventListener('click', closeRenameModal);
      if (renameInput) {
        renameInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            if (renameSave) renameSave.click();
          }
          if (e.key === 'Escape') closeRenameModal();
        });
      }
      if (renameSave) {
        renameSave.addEventListener('click', function () {
          var key = document.getElementById('folderLiteRenameKey').value;
          var name = String(document.getElementById('folderLiteRenameName').value || '').trim();
          var err = document.getElementById('folderLiteRenameError');
          if (!name) {
            if (err) { err.textContent = 'Folder name is required.'; err.classList.remove('hidden'); }
            return;
          }
          renameSave.disabled = true;
          fetch('/folders/rename', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key, name: name })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not rename folder.');
              }
              closeRenameModal();
              reloadInbox();
            })
            .catch(function (e) {
              if (err) { err.textContent = e.message || 'Could not rename folder.'; err.classList.remove('hidden'); }
            })
            .finally(function () { renameSave.disabled = false; });
        });
      }

      var moveBd = document.getElementById('folderLiteMoveBackdrop');
      var moveCancel = document.getElementById('folderLiteMoveCancel');
      var moveSave = document.getElementById('folderLiteMoveSave');
      if (moveBd) moveBd.addEventListener('click', closeMoveModal);
      if (moveCancel) moveCancel.addEventListener('click', closeMoveModal);
      if (moveSave) {
        moveSave.addEventListener('click', function () {
          var key = document.getElementById('folderLiteMoveKey').value;
          var parent = document.getElementById('folderLiteMoveParent').value;
          var err = document.getElementById('folderLiteMoveError');
          moveSave.disabled = true;
          fetch('/folders/move', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key, parentFolderKey: parent })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not move folder.');
              }
              closeMoveModal();
              reloadInbox();
            })
            .catch(function (e) {
              if (err) { err.textContent = e.message || 'Could not move folder.'; err.classList.remove('hidden'); }
            })
            .finally(function () { moveSave.disabled = false; });
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        closeRenameModal();
        closeMoveModal();
      });
    }

    function runHydrate() {
      hydrateAttempts += 1;
      if (loading && hydrateAttempts > 1) {
        var p = loading.querySelector('p');
        if (p) p.textContent = 'Still loading folders…';
      }
      var ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
      var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 5000);
      fetch('/prospecting/folders-inbox.json', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        signal: ctrl ? ctrl.signal : undefined
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, status: res.status, data: data }; }); })
        .then(function (parsed) {
          clearTimeout(timer);
          if (parsed.data && parsed.data.pending && hydrateAttempts < hydrateMax) {
            setTimeout(runHydrate, Math.min(900, 250 * hydrateAttempts));
            return;
          }
          if (!parsed.ok || !parsed.data || !parsed.data.success) {
            var busy = !!(parsed.data && parsed.data.pending) || parsed.status === 503;
            if (busy && hydrateAttempts < hydrateMax) {
              setTimeout(runHydrate, Math.min(900, 250 * hydrateAttempts));
              return;
            }
            throw new Error((parsed.data && parsed.data.error) || 'Could not load folders');
          }
          var groups = parsed.data.groups || [];
          inboxFolders = parsed.data.folders || [];
          inboxGroups = groups;
          if (!groups.length && !inboxFolders.length) {
            if (loading) loading.classList.add('hidden');
            if (empty) empty.classList.remove('hidden');
            if (root) root.classList.add('hidden');
            return;
          }
          renderGroups(groups);
          fetchCounts(1);
        })
        .catch(function (e) {
          clearTimeout(timer);
          if (hydrateAttempts < hydrateMax) {
            setTimeout(runHydrate, Math.min(900, 300 * hydrateAttempts));
            return;
          }
          showRetry((e && e.name === 'AbortError') ? 'Folders is taking too long.' : ((e && e.message) || 'Could not load folders'));
        });
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        hydrateAttempts = 0;
        if (retryBtn) retryBtn.classList.add('hidden');
        if (loading) {
          loading.classList.remove('hidden');
          var p = loading.querySelector('p');
          if (p) p.textContent = 'Loading folders…';
        }
        runHydrate();
      });
    }

    document.addEventListener('click', function (e) {
      if (!root) return;
      if (e.target && e.target.closest && e.target.closest('.folder-lite-row')) return;
      closeAllLiteMore();
    });

    bindSearch();
    bindModals();
    runHydrate();
  })();
  </script>
  <script src="/js/lead-workspace-share.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
  <%- include('partials/footer') %>
</body>
</html>
