<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden transition-colors duration-400">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Search Results</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          <% if (keyword) { %>
            <%= keyword %> <span class="text-brand-muted">in</span> <%= city %>
          <% } else { %>
            Lead Results
          <% } %>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          Found <%= results.length %> potential lead<%= results.length !== 1 ? 's' : '' %> for your business.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <div id="bulkActions" class="hidden items-center gap-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted"><span id="selectedCount" class="text-brand-dark mr-1 text-sm">0</span> selected</span>
          <button id="bulkEnrichBtn" class="btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all text-brand-dark">
            ✨ Enrich Leads
          </button>
          <button id="bulkExportBtn" class="btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 text-brand-dark dark:text-slate-100 hover:bg-brand-cream dark:hover:bg-slate-800 px-4 py-2 text-sm font-bold shadow-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Export CSV
          </button>
          <button id="bulkSaveBtn" class="btn-pill btn-primary px-4 py-2 text-sm font-bold shadow-sm">
            Save Leads
          </button>
        </div>
        <a href="/" id="newSearchBtn" class="btn-pill btn-primary flex">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          New Search
        </a>
      </div>
    </div>

    <% if (message) { %>
      <div class="mb-8 bg-brand-yellow/10 border border-brand-yellow/20 text-brand-dark px-6 py-4 rounded-2xl flex items-center gap-3">
        <svg class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium text-sm"><%= message %></span>
      </div>
    <% } %>

    <% if (results.length > 0) { %>
      <!-- Table Card (Full Width) -->
      <div class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="px-6 py-4 text-left w-12">
                  <input type="checkbox" id="selectAll" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow">
                </th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted min-w-[140px]">Phone</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Location</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Reviews</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Opportunity</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Website</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Email</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-center">Socials</th>
                <th class="px-6 py-4 text-right text-[10px] font-bold uppercase tracking-widest text-brand-muted">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% results.forEach((place, i) => { %>
                <tr class="result-row group"
                    data-index="<%= i %>"
                    data-title="<%= place.title %>"
                    data-phone="<%= place.phone || 'N/A' %>"
                    data-website="<%= place.website || 'N/A' %>"
                    data-email="<%= place.email || 'N/A' %>"
                    data-category="<%= place.categoryName || 'N/A' %>"
                    data-address="<%= place.address || 'N/A' %>"
                    data-city="<%= place.city || '' %>"
                    data-rating="<%= place.totalScore || 0 %>"
                    data-reviews="<%= place.reviewsCount || 0 %>"
                    data-url="<%= place.url || '' %>"
                    data-facebook="<%= place.facebook || 'N/A' %>"
                    data-instagram="<%= place.instagram || 'N/A' %>"
                    data-twitter="<%= place.twitter || 'N/A' %>">
                  <td class="px-6 py-5">
                    <input type="checkbox" class="row-checkbox rounded border-brand-border text-brand-yellow focus:ring-brand-yellow">
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-bold text-brand-dark group-hover:text-black transition-colors max-w-[150px] truncate" title="<%= place.title %>"><%= place.title %></div>
                    <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5 max-w-[150px] truncate"><%= place.categoryName %></div>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted whitespace-nowrap">
                    <%= place.phone && place.phone !== 'N/A' ? place.phone : '-' %>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted">
                    <div class="max-w-[150px] truncate" title="<%= place.address %>">
                      <%= place.address && place.address !== 'N/A' ? place.address : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <% if (place.totalScore) { %>
                      <div class="flex flex-col gap-1">
                        <div class="row-stars flex items-center gap-0.5"></div>
                        <div class="flex items-center gap-1.5">
                          <span class="text-[11px] font-black text-brand-dark dark:text-slate-200"><%= Number(place.totalScore).toFixed(1) %></span>
                          <span class="text-[9px] font-bold text-brand-muted/60">(<%= place.reviewsCount %>)</span>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 text-sm font-bold">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-5">
                    <div class="opportunity-badge flex items-center gap-2" data-score="0">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-300 animate-pulse"></span>
                      <span class="text-[10px] font-bold text-brand-muted uppercase tracking-wider">Calculating</span>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted">
                    <% if (place.website && place.website !== 'N/A') { %>
                      <a href="<%= place.website %>" target="_blank" class="website-link hover:text-brand-dark transition-colors border-b border-transparent hover:border-brand-dark pb-0.5 inline-block max-w-[150px] truncate" title="<%= place.website %>">
                        <%= place.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                      </a>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="px-6 py-5 text-sm">
                    <% if (place.email && place.email !== 'N/A') { %>
                      <a href="mailto:<%= place.email %>" class="font-bold text-brand-dark hover:text-brand-yellow transition-colors truncate max-w-[120px] inline-block" title="<%= place.email %>">
                          <%= place.email %>
                      </a>
                    <% } else { %>
                      <span class="text-[9px] bg-brand-cream/50 px-1.5 py-0.5 rounded border border-brand-border uppercase tracking-widest text-brand-muted/70 font-bold">No Email</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-5">
                    <div class="flex items-center justify-center gap-2.5">
                      <% if (place.facebook && place.facebook !== 'N/A') { %>
                        <a href="<%= place.facebook %>" target="_blank" class="w-4 h-4 text-brand-muted hover:text-[#1877F2] transition-colors" title="Facebook">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                        </a>
                      <% } %>
                      <% if (place.instagram && place.instagram !== 'N/A') { %>
                        <a href="<%= place.instagram %>" target="_blank" class="w-4 h-4 text-brand-muted hover:text-[#E4405F] transition-colors" title="Instagram">
                          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
                        </a>
                      <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-right">
                   <div class="flex items-center justify-end gap-2">
                       <% if (place.email && place.email !== 'N/A') { %>
                        <button class="quick-outreach-btn w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow hover:text-brand-dark transition-all" 
                          data-email="<%= place.email %>" data-company="<%= place.title %>" title="Quick Email Outreach">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </button>
                      <% } %>
                      <button class="bookmark-btn w-8 h-8 rounded-lg inline-flex items-center justify-center border border-brand-border hover:bg-brand-yellow hover:border-brand-yellow hover:text-brand-dark transition-all duration-300 text-brand-muted"
                              data-index="<%= i %>" title="Save lead">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No results found</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">We couldn't find any leads matching your search criteria. Try adjusting your keyword or city.</p>
        <a href="/" class="btn-pill btn-primary px-10">Try Another Search</a>
      </div>
    <% } %>
  </main>

  <!-- Premium Detail Sidebar / Mobile Panel -->
  <div id="mobilePanel" class="fixed inset-0 z-[100] bg-brand-dark/40 dark:bg-black/60 backdrop-blur-sm hidden flex flex-col justify-end lg:flex-row lg:justify-end items-center lg:items-stretch opacity-0 transition-opacity duration-300 pointer-events-none">
    <div class="bg-white dark:bg-slate-900 w-full lg:w-[480px] rounded-t-[3rem] lg:rounded-none p-8 animate-slide-up lg:animate-slide-in-right pointer-events-auto max-h-[90vh] lg:max-h-screen overflow-y-auto shadow-2xl sidebar-shadow border-l dark:border-white/10">
      
      <!-- Top Actions & Close -->
      <div class="flex items-center justify-between mb-8 sticky top-0 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md py-2 z-10">
        <div class="flex items-center gap-3">
            <button id="prevLeadBtn" class="w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all group">
                <svg class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div id="mobilePanelAvatar" class="w-14 h-14 bg-brand-yellow rounded-2xl flex items-center justify-center font-display font-black text-2xl shadow-brutal text-brand-dark">A</div>
            <button id="nextLeadBtn" class="w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all group">
                <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>
        <button id="closeMobilePanel" class="w-10 h-10 rounded-full bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all transform hover:rotate-90">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <!-- Profile Section -->
      <div class="mb-10">
        <h2 id="mobilePanelTitle" class="font-display font-black text-3xl lg:text-4xl text-brand-dark dark:text-white mb-3 leading-[1.1]">Company Name</h2>
        <div class="flex flex-wrap items-center gap-3">
            <span id="mobilePanelCategory" class="px-3 py-1 rounded-full bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 text-[10px] font-bold uppercase tracking-widest">Category</span>
            <div id="mobilePanelStars" class="flex items-center gap-0.5">
                <!-- Stars injected via JS -->
            </div>
            <span id="mobilePanelRatingText" class="text-xs font-bold text-brand-muted">5.0 Rating</span>
        </div>
      </div>

      <!-- High-Productivity Action Grid -->
      <section class="mb-10">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-6 px-1 text-center">Engagement Command Center</h3>
        
        <div class="grid grid-cols-2 gap-4">
            <!-- Phone Action Tile -->
            <div id="mobilePanelPhoneRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <a href="#" id="mobilePanelPhoneLink" class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </a>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Call Lead</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelPhone">Phone</div>
            </div>

            <!-- Email Action Tile -->
            <div id="mobilePanelEmailRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <button class="quick-outreach-btn w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform" id="mobilePanelEmailBtn">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </button>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Send Email</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelEmail">No Email</div>
            </div>

            <!-- Website Action Tile -->
            <div id="mobilePanelWebsiteRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <a href="#" id="mobilePanelWebsiteLink" target="_blank" class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                </a>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Visit Site</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelWebsiteShort">Website</div>
            </div>

            <!-- Location Action Tile -->
            <div id="mobilePanelAddressRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <a href="#" id="mobilePanelMapsLink" target="_blank" class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </a>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Map View</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelAddress">Address</div>
            </div>
        </div>

        <!-- Social Connections Grid -->
        <div class="mt-6 p-6 bg-brand-dark text-white dark:bg-slate-800 rounded-[2.5rem] shadow-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-10">
                <svg class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/></svg>
            </div>
            <div class="text-[10px] font-black uppercase tracking-widest text-white/40 mb-5 relative z-10">Social Ecosystem</div>
            <div class="flex items-center gap-4 relative z-10">
                <a id="mobilePanelFacebook" href="#" target="_blank" class="hidden w-11 h-11 bg-white/10 hover:bg-[#1877F2] rounded-2xl flex items-center justify-center transition-all hover:scale-110">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                </a>
                <a id="mobilePanelInstagram" href="#" target="_blank" class="hidden w-11 h-11 bg-white/10 hover:bg-[#E4405F] rounded-2xl flex items-center justify-center transition-all hover:scale-110">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
                </a>
                <a id="mobilePanelTwitter" href="#" target="_blank" class="hidden w-11 h-11 bg-white/10 hover:bg-black rounded-2xl flex items-center justify-center transition-all hover:scale-110 border border-white/5">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z" /></svg>
                </a>
                <div id="noSocialsMsg" class="text-xs font-medium text-white/30 italic hidden">No social profiles detected.</div>
            </div>
        </div>
      </section>

      <!-- Description Area -->
      <div class="mb-10">
        <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted mb-4">About the business</h3>
        <p id="mobilePanelDesc" class="text-sm font-medium text-brand-dark leading-relaxed">
          High-quality business services provided with a focus on local excellence and customer satisfaction. Specializing in specialized industry solutions...
          <button class="text-brand-muted font-bold hover:text-brand-dark underline underline-offset-4 ml-1">See more</button>
        </p>
      </div>

      <!-- Functional Area / Badges -->
      <div class="mb-12">
        <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted mb-4">Functional area</h3>
        <div id="badgeContainer" class="flex flex-wrap gap-2">
          <!-- Will be populated dynamicly -->
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Marketing & PR</span>
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Service Industry</span>
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Local Search</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-4 mt-auto">
        <a id="mobilePanelWebsiteBtn" href="#" target="_blank" class="flex-1 bg-brand-cream text-brand-dark font-bold py-5 rounded-2xl border border-brand-border flex items-center justify-center gap-2 hover:bg-white transition-all">
          <span>Export PDF</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <button id="mobilePanelSaveBtn" class="flex-1 bg-brand-dark text-white font-bold py-5 rounded-2xl flex items-center justify-center gap-2 hover:bg-black transition-all group">
          <span>Email</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Website Preview Tooltip -->
  <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white border border-brand-border rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
    <div class="bg-gray-100 px-3 py-2 border-b border-gray-200 flex items-center gap-2">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
      </div>
      <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
      <a id="previewNewTabBtn" href="#" target="_blank" class="text-[10px] text-brand-dark hover:text-brand-yellow flex items-center gap-1 font-bold tracking-wider transition-colors">
         OPEN <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
    <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
      <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
         <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
      </div>
      <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
</body>
</html>
