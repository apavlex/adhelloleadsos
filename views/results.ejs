<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Search Results</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          <% if (keyword) { %>
            <%= keyword %> <span class="text-brand-muted">in</span> <%= city %>
          <% } else { %>
            Agency OS Results
          <% } %>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          Found <%= results.length %> potential lead<%= results.length !== 1 ? 's' : '' %> for your business.
        </p>
        <% if (targetFolderKey) { %>
          <p class="text-[11px] font-bold uppercase tracking-wider text-brand-yellow mt-2">
            Saving into folder: <span class="text-brand-dark dark:text-slate-100"><%= targetFolderName || 'Selected folder' %></span>
          </p>
        <% } %>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <!-- Bulk Actions (Dynamic) -->
        <div id="headerBulkActions" class="hidden items-center gap-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted"><span id="headerSelectedCount" class="text-brand-dark mr-1 text-sm font-black">0</span> selected</span>
          <button type="button" id="headerBulkEnhanceBtn" class="js-bulk-enhance btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all" title="Enrich selected leads (Firecrawl)">✨ Enrich</button>
          <button id="headerBulkExportBtn" class="btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 text-brand-dark dark:text-slate-100 hover:bg-brand-cream dark:hover:bg-slate-800 px-4 py-2 text-sm font-bold shadow-sm flex items-center gap-2">Export CSV</button>
          <button id="headerBulkSaveBtn" class="btn-pill btn-primary px-4 py-2 text-sm font-bold shadow-sm">Save Leads</button>
        </div>
        <a href="/leads/find" id="newSearchBtn" class="btn-pill btn-primary flex">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          New Search
        </a>
      </div>
    </div>

    <% if (message) { %>
      <div class="mb-8 bg-brand-yellow/10 border border-brand-yellow/20 text-brand-dark px-6 py-4 rounded-2xl flex items-center gap-3">
        <svg class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium text-sm"><%= message %></span>
      </div>
    <% } %>

    <% if (results.length > 0) { %>
      <!-- Table Card (Full Width) -->
      <div class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="px-6 py-4 text-left w-12">
                  <input type="checkbox" id="selectAllLeads" class="w-4 h-4 rounded border-brand-border text-brand-yellow focus:ring-brand-yellow cursor-pointer" title="Select all leads in this list" aria-label="Select all leads in this list">
                </th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted min-w-[180px]">Contact</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Location</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Reviews</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted cursor-pointer hover:text-brand-dark transition-colors group flex items-center gap-1" id="sortOpportunity">
                    Opportunity
                    <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-center">Socials</th>
                <th class="px-6 py-4 text-right text-[10px] font-bold uppercase tracking-widest text-brand-muted">Actions</th>
              </tr>
            </thead>
            <tbody id="resultsLeadsTbody" class="divide-y divide-brand-border/50">
              <% results.forEach((place, i) => { %>
                <tr class="result-row"
                    data-index="<%= i %>"
                    data-title="<%= place.title %>"
                    data-phone="<%= place.phone || 'N/A' %>"
                    data-website="<%= place.website || 'N/A' %>"
                    data-email="<%= place.email || 'N/A' %>"
                    data-category="<%= place.categoryName || 'N/A' %>"
                    data-address="<%= place.address || 'N/A' %>"
                    data-city="<%= place.city || '' %>"
                    data-rating="<%= place.totalScore || 0 %>"
                    data-reviews="<%= place.reviewsCount || 0 %>"
                    data-url="<%= place.url || '' %>"
                    data-facebook="<%= place.facebook || 'N/A' %>"
                    data-instagram="<%= place.instagram || 'N/A' %>"
                    data-twitter="<%= place.twitter || 'N/A' %>"
                    data-has-schema-markup="false"
                    data-has-chatbot="false"
                    data-has-click-to-call="false"
                    data-is-mobile-friendly="true"
                    data-is-outdated="false"
                    data-visual-modernity-score="10"
                    data-aeo-score="3"
                    data-geo-gaps=""
                    data-audit-summary="">
                  <td class="px-6 py-5">
                    <input type="checkbox" class="lead-checkbox rounded border-brand-border text-brand-yellow focus:ring-brand-yellow cursor-pointer" data-key="<%= i %>">
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-bold text-brand-dark group-hover:text-black transition-colors max-w-[150px] truncate" title="<%= place.title %>"><%= place.title %></div>
                    <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5 max-w-[150px] truncate"><%= place.categoryName %></div>
                  </td>
                  <td class="lead-cell-contact px-6 py-5 text-sm text-brand-muted min-w-[180px]">
                    <div class="flex flex-col gap-2 min-w-0">
                      <div class="flex items-start gap-2 min-w-0">
                        <svg class="w-3.5 h-3.5 shrink-0 mt-0.5 text-brand-muted dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                        <% if (place.phone && place.phone !== 'N/A') { %>
                          <a href="#" class="lead-contact-phone-slot js-click-to-call-number text-xs font-semibold text-brand-dark dark:text-slate-200 truncate hover:text-brand-yellow transition-colors" data-phone="<%= place.phone %>" onclick="event.stopPropagation()"><%= place.phone %></a>
                        <% } else { %>
                          <span class="lead-contact-phone-slot text-xs font-semibold text-brand-muted/60 dark:text-slate-500">—</span>
                        <% } %>
                      </div>
                      <div class="flex items-start gap-2 min-w-0">
                        <svg class="w-3.5 h-3.5 shrink-0 mt-0.5 text-brand-muted dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        <span class="lead-contact-email-slot min-w-0 flex-1">
                          <% if (place.email && place.email !== 'N/A') { %>
                            <a href="mailto:<%= place.email %>" class="font-bold text-brand-dark hover:text-brand-yellow transition-colors truncate block" title="<%= place.email %>"><%= place.email %></a>
                          <% } else { %>
                            <span class="text-xs font-semibold text-brand-muted/60 dark:text-slate-500">—</span>
                          <% } %>
                        </span>
                      </div>
                      <div class="flex items-start gap-2 min-w-0">
                        <svg class="w-3.5 h-3.5 shrink-0 mt-0.5 text-brand-muted dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                        <span class="lead-contact-web-slot min-w-0 flex-1">
                          <% if (place.website && place.website !== 'N/A') { %>
                            <a href="<%= place.website %>" target="_blank" class="website-link hover:text-brand-dark transition-colors border-b border-transparent hover:border-brand-dark pb-0.5 inline-block max-w-[150px] truncate" title="<%= place.website %>">
                              <%= place.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                            </a>
                          <% } else { %>
                            <span class="text-xs font-semibold text-brand-muted/60 dark:text-slate-500">—</span>
                          <% } %>
                        </span>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted">
                    <div class="max-w-[150px] truncate" title="<%= place.address %>">
                      <%= place.address && place.address !== 'N/A' ? place.address : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <% if (place.totalScore) { %>
                      <div class="flex flex-col items-start gap-1 min-w-[4.5rem]">
                        <div class="row-stars flex items-center gap-0.5"></div>
                        <div class="flex flex-col gap-0.5">
                          <span class="text-xs font-black tabular-nums text-brand-dark dark:text-slate-100 leading-none"><%= Number(place.totalScore).toFixed(1) %></span>
                          <span class="text-[10px] font-bold text-brand-muted dark:text-slate-400 leading-snug"><%= place.reviewsCount || 0 %> reviews</span>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 text-sm font-bold">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-5 opportunity-cell">
                    <div class="opportunity-badge flex flex-wrap gap-1 items-center justify-center min-h-[32px]" data-score="0">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow animate-pulse"></span>
                        <span class="text-[9px] font-black text-brand-muted uppercase tracking-widest leading-none">Vetting...</span>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <div class="flex items-center justify-center gap-2.5">
                      <% if (place.facebook && place.facebook !== 'N/A') { %>
                        <a href="<%= place.facebook %>" target="_blank" class="w-4 h-4 text-brand-muted hover:text-[#1877F2] transition-colors" title="Facebook">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                        </a>
                      <% } %>
                      <% if (place.instagram && place.instagram !== 'N/A') { %>
                        <a href="<%= place.instagram %>" target="_blank" class="w-4 h-4 text-brand-muted hover:text-[#E4405F] transition-colors" title="Instagram">
                          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
                        </a>
                      <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-right">
                   <div class="flex items-center justify-end gap-2">
                       <% if (place.email && place.email !== 'N/A') { %>
                        <button class="quick-outreach-btn w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow hover:text-brand-dark transition-all" 
                          data-email="<%= place.email %>" data-company="<%= place.title %>" title="Quick Email Outreach">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </button>
                      <% } %>
                      <button class="bookmark-btn w-8 h-8 rounded-lg inline-flex items-center justify-center border border-brand-border hover:bg-brand-yellow hover:border-brand-yellow hover:text-brand-dark transition-all duration-300 text-brand-muted"
                              data-index="<%= i %>" title="Save lead">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No results found</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">We couldn't find any leads matching your search criteria. Try adjusting your keyword or city.</p>
        <a href="/leads/find" class="btn-pill btn-primary px-10">Try Another Search</a>
      </div>
    <% } %>
    <%- include('partials/lead_detail_panel') %>
    
    <!-- Floating Bulk Actions Bar -->
    <div id="bulkActionBar" class="fixed bottom-6 left-1/2 -translate-x-1/2 text-white px-6 py-4 sm:px-8 sm:py-5 rounded-[2.5rem] z-[190] flex flex-col gap-3 max-w-[calc(100vw-2rem)] opacity-0 translate-y-24 pointer-events-none transition-all duration-300 ease-out border border-white/10" role="toolbar" aria-label="Bulk lead actions">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
        <div class="flex items-center gap-4 sm:border-r sm:border-white/10 sm:pr-8">
          <div id="selectedCountCircle" class="w-10 h-10 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-sm shadow-lg">0</div>
          <div class="text-sm font-bold text-white/90">Leads Selected</div>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="button" class="js-bulk-enhance flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-yellow transition-all group overflow-hidden relative">
             <svg class="w-4 h-4 text-brand-yellow group-hover:animate-sparkle" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
             <span class="text-xs font-black uppercase tracking-widest">Enhance</span>
          </button>
          <button type="button" class="js-bulk-export-csv flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-400 transition-all group">
             <svg class="w-4 h-4 text-blue-400 group-hover:translate-y-[-2px] transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
             <span class="text-xs font-black uppercase tracking-widest">Export CSV</span>
          </button>
          <button id="bulkSaveBtn" class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-brand-yellow text-brand-dark text-[10px] font-black uppercase tracking-widest hover:brightness-105 active:scale-[0.98] transition-all">
             <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" /></svg>
             <span>Save Leads</span>
          </button>
          <div class="hidden sm:block w-px h-6 bg-white/10"></div>
          <button id="cancelSelectionBtn" class="text-xs font-bold text-white/50 hover:text-white transition-colors uppercase tracking-widest">Cancel</button>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    // Inject saved leads from server to app.js context
    window.INITIAL_SAVED_LEADS = <%- JSON.stringify(savedLeads || []) %>;
    window.SEARCH_TARGET_FOLDER_KEY = <%- JSON.stringify(targetFolderKey || '') %>;
  </script>

  <script src="/js/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
