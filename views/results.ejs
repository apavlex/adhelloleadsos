<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/navbar') %>

  <div class="ml-56 min-h-screen flex flex-col">

    <!-- Top bar with search summary -->
    <div class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-lg font-semibold text-gray-800">
          <% if (keyword) { %>
            <%= keyword %> in <%= city %>, <%= state %>
          <% } else { %>
            Search Results
          <% } %>
        </h1>
        <p class="text-sm text-gray-500">
          <%= results.length %> lead<%= results.length !== 1 ? 's' : '' %> found
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/"
          class="px-4 py-2 bg-sidebar text-white rounded-lg text-sm font-medium hover:bg-sidebar-active transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          New Search
        </a>
      </div>
    </div>

    <% if (message) { %>
      <div class="mx-8 mt-4 bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-lg text-sm">
        <%= message %>
      </div>
    <% } %>

    <% if (results.length > 0) { %>
      <!-- Main content: table + detail panel -->
      <div class="flex-1 flex overflow-hidden">

        <!-- Table area -->
        <div class="flex-1 overflow-auto" id="tableArea">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200 sticky top-0">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-8">
                  <input type="checkbox" id="selectAll" class="rounded border-gray-300 text-accent focus:ring-accent">
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Company</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Phone</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Website</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location</th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider w-16">Save</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
              <% results.forEach((place, i) => { %>
                <tr class="result-row"
                    data-index="<%= i %>"
                    data-lead-key=""
                    data-title="<%= place.title %>"
                    data-phone="<%= place.phone || 'N/A' %>"
                    data-website="<%= place.website || 'N/A' %>"
                    data-email="<%= place.email || 'N/A' %>"
                    data-category="<%= place.categoryName || 'N/A' %>"
                    data-address="<%= place.address || 'N/A' %>"
                    data-city="<%= place.city || '' %>"
                    data-rating="<%= place.totalScore || 0 %>"
                    data-reviews="<%= place.reviewsCount || 0 %>"
                    data-url="<%= place.url || '' %>">
                  <td class="px-6 py-3.5">
                    <input type="checkbox" class="row-checkbox rounded border-gray-300 text-accent focus:ring-accent">
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="text-sm font-medium text-gray-900"><%= place.title %></span>
                  </td>
                  <td class="px-4 py-3.5 text-sm text-gray-600">
                    <%= place.phone && place.phone !== 'N/A' ? place.phone : '' %>
                  </td>
                  <td class="px-4 py-3.5 text-sm text-gray-600 max-w-[200px] truncate">
                    <% if (place.website && place.website !== 'N/A') { %>
                      <%= place.website.replace(/^https?:\/\//, '').replace(/\/$/, '') %>
                    <% } %>
                  </td>
                  <td class="px-4 py-3.5 text-sm text-gray-600">
                    <% if (place.address && place.address !== 'N/A') { %>
                      <%= place.address %>
                    <% } else if (place.city) { %>
                      <%= place.city %>
                    <% } %>
                  </td>
                  <td class="px-4 py-3.5 text-center">
                    <button class="bookmark-btn text-gray-300 hover:text-accent transition-colors"
                            data-index="<%= i %>" title="Save lead">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                      </svg>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Detail panel (hidden by default, slides in on row click) -->
        <div id="detailPanel" class="detail-panel w-80 bg-white border-l border-gray-200 overflow-y-auto flex-shrink-0">
          <div class="p-6">
            <!-- Close button -->
            <button id="closePanel" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>

            <!-- Company avatar -->
            <div class="flex items-center gap-3 mb-4">
              <div id="panelAvatar" class="w-12 h-12 rounded-full bg-accent-light flex items-center justify-center text-accent font-bold text-lg">
                A
              </div>
              <div>
                <h2 id="panelTitle" class="text-lg font-semibold text-gray-900">Company Name</h2>
                <p id="panelCategory" class="text-sm text-gray-500">Category</p>
              </div>
            </div>

            <!-- Info card -->
            <div class="bg-gray-50 rounded-lg p-4 space-y-3 mb-5 border border-gray-100">
              <div class="flex items-start gap-3" id="panelRatingRow">
                <svg class="w-4 h-4 text-yellow-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
                <span id="panelRating" class="text-sm text-gray-700"></span>
              </div>
              <div class="flex items-start gap-3" id="panelPhoneRow">
                <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <a id="panelPhone" href="#" class="text-sm text-gray-700 hover:text-accent"></a>
              </div>
              <div class="flex items-start gap-3" id="panelEmailRow">
                <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <span id="panelEmail" class="text-sm text-gray-700"></span>
              </div>
              <div class="flex items-start gap-3" id="panelAddressRow">
                <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <span id="panelAddress" class="text-sm text-gray-700"></span>
              </div>
            </div>

            <!-- Save lead button -->
            <button id="panelSaveBtn"
              class="w-full mb-3 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium hover:bg-accent-dark transition-colors flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
              </svg>
              <span>Save Lead</span>
            </button>

            <!-- Action buttons -->
            <div class="flex gap-2">
              <a id="panelWebsiteBtn" href="#" target="_blank" rel="noopener"
                class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors text-center">
                Visit Website
              </a>
              <a id="panelMapsBtn" href="#" target="_blank" rel="noopener"
                class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors text-center">
                Google Maps
              </a>
            </div>

          </div>
        </div>

      </div>
    <% } else if (!message) { %>
      <div class="flex-1 flex items-center justify-center">
        <div class="text-center text-gray-500">
          <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <p class="text-sm">No results found. Try a different keyword or location.</p>
          <a href="/" class="text-accent hover:underline text-sm mt-2 inline-block">Back to search</a>
        </div>
      </div>
    <% } %>

  </div>

  <script src="/js/app.js"></script>
</body>
</html>
