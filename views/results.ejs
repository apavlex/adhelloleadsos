<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-cream min-h-screen text-brand-dark">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white px-3 py-1 rounded-full border border-brand-border shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted">Search Results</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          <% if (keyword) { %>
            <%= keyword %> <span class="text-brand-muted">in</span> <%= city %>
          <% } else { %>
            Lead Results
          <% } %>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          Found <%= results.length %> potential lead<%= results.length !== 1 ? 's' : '' %> for your business.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <div id="bulkActions" class="hidden items-center gap-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted"><span id="selectedCount" class="text-brand-dark mr-1 text-sm">0</span> selected</span>
          <button id="bulkEnrichBtn" class="btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all text-brand-dark">
            ✨ Enrich Leads
          </button>
          <button id="bulkExportBtn" class="btn-pill bg-white border border-brand-border text-brand-dark hover:bg-brand-cream px-4 py-2 text-sm font-bold shadow-sm">
            Export CSV
          </button>
          <button id="bulkSaveBtn" class="btn-pill btn-primary px-4 py-2 text-sm font-bold shadow-sm">
            Save Leads
          </button>
        </div>
        <a href="/" id="newSearchBtn" class="btn-pill btn-primary flex">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          New Search
        </a>
      </div>
    </div>

    <% if (message) { %>
      <div class="mb-8 bg-brand-yellow/10 border border-brand-yellow/20 text-brand-dark px-6 py-4 rounded-2xl flex items-center gap-3">
        <svg class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium text-sm"><%= message %></span>
      </div>
    <% } %>

    <% if (results.length > 0) { %>
      <!-- Table Card (Full Width) -->
      <div class="brand-card overflow-hidden w-full">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 border-b border-brand-border">
                <th class="px-6 py-4 text-left w-12">
                  <input type="checkbox" id="selectAll" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow">
                </th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted min-w-[140px]">Phone</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Location</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Reviews</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Website</th>
                <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Socials</th>
                <th class="px-6 py-4 text-right text-[10px] font-bold uppercase tracking-widest text-brand-muted">Save Lead</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% results.forEach((place, i) => { %>
                <tr class="result-row group"
                    data-index="<%= i %>"
                    data-title="<%= place.title %>"
                    data-phone="<%= place.phone || 'N/A' %>"
                    data-website="<%= place.website || 'N/A' %>"
                    data-email="<%= place.email || 'N/A' %>"
                    data-category="<%= place.categoryName || 'N/A' %>"
                    data-address="<%= place.address || 'N/A' %>"
                    data-city="<%= place.city || '' %>"
                    data-rating="<%= place.totalScore || 0 %>"
                    data-reviews="<%= place.reviewsCount || 0 %>"
                    data-url="<%= place.url || '' %>"
                    data-facebook="<%= place.facebook || 'N/A' %>"
                    data-instagram="<%= place.instagram || 'N/A' %>"
                    data-twitter="<%= place.twitter || 'N/A' %>">
                  <td class="px-6 py-5">
                    <input type="checkbox" class="row-checkbox rounded border-brand-border text-brand-yellow focus:ring-brand-yellow">
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-bold text-brand-dark group-hover:text-black transition-colors"><%= place.title %></div>
                    <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5"><%= place.categoryName %></div>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted whitespace-nowrap">
                    <%= place.phone && place.phone !== 'N/A' ? place.phone : '-' %>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted">
                    <div class="max-w-[200px] truncate" title="<%= place.address %>">
                      <%= place.address && place.address !== 'N/A' ? place.address : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <% if (place.totalScore) { %>
                      <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="text-sm font-bold text-brand-dark"><%= Number(place.totalScore).toFixed(1) %></span>
                        <span class="text-[10px] font-bold text-brand-muted">(<%= place.reviewsCount %>)</span>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 text-sm">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-brand-muted">
                    <% if (place.website && place.website !== 'N/A') { %>
                      <a href="<%= place.website %>" target="_blank" class="website-link hover:text-brand-dark transition-colors border-b border-transparent hover:border-brand-dark pb-0.5 inline-block" data-url="<%= place.website %>">
                        <%= place.website.replace(/^https?:\/\//, '').replace(/\/$/, '') %>
                      </a>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="px-6 py-5">
                    <div class="flex items-center gap-3">
                      <% if (place.facebook && place.facebook !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Facebook">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                        </div>
                      <% } %>
                      <% if (place.instagram && place.instagram !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Instagram">
                          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
                        </div>
                      <% } %>
                      <% if (place.twitter && place.twitter !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Twitter / X">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z" /></svg>
                        </div>
                      <% } else if (!place.facebook && !place.instagram) { %>
                        <span class="text-brand-muted/40 text-sm">-</span>
                      <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-right">
                    <button class="bookmark-btn w-10 h-10 rounded-full inline-flex items-center justify-center border border-brand-border hover:bg-brand-yellow hover:border-brand-yellow hover:text-brand-dark transition-all duration-300 text-brand-muted ml-auto"
                            data-index="<%= i %>" title="Save lead">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                      </svg>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No results found</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">We couldn't find any leads matching your search criteria. Try adjusting your keyword or city.</p>
        <a href="/" class="btn-pill btn-primary px-10">Try Another Search</a>
      </div>
    <% } %>
  </main>

  <!-- Premium Detail Sidebar / Mobile Panel -->
  <div id="mobilePanel" class="fixed inset-0 z-[100] bg-brand-dark/40 backdrop-blur-sm hidden flex flex-col justify-end lg:flex-row lg:justify-end items-center lg:items-stretch opacity-0 transition-opacity duration-300 pointer-events-none">
    <div class="bg-white w-full lg:w-[480px] rounded-t-[3rem] lg:rounded-none p-8 animate-slide-up lg:animate-slide-in-right pointer-events-auto max-h-[90vh] lg:max-h-screen overflow-y-auto shadow-2xl sidebar-shadow">
      
      <!-- Top Actions & Close -->
      <div class="flex items-center justify-between mb-8">
        <div class="flex gap-3">
          <a id="mobilePanelXBtn" href="#" target="_blank" class="w-10 h-10 rounded-xl border border-brand-border flex items-center justify-center text-brand-dark hover:bg-brand-cream transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z" /></svg>
          </a>
          <a id="mobilePanelLinkedinBtn" href="#" target="_blank" class="w-10 h-10 rounded-xl border border-brand-border flex items-center justify-center text-brand-dark hover:bg-brand-cream transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
        <button id="closeMobilePanel" class="w-10 h-10 rounded-xl bg-brand-cream border border-brand-border flex items-center justify-center text-brand-muted hover:text-brand-dark transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Profile Section -->
      <div class="flex flex-col mb-10">
        <div id="mobilePanelAvatarImg" class="w-20 h-20 rounded-2xl overflow-hidden mb-6 shadow-brutal border-2 border-white">
          <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Avatar" class="w-full h-full object-cover">
        </div>
        <h2 id="mobilePanelTitle" class="font-display font-black text-4xl text-brand-dark mb-2 tracking-tight">Company Name</h2>
        <div id="mobilePanelCategory" class="text-sm font-bold text-brand-muted uppercase tracking-[0.2em]">Industry Category</div>
      </div>

      <!-- Detail Info Boxes -->
      <div class="space-y-4 mb-10">
        <div class="p-6 rounded-3xl border border-brand-border/60 bg-white shadow-sm space-y-5">
          <div id="mobilePanelReviewsBox" class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/><path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/></svg>
            </div>
            <div class="flex flex-col">
              <span id="mobilePanelRating" class="text-sm font-bold text-brand-dark">4.8 Rating</span>
              <span id="mobilePanelReviews" class="text-[10px] font-bold text-brand-muted uppercase tracking-widest">100+ Reviews</span>
            </div>
          </div>

          <div id="mobilePanelEmailBox" class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div class="flex flex-col">
              <span id="mobilePanelEmail" class="text-sm font-bold text-brand-dark truncate max-w-[280px]">contact@domain.com</span>
              <span class="text-[10px] font-bold text-brand-muted uppercase tracking-widest">Business Email</span>
            </div>
          </div>

          <div id="mobilePanelLocationBox" class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div class="flex flex-col">
              <span id="mobilePanelAddress" class="text-sm font-bold text-brand-dark line-clamp-2">Vancouver, WA, USA</span>
              <span class="text-[10px] font-bold text-brand-muted uppercase tracking-widest">Primary Office</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Description Area -->
      <div class="mb-10">
        <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted mb-4">About the business</h3>
        <p id="mobilePanelDesc" class="text-sm font-medium text-brand-dark leading-relaxed">
          High-quality business services provided with a focus on local excellence and customer satisfaction. Specializing in specialized industry solutions...
          <button class="text-brand-muted font-bold hover:text-brand-dark underline underline-offset-4 ml-1">See more</button>
        </p>
      </div>

      <!-- Functional Area / Badges -->
      <div class="mb-12">
        <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted mb-4">Functional area</h3>
        <div id="badgeContainer" class="flex flex-wrap gap-2">
          <!-- Will be populated dynamicly -->
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Marketing & PR</span>
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Service Industry</span>
          <span class="px-4 py-2 rounded-xl border border-brand-border/60 text-[11px] font-bold text-brand-dark bg-white">Local Search</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-4 mt-auto">
        <a id="mobilePanelWebsiteBtn" href="#" target="_blank" class="flex-1 bg-brand-cream text-brand-dark font-bold py-5 rounded-2xl border border-brand-border flex items-center justify-center gap-2 hover:bg-white transition-all">
          <span>Export PDF</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <button id="mobilePanelSaveBtn" class="flex-1 bg-brand-dark text-white font-bold py-5 rounded-2xl flex items-center justify-center gap-2 hover:bg-black transition-all group">
          <span>Email</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Website Preview Tooltip -->
  <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white border border-brand-border rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
    <div class="bg-gray-100 px-3 py-2 border-b border-gray-200 flex items-center gap-2">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
      </div>
      <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
    </div>
    <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
      <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
         <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
      </div>
      <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const selectAllCheckbox = document.getElementById('selectAll');
      const rowCheckboxes = document.querySelectorAll('.row-checkbox');
      const bulkActions = document.getElementById('bulkActions');
      const newSearchBtn = document.getElementById('newSearchBtn');
      const selectedCountSpan = document.getElementById('selectedCount');
      
      function updateBulkActions() {
        const selectedCount = document.querySelectorAll('.row-checkbox:checked').length;
        if (selectedCount > 0) {
          if (bulkActions) {
            bulkActions.classList.remove('hidden');
            bulkActions.classList.add('flex');
          }
          if (newSearchBtn) {
            newSearchBtn.classList.add('hidden');
            newSearchBtn.classList.remove('flex');
          }
          if (selectedCountSpan) {
            selectedCountSpan.textContent = selectedCount;
          }
        } else {
          if (bulkActions) {
            bulkActions.classList.add('hidden');
            bulkActions.classList.remove('flex');
          }
          if (newSearchBtn) {
            newSearchBtn.classList.remove('hidden');
            newSearchBtn.classList.add('flex');
          }
        }
      }

      if (selectAllCheckbox && rowCheckboxes.length > 0) {
        selectAllCheckbox.addEventListener('change', (e) => {
          rowCheckboxes.forEach(cb => {
            cb.checked = e.target.checked;
          });
          updateBulkActions();
        });
      }

      rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          if (selectAllCheckbox) {
            const allChecked = document.querySelectorAll('.row-checkbox:checked').length === rowCheckboxes.length;
            selectAllCheckbox.checked = allChecked;
          }
          updateBulkActions();
        });
      });

      // Website Preview Hover Logic
      const websiteLinks = document.querySelectorAll('.website-link');
      const websitePreview = document.getElementById('websitePreview');
      const previewIframe = document.getElementById('previewIframe');
      const previewUrlText = document.getElementById('previewUrlText');
      const previewLoading = document.getElementById('previewLoading');

      let previewTimeout;

      websiteLinks.forEach(link => {
        link.addEventListener('mouseenter', (e) => {
          const url = link.getAttribute('data-url');
          if (!url) return;

          previewTimeout = setTimeout(() => {
            const rect = link.getBoundingClientRect();
            
            // Default position above the link
            let top = rect.top;
            let left = rect.left + (rect.width / 2);
            let translateY = '-100%';
            let marginTop = '-15px';

            // If there's not enough room above, show it below the link
            if (top < 320) {
              top = rect.bottom;
              translateY = '0';
              marginTop = '15px';
            }

            // Boundary checks for left/right
            if (left < 200) left = 200;
            if (window.innerWidth - left < 200) left = window.innerWidth - 200;

            websitePreview.style.top = `${top}px`;
            websitePreview.style.left = `${left}px`;
            websitePreview.style.transform = `translate(-50%, ${translateY})`;
            websitePreview.style.marginTop = marginTop;
            
            previewUrlText.textContent = url;
            previewIframe.src = 'about:blank'; // Reset frame
            previewLoading.style.display = 'flex';
            
            websitePreview.classList.remove('hidden');
            // Small delay to allow element to render before adding opacity for animation
            setTimeout(() => {
              websitePreview.classList.remove('opacity-0');
              websitePreview.classList.add('opacity-100');
            }, 10);

            // Load iframe with URL
            setTimeout(() => {
               previewIframe.src = url;
               previewIframe.onload = () => {
                 previewLoading.style.display = 'none';
               };
            }, 50);
            
          }, 450); // Delay hover to avoid accidental popups
        });

        link.addEventListener('mouseleave', () => {
          clearTimeout(previewTimeout);
          websitePreview.classList.remove('opacity-100');
          websitePreview.classList.add('opacity-0');
          
          setTimeout(() => {
            if (websitePreview.classList.contains('opacity-0')) {
              websitePreview.classList.add('hidden');
              previewIframe.src = 'about:blank';
            }
          }, 200); // Wait for fade out
        });
      });

      const bulkEnrichBtn = document.getElementById('bulkEnrichBtn');
      const bulkExportBtn = document.getElementById('bulkExportBtn');
      const bulkSaveBtn = document.getElementById('bulkSaveBtn');

      if (bulkEnrichBtn) {
        bulkEnrichBtn.addEventListener('click', async () => {
          const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
          if (checkedBoxes.length === 0) return;
          
          const selectedRows = Array.from(checkedBoxes).map(cb => cb.closest('.result-row'));
          
          const originalText = bulkEnrichBtn.innerHTML;
          bulkEnrichBtn.innerHTML = '<span class="flex items-center gap-2"><svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Enriching...</span>';
          bulkEnrichBtn.disabled = true;

          for (const row of selectedRows) {
            const url = row.dataset.website;
            if (!url || url === 'N/A') continue;

            const socialCell = row.cells[6];
            const originalSocialHtml = socialCell.innerHTML;
            socialCell.innerHTML = '<div class="flex items-center gap-2 text-brand-muted"><svg class="animate-spin h-4 w-4 text-brand-yellow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span class="text-[10px] font-bold uppercase tracking-widest">Scanning...</span></div>';

            try {
              const res = await fetch('/enrich', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
              });

              if (res.ok) {
                const result = await res.json();
                if (result.success && result.data) {
                  const d = result.data;
                  if (d.facebook) row.dataset.facebook = d.facebook;
                  if (d.instagram) row.dataset.instagram = d.instagram;
                  if (d.twitter) row.dataset.twitter = d.twitter;
                  if (d.linkedin) row.dataset.linkedin = d.linkedin;
                  if (d.yelp) row.dataset.yelp = d.yelp;
                  if (d.email) row.dataset.email = d.email;

                  let socialsHtml = '<div class="flex items-center gap-3 flex-wrap">';
                  const iconTemplate = (link, title, pathData, extraClasses = '') => {
                    return `<a href="${link}" target="_blank" class="w-6 h-6 text-brand-dark hover:text-brand-yellow ${extraClasses} transition-all duration-300 transform hover:scale-110" title="${title}"><svg fill="currentColor" viewBox="0 0 24 24"><path d="${pathData}"/></svg></a>`;
                  };

                  if (row.dataset.facebook && row.dataset.facebook !== 'N/A') {
                    socialsHtml += iconTemplate(row.dataset.facebook, 'Facebook', 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z');
                  }
                  if (row.dataset.instagram && row.dataset.instagram !== 'N/A') {
                    socialsHtml += `<a href="${row.dataset.instagram}" target="_blank" class="w-6 h-6 text-brand-dark hover:text-brand-yellow transition-all duration-300 transform hover:scale-110" title="Instagram"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg></a>`;
                  }
                  if (row.dataset.twitter && row.dataset.twitter !== 'N/A') {
                    socialsHtml += iconTemplate(row.dataset.twitter, 'Twitter / X', 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z');
                  }
                  if (row.dataset.linkedin && row.dataset.linkedin !== 'N/A') {
                    socialsHtml += iconTemplate(row.dataset.linkedin, 'LinkedIn', 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z');
                  }
                  if (row.dataset.yelp && row.dataset.yelp !== 'N/A') {
                    socialsHtml += `<a href="${row.dataset.yelp}" target="_blank" class="px-2 py-0.5 rounded-md bg-[#FF1A1A] text-white text-[10px] font-bold hover:bg-black transition-all duration-300 transform hover:scale-110" title="Yelp">YELP</a>`;
                  }

                  if (socialsHtml === '<div class="flex items-center gap-3 flex-wrap">') {
                    socialsHtml = '<span class="text-brand-muted/40 text-sm">-</span>';
                  } else {
                    socialsHtml += '</div>';
                  }
                  
                  socialCell.innerHTML = socialsHtml;
                } else {
                  socialCell.innerHTML = originalSocialHtml;
                }
              } else {
                socialCell.innerHTML = originalSocialHtml;
              }
            } catch (err) {
              console.error('Enrichment fetch error:', err);
              socialCell.innerHTML = originalSocialHtml;
            }
          }

          bulkEnrichBtn.innerHTML = '✨ Enriched';
          setTimeout(() => {
            bulkEnrichBtn.innerHTML = originalText;
            bulkEnrichBtn.disabled = false;
          }, 3000);
        });
      }

      if (bulkExportBtn) {
        bulkExportBtn.addEventListener('click', () => {
          const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
          if (checkedBoxes.length === 0) return;
          
          const selectedRows = Array.from(checkedBoxes).map(cb => cb.closest('.result-row'));
          
          // Build CSV
          const headers = ['Company', 'Category', 'Phone', 'Address', 'City', 'Website', 'Email', 'Rating', 'Reviews', 'Facebook', 'Instagram', 'Twitter'];
          const rows = [headers.join(',')];

          selectedRows.forEach(row => {
            const data = [
              `"${(row.dataset.title || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.category || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.phone || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.address || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.city || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.website || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.email || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.rating || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.reviews || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.facebook || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.instagram || '').replace(/"/g, '""')}"`,
              `"${(row.dataset.twitter || '').replace(/"/g, '""')}"`
            ];
            rows.push(data.join(','));
          });

          const csvContent = rows.join('\n');
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.setAttribute('href', url);
          link.setAttribute('download', 'leads_export.csv');
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      }

      if (bulkSaveBtn) {
        bulkSaveBtn.addEventListener('click', async () => {
          const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
          if (checkedBoxes.length === 0) return;
          
          const selectedRows = Array.from(checkedBoxes).map(cb => cb.closest('.result-row'));

          const originalText = bulkSaveBtn.textContent;
          bulkSaveBtn.textContent = 'Saving...';
          bulkSaveBtn.disabled = true;

          let savedCount = 0;

          for (const row of selectedRows) {
            const leadData = {
              title: row.dataset.title,
              phone: row.dataset.phone,
              website: row.dataset.website,
              email: row.dataset.email,
              categoryName: row.dataset.category,
              address: row.dataset.address,
              city: row.dataset.city,
              totalScore: row.dataset.rating,
              reviewsCount: row.dataset.reviews,
              url: row.dataset.url,
              facebook: row.dataset.facebook,
              instagram: row.dataset.instagram,
              twitter: row.dataset.twitter
            };

            try {
              const res = await fetch('/leads/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(leadData)
              });
              if (res.ok) {
                const saveBtn = row.querySelector('.bookmark-btn');
                if (saveBtn) {
                  saveBtn.classList.add('bg-brand-yellow', 'border-brand-yellow', 'text-brand-dark');
                  saveBtn.classList.remove('text-brand-muted');
                }
                savedCount++;
              }
            } catch (err) {
              console.error('Error saving lead:', err);
            }
          }

          bulkSaveBtn.textContent = `Saved ${savedCount}`;
          setTimeout(() => {
            bulkSaveBtn.textContent = originalText;
            bulkSaveBtn.disabled = false;
            
            // Uncheck all after saving
            if (selectAllCheckbox) selectAllCheckbox.checked = false;
            rowCheckboxes.forEach(cb => cb.checked = false);
            updateBulkActions();
          }, 2000);
        });
      }
    });
  </script>
</body>
</html>
