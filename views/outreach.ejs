<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <% if (typeof tab !== 'undefined' && tab === 'pipeline') { %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <% } %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-14">
    <div class="mb-8 max-w-3xl">
      <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Outreach <span class="text-brand-muted">Hub</span></h1>
      <p class="text-brand-muted font-medium mt-2">One place to filter your working leads and organize folders. Daily hustle metrics live under <a href="/analytics?tab=tracker" class="font-bold text-brand-dark dark:text-white underline decoration-brand-yellow/60 hover:decoration-brand-yellow">Reports → Daily tracker</a>.</p>
    </div>

    <% const activeTab = typeof tab !== 'undefined' ? tab : 'queue'; %>
    <nav class="flex flex-wrap gap-2 mb-8" aria-label="Outreach tabs">
      <a href="/outreach?tab=queue" class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-colors <%= activeTab === 'queue' ? 'bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm' : 'bg-white dark:bg-slate-900 border-brand-border dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white' %>">Queue</a>
      <a href="/outreach?tab=pipeline" class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-colors <%= activeTab === 'pipeline' ? 'bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm' : 'bg-white dark:bg-slate-900 border-brand-border dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white' %>">Pipeline</a>
      <a href="/outreach?tab=folders" class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-colors <%= activeTab === 'folders' ? 'bg-brand-yellow text-brand-dark border-brand-yellow shadow-sm' : 'bg-white dark:bg-slate-900 border-brand-border dark:border-white/10 text-brand-muted hover:text-brand-dark dark:hover:text-white' %>">Folders</a>
    </nav>

    <% if (activeTab === 'pipeline') { %>
      <% const _pipeSrc = typeof sourceFilter !== 'undefined' ? sourceFilter : 'all'; %>
      <% const _pipeCounts = typeof leadSourceCounts !== 'undefined' && leadSourceCounts ? leadSourceCounts : { all: (pipelineBoardLeads || []).length, cold: 0, inbound: 0 }; %>
      <% const _pipeLeads = typeof pipelineBoardLeads !== 'undefined' ? pipelineBoardLeads : []; %>
      <% const _pf = typeof pipelineFilters !== 'undefined' && pipelineFilters ? pipelineFilters : { q: '', stage: '', status: '', minRating: '', minReviews: '', origin: '', addedFrom: '', addedTo: '' }; %>
      <% const _pfSuffix = typeof pipelineFilterSuffix !== 'undefined' ? pipelineFilterSuffix : ''; %>
      <% const _statusOpts = typeof pipelineStatusOptions !== 'undefined' && pipelineStatusOptions ? pipelineStatusOptions : []; %>
      <% const _pfActive = _pf && Object.values(_pf).some(function (v) { return v != null && String(v).trim() !== ''; }); %>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-6">
        <div class="min-w-0 flex-1">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Pipeline</p>
          <h2 class="font-display font-extrabold text-2xl md:text-3xl text-brand-dark dark:text-white tracking-tight">Working leads</h2>
          <p class="text-brand-muted text-sm mt-2 max-w-xl">Same table and board as the full leads page — inline stage updates, email intel, and detail panel.</p>
          <div class="flex flex-wrap gap-2 mt-4" role="tablist" aria-label="Filter by lead source">
            <a href="/outreach?tab=pipeline&amp;source=all<%- _pfSuffix.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= _pipeSrc === 'all' ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">All (<%= _pipeCounts.all %>)</a>
            <a href="/outreach?tab=pipeline&amp;source=cold<%- _pfSuffix.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= _pipeSrc === 'cold' ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Cold (<%= _pipeCounts.cold %>)</a>
            <a href="/outreach?tab=pipeline&amp;source=inbound<%- _pfSuffix.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= _pipeSrc === 'inbound' ? 'bg-amber-500 text-white border-amber-500' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Warm inbound (<%= _pipeCounts.inbound %>)</a>
          </div>
          <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-3">
            <a href="/workspace" class="text-brand-dark dark:text-white hover:underline">Team &amp; assign</a>
          </p>
          <% } %>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <div class="flex items-center bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-1 shadow-sm">
            <button id="showTableView" type="button" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-brand-yellow text-brand-dark shadow-sm">Table</button>
            <button id="showKanbanView" type="button" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white">Pipeline</button>
          </div>
          <a href="/leads" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white text-center whitespace-nowrap">Import CSV &amp; tools</a>
          <a href="/" class="btn-pill btn-primary px-5 py-3 text-[10px] font-black uppercase tracking-widest whitespace-nowrap text-center">Find leads</a>
        </div>
      </div>

      <details class="brand-card dark:bg-slate-900 dark:border-white/10 mb-8 w-full max-w-none group overflow-hidden" <%= _pfActive ? 'open' : '' %>>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
          <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1">
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Filter this view</span>
            <% if (_pfActive) { %>
            <span class="rounded-full bg-brand-yellow/20 px-2.5 py-0.5 text-[9px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow">Active</span>
            <% } %>
            <span class="text-[11px] text-brand-muted"><%= _pipeLeads.length %> lead<%= _pipeLeads.length === 1 ? '' : 's' %> in view</span>
          </div>
          <span class="shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </span>
        </summary>
        <form method="get" action="/outreach" class="border-t border-brand-border/40 px-5 pb-5 pt-4 dark:border-white/10 md:px-6 md:pb-6 w-full">
          <input type="hidden" name="tab" value="pipeline" />
          <input type="hidden" name="source" value="<%= _pipeSrc %>" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-4 xl:grid-cols-8 items-end w-full">
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Search</label>
              <input type="search" name="q" value="<%= _pf.q %>" autocomplete="off" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Company, email, phone…" />
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Origin</label>
              <select name="origin" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
                <option value=""<%= !_pf.origin ? ' selected' : '' %>>All origins</option>
                <option value="search"<%= _pf.origin === 'search' ? ' selected' : '' %>>Searched / maps</option>
                <option value="csv"<%= _pf.origin === 'csv' ? ' selected' : '' %>>CSV import</option>
                <option value="manual"<%= _pf.origin === 'manual' ? ' selected' : '' %>>Manual / offline</option>
                <option value="warm"<%= _pf.origin === 'warm' ? ' selected' : '' %>>Warm (inbound)</option>
              </select>
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Added from</label>
              <input type="date" name="addedFrom" value="<%= _pf.addedFrom || '' %>" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Added to</label>
              <input type="date" name="addedTo" value="<%= _pf.addedTo || '' %>" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Pipeline stage</label>
              <select name="stage" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
                <option value="">All stages</option>
                <% for (let i = 1; i <= 10; i += 1) { %>
                <option value="<%= i %>"<%= String(_pf.stage) === String(i) ? ' selected' : '' %>><%= i %></option>
                <% } %>
              </select>
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Status</label>
              <select name="status" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
                <option value="">Any status</option>
                <% _statusOpts.forEach(function (st) { %>
                <option value="<%= st %>"<%= _pf.status === st ? ' selected' : '' %>><%= st %></option>
                <% }); %>
              </select>
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Min rating</label>
              <input type="number" name="minRating" min="0" max="5" step="0.1" value="<%= _pf.minRating %>" placeholder="0" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
            <div class="min-w-0">
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Min reviews</label>
              <input type="number" name="minReviews" min="0" step="1" value="<%= _pf.minReviews %>" placeholder="0" class="w-full min-w-0 rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
            </div>
            <div class="col-span-1 sm:col-span-2 md:col-span-4 xl:col-span-8 flex flex-wrap gap-2 pt-1">
              <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest sm:flex-1 sm:min-w-[140px]">Apply filters</button>
              <a href="/outreach?tab=pipeline&amp;source=<%= _pipeSrc %>" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-center text-brand-dark dark:text-white sm:flex-1 sm:min-w-[140px]">Clear</a>
            </div>
          </div>
        </form>
      </details>

      <%- include('partials/leads_pipeline_core', { leads: _pipeLeads, pipelineStages }) %>
    <% } else if (activeTab === 'queue') { %>
      <div class="grid lg:grid-cols-3 gap-6">
        <section class="lg:col-span-1 brand-card p-6 dark:bg-slate-900 dark:border-white/10">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-4">Filters</p>
          <div class="space-y-4">
            <div>
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Stage</label>
              <select id="queueStage" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-bold text-brand-dark dark:text-white">
                <option value="">All stages</option>
                <% for (let i = 1; i <= 10; i += 1) { %>
                  <option value="<%= i %>"><%= i %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Folder</label>
              <select id="queueFolder" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-bold text-brand-dark dark:text-white">
                <option value="">All folders</option>
                <% (folders || []).forEach((f) => { %>
                  <option value="<%= f.key %>"><%= f.name %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Search</label>
              <input id="queueSearch" type="text" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Company, email, phone, domain…" />
            </div>
            <button id="queueApply" type="button" class="btn-pill btn-primary w-full py-3 text-[10px] font-black uppercase tracking-widest">Apply</button>
          </div>
        </section>

        <section class="lg:col-span-2 brand-card p-6 dark:bg-slate-900 dark:border-white/10">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Working queue</p>
              <p class="text-sm text-brand-muted mt-1">Leads filtered for outreach focus. Click a lead to open details.</p>
            </div>
            <a href="/outreach?tab=pipeline" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Open pipeline</a>
          </div>
          <div id="queueList" class="divide-y divide-brand-border/40 dark:divide-white/10 rounded-2xl border border-brand-border/30 dark:border-white/10 overflow-hidden bg-white/50 dark:bg-slate-950/20">
            <% if (typeof queueListLeads !== 'undefined' && queueListLeads && queueListLeads.length) { %>
              <% queueListLeads.forEach(function (lead) { %>
                <%- include('partials/outreach_lead_row', { lead: lead, mode: 'queue' }) %>
              <% }); %>
            <% } else { %>
              <div class="p-6 text-sm text-brand-muted dark:text-slate-400 italic">No leads in this workspace.</div>
            <% } %>
          </div>
        </section>
      </div>
    <% } else { %>
      <div class="grid lg:grid-cols-3 gap-6">
        <aside class="brand-card p-6 dark:bg-slate-900 dark:border-white/10">
          <div class="flex items-center justify-between gap-3 mb-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Folders</p>
            <button type="button" id="folderCreateOpen" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">New</button>
          </div>
          <div id="folderList" class="space-y-2">
            <button type="button" data-folder="" class="folder-pill w-full text-left px-4 py-3 rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/60 dark:bg-slate-800/40 text-sm font-bold text-brand-dark dark:text-white">All leads</button>
            <% (folders || []).forEach((f) => { %>
              <button type="button" data-folder="<%= f.key %>" class="folder-pill w-full text-left px-4 py-3 rounded-2xl border border-brand-border/30 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/30 text-sm font-semibold text-brand-dark dark:text-white hover:border-brand-yellow/40 transition-colors"><%= f.name %></button>
            <% }) %>
          </div>
          <p class="text-[11px] text-brand-muted mt-4">Use folders for “Referrals”, “Events”, “High-priority”, etc.</p>
        </aside>

        <section class="lg:col-span-2 brand-card p-6 dark:bg-slate-900 dark:border-white/10">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Leads</p>
              <p id="folderLeadsMeta" class="text-sm text-brand-muted mt-1">Select a folder to filter.</p>
            </div>
            <div class="flex items-center gap-2">
              <input id="folderSearch" type="text" class="rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Search…" />
              <button id="folderRefresh" type="button" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Refresh</button>
            </div>
          </div>

          <div id="folderLeads" class="divide-y divide-brand-border/40 dark:divide-white/10 rounded-2xl border border-brand-border/30 dark:border-white/10 overflow-hidden bg-white/50 dark:bg-slate-950/20">
            <% if (typeof folderListLeads !== 'undefined' && folderListLeads && folderListLeads.length) { %>
              <% folderListLeads.forEach(function (lead) { %>
                <%- include('partials/outreach_lead_row', { lead: lead, mode: 'folders', folders: folders || [] }) %>
              <% }); %>
            <% } else { %>
              <div class="p-6 text-sm text-brand-muted dark:text-slate-400 italic">No leads in this workspace.</div>
            <% } %>
          </div>
        </section>
      </div>
    <% } %>
  </main>

  <% if (activeTab === 'pipeline') { %>
  <%- include('partials/leads_interactive_tail', { leads: typeof pipelineBoardLeads !== 'undefined' ? pipelineBoardLeads : [], pipelineStages }) %>
  <script src="/js/app.js"></script>
  <% } else { %>
  <div id="folderCreateModal" class="fixed inset-0 z-[6000] hidden items-center justify-center p-4" aria-hidden="true">
    <div id="folderCreateBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">New folder</h2>
      <p class="text-sm text-brand-muted mb-5">Create a folder to bucket leads (manual or imported).</p>
      <input id="folderCreateName" type="text" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" placeholder="e.g. Referrals" />
      <p id="folderCreateError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderCreateSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Create</button>
        <button id="folderCreateCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var activeTab = <%- JSON.stringify(activeTab) %>;
    function $(id) { return document.getElementById(id); }

    var jsonHeaders = { Accept: 'application/json', 'Content-Type': 'application/json' };
    var fetchJsonOpts = { credentials: 'same-origin', headers: { Accept: 'application/json' } };

    function renderLeadRow(l, folderKey) {
      var email = l.email && l.email !== 'N/A' ? l.email : '—';
      var phone = l.phone && l.phone !== 'N/A' ? l.phone : '—';
      var site = l.website && l.website !== 'N/A' ? l.website.replace(/^https?:\\/\\//, '').replace(/\\/$/, '') : '—';
      var stage = l.pipelineStage || 1;
      var fk = l.folderKey || '';
      var rowAnchor = String(l.key || '').replace(/[^a-z0-9]+/gi, '-');
      var openHref = fk ? '/outreach?tab=folders' : ('/leads#lead-row-' + rowAnchor);
      return '' +
        '<div class="p-4 sm:p-5 flex items-start justify-between gap-3">' +
          '<div class="min-w-0">' +
            '<div class="font-bold text-brand-dark dark:text-white truncate">' + escapeHtml(l.title || 'Lead') + '</div>' +
            '<div class="text-[11px] text-brand-muted dark:text-slate-400 mt-1 truncate">' +
              escapeHtml([email, phone, site].filter(Boolean).join(' · ')) +
            '</div>' +
            '<div class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-2">Stage ' + escapeHtml(String(stage)) + '</div>' +
          '</div>' +
          '<div class="shrink-0 flex flex-col items-end gap-2">' +
            (activeTab === 'folders'
              ? '<select class="folder-assign rounded-xl border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-800/80 px-3 py-2 text-[11px] font-bold text-brand-dark dark:text-white" data-lead="' + escapeAttr(l.key) + '">' +
                  '<option value="">No folder</option>' +
                  (window.__folders || []).map(function (f) {
                    var sel = (fk === f.key) ? ' selected' : '';
                    return '<option value="' + escapeAttr(f.key) + '"' + sel + '>' + escapeHtml(f.name) + '</option>';
                  }).join('') +
                '</select>'
              : '') +
            '<a href="' + escapeAttr(openHref) + '" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline">Open</a>' +
          '</div>' +
        '</div>';
    }

    function escapeHtml(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escapeAttr(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    }

    function loadLeads(params, targetEl, metaEl) {
      if (!targetEl) return Promise.resolve();
      var qs = new URLSearchParams(params || {});
      return fetch('/leads/list.json?' + qs.toString(), fetchJsonOpts)
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          if (!data || !data.success) throw new Error('Failed');
          if (metaEl) metaEl.textContent = data.leads.length + ' lead' + (data.leads.length === 1 ? '' : 's');
          if (!data.leads.length) {
            targetEl.innerHTML = '<div class="p-6 text-sm text-brand-muted dark:text-slate-400 italic">No leads match this filter.</div>';
            return;
          }
          targetEl.innerHTML = data.leads.map(function (l) { return renderLeadRow(l); }).join('');
        })
        .catch(function () {
          targetEl.innerHTML = '<div class="p-6 text-sm text-rose-600 dark:text-rose-400 italic">Could not load leads. Refresh the page or sign in again.</div>';
        });
    }

    if (activeTab === 'queue') {
      var list = $('queueList');
      var stage = $('queueStage');
      var folder = $('queueFolder');
      var q = $('queueSearch');
      var apply = $('queueApply');
      function refresh() {
        loadLeads({ stage: stage.value, folderKey: folder.value, q: q.value, excludeFolderAssigned: '1' }, list);
      }
      if (apply) apply.addEventListener('click', refresh);
      refresh();
    }

    if (activeTab === 'folders') {
      window.__folders = <%- JSON.stringify((folders || []).map((f) => ({ key: f.key, name: f.name }))) %>;
      var leadsEl = $('folderLeads');
      var metaEl = $('folderLeadsMeta');
      var searchEl = $('folderSearch');
      var refreshBtn = $('folderRefresh');
      var selectedFolder = '';

      function bindFolderAssigns(container) {
        if (!container) return;
        container.querySelectorAll('select.folder-assign').forEach(function (sel) {
          sel.addEventListener('change', function () {
            var leadKey = sel.getAttribute('data-lead');
            var folderKey = sel.value;
            fetch('/folders/assign', {
              method: 'POST',
              credentials: 'same-origin',
              headers: jsonHeaders,
              body: JSON.stringify({ leadKey: leadKey, folderKey: folderKey })
            }).then(function () { refreshLeads(); });
          });
        });
      }

      function refreshFolders() {
        return fetch('/folders', fetchJsonOpts)
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function (data) {
            if (data && data.success) {
              window.__folders = data.folders.map(function (f) { return { key: f.key, name: f.name }; });
            }
          })
          .catch(function () {});
      }

      function refreshLeads() {
        var params = { q: (searchEl && searchEl.value) || '' };
        if (selectedFolder) params.folderKey = selectedFolder;
        return fetch('/leads/list.json?' + new URLSearchParams(params).toString(), fetchJsonOpts)
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function (data) {
            if (!data || !data.success) throw new Error('Failed');
            if (metaEl) {
              metaEl.textContent = (selectedFolder ? 'Folder' : 'All leads') + ' · ' + data.leads.length + ' lead' + (data.leads.length === 1 ? '' : 's');
            }
            if (!data.leads.length) {
              leadsEl.innerHTML = '<div class="p-6 text-sm text-brand-muted dark:text-slate-400 italic">No leads in this folder.</div>';
              return;
            }
            leadsEl.innerHTML = data.leads.map(function (l) { return renderLeadRow(l); }).join('');
          })
          .then(function () {
            bindFolderAssigns(leadsEl);
          })
          .catch(function () {
            if (leadsEl) leadsEl.innerHTML = '<div class="p-6 text-sm text-rose-600 dark:text-rose-400 italic">Could not load leads.</div>';
          });
      }

      document.querySelectorAll('.folder-pill').forEach(function (b) {
        b.addEventListener('click', function () {
          selectedFolder = b.getAttribute('data-folder') || '';
          document.querySelectorAll('.folder-pill').forEach(function (x) {
            x.classList.remove('border-brand-yellow', 'bg-brand-yellow/10');
          });
          b.classList.add('border-brand-yellow', 'bg-brand-yellow/10');
          refreshLeads();
        });
      });
      if (refreshBtn) refreshBtn.addEventListener('click', function () { refreshFolders().then(refreshLeads); });
      if (searchEl) searchEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); refreshLeads(); }});

      // Create folder modal
      var m = $('folderCreateModal');
      var open = $('folderCreateOpen');
      var bd = $('folderCreateBackdrop');
      var cancel = $('folderCreateCancel');
      var save = $('folderCreateSave');
      var name = $('folderCreateName');
      var err = $('folderCreateError');
      function openM() {
        if (!m) return;
        m.classList.remove('hidden');
        m.classList.add('flex');
        m.setAttribute('aria-hidden', 'false');
        if (name) name.focus();
        if (err) { err.classList.add('hidden'); err.textContent = ''; }
      }
      function closeM() {
        if (!m) return;
        m.classList.add('hidden');
        m.classList.remove('flex');
        m.setAttribute('aria-hidden', 'true');
        if (name) name.value = '';
      }
      if (open) open.addEventListener('click', openM);
      if (bd) bd.addEventListener('click', closeM);
      if (cancel) cancel.addEventListener('click', closeM);
      if (save) save.addEventListener('click', function () {
        var n = (name && name.value || '').trim();
        if (!n) return;
        fetch('/folders', {
          method: 'POST',
          credentials: 'same-origin',
          headers: jsonHeaders,
          body: JSON.stringify({ name: n })
        })
          .then(function (r) {
            return r.text().then(function (t) {
              try { return JSON.parse(t); } catch (e2) {
                throw new Error(r.ok ? 'Invalid response' : ('HTTP ' + r.status));
              }
            });
          })
          .then(function (data) {
            if (!data || !data.success) throw new Error((data && data.error) || 'Failed');
            closeM();
            window.location.reload();
          })
          .catch(function (e) {
            if (err) { err.textContent = e && e.message ? e.message : 'Could not create folder.'; err.classList.remove('hidden'); }
          });
      });

      bindFolderAssigns(leadsEl);
      if (metaEl && leadsEl) {
        var nInit = leadsEl.querySelectorAll('select.folder-assign').length;
        metaEl.textContent = 'All leads · ' + nInit + ' lead' + (nInit === 1 ? '' : 's');
      }
      refreshFolders().then(refreshLeads);
    }
  })();
  </script>
  <%- include('partials/footer') %>
  <% } %>
</body>
</html>

