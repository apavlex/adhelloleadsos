<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { tailwindInPage: true }) %>
  <style>
    .fw-detail-card { border: 1px solid rgba(15, 23, 42, 0.08); background: #fff; border-radius: 1.35rem; padding: 1.1rem 1.15rem; }
    html.dark .fw-detail-card { background: rgba(15, 23, 42, 0.78); border-color: rgba(255, 255, 255, 0.08); }
    .fw-owner-chip {
      display: inline-flex; align-items: center; gap: 0.35rem; max-width: 100%;
      border-radius: 999px; padding: 0.4rem 0.75rem; font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.02em; background: color-mix(in srgb, var(--brand-yellow, #FFD644) 28%, #fff);
      color: #854d0e; border: 1px solid color-mix(in srgb, var(--brand-yellow, #FFD644) 55%, transparent);
    }
    html.dark .fw-owner-chip { background: color-mix(in srgb, var(--brand-yellow, #FFD644) 18%, rgba(15, 23, 42, 0.9)); color: #fde68a; }
    .fw-owner-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw-owner-chip em { font-style: normal; font-size: 9px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.75; }
    .net-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0.55rem 0.95rem; font-size: 0.78rem; font-weight: 700; line-height: 1; white-space: nowrap; border: 1px solid transparent; cursor: pointer; text-decoration: none; }
    .net-btn-yellow { background: var(--brand-yellow, #FFD644); color: var(--brand-on-accent, #111827); }
    .net-btn-ghost { background: transparent; border-color: rgba(15, 23, 42, 0.14); color: inherit; }
    html.dark .net-btn-ghost { border-color: rgba(255, 255, 255, 0.16); }
    .net-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(148, 163, 184, 0.16); color: #64748b; }
    .fw-pill-overdue { background: rgba(225, 29, 72, 0.12); color: #be123c; }
    .fw-pill-scheduled { background: rgba(59, 130, 246, 0.14); color: #1d4ed8; }
    .fw-pill-in_progress { background: rgba(245, 158, 11, 0.16); color: #b45309; }
    .fw-pill-completed { background: rgba(16, 185, 129, 0.14); color: #047857; }
    .fw-photos { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
    .fw-photo { display: block; width: 5rem; height: 5rem; border-radius: 0.85rem; overflow: hidden; border: 1px solid rgba(15, 23, 42, 0.08); background: rgba(15, 23, 42, 0.04); }
    .fw-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .fw-actions { display: grid; grid-template-columns: 1fr; gap: 0.5rem; margin-top: 1rem; }
    @media (min-width: 480px) { .fw-actions { grid-template-columns: 1fr 1fr; } }
    .fw-actions .net-btn { width: 100%; min-height: 2.75rem; border-radius: 0.9rem; }
  </style>
  <%- include('partials/tailwind_css') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <% const d = detail; %>
  <main class="max-wide px-6 py-8 md:py-12">
    <div class="mb-4 flex items-start justify-between gap-3">
      <a href="<%= d.backHref %>" class="text-[12px] font-bold text-brand-muted hover:underline shrink-0">← Team field work</a>
      <span class="fw-owner-chip" title="Reviews app owned by this teammate">
        <em>Teammate</em>
        <span><%= d.memberName %></span>
      </span>
    </div>

    <header class="mb-5">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="net-pill fw-pill-<%= d.status %><%= d.overdue ? ' fw-pill-overdue' : '' %>"><%= d.statusLabel %><%= d.overdue ? ' · overdue' : '' %></span>
        <% if (d.whenLabel) { %><span class="text-[12px] font-bold <%= d.overdue ? 'text-rose-600' : 'text-brand-muted' %>"><%= d.whenLabel %></span><% } %>
      </div>
      <h1 class="font-display font-extrabold text-2xl md:text-3xl tracking-tight"><%= d.title %></h1>
      <p class="mt-2 text-base font-semibold"><%= d.customerName %></p>
      <p class="mt-1 text-[13px] font-semibold text-brand-muted">In <strong class="text-brand-dark dark:text-white"><%= d.memberName %></strong>’s Reviews app<% if (d.memberContact) { %> · <%= d.memberContact %><% } %></p>
    </header>

    <section class="fw-detail-card mb-4">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Customer</p>
      <p class="font-semibold text-lg"><%= d.customerName %></p>
      <% if (d.customerPhone) { %><p class="mt-1 text-sm"><a class="hover:underline" href="tel:<%= String(d.customerPhone).replace(/[^0-9+]/g, '') %>"><%= d.customerPhone %></a></p><% } %>
      <% if (d.customerEmail) { %><p class="mt-1 text-sm text-brand-muted"><%= d.customerEmail %></p><% } %>
      <% if (d.customerAddress) { %><p class="mt-1 text-sm text-brand-muted"><%= d.customerAddress %></p><% } %>
      <% if (d.ownerCustomerHref) { %>
      <a href="<%= d.ownerCustomerHref %>" class="net-btn net-btn-ghost mt-3">View customer</a>
      <% } %>
    </section>

    <% if (d.latestNote || d.notes || d.customerNotes) { %>
    <section class="fw-detail-card mb-4">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Notes</p>
      <p class="text-sm leading-relaxed whitespace-pre-wrap"><%= d.latestNote || d.notes || d.customerNotes %></p>
    </section>
    <% } %>

    <% if (d.photos && d.photos.length) { %>
    <section class="fw-detail-card mb-4">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Photos</p>
      <p class="text-[12px] font-semibold text-brand-muted mb-2"><%= d.photoCount %> on this job</p>
      <div class="fw-photos" data-os-lr-gallery>
        <% d.photos.forEach(function (p) { %>
        <a class="fw-photo" href="<%= p.href %>" data-os-lr-open data-os-lr-src="<%= p.href %>" data-os-lr-caption="<%= String(p.caption || 'Job photo').replace(/"/g, '&quot;') %>" title="<%= p.caption || 'Job photo' %>">
          <img src="<%= p.href %>" alt="<%= p.caption || 'Job photo' %>" loading="lazy" decoding="async" width="80" height="80" />
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <div class="fw-actions">
      <a href="<%= d.backHref %>" class="net-btn net-btn-yellow">Back to field work</a>
      <% if (d.portalJobHref) { %>
      <a href="<%= d.portalJobHref %>" class="net-btn net-btn-ghost" target="_blank" rel="noopener">Edit in their app</a>
      <% } %>
    </div>
    <p class="mt-3 text-[12px] text-brand-muted">You’re in the workspace manager view. Opening in their app is only for edits inside that teammate’s Reviews app.</p>
  </main>
  <%- include('partials/photo_lightroom') %>
</body>
</html>
