<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { tailwindInPage: true }) %>
  <%- include('partials/tailwind_css') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <%
    const _openPath = typeof openPath !== 'undefined' && openPath ? openPath : '/today';
    const _openUrl = typeof openUrl !== 'undefined' && openUrl ? openUrl : _openPath;
    const _net = typeof networkName !== 'undefined' && networkName ? networkName : 'your network';
  %>
  <main class="max-wide px-6 py-8 md:py-12">
    <header class="mb-6 max-w-2xl">
      <p class="text-[11px] font-black uppercase tracking-[0.22em] text-brand-muted mb-2">Workspace</p>
      <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Get the Referral app</h1>
      <p class="mt-2 text-sm leading-relaxed text-brand-muted dark:text-slate-400">Your installable app for <strong class="text-brand-dark dark:text-white"><%= _net %></strong> — Home, Request a review, customers, and referrals. Partner apps for other businesses stay on <a href="/network?tab=members" class="font-semibold text-brand-dark dark:text-white underline decoration-brand-yellow/60 underline-offset-2 hover:decoration-brand-yellow">Network</a>.</p>
    </header>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 md:p-8" id="referralApp" aria-label="Referral app">
      <div class="mb-5">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Your Referral app</p>
        <h2 class="font-display font-extrabold text-xl md:text-2xl text-brand-dark dark:text-white mt-1">Open &amp; install</h2>
        <p class="text-sm text-brand-muted mt-1 max-w-2xl">Same app you brand under Network → App branding. Add it to your Home Screen, then use reviews, customers, and referrals on the go.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-[180px_minmax(0,1fr)] items-start">
        <div class="flex flex-col items-center text-center gap-2">
          <img src="/get-app/qr.png" alt="QR code that opens your Referral app" width="160" height="160" class="w-40 h-40 rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white p-1" loading="lazy" />
          <p class="text-[11px] text-brand-muted">Scan with your phone camera, then Add to Home Screen.</p>
          <p class="text-[11px] font-semibold text-brand-dark dark:text-white break-all"><%= typeof openHost !== 'undefined' ? openHost : '' %></p>
          <button
            type="button"
            class="mt-1 inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-dark/40 dark:border-white/40 bg-transparent text-brand-dark dark:text-white px-5 py-2.5 text-[10px] font-black uppercase tracking-widest hover:border-brand-yellow hover:bg-brand-yellow/15 transition-colors cursor-pointer"
            data-get-app-share="only"
            data-get-app-share-title="<%= typeof appName !== 'undefined' ? appName : 'AdHello' %> Referral app"
            data-get-app-share-url="<%= _openUrl %>"
            data-share-label="Share Referral app"
            title="Share or copy your Referral app link"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 00-2.25 2.25v9a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H15m0-3l-3-3m0 0l-3 3m3-3V15" /></svg>
            <span data-get-app-share-label>Share Referral app</span>
          </button>
          <a
            href="<%= _openPath %>"
            class="inline-flex items-center justify-center rounded-full bg-brand-yellow text-brand-dark no-underline px-5 py-2.5 text-[10px] font-black uppercase tracking-widest"
          >Open Referral app</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4">
            <p class="font-bold text-brand-dark dark:text-white mb-2">iPhone &amp; iPad</p>
            <ol class="list-decimal pl-5 space-y-1.5 text-sm text-brand-dark dark:text-slate-200">
              <li>Tap <strong>Open Referral app</strong> (or scan the QR) in <strong>Safari</strong>.</li>
              <li>Tap <strong>Share</strong> (square with an arrow).</li>
              <li>Tap <strong>Add to Home Screen</strong>.</li>
              <li>Tap <strong>Add</strong>.</li>
            </ol>
          </div>
          <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4">
            <p class="font-bold text-brand-dark dark:text-white mb-2">Android</p>
            <ol class="list-decimal pl-5 space-y-1.5 text-sm text-brand-dark dark:text-slate-200">
              <li>Tap <strong>Open Referral app</strong> (or scan the QR) in <strong>Chrome</strong>.</li>
              <li>Tap the <strong>⋮</strong> menu.</li>
              <li>Tap <strong>Add to Home screen</strong> or <strong>Install app</strong>.</li>
              <li>Tap <strong>Install</strong> or <strong>Add</strong>.</li>
            </ol>
          </div>
        </div>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
