<!DOCTYPE html>
<html lang="en">
<head>
  <%/* Public /rv pages must be crawlable so iMessage/SMS link previews can load og:image. */%>
  <%- include('member_app/_head', {
    pageTitle: 'Review ' + member.companyName,
    robots: (typeof previewMode !== 'undefined' && previewMode) ? 'noindex' : 'index, follow, max-image-preview:large',
    cssAsync: true,
  }) %>
  <% if (!(typeof previewMode !== 'undefined' && previewMode)) { %>
  <%- include('partials/review_og_meta') %>
  <% } %>
  <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
  <link rel="preload" as="image" href="<%= logoUrl %>">
  <% } %>
</head>
<body>
  <%
    const _pageBase = typeof pageBase !== 'undefined' && pageBase ? pageBase : ('/rv/' + slug);
    const _preview = typeof previewMode !== 'undefined' && previewMode;
    const _feedbackAction = _preview ? (_pageBase + '/feedback') : ('/rv/' + slug + '/feedback');
  %>
  <% if (_preview) { %>
  <div class="rv-preview-bar">
    <a href="<%= typeof previewBack !== 'undefined' && previewBack ? previewBack : '#' %>">← Back to Review</a>
    <span>Preview · customers still open your public link</span>
  </div>
  <% } %>
  <main class="rv-wrap<%= _preview ? ' rv-wrap--preview' : '' %>">
    <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
    <img class="rv-logo" src="<%= logoUrl %>" alt="<%= member.companyName %>" width="84" height="84" decoding="async" fetchpriority="high">
    <% } else { %>
    <div class="rv-initials" aria-hidden="true"><%= member.companyName.trim().charAt(0).toUpperCase() %></div>
    <% } %>
    <h1><%= member.companyName %></h1>

    <% if (thanks) { %>
      <p class="rv-sub">Thank you. Your message went straight to the owner, and they'll reach out to make it right.</p>
      <% if (destinations.length) { %>
      <div class="rv-panel">
        <p class="ma-hint" style="text-align:center">You can also post a public review:</p>
        <div class="rv-links rv-links--quiet">
          <% destinations.forEach(function (d) { %>
          <a class="rv-link" href="<%= d.href %>" rel="noopener"><span class="rv-link__icon" style="background: <%= d.tile || d.color %>"><% if (d.icon) { %><%- d.icon %><% } else { %><%= d.letter %><% } %></span><%= d.label %><span class="rv-link__go">›</span></a>
          <% }); %>
        </div>
      </div>
      <% } %>
    <% } else { %>
      <p class="rv-sub"><%= gate.stage === 'ask' ? 'How was your experience?' : (gate.stage === 'happy' ? 'Thank you! Would you share that in a quick review?' : "We're sorry it wasn't great.") %></p>

      <div class="rv-stars" role="group" aria-label="Rate your experience">
        <% [1, 2, 3, 4, 5].forEach(function (s) { %>
        <a class="rv-star <%= gate.rating >= s ? 'is-on' : '' %>" href="<%= _pageBase %>?r=<%= s %>" aria-label="<%= s %> star<%= s > 1 ? 's' : '' %>" rel="nofollow"><%- icons.starSolid %></a>
        <% }); %>
      </div>

      <% if (gate.stage === 'happy') { %>
      <div class="rv-panel">
        <% const _kw = typeof keywordHint !== 'undefined' && keywordHint ? String(keywordHint).trim() : ''; %>
        <% if (_kw) { %>
        <div class="rv-keyword" style="margin:0 0 14px;padding:12px 14px;border-radius:14px;background:color-mix(in srgb,var(--acc) 12%,var(--card));border:1px solid var(--line);text-align:left">
          <p class="ma-hint" style="margin:0 0 6px;font-weight:700;color:var(--ink)">Tip for your review</p>
          <p style="margin:0 0 10px;font-size:15px;font-weight:600;color:var(--ink)">Mention “<%= _kw %>” so neighbors find this work.</p>
          <button type="button" class="ma-btn ma-btn--sm ma-btn--soft" id="rvCopyKeyword" data-copy="<%= _kw.replace(/"/g, '&quot;') %>"><%- typeof icons !== 'undefined' && icons.copy ? icons.copy : '' %> Copy phrase</button>
          <script>
          (function () {
            var btn = document.getElementById('rvCopyKeyword');
            if (!btn) return;
            btn.addEventListener('click', function () {
              var t = btn.getAttribute('data-copy') || '';
              if (!t) return;
              var done = function () {
                var prev = btn.textContent;
                btn.textContent = 'Copied';
                setTimeout(function () { btn.textContent = prev; }, 1600);
              };
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(t).then(done).catch(function () {});
              } else {
                var ta = document.createElement('textarea');
                ta.value = t; document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta); done();
              }
            });
          })();
          </script>
        </div>
        <% } %>
        <% const _ref = typeof referralShare !== 'undefined' && referralShare ? referralShare : null; %>
        <% if (_ref && _ref.url) { %>
        <section class="rv-referral" aria-label="Share your referral link"<%= _ref.preview ? ' data-preview="1"' : '' %>>
          <p class="rv-referral__eyebrow"><%= _ref.eyebrow || 'Refer a friend' %></p>
          <h2 class="rv-referral__title"><%= _ref.headline %></h2>
          <% if (_ref.preview) { %>
          <p class="ma-hint" style="margin:0 0 10px">Preview — customers get a personal tracked link synced to them.</p>
          <% } else { %>
          <p class="ma-hint" style="margin:0 0 10px">Your personal tracked link — friends who book through it count for you.</p>
          <% } %>
          <div class="ma-link-box rv-referral__link">
            <code id="rvReferralUrl"><%= _ref.url %></code>
          </div>
          <div class="rv-referral__actions">
            <button type="button" class="ma-btn" id="rvReferralShare" data-share-text="<%= String(_ref.smsText || '').replace(/"/g, '&quot;') %>" data-share-url="<%= String(_ref.url).replace(/"/g, '&quot;') %>" data-share-title="<%= String(member.companyName || '').replace(/"/g, '&quot;') %>"<%= _ref.preview ? ' disabled' : '' %>><%= _ref.buttonLabel || 'Share' %></button>
            <button type="button" class="ma-btn ma-btn--soft" id="rvReferralCopy" data-copy="<%= String(_ref.url).replace(/"/g, '&quot;') %>"<%= _ref.preview ? ' disabled' : '' %>>Copy link</button>
          </div>
          <script>
          (function () {
            function copyText(t, btn, label) {
              if (!t) return;
              var done = function () {
                if (!btn) return;
                var prev = btn.textContent;
                btn.textContent = label || 'Copied';
                setTimeout(function () { btn.textContent = prev; }, 1600);
              };
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(t).then(done).catch(function () {});
              } else {
                var ta = document.createElement('textarea');
                ta.value = t; document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta); done();
              }
            }
            var copyBtn = document.getElementById('rvReferralCopy');
            if (copyBtn) {
              copyBtn.addEventListener('click', function () {
                copyText(copyBtn.getAttribute('data-copy') || '', copyBtn, 'Copied');
              });
            }
            var shareBtn = document.getElementById('rvReferralShare');
            if (shareBtn && !shareBtn.disabled) {
              shareBtn.addEventListener('click', function () {
                var url = shareBtn.getAttribute('data-share-url') || '';
                var text = shareBtn.getAttribute('data-share-text') || url;
                var title = shareBtn.getAttribute('data-share-title') || '';
                if (navigator.share) {
                  navigator.share({ title: title, text: text, url: url }).catch(function () {
                    copyText(text || url, shareBtn, 'Copied');
                  });
                  return;
                }
                var sms = 'sms:&body=' + encodeURIComponent(text || url);
                try { window.location.href = sms; } catch (e) {
                  copyText(text || url, shareBtn, 'Copied');
                }
              });
            }
          })();
          </script>
        </section>
        <% } %>
        <% if (destinations.length) { %>
        <p class="ma-hint" style="text-align:center;margin:<%= _ref && _ref.url ? '18px' : '0' %> 0 0">Leave a quick public review:</p>
        <div class="rv-links">
          <% destinations.forEach(function (d) { %>
          <a class="rv-link" href="<%= d.href %>" rel="noopener"><span class="rv-link__icon" style="background: <%= d.tile || d.color %>"><% if (d.icon) { %><%- d.icon %><% } else { %><%= d.letter %><% } %></span>Review us on <%= d.label %><span class="rv-link__go">›</span></a>
          <% }); %>
        </div>
        <% } else if (!(_ref && _ref.url)) { %>
        <p class="ma-hint" style="text-align:center">Thanks for the stars!</p>
        <% } %>
        <details style="margin-top:16px">
          <summary class="ma-hint" style="cursor:pointer;text-align:center">Something we could do better? Tell us privately</summary>
          <%- include('member_app/_review_feedback_form', { feedbackAction: _feedbackAction }) %>
        </details>
      </div>
      <% } else if (gate.stage === 'unhappy') { %>
      <div class="rv-panel">
        <p class="ma-hint" style="text-align:center;margin-bottom:10px">Tell the owner what happened. It goes straight to them.</p>
        <%- include('member_app/_review_feedback_form', { feedbackAction: _feedbackAction }) %>
        <% if (destinations.length) { %>
        <p class="ma-hint" style="text-align:center;margin-top:18px">Prefer to post a public review?</p>
        <div class="rv-links rv-links--quiet">
          <% destinations.forEach(function (d) { %>
          <a class="rv-link" href="<%= d.href %>" rel="noopener"><span class="rv-link__icon" style="background: <%= d.tile || d.color %>"><% if (d.icon) { %><%- d.icon %><% } else { %><%= d.letter %><% } %></span><%= d.label %><span class="rv-link__go">›</span></a>
          <% }); %>
        </div>
        <% } %>
      </div>
      <% } else if (destinations.length) { %>
      <div class="rv-panel">
        <p class="ma-hint" style="text-align:center">Or go straight to a review site:</p>
        <div class="rv-links rv-links--quiet">
          <% destinations.forEach(function (d) { %>
          <a class="rv-link" href="<%= d.href %>" rel="noopener"><span class="rv-link__icon" style="background: <%= d.tile || d.color %>"><% if (d.icon) { %><%- d.icon %><% } else { %><%= d.letter %><% } %></span><%= d.label %><span class="rv-link__go">›</span></a>
          <% }); %>
        </div>
      </div>
      <% } %>
    <% } %>

    <p class="rv-foot"><%= brand.appName %> member · <a href="https://adhello.io" rel="noopener">AdHello.io</a></p>
  </main>
</body>
</html>
