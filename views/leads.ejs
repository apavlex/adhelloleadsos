<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-cream min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white px-3 py-1 rounded-full border border-brand-border shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted">Lead Management</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          Saved <span class="text-brand-muted">Leads</span>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          You have <%= leads.length %> bookmarked lead<%= leads.length !== 1 ? 's' : '' %> in your collection.
        </p>
      </div>
      <a href="/" class="btn-pill btn-primary">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Find More Leads
      </a>
    </div>

    <% if (leads.length > 0) { %>
      <!-- Table Card (Full Width) -->
      <div class="brand-card overflow-hidden w-full">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 border-b border-brand-border">
                <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Phone</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Status</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Rating</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Socials</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Saved</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% leads.forEach((lead, i) => { %>
                <tr class="result-row group"
                    data-index="<%= i %>"
                    data-lead-key="<%= lead.key %>"
                    data-title="<%= lead.title %>"
                    data-phone="<%= lead.phone || 'N/A' %>"
                    data-website="<%= lead.website || 'N/A' %>"
                    data-email="<%= lead.email || 'N/A' %>"
                    data-category="<%= lead.categoryName || 'N/A' %>"
                    data-address="<%= lead.address || 'N/A' %>"
                    data-city="<%= lead.city || '' %>"
                    data-rating="<%= lead.totalScore || 0 %>"
                    data-reviews="<%= lead.reviewsCount || 0 %>"
                    data-url="<%= lead.url || '' %>"
                    data-facebook="<%= lead.facebook || 'N/A' %>"
                    data-instagram="<%= lead.instagram || 'N/A' %>"
                    data-twitter="<%= lead.twitter || 'N/A' %>"
                    data-status="<%= lead.status || 'New' %>"
                    data-outreach-prompt="<%= lead.outreachPrompt || '' %>"
                    data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'>
                  <td class="px-8 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark border border-brand-yellow/20 group-hover:bg-brand-yellow group-hover:border-brand-yellow transition-all duration-300">
                        <%= lead.title.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <div class="font-bold text-brand-dark group-hover:text-black transition-colors text-base"><%= lead.title %></div>
                        <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5"><%= lead.categoryName %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= lead.phone && lead.phone !== 'N/A' ? lead.phone : '-' %>
                  </td>
                  <td class="px-6 py-6">
                    <% 
                      let statusClass = 'bg-blue-50 text-blue-600';
                      if (lead.status === 'Contacted') statusClass = 'bg-purple-50 text-purple-600';
                      if (lead.status === 'In Progress') statusClass = 'bg-yellow-50 text-brand-yellow';
                      if (lead.status === 'Closed') statusClass = 'bg-emerald-50 text-emerald-600';
                    %>
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= statusClass %>">
                      <%= lead.status || 'New' %>
                    </span>
                  </td>
                  <td class="px-6 py-6">
                    <% if (lead.totalScore) { %>
                      <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="text-sm font-bold text-brand-dark"><%= Number(lead.totalScore).toFixed(1) %></span>
                        <span class="text-[10px] font-bold text-brand-muted">(<%= lead.reviewsCount %>)</span>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-6">
                    <div class="flex items-center gap-3">
                      <% if (lead.facebook && lead.facebook !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Facebook">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                        </div>
                      <% } %>
                      <% if (lead.instagram && lead.instagram !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Instagram">
                          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
                        </div>
                      <% } %>
                      <% if (lead.twitter && lead.twitter !== 'N/A') { %>
                        <div class="w-6 h-6 text-brand-muted" title="Twitter / X">
                          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z" /></svg>
                        </div>
                      <% } else if (!lead.facebook && !lead.instagram) { %>
                        <span class="text-brand-muted/40 text-sm">-</span>
                      <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= lead.savedAt ? new Date(lead.savedAt).toLocaleDateString() : '-' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" /></svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No saved leads</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">You haven't bookmarked any leads yet. Start searching to build your collection.</p>
        <a href="/" class="btn-pill btn-primary px-10">Start Searching</a>
      </div>
    <% } %>
  </main>

  <!-- Mobile Detail Panel / Desktop Sidebar -->
  <div id="mobilePanel" class="fixed inset-0 z-[100] bg-brand-dark/40 backdrop-blur-sm hidden flex flex-col justify-end lg:flex-row lg:justify-end items-center lg:items-stretch opacity-0 transition-opacity duration-300 pointer-events-none border-l border-brand-border">
    <div class="bg-white w-full lg:w-[550px] rounded-t-[3rem] lg:rounded-none p-10 animate-slide-up lg:animate-slide-in-right pointer-events-auto max-h-[90vh] lg:max-h-screen overflow-y-auto shadow-2xl relative">
      <div class="flex items-center justify-center mb-6">
        <div class="w-12 h-1.5 bg-brand-border rounded-full"></div>
      </div>
      
      <div class="flex items-start justify-between mb-8">
        <div id="mobilePanelAvatar" class="w-16 h-16 bg-brand-yellow rounded-2xl flex items-center justify-center font-display font-extrabold text-2xl shadow-brutal text-brand-dark line-height-1">A</div>
        <button id="closeMobilePanel" class="text-brand-muted hover:text-brand-dark p-2">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <h2 id="mobilePanelTitle" class="font-display font-extrabold text-3xl text-brand-dark mb-1 leading-tight">Company Name</h2>
      <p id="mobilePanelCategory" class="text-sm font-bold text-brand-muted uppercase tracking-widest mb-8">Category</p>

      <!-- Status Selector -->
      <div class="mb-8 p-6 bg-brand-cream rounded-3xl border border-brand-border/50">
        <label class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-3 block">Lead Status</label>
        <select id="leadStatusSelect" class="w-full bg-white border border-brand-border rounded-2xl px-4 py-3 font-bold text-sm focus:ring-2 focus:ring-brand-yellow focus:border-brand-yellow transition-all">
          <option value="New">New</option>
          <option value="Contacted">Contacted</option>
          <option value="In Progress">In Progress</option>
          <option value="Closed">Closed</option>
        </select>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Left: Contact Details -->
        <div class="space-y-4">
          <h3 class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-4">Contact Details</h3>
          <div id="mobilePanelRatingRow" class="flex items-center gap-4 p-4 bg-brand-cream rounded-2xl border border-brand-border/50 hidden">
             <svg class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
             <span id="mobilePanelRating" class="font-bold text-brand-dark text-sm"></span>
          </div>
          <div id="mobilePanelPhoneRow" class="flex items-center gap-4 p-4 bg-brand-cream rounded-2xl border border-brand-border/50 hidden">
             <svg class="w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
             <a id="mobilePanelPhone" href="#" class="font-bold text-brand-dark text-sm"></a>
          </div>
          <div id="mobilePanelFacebookRow" class="flex items-center gap-4 p-4 bg-brand-cream rounded-2xl border border-brand-border/50 hidden">
             <svg class="w-5 h-5 text-brand-muted" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
             <a id="mobilePanelFacebook" href="#" target="_blank" class="font-bold text-brand-dark text-sm truncate">Facebook</a>
          </div>
          <div id="mobilePanelInstagramRow" class="flex items-center gap-4 p-4 bg-brand-cream rounded-2xl border border-brand-border/50 hidden">
             <svg class="w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" /></svg>
             <a id="mobilePanelInstagram" href="#" target="_blank" class="font-bold text-brand-dark text-sm truncate">Instagram</a>
          </div>
          <div id="mobilePanelAddressRow" class="flex items-center gap-4 p-4 bg-brand-cream rounded-2xl border border-brand-border/50 hidden">
             <svg class="w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
             <span id="mobilePanelAddress" class="text-sm font-bold text-brand-dark"></span>
          </div>
        </div>

        <!-- Right: Activity & Prompts -->
        <div class="space-y-6">
          <div class="bg-brand-cream p-6 rounded-3xl border border-brand-border/50">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-4">Outreach Prompt</h3>
            <textarea id="outreachPromptArea" class="w-full h-32 bg-white border border-brand-border rounded-2xl p-4 text-sm font-medium focus:ring-2 focus:ring-brand-yellow focus:border-brand-yellow resize-none mb-3" placeholder="Click generate to create an AI prompt..."></textarea>
            <button id="generatePromptBtn" class="w-full btn-pill btn-primary py-3 text-sm">Generate AI Prompt</button>
          </div>

          <div class="bg-brand-cream p-6 rounded-3xl border border-brand-border/50">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-4">Updates & Notes</h3>
            <div id="activityLog" class="space-y-3 max-h-48 overflow-y-auto mb-4">
              <!-- Updates populated here -->
              <p class="text-[10px] text-brand-muted italic">No activity recorded yet.</p>
            </div>
            <div class="flex gap-2">
              <input type="text" id="noteInput" placeholder="Add a note..." class="flex-1 bg-white border border-brand-border rounded-2xl px-4 py-2 text-sm">
              <button id="addNoteBtn" class="bg-brand-dark text-white rounded-2xl px-4 py-2 text-sm font-bold">Add</button>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <a id="mobilePanelWebsiteBtn" href="#" target="_blank" class="btn-pill bg-white border border-brand-border py-5 text-sm hidden">Visit Website</a>
        <a id="mobilePanelMapsBtn" href="#" target="_blank" class="btn-pill bg-white border border-brand-border py-5 text-sm">View on Maps</a>
      </div>

      <button id="mobilePanelRemoveBtn" class="w-full btn-pill bg-brand-cream border border-brand-border/50 text-red-600 hover:bg-red-50 hover:border-red-200 py-5 text-lg font-bold transition-all">Remove Lead</button>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
