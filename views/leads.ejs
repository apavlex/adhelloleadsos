<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden transition-colors duration-400">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Lead Management</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">
          Saved <span class="text-brand-muted">Leads</span>
        </h1>
        <p class="text-brand-muted font-medium mt-2">
          You have <%= leads.length %> bookmarked lead<%= leads.length !== 1 ? 's' : '' %> in your collection.
        </p>
      </div>
      <a href="/" class="btn-pill btn-primary">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Find More Leads
      </a>
    </div>

    <% if (leads.length > 0) { %>
      <!-- Table Card (Full Width) -->
      <div class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="pl-8 pr-4 py-5 w-10">
                  <div class="flex items-center">
                    <input type="checkbox" id="selectAllLeads" class="w-4 h-4 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer">
                  </div>
                </th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Address</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Phone</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Website</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Reviews</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-center cursor-pointer hover:text-brand-dark transition-colors group" id="sortOpportunity">
                    <div class="flex items-center justify-center gap-1">
                        Opportunity
                        <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </div>
                </th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Status</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-right pr-8">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% leads.forEach((lead, i) => { %>
                <tr class="result-row"
                    data-index="<%= i %>"
                    data-lead-key="<%= lead.key %>"
                    data-title="<%= lead.title %>"
                    data-phone="<%= lead.phone || 'N/A' %>"
                    data-website="<%= lead.website || 'N/A' %>"
                    data-email="<%= lead.email || 'N/A' %>"
                    data-category="<%= lead.categoryName || 'N/A' %>"
                    data-address="<%= lead.address || 'N/A' %>"
                    data-city="<%= lead.city || '' %>"
                    data-rating="<%= lead.totalScore || 0 %>"
                    data-reviews="<%= lead.reviewsCount || 0 %>"
                    data-url="<%= lead.url || '' %>"
                    data-facebook="<%= lead.facebook || 'N/A' %>"
                    data-instagram="<%= lead.instagram || 'N/A' %>"
                    data-twitter="<%= lead.twitter || 'N/A' %>"
                    data-status="<%= lead.status || 'Needs Video' %>"
                    data-loom-url="<%= lead.loomUrl || '' %>"
                    data-outreach-prompt="<%= lead.outreachPrompt || '' %>"
                    data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'
                    data-has-schema-markup="<%= lead.hasSchemaMarkup %>"
                    data-has-chatbot="<%= lead.hasChatbot %>"
                    data-has-click-to-call="<%= lead.hasClickToCall %>"
                    data-is-mobile-friendly="<%= lead.isMobileFriendly %>"
                    data-is-outdated="<%= lead.isOutdated %>"
                    data-visual-modernity-score="<%= lead.visualModernityScore %>"
                    data-aeo-score="<%= lead.aeoScore %>"
                    data-geo-gaps="<%= lead.geoGaps %>"
                    data-audit-summary="<%= lead.auditSummary %>">
                  <td class="pl-8 pr-4 py-6">
                    <div class="flex items-center">
                      <input type="checkbox" class="lead-checkbox w-4 h-4 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer" data-key="<%= lead.key %>">
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark border border-brand-yellow/20 group-hover:bg-brand-yellow group-hover:border-brand-yellow transition-all duration-300">
                        <%= lead.title.charAt(0).toUpperCase() %>
                      </div>
                      <div class="max-w-[180px] truncate">
                        <div class="font-bold text-brand-dark group-hover:text-black transition-colors text-base" title="<%= lead.title %>"><%= lead.title %></div>
                        <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5 truncate" title="<%= lead.categoryName %>"><%= lead.categoryName %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <div class="text-xs font-medium text-brand-muted max-w-[200px] truncate" title="<%= lead.address %>">
                      <%= lead.address && lead.address !== 'N/A' ? lead.address : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= lead.phone && lead.phone !== 'N/A' ? lead.phone : '-' %>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <% if (lead.website && lead.website !== 'N/A') { %>
                      <div class="relative group">
                        <a href="<%= lead.website %>" target="_blank" class="website-link hover:text-brand-dark transition-colors border-b border-transparent hover:border-brand-dark pb-0.5 inline-block max-w-[150px] truncate" title="<%= lead.website %>" data-url="<%= lead.website %>">
                            <%= lead.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                        </a>
                        
                        <!-- AI Website Preview Tooltip -->
                        <div class="website-preview invisible group-hover:visible opacity-0 group-hover:opacity-100 absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-[380px] bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl border border-brand-border/20 dark:border-white/10 p-4 transition-all duration-300 z-[60] pointer-events-none scale-95 group-hover:scale-100 origin-bottom">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3 p-3 bg-brand-yellow/5 dark:bg-brand-yellow/10 rounded-2xl border border-brand-yellow/20">
                                    <div class="w-8 h-8 rounded-xl bg-brand-yellow flex items-center justify-center text-brand-dark">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
                                    </div>
                                    <div class="flex-1 min-w-0 text-left">
                                        <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-0.5">AI Audit Summary</div>
                                        <div class="text-[11px] font-bold text-brand-dark dark:text-white leading-tight truncate audit-summary-text">Run enhancement to unlock audit...</div>
                                    </div>
                                </div>
                                <div class="w-full aspect-video rounded-xl bg-brand-cream dark:bg-slate-800 overflow-hidden relative border border-brand-border/10">
                                    <iframe src="about:blank" data-src="<%= lead.website %>" class="w-[1280px] h-[720px] scale-[0.27] origin-top-left border-none opacity-0 transition-opacity duration-700"></iframe>
                                    <div class="absolute inset-0 flex items-center justify-center bg-brand-cream/80 dark:bg-slate-800/80 backdrop-blur-sm iframe-loader">
                                        <div class="w-6 h-6 border-2 border-brand-yellow border-t-transparent rounded-full animate-spin"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-white dark:bg-slate-900 border-r border-b border-brand-border/20 dark:border-white/10 rotate-45"></div>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 font-bold text-sm">-</span>
                    <% } %>
                  </td>
                  <!-- New Rating Column -->
                  <td class="px-6 py-6">
                    <% if (lead.totalScore) { %>
                      <div class="flex flex-col gap-1">
                        <div class="row-stars flex items-center gap-0.5"></div>
                        <div class="flex items-center gap-1.5">
                          <span class="text-[11px] font-black text-brand-dark dark:text-slate-200"><%= Number(lead.totalScore).toFixed(1) %></span>
                          <span class="text-[9px] font-bold text-brand-muted/60">(<%= lead.reviewsCount %>)</span>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 text-sm font-bold">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-6">
                    <div class="opportunity-badge flex flex-wrap gap-1 items-center justify-center min-h-[32px]" data-score="0">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow animate-pulse"></span>
                        <span class="text-[9px] font-black text-brand-muted uppercase tracking-widest leading-none">Veting...</span>
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <% 
                      let statusClass = 'bg-gray-100 text-gray-500';
                      if (lead.status === 'Video Recorded') statusClass = 'bg-brand-yellow text-brand-dark';
                      if (lead.status === 'Email Sent') statusClass = 'bg-blue-50 text-blue-600';
                      if (lead.status === 'Follow-up') statusClass = 'bg-purple-50 text-purple-600';
                      if (lead.status === 'Closed - Won') statusClass = 'bg-emerald-50 text-emerald-600';
                      if (lead.status === 'Closed - Lost') statusClass = 'bg-red-50 text-red-600';
                    %>
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= statusClass %> whitespace-nowrap">
                      <%= lead.status || 'Needs Video' %>
                    </span>
                  </td>
                  <td class="px-6 py-6 text-right pr-8">
                    <div class="flex items-center justify-end gap-2 text-center">
                       <% if (lead.email && lead.email !== 'N/A') { %>
                        <button class="quick-outreach-btn w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow hover:text-brand-dark transition-all" 
                          data-email="<%= lead.email %>" data-company="<%= lead.title %>" title="Quick Email Outreach">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </button>
                      <% } %>
                       <button class="view-detail-btn w-8 h-8 rounded-lg hover:bg-brand-yellow/10 text-brand-muted hover:text-brand-yellow transition-all flex items-center justify-center border border-transparent hover:border-brand-yellow/20">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
                       </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bulk Action Bar -->
      <div id="bulkActionBar" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-brand-dark text-white px-8 py-5 rounded-[2.5rem] shadow-2xl z-[150] flex items-center gap-8 opacity-0 translate-y-20 pointer-events-none transition-all duration-500 backdrop-blur-xl border border-white/10">
        <div class="flex items-center gap-4 border-r border-white/10 pr-8">
            <div id="selectedCountCircle" class="w-10 h-10 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-sm shadow-lg">0</div>
            <div class="text-sm font-bold text-white/90">Leads Selected</div>
        </div>
        
        <div class="flex items-center gap-4">
            <button id="bulkEnhanceBtn" class="flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-yellow transition-all group overflow-hidden relative">
               <svg class="w-4 h-4 text-brand-yellow group-hover:animate-sparkle" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.25 15L18 16.125l-.25-1.125a1.125 1.125 0 00-.75-.75L15.875 14l1.125-.25a1.125 1.125 0 00.75-.75L18 11.875l.25 1.125a1.125 1.125 0 00.75.75l1.125.25-1.125.25a1.125 1.125 0 00-.75.75z" /></svg>
               <span class="text-xs font-black uppercase tracking-widest">Enhance</span>
            </button>
            <button id="bulkExportBtn" class="flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-400 transition-all group">
               <svg class="w-4 h-4 text-blue-400 group-hover:translate-y-[-2px] transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
               <span class="text-xs font-black uppercase tracking-widest">Export CSV</span>
            </button>
            
            <div class="w-px h-6 bg-white/10"></div>
            
            <button id="cancelSelectionBtn" class="text-xs font-bold text-white/50 hover:text-white transition-colors uppercase tracking-widest">Cancel</button>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" /></svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No saved leads</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">You haven't bookmarked any leads yet. Start searching to build your collection.</p>
        <a href="/" class="btn-pill btn-primary px-10">Start Searching</a>
      </div>
    <% } %>
  </main>

  <!-- Mobile Detail Panel / Desktop Sidebar -->
  <div id="mobilePanel" class="fixed inset-0 z-[100] bg-brand-dark/60 backdrop-blur-md hidden flex flex-col justify-end lg:flex-row lg:justify-end items-center lg:items-stretch opacity-0 transition-opacity duration-300 pointer-events-none">
    <div class="bg-white dark:bg-slate-900 w-full h-full lg:h-screen lg:w-[480px] rounded-none p-8 lg:p-10 animate-slide-up lg:animate-slide-in-right pointer-events-auto overflow-y-auto shadow-2xl relative border-l border-brand-border/20 dark:border-white/5">
      
      <!-- Close/Handle -->
      <div class="flex items-center justify-between mb-8 sticky top-0 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md py-2 z-10 px-1">
        <div class="flex items-center gap-3 flex-1 min-w-0 mr-4">
            <button id="prevLeadBtn" class="w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all group shrink-0">
                <svg class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div id="mobilePanelAvatar" class="w-14 h-14 bg-brand-yellow rounded-2xl flex items-center justify-center font-display font-black text-2xl shadow-brutal text-brand-dark shrink-0">A</div>
            <span id="stickyPanelTitle" class="text-sm font-black text-brand-dark dark:text-white truncate opacity-0 transition-all duration-300 pointer-events-none"></span>
            <button id="nextLeadBtn" class="w-10 h-10 rounded-xl bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all group shrink-0">
                <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>
        <button id="closeMobilePanel" class="w-10 h-10 rounded-full bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted hover:text-brand-dark dark:hover:text-white transition-all transform hover:rotate-90 shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="mb-8">
        <div class="flex flex-col gap-1 mb-4">
        <div class="flex flex-col gap-1 mb-4">
          <div class="flex flex-wrap items-center gap-3 mb-2">
              <div class="flex items-center gap-2 bg-brand-cream/50 dark:bg-white/5 px-3 py-1 rounded-full border border-brand-border/20">
                <div id="mobilePanelStars" class="flex items-center gap-0.5"></div>
                <span id="mobilePanelRatingText" class="text-[10px] font-black text-brand-dark dark:text-slate-300">5.0</span>
              </div>
              <span id="mobilePanelCategory" class="px-3 py-1 rounded-full bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 text-[10px] font-bold uppercase tracking-widest whitespace-nowrap">Category</span>
          </div>
          <h2 id="mobilePanelTitle" class="font-display font-black text-3xl lg:text-4xl text-brand-dark dark:text-white leading-[1.1]">Company Name</h2>
        </div>

        <!-- Quick Contact Info -->
        <div class="flex flex-col gap-2.5 px-1">
          <div id="headerAddressRow" class="flex items-start gap-3 group/item">
            <div class="w-5 h-5 mt-0.5 rounded-md bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted group-hover/item:text-brand-yellow transition-colors">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <span id="mobilePanelHeaderAddress" class="text-sm font-semibold text-brand-muted dark:text-slate-400 leading-tight">Address placeholder</span>
          </div>
          
          <div id="headerPhoneRow" class="flex items-center gap-3 group/item">
            <div class="w-5 h-5 rounded-md bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-brand-muted group-hover/item:text-brand-yellow transition-colors">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2.5 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <a href="#" id="mobilePanelHeaderPhone" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow transition-colors underline decoration-brand-yellow/30 decoration-2 underline-offset-4">Phone placeholder</a>
          </div>

          <!-- Header Socials -->
          <div id="headerSocialsRow" class="flex items-center gap-3 mt-1">
            <div class="flex items-center gap-2" id="mobilePanelHeaderSocials">
                <!-- Social icons injected via JS -->
            </div>
          </div>
        </div>
      </div>

      <!-- AI Opportunity Audit -->
      <section class="mb-10">
        <div class="p-6 bg-brand-dark/5 dark:bg-white/5 rounded-[2.5rem] border border-brand-yellow/30 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:rotate-12 transition-transform duration-500">
                <svg class="w-12 h-12 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.25 15L18 16.125l-.25-1.125a1.125 1.125 0 00-.75-.75L15.875 14l1.125-.25a1.125 1.125 0 00.75-.75L18 11.875l.25 1.125a1.125 1.125 0 00.75.75l1.125.25-1.125.25a1.125 1.125 0 00-.75.75z" /></svg>
            </div>
            <div class="relative z-10">
                <div class="flex items-center gap-2 mb-2">
                    <span id="mobilePanelAuditStatus" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Calculating Opportunity...</span>
                </div>
                <h3 class="text-lg font-black text-brand-dark dark:text-white mb-2 leading-tight">AI Audit Insight</h3>
                <p id="mobilePanelAuditSummary" class="text-xs font-semibold text-brand-muted dark:text-slate-400 leading-relaxed italic">
                    Analyzing this business's digital footprint for GEO and AEO gaps. Run enhancement to unlock deeper insights.
                </p>
            </div>
        </div>
      </section>

      <!-- Technical Health Check -->
      <section class="mb-10">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-6 px-1">Technical Health Check</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="p-4 bg-brand-cream/30 dark:bg-white/5 rounded-3xl border border-brand-border/10">
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-2">Chatbot</div>
                <div id="chatbotStatus" class="text-xs font-bold text-brand-dark dark:text-white">Scanning...</div>
            </div>
            <div class="p-4 bg-brand-cream/30 dark:bg-white/5 rounded-3xl border border-brand-border/10">
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-2">Click-to-Call</div>
                <div id="clickToCallStatus" class="text-xs font-bold text-brand-dark dark:text-white">Scanning...</div>
            </div>
            <div class="p-4 bg-brand-cream/30 dark:bg-white/5 rounded-3xl border border-brand-border/10">
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-2">Mobile Ready</div>
                <div id="mobileFriendlyStatus" class="text-xs font-bold text-brand-dark dark:text-white">Scanning...</div>
            </div>
            <div class="p-4 bg-brand-cream/30 dark:bg-white/5 rounded-3xl border border-brand-border/10">
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-2">GEO Schema</div>
                <div id="schemaStatus" class="text-xs font-bold text-brand-dark dark:text-white">Scanning...</div>
            </div>
        </div>
      </section>

      <!-- Engagement Command Center (Moved here under Technical Health Check) -->
      <section class="mb-10">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-6 px-1 text-center border-t border-brand-border/10 pt-6">Engagement Command Center</h3>
        
        <div class="grid grid-cols-2 gap-4">
            <!-- Phone Action Tile -->
            <div id="mobilePanelPhoneRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <a href="#" id="mobilePanelPhoneLink" class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </a>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Call Lead</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelPhone">Phone</div>
            </div>

            <!-- Email Action Tile -->
            <div id="mobilePanelEmailRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <button class="quick-outreach-btn w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform" id="mobilePanelEmailBtn">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </button>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Send Email</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelEmail">No Email</div>
            </div>

            <!-- Website Action Tile -->
            <div id="mobilePanelWebsiteRow" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <a href="#" id="mobilePanelWebsiteLink" target="_blank" class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                </a>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Visit Site</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelWebsiteShort">Website</div>
            </div>

            <!-- Location Action Tile -->
            <a href="#" id="mobilePanelMapsLink" target="_blank" class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-3xl border border-brand-border/20 dark:border-white/5 flex flex-col items-center text-center group hover:bg-brand-yellow/10 transition-all cursor-pointer">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-brand-yellow shadow-sm border border-brand-border/10 mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <div class="text-[9px] font-black uppercase tracking-widest text-brand-muted/60 mb-1">Map View</div>
                <div class="text-sm font-bold text-brand-dark dark:text-white truncate w-full px-2" id="mobilePanelAddress">Address</div>
            </a>
        </div>
      </section>

      <!-- Action Section: Status & Video -->
      <section class="space-y-4 mb-10">
        <div class="p-6 bg-brand-cream/50 dark:bg-slate-800/50 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm">
            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-4 block">Sales Pipelines State</label>
            <div class="relative">
                <select id="leadStatusSelect" class="w-full bg-white dark:bg-slate-800 border-none rounded-2xl px-5 py-4 font-bold text-sm shadow-sm ring-1 ring-brand-border/50 dark:ring-white/10 focus:ring-2 focus:ring-brand-yellow appearance-none transition-all dark:text-white">
                    <option value="Needs Video">Needs Video</option>
                    <option value="Video Recorded">Video Recorded</option>
                    <option value="Called Lead">Called Lead</option>
                    <option value="Email Sent">Email Sent</option>
                    <option value="Follow-up">Follow-up</option>
                    <option value="Closed - Won">Closed - Won</option>
                    <option value="Closed - Lost">Closed - Lost</option>
                </select>
                <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-brand-muted">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </div>
            </div>
        </div>

        <div class="p-6 bg-brand-cream/50 dark:bg-slate-800/50 rounded-3xl border border-brand-border/40 dark:border-white/5 shadow-sm">
            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-3 flex items-center gap-2 block">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              Quick Pitch Video
            </label>
            <input type="url" id="loomUrlInput" placeholder="Paste Loom link here..." class="w-full bg-white dark:bg-slate-800 border-none rounded-2xl px-5 py-4 font-bold text-sm shadow-sm ring-1 ring-brand-border/50 dark:ring-white/10 focus:ring-2 focus:ring-brand-yellow dark:text-white placeholder:text-brand-muted/40 transition-all">
        </div>
      </section>

      <!-- Outreach Actions -->
      <section class="mb-10">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-6 px-1">Outreach Intelligence</h3>
        <div class="flex flex-col gap-3">
            <button id="draftEmailBtn" class="w-full btn-pill btn-primary py-5 text-sm flex items-center justify-center gap-3 shadow-lg hover:shadow-brand-yellow/30">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Generate Draft Email
            </button>
            <button id="deepEnhanceBtn" class="w-full btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 py-5 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow transition-all flex items-center justify-center gap-3 group">
              <svg class="w-5 h-5 text-brand-yellow group-hover:animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9" /></svg>
              Hunt for more contact data
            </button>
        </div>
      </section>

      <!-- Activity Timeline -->
      <section class="mb-12">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-muted dark:text-slate-500 mb-6 px-1">Activity & History</h3>
        <div id="activityLog" class="space-y-6 relative before:absolute before:left-4 before:top-2 before:bottom-2 before:w-0.5 before:bg-brand-border/40 dark:before:bg-white/10 mb-8">
            <!-- Timeline items will be injected here via JS -->
            <div class="pl-10 text-xs text-brand-muted italic">Initializing timeline...</div>
        </div>
        
        <div class="flex gap-2 p-2 bg-brand-cream/30 dark:bg-white/5 rounded-3xl border border-brand-border/20 dark:border-white/5">
            <input type="text" id="noteInput" placeholder="Add a quick note..." class="flex-1 bg-transparent border-none focus:ring-0 text-sm py-3 px-4 dark:text-white placeholder:text-brand-muted/40">
            <button id="addNoteBtn" class="bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark rounded-2xl px-6 py-2 text-xs font-black uppercase tracking-widest transition-transform hover:scale-95 active:scale-90">Post</button>
        </div>
      </section>

      <!-- Final Actions -->
      <div class="space-y-4 pt-6 border-t border-brand-border/20 dark:border-white/5">
        <button id="mobilePanelRemoveBtn" class="w-full text-center py-4 text-xs font-black uppercase tracking-[0.2em] text-red-500 hover:text-red-600 transition-colors">Discard this Lead</button>
      </div>
    </div>
  </div>

    <!-- Website Preview Tooltip -->
    <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
      <div class="bg-gray-100 dark:bg-slate-800 px-3 py-2 border-b border-gray-200 dark:border-white/5 flex items-center gap-2">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
        </div>
        <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
        <a id="previewNewTabBtn" href="#" target="_blank" class="text-[10px] text-brand-dark dark:text-slate-100 hover:text-brand-yellow flex items-center gap-1 font-bold tracking-wider transition-colors">
           OPEN <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
      <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
        <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
           <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
        <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
      </div>
    </div>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
