<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <!-- SortableJS for Kanban -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <% const _lfs = typeof leadsFilterSuffix !== 'undefined' ? leadsFilterSuffix : ''; %>
    <% const _lf = typeof leadListFilters !== 'undefined' && leadListFilters ? leadListFilters : {}; %>
    <% const _stOpts = typeof pipelineStatusOptions !== 'undefined' && pipelineStatusOptions ? pipelineStatusOptions : []; %>
    <% const _src = typeof sourceFilter !== 'undefined' ? sourceFilter : 'all'; %>
    <% const _hasActiveFilters = _lf && typeof _lf === 'object' && Object.keys(_lf).length > 0; %>
    <% if (typeof importError !== 'undefined' && importError) { %>
      <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4">
        <p class="text-sm font-semibold text-rose-900 dark:text-rose-100">Import failed: <%= importError %></p>
        <a href="/leads" class="mt-2 inline-block text-xs font-black uppercase text-rose-800 dark:text-rose-200 underline">Dismiss</a>
      </div>
    <% } %>
    <% if (typeof importNotice !== 'undefined' && importNotice) { %>
      <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <% const hasRowBreakdown = importNotice.rows != null && importNotice.created != null && importNotice.updated != null; %>
        <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100 max-w-3xl">
          <% if (hasRowBreakdown) { %>
            CSV import finished: <strong><%= importNotice.rows %></strong> rows processed —
            <strong><%= importNotice.created %></strong> new lead<%= importNotice.created === 1 ? '' : 's' %>,
            <strong><%= importNotice.updated %></strong> merged into an existing lead (duplicate email in this workspace).
            <% if (importNotice.skipped > 0) { %> <strong><%= importNotice.skipped %></strong> skipped.<% } %>
            <% if (importNotice.failed > 0) { %> <strong><%= importNotice.failed %></strong> failed.<% } %>
          <% } else { %>
            CSV import finished:
            <strong><%= importNotice.imported %></strong> saved
            <% if (importNotice.skipped > 0) { %>, <strong><%= importNotice.skipped %></strong> skipped<% } %>
            <% if (importNotice.failed > 0) { %>, <strong><%= importNotice.failed %></strong> failed<% } %>.
          <% } %>
        </p>
        <a href="/leads" class="text-xs font-black uppercase text-emerald-800 dark:text-emerald-200 underline shrink-0">Dismiss</a>
      </div>
    <% } %>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Lead Management</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark dark:text-white">
          <span class="text-brand-muted dark:text-slate-500">Leads</span> pipeline
        </h1>
        <% const _wsAll = typeof leadSourceCounts !== 'undefined' && leadSourceCounts ? leadSourceCounts.all : leads.length; %>
        <p class="text-sm font-bold text-brand-muted dark:text-slate-400 mt-2 tabular-nums">
          In view · <%= leads.length %> · Workspace · <%= _wsAll %>
        </p>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mt-3 flex flex-wrap gap-x-4 gap-y-2">
          <a href="/outreach" class="text-brand-yellow hover:underline">Cadences</a>
          <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
          <a href="/workspace/team" class="text-brand-dark dark:text-white hover:underline">Team &amp; assign</a>
          <% } %>
        </p>
        <% if (typeof leadSourceCounts !== 'undefined' && leadSourceCounts) { %>
        <div class="flex flex-wrap gap-2 mt-4" role="tablist" aria-label="Filter by lead source">
          <a href="/leads?source=all<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter === 'undefined' || sourceFilter === 'all') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">All (<%= leadSourceCounts.all %>)</a>
          <a href="/leads?source=cold<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'cold') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Cold (<%= leadSourceCounts.cold %>)</a>
          <a href="/leads?source=inbound<%- _lfs.replace(/&/g, '&amp;') %>" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'inbound') ? 'bg-amber-500 text-white border-amber-500' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted dark:text-slate-300 hover:text-brand-dark dark:hover:text-white' %>">Warm inbound (<%= leadSourceCounts.inbound %>)</a>
        </div>
        <% } %>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <!-- View Toggle -->
        <div class="flex items-center bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-1 shadow-sm mr-2">
            <button id="showTableView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-brand-yellow text-brand-dark shadow-sm">Table</button>
            <button id="showKanbanView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white">Pipeline</button>
        </div>
        <div class="flex flex-col gap-1.5 w-full sm:w-auto shrink-0">
        <form action="/leads/import" method="post" enctype="multipart/form-data" id="leadsCsvImportForm" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
          <label class="relative flex-1 min-w-0 cursor-pointer group">
            <input type="file" id="leadsCsvFile" name="csvfile" accept=".csv,text/csv" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" title="CSV with columns like company_name, phone_number, company_website">
            <span id="leadsCsvLabelWrap" class="flex items-center justify-center gap-2 px-4 py-3 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white shadow-sm group-hover:bg-brand-cream dark:group-hover:bg-slate-800 transition-colors truncate">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
              <span id="leadsCsvLabelText">Import CSV</span>
            </span>
          </label>
          <button type="submit" id="leadsCsvUploadButton" class="btn-pill bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-5 py-3 text-xs font-black uppercase tracking-widest shadow-sm whitespace-nowrap inline-flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-wait" aria-live="polite">
            <svg id="leadsCsvUploadSpinner" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span id="leadsCsvUploadButtonText">Upload</span>
          </button>
        </form>
        <p id="csvFileAttachHint" class="hidden items-center gap-2 text-[10px] font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-widest" role="status" aria-live="polite">
          <svg class="w-3.5 h-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
          <span>File attached</span>
          <span id="csvFileNameDisplay" class="font-mono normal-case tracking-normal text-brand-dark dark:text-white max-w-[200px] sm:max-w-xs truncate"></span>
        </p>
        </div>
        <a href="/leads/find" class="btn-pill btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Find More Leads
        </a>
      </div>
    </div>

    <details class="brand-card dark:bg-slate-900 dark:border-white/10 mb-8 -mt-4 group overflow-hidden" <%= _hasActiveFilters ? 'open' : '' %>>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Search &amp; refine</span>
          <% if (_hasActiveFilters) { %>
          <span class="rounded-full bg-brand-yellow/20 px-2.5 py-0.5 text-[9px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow">Active</span>
          <% } %>
          <span class="text-[11px] text-brand-muted"><%= leads.length %> lead<%= leads.length === 1 ? '' : 's' %> in view</span>
        </div>
        <span class="shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </span>
      </summary>
    <form method="get" action="/leads" class="border-t border-brand-border/40 px-5 pb-5 pt-4 dark:border-white/10 md:px-6 md:pb-6">
      <input type="hidden" name="source" value="<%= _src %>" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
        <div class="lg:col-span-3">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Search</label>
          <input type="search" name="q" value="<%= _lf.q || '' %>" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Company, email, phone, website…" />
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Origin</label>
          <select name="origin" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
            <option value=""<%= !_lf.origin ? ' selected' : '' %>>All origins</option>
            <option value="search"<%= _lf.origin === 'search' ? ' selected' : '' %>>Searched / maps</option>
            <option value="csv"<%= _lf.origin === 'csv' ? ' selected' : '' %>>CSV import</option>
            <option value="manual"<%= _lf.origin === 'manual' ? ' selected' : '' %>>Manual / offline</option>
            <option value="warm"<%= _lf.origin === 'warm' ? ' selected' : '' %>>Warm (inbound)</option>
          </select>
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Added from</label>
          <input type="date" name="addedFrom" value="<%= _lf.addedFrom || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Added to</label>
          <input type="date" name="addedTo" value="<%= _lf.addedTo || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Pipeline stage</label>
          <select name="stage" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
            <option value=""<%= !_lf.stage ? ' selected' : '' %>>All stages</option>
            <% for (let i = 1; i <= 10; i += 1) { %>
            <option value="<%= i %>"<%= String(_lf.stage) === String(i) ? ' selected' : '' %>><%= i %></option>
            <% } %>
          </select>
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Status</label>
          <select name="status" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
            <option value=""<%= !_lf.status ? ' selected' : '' %>>Any status</option>
            <% _stOpts.forEach(function (st) { %>
            <option value="<%= st %>"<%= _lf.status === st ? ' selected' : '' %>><%= st %></option>
            <% }); %>
          </select>
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Min rating</label>
          <input type="number" name="minRating" min="0" max="5" step="0.1" value="<%= _lf.minRating || '' %>" placeholder="0" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
        </div>
        <div class="lg:col-span-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Min reviews</label>
          <input type="number" name="minReviews" min="0" step="1" value="<%= _lf.minReviews || '' %>" placeholder="0" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
        </div>
        <div class="lg:col-span-12 flex flex-wrap gap-2 pt-1">
          <button type="submit" class="btn-pill btn-primary px-6 py-2.5 text-[10px] font-black uppercase tracking-widest">Apply</button>
          <a href="/leads?source=<%= _src %>" class="btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 px-6 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white text-center">Clear filters</a>
        </div>
      </div>
    </form>
    </details>

    <p class="text-[11px] font-medium text-brand-muted/80 dark:text-slate-400 -mt-4 mb-10 max-w-2xl leading-relaxed">
      CSV import maps Agency-style exports (e.g. <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-700 dark:text-slate-200 px-1 rounded">company_name</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-700 dark:text-slate-200 px-1 rounded">company_location</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-700 dark:text-slate-200 px-1 rounded">phone_number</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-700 dark:text-slate-200 px-1 rounded">company_website</code>, emails) into saved leads. Rows with the same email in this workspace merge into one lead.
    </p>

    <%- include('partials/leads_pipeline_core') %>
  </main>
  <%- include('partials/leads_interactive_tail') %>
  <script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      var input = document.getElementById('leadsCsvFile');
      var hint = document.getElementById('csvFileAttachHint');
      var nameEl = document.getElementById('csvFileNameDisplay');
      var labelWrap = document.getElementById('leadsCsvLabelWrap');
      var labelText = document.getElementById('leadsCsvLabelText');
      var form = document.getElementById('leadsCsvImportForm');
      var uploadButton = document.getElementById('leadsCsvUploadButton');
      var uploadSpinner = document.getElementById('leadsCsvUploadSpinner');
      var uploadButtonText = document.getElementById('leadsCsvUploadButtonText');
      if (!input || !hint || !nameEl) return;
      function sync() {
        var f = input.files && input.files[0];
        if (f && f.name) {
          nameEl.textContent = f.name;
          hint.classList.remove('hidden');
          hint.classList.add('flex');
          if (labelWrap) {
            labelWrap.classList.add('border-emerald-500/70', 'dark:border-emerald-400/60', 'ring-2', 'ring-emerald-500/25', 'dark:ring-emerald-400/20');
          }
          if (labelText) labelText.textContent = 'Change file';
        } else {
          nameEl.textContent = '';
          hint.classList.add('hidden');
          hint.classList.remove('flex');
          if (labelWrap) {
            labelWrap.classList.remove('border-emerald-500/70', 'dark:border-emerald-400/60', 'ring-2', 'ring-emerald-500/25', 'dark:ring-emerald-400/20');
          }
          if (labelText) labelText.textContent = 'Import CSV';
        }
      }
      input.addEventListener('change', sync);
      sync();
      if (form && uploadButton) {
        form.addEventListener('submit', function () {
          uploadButton.disabled = true;
          uploadButton.setAttribute('aria-busy', 'true');
          if (uploadSpinner) {
            uploadSpinner.classList.remove('hidden');
          }
          if (uploadButtonText) {
            uploadButtonText.textContent = 'Uploading...';
          }
        });
      }
    });
  })();
  </script>
  <script src="/js/app.js"></script>
</body>
</html>
