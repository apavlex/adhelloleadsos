<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <!-- SortableJS for Kanban -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden transition-colors duration-400">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <% if (typeof importError !== 'undefined' && importError) { %>
      <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4">
        <p class="text-sm font-semibold text-rose-900 dark:text-rose-100">Import failed: <%= importError %></p>
        <a href="/leads" class="mt-2 inline-block text-xs font-black uppercase text-rose-800 dark:text-rose-200 underline">Dismiss</a>
      </div>
    <% } %>
    <% if (typeof importNotice !== 'undefined' && importNotice) { %>
      <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">
          CSV import finished:
          <strong><%= importNotice.imported %></strong> saved
          <% if (importNotice.skipped > 0) { %>, <strong><%= importNotice.skipped %></strong> skipped<% } %>
          <% if (importNotice.failed > 0) { %>, <strong><%= importNotice.failed %></strong> failed<% } %>.
        </p>
        <a href="/leads" class="text-xs font-black uppercase text-emerald-800 dark:text-emerald-200 underline shrink-0">Dismiss</a>
      </div>
    <% } %>
    <%- include('partials/flow-coach') %>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Lead Management</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark dark:text-white">
          <span class="text-brand-muted">Leads</span> pipeline
        </h1>
        <p class="text-brand-muted font-medium mt-2 max-w-xl">
          One board for <strong class="text-brand-dark dark:text-white">cold + warm</strong> (<%= leads.length %> shown). Drag cards on the <strong class="text-brand-dark dark:text-white">Pipeline</strong> view to move through 10 stages (Niche → … → Referral); table view shows status and source.
        </p>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-3 flex flex-wrap gap-x-4 gap-y-2">
          <a href="/sequences" class="text-brand-yellow hover:underline">Cadence templates</a>
          <a href="/activation" class="text-violet-600 dark:text-violet-300 hover:underline">7-day plan</a>
          <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
          <a href="/workspace" class="text-brand-dark dark:text-white hover:underline">Team &amp; assign</a>
          <% } %>
        </p>
        <% if (typeof leadSourceCounts !== 'undefined' && leadSourceCounts) { %>
        <div class="flex flex-wrap gap-2 mt-4" role="tablist" aria-label="Filter by lead source">
          <a href="/leads?source=all" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter === 'undefined' || sourceFilter === 'all') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted hover:text-brand-dark' %>">All (<%= leadSourceCounts.all %>)</a>
          <a href="/leads?source=cold" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'cold') ? 'bg-brand-dark text-white border-brand-dark dark:bg-white dark:text-slate-900' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted hover:text-brand-dark' %>">Cold (<%= leadSourceCounts.cold %>)</a>
          <a href="/leads?source=inbound" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border transition-colors <%= (typeof sourceFilter !== 'undefined' && sourceFilter === 'inbound') ? 'bg-amber-500 text-white border-amber-500' : 'bg-white dark:bg-slate-900 border-brand-border text-brand-muted hover:text-brand-dark' %>">Warm inbound (<%= leadSourceCounts.inbound %>)</a>
        </div>
        <% } %>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <!-- View Toggle -->
        <div class="flex items-center bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-1 shadow-sm mr-2">
            <button id="showTableView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-brand-yellow text-brand-dark shadow-sm">Table</button>
            <button id="showKanbanView" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-brand-muted hover:text-brand-dark">Pipeline</button>
        </div>
        <form action="/leads/import" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
          <label class="relative flex-1 min-w-0 cursor-pointer group">
            <input type="file" name="csvfile" accept=".csv,text/csv" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" title="CSV with columns like company_name, phone_number, company_website">
            <span class="flex items-center justify-center gap-2 px-4 py-3 rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white shadow-sm group-hover:bg-brand-cream dark:group-hover:bg-slate-800 transition-colors truncate">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
              Import CSV
            </span>
          </label>
          <button type="submit" class="btn-pill bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-5 py-3 text-xs font-black uppercase tracking-widest shadow-sm whitespace-nowrap">Upload</button>
        </form>
        <a href="/" class="btn-pill btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Find More Leads
        </a>
      </div>
    </div>
    <p class="text-[11px] font-medium text-brand-muted/80 -mt-8 mb-10 max-w-2xl">
      CSV import maps Agency-style exports (e.g. <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">company_name</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">company_location</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">phone_number</code>, <code class="text-[10px] bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">company_website</code>, emails) into saved leads. Rows with the same email merge with an existing lead.
    </p>

    <% if (leads.length > 0) { %>
      <!-- Bulk Actions Bar (for Leads) -->
      <div id="bulkActions" class="hidden items-center gap-3 mb-6 bg-white dark:bg-slate-900 p-3 rounded-2xl border border-brand-border dark:border-white/10 shadow-sm">
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-2"><span id="selectedCount" class="text-brand-dark mr-1 text-sm font-black">0</span> SELECTED</span>
        <button id="bulkExportBtn" class="btn-pill bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 text-brand-dark dark:text-slate-100 hover:bg-brand-cream dark:hover:bg-slate-800 px-4 py-2 text-sm font-bold shadow-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Export
        </button>
        <button id="bulkEnhanceBtn" class="btn-pill bg-brand-yellow/10 border border-brand-yellow/30 text-brand-dark hover:bg-brand-yellow px-4 py-2 text-sm font-bold shadow-sm transition-all">
            ✨ Enrich All
        </button>
        <div class="h-6 w-px bg-brand-border/30 mx-2"></div>
        <button id="batchOutreachBtn" class="btn-pill bg-rose-500/10 border border-rose-500/30 text-rose-600 hover:bg-rose-500 hover:text-white px-4 py-2 text-sm font-black uppercase tracking-widest shadow-sm transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
            War Room
        </button>
      </div>      <!-- Table View Section -->
      <div id="tableView" class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/50 dark:bg-white/5 border-b border-brand-border dark:border-white/10">
                <th class="pl-8 pr-4 py-5 w-10">
                  <div class="flex items-center">
                    <input type="checkbox" id="selectAllLeads" class="w-4 h-4 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer">
                  </div>
                </th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Company</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Pipeline</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Address</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Phone</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Website</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Reviews</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-center cursor-pointer hover:text-brand-dark transition-colors group" id="sortOpportunity">
                    <div class="flex items-center justify-center gap-1">
                        Opportunity
                        <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </div>
                </th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted">Status</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-widest text-brand-muted text-right pr-8">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/50">
              <% leads.forEach((lead, i) => { %>
                <% const _ps = parseInt(lead.pipelineStage, 10); %>
                <% const psRow = !Number.isNaN(_ps) && _ps >= 1 && _ps <= 10 ? _ps : 1; %>
                <% const stRow = (typeof pipelineStages !== 'undefined' && pipelineStages) ? pipelineStages.find((s) => s.id === psRow) : null; %>
                <% const pipeName = stRow ? stRow.name.replace(/\s*\(.*$/, '').trim() : 'Stage'; %>
                <% const pipeShort = pipeName.length > 26 ? pipeName.slice(0, 26) + '…' : pipeName; %>
                <% const rowAnchor = String(lead.key || '').replace(/[^a-z0-9]+/gi, '-'); %>
                <tr class="result-row scroll-mt-28"
                    id="lead-row-<%= rowAnchor %>"
                    data-index="<%= i %>"
                    data-lead-key="<%= lead.key %>"
                    data-pipeline-stage="<%= psRow %>"
                    data-pipeline-label="<%= pipeShort.replace(/"/g, '&quot;') %>"
                    data-title="<%= lead.title %>"
                    data-phone="<%= lead.phone || 'N/A' %>"
                    data-website="<%= lead.website || 'N/A' %>"
                    data-email="<%= lead.email || 'N/A' %>"
                    data-category="<%= lead.categoryName || 'N/A' %>"
                    data-address="<%= lead.address || 'N/A' %>"
                    data-city="<%= lead.city || '' %>"
                    data-rating="<%= lead.totalScore || 0 %>"
                    data-reviews="<%= lead.reviewsCount || 0 %>"
                    data-url="<%= lead.url || '' %>"
                    data-facebook="<%= lead.facebook || 'N/A' %>"
                    data-instagram="<%= lead.instagram || 'N/A' %>"
                    data-twitter="<%= lead.twitter || 'N/A' %>"
                    data-status="<%= lead.status || 'Needs Video' %>"
                    data-loom-url="<%= lead.loomUrl || '' %>"
                    data-outreach-prompt="<%= lead.outreachPrompt || '' %>"
                    data-updates='<%= JSON.stringify(lead.updates || []).replace(/'/g, "&apos;") %>'
                    data-has-schema-markup="<%= lead.hasSchemaMarkup %>"
                    data-has-chatbot="<%= lead.hasChatbot %>"
                    data-has-click-to-call="<%= lead.hasClickToCall %>"
                    data-is-mobile-friendly="<%= lead.isMobileFriendly %>"
                    data-is-outdated="<%= lead.isOutdated %>"
                    data-visual-modernity-score="<%= lead.visualModernityScore %>"
                    data-aeo-score="<%= lead.aeoScore %>"
                    data-geo-gaps="<%= lead.geoGaps %>"
                    data-audit-summary="<%= lead.auditSummary %>"
                    data-cms-platform="<%= lead.cmsPlatform || '' %>"
                    data-buying-signals='<%= JSON.stringify(lead.buyingSignals || []).replace(/'/g, "&apos;") %>'
                    data-source="<%= lead.source || 'manual' %>"
                    data-audit-data='<%= JSON.stringify(lead.auditData || null).replace(/'/g, "&apos;") %>'
                    data-chat-history='<%= JSON.stringify(lead.chatHistory || null).replace(/'/g, "&apos;") %>'
                    data-stitch-design-url="<%= lead.stitchDesignUrl || '' %>"
                    data-stitch-screenshot-url="<%= lead.stitchScreenshotUrl || '' %>"
                    data-stitch-screen-id="<%= lead.stitchScreenId || '' %>">
                  <td class="pl-8 pr-4 py-6">
                    <div class="flex items-center">
                      <input type="checkbox" class="lead-checkbox w-4 h-4 rounded-md border-brand-border text-brand-yellow focus:ring-brand-yellow transition-all cursor-pointer" data-key="<%= lead.key %>">
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark border border-brand-yellow/20 group-hover:bg-brand-yellow group-hover:border-brand-yellow transition-all duration-300">
                        <%= lead.title.charAt(0).toUpperCase() %>
                      </div>
                      <div class="max-w-[180px] truncate">
                        <div class="font-bold text-brand-dark group-hover:text-black transition-colors text-base" title="<%= lead.title %>"><%= lead.title %></div>
                        <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                          <% if (lead.source && lead.source.startsWith('adhello_')) { %>
                            <span class="text-[9px] font-black uppercase tracking-widest text-amber-600 dark:text-amber-400">Warm</span>
                          <% } else { %>
                            <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Cold</span>
                          <% } %>
                          <span class="text-[10px] font-bold text-brand-muted uppercase tracking-wider truncate" title="<%= lead.categoryName %>"><%= lead.categoryName %></span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6 pipeline-stage-cell align-top">
                    <a href="/sales/workflow" class="inline-flex flex-col gap-0.5 group/pipe" title="Edit stage on workflow page">
                      <span class="pipeline-stage-label text-[10px] font-black text-brand-yellow"><%= psRow %>. <%= pipeShort %></span>
                      <span class="text-[9px] font-bold text-brand-muted group-hover/pipe:underline">Command Center →</span>
                    </a>
                  </td>
                  <td class="px-6 py-6">
                    <div class="text-xs font-medium text-brand-muted max-w-[200px] truncate" title="<%= lead.address %>">
                      <%= lead.address && lead.address !== 'N/A' ? lead.address : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <%= lead.phone && lead.phone !== 'N/A' ? lead.phone : '-' %>
                  </td>
                  <td class="px-6 py-6 text-sm font-medium text-brand-muted">
                    <% if (lead.website && lead.website !== 'N/A') { %>
                      <a href="<%= lead.website %>" target="_blank" class="website-link hover:text-brand-dark transition-colors border-b border-transparent hover:border-brand-dark pb-0.5 inline-block max-w-[150px] truncate" title="<%= lead.website %>" data-url="<%= lead.website %>">
                          <%= lead.website.replace(/^https?:\/\//, '').split('?')[0].replace(/\/$/, '') %>
                      </a>
                    <% } else { %>
                      <span class="text-brand-muted/40 font-bold text-sm">-</span>
                    <% } %>
                  </td>
                  <!-- New Rating Column -->
                  <td class="px-6 py-6">
                    <% if (lead.totalScore) { %>
                      <div class="flex flex-col gap-1">
                        <div class="row-stars flex items-center gap-0.5"></div>
                        <div class="flex items-center gap-1.5">
                          <span class="text-[11px] font-black text-brand-dark dark:text-slate-200"><%= Number(lead.totalScore).toFixed(1) %></span>
                          <span class="text-[9px] font-bold text-brand-muted/60">(<%= lead.reviewsCount %>)</span>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-brand-muted/40 text-sm font-bold">-</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-6">
                    <div class="opportunity-badge flex flex-wrap gap-1 items-center justify-center min-h-[32px]" data-score="0">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow animate-pulse"></span>
                        <span class="text-[9px] font-black text-brand-muted uppercase tracking-widest leading-none">Vetting...</span>
                    </div>
                  </td>
                  <td class="px-6 py-6">
                    <% 
                      let statusClass = 'bg-gray-100 text-gray-500';
                      if (lead.status === 'Video Recorded') statusClass = 'bg-brand-yellow text-brand-dark';
                      if (lead.status === 'Email Sent') statusClass = 'bg-blue-50 text-blue-600';
                      if (lead.status === 'Follow-up') statusClass = 'bg-purple-50 text-purple-600';
                      if (lead.status === 'Closed - Won') statusClass = 'bg-emerald-50 text-emerald-600';
                      if (lead.status === 'Closed - Lost') statusClass = 'bg-red-50 text-red-600';
                    %>
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= statusClass %> whitespace-nowrap">
                      <%= lead.status || 'Needs Video' %>
                    </span>
                  </td>
                  <td class="px-6 py-6 text-right pr-8">
                    <div class="flex items-center justify-end gap-2 text-center">
                       <% if (lead.email && lead.email !== 'N/A') { %>
                        <button class="quick-outreach-btn w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 flex items-center justify-center hover:bg-brand-yellow hover:text-brand-dark transition-all" 
                          data-email="<%= lead.email %>" data-company="<%= lead.title %>" title="Quick Email Outreach">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </button>
                      <% } %>
                       <button class="view-detail-btn w-8 h-8 rounded-lg hover:bg-brand-yellow/10 text-brand-muted hover:text-brand-yellow transition-all flex items-center justify-center border border-transparent hover:border-brand-yellow/20">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
                       </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pipeline board: 10-stage methodology (drag cards between columns to update pipelineStage) -->
      <div id="kanbanView" class="hidden w-full overflow-x-auto pb-12 custom-scrollbar" data-kanban-mode="pipeline">
          <p class="text-xs text-brand-muted mb-4 max-w-3xl">Drag a card to another column to update its <strong class="text-brand-dark dark:text-white">pipeline stage</strong>. Delivery status (Needs Video, etc.) stays in table view — use your CRM column for fulfillment.</p>
          <div class="flex gap-4 min-w-max pb-2">
              <% if (typeof pipelineStages !== 'undefined' && pipelineStages) { pipelineStages.forEach((col) => { %>
              <div class="kanban-column w-[min(100vw-2rem,17rem)] shrink-0 flex flex-col gap-3" data-pipeline-stage="<%= col.id %>">
                  <div class="flex items-center justify-between px-1 mb-1">
                      <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white leading-tight"><%= col.id %>. <%= col.name %></h3>
                      <span class="px-2 py-0.5 rounded-full bg-brand-cream dark:bg-slate-800 text-[10px] font-bold text-brand-muted column-count">0</span>
                  </div>
                  <div class="kanban-list min-h-[480px] flex flex-col gap-3 p-2 bg-brand-cream/20 dark:bg-white/5 rounded-3xl border border-dashed border-brand-border/40 dark:border-white/10"></div>
              </div>
              <% }); } %>
          </div>
      </div>

      <!-- Bulk Action Bar -->
      <div id="bulkActionBar" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-brand-dark text-white px-8 py-5 rounded-[2.5rem] shadow-2xl z-[150] flex items-center gap-8 opacity-0 translate-y-20 pointer-events-none transition-all duration-500 backdrop-blur-xl border border-white/10">
        <div class="flex items-center gap-4 border-r border-white/10 pr-8">
            <div id="selectedCountCircle" class="w-10 h-10 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center font-black text-sm shadow-lg">0</div>
            <div class="text-sm font-bold text-white/90">Leads Selected</div>
        </div>
        
        <div class="flex items-center gap-4">
            <button id="bulkEnhanceBtn" class="flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-yellow transition-all group overflow-hidden relative">
               <svg class="w-4 h-4 text-brand-yellow group-hover:animate-sparkle" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.091 3.091L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.25 15L18 16.125l-.25-1.125a1.125 1.125 0 00-.75-.75L15.875 14l1.125-.25a1.125 1.125 0 00.75-.75L18 11.875l.25 1.125a1.125 1.125 0 00.75.75l1.125.25-1.125.25a1.125 1.125 0 00-.75.75z" /></svg>
               <span class="text-xs font-black uppercase tracking-widest">Enhance</span>
            </button>
            <button id="bulkExportBtn" class="flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-400 transition-all group">
               <svg class="w-4 h-4 text-blue-400 group-hover:translate-y-[-2px] transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 12L12 16.5m0 0l4.5-4.5M12 16.5V3" /></svg>
               <span class="text-xs font-black uppercase tracking-widest">Export CSV</span>
            </button>
            
            <div class="w-px h-6 bg-white/10"></div>
            
            <button id="cancelSelectionBtn" class="text-xs font-bold text-white/50 hover:text-white transition-colors uppercase tracking-widest">Cancel</button>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" /></svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No saved leads</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">You haven't bookmarked any leads yet. Start searching to build your collection.</p>
        <a href="/" class="btn-pill btn-primary px-10">Start Searching</a>
      </div>
    <% } %>
  </main>  <!-- Mobile Detail Panel / Desktop Sidebar -->
  <%- include('partials/lead_detail_panel') %>

  <script>
    window.INITIAL_SAVED_LEADS = <%- JSON.stringify(leads || []) %>;
    window.PIPELINE_STAGE_LABELS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.name; return m; }, {})) %>;
  </script>
  <!-- The War Room: Batch Outreach Modal -->
  <div id="warRoomModal" class="fixed inset-0 z-[300] hidden overflow-hidden">
    <div class="absolute inset-0 bg-brand-dark/90 backdrop-blur-md transition-opacity"></div>
    <div class="absolute inset-0 flex flex-col p-4 md:p-8">
        <!-- War Room Header -->
        <div class="flex items-center justify-between mb-8 relative z-10">
            <div>
                <h2 class="font-display font-black text-4xl text-white tracking-tight">The War Room</h2>
                <p class="text-brand-muted font-bold uppercase tracking-[0.2em] text-xs">Batch Personalized Outreach</p>
            </div>
            <button id="closeWarRoom" class="w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-rose-500 transition-all border border-white/10">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <!-- War Room Content (Scrollable Grid) -->
        <div id="warRoomGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 overflow-y-auto pb-20 custom-scrollbar pr-2 relative z-10">
            <!-- Cards will be injected via JS -->
        </div>
        <!-- War Room Footer Stats -->
        <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-brand-dark to-transparent pointer-events-none z-20">
            <div class="flex items-center gap-6 pointer-events-auto">
                <div class="bg-white/5 border border-white/10 rounded-2xl px-6 py-4 flex items-center gap-4">
                    <div class="text-3xl font-display font-black text-white" id="warRoomTotal">0</div>
                    <div class="text-[10px] font-bold text-brand-muted uppercase tracking-widest leading-tight">Leads in<br>Queue</div>
                </div>
            </div>
        </div>
    </div>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
  </style>

  <!-- Website Preview Tooltip -->
    <div id="websitePreview" class="fixed hidden z-[200] w-[400px] h-[300px] bg-white dark:bg-slate-900 border border-brand-border dark:border-white/10 rounded-xl shadow-2xl overflow-hidden pointer-events-none transform -translate-x-1/2 -translate-y-full mt-[-15px] transition-opacity duration-200 opacity-0">
      <div class="bg-gray-100 dark:bg-slate-800 px-3 py-2 border-b border-gray-200 dark:border-white/5 flex items-center gap-2">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
        </div>
        <span id="previewUrlText" class="text-[10px] font-bold text-gray-500 truncate flex-1 ml-2 tracking-wide text-left"></span>
        <a id="previewNewTabBtn" href="#" target="_blank" class="text-[10px] text-brand-dark dark:text-slate-100 hover:text-brand-yellow flex items-center gap-1 font-bold tracking-wider transition-colors">
           OPEN <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
      <div class="w-full h-[calc(100%-34px)] relative bg-brand-cream/30 flex items-center justify-center">
        <div id="previewLoading" class="absolute inset-0 flex items-center justify-center text-brand-muted">
           <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
        <iframe id="previewIframe" class="w-full h-full border-0 relative z-10 bg-white" sandbox="allow-same-origin allow-scripts"></iframe>
      </div>
    </div>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
