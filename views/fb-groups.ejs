<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .fb-view-toggle {
      display: flex;
      width: 100%;
      max-width: 28rem;
      border-radius: 0.75rem;
      border: 1px solid var(--brand-border);
      background: rgba(255,255,255,.7);
      overflow: hidden;
    }
    .dark .fb-view-toggle { background: rgba(15,23,42,.55); border-color: rgba(255,255,255,.1); }
    .fb-view-toggle__btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.65rem 0.75rem;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--brand-muted);
      background: transparent;
      border: none;
      cursor: pointer;
      position: relative;
    }
    .fb-view-toggle__btn + .fb-view-toggle__btn { border-left: 1px solid var(--brand-border); }
    .dark .fb-view-toggle__btn + .fb-view-toggle__btn { border-left-color: rgba(255,255,255,.1); }
    .fb-view-toggle__btn svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .fb-view-toggle__btn.is-active { color: #1877F2; background: rgba(24,119,242,.06); }
    .fb-view-toggle__btn.is-active::after {
      content: '';
      position: absolute;
      left: 14%;
      right: 14%;
      bottom: 0;
      height: 3px;
      border-radius: 3px 3px 0 0;
      background: #1877F2;
    }
    #fbGroupsGrid.fb-layout--list {
      grid-template-columns: minmax(0, 1fr) !important;
    }
    #fbGroupsGrid.fb-layout--grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
    @media (min-width: 768px) {
      #fbGroupsGrid.fb-layout--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (min-width: 1280px) {
      #fbGroupsGrid.fb-layout--grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .fb-group-bookmark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      border: 1px solid var(--brand-border);
      background: rgba(255,255,255,.85);
      color: var(--brand-muted);
      cursor: pointer;
      transition: color .15s ease, border-color .15s ease, background .15s ease, transform .15s ease;
    }
    .dark .fb-group-bookmark { background: rgba(15,23,42,.7); border-color: rgba(255,255,255,.12); }
    .fb-group-bookmark:hover { color: var(--brand-yellow); border-color: rgba(255,214,68,.45); transform: translateY(-1px); }
    .fb-group-bookmark.is-on {
      color: #111827;
      background: var(--brand-yellow);
      border-color: var(--brand-yellow);
    }
    .fb-group-bookmark svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .fb-group-bookmark.is-on svg { fill: currentColor; }
    .fb-group-card.is-bookmarked {
      border-color: rgba(255,214,68,.55);
      box-shadow: 0 0 0 1px rgba(255,214,68,.18);
    }
  </style>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Prospecting</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Facebook Groups</h1>
        <p class="text-sm text-brand-muted mt-2 max-w-xl leading-relaxed">Save the groups you prospect in and open them in one click. Educational scripts live on Social Posts → Facebook Groups.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/social-posts?platform=facebook_group" class="btn-pill btn-primary px-4 py-2.5 text-[10px] font-black uppercase tracking-widest">Group scripts</a>
        <a href="/sales/personas/arms-reach" class="btn-pill border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50">Arm's Reach scripts</a>
      </div>
    </div>

    <% if (typeof saveError !== 'undefined' && saveError) { %>
    <div class="mb-6 rounded-2xl border border-red-300/60 bg-red-50/90 dark:bg-red-950/40 dark:border-red-500/30 px-4 py-3 text-sm text-red-900 dark:text-red-100">
      Could not save that URL. Use a valid Facebook group link.
    </div>
    <% } %>
    <% if (typeof notGroupError !== 'undefined' && notGroupError) { %>
    <div class="mb-6 rounded-2xl border border-amber-300/60 bg-amber-50/90 dark:bg-amber-950/40 dark:border-amber-500/30 px-4 py-3 text-sm text-amber-950 dark:text-amber-100">
      That link doesn't look like a Facebook <strong>group</strong>. Paste a URL that includes <code class="text-xs">/groups/</code> (e.g. facebook.com/groups/…).
    </div>
    <% } %>

    <details class="brand-card dark:bg-slate-900 dark:border-white/10 mb-8 group overflow-hidden"<%= (typeof saveError !== 'undefined' && saveError) || (typeof notGroupError !== 'undefined' && notGroupError) ? ' open' : '' %>>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
        <div class="min-w-0 flex-1">
          <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white">Save a group</h2>
          <p class="text-sm text-brand-muted mt-1">Paste a facebook.com/groups/… link to add it to your library.</p>
        </div>
        <span class="shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </span>
      </summary>
      <div class="border-t border-brand-border/40 dark:border-white/10 px-5 pb-5 pt-4 md:px-6 md:pb-6 md:pt-5">
      <form action="/fb-groups/add" method="post" class="space-y-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-6">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupUrl">Group URL</label>
            <input id="fbGroupUrl" name="url" type="text" required maxlength="2048" placeholder="https://www.facebook.com/groups/…" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50" />
          </div>
          <div class="lg:col-span-3">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupTitle">Name (optional)</label>
            <input id="fbGroupTitle" name="title" type="text" maxlength="200" placeholder="Defaults from URL" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
          <div class="lg:col-span-3">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupCategory">Category (optional)</label>
            <input id="fbGroupCategory" name="category" type="text" maxlength="80" placeholder="e.g. Local flooring" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupMembers">Members (optional)</label>
            <input id="fbGroupMembers" name="memberCount" type="text" maxlength="40" placeholder="e.g. 12K or 12,450" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupPrivacy">Privacy</label>
            <select id="fbGroupPrivacy" name="privacy" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white">
              <option value="">Unknown</option>
              <option value="public">Public</option>
              <option value="private">Private</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupLocation">Location (optional)</label>
            <input id="fbGroupLocation" name="location" type="text" maxlength="120" placeholder="e.g. Portland, OR" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupLastPosted">Last posted (optional)</label>
            <input id="fbGroupLastPosted" name="lastPosted" type="text" maxlength="80" placeholder="e.g. 2 days ago or Sep 12" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupAdmin">Owner / admin contact</label>
            <input id="fbGroupAdmin" name="adminContact" type="text" maxlength="200" placeholder="Name, phone, or profile link" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupLastVisited">Last visited (optional)</label>
            <input id="fbGroupLastVisited" name="lastVisited" type="date" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" />
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5" for="fbGroupNote">Note (optional)</label>
          <textarea id="fbGroupNote" name="note" rows="2" maxlength="2000" placeholder="Why this group matters, posting rules, best days…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm text-brand-dark dark:text-white resize-y"></textarea>
        </div>
        <button type="submit" class="btn-pill btn-primary px-8 py-3 text-[10px] font-black uppercase tracking-widest">Save group</button>
      </form>
      </div>
    </details>

    <div class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white">Your groups <span class="text-brand-muted font-semibold text-base">· <%= (groups || []).length %></span></h2>
        <% if (groups && groups.length) { %>
        <div class="fb-view-toggle" role="tablist" aria-label="Group layout">
          <button type="button" class="fb-view-toggle__btn is-active" data-fb-view="list" role="tab" aria-selected="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            List
          </button>
          <button type="button" class="fb-view-toggle__btn" data-fb-view="grid" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Grid
          </button>
        </div>
        <% } %>
      </div>
      <% if (!groups || !groups.length) { %>
      <%- include('partials/empty_state', {
        emptyHeadline: 'No groups saved yet',
        emptyBody: 'Paste a facebook.com/groups/… link above. You can also save the group you’re viewing from the Chrome extension Save tab.',
        emptyCtaHref: '/social-posts',
        emptyCtaLabel: 'Browse educational posts',
        emptySecondaryHref: '/resources',
        emptySecondaryLabel: 'Resources library',
      }) %>
      <% } else { %>
      <div id="fbGroupsGrid" class="grid gap-4 fb-layout--list">
        <% groups.forEach((g) => {
          const _title = String(g.title || '').replace(/^\(\d+\)\s*/, '').replace(/\s*[|·•]\s*Groups\s*[|·•]\s*Facebook\s*$/i, '').replace(/\s*[|·•]\s*Facebook\s*$/i, '').trim() || g.title;
          const _members = g.memberCountLabel || (g.memberCount != null ? Number(g.memberCount).toLocaleString() + ' members' : '');
          const _privacy = g.privacy === 'public' ? 'Public' : g.privacy === 'private' ? 'Private' : '';
          const _added = g.createdAt ? new Date(g.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : '';
          const _visitedTs = g.lastVisited ? Date.parse(g.lastVisited) : NaN;
          const _visited = Number.isFinite(_visitedTs)
            ? new Date(_visitedTs).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })
            : String(g.lastVisited || '').trim();
          const _lastPosted = String(g.lastPosted || '').trim();
          const _admin = String(g.adminContact || '').trim();
          const _visitDateInput = Number.isFinite(_visitedTs) ? new Date(_visitedTs).toISOString().slice(0, 10) : '';
          const _note = String(g.note || '').trim();
          const _notes = Array.isArray(g.notes) && g.notes.length
            ? g.notes
            : (_note ? [{ id: 'legacy', text: _note, createdAt: g.updatedAt || g.createdAt || '' }] : []);
          const _latestNote = _notes[0] || null;
          const _olderNotes = _notes.slice(1);
          const _tags = Array.isArray(g.tags) ? g.tags : [];
          const _bookmarked = g.bookmarked === true || g.bookmarked === 1 || g.bookmarked === '1';
        %>
        <article class="brand-card p-5 dark:bg-slate-900 dark:border-white/10 flex flex-col gap-3 fb-group-card<%= _bookmarked ? ' is-bookmarked' : '' %>">
          <div class="flex items-start justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2 min-w-0">
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-[#1877F2]/15 text-[#1877F2] dark:text-sky-300 border border-[#1877F2]/25 shrink-0">Facebook Group</span>
              <% if (_bookmarked) { %>
              <span class="js-fb-bookmark-badge inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-yellow/25 text-brand-dark dark:text-brand-yellow border border-brand-yellow/40 shrink-0">Bookmarked</span>
              <% } %>
              <% if (_privacy) { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 text-brand-dark dark:text-slate-200 border border-brand-border/40 dark:border-white/10 shrink-0"><%= _privacy %></span>
              <% } %>
              <% if (g.category) { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 text-brand-dark dark:text-slate-200 border border-brand-border/40 dark:border-white/10 shrink-0"><%= g.category %></span>
              <% } %>
              <% _tags.forEach((tag) => { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-yellow/20 text-brand-dark dark:text-brand-yellow border border-brand-yellow/30 shrink-0">#<%= tag %></span>
              <% }); %>
            </div>
            <form action="/fb-groups/<%= encodeURIComponent(g.id) %>/bookmark" method="post" class="shrink-0 js-fb-bookmark-form" data-group-id="<%= g.id %>">
              <button type="submit" class="fb-group-bookmark js-fb-bookmark-btn<%= _bookmarked ? ' is-on' : '' %>" title="<%= _bookmarked ? 'Remove bookmark' : 'Bookmark group' %>" aria-label="<%= _bookmarked ? 'Remove bookmark' : 'Bookmark group' %>" aria-pressed="<%= _bookmarked ? 'true' : 'false' %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>
              </button>
            </form>
          </div>
          <h3 class="font-display font-bold text-base text-brand-dark dark:text-white leading-snug break-words"><%= _title %></h3>
          <dl class="grid grid-cols-1 gap-1.5 text-xs text-brand-muted">
            <% if (_members) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Members</dt><dd class="font-semibold text-brand-dark dark:text-slate-200"><%= _members %></dd></div>
            <% } %>
            <% if (g.location) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Location</dt><dd><%= g.location %></dd></div>
            <% } %>
            <% if (_lastPosted) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Last post</dt><dd><%= _lastPosted %></dd></div>
            <% } %>
            <% if (_visited) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Visited</dt><dd><%= _visited %></dd></div>
            <% } %>
            <% if (_admin) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Admin</dt><dd class="break-words"><%= _admin %></dd></div>
            <% } %>
            <% if (_added) { %>
            <div class="flex gap-2"><dt class="shrink-0 font-black uppercase tracking-wider text-[9px] text-brand-muted/80 w-20">Added</dt><dd><%= _added %></dd></div>
            <% } %>
          </dl>

          <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 space-y-3">
            <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Notes</p>

            <form action="/fb-groups/<%= encodeURIComponent(g.id) %>/notes" method="post" class="space-y-2">
              <input name="tags" type="text" maxlength="200" value="<%= _tags.join(', ') %>" placeholder="Tags (comma-separated)" class="w-full rounded-lg border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-800/70 px-3 py-1.5 text-[11px] text-brand-dark dark:text-white" />
              <textarea name="noteText" rows="2" maxlength="4000" required placeholder="Quick note from prospecting…" class="w-full rounded-lg border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-800/70 px-3 py-2 text-xs text-brand-dark dark:text-white resize-y"></textarea>
              <div class="flex justify-end">
                <button type="submit" class="btn-pill btn-primary px-3 py-1.5 text-[9px] font-black uppercase tracking-widest">Add note</button>
              </div>
            </form>

            <% if (_latestNote) { %>
            <div class="border-t border-brand-border/30 dark:border-white/10 pt-2">
              <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Latest note</p>
              <p class="text-xs text-brand-dark dark:text-slate-200 leading-relaxed whitespace-pre-wrap"><%= _latestNote.text %></p>
              <% if (_latestNote.createdAt) { %>
              <p class="mt-1 text-[9px] font-semibold text-brand-muted"><%= String(_latestNote.createdAt).slice(0, 10) %></p>
              <% } %>
              <% if (_olderNotes.length) { %>
              <details class="mt-2 group/notes">
                <summary class="cursor-pointer list-none text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline [&::-webkit-details-marker]:hidden">View more · <%= _olderNotes.length %> older</summary>
                <ul class="mt-2 space-y-2 max-h-40 overflow-y-auto">
                  <% _olderNotes.forEach((n) => { %>
                  <li class="text-xs text-brand-muted leading-relaxed border-t border-brand-border/30 dark:border-white/10 pt-2">
                    <% if (n.createdAt) { %><p class="text-[9px] font-black uppercase tracking-wider mb-0.5"><%= String(n.createdAt).slice(0, 10) %></p><% } %>
                    <p class="whitespace-pre-wrap text-brand-dark dark:text-slate-200"><%= n.text %></p>
                    <form action="/fb-groups/<%= encodeURIComponent(g.id) %>/notes/<%= encodeURIComponent(n.id) %>/delete" method="post" class="mt-1">
                      <button type="submit" class="text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-rose-600">Delete</button>
                    </form>
                  </li>
                  <% }); %>
                </ul>
              </details>
              <% } %>
            </div>
            <% } %>
          </div>

          <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
            <a href="/fb-groups/<%= encodeURIComponent(g.id) %>/open" target="_blank" rel="noopener noreferrer" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest">Open group</a>
            <button type="button" class="js-fb-copy-url btn-pill border border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white" data-url="<%= g.url %>">Copy URL</button>
            <form action="/fb-groups/<%= encodeURIComponent(g.id) %>/delete" method="post" class="inline" onsubmit="return confirm('Remove this group from your library?');">
              <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-rose-600 px-2 py-2">Remove</button>
            </form>
          </div>
          <details class="mt-1 border-t border-brand-border/40 dark:border-white/10 pt-3 group/edit">
            <summary class="cursor-pointer list-none text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white [&::-webkit-details-marker]:hidden">Edit details</summary>
            <form action="/fb-groups/<%= encodeURIComponent(g.id) %>/update" method="post" class="mt-3 space-y-3">
              <input name="title" type="text" maxlength="200" value="<%= _title %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" placeholder="Group name" />
              <div class="grid grid-cols-2 gap-2">
                <input name="memberCount" type="text" maxlength="40" value="<%= g.memberCount != null ? g.memberCount : '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Members" />
                <select name="privacy" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white">
                  <option value=""<%= !g.privacy ? ' selected' : '' %>>Privacy</option>
                  <option value="public"<%= g.privacy === 'public' ? ' selected' : '' %>>Public</option>
                  <option value="private"<%= g.privacy === 'private' ? ' selected' : '' %>>Private</option>
                </select>
              </div>
              <input name="location" type="text" maxlength="120" value="<%= g.location || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Location" />
              <input name="lastPosted" type="text" maxlength="80" value="<%= _lastPosted %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Last activity seen in group" />
              <input name="adminContact" type="text" maxlength="200" value="<%= _admin %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Owner / admin contact" />
              <input name="lastVisited" type="date" value="<%= _visitDateInput %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" />
              <input name="category" type="text" maxlength="80" value="<%= g.category || '' %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Category" />
              <input name="tags" type="text" maxlength="200" value="<%= _tags.join(', ') %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white" placeholder="Tags (comma-separated)" />
              <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted">Add / update latest note</label>
              <textarea name="note" rows="3" maxlength="2000" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-3 py-2 text-sm text-brand-dark dark:text-white resize-y" placeholder="Posting rules, angle, best days, what to say…"><%= _latestNote ? _latestNote.text : '' %></textarea>
              <button type="submit" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest">Save changes</button>
            </form>
          </details>
        </article>
        <% }); %>
      </div>
      <% } %>
    </div>

    <div class="mb-8">
      <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="font-display font-bold text-base text-brand-dark dark:text-white">Group script pack</h2>
          <p class="text-sm text-brand-muted mt-1">Educational copy for groups and your profile now lives on Social Posts → <strong>Facebook Groups</strong>.</p>
        </div>
        <a href="/social-posts?platform=facebook_group" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest shrink-0 text-center">Open Facebook Groups tab</a>
      </div>
    </div>

    <details class="brand-card dark:bg-slate-900 dark:border-white/10 mb-4 group overflow-hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
        <div class="min-w-0 flex-1">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Optional</p>
          <h2 class="font-display font-bold text-base md:text-lg text-brand-dark dark:text-white">Chrome extension</h2>
          <p class="text-sm text-brand-muted mt-1 max-w-2xl leading-relaxed">
            Install AdHello Leads to save the group you’re viewing, then open it here. Same ZIP + settings as Workspace → Integrations.
          </p>
        </div>
        <span class="shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </span>
      </summary>
      <div class="border-t border-brand-border/40 dark:border-white/10 px-5 pb-5 pt-4 md:px-6 md:pb-6">
        <%- include('partials/chrome_extension_card', { chromeExtensionNested: true }) %>
      </div>
    </details>

    <p id="fbGroupsToast" class="fixed bottom-6 right-6 hidden z-[80] rounded-xl bg-brand-dark text-white dark:bg-white dark:text-slate-900 px-4 py-2.5 text-xs font-bold shadow-lg" role="status"></p>
  </main>

  <%- include('partials/footer') %>
  <script>
  (function () {
    function toast(msg) {
      var el = document.getElementById('fbGroupsToast');
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window.__fbGroupsToastTimer);
      window.__fbGroupsToastTimer = setTimeout(function () {
        el.classList.add('hidden');
      }, 2200);
    }
    function copyText(text) {
      if (!text) return Promise.reject(new Error('empty'));
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise(function (resolve, reject) {
        var ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          resolve();
        } catch (e) {
          reject(e);
        } finally {
          document.body.removeChild(ta);
        }
      });
    }
    document.querySelectorAll('.js-fb-copy-url').forEach(function (btn) {
      btn.addEventListener('click', function () {
        copyText(btn.getAttribute('data-url') || '').then(function () {
          toast('Group URL copied');
        }).catch(function () {
          toast('Could not copy');
        });
      });
    });

    function setBookmarkUi(card, btn, on) {
      if (!card || !btn) return;
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.setAttribute('title', on ? 'Remove bookmark' : 'Bookmark group');
      btn.setAttribute('aria-label', on ? 'Remove bookmark' : 'Bookmark group');
      card.classList.toggle('is-bookmarked', on);
      var badges = card.querySelector('.flex.flex-wrap.items-center.gap-2.min-w-0');
      var badge = card.querySelector('.js-fb-bookmark-badge');
      if (on) {
        if (!badge && badges) {
          badge = document.createElement('span');
          badge.className =
            'js-fb-bookmark-badge inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-brand-yellow/25 text-brand-dark dark:text-brand-yellow border border-brand-yellow/40 shrink-0';
          badge.textContent = 'Bookmarked';
          var after = badges.querySelector('span');
          if (after && after.nextSibling) badges.insertBefore(badge, after.nextSibling);
          else badges.appendChild(badge);
        } else if (badge) {
          badge.classList.remove('hidden');
        }
      } else if (badge) {
        badge.remove();
      }
    }

    function reorderBookmarkedCards() {
      var grid = document.getElementById('fbGroupsGrid');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.fb-group-card'));
      cards.sort(function (a, b) {
        var ba = a.classList.contains('is-bookmarked') ? 1 : 0;
        var bb = b.classList.contains('is-bookmarked') ? 1 : 0;
        return bb - ba;
      });
      cards.forEach(function (card) {
        grid.appendChild(card);
      });
    }

    document.querySelectorAll('.js-fb-bookmark-form').forEach(function (form) {
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var btn = form.querySelector('.js-fb-bookmark-btn');
        var card = form.closest('.fb-group-card');
        if (!btn || btn.disabled) return;
        var nextOn = !btn.classList.contains('is-on');
        setBookmarkUi(card, btn, nextOn);
        reorderBookmarkedCards();
        btn.disabled = true;
        fetch(form.getAttribute('action'), {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({ bookmarked: nextOn ? '1' : '0', ajax: '1' }),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, data: data };
            });
          })
          .then(function (result) {
            if (!result.ok || !result.data || !result.data.success) {
              throw new Error((result.data && result.data.error) || 'Could not update bookmark');
            }
            var serverOn = !!result.data.bookmarked;
            if (serverOn !== nextOn) {
              setBookmarkUi(card, btn, serverOn);
              reorderBookmarkedCards();
            }
            toast(serverOn ? 'Bookmarked' : 'Bookmark removed');
          })
          .catch(function (err) {
            setBookmarkUi(card, btn, !nextOn);
            reorderBookmarkedCards();
            toast((err && err.message) || 'Could not update bookmark');
          })
          .finally(function () {
            btn.disabled = false;
          });
      });
    });

    var FB_VIEW_KEY = 'adhelloFbGroupsView';
    function applyFbGroupsView(view) {
      var next = view === 'grid' ? 'grid' : 'list';
      var grid = document.getElementById('fbGroupsGrid');
      if (grid) {
        grid.classList.toggle('fb-layout--list', next === 'list');
        grid.classList.toggle('fb-layout--grid', next === 'grid');
      }
      document.querySelectorAll('[data-fb-view]').forEach(function (btn) {
        var active = btn.getAttribute('data-fb-view') === next;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      try { localStorage.setItem(FB_VIEW_KEY, next); } catch (_) {}
    }
    (function initFbGroupsView() {
      var saved = 'list';
      try {
        var raw = localStorage.getItem(FB_VIEW_KEY);
        if (raw === 'grid' || raw === 'list') saved = raw;
      } catch (_) {}
      applyFbGroupsView(saved);
      document.querySelectorAll('[data-fb-view]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          applyFbGroupsView(btn.getAttribute('data-fb-view') || 'list');
        });
      });
    })();
  })();
  </script>
</body>
</html>
