<%
  const _tabs = [
    { id: 'all', label: 'All' },
    { id: 'inbound', label: 'Inbound' },
    { id: 'search', label: 'Searches' },
    { id: 'other', label: 'Other' },
  ];
  const _tone = {
    form: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
    missed_call: 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300',
    voicemail: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    call: 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-300',
    sms: 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-300',
    email: 'bg-violet-50 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300',
    search: 'bg-amber-50 dark:bg-amber-900/40 text-brand-yellow',
    search_failed: 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300',
    job: 'bg-amber-50 dark:bg-amber-900/40 text-brand-yellow',
  };
  const _icon = {
    form: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 16h4M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>',
    missed_call: '<path stroke-linecap="round" stroke-linejoin="round" d="M16 3l5 5m0-5l-5 5M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
    call: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
    voicemail: '<circle cx="6.5" cy="12" r="3.5"/><circle cx="17.5" cy="12" r="3.5"/><path stroke-linecap="round" d="M6.5 15.5h11"/>',
    sms: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    email: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4zM4 7l8 6 8-6"/>',
    search: '<circle cx="11" cy="11" r="6"/><path stroke-linecap="round" d="M20 20l-4.5-4.5"/>',
    search_failed: '<circle cx="11" cy="11" r="6"/><path stroke-linecap="round" d="M20 20l-4.5-4.5M9 9l4 4m0-4l-4 4"/>',
    job: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">Notifications</h1>
        <p class="text-brand-muted font-medium mt-2">Inbound leads, calls, texts and emails, finished searches, and background jobs from the last 30 days.</p>
      </div>
      <a href="/history" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow">Search history →</a>
    </div>

    <nav class="flex flex-wrap gap-2 mb-6" aria-label="Filter notifications">
      <% _tabs.forEach(function (t) { const on = kind === t.id; %>
      <a href="/notifications<%= t.id === 'all' ? '' : '?kind=' + t.id %>" class="btn-pill px-4 py-2 text-[10px] font-black uppercase tracking-widest <%= on ? 'btn-primary' : 'border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 text-brand-muted hover:text-brand-yellow' %>" <%= on ? 'aria-current=page' : '' %>>
        <%= t.label %> <span class="tabular-nums opacity-70"><%= counts[t.id] || 0 %></span>
      </a>
      <% }) %>
    </nav>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-4 md:p-6 shadow-sm">
      <% if (!items.length) { %>
      <p class="p-8 text-center text-brand-muted dark:text-slate-500 italic text-sm">No notifications in the last 30 days.</p>
      <% } else { %>
      <ul id="notificationHistoryList">
        <% items.forEach(function (n) { %>
        <li class="py-3 flex items-start gap-3 border-b border-brand-border dark:border-white/10 last:border-0" data-notif-at="<%= n.at %>">
          <span class="shrink-0 mt-0.5 grid place-items-center w-9 h-9 rounded-xl <%= _tone[n.type] || _tone.job %>" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><%- _icon[n.type] || _icon.job %></svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <% if (n.href) { %>
              <a href="<%= n.href %>" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow truncate min-w-0"><%= n.title %></a>
              <% } else { %>
              <span class="text-sm font-bold text-brand-dark dark:text-white truncate min-w-0"><%= n.title %></span>
              <% } %>
              <% if (n.status === 'open') { %><span class="shrink-0 px-1.5 rounded-full bg-brand-yellow text-brand-dark text-[9px] font-black uppercase tracking-widest">Open</span><% } %>
              <% if (n.status === 'handled') { %><span class="shrink-0 text-[9px] font-black uppercase tracking-widest text-brand-muted">Handled</span><% } %>
              <span class="ml-auto text-[10px] font-bold text-brand-muted whitespace-nowrap tabular-nums" title="<%= n.at %>" data-local-time="<%= n.at %>"></span>
            </div>
            <% if (n.body) { %><p class="text-xs text-brand-muted dark:text-slate-400 mt-0.5 line-clamp-2"><%= n.body %></p><% } %>
            <% if (n.href && n.linkLabel) { %>
            <a href="<%= n.href %>" class="inline-block mt-1 text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline"><%= n.linkLabel %> →</a>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </main>
  <script>
    (function () {
      document.querySelectorAll('[data-local-time]').forEach(function (el) {
        var d = new Date(el.getAttribute('data-local-time'));
        if (!isNaN(d)) el.textContent = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      });
      function startOf(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); }
      var today = startOf(new Date());
      var last = '';
      document.querySelectorAll('[data-notif-at]').forEach(function (row) {
        var d = new Date(row.getAttribute('data-notif-at'));
        if (isNaN(d)) return;
        var diff = Math.round((today - startOf(d)) / 86400000);
        var label = diff === 0 ? 'Today' : diff === 1 ? 'Yesterday' : d.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
        if (label === last) return;
        last = label;
        var head = document.createElement('li');
        head.className = 'pt-5 pb-1 text-[10px] font-black uppercase tracking-widest text-brand-muted';
        head.textContent = label;
        row.parentNode.insertBefore(head, row);
      });
    })();
  </script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
