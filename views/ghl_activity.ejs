<%
  const _tone = {
    missed_call: 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300',
    voicemail: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    sms: 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-300',
  };
  const _icon = {
    missed_call: '<path stroke-linecap="round" stroke-linejoin="round" d="M16 3l5 5m0-5l-5 5M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
    voicemail: '<circle cx="6.5" cy="12" r="3.5"/><circle cx="17.5" cy="12" r="3.5"/><path stroke-linecap="round" d="M6.5 15.5h11"/>',
    sms: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  };
  const _items = typeof items !== 'undefined' && Array.isArray(items) ? items : [];
  const _open = typeof openCount === 'number' ? openCount : 0;
  const _total = typeof totalCount === 'number' ? totalCount : _items.length;
  const _linked = typeof ghlLinked !== 'undefined' && ghlLinked;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Go High Level</p>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark">Calls &amp; texts</h1>
        <p class="text-brand-muted font-medium mt-2 max-w-xl">
          Every missed call, voicemail, and SMS from GHL in the last 30 days.
          <% if (_linked) { %>
          <strong class="text-brand-dark dark:text-white font-semibold">Call</strong> opens the contact in Lead Connector so you can dial from the app.
          <% } else { %>
          Connect GHL (Location ID) under Integrations so Call can open Lead Connector.
          <% } %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted tabular-nums"><%= _open %> open · <%= _total %> total</span>
        <a href="/notifications?kind=inbound" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow">All inbound →</a>
      </div>
    </div>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 p-4 md:p-6 shadow-sm">
      <% if (!_items.length) { %>
      <p class="p-8 text-center text-brand-muted dark:text-slate-500 italic text-sm">No missed calls or GHL texts in the last 30 days. Wire the GHL webhook (missed_call / Customer Replied) to start filling this list.</p>
      <% } else { %>
      <ul id="ghlActivityList">
        <% _items.forEach(function (n) {
          const reply = n.type === 'sms';
          const callLabel = reply ? (n.callOpensLeadConnector ? 'Open in Lead Connector' : 'Reply') : (n.callOpensLeadConnector ? 'Call in Lead Connector' : 'Call back');
        %>
        <li class="py-3 flex items-start gap-3 border-b border-brand-border dark:border-white/10 last:border-0" data-ghl-at="<%= n.at %>">
          <span class="shrink-0 mt-0.5 grid place-items-center w-9 h-9 rounded-xl <%= _tone[n.type] || _tone.sms %>" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><%- _icon[n.type] || _icon.sms %></svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2 flex-wrap">
              <a href="<%= n.openHref %>" class="text-sm font-bold text-brand-dark dark:text-white hover:text-brand-yellow truncate min-w-0"><%= n.title %></a>
              <span class="shrink-0 text-[10px] font-bold text-brand-muted"><%= n.typeLabel %><% if (n.label) { %> · <%= n.label %><% } %></span>
              <% if (!n.handled) { %><span class="shrink-0 px-1.5 rounded-full bg-brand-yellow text-brand-dark text-[9px] font-black uppercase tracking-widest">Open</span><% } %>
              <% if (n.handled) { %><span class="shrink-0 text-[9px] font-black uppercase tracking-widest text-brand-muted">Handled</span><% } %>
              <span class="ml-auto text-[10px] font-bold text-brand-muted whitespace-nowrap tabular-nums" title="<%= n.at %>" data-local-time="<%= n.at %>"></span>
            </div>
            <% if (n.phone) { %><p class="text-[11px] text-brand-muted tabular-nums mt-0.5"><%= n.phone %></p><% } %>
            <% if (n.preview) { %><p class="text-xs text-brand-muted dark:text-slate-400 mt-0.5 line-clamp-2"><%= n.preview %></p><% } %>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <a
                href="<%= n.callHref %>"
                class="btn-pill btn-primary px-3 py-1.5 text-[9px] font-black uppercase tracking-widest"
                <% if (n.callExternal) { %>target="_blank" rel="noopener noreferrer"<% } %>
              ><%= callLabel %></a>
              <% if (n.phone && n.callOpensLeadConnector) { %>
              <a href="tel:<%= n.phone %>" class="text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow px-2 py-1">Phone app</a>
              <% } %>
              <a href="<%= n.focusHref %>" class="text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow px-2 py-1">Focus</a>
              <a href="<%= n.openHref %>" class="text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-yellow px-2 py-1">Lead</a>
            </div>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </main>
  <script>
    (function () {
      document.querySelectorAll('[data-local-time]').forEach(function (el) {
        var d = new Date(el.getAttribute('data-local-time'));
        if (!isNaN(d)) el.textContent = d.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      });
      function startOf(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); }
      var today = startOf(new Date());
      var last = '';
      document.querySelectorAll('[data-ghl-at]').forEach(function (row) {
        var d = new Date(row.getAttribute('data-ghl-at'));
        if (isNaN(d)) return;
        var diff = Math.round((today - startOf(d)) / 86400000);
        var label = diff === 0 ? 'Today' : diff === 1 ? 'Yesterday' : d.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
        if (label === last) return;
        last = label;
        var head = document.createElement('li');
        head.className = 'pt-5 pb-1 text-[10px] font-black uppercase tracking-widest text-brand-muted';
        head.textContent = label;
        row.parentNode.insertBefore(head, row);
      });
    })();
  </script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
