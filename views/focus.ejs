    function runFocusOwnerSignalAnalysis(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      var website = lead && lead.website ? String(lead.website).trim() : '';
      if (!website || website === 'N/A' || website === '—') {
        return Promise.reject(new Error('Add a website URL for this lead first.'));
      }
      if (btnOwnerSignalAi) {
        btnOwnerSignalAi.disabled = true;
        btnOwnerSignalAi.setAttribute('aria-busy', 'true');
      }
      setOwnerSignalFeedback('Running AI analysis…', false);
      return focusPostJson('/leads/' + encodeURIComponent(key) + '/ai-analysis', {})
        .then(function (data) {
          if (lead) {
            lead.hasAiWebsiteAnalysis = true;
            if (data && data.ownerSignal) lead.ownerSignal = String(data.ownerSignal).trim();
          }
          syncFocusOwnerSignalUi(lead || {});
          setOwnerSignalFeedback('Owner signal ready.', false);
          return data;
        })
        .catch(function (err) {
          setOwnerSignalFeedback((err && err.message) || 'AI analysis failed.', true);
          throw err;
        })
        .finally(function () {
          if (btnOwnerSignalAi) {
            btnOwnerSignalAi.removeAttribute('aria-busy');
            syncFocusOwnerSignalUi(lead || currentLead());
          }
        });
    }

    function focusEnsureAiWebsiteAnalysis(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      if (focusHasAiWebsiteAnalysis(lead)) return Promise.resolve({ analysis: true });
      var website = lead && lead.website ? String(lead.website).trim() : '';
      if (!website) {
        return Promise.reject(
          new Error('Add a website URL for this lead before generating a hosted audit.'),
        );
      }
      setDeliverablesFeedback('Running AI analysis for hosted audit…');
      return runFocusOwnerSignalAnalysis(lead).then(function (data) {
        setDeliverablesFeedback('');
        return data;
      });
    }

    function focusFetchAuditLink(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      return focusEnsureAiWebsiteAnalysis(lead).then(function () {
        return focusPostJson('/leads/' + encodeURIComponent(key) + '/audit-report-link', {});
      });
    }

    function focusFetchAiToolsLink(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      return focusEnsureAiToolsAssessment(lead).then(function () {
        return focusPostJson('/leads/' + encodeURIComponent(key) + '/ai-tools-report-link', {});
      });
    }

    function focusCopyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
      } finally {
        document.body.removeChild(ta);
      }
      return Promise.resolve();
    }

    function bindFocusDeliverableBtn(id, handler) {
      var btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', function () {
        var lead = currentLead();
        if (!lead || !lead.key) {
          setDeliverablesFeedback('No lead selected.', true);
          return;
        }
        handler(lead, btn);
      });
    }

    bindFocusDeliverableBtn('focus-hosted-audit-open', function (lead) {
      var preTab = window.open('about:blank', '_blank', 'noopener,noreferrer');
      if (preTab) {
        try {
          preTab.document.title = 'Website audit';
          preTab.document.body.innerHTML =
            '<p style="font-family:system-ui,sans-serif;padding:2rem;color:#334155">Loading hosted audit…</p>';
        } catch (_) {}
      }
      setDeliverablesFeedback('Preparing hosted audit…');
      focusFetchAuditLink(lead)
        .then(function (bundle) {
          var url = bundle && bundle.reportUrl ? String(bundle.reportUrl).trim() : '';
          if (!url) throw new Error('No audit link returned');
          if (preTab && !preTab.closed) {
            preTab.opener = null;
            preTab.location.href = url;
          } else if (!window.open(url, '_blank', 'noopener,noreferrer')) {
            throw new Error('Pop-up blocked — allow pop-ups or use Copy audit link.');
          }
          setDeliverablesFeedback('Hosted audit opened — text them the link.');
        })
        .catch(function (err) {
          if (preTab && !preTab.closed) {
            try {
              preTab.close();
            } catch (_) {}
          }
          setDeliverablesFeedback((err && err.message) || 'Could not open hosted audit', true);
        });
    });

