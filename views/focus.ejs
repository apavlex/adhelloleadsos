    function focusFieldEmpty(v) {
      var s = String(v || '').trim();
      return !s || s === 'N/A' || s === '—';
    }

    function focusSocialSummary(lead) {
      if (!lead) return '—';
      var labels = [];
      if (!focusFieldEmpty(lead.url)) labels.push('Google');
      if (!focusFieldEmpty(lead.facebook)) labels.push('Facebook');
      if (!focusFieldEmpty(lead.instagram)) labels.push('Instagram');
      if (!focusFieldEmpty(lead.twitter)) labels.push('X');
      if (!focusFieldEmpty(lead.linkedin)) labels.push('LinkedIn');
      if (!focusFieldEmpty(lead.tiktok)) labels.push('TikTok');
      return labels.length ? labels.join(' · ') : 'No social links';
    }

    function renderFocusContactFields(lead) {
      var addrEl = document.getElementById('focus-header-address');
      var phoneEl = document.getElementById('focus-header-phone');
      var webEl = document.getElementById('focus-header-website');
      var emailEl = document.getElementById('focus-header-email');
      var socialSummary = document.getElementById('focus-header-socials-summary');
      if (!lead) return;
      var parts = [];
      if (!focusFieldEmpty(lead.address)) parts.push(String(lead.address).trim());
      var cityState = [lead.city || '', lead.state || ''].filter(Boolean).join(', ');
      if (cityState) parts.push(cityState);
      if (addrEl) addrEl.textContent = parts.length ? parts.join(' · ') : '—';
      if (phoneEl) phoneEl.textContent = !focusFieldEmpty(lead.phone) ? String(lead.phone).trim() : '—';
      if (webEl) {
        var websiteHref = hrefUrl(lead.website || '');
        if (websiteHref) {
          webEl.href = websiteHref;
          webEl.textContent = cleanUrlLabel(websiteHref);
          webEl.classList.remove('opacity-40', 'pointer-events-none');
        } else {
          webEl.href = '#';
          webEl.textContent = '—';
          webEl.classList.add('opacity-40');
        }
      }
      if (emailEl) {
        var em = !focusFieldEmpty(lead.email) ? String(lead.email).trim() : '';
        if (em) {
          emailEl.href = 'mailto:' + encodeURIComponent(em);
          emailEl.textContent = em;
          emailEl.classList.remove('opacity-40', 'pointer-events-none');
        } else {
          emailEl.href = '#';
          emailEl.textContent = '—';
          emailEl.classList.add('opacity-40');
        }
      }
      if (socialSummary) socialSummary.textContent = focusSocialSummary(lead);
    }

    function setFocusContactEditFeedback(msg, isError) {
      var el = document.getElementById('focus-contact-edit-feedback');
      if (!el) return;
      el.textContent = msg || '';
      el.classList.toggle('text-rose-600', !!isError);
      el.classList.toggle('dark:text-rose-400', !!isError);
      el.classList.toggle('text-brand-muted', !isError);
    }

    function focusNormalizeWebsite(raw) {
      var s = String(raw || '').trim();
      if (!s) return '';
      if (/^https?:\/\//i.test(s)) return s;
      return 'https://' + s.replace(/^\/+/, '');
    }

    function focusNormalizeSocial(raw, platform) {
      var s = String(raw || '').trim();
      if (!s) return '';
      var norm = window.AdhelloSocialUrlNormalize;
      if (norm && typeof norm.normalizeSocialUrl === 'function') {
        return norm.normalizeSocialUrl(s, platform) || s;
      }
      return /^https?:\/\//i.test(s) ? s : s;
    }

    function focusSaveLeadPatch(patch) {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.reject(new Error('No lead loaded.'));
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/update', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(patch || {}),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error((j && j.error) || 'Update failed');
          if (j.lead) {
            Object.keys(j.lead).forEach(function (k) {
              if (j.lead[k] !== undefined && j.lead[k] !== null) lead[k] = j.lead[k];
            });
          } else {
            Object.keys(patch || {}).forEach(function (k) {
              lead[k] = patch[k];
            });
          }
          renderLinks(lead);
          renderBusinessInfo(lead);
          renderFocusContactFields(lead);
          return j;
        });
      });
    }

    var focusContactEditState = { address: false, phone: false, website: false, email: false, socials: false };

    function bindFocusTextFieldEdit(fieldKey, viewId, inputId, btnId, buildPatch) {
      var viewEl = document.getElementById(viewId);
      var inputEl = document.getElementById(inputId);
      var editBtn = document.getElementById(btnId);
      if (!viewEl || !inputEl || !editBtn || editBtn.dataset.focusEditBound === '1') return;
      editBtn.dataset.focusEditBound = '1';

      function showView() {
        focusContactEditState[fieldKey] = false;
        viewEl.classList.remove('hidden');
        inputEl.classList.add('hidden');
      }
      function showEdit() {
        var lead = currentLead();
        if (!lead || !lead.key) {
          setFocusContactEditFeedback('No lead loaded.', true);
          return;
        }
        focusContactEditState[fieldKey] = true;
        if (fieldKey === 'address') {
          var addrParts = [];
          if (!focusFieldEmpty(lead.address)) addrParts.push(String(lead.address).trim());
          var cs = [lead.city || '', lead.state || ''].filter(Boolean).join(', ');
          if (cs) addrParts.push(cs);
          inputEl.value = addrParts.join(', ');
        } else if (fieldKey === 'phone') {
          inputEl.value = !focusFieldEmpty(lead.phone) ? String(lead.phone).trim() : '';
        } else if (fieldKey === 'website') {
          inputEl.value = !focusFieldEmpty(lead.website) ? String(lead.website).trim() : '';
        } else if (fieldKey === 'email') {
          inputEl.value = !focusFieldEmpty(lead.email) ? String(lead.email).trim() : '';
        }
        viewEl.classList.add('hidden');
        inputEl.classList.remove('hidden');
        inputEl.focus();
        inputEl.select();
      }
      function commit() {
        if (!focusContactEditState[fieldKey]) return;
        var val = String(inputEl.value || '').trim();
        var patch = buildPatch(val);
        editBtn.disabled = true;
        focusSaveLeadPatch(patch)
          .then(function () {
            setFocusContactEditFeedback('Saved.');
          })
          .catch(function (err) {
            setFocusContactEditFeedback(err && err.message ? err.message : 'Save failed', true);
          })
          .finally(function () {
            editBtn.disabled = false;
            showView();
          });
      }

      editBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (focusContactEditState[fieldKey]) commit();
        else showEdit();
      });
      inputEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); showView(); }
      });
      inputEl.addEventListener('blur', function () {
        setTimeout(function () {
          if (!focusContactEditState[fieldKey]) return;
          if (document.activeElement === inputEl || document.activeElement === editBtn) return;
          commit();
        }, 160);
      });
    }

    function bindFocusSocialsEdit() {
      var editBtn = document.getElementById('focus-edit-socials-btn');
      var panel = document.getElementById('focus-socials-edit-panel');
      var summary = document.getElementById('focus-header-socials-summary');
      var saveBtn = document.getElementById('focus-socials-save-btn');
      var cancelBtn = document.getElementById('focus-socials-cancel-btn');
      if (!editBtn || !panel || !summary || editBtn.dataset.focusEditBound === '1') return;
      editBtn.dataset.focusEditBound = '1';
      var inputs = {
        url: document.getElementById('focus-social-url-input'),
        facebook: document.getElementById('focus-social-facebook-input'),
        instagram: document.getElementById('focus-social-instagram-input'),
        twitter: document.getElementById('focus-social-twitter-input'),
        linkedin: document.getElementById('focus-social-linkedin-input'),
        tiktok: document.getElementById('focus-social-tiktok-input'),
      };

      function hide() {
        focusContactEditState.socials = false;
        panel.classList.add('hidden');
        summary.classList.remove('hidden');
      }
      function show(e) {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        var lead = currentLead();
        if (!lead || !lead.key) {
          setFocusContactEditFeedback('No lead loaded.', true);
          return;
        }
        focusContactEditState.socials = true;
        if (inputs.url) inputs.url.value = focusFieldEmpty(lead.url) ? '' : String(lead.url).trim();
        if (inputs.facebook) inputs.facebook.value = focusFieldEmpty(lead.facebook) ? '' : String(lead.facebook).trim();
        if (inputs.instagram) inputs.instagram.value = focusFieldEmpty(lead.instagram) ? '' : String(lead.instagram).trim();
        if (inputs.twitter) inputs.twitter.value = focusFieldEmpty(lead.twitter) ? '' : String(lead.twitter).trim();
        if (inputs.linkedin) inputs.linkedin.value = focusFieldEmpty(lead.linkedin) ? '' : String(lead.linkedin).trim();
        if (inputs.tiktok) inputs.tiktok.value = focusFieldEmpty(lead.tiktok) ? '' : String(lead.tiktok).trim();
        summary.classList.add('hidden');
        panel.classList.remove('hidden');
        if (inputs.url) inputs.url.focus();
      }
      function commit() {
        var patch = {
          url: inputs.url && inputs.url.value.trim() ? focusNormalizeWebsite(inputs.url.value.trim()) : 'N/A',
          facebook: inputs.facebook && inputs.facebook.value.trim() ? focusNormalizeSocial(inputs.facebook.value.trim(), 'facebook') || 'N/A' : 'N/A',
          instagram: inputs.instagram && inputs.instagram.value.trim() ? focusNormalizeSocial(inputs.instagram.value.trim(), 'instagram') || 'N/A' : 'N/A',
          twitter: inputs.twitter && inputs.twitter.value.trim() ? focusNormalizeSocial(inputs.twitter.value.trim(), 'twitter') || 'N/A' : 'N/A',
          linkedin: inputs.linkedin && inputs.linkedin.value.trim() ? focusNormalizeSocial(inputs.linkedin.value.trim(), 'linkedin') || 'N/A' : 'N/A',
          tiktok: inputs.tiktok && inputs.tiktok.value.trim() ? focusNormalizeSocial(inputs.tiktok.value.trim(), 'tiktok') || 'N/A' : 'N/A',
        };
        if (saveBtn) saveBtn.disabled = true;
        editBtn.disabled = true;
        focusSaveLeadPatch(patch)
          .then(function () { setFocusContactEditFeedback('Social links saved.'); hide(); })
          .catch(function (err) { setFocusContactEditFeedback(err && err.message ? err.message : 'Save failed', true); })
          .finally(function () {
            if (saveBtn) saveBtn.disabled = false;
            editBtn.disabled = false;
          });
      }

      editBtn.addEventListener('click', function (e) {
        if (focusContactEditState.socials) commit();
        else show(e);
      });
      if (saveBtn) saveBtn.addEventListener('click', function (e) { e.stopPropagation(); commit(); });
      if (cancelBtn) cancelBtn.addEventListener('click', function (e) { e.stopPropagation(); hide(); });
    }

    function initFocusContactEdit() {
      bindFocusTextFieldEdit('address', 'focus-header-address', 'focus-header-address-input', 'focus-edit-address-btn', function (val) {
        var parts = val.split(',').map(function (p) { return p.trim(); }).filter(Boolean);
        var city = '';
        var state = '';
        if (parts.length >= 2) {
          city = parts[parts.length - 2] || '';
          state = (parts[parts.length - 1] || '').replace(/\d{5}(-\d{4})?.*$/, '').trim();
        }
        return { address: val || 'N/A', city: city, state: state };
      });
      bindFocusTextFieldEdit('phone', 'focus-header-phone', 'focus-header-phone-input', 'focus-edit-phone-btn', function (val) {
        return { phone: val || 'N/A' };
      });
      bindFocusTextFieldEdit('website', 'focus-header-website', 'focus-header-website-input', 'focus-edit-website-btn', function (val) {
        return { website: val ? focusNormalizeWebsite(val) : 'N/A' };
      });
      bindFocusTextFieldEdit('email', 'focus-header-email', 'focus-header-email-input', 'focus-edit-email-btn', function (val) {
        return { email: val || 'N/A' };
      });
      bindFocusSocialsEdit();
    }

    function focusQuickLogItems() {
      return (window.__QUICK_LOG && window.__QUICK_LOG.items) || [];
    }

    function focusQuickLogItemForValue(value) {
      var v = String(value || '').trim();
      if (!v) return null;
      if (v.indexOf('status:') === 0) {
        var status = v.slice(7);
        return focusQuickLogItems().find(function (i) { return i.status === status; }) || null;
      }
      return focusQuickLogItems().find(function (i) { return i.disposition === v; }) || null;
    }

    function focusBtnSelectionValue(btn) {
      var disp = String(btn.getAttribute('data-disposition') || '').trim();
      if (disp) return disp;
      var status = String(btn.getAttribute('data-status') || '').trim();
      if (status) return 'status:' + status;
      return '';
    }

    function parseFocusQuickLogSelection(value) {
      var v = String(value || '').trim();
      if (!v) return null;
      if (v.indexOf('status:') === 0) {
        var status = v.slice(7);
        var statusItem = focusQuickLogItems().find(function (i) { return i.status === status; });
        if (statusItem && statusItem.disposition) return { code: statusItem.disposition };
        return { status: status };
      }
      return { code: v };
    }

    function focusGhlPushPayload(lead) {
      var key = String(lead && lead.key || '').trim();
      var payload = { leadKeys: [key] };
      var website = lead && lead.website ? String(lead.website).trim() : '';
      if (!website || website === 'N/A' || website === '—') payload.tagNoWebsite = true;
      var parsed = parseFocusQuickLogSelection(elOutcome && elOutcome.value);
      var notes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      if (parsed && parsed.code) {
        payload.disposition = parsed.code;
        if (notes) payload.dispositionNotes = notes;
      }
      return payload;
    }

    function focusFollowUpPayload() {
      if (!elFollowupEnable || !elFollowupEnable.checked) {
        return { skipFollowUp: true };
      }
      var when = String((elFollowupAt && elFollowupAt.value) || '').trim();
      if (!when) {
        defaultFollowupDatetime();
        when = String((elFollowupAt && elFollowupAt.value) || '').trim();
      }
      if (!when) return { skipFollowUp: true };
      var parsed = new Date(when);
      if (Number.isNaN(parsed.getTime())) {
        setOutcomeFeedback('Invalid follow-up date/time.', true);
        return null;
      }
      return { scheduledAt: parsed.toISOString(), skipFollowUp: false };
    }

    function applyFocusQuickLogIfNeeded(lead, opts) {
      opts = opts || {};
      if (!lead || !lead.key) return Promise.resolve();
      var parsed = parseFocusQuickLogSelection(elOutcome && elOutcome.value);
      if (!parsed) return Promise.resolve();
      var notes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      if (parsed.code) {
        var body = { code: parsed.code, notes: notes };
        if (opts.deferGhlSync) body.deferGhlSync = true;
        var followPayload = focusFollowUpPayload();
        if (followPayload === null) return Promise.reject(new Error('invalid follow-up datetime'));
        if (followPayload.skipFollowUp) body.skipFollowUp = true;
        else if (followPayload.scheduledAt) body.scheduledAt = followPayload.scheduledAt;
        return fetch('/leads/' + encodeURIComponent(lead.key) + '/disposition', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body),
        }).then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Could not save disposition.');
            if (j.scheduledAt && !j.skipFollowUp) {
              setOutcomeFeedback('Logged — follow-up scheduled.', false);
            }
            return j;
          });
        });
      }
      if (parsed.status) {
        return fetch('/leads/' + encodeURIComponent(lead.key) + '/update', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ status: parsed.status }),
        }).then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Could not save status.');
            return j;
          });
        });
      }
      return Promise.resolve();
    }

    function saveFocusContextBeforeGhlSync(lead) {
      return applyFocusQuickLogIfNeeded(lead, { deferGhlSync: true });
    }

    function pushFocusLeadToGhl() {
      if (window.__focusPushGhlInFlight) return Promise.resolve();
      var lead = currentLead();
      if (!lead) {
        setOutcomeFeedback('No lead loaded.', true);
        return Promise.resolve();
      }
      var key = String(lead.key || '').trim();
      if (!key) {
        setOutcomeFeedback('Save this lead before syncing to GHL.', true);
        return Promise.resolve();
      }

      var labelDefault = 'Sync GHL';
      window.__focusPushGhlInFlight = true;
      if (btnPushGhl) {
        btnPushGhl.disabled = true;
        btnPushGhl.setAttribute('aria-busy', 'true');
        btnPushGhl.classList.add('is-busy');
        btnPushGhl.textContent = 'Syncing…';
      }
      setOutcomeFeedback('Saving disposition and notes…', false);

      return saveFocusContextBeforeGhlSync(lead)
        .then(function () {
          var payload = focusGhlPushPayload(lead);
          setOutcomeFeedback('Syncing to Go High Level…', false);
          return fetch('/ghl/push', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          }).then(function (r) {
            return r.json().then(function (j) {
              return { ok: r.ok, j: j };
            });
          });
        })
        .then(function (res) {
          var data = res.j || {};
          if (!res.ok || !data.success) throw new Error((data && data.error) || 'GHL sync failed');
          return data;
        })
        .then(function (data) {
          var payload = focusGhlPushPayload(lead);
          postNote().catch(function () { /* note is optional after GHL sync */ });
          var result = data.results && data.results.length ? data.results[0] : null;
          var actionTags = result && Array.isArray(result.actionTags) ? result.actionTags : [];
          var tagLabel = actionTags.length
            ? actionTags[0].replace(/^AO:\s*/i, '')
            : (payload.disposition ? payload.disposition.replace(/_/g, ' ') : '');
          var msg = 'GHL sync complete';
          if (tagLabel) msg += ' · AO: ' + tagLabel;
          if (payload.tagNoWebsite) msg += ' · no website';
          setOutcomeFeedback(msg, false);
          setCopyFeedback(msg, false);
          if (btnPushGhl) {
            btnPushGhl.textContent = '✓ Synced';
            if (window.__focusPushGhlFlashTimer) clearTimeout(window.__focusPushGhlFlashTimer);
            window.__focusPushGhlFlashTimer = setTimeout(function () {
              if (btnPushGhl) {
                btnPushGhl.textContent = labelDefault;
                btnPushGhl.classList.remove('is-busy');
                btnPushGhl.removeAttribute('aria-busy');
              }
            }, 1600);
          }
          return data;
        })
        .catch(function (err) {
          var errMsg = err && err.message ? err.message : 'Could not sync to GHL.';
          setOutcomeFeedback(errMsg, true);
          setCopyFeedback(errMsg, true);
          if (btnPushGhl) {
            btnPushGhl.textContent = 'Failed';
            if (window.__focusPushGhlFlashTimer) clearTimeout(window.__focusPushGhlFlashTimer);
            window.__focusPushGhlFlashTimer = setTimeout(function () {
              if (btnPushGhl) {
                btnPushGhl.textContent = labelDefault;
                btnPushGhl.classList.remove('is-busy');
                btnPushGhl.removeAttribute('aria-busy');
              }
            }, 1200);
          }
          throw err;
        })
        .finally(function () {
          window.__focusPushGhlInFlight = false;
          if (btnPushGhl) btnPushGhl.disabled = false;
        });
    }
    window.__pushFocusLeadToGhl = pushFocusLeadToGhl;

    function paintFocusStageBadge(lead) {
      if (!elStage || !lead) return;
      elStage.textContent = lead.pipelineLabel || ('Stage ' + lead.pipelineStage);
    }

    function applyFocusPipelineFromLead(lead, dataLead) {
      if (!lead || !dataLead) return;
      if (dataLead.stageId) lead.stageId = dataLead.stageId;
      if (dataLead.pipelineStage != null) lead.pipelineStage = dataLead.pipelineStage;
      if (dataLead.pipelineStageKey) lead.pipelineStageKey = dataLead.pipelineStageKey;
      if (dataLead.pipelineLabel) lead.pipelineLabel = dataLead.pipelineLabel;
      var cur = currentLead();
      if (cur === lead || (cur && lead && String(cur.key) === String(lead.key))) {
        paintFocusStageBadge(lead);
      }
    }

    function placeFocusCall() {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/call', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      })
        .then(function (r) {
