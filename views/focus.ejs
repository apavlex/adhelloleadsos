<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 pb-28 md:pb-10 md:py-10">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Focus mode</p>
          <h1 class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Start my 54</h1>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-2">One lead at a time — draft, log, next. <button type="button" id="focus-help-btn" class="font-bold text-brand-dark dark:text-white underline decoration-brand-yellow/60 hover:decoration-brand-yellow">Shortcuts (?)</button></p>
        </div>
        <a href="/today" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">← Today</a>
      </div>
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-4 py-3">
        <div class="flex justify-between items-baseline text-sm mb-2">
          <span class="text-brand-muted dark:text-slate-400">Touches today</span>
          <span class="font-display font-black text-brand-dark dark:text-white"><span id="focus-touch-count"><%= typeof touchesToday !== 'undefined' ? touchesToday : 0 %></span> <span class="text-brand-muted font-bold text-sm">/ <span id="focus-touch-goal"><%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %></span></span></span>
        </div>
        <div class="h-2 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %>" aria-valuenow="<%= typeof touchesToday !== 'undefined' ? touchesToday : 0 %>" id="focus-progress-bar-wrap">
          <div id="focus-progress-fill" class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width: <%= (typeof touchGoal !== 'undefined' && touchGoal > 0) ? Math.min(100, Math.round((touchesToday || 0) / touchGoal * 100)) : 0 %>%"></div>
        </div>
      </div>
    </header>

    <div id="focus-empty" class="hidden rounded-[2rem] border-2 border-dashed border-brand-border dark:border-white/15 bg-white/60 dark:bg-slate-900/50 px-8 py-14 text-center">
      <h2 id="focus-empty-title" class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2">No leads in this queue</h2>
      <p id="focus-empty-desc" class="text-sm text-brand-muted mb-6 max-w-md mx-auto">Add or import leads to your pipeline, then come back.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <button type="button" id="focus-empty-reload" class="hidden btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Reload queue</button>
        <a href="/prospecting?tab=pipeline" class="btn-pill btn-primary inline-flex px-8 py-3 text-xs font-black uppercase tracking-widest">Open pipeline</a>
      </div>
    </div>

    <section id="focus-card-section" class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/85 dark:bg-slate-900/75 shadow-sm p-6 md:p-8 max-w-3xl mx-auto" aria-label="Current lead">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h2 id="focus-company" class="font-display font-black text-2xl text-brand-dark dark:text-white truncate">—</h2>
          <p id="focus-contact" class="text-sm font-semibold text-brand-muted dark:text-slate-400 mt-1">—</p>
        </div>
        <span id="focus-stage-badge" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 border border-brand-border/50 dark:border-white/10 text-brand-dark dark:text-slate-200">—</span>
      </div>
      <p class="text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-4">Last touch <span id="focus-last-touch" class="text-brand-dark dark:text-white normal-case">—</span></p>

      <div id="focus-links" class="flex flex-wrap gap-2 mb-6" aria-label="Contact links"></div>
      <div class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/35 dark:bg-slate-800/60 px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Business info</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Website</p>
            <a id="focus-biz-website" href="#" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-dark dark:text-slate-100 hover:text-brand-yellow transition-colors truncate block">—</a>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Location</p>
            <p id="focus-biz-location" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Category</p>
            <p id="focus-biz-category" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Reviews</p>
            <p id="focus-biz-reviews" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
            <div id="focus-biz-review-stars" class="mt-1 flex items-center gap-1 text-amber-500" aria-label="Review stars"></div>
          </div>
        </div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">AI review summary</p>
          <p id="focus-review-summary" class="text-[11px] text-brand-muted leading-snug">Loading review summary…</p>
        </div>
        <div id="focus-biz-socials" class="flex flex-wrap gap-2 mt-3"></div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-2">Quick copy</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="focus-copy-phone" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Phone</button>
            <button type="button" id="focus-copy-email" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Email</button>
            <button type="button" id="focus-copy-website" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Website</button>
          </div>
          <p id="focus-copy-feedback" class="text-[11px] text-brand-muted mt-2 min-h-[1rem]"></p>
        </div>
      </div>

      <div
        id="focus-recommended"
        class="hidden mb-4 rounded-2xl border border-brand-yellow/35 bg-brand-yellow/10 dark:bg-amber-500/10 dark:border-amber-500/30 px-4 py-3"
        role="group"
        aria-label="Product and service angle"
      >
        <% const _focusProductOptions = (typeof focusProductOptions !== 'undefined' && Array.isArray(focusProductOptions) && focusProductOptions.length) ? focusProductOptions : [
          { key: 'reputation', label: 'Reputation management' },
          { key: 'ai_automation', label: 'AI automation' },
          { key: 'ai_websites', label: 'AI websites' },
          { key: 'social_media', label: 'Social media' },
          { key: 'ad_management', label: 'Ad management' },
          { key: 'web_design', label: 'Web design' },
        ]; %>
        <label for="focus-service-select" class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-amber-200/80 mb-2 block">Recommended product</label>
        <button
          type="button"
          id="focus-recommended-toggle"
          class="w-full text-left rounded-xl border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors"
          aria-expanded="false"
          aria-controls="focus-product-options"
        >
          —
        </button>
        <div id="focus-product-options" class="hidden mt-2 flex flex-wrap gap-2">
          <% _focusProductOptions.forEach(function (p) { %>
            <button
              type="button"
              class="focus-product-option inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors"
              data-service-key="<%= p.key %>"
              data-service-label="<%= p.label %>"
            ><%= p.label %></button>
          <% }); %>
        </div>
        <select
          id="focus-service-select"
          class="hidden"
        >
          <option value="auto">Use lead’s recommended</option>
          <% _focusProductOptions.forEach(function (p) { %>
            <option value="<%= p.key %>"><%= p.label %></option>
          <% }); %>
        </select>
        <p id="focus-recommended-hint" class="text-[11px] text-brand-muted dark:text-slate-400 mt-2 leading-snug" aria-live="polite"></p>
      </div>

      <div class="mb-4 rounded-2xl border-2 border-brand-yellow/35 dark:border-brand-yellow/35 bg-brand-yellow/10 dark:bg-brand-yellow/10 px-4 py-3 shadow-sm">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Channel</p>
        <p class="text-xs text-brand-muted dark:text-slate-400 mb-2">Use <strong>Call</strong>, <strong>Voicemail drop</strong>, <strong>SMS</strong>, or <strong>Email</strong> as separate touch channels, then log and move to the next lead.</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Outreach channel">
          <button type="button" class="focus-channel-btn btn-pill border-2 border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/60 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-channel="call-script" title="Call script and dialer">Call</button>
          <button type="button" class="focus-channel-btn btn-pill border-2 border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/60 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-channel="voicemail-drop" title="One-touch voicemail drop to this lead">Voicemail drop</button>
          <button type="button" class="focus-channel-btn btn-pill border-2 border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/60 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-channel="sms" title="SMS touch">SMS</button>
          <button type="button" class="focus-channel-btn btn-pill border-2 border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/60 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-channel="email">Email</button>
        </div>
        <p id="focus-channel-hint" class="text-[11px] text-brand-muted dark:text-slate-400 mt-2 min-h-[2.5rem] leading-snug" aria-live="polite"></p>
      </div>

      <div class="mb-4 rounded-2xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/35 dark:bg-slate-800/35 px-4 py-3">
        <div class="flex flex-col sm:flex-row sm:items-end gap-3 sm:gap-4">
        <label class="block flex-1 min-w-0" for="focus-script-variant">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Script style</span>
          <select
            id="focus-script-variant"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <option value="default">First touch / default</option>
            <option value="followup">Follow-up</option>
            <option value="reengage">Re-engagement</option>
            <option value="short">Short &amp; punchy</option>
          </select>
        </label>
        </div>
      </div>

      <div id="focus-subject-wrap" class="mb-3 hidden">
        <label for="focus-subject" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Subject</label>
        <input id="focus-subject" type="text" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm text-brand-dark dark:text-white" autocomplete="off" />
      </div>
      <div class="mb-6">
        <label for="focus-body" id="focus-body-label" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Outreach draft</label>
        <textarea id="focus-body" rows="10" class="w-full rounded-2xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white font-medium leading-relaxed resize-y min-h-[200px]" placeholder="Draft loads here — edit before you send or log."></textarea>
      </div>
      <div class="mb-6 md:mb-4 md:sticky md:bottom-4 z-30 rounded-[1.35rem] border border-brand-border/60 dark:border-white/15 bg-brand-cream/25 dark:bg-slate-900/70 md:bg-white/70 md:dark:bg-slate-900/65 md:backdrop-blur-xl shadow-sm md:shadow-xl p-4 space-y-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Call outcome + notes</p>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Quick disposition</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="no_pickup">No pickup</button>
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="voicemail">Voicemail</button>
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="sent_sms">Sent SMS</button>
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="sent_email">Sent email</button>
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="talked_owner">Spoke owner</button>
            <button type="button" class="focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15" data-outcome="callback_requested">Callback</button>
          </div>
          <p id="focus-selected-outcome-label" class="mt-2 text-[11px] text-brand-muted">Selected: none</p>
        </div>
        <select id="focus-outcome" class="hidden" aria-hidden="true" tabindex="-1">
          <option value="">Select outcome…</option>
          <option value="voicemail">Went to voicemail</option>
          <option value="no_pickup">No pickup</option>
          <option value="talked_owner">Talked to business owner</option>
          <option value="callback_requested">Callback requested</option>
          <option value="sent_sms">Sent SMS</option>
          <option value="sent_email">Sent email</option>
          <option value="other">Other</option>
        </select>
        <div>
          <label for="focus-outcome-notes" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-1.5">Notes</label>
          <textarea id="focus-outcome-notes" rows="3" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white" placeholder="Owner response, objection, timing, next step…"></textarea>
        </div>
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-brand-dark dark:text-white">
          <input type="checkbox" id="focus-followup-enable" class="rounded border-brand-border" />
          Schedule follow-up task
        </label>
        <div id="focus-followup-wrap" class="hidden">
          <label for="focus-followup-at" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-1.5">Follow-up date &amp; time</label>
          <input id="focus-followup-at" type="datetime-local" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white" />
        </div>
        <p id="focus-outcome-feedback" class="min-h-[1rem] text-[11px] text-brand-muted"></p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3 pt-1">
        <button
          type="button"
          id="focus-btn-open-dialer"
          class="btn-pill border-2 border-emerald-600/90 bg-emerald-600/10 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-200 px-6 py-3.5 text-xs font-black uppercase tracking-widest hover:bg-emerald-100 dark:hover:bg-emerald-900/50"
          title="Open AdHello softphone and fill this lead number"
        >
          Open in dialer
        </button>
        <button type="button" id="focus-btn-call" class="btn-pill btn-primary flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest shadow-md">Call</button>
        <button type="button" id="focus-btn-voicemail" class="btn-pill border-2 border-violet-500/50 bg-violet-500/10 text-violet-800 dark:text-violet-200 flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest">Drop voicemail</button>
        <button type="button" id="focus-btn-sms" class="btn-pill border-2 border-blue-500/40 bg-blue-500/10 text-blue-800 dark:text-blue-200 flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest">SMS</button>
        <button type="button" id="focus-btn-email" class="btn-pill border-2 border-brand-yellow/40 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest">Email</button>
        <button type="button" id="focus-btn-log" class="btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white hover:bg-brand-cream/40 dark:hover:bg-slate-800">Log &amp; next</button>
        <button type="button" id="focus-btn-skip" class="btn-pill border-2 border-brand-border dark:border-white/15 bg-brand-cream/30 dark:bg-slate-800/50 flex-1 px-6 py-3.5 text-xs font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hover:border-brand-yellow/40">Skip</button>
        </div>
        <p class="text-[10px] text-brand-muted mt-1"><kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">⌘</kbd>/<kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">Ctrl</kbd>+<kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">Enter</kbd> run selected channel · <kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">L</kbd> log · <kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">J</kbd> skip · <kbd class="px-1 py-0.5 rounded bg-brand-cream dark:bg-slate-800 font-mono">E</kbd> focus draft</p>
      </div>
    </section>
  </main>
  <div id="focus-mobile-fab-wrap" class="md:hidden fixed right-4 bottom-[max(0.9rem,env(safe-area-inset-bottom))] z-[90] hidden" aria-label="Mobile quick actions">
    <div id="focus-mobile-fab-actions" class="hidden mb-2.5 w-[min(78vw,18rem)] rounded-2xl border border-brand-border/70 dark:border-white/15 bg-white/95 dark:bg-slate-900/95 backdrop-blur shadow-xl p-2.5 space-y-2">
      <button type="button" id="focus-mobile-call" class="w-full btn-pill bg-emerald-600 text-white py-2.5 text-[10px] font-black uppercase tracking-widest">Call now</button>
      <button type="button" id="focus-mobile-log" class="w-full btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Log &amp; next</button>
      <button type="button" id="focus-mobile-skip" class="w-full btn-pill border-2 border-brand-border dark:border-white/15 bg-brand-cream/30 dark:bg-slate-800/50 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Skip</button>
    </div>
    <button type="button" id="focus-mobile-fab-toggle" class="w-14 h-14 rounded-full bg-brand-yellow text-brand-dark shadow-xl border border-amber-400/40 inline-flex items-center justify-center" aria-label="Open quick actions" aria-expanded="false" aria-controls="focus-mobile-fab-actions">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>

  <div id="focus-modal-help" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="focus-help-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="focus-help-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Keyboard shortcuts</h2>
      <ul class="space-y-2 text-sm text-brand-dark dark:text-slate-200">
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">E</kbd> — Focus draft textarea</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">⌘/Ctrl</kbd> + <kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">Enter</kbd> — Send &amp; advance</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">L</kbd> — Log &amp; next</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">J</kbd> — Skip</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">?</kbd> — This sheet</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">Esc</kbd> — Close</li>
      </ul>
      <button type="button" id="focus-help-close" class="mt-6 w-full btn-pill btn-primary py-3 text-xs font-black uppercase tracking-widest">Got it</button>
    </div>
  </div>

  <div id="focus-modal-celebrate" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="focus-celebrate-title">
    <div class="bg-white dark:bg-slate-900 rounded-[2rem] border-2 border-brand-yellow/50 shadow-xl max-w-md w-full p-8 text-center">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Goal hit</p>
      <h2 id="focus-celebrate-title" class="font-display font-black text-2xl text-brand-dark dark:text-white mb-3">You hit your touch goal 🎯</h2>
      <p class="text-sm text-brand-muted mb-8">Nice work. Keep the streak or call it a day.</p>
      <div class="flex flex-col gap-3">
        <button type="button" id="focus-celebrate-continue" class="btn-pill btn-primary py-3.5 text-xs font-black uppercase tracking-widest">Keep going</button>
        <a href="/today" id="focus-celebrate-done" class="btn-pill border-2 border-brand-border dark:border-white/20 py-3.5 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center">Done for today</a>
      </div>
    </div>
  </div>

  <script type="application/json" id="focus-queue-json"><%- typeof focusQueueJson !== 'undefined' ? focusQueueJson : '[]' %></script>
  <script>
  (function () {
    var queue = [];
    try {
      queue = JSON.parse(document.getElementById('focus-queue-json').textContent || '[]');
    } catch (e) {
      queue = [];
    }

    var idx = 0;
    var currentChannel = 'email';
    var touchGoal = parseInt(document.getElementById('focus-touch-goal').textContent, 10) || 54;
    var celebrateDismissed = false;

    var elEmpty = document.getElementById('focus-empty');
    var elEmptyTitle = document.getElementById('focus-empty-title');
    var elEmptyDesc = document.getElementById('focus-empty-desc');
    var elEmptyReload = document.getElementById('focus-empty-reload');
    var elSection = document.getElementById('focus-card-section');
    var elCompany = document.getElementById('focus-company');
    var elContact = document.getElementById('focus-contact');
    var elStage = document.getElementById('focus-stage-badge');
    var elLast = document.getElementById('focus-last-touch');
    var elLinks = document.getElementById('focus-links');
    var elBizWebsite = document.getElementById('focus-biz-website');
    var elBizLocation = document.getElementById('focus-biz-location');
    var elBizCategory = document.getElementById('focus-biz-category');
    var elBizReviews = document.getElementById('focus-biz-reviews');
    var elBizReviewStars = document.getElementById('focus-biz-review-stars');
    var elReviewSummary = document.getElementById('focus-review-summary');
    var elBizSocials = document.getElementById('focus-biz-socials');
    var btnCopyPhone = document.getElementById('focus-copy-phone');
    var btnCopyEmail = document.getElementById('focus-copy-email');
    var btnCopyWebsite = document.getElementById('focus-copy-website');
    var elCopyFeedback = document.getElementById('focus-copy-feedback');
    var elOutcome = document.getElementById('focus-outcome');
    var elSelectedOutcomeLabel = document.getElementById('focus-selected-outcome-label');
    var elQuickOutcomeBtns = document.querySelectorAll('.focus-quick-outcome');
    var elOutcomeNotes = document.getElementById('focus-outcome-notes');
    var elFollowupEnable = document.getElementById('focus-followup-enable');
    var elFollowupWrap = document.getElementById('focus-followup-wrap');
    var elFollowupAt = document.getElementById('focus-followup-at');
    var elOutcomeFeedback = document.getElementById('focus-outcome-feedback');
    var elSubjectWrap = document.getElementById('focus-subject-wrap');
    var elSubject = document.getElementById('focus-subject');
    var elBody = document.getElementById('focus-body');
    var channelBtns = document.querySelectorAll('.focus-channel-btn');
    var btnCall = document.getElementById('focus-btn-call');
    var btnVoicemail = document.getElementById('focus-btn-voicemail');
    var btnSms = document.getElementById('focus-btn-sms');
    var btnEmail = document.getElementById('focus-btn-email');
    var btnLog = document.getElementById('focus-btn-log');
    var btnSkip = document.getElementById('focus-btn-skip');
    var modalHelp = document.getElementById('focus-modal-help');
    var modalCelebrate = document.getElementById('focus-modal-celebrate');
    var fill = document.getElementById('focus-progress-fill');
    var countEl = document.getElementById('focus-touch-count');
    var barWrap = document.getElementById('focus-progress-bar-wrap');
    var elRecommended = document.getElementById('focus-recommended');
    var elRecommendedToggle = document.getElementById('focus-recommended-toggle');
    var elProductOptions = document.getElementById('focus-product-options');
    var elProductOptionBtns = document.querySelectorAll('.focus-product-option');
    var elServiceSelect = document.getElementById('focus-service-select');
    var elRecommendedHint = document.getElementById('focus-recommended-hint');
    var elChannelHint = document.getElementById('focus-channel-hint');
    var elScriptVariant = document.getElementById('focus-script-variant');
    var btnOpenDialer = document.getElementById('focus-btn-open-dialer');
    var elBodyLabel = document.getElementById('focus-body-label');
    var elMobileFabWrap = document.getElementById('focus-mobile-fab-wrap');
    var elMobileFabActions = document.getElementById('focus-mobile-fab-actions');
    var btnMobileFabToggle = document.getElementById('focus-mobile-fab-toggle');
    var btnMobileCall = document.getElementById('focus-mobile-call');
    var btnMobileLog = document.getElementById('focus-mobile-log');
    var btnMobileSkip = document.getElementById('focus-mobile-skip');

    function isMobileViewport() {
      return window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    }
    function closeMobileFabActions() {
      if (elMobileFabActions) elMobileFabActions.classList.add('hidden');
      if (btnMobileFabToggle) btnMobileFabToggle.setAttribute('aria-expanded', 'false');
    }

    function normalizeTel(raw) {
      var s = String(raw || '').trim();
      if (!s) return '';
      var plus = s.indexOf('+') === 0 ? '+' : '';
      var digits = s.replace(/\D/g, '');
      if (!digits) return '';
      return plus + digits;
    }

    function openDialerForLead() {
      var lead = currentLead();
      if (!lead || !String(lead.phone || '').trim()) {
        setCopyFeedback('No phone on this lead.', true);
        return;
      }
      if (isMobileViewport()) {
        var to = normalizeTel(lead.phone);
        if (!to) {
          setCopyFeedback('Could not normalize this phone number.', true);
          return;
        }
        setCopyFeedback('Opening your phone app...');
        window.location.href = 'tel:' + to;
        return;
      }
      var navSoftphoneBtn = document.getElementById('navSoftphoneOpen') || document.getElementById('navSoftphoneOpenMobile');
      if (navSoftphoneBtn) navSoftphoneBtn.click();
      if (typeof window.__adhelloOpenSoftphoneWithDial === 'function') {
        if (!window.__adhelloOpenSoftphoneWithDial(lead.phone)) {
          setCopyFeedback('Could not normalize that phone number for the dialer.', true);
          return;
        }
        setCopyFeedback('Dialer opened with lead number loaded. Press Call in the softphone to dial.');
      } else {
        setCopyFeedback('Dialer opened. Copy phone if needed.', false);
      }
    }

    function setChannelHint() {
      if (!elChannelHint) return;
      if (currentChannel === 'email') {
        elChannelHint.textContent =
          'Email: edit subject and message, then click Email below to log and advance. Script style above swaps the copy.';
        return;
      }
      if (currentChannel === 'call-script') {
        elChannelHint.textContent =
          'Call: rehearse the script in the box. Use “Open in dialer” to fill the softphone, then click Call below.';
        return;
      }
      if (currentChannel === 'voicemail-drop') {
        elChannelHint.textContent =
          'Voicemail drop: click Drop voicemail below to run your saved workspace voicemail audio for this lead.';
        return;
      }
      if (currentChannel === 'sms') {
        elChannelHint.textContent =
          'SMS: keep this short and direct. Run SMS to log this touch and open your device/app composer when possible.';
        return;
      }
      elChannelHint.textContent = '';
    }

    function updateBodyLabel() {
      if (!elBodyLabel) return;
      if (currentChannel === 'email') {
        elBodyLabel.textContent = 'Outreach draft';
      } else if (currentChannel === 'sms') {
        elBodyLabel.textContent = 'SMS script';
      } else if (currentChannel === 'voicemail-drop') {
        elBodyLabel.textContent = 'Voicemail / call script (rehearsal)';
      } else {
        elBodyLabel.textContent = 'Call script';
      }
    }

    function updateDialerCta() {
      var lead = currentLead();
      var hasPhone = Boolean(lead && String(lead.phone || '').trim() && String(lead.phone) !== 'N/A');
      if (btnOpenDialer) {
        btnOpenDialer.classList.toggle('hidden', !hasPhone);
      }
      if (elMobileFabWrap) {
        var showFab = isMobileViewport() && hasPhone;
        elMobileFabWrap.classList.toggle('hidden', !showFab);
        if (!showFab) closeMobileFabActions();
      }
    }

    function applyRecommendedFromDraft(data) {
      if (!elRecommended) return;
      if (data && (data.recommendedProduct || data.selectedServiceKey)) {
        elRecommended.classList.remove('hidden');
      } else {
        elRecommended.classList.add('hidden');
        if (elRecommendedHint) elRecommendedHint.textContent = '';
        return;
      }
      if (elServiceSelect && data.selectedServiceKey) {
        if (elServiceSelect.querySelector('option[value="' + data.selectedServiceKey + '"]')) {
          elServiceSelect.value = data.selectedServiceKey;
        } else {
          elServiceSelect.value = 'auto';
        }
      }
      if (elRecommendedToggle) {
        var selectedOpt =
          elServiceSelect &&
          elServiceSelect.value &&
          elServiceSelect.querySelector('option[value="' + elServiceSelect.value + '"]');
        var selectedLabel = selectedOpt ? selectedOpt.textContent : '';
        var recommendedLabel =
          (data.recommendedProduct && data.recommendedProduct.label) ||
          data.recommendedServiceKey ||
          'Recommended';
        elRecommendedToggle.textContent = selectedLabel || recommendedLabel;
      }
      if (elProductOptionBtns && elProductOptionBtns.length) {
        elProductOptionBtns.forEach(function (btn) {
          var key = btn.getAttribute('data-service-key');
          var active = !!(elServiceSelect && key === elServiceSelect.value);
          btn.classList.toggle('border-brand-yellow', active);
          btn.classList.toggle('bg-brand-yellow/15', active);
        });
      }
      if (elRecommendedHint && data.recommendedServiceKey) {
        var recLabel = (data.recommendedProduct && data.recommendedProduct.label) || data.recommendedServiceKey;
        var sel = data.selectedServiceKey || '';
        if (sel && sel === data.recommendedServiceKey) {
          elRecommendedHint.textContent =
            'This lead’s default angle is: ' + recLabel + '. Change the dropdown anytime to practice a different offer.';
        } else if (sel) {
          var opt =
            data.productOptions && Array.isArray(data.productOptions)
              ? data.productOptions.find(function (o) {
                  return o.key === sel;
                })
              : null;
          var sellabel = (opt && opt.label) || sel;
          elRecommendedHint.textContent =
            'This lead’s recommended offer is ' +
            recLabel +
            '. You are practicing the script for: ' +
            sellabel +
            ' (see below).';
        } else {
          elRecommendedHint.textContent = 'Choose a product angle above; “Use lead’s recommended” matches this lead’s saved primary service when set.';
        }
      } else if (elRecommendedHint) {
        elRecommendedHint.textContent = 'Choose a product angle above, or keep “Use lead’s recommended”.';
      }
    }

    function hrefUrl(u) {
      if (!u) return '';
      var s = String(u).trim();
      if (!s) return '';
      if (/^https?:\/\//i.test(s)) return s;
      return 'https://' + s.replace(/^\/\//, '');
    }

    function iconLink(href, label, svgPath) {
      var a = document.createElement('a');
      a.href = href;
      a.setAttribute('aria-label', label);
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'inline-flex items-center justify-center w-9 h-9 rounded-xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors';
      a.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' + svgPath + '</svg>';
      return a;
    }

    function cleanUrlLabel(raw) {
      if (!raw) return '';
      return String(raw).replace(/^https?:\/\//i, '').replace(/\/$/, '');
    }

    function socialPill(label, href) {
      var a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors';
      a.textContent = label;
      return a;
    }

    function renderLinks(lead) {
      elLinks.innerHTML = '';
      if (lead.website) elLinks.appendChild(iconLink(hrefUrl(lead.website), 'Website', '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>'));
      if (lead.phone) {
        var phoneBtn = iconLink('#', 'Phone', '<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>');
        phoneBtn.removeAttribute('target');
        phoneBtn.removeAttribute('rel');
        phoneBtn.addEventListener('click', function (e) {
          e.preventDefault();
          openDialerForLead();
        });
        elLinks.appendChild(phoneBtn);
      }
      if (lead.email) elLinks.appendChild(iconLink('mailto:' + encodeURIComponent(lead.email), 'Email', '<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'));
      if (lead.linkedin) elLinks.appendChild(iconLink(hrefUrl(lead.linkedin), 'LinkedIn', '<path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2V9zM4 6a2 2 0 100-4 2 2 0 000 4z"/>'));
      if (lead.instagram) elLinks.appendChild(iconLink(hrefUrl(lead.instagram), 'Instagram', '<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>'));
      if (lead.facebook) elLinks.appendChild(iconLink(hrefUrl(lead.facebook), 'Facebook', '<path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z"/>'));
      if (lead.twitter) elLinks.appendChild(iconLink(hrefUrl(lead.twitter), 'X / Twitter', '<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>'));
    }

    function placeFocusCall() {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/call', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Call failed');
            return j;
          });
        })
        .then(function (data) {
          var dialMode = String((data && data.dialMode) || '').trim();
          var phone = String((data && data.phone) || (lead.phone || '')).replace(/[^\d+]/g, '');
          if (dialMode === 'browser_device' && phone) {
            setCopyFeedback('Opening your dialer...');
            window.location.href = 'tel:' + phone;
          } else {
            setCopyFeedback('Cloud call started.');
          }
          return data;
        })
        .catch(function (err) {
          setCopyFeedback(err && err.message ? err.message : 'Could not start call.', true);
          throw err;
        });
    }

    function placeFocusVoicemail() {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/voicemail-drop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Voicemail drop failed');
            return j;
          });
        })
        .then(function (data) {
          setCopyFeedback('Voicemail drop started.');
          return data;
        })
        .catch(function (err) {
          setCopyFeedback(err && err.message ? err.message : 'Could not start voicemail drop.', true);
          throw err;
        });
    }

    function placeFocusSms() {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      var msgBody = String((elBody && elBody.value) || '').trim();
      if (!msgBody) {
        setCopyFeedback('SMS body is empty. Add a message first.', true);
        return Promise.reject(new Error('sms body empty'));
      }
      var phone = normalizeTel(lead.phone || '');
      if (!phone) {
        setCopyFeedback('No phone found for this lead.', true);
        return Promise.reject(new Error('missing phone'));
      }
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/sms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ body: msgBody }),
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'SMS failed');
            return j;
          });
        })
        .then(function (data) {
          setCopyFeedback('SMS sent.');
          return data;
        })
        .catch(function (err) {
          setCopyFeedback(err && err.message ? err.message : 'Could not send SMS.', true);
          throw err;
        });
    }

    function placeFocusEmail() {
      var lead = currentLead();
      if (!lead) return Promise.resolve();
      var email = String((lead && lead.email) || '').trim();
      if (!email || email === 'N/A') {
        setCopyFeedback('No email found for this lead.', true);
        return Promise.reject(new Error('missing email'));
      }
      var subject = String((elSubject && elSubject.value) || '').trim();
      var body = String((elBody && elBody.value) || '').trim();
      var mailto = 'mailto:' + encodeURIComponent(email);
      var params = [];
      if (subject) params.push('subject=' + encodeURIComponent(subject));
      if (body) params.push('body=' + encodeURIComponent(body));
      if (params.length) mailto += '?' + params.join('&');
      try {
        window.location.href = mailto;
        setCopyFeedback('Email client opened.');
        return Promise.resolve({ success: true });
      } catch (err) {
        setCopyFeedback('Could not open email client.', true);
        return Promise.reject(err);
      }
    }

    function renderBusinessInfo(lead) {
      var websiteHref = hrefUrl(lead.website || '');
      if (websiteHref) {
        elBizWebsite.href = websiteHref;
        elBizWebsite.textContent = cleanUrlLabel(websiteHref);
        elBizWebsite.classList.remove('pointer-events-none', 'text-brand-muted');
      } else {
        elBizWebsite.href = '#';
        elBizWebsite.textContent = '—';
        elBizWebsite.classList.add('pointer-events-none', 'text-brand-muted');
      }

      var parts = [];
      if (lead.address) parts.push(lead.address);
      var cityState = [lead.city || '', lead.state || ''].filter(Boolean).join(', ');
      if (cityState) parts.push(cityState);
      elBizLocation.textContent = parts.length ? parts.join(' · ') : '—';

      elBizCategory.textContent = lead.categoryName || '—';

      var score = Number(lead.totalScore || 0);
      var reviews = parseInt(lead.reviewsCount, 10) || 0;
      if (score > 0) {
        elBizReviews.textContent = score.toFixed(1) + ' stars · ' + reviews + ' review' + (reviews === 1 ? '' : 's');
      } else if (reviews > 0) {
        elBizReviews.textContent = reviews + ' review' + (reviews === 1 ? '' : 's');
      } else {
        elBizReviews.textContent = '—';
      }
      applyReviewTone(score, reviews);
      renderReviewStars(score);

      elBizSocials.innerHTML = '';
      if (lead.url) elBizSocials.appendChild(socialPill('Google listing', hrefUrl(lead.url)));
      if (lead.facebook) elBizSocials.appendChild(socialPill('Facebook', hrefUrl(lead.facebook)));
      if (lead.instagram) elBizSocials.appendChild(socialPill('Instagram', hrefUrl(lead.instagram)));
      if (lead.twitter) elBizSocials.appendChild(socialPill('X', hrefUrl(lead.twitter)));
      if (lead.linkedin) elBizSocials.appendChild(socialPill('LinkedIn', hrefUrl(lead.linkedin)));
      if (!elBizSocials.children.length) {
        var empty = document.createElement('span');
        empty.className = 'text-[11px] text-brand-muted';
        empty.textContent = 'No social/profile links found';
        elBizSocials.appendChild(empty);
      }
    }

    function renderReviewStars(score) {
      if (!elBizReviewStars) return;
      elBizReviewStars.innerHTML = '';
      var val = Number(score || 0);
      if (!(val > 0)) {
        var noData = document.createElement('span');
        noData.className = 'text-[10px] text-brand-muted';
        noData.textContent = 'No rating data';
        elBizReviewStars.appendChild(noData);
        return;
      }
      var rounded = Math.round(val * 2) / 2;
      for (var i = 1; i <= 5; i += 1) {
        var star = document.createElement('span');
        star.className = 'text-[14px] leading-none';
        if (rounded >= i) star.textContent = '★';
        else if (rounded >= i - 0.5) star.textContent = '⯨';
        else star.textContent = '☆';
        elBizReviewStars.appendChild(star);
      }
    }

    function applyReviewTone(score, reviews) {
      if (!elBizReviews && !elBizReviewStars) return;
      var s = Number(score || 0);
      var r = parseInt(reviews, 10) || 0;
      var tone = 'muted';
      if (s > 0) {
        if (s >= 4.4 && r >= 20) tone = 'good';
        else if (s <= 3.4 || (r >= 20 && s < 3.9)) tone = 'risk';
        else tone = 'mid';
      }
      var textClass = tone === 'good'
        ? 'text-emerald-700 dark:text-emerald-300'
        : tone === 'risk'
          ? 'text-rose-700 dark:text-rose-300'
          : tone === 'mid'
            ? 'text-amber-700 dark:text-amber-300'
            : 'text-brand-dark dark:text-slate-100';
      var starClass = tone === 'good'
        ? 'text-emerald-500'
        : tone === 'risk'
          ? 'text-rose-500'
          : tone === 'mid'
            ? 'text-amber-500'
            : 'text-brand-muted';
      if (elBizReviews) {
        elBizReviews.classList.remove(
          'text-brand-dark', 'dark:text-slate-100',
          'text-emerald-700', 'dark:text-emerald-300',
          'text-rose-700', 'dark:text-rose-300',
          'text-amber-700', 'dark:text-amber-300'
        );
        textClass.split(' ').forEach(function (c) { if (c) elBizReviews.classList.add(c); });
      }
      if (elBizReviewStars) {
        elBizReviewStars.classList.remove(
          'text-amber-500', 'text-emerald-500', 'text-rose-500', 'text-brand-muted'
        );
        starClass.split(' ').forEach(function (c) { if (c) elBizReviewStars.classList.add(c); });
      }
    }

    function renderReviewSummaryText(strengths, weaknesses, sourceNote) {
      var bits = [];
      if (Array.isArray(strengths) && strengths.length) {
        bits.push('Strength: ' + String(strengths[0]));
      }
      if (Array.isArray(weaknesses) && weaknesses.length) {
        bits.push('Risk: ' + String(weaknesses[0]));
      }
      if (sourceNote) bits.push(String(sourceNote));
      return bits.join(' ');
    }

    function fetchReviewSummary() {
      var lead = currentLead();
      if (!elReviewSummary) return Promise.resolve();
      if (!lead || !lead.key) {
        elReviewSummary.textContent = 'No lead selected.';
        return Promise.resolve();
      }
      var requestId = String(lead.key) + '|' + Date.now();
      window.__focusReviewReq = requestId;
      elReviewSummary.textContent = 'Loading review summary…';
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/review-intelligence', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({}),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (window.__focusReviewReq !== requestId) return;
          if (!data || !data.success) {
            elReviewSummary.textContent = 'No AI summary available yet.';
            return;
          }
          var msg = renderReviewSummaryText(data.strengths, data.weaknesses, data.sourceNote);
          elReviewSummary.textContent = msg || 'No AI summary available yet.';
        })
        .catch(function () {
          if (window.__focusReviewReq === requestId) {
            elReviewSummary.textContent = 'No AI summary available right now.';
          }
        });
    }

    function setCopyFeedback(msg, isError) {
      if (!elCopyFeedback) return;
      elCopyFeedback.textContent = msg || '';
      elCopyFeedback.classList.toggle('text-red-500', Boolean(isError));
      elCopyFeedback.classList.toggle('text-brand-muted', !isError);
      if (window.__focusCopyTimer) clearTimeout(window.__focusCopyTimer);
      if (msg) {
        window.__focusCopyTimer = setTimeout(function () {
          elCopyFeedback.textContent = '';
          elCopyFeedback.classList.remove('text-red-500');
          elCopyFeedback.classList.add('text-brand-muted');
        }, 1800);
      }
    }

    function setOutcomeFeedback(msg, isError) {
      if (!elOutcomeFeedback) return;
      elOutcomeFeedback.textContent = msg || '';
      elOutcomeFeedback.classList.toggle('text-rose-600', !!isError);
      elOutcomeFeedback.classList.toggle('text-emerald-700', !!msg && !isError);
      elOutcomeFeedback.classList.toggle('text-brand-muted', !msg);
      if (window.__focusOutcomeTimer) clearTimeout(window.__focusOutcomeTimer);
      if (!msg) return;
      window.__focusOutcomeTimer = setTimeout(function () {
        if (elOutcomeFeedback) {
          elOutcomeFeedback.textContent = '';
          elOutcomeFeedback.classList.remove('text-rose-600', 'text-emerald-700');
          elOutcomeFeedback.classList.add('text-brand-muted');
        }
      }, 2800);
    }

    function outcomeLabel(v) {
      var map = {
        voicemail: 'Went to voicemail',
        no_pickup: 'No pickup',
        talked_owner: 'Talked to business owner',
        callback_requested: 'Callback requested',
        sent_sms: 'Sent SMS',
        sent_email: 'Sent email',
        other: 'Other',
      };
      return map[String(v || '').trim()] || '';
    }

    function ensureSuggestedOutcome() {
      if (!elOutcome || String(elOutcome.value || '').trim()) return;
      if (currentChannel === 'voicemail-drop') elOutcome.value = 'voicemail';
      else if (currentChannel === 'sms') elOutcome.value = 'sent_sms';
      else if (currentChannel === 'email') elOutcome.value = 'sent_email';
      syncQuickOutcomeButtons();
    }

    function syncQuickOutcomeButtons() {
      if (!elQuickOutcomeBtns || !elQuickOutcomeBtns.length || !elOutcome) return;
      var selected = String(elOutcome.value || '').trim();
      elQuickOutcomeBtns.forEach(function (btn) {
        btn.classList.remove(
          'border-brand-yellow', 'bg-brand-yellow/15', 'text-brand-dark', 'dark:text-brand-yellow',
          'border-violet-500/60', 'bg-violet-500/15', 'text-violet-800', 'dark:text-violet-200',
          'border-blue-500/60', 'bg-blue-500/15', 'text-blue-800', 'dark:text-blue-200',
          'border-brand-border/80', 'dark:border-white/25', 'bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-100',
          'border-emerald-500/60', 'bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-200'
        );
        var active = String(btn.getAttribute('data-outcome') || '') === selected;
        btn.setAttribute('data-active', active ? 'true' : 'false');
        if (!active) return;
        var outcome = String(btn.getAttribute('data-outcome') || '');
        if (outcome === 'voicemail') {
          btn.classList.add('border-violet-500/60', 'bg-violet-500/15', 'text-violet-800', 'dark:text-violet-200');
        } else if (outcome === 'sent_sms') {
          btn.classList.add('border-blue-500/60', 'bg-blue-500/15', 'text-blue-800', 'dark:text-blue-200');
        } else if (outcome === 'sent_email') {
          btn.classList.add('border-brand-border/80', 'dark:border-white/25', 'bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-100');
        } else if (outcome === 'talked_owner') {
          btn.classList.add('border-emerald-500/60', 'bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-200');
        } else {
          btn.classList.add('border-brand-yellow', 'bg-brand-yellow/15', 'text-brand-dark', 'dark:text-brand-yellow');
        }
      });
      if (elSelectedOutcomeLabel) {
        var label = outcomeLabel(selected);
        elSelectedOutcomeLabel.textContent = 'Selected: ' + (label || 'none');
      }
    }

    function quickSetOutcome(value) {
      if (!elOutcome) return;
      var v = String(value || '').trim();
      if (!v) return;
      elOutcome.value = v;
      syncQuickOutcomeButtons();
      if (elOutcomeNotes) {
        var existing = String(elOutcomeNotes.value || '').trim();
        var templates = {
          no_pickup: 'No pickup. Retry in next calling window.',
          voicemail: 'Left voicemail with value prop and callback number.',
          talked_owner: 'Spoke with owner. Interested - follow up with tailored recap.',
          callback_requested: 'Requested callback. Confirm best time and call back as scheduled.',
          sent_sms: 'Sent SMS follow-up with short CTA.',
          sent_email: 'Sent follow-up email with concise summary and CTA.',
        };
        if (!existing && templates[v]) {
          elOutcomeNotes.value = templates[v];
        }
      }
      if (elFollowupEnable && (v === 'callback_requested' || v === 'talked_owner')) {
        elFollowupEnable.checked = true;
        if (elFollowupWrap) elFollowupWrap.classList.remove('hidden');
      }
      setOutcomeFeedback('Outcome set: ' + (outcomeLabel(v) || v.replace(/_/g, ' ')), false);
    }

    function copyLeadField(field, label) {
      var lead = currentLead();
      if (!lead) return;
      var value = String(lead[field] || '').trim();
      if (!value) {
        setCopyFeedback('No ' + label.toLowerCase() + ' available for this lead.', true);
        return;
      }
      navigator.clipboard.writeText(value)
        .then(function () {
          setCopyFeedback(label + ' copied');
        })
        .catch(function () {
          setCopyFeedback('Could not copy ' + label.toLowerCase() + '.', true);
        });
    }

    function setChannelButtons() {
      channelBtns.forEach(function (b) {
        var isActive = b.getAttribute('data-channel') === currentChannel;
        b.setAttribute('data-active', isActive ? 'true' : 'false');
        b.classList.remove(
          'border-brand-yellow', 'bg-brand-yellow/15', 'text-brand-dark', 'dark:text-brand-yellow',
          'border-blue-500/60', 'bg-blue-500/15', 'text-blue-800', 'dark:text-blue-200',
          'border-violet-500/60', 'bg-violet-500/15', 'text-violet-800', 'dark:text-violet-200',
          'border-emerald-500/60', 'bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-200'
        );
        if (!isActive) return;
        var ch = b.getAttribute('data-channel');
        if (ch === 'email') {
          b.classList.add('border-brand-border', 'dark:border-white/25', 'bg-white', 'dark:bg-slate-800', 'text-brand-dark', 'dark:text-white');
        } else if (ch === 'sms') {
          b.classList.add('border-blue-500/60', 'bg-blue-500/15', 'text-blue-800', 'dark:text-blue-200');
        } else if (ch === 'voicemail-drop') {
          b.classList.add('border-violet-500/60', 'bg-violet-500/15', 'text-violet-800', 'dark:text-violet-200');
        } else if (ch === 'call-script') {
          b.classList.add('border-emerald-500/60', 'bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-200');
        }
      });
    }

    function setPrimaryActionVisual() {
      var map = {
        'call-script': btnCall,
        'voicemail-drop': btnVoicemail,
        sms: btnSms,
        email: btnEmail,
      };
      [btnCall, btnVoicemail, btnSms, btnEmail].forEach(function (btn) {
        if (!btn) return;
        btn.classList.add('opacity-55', 'saturate-50');
        btn.classList.remove('ring-2', 'ring-brand-yellow/40', 'shadow-md', 'opacity-100', 'saturate-100');
      });
      var activeBtn = map[currentChannel];
      if (activeBtn) {
        activeBtn.classList.remove('opacity-55', 'saturate-50');
        activeBtn.classList.add('ring-2', 'ring-brand-yellow/40', 'shadow-md', 'opacity-100', 'saturate-100');
      }
    }

    function applyChannelUI() {
      var isEmail = currentChannel === 'email';
      elSubjectWrap.classList.toggle('hidden', !isEmail);
      setChannelButtons();
      setPrimaryActionVisual();
      setChannelHint();
      updateBodyLabel();
      updateDialerCta();
    }

    function currentLead() {
      return queue[idx] || null;
    }

    function renderCard() {
      var lead = currentLead();
      if (!lead) {
        elSection.classList.add('hidden');
        elEmpty.classList.remove('hidden');
        elEmptyReload.classList.add('hidden');
        elEmptyTitle.textContent = 'No leads in this queue';
        elEmptyDesc.textContent = 'Add or import leads to your pipeline, then come back.';
        return;
      }
      elEmpty.classList.add('hidden');
      elSection.classList.remove('hidden');
      elCompany.textContent = lead.title || '—';
      elContact.textContent = lead.contactName || '—';
      elStage.textContent = lead.pipelineLabel || ('Stage ' + lead.pipelineStage);
      elLast.textContent = lead.lastTouchLabel || '—';
      renderLinks(lead);
      renderBusinessInfo(lead);
      if (elRecommended) elRecommended.classList.remove('hidden');
      if (elServiceSelect) {
        elServiceSelect.value = 'auto';
      }
      if (elRecommendedHint) {
        elRecommendedHint.textContent = 'Loading best angle for this lead…';
      }
      if (elProductOptions) {
        elProductOptions.classList.add('hidden');
      }
      if (elRecommendedToggle) {
        elRecommendedToggle.setAttribute('aria-expanded', 'false');
      }
      currentChannel = lead.defaultChannel || 'email';
      var hasEmail = Boolean(String(lead.email || '').trim());
      var hasPhone = Boolean(String(lead.phone || '').trim());
      if (!hasEmail && hasPhone && !lead.defaultChannel) {
        currentChannel = 'voicemail-drop';
      }
      if (currentChannel === 'dm' || currentChannel === 'objection-handling') {
        currentChannel = 'call-script';
      }
      if (currentChannel !== 'email' && currentChannel !== 'call-script' && currentChannel !== 'voicemail-drop' && currentChannel !== 'sms') {
        currentChannel = 'email';
      }
      if (elOutcome) elOutcome.value = '';
      syncQuickOutcomeButtons();
      if (elOutcomeNotes) elOutcomeNotes.value = '';
      if (elFollowupEnable) elFollowupEnable.checked = false;
      if (elFollowupWrap) elFollowupWrap.classList.add('hidden');
      if (elFollowupAt) elFollowupAt.value = '';
      setOutcomeFeedback('');
      applyChannelUI();
      fetchReviewSummary();
    }

    function buildNoteText() {
      var ch = currentChannel;
      var body = (elBody.value || '').trim();
      var out = outcomeLabel(elOutcome && elOutcome.value);
      var outNotes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      var note = '[Focus · call script]\n\n' + body;
      if (ch === 'email') {
        var sub = (elSubject.value || '').trim();
        note = sub ? '[Focus · email] ' + sub + '\n\n' + body : '[Focus · email]\n\n' + body;
      } else if (ch === 'voicemail-drop') {
        note = '[Focus · voicemail drop]\n\n' + body;
      } else if (ch === 'sms') {
        note = '[Focus · sms]\n\n' + body;
      } else if (ch === 'dm') {
        note = '[Focus · DM]\n\n' + body;
      } else if (ch === 'objection-handling') {
        note = '[Focus · objection handling]\n\n' + body;
      }
      if (out) note += '\n\nOutcome: ' + out;
      if (outNotes) note += '\nNotes: ' + outNotes;
      return note;
    }

    function createFollowupTaskIfRequested() {
      var lead = currentLead();
      if (!lead) return Promise.resolve();
      if (!elFollowupEnable || !elFollowupEnable.checked) return Promise.resolve();
      var when = String((elFollowupAt && elFollowupAt.value) || '').trim();
      if (!when) {
        setOutcomeFeedback('Choose follow-up date and time.', true);
        return Promise.reject(new Error('missing follow-up datetime'));
      }
      var parsed = new Date(when);
      if (Number.isNaN(parsed.getTime())) {
        setOutcomeFeedback('Invalid follow-up date/time.', true);
        return Promise.reject(new Error('invalid follow-up datetime'));
      }
      var whenIso = parsed.toISOString();
      var out = outcomeLabel(elOutcome && elOutcome.value) || 'Follow-up';
      var notes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      var title = 'Follow up: ' + (lead.title || 'Lead') + ' — ' + out;
      if (notes) title += ' (' + notes.slice(0, 80) + ')';
      return fetch('/tasks/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          title: title,
          column: 'todo',
          scheduledAt: whenIso,
          leadKey: lead.key,
        }),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.j || !res.j.success) {
            throw new Error((res.j && res.j.error) || 'Could not create follow-up task.');
          }
          setOutcomeFeedback('Follow-up task scheduled.', false);
        });
    }

    function fetchDraft() {
      var lead = currentLead();
      if (!lead) return Promise.resolve();
      var ch = currentChannel;
      if (ch === 'voicemail-drop') {
        ch = 'voicemail';
      }
      if (ch === 'dm' || ch === 'objection-handling') {
        ch = 'call-script';
      }
      var scriptVariant = elScriptVariant && elScriptVariant.value ? elScriptVariant.value : 'default';
      return fetch('/sales/draft-outreach', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          leadId: lead.key,
          channel: ch,
          scriptVariant: scriptVariant,
          serviceKey: elServiceSelect && elServiceSelect.value ? elServiceSelect.value : 'auto',
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.success) return;
          elSubject.value = data.subject || '';
          elBody.value = data.body || '';
          if (data.scriptVariant && elScriptVariant) {
            elScriptVariant.value = data.scriptVariant;
          }
          applyRecommendedFromDraft(data);
        })
        .catch(function () {
          if (elRecommended) elRecommended.classList.remove('hidden');
          if (elRecommendedHint) {
            elRecommendedHint.textContent = 'Select a product angle above.';
          }
          if (elRecommendedToggle) {
            elRecommendedToggle.textContent = 'Use lead’s recommended';
          }
        });
    }

    function refreshMetrics() {
      return fetch('/focus/metrics.json', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.success) return;
          var n = data.touchesToday;
          touchGoal = data.touchGoal || touchGoal;
          countEl.textContent = n;
          document.getElementById('focus-touch-goal').textContent = touchGoal;
          var pct = touchGoal > 0 ? Math.min(100, Math.round((n / touchGoal) * 100)) : 0;
          fill.style.width = pct + '%';
          barWrap.setAttribute('aria-valuenow', String(n));
          barWrap.setAttribute('aria-valuemax', String(touchGoal));
          if (!celebrateDismissed && n >= touchGoal) {
            modalCelebrate.classList.remove('hidden');
          }
        })
        .catch(function () {});
    }

    function nextLead() {
      idx += 1;
      if (idx >= queue.length) {
        elSection.classList.add('hidden');
        elEmpty.classList.remove('hidden');
        elEmptyReload.classList.remove('hidden');
        elEmptyTitle.textContent = 'End of queue';
        elEmptyDesc.textContent = 'Reload for a fresh ordering, or head back to your pipeline.';
        return;
      }
      renderCard();
      fetchDraft();
    }

    function postNote() {
      var lead = currentLead();
      if (!lead) return Promise.resolve(null);
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/notes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ content: buildNoteText() }),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error('note failed');
          return j;
        });
      });
    }

    function maybeAdvanceStage() {
      var lead = currentLead();
      if (!lead) return Promise.resolve(null);
      var ps = parseInt(lead.pipelineStage, 10);
      if (ps !== 1 && ps !== 2) return Promise.resolve(null);
      var nextStage = ps + 1;
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          pipelineStage: nextStage,
          pipelineStageUpdatedAt: new Date().toISOString(),
        }),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error('stage update failed');
          lead.pipelineStage = nextStage;
          return j;
        });
      });
    }

    function onSendAdvance() {
      var lead = currentLead();
      if (!lead) return;
      ensureSuggestedOutcome();
      var actionBtn = null;
      if (currentChannel === 'call-script') actionBtn = btnCall;
      else if (currentChannel === 'voicemail-drop') actionBtn = btnVoicemail;
      else if (currentChannel === 'sms') actionBtn = btnSms;
      else actionBtn = btnEmail;
      if (actionBtn) actionBtn.disabled = true;
      var callStep = Promise.resolve();
      if (currentChannel === 'call-script') callStep = placeFocusCall();
      else if (currentChannel === 'voicemail-drop') callStep = placeFocusVoicemail();
      else if (currentChannel === 'sms') callStep = placeFocusSms();
      else if (currentChannel === 'email') callStep = placeFocusEmail();
      callStep
        .then(function () { return postNote(); })
        .then(function () { return createFollowupTaskIfRequested(); })
        .then(function () { return maybeAdvanceStage(); })
        .then(function () {
          nextLead();
          return refreshMetrics();
        })
        .catch(function (err) {
          setOutcomeFeedback(err && err.message ? err.message : 'Could not complete this action.', true);
        })
        .finally(function () { if (actionBtn) actionBtn.disabled = false; });
    }

    function onLogNext() {
      var lead = currentLead();
      if (!lead) return;
      btnLog.disabled = true;
      postNote()
        .then(function () { return createFollowupTaskIfRequested(); })
        .then(function () {
          nextLead();
          return refreshMetrics();
        })
        .catch(function () {})
        .finally(function () { btnLog.disabled = false; });
    }

    function onSkip() {
      nextLead();
    }

    channelBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        currentChannel = b.getAttribute('data-channel');
        applyChannelUI();
        fetchDraft();
      });
    });
    if (elScriptVariant) {
      elScriptVariant.addEventListener('change', function () {
        fetchDraft();
      });
    }
    if (elServiceSelect) {
      elServiceSelect.addEventListener('change', function () {
        fetchDraft();
      });
    }
    if (elRecommendedToggle && elProductOptions) {
      elRecommendedToggle.addEventListener('click', function () {
        var isOpen = !elProductOptions.classList.contains('hidden');
        elProductOptions.classList.toggle('hidden', isOpen);
        elRecommendedToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });
    }
    if (elProductOptionBtns && elProductOptionBtns.length && elServiceSelect) {
      elProductOptionBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-service-key') || '';
          if (!key) return;
          if (elServiceSelect.querySelector('option[value="' + key + '"]')) {
            elServiceSelect.value = key;
            fetchDraft();
          }
          if (elProductOptions) elProductOptions.classList.add('hidden');
          if (elRecommendedToggle) elRecommendedToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
    if (btnOpenDialer) {
      btnOpenDialer.addEventListener('click', function () {
        openDialerForLead();
      });
    }
    if (btnMobileCall) {
      btnMobileCall.addEventListener('click', function () {
        closeMobileFabActions();
        openDialerForLead();
      });
    }
    if (btnMobileLog) {
      btnMobileLog.addEventListener('click', function () {
        closeMobileFabActions();
        onLogNext();
      });
    }
    if (btnMobileSkip) {
      btnMobileSkip.addEventListener('click', function () {
        closeMobileFabActions();
        onSkip();
      });
    }
    if (elFollowupEnable && elFollowupWrap) {
      elFollowupEnable.addEventListener('change', function () {
        elFollowupWrap.classList.toggle('hidden', !elFollowupEnable.checked);
      });
    }
    if (elQuickOutcomeBtns && elQuickOutcomeBtns.length) {
      elQuickOutcomeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          quickSetOutcome(btn.getAttribute('data-outcome'));
        });
      });
    }
    if (btnMobileFabToggle && elMobileFabActions) {
      btnMobileFabToggle.addEventListener('click', function () {
        var isOpen = !elMobileFabActions.classList.contains('hidden');
        elMobileFabActions.classList.toggle('hidden', isOpen);
        btnMobileFabToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });
      document.addEventListener('click', function (e) {
        if (!elMobileFabWrap || elMobileFabWrap.classList.contains('hidden')) return;
        if (!elMobileFabWrap.contains(e.target)) closeMobileFabActions();
      });
    }

    if (btnCall) btnCall.addEventListener('click', function () { currentChannel = 'call-script'; applyChannelUI(); onSendAdvance(); });
    if (btnVoicemail) btnVoicemail.addEventListener('click', function () { currentChannel = 'voicemail-drop'; applyChannelUI(); onSendAdvance(); });
    if (btnSms) btnSms.addEventListener('click', function () { currentChannel = 'sms'; applyChannelUI(); onSendAdvance(); });
    if (btnEmail) btnEmail.addEventListener('click', function () { currentChannel = 'email'; applyChannelUI(); onSendAdvance(); });
    btnLog.addEventListener('click', onLogNext);
    btnSkip.addEventListener('click', onSkip);
    if (btnCopyPhone) btnCopyPhone.addEventListener('click', function () { copyLeadField('phone', 'Phone'); });
    if (btnCopyEmail) btnCopyEmail.addEventListener('click', function () { copyLeadField('email', 'Email'); });
    if (btnCopyWebsite) btnCopyWebsite.addEventListener('click', function () { copyLeadField('website', 'Website'); });

    document.getElementById('focus-help-btn').addEventListener('click', function () {
      modalHelp.classList.remove('hidden');
    });
    document.getElementById('focus-help-close').addEventListener('click', function () {
      modalHelp.classList.add('hidden');
    });
    modalHelp.addEventListener('click', function (e) {
      if (e.target === modalHelp) modalHelp.classList.add('hidden');
    });
    document.getElementById('focus-celebrate-continue').addEventListener('click', function () {
      celebrateDismissed = true;
      modalCelebrate.classList.add('hidden');
    });
    modalCelebrate.addEventListener('click', function (e) {
      if (e.target === modalCelebrate) {
        celebrateDismissed = true;
        modalCelebrate.classList.add('hidden');
      }
    });

    function typingTarget(el) {
      if (!el) return false;
      var tag = el.tagName;
      if (tag === 'TEXTAREA') return true;
      if (tag === 'SELECT') return true;
      if (tag === 'INPUT') return el.type !== 'button' && el.type !== 'submit' && el.type !== 'checkbox' && el.type !== 'radio';
      return el.isContentEditable;
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        modalHelp.classList.add('hidden');
        celebrateDismissed = true;
        modalCelebrate.classList.add('hidden');
      }
      if (e.key === '?' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        modalHelp.classList.toggle('hidden');
      }
      if (e.key === 'e' || e.key === 'E') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        elBody.focus();
      }
      if (e.key === 'l' || e.key === 'L') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        onLogNext();
      }
      if (e.key === 'j' || e.key === 'J') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        onSkip();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        onSendAdvance();
      }
    });

    elEmptyReload.addEventListener('click', function () {
      location.reload();
    });
    window.addEventListener('resize', updateDialerCta);

    if (!queue.length) {
      elSection.classList.add('hidden');
      elEmpty.classList.remove('hidden');
      elEmptyReload.classList.add('hidden');
    } else {
      renderCard();
      fetchDraft();
      var initial = parseInt(countEl.textContent, 10) || 0;
      if (initial >= touchGoal) modalCelebrate.classList.remove('hidden');
    }
  })();
  </script>
</body>
</html>
