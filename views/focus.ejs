    function pushFocusLeadToGhl() {
      if (window.__focusPushGhlInFlight) return Promise.resolve();
      var lead = currentLead();
      if (!lead) {
        setOutcomeFeedback('No lead loaded.', true);
        return Promise.resolve();
      }
      var key = String(lead.key || '').trim();
      if (!key) {
        setOutcomeFeedback('Save this lead before pushing to GHL.', true);
        return Promise.resolve();
      }

      var labelDefault = 'Push GHL';
      window.__focusPushGhlInFlight = true;
      if (btnPushGhl) {
        btnPushGhl.disabled = true;
        btnPushGhl.setAttribute('aria-busy', 'true');
        btnPushGhl.classList.add('is-busy');
        btnPushGhl.textContent = 'Pushing…';
      }
      setOutcomeFeedback('Syncing to Go High Level…', false);

      var payload = { leadKeys: [key] };
      var website = lead.website ? String(lead.website).trim() : '';
      if (!website || website === 'N/A' || website === '—') payload.tagNoWebsite = true;

      return fetch('/ghl/push', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'GHL push failed');
            return j;
          });
        })
        .then(function (data) {
          var msg = payload.tagNoWebsite
            ? 'GHL sync complete (tagged no website).'
            : 'GHL sync complete.';
          setOutcomeFeedback(msg, false);
          setCopyFeedback(msg, false);
          if (btnPushGhl) {
            btnPushGhl.textContent = '✓ Synced';
            if (window.__focusPushGhlFlashTimer) clearTimeout(window.__focusPushGhlFlashTimer);
            window.__focusPushGhlFlashTimer = setTimeout(function () {
              if (btnPushGhl) {
                btnPushGhl.textContent = labelDefault;
                btnPushGhl.classList.remove('is-busy');
                btnPushGhl.removeAttribute('aria-busy');
              }
            }, 1600);
          }
          return data;
        })
        .catch(function (err) {
          var errMsg = err && err.message ? err.message : 'Could not push to GHL.';
          setOutcomeFeedback(errMsg, true);
          setCopyFeedback(errMsg, true);
          if (btnPushGhl) {
            btnPushGhl.textContent = 'Failed';
            if (window.__focusPushGhlFlashTimer) clearTimeout(window.__focusPushGhlFlashTimer);
            window.__focusPushGhlFlashTimer = setTimeout(function () {
              if (btnPushGhl) {
                btnPushGhl.textContent = labelDefault;
                btnPushGhl.classList.remove('is-busy');
                btnPushGhl.removeAttribute('aria-busy');
              }
            }, 1200);
          }
          throw err;
        })
        .finally(function () {
          window.__focusPushGhlInFlight = false;
          if (btnPushGhl) btnPushGhl.disabled = false;
        });
    }
    window.__pushFocusLeadToGhl = pushFocusLeadToGhl;

    function placeFocusCall() {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/call', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Call failed');
            return j;
          });
        })
        .then(function (data) {
          var dialMode = String((data && data.dialMode) || '').trim();
          var phone = String((data && data.phone) || (lead.phone || '')).replace(/[^\d+]/g, '');
          if (dialMode === 'browser_device' && phone) {
            setCopyFeedback('Opening your dialer...');
            window.location.href = 'tel:' + phone;
          } else {
            setCopyFeedback('Cloud call started.');
          }
          return data;
        })
        .catch(function (err) {
          setCopyFeedback(err && err.message ? err.message : 'Could not start call.', true);
          throw err;
        });
    }

