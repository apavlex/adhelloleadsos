        if (focusSoftphoneDialLead(lead, true)) {
          setOutcomeFeedback('Dialing via softphone…');
          return Promise.resolve({ softphone: true });
        }
      }
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/call', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Call failed');
            return j;
          });
