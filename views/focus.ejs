    function focusQuickLogItemForValue(value) {
      var v = String(value || '').trim();
      if (!v) return null;
      if (v.indexOf('status:') === 0) {
        var status = v.slice(7);
        return focusQuickLogItems().find(function (i) { return i.status === status; }) || null;
      }
      return focusQuickLogItems().find(function (i) { return i.disposition === v; }) || null;
    }

    function focusBtnSelectionValue(btn) {
