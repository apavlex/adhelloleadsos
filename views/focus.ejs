    function mapQueryFromFocusLead(lead) {
      var addr = String((lead && lead.address) || '').trim();
      if (addr) return addr;
      var cs = [lead.city || '', lead.state || ''].filter(Boolean).join(', ');
      var title = String((lead && lead.title) || '').trim();
      return [title, cs].filter(Boolean).join(' ').trim();
    }

    var focusMapLoadGen = 0;

    function buildFocusStaticMapUrl(center, key, width, height) {
      var c = String(center || '').trim();
      var k = String(key || '').trim();
      if (!c || !k) return '';
      var w = Math.min(640, Math.max(100, parseInt(width, 10) || 560));
      var h = Math.min(640, Math.max(100, parseInt(height, 10) || 420));
      return (
        'https://maps.googleapis.com/maps/api/staticmap?center=' +
        encodeURIComponent(c) +
        '&zoom=15&size=' +
        w +
        'x' +
        h +
        '&scale=2&maptype=roadmap&markers=' +
        encodeURIComponent('color:0xEAB308|' + c) +
        '&key=' +
        encodeURIComponent(k)
      );
    }

    function renderFocusMap(lead) {
      var wrap = document.getElementById('focus-map-wrap');
      var img = document.getElementById('focus-map-img');
      var fallback = document.getElementById('focus-map-fallback');
      var openLink = document.getElementById('focus-map-open-link');
      if (!wrap || !img) return;
      var q = mapQueryFromFocusLead(lead);
      if (!q) {
        wrap.classList.add('hidden');
        img.onload = null;
        img.onerror = null;
        img.removeAttribute('src');
        img.classList.add('hidden');
        if (fallback) {
          fallback.classList.add('hidden');
          fallback.classList.remove('flex');
        }
        return;
      }

      var mapsHref = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
      if (openLink) {
        openLink.href = mapsHref;
        openLink.classList.remove('hidden');
      }

      var key =
        typeof window !== 'undefined' && window.__ADHELLO_GOOGLE_MAPS_STATIC_KEY__
          ? String(window.__ADHELLO_GOOGLE_MAPS_STATIC_KEY__).trim()
          : '';

      var loadGen = ++focusMapLoadGen;
      function isCurrentLoad() {
        return loadGen === focusMapLoadGen;
      }

      function showFallback() {
        if (!isCurrentLoad()) return;
        img.onload = null;
        img.onerror = null;
        img.removeAttribute('src');
        img.classList.add('hidden');
        if (fallback) {
          fallback.classList.remove('hidden');
          fallback.classList.add('flex');
        }
      }

      function revealImage() {
        if (!isCurrentLoad()) return;
        img.classList.remove('hidden');
        if (fallback) {
          fallback.classList.add('hidden');
          fallback.classList.remove('flex');
        }
      }

      function loadPreviewImage(previewUrl, onFail) {
        img.alt = lead && lead.title ? 'Map near ' + String(lead.title).slice(0, 80) : 'Business location map';
        img.onload = function () {
          if (!isCurrentLoad()) return;
          revealImage();
        };
        img.onerror = function () {
          if (!isCurrentLoad()) return;
          if (typeof onFail === 'function') onFail();
          else showFallback();
        };
        img.classList.add('hidden');
        img.src = previewUrl;
      }

      wrap.classList.remove('hidden');
      if (fallback) {
        fallback.classList.add('hidden');
        fallback.classList.remove('flex');
      }

      var params = new URLSearchParams();
      params.set('center', q);
      if (lead && lead.latitude != null && lead.longitude != null && Number.isFinite(Number(lead.latitude)) && Number.isFinite(Number(lead.longitude))) {
        params.set('lat', String(lead.latitude));
        params.set('lng', String(lead.longitude));
      }
      params.set('w', '560');
      params.set('h', '420');

      loadPreviewImage('/leads/map-preview?' + params.toString(), function () {
        if (!isCurrentLoad()) return;
        var clientStatic = buildFocusStaticMapUrl(q, key, 560, 420);
        if (clientStatic) {
          loadPreviewImage(clientStatic, showFallback);
        } else {
          showFallback();
        }
      });
    }

