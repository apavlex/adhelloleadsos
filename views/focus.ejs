    function googleMapsSocialHrefFromLead(lead) {
      var raw = lead.url && lead.url !== 'N/A' ? String(lead.url).trim() : '';
      function isGmListing(absUrl) {
        try {
          var u = new URL(absUrl);
          var h = u.hostname.replace(/^www\./i, '').toLowerCase();
          if (h === 'maps.app.goo.gl') return true;
          if (h === 'goo.gl' && u.pathname.indexOf('maps') !== -1) return true;
          if (h.endsWith('google.com') || h.endsWith('google.co.uk')) {
            if (u.pathname.indexOf('/maps/') !== -1) return true;
            if (u.search.indexOf('cid=') !== -1 || u.search.indexOf('q=place_id:') !== -1) return true;
          }
          return false;
        } catch (e) {
          return false;
        }
