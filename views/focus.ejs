          if (!res.ok || !data.success) throw new Error((data && data.error) || 'GHL sync failed');
          return data;
        })
        .then(function (data) {
          var payload = focusGhlPushPayload(lead);
          postNote().catch(function () { /* note is optional after GHL sync */ });
          var result = data.results && data.results.length ? data.results[0] : null;
          var actionTags = result && Array.isArray(result.actionTags) ? result.actionTags : [];
          var tagLabel = actionTags.length
            ? actionTags[0].replace(/^AO:\s*/i, '')
            : (payload.disposition ? payload.disposition.replace(/_/g, ' ') : '');
          var msg = 'GHL sync complete';
          if (tagLabel) msg += ' · AO: ' + tagLabel;
          if (payload.tagNoWebsite) msg += ' · no website';
          setOutcomeFeedback(msg, false);
          setCopyFeedback(msg, false);
          if (btnPushGhl) {
