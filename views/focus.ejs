  <div id="focus-modal-help" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="focus-help-title">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 shadow-xl max-w-md w-full p-6">
      <h2 id="focus-help-title" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Keyboard shortcuts</h2>
      <ul class="space-y-2 text-sm text-brand-dark dark:text-slate-200">
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">E</kbd> — Focus draft textarea</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">⌘/Ctrl</kbd> + <kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">Enter</kbd> — Send &amp; advance</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">L</kbd> — Log &amp; next</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">N</kbd> — Call next (log, advance &amp; dial)</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">J</kbd> — Skip</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">D</kbd> — Delete lead</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">?</kbd> — This sheet</li>
        <li><kbd class="font-mono text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">Esc</kbd> — Close</li>
      </ul>
      <button type="button" id="focus-help-close" class="mt-6 w-full btn-pill btn-primary py-3 text-xs font-black uppercase tracking-widest">Got it</button>
