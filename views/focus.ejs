    function pickWhyCta(reason) {
      var r = String(reason || '').toLowerCase();
      for (var key in WHY_CTA_MAP) {
        if (r.indexOf(key.toLowerCase()) !== -1) return WHY_CTA_MAP[key];
      }
      return { label: 'Opportunity', cls: 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow' };
    }

    function renderWhyReasons(lead) {
      if (!elWhySection || !elWhyReasons) return;
      var reasons = lead.whyReasons;
      if (!reasons || !Array.isArray(reasons) || !reasons.length) {
        elWhySection.classList.add('hidden');
        return;
      }
      elWhySection.classList.remove('hidden');
      elWhyReasons.innerHTML = '';
      reasons.forEach(function (r) {
        var cta = pickWhyCta(r);
        var pill = document.createElement('span');
        pill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border ' + cta.cls;
        pill.textContent = cta.label;
        var reason = document.createElement('span');
        reason.className = 'text-[11px] font-semibold text-brand-dark dark:text-slate-200 ml-1';
        reason.textContent = String(r);
        var row = document.createElement('div');
        row.className = 'flex flex-wrap items-center gap-2';
        row.appendChild(pill);
        row.appendChild(reason);
        elWhyReasons.appendChild(row);
      });
    }

    function renderReviewSummaryText(strengths, weaknesses, sourceNote) {
      var bits = [];
      if (Array.isArray(strengths) && strengths.length) {
        bits.push('Strength: ' + String(strengths[0]));
      }
      if (Array.isArray(weaknesses) && weaknesses.length) {
        bits.push('Risk: ' + String(weaknesses[0]));
      }
      if (sourceNote) bits.push(String(sourceNote));
      return bits.join(' ');
    }

    function fetchReviewSummary() {
      var lead = currentLead();
      if (!elReviewSummary) return Promise.resolve();
      if (!lead || !lead.key) {
        elReviewSummary.textContent = 'No lead selected.';
        return Promise.resolve();
      }
      var requestId = String(lead.key) + '|' + Date.now();
      window.__focusReviewReq = requestId;
      elReviewSummary.textContent = 'Loading review summary…';
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/review-intelligence', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({}),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (window.__focusReviewReq !== requestId) return;
          if (!data || !data.success) {
            elReviewSummary.textContent = 'No AI summary available yet.';
            return;
          }
          var msg = renderReviewSummaryText(data.strengths, data.weaknesses, data.sourceNote);
          elReviewSummary.textContent = msg || 'No AI summary available yet.';
        })
        .catch(function () {
          if (window.__focusReviewReq === requestId) {
            elReviewSummary.textContent = 'No AI summary available right now.';
          }
        });
    }

    function setCopyFeedback(msg, isError) {
      if (!elCopyFeedback) return;
      elCopyFeedback.textContent = msg || '';
      elCopyFeedback.classList.toggle('text-red-500', Boolean(isError));
      elCopyFeedback.classList.toggle('text-brand-muted', !isError);
      if (window.__focusCopyTimer) clearTimeout(window.__focusCopyTimer);
      if (msg) {
        window.__focusCopyTimer = setTimeout(function () {
          elCopyFeedback.textContent = '';
          elCopyFeedback.classList.remove('text-red-500');
          elCopyFeedback.classList.add('text-brand-muted');
        }, 1800);
      }
    }

