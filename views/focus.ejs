  <div id="focus-modal-celebrate" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-dark/50 dark:bg-black/60" role="dialog" aria-modal="true" aria-labelledby="focus-celebrate-title">
    <div class="bg-white dark:bg-slate-900 rounded-[2rem] border-2 border-brand-yellow/50 shadow-xl max-w-md w-full p-8 text-center">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Goal hit</p>
      <h2 id="focus-celebrate-title" class="font-display font-black text-2xl text-brand-dark dark:text-white mb-3">You hit your touch goal 🎯</h2>
      <p class="text-sm text-brand-muted mb-8">Nice work. Keep the streak or call it a day.</p>
      <div class="flex flex-col gap-3">
        <button type="button" id="focus-celebrate-continue" class="btn-pill btn-primary py-3.5 text-xs font-black uppercase tracking-widest">Keep going</button>
        <a href="/today" id="focus-celebrate-done" class="btn-pill border-2 border-brand-border dark:border-white/20 py-3.5 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white text-center">Done for today</a>
      </div>
    </div>
  </div>

  <script type="application/json" id="focus-queue-json"><%- typeof focusQueueJson !== 'undefined' ? focusQueueJson : '[]' %></script>
  <script type="application/json" id="focus-script-library-json"><%- typeof focusScriptLibraryJson !== 'undefined' ? focusScriptLibraryJson : '{}' %></script>
  <script>
  (function () {
    var FOCUS_PRODUCT_STORAGE_KEY = 'focusProductKey';
    var focusScriptLibrary = {};
    try {
      focusScriptLibrary = JSON.parse(document.getElementById('focus-script-library-json').textContent || '{}');
    } catch (e) {
      focusScriptLibrary = {};
    }

    var queue = [];
    try {
      queue = JSON.parse(document.getElementById('focus-queue-json').textContent || '[]');
    } catch (e) {
      queue = [];
    }

    var idx = 0;
    var currentChannel = 'call-script';
    var touchGoal = parseInt(document.getElementById('focus-touch-goal').textContent, 10) || 54;
    var celebrateDismissed = false;

    var elEmpty = document.getElementById('focus-empty');
    var elEmptyTitle = document.getElementById('focus-empty-title');
    var elEmptyDesc = document.getElementById('focus-empty-desc');
    var elEmptyReload = document.getElementById('focus-empty-reload');
    var elSection = document.getElementById('focus-card-section');
    var elCompany = document.getElementById('focus-company');
    var elContact = document.getElementById('focus-contact');
    var elStage = document.getElementById('focus-stage-badge');
    var elLast = document.getElementById('focus-last-touch');
    var elLinks = document.getElementById('focus-links');
    var elBizWebsite = document.getElementById('focus-biz-website');
    var elBizLocation = document.getElementById('focus-biz-location');
    var elBizCategory = document.getElementById('focus-biz-category');
    var elBizReviews = document.getElementById('focus-biz-reviews');
    var elBizReviewStars = document.getElementById('focus-biz-review-stars');
    var elReviewSummary = document.getElementById('focus-review-summary');
    var elOwnerSignal = document.getElementById('focus-owner-signal');
    var elBizSocials = document.getElementById('focus-biz-socials');
    var btnCopyPhone = document.getElementById('focus-copy-phone');
    var btnCopyEmail = document.getElementById('focus-copy-email');
    var btnCopyWebsite = document.getElementById('focus-copy-website');
    var elCopyFeedback = document.getElementById('focus-copy-feedback');
    var elOutcome = document.getElementById('focus-outcome');
    var elSelectedOutcomeLabel = document.getElementById('focus-selected-outcome-label');
    var elQuickOutcomeBtns = document.querySelectorAll('.focus-quick-outcome');
    var elOutcomeNotes = document.getElementById('focus-outcome-notes');
    var elFollowupEnable = document.getElementById('focus-followup-enable');
    var elFollowupWrap = document.getElementById('focus-followup-wrap');
    var elFollowupAt = document.getElementById('focus-followup-at');
    var elOutcomeFeedback = document.getElementById('focus-outcome-feedback');
    var elSubjectWrap = document.getElementById('focus-subject-wrap');
    var elSubject = document.getElementById('focus-subject');
    var elBody = document.getElementById('focus-body');
    var channelBtns = document.querySelectorAll('.focus-channel-btn');
    var btnCall = document.getElementById('focus-btn-call');
    var btnPushGhl = document.getElementById('focus-btn-push-ghl');
    var btnLog = document.getElementById('focus-btn-log');
    var btnSkip = document.getElementById('focus-btn-skip');
    var btnCallNext = document.getElementById('focus-btn-call-next');
    var btnDelete = document.getElementById('focus-btn-delete');
    var autoDialNext = false;
    var modalHelp = document.getElementById('focus-modal-help');
    var modalCelebrate = document.getElementById('focus-modal-celebrate');
    var fill = document.getElementById('focus-progress-fill');
    var countEl = document.getElementById('focus-touch-count');
    var barWrap = document.getElementById('focus-progress-bar-wrap');
    var elServiceSelect = document.getElementById('focus-service-select');
    var elChannelHint = document.getElementById('focus-channel-hint');
    var elScriptVariant = document.getElementById('focus-script-variant');
    var elTone = document.getElementById('focus-tone');
    var btnOpenDialer = document.getElementById('focus-btn-open-dialer');
    var elBodyLabel = document.getElementById('focus-body-label');
    var elMobileFabWrap = document.getElementById('focus-mobile-fab-wrap');
    var elMobileFabActions = document.getElementById('focus-mobile-fab-actions');
    var btnMobileFabToggle = document.getElementById('focus-mobile-fab-toggle');
    var btnMobileCall = document.getElementById('focus-mobile-call');
    var btnMobileCallNext = document.getElementById('focus-mobile-call-next');
    var btnMobileLog = document.getElementById('focus-mobile-log');
    var btnMobileSkip = document.getElementById('focus-mobile-skip');
    var elOutcomePanel = document.getElementById('focus-outcome-panel');
    var elOutcomeDetails = document.getElementById('focus-outcome-details');
    var btnOutcomeCollapse = document.getElementById('focus-outcome-collapse-toggle');
    var elOutcomeCollapseIcon = document.getElementById('focus-outcome-collapse-icon');
    var elOutcomeHeading = document.getElementById('focus-outcome-heading');
    var elOutcomeShortcuts = document.getElementById('focus-outcome-shortcuts');
    var outcomePanelCollapsed = false;
    var elWhySection = document.getElementById('focus-why-section');
    var elWhyReasons = document.getElementById('focus-why-reasons');

    function setOutcomePanelCollapsed(collapsed) {
      outcomePanelCollapsed = !!collapsed;
      if (elOutcomePanel) {
        elOutcomePanel.setAttribute('data-collapsed', outcomePanelCollapsed ? 'true' : 'false');
      }
      if (elOutcomeDetails) {
        elOutcomeDetails.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeHeading) {
        elOutcomeHeading.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeShortcuts) {
        elOutcomeShortcuts.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (btnOutcomeCollapse) {
        btnOutcomeCollapse.setAttribute('aria-expanded', outcomePanelCollapsed ? 'false' : 'true');
        btnOutcomeCollapse.setAttribute('title', outcomePanelCollapsed ? 'Expand notes' : 'Collapse notes');
      }
      if (elOutcomeCollapseIcon) {
        elOutcomeCollapseIcon.classList.toggle('rotate-180', outcomePanelCollapsed);
      }
    }

    function isMobileViewport() {
      return window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    }
    function closeMobileFabActions() {
      if (elMobileFabActions) elMobileFabActions.classList.add('hidden');
      if (btnMobileFabToggle) btnMobileFabToggle.setAttribute('aria-expanded', 'false');
    }

    function normalizeTel(raw) {
      var s = String(raw || '').trim();
      if (!s) return '';
      var plus = s.indexOf('+') === 0 ? '+' : '';
      var digits = s.replace(/\D/g, '');
      if (!digits) return '';
      return plus + digits;
    }

    function openDialerForLead() {
      var lead = currentLead();
      if (!lead || !String(lead.phone || '').trim()) {
        setCopyFeedback('No phone on this lead.', true);
        return;
      }
      if (isMobileViewport()) {
        var to = normalizeTel(lead.phone);
        if (!to) {
          setCopyFeedback('Could not normalize this phone number.', true);
          return;
        }
        setCopyFeedback('Opening your phone app...');
        window.location.href = 'tel:' + to;
        return;
      }
      var navSoftphoneBtn = document.getElementById('navSoftphoneOpen') || document.getElementById('navSoftphoneOpenMobile');
      if (navSoftphoneBtn) navSoftphoneBtn.click();
      if (typeof window.__adhelloOpenSoftphoneWithDial === 'function') {
        if (!window.__adhelloOpenSoftphoneWithDial(lead.phone)) {
          setCopyFeedback('Could not normalize that phone number for the dialer.', true);
          return;
        }
        setCopyFeedback('Dialer opened with lead number loaded. Press Call in the softphone to dial.');
        updateDialerCta();
      } else {
        setCopyFeedback('Dialer opened. Copy phone if needed.', false);
      }
    }

    function setChannelHint() {
      if (!elChannelHint) return;
      elChannelHint.textContent =
        'Call: rehearse the script, dial, and log. Push GHL first if you need SMS, email, or voicemail in Go High Level.';
    }

    function updateBodyLabel() {
      if (!elBodyLabel) return;
      elBodyLabel.textContent = 'Call script';
    }

    function isSoftphoneOpen() {
      if (typeof window.__adhelloIsSoftphoneOpen === 'function') {
        return window.__adhelloIsSoftphoneOpen();
      }
      var spModal = document.getElementById('softphoneModal');
      return !!(spModal && !spModal.classList.contains('hidden'));
    }

    function updateDialerCta() {
      var lead = currentLead();
      var hasPhone = Boolean(lead && String(lead.phone || '').trim() && String(lead.phone) !== 'N/A');
      var dialerOpen = isSoftphoneOpen();
      if (btnOpenDialer) {
        btnOpenDialer.classList.toggle('hidden', !hasPhone || dialerOpen);
      }
      if (btnCallNext) {
        btnCallNext.classList.toggle('hidden', !hasPhone || currentChannel !== 'call-script');
      }
      if (elMobileFabWrap) {
        var showFab = isMobileViewport() && hasPhone;
        elMobileFabWrap.classList.toggle('hidden', !showFab);
        if (!showFab) closeMobileFabActions();
      }
    }

    function getDefaultProductKey() {
      var stored = '';
      try {
        stored = String(window.sessionStorage.getItem(FOCUS_PRODUCT_STORAGE_KEY) || '').trim();
      } catch (e) {
        stored = '';
      }
      if (stored && elServiceSelect && elServiceSelect.querySelector('option[value="' + stored + '"]')) {
        return stored;
      }
      if (elServiceSelect && elServiceSelect.options && elServiceSelect.options.length) {
        return elServiceSelect.options[0].value;
      }
      return 'reputation';
    }

    function rememberProductKey(key) {
      var k = String(key || '').trim();
      if (!k) return;
      try {
        window.sessionStorage.setItem(FOCUS_PRODUCT_STORAGE_KEY, k);
      } catch (e) {
        /* ignore */
      }
    }

    function applyScriptPlaceholders(text, contact, company, cityState) {
      return String(text || '')
        .replace(/\{\{name\}\}/gi, contact)
        .replace(/\{\{company\}\}/gi, company)
        .replace(/\{\{city\}\}/gi, cityState || 'your area');
    }

    function buildLocalFocusDraft(lead) {
      if (!lead) return { subject: '', body: '' };
      var serviceKey = elServiceSelect && elServiceSelect.value ? elServiceSelect.value : getDefaultProductKey();
      var scriptVariant = elScriptVariant && elScriptVariant.value ? elScriptVariant.value : 'default';
      var serviceBlock = focusScriptLibrary && focusScriptLibrary[serviceKey] ? focusScriptLibrary[serviceKey] : null;
      var company = String(lead.title || 'your team').trim() || 'your team';
      var em = String(lead.email || '').trim();
      var contact =
        String(lead.contactName || '').trim() ||
        (em && em.indexOf('@') !== -1 ? em.split('@')[0].replace(/[._]+/g, ' ') : '') ||
        'there';
      var cityState = [lead.city, lead.state].filter(Boolean).join(', ');
      var loc = cityState ? ' in ' + cityState : '';
      var svcLabel = (serviceBlock && serviceBlock.label) || serviceKey;
      var libOpen =
        serviceBlock && serviceBlock.opening
          ? applyScriptPlaceholders(serviceBlock.opening, contact, company, cityState)
          : '';
      var v = scriptVariant;
      var body = '';
      if (v === 'followup') {
        body =
          '[Opener] Hi, this is ___ for ' +
          contact +
          ' at ' +
          company +
          '. I tried you briefly — is now any better for a 30-second reason I called' +
          loc +
          '?\n\n[Bridge] Quick context: I help local service businesses with ' +
          svcLabel +
          '.\n\n[Ask] If you\'re the right person, is there a better time today I could try you back?';
      } else if (v === 'reengage' || v === 'short') {
        body =
          '[Opener] Hi, calling ' +
          contact +
          ' at ' +
          company +
          ' — I’m ___. Two sentences: I help with ' +
          svcLabel +
          ' for shops in ' +
          (cityState || 'this market') +
          '.\n\n[Ask] Who would I talk to about growth or marketing ?';
      } else if (libOpen) {
        body =
          'Product: ' +
          svcLabel +
          '\n\n[Opener] ' +
          libOpen +
          '\n\n[Bridge] I work with local businesses on filling the calendar and noticed you online' +
          loc +
          '.\n\n[Ask] Did I catch you at an okay time, or is there a better 5-minute block later?';
      } else {
        body =
          '[Opener] Hi, this is ___ calling for ' +
          contact +
          ' at ' +
          company +
          '. Did I catch you at an okay time?\n\n[Bridge] I work with local businesses on filling the calendar — noticed you online' +
          loc +
          ' (focus: ' +
          svcLabel +
          ').\n\n[Ask] If it makes sense, who handles marketing day-to-day?';
      }
      return { subject: '', body: body };
    }

    function updateDraftFromSelection() {
      var lead = currentLead();
      if (!lead) return;
      if (elServiceSelect && elServiceSelect.value) {
        rememberProductKey(elServiceSelect.value);
      }
      var draft = buildLocalFocusDraft(lead);
      if (elSubject) elSubject.value = draft.subject || '';
      if (elBody) elBody.value = draft.body || '';
    }

    function hrefUrl(u) {
      if (!u) return '';
      var s = String(u).trim();
      if (!s) return '';
      if (/^https?:\/\//i.test(s)) return s;
      return 'https://' + s.replace(/^\/\//, '');
    }

    /** Same rules as pipeline `googleMapsSocialHrefForLead` (views/partials/leads_pipeline_core.ejs). */
    function googleMapsSocialHrefFromLead(lead) {
      var raw = lead.url && lead.url !== 'N/A' ? String(lead.url).trim() : '';
      function isGmListing(absUrl) {
        try {
          var u = new URL(absUrl);
          var h = u.hostname.replace(/^www\./i, '').toLowerCase();
          if (h === 'maps.app.goo.gl') return true;
          if (h === 'goo.gl' && u.pathname.indexOf('maps') !== -1) return true;
          if (h.endsWith('google.com') || h.endsWith('google.co.uk')) {
            if (u.pathname.indexOf('/maps/') !== -1) return true;
            if (u.search.indexOf('cid=') !== -1 || u.search.indexOf('q=place_id:') !== -1) return true;
          }
          return false;
        } catch (e) {
          return false;
        }
      }
      if (raw && /^https?:\/\//i.test(raw) && isGmListing(raw)) return raw;
      var title = String(lead.title || '').trim();
      var address = String(lead.address || '').trim();
      var city = String(lead.city || '').trim();
      if (address && address !== 'N/A') {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((address + ' ' + title).trim());
      }
      if (title && city) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((title + ' ' + city).trim());
      }
      if (title) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(title);
      }
      return '';
    }

    var FOCUS_SVG_GOOGLE_MAPS =
      '<svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>';

    function renderFocusPipelineSocials(container, lead) {
      if (!container) return;
      container.innerHTML = '';
      var gm = googleMapsSocialHrefFromLead(lead);
      var fb = lead.facebook && lead.facebook !== 'N/A' ? String(lead.facebook).trim() : '';
      var ig = lead.instagram && lead.instagram !== 'N/A' ? String(lead.instagram).trim() : '';
      var tw = lead.twitter && lead.twitter !== 'N/A' ? String(lead.twitter).trim() : '';
      var li = lead.linkedin && lead.linkedin !== 'N/A' ? String(lead.linkedin).trim() : '';

      if (gm) {
        var aG = document.createElement('a');
        aG.href = gm;
        aG.target = '_blank';
        aG.rel = 'noopener noreferrer';
        aG.className =
          'inline-flex w-8 h-8 shrink-0 rounded-lg bg-brand-cream dark:bg-slate-800 items-center justify-center shadow-sm border border-brand-border/10 hover:bg-[#4285F4]/15 dark:hover:bg-[#4285F4]/25 transition-all hover:scale-105';
        aG.title = 'Google Maps / Business Profile';
        aG.setAttribute('aria-label', 'Google Business Profile (opens in Maps)');
        aG.innerHTML = FOCUS_SVG_GOOGLE_MAPS;
        container.appendChild(aG);
      }
      function brandLink(href, title, aria, className, svgInner) {
        var a = document.createElement('a');
        a.href = hrefUrl(href);
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.title = title;
        a.setAttribute('aria-label', aria);
        a.className = className;
        a.innerHTML = svgInner;
        return a;
      }
      if (fb) {
        container.appendChild(
          brandLink(
            fb,
            'Facebook',
            'Facebook',
            'inline-flex w-4 h-4 text-brand-muted hover:text-[#1877F2] transition-colors',
            '<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>'
          )
        );
      }
      if (ig) {
        container.appendChild(
          brandLink(
