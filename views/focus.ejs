      var parsed = parseFocusQuickLogSelection(elOutcome && elOutcome.value);
      var notes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      if (parsed && parsed.code) {
        payload.disposition = parsed.code;
        if (notes) payload.dispositionNotes = notes;
