            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Call failed');
            return j;
          });
        })
        .then(function (data) {
          if (data && data.lead) {
            Object.assign(lead, data.lead);
            applyFocusPipelineFromLead(lead, data.lead);
            hydrateFocusQuickLogFromLead(lead);
            syncFollowupStripForOutcome(elOutcome ? elOutcome.value : '');
          }
          var dialMode = String((data && data.dialMode) || '').trim();
          var phone = String((data && data.phone) || (lead.phone || '')).replace(/[^\d+]/g, '');
