    window.__onFocusLeadTagsUpdated = function (leadKey, tagKeys, leadRecord) {
      var short = String(leadKey || '').trim().replace(/^lead:/i, '');
      var next = Array.isArray(tagKeys) ? tagKeys.map(String).filter(Boolean) : [];
      queue.forEach(function (item) {
        if (!item || !item.key) return;
        if (String(item.key).replace(/^lead:/i, '') === short) {
          item.tags = next.slice();
          if (leadRecord) applyFocusPipelineFromLead(item, leadRecord);
        }
      });
    };

    function renderCard() {
      var lead = currentLead();
      if (!lead) {
        elSection.classList.add('hidden');
        elEmpty.classList.remove('hidden');
        elEmptyReload.classList.add('hidden');
        elEmptyTitle.textContent = 'No leads in this queue';
        elEmptyDesc.textContent = 'Add or import leads to your pipeline, then come back.';
        var fwEmpty = document.getElementById('focus-map-wrap');
        var fiEmpty = document.getElementById('focus-map-img');
        if (fwEmpty) {
          fwEmpty.classList.add('hidden');
          fwEmpty.setAttribute('aria-hidden', 'true');
        }
        if (fiEmpty) {
          fiEmpty.onload = null;
          fiEmpty.onerror = null;
          fiEmpty.removeAttribute('src');
          fiEmpty.classList.add('opacity-0');
        }
        syncFocusMailListBtn(null);
        setFocusNotesOpen(false);
        syncFocusNotesIndicator();
        resetFocusSmsCompose();
        return;
      }
      elEmpty.classList.add('hidden');
      elSection.classList.remove('hidden');
      elCompany.textContent = lead.title || '—';
      elContact.textContent = lead.contactName || '—';
      elStage.textContent = lead.pipelineLabel || ('Stage ' + lead.pipelineStage);
      elLast.textContent = lead.lastTouchLabel || '—';
      renderTouchPoints(lead);
      if (typeof window.__renderFocusLeadTags === 'function') {
        window.__renderFocusLeadTags(
          document.getElementById('focusLeadTagsHost'),
          lead.key,
          Array.isArray(lead.tags) ? lead.tags : [],
        );
      }
      renderLinks(lead);
      renderFocusContactFields(lead);
      renderBusinessInfo(lead);
      hydrateFocusLeadFromPanelData(lead);
      if (elServiceSelect) {
        elServiceSelect.value = getDefaultProductKey();
      }
      currentChannel = 'call-script';
      hydrateFocusQuickLogFromLead(lead);
      if (elFollowupEnable) elFollowupEnable.checked = false;
      if (elFollowupWrap) elFollowupWrap.classList.add('hidden');
      if (focusFollowupPicker && typeof focusFollowupPicker.clear === 'function') {
        focusFollowupPicker.clear();
      } else if (elFollowupAt) {
        elFollowupAt.value = '';
      }
      setOutcomeFeedback('');
      resetFocusSmsCompose();
      syncFocusSendInfo(lead);
      applyChannelUI();
      updateDraftFromSelection();
      fetchReviewSummary();
      updateSelectionProgress();
      syncFocusMailListBtn(lead);
      setFocusNotesOpen(false);
