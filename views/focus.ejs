<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-8 pb-28 md:pb-10 md:py-10">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Focus mode</p>
          <h1 class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Start my <span id="focus-session-goal"><%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %></span></h1>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-2">One lead at a time — draft, log, next. Set your daily contact goal below. <button type="button" id="focus-help-btn" class="font-bold text-brand-dark dark:text-white underline decoration-brand-yellow/60 hover:decoration-brand-yellow">Shortcuts (?)</button></p>
        </div>
        <a href="/today" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">← Today</a>
      </div>
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-4 py-3">
        <div class="flex flex-wrap items-end justify-between gap-3 mb-2">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mb-1">Touches today</p>
            <p class="font-display font-black text-brand-dark dark:text-white tabular-nums">
              <span id="focus-touch-count"><%= typeof touchesToday !== 'undefined' ? touchesToday : 0 %></span>
              <span class="text-brand-muted font-bold text-sm"> / <span id="focus-touch-goal"><%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %></span></span>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <label for="focus-touch-goal-input" class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Daily goal</label>
            <input
              type="number"
              id="focus-touch-goal-input"
              min="1"
              max="500"
              step="1"
              value="<%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %>"
              class="w-[4.5rem] rounded-lg border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-800 px-2 py-1.5 text-sm font-bold text-brand-dark dark:text-white tabular-nums focus:outline-none focus:ring-2 focus:ring-brand-yellow/40"
              aria-label="Daily contact goal"
            />
            <div class="flex items-center gap-1" role="group" aria-label="Quick goal presets">
              <button type="button" class="focus-goal-preset rounded-md border border-brand-border/50 dark:border-white/15 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-brand-muted dark:text-slate-300 hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors" data-goal="25">25</button>
              <button type="button" class="focus-goal-preset rounded-md border border-brand-border/50 dark:border-white/15 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-brand-muted dark:text-slate-300 hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors" data-goal="54">54</button>
              <button type="button" class="focus-goal-preset rounded-md border border-brand-border/50 dark:border-white/15 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-brand-muted dark:text-slate-300 hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors" data-goal="100">100</button>
            </div>
          </div>
        </div>
        <div class="h-2 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= typeof touchGoal !== 'undefined' ? touchGoal : 54 %>" aria-valuenow="<%= typeof touchesToday !== 'undefined' ? touchesToday : 0 %>" id="focus-progress-bar-wrap">
          <div id="focus-progress-fill" class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width: <%= (typeof touchGoal !== 'undefined' && touchGoal > 0) ? Math.min(100, Math.round((touchesToday || 0) / touchGoal * 100)) : 0 %>%"></div>
        </div>
        <p id="focus-touch-goal-status" class="hidden mt-2 text-[11px] font-semibold text-brand-muted dark:text-slate-400" role="status" aria-live="polite"></p>
      </div>
    </header>

    <div id="focus-empty" class="hidden rounded-[2rem] border-2 border-dashed border-brand-border dark:border-white/15 bg-white/60 dark:bg-slate-900/50 px-8 py-14 text-center">
      <h2 id="focus-empty-title" class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2">No leads in this queue</h2>
      <p id="focus-empty-desc" class="text-sm text-brand-muted mb-6 max-w-md mx-auto">Add or import leads to your pipeline, then come back.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <button type="button" id="focus-empty-reload" class="hidden btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Reload queue</button>
        <a href="/prospecting?tab=pipeline" class="btn-pill btn-primary inline-flex px-8 py-3 text-xs font-black uppercase tracking-widest">Open pipeline</a>
      </div>
    </div>

    <section id="focus-card-section" class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/85 dark:bg-slate-900/75 shadow-sm p-6 md:p-8 max-w-3xl lg:max-w-4xl mx-auto" aria-label="Current lead">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div class="min-w-0 flex-1">
          <h2 id="focus-company" class="font-display font-black text-2xl text-brand-dark dark:text-white truncate">—</h2>
          <p id="focus-contact" class="text-sm font-semibold text-brand-muted dark:text-slate-400 mt-1">—</p>
          <p class="text-[11px] font-bold uppercase tracking-wider text-brand-muted mt-2 mb-0">Last touch <span id="focus-last-touch" class="text-brand-dark dark:text-white normal-case">—</span></p>
          <div id="focus-links" class="flex flex-wrap items-center gap-2 mt-3" aria-label="Contact links"></div>
        </div>
        <div class="flex flex-col items-end gap-1.5 shrink-0 max-w-full">
          <div class="flex flex-wrap items-center justify-end gap-2">
            <span id="focus-stage-badge" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 border border-brand-border/50 dark:border-white/10 text-brand-dark dark:text-slate-200">—</span>
            <button type="button" id="focus-schedule-deliverables" class="inline-flex items-center gap-2 rounded-xl border border-indigo-500/40 bg-indigo-500/10 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-indigo-800 dark:text-indigo-200 hover:bg-indigo-500/20 hover:border-indigo-500/60 transition-colors shrink-0" title="Add hosted audit + AI deck to your task list">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Schedule deliverables in tasks
            </button>
            <button type="button" id="focus-btn-delete" class="w-8 h-8 rounded-lg border border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-800/60 text-brand-muted hover:text-red-600 dark:hover:text-red-400 hover:border-red-500/40 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors flex items-center justify-center shrink-0" title="Delete lead" aria-label="Delete lead">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
          <p id="focus-deliverables-feedback" class="text-[11px] text-brand-muted text-right min-h-[1rem] max-w-[20rem]" aria-live="polite"></p>
        </div>
      </div>

      <div
        id="focus-business-needs"
        class="mb-6 rounded-2xl border-2 border-brand-yellow/40 dark:border-amber-500/35 bg-gradient-to-br from-brand-yellow/18 via-brand-yellow/8 to-white/40 dark:from-amber-500/15 dark:via-amber-500/5 dark:to-slate-900/40 px-4 py-4 shadow-sm transition-colors duration-300"
        aria-label="What this business needs"
      >
        <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
          <p id="focus-needs-label" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow dark:text-amber-300">What they need</p>
          <span id="focus-needs-offer-pill" class="hidden shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-yellow/50 bg-white/80 dark:bg-slate-900/80 text-brand-dark dark:text-amber-100">—</span>
        </div>
        <p id="focus-needs-headline" class="text-sm md:text-[15px] font-bold text-brand-dark dark:text-white leading-snug">—</p>
        <ul id="focus-needs-gaps" class="hidden mt-3 flex flex-wrap gap-1.5 list-none m-0 p-0" aria-label="Top gaps"></ul>
        <p id="focus-needs-rationale" class="hidden mt-3 text-xs text-brand-muted dark:text-slate-400 leading-relaxed">—</p>
        <p id="focus-needs-opener" class="hidden mt-3 text-xs font-semibold text-brand-dark/80 dark:text-slate-300 leading-relaxed"><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted not-italic mr-1">Opener</span><span id="focus-needs-opener-text" class="italic">—</span></p>
        <p id="focus-needs-loading" class="hidden mt-2 text-[11px] text-brand-muted animate-pulse">Loading AI insight…</p>
        <p id="focus-needs-empty" class="text-xs text-brand-muted dark:text-slate-500 leading-snug">Run AI Analysis in pipeline to surface what this business needs.</p>
      </div>

      <div class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/35 dark:bg-slate-800/60 px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Business info</p>
        <div class="flex flex-col md:flex-row gap-4 items-stretch">
          <div id="focus-map-wrap" class="hidden w-full md:w-[min(100%,280px)] shrink-0 rounded-xl border border-brand-border/50 dark:border-white/10 overflow-hidden bg-slate-200/80 dark:bg-slate-950/80 aspect-[4/3] md:aspect-auto md:h-52 min-h-[11rem] relative shadow-inner">
            <img id="focus-map-img" class="absolute inset-0 z-0 hidden h-full w-full object-cover" alt="" loading="eager" width="560" height="420" decoding="async" />
            <div id="focus-map-fallback" class="absolute inset-0 z-0 hidden flex-col items-center justify-center gap-2 px-3 text-center bg-brand-cream/90 dark:bg-slate-900/95">
              <svg class="w-7 h-7 text-brand-yellow shrink-0 opacity-95" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Map preview unavailable</span>
            </div>
            <a id="focus-map-open-link" href="#" target="_blank" rel="noopener noreferrer" class="absolute bottom-2 left-2 z-[1] inline-flex items-center rounded-full border border-brand-dark/70 dark:border-white/20 bg-white/95 dark:bg-slate-900/95 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-brand-dark dark:text-white shadow-md hover:border-brand-yellow transition-colors">Open in Maps</a>
          </div>
          <div class="flex-1 min-w-0 w-full">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Website</p>
            <a id="focus-biz-website" href="#" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-dark dark:text-slate-100 hover:text-brand-yellow transition-colors truncate block">—</a>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Location</p>
            <p id="focus-biz-location" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Category</p>
            <p id="focus-biz-category" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Reviews</p>
            <p id="focus-biz-reviews" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
            <div id="focus-biz-review-stars" class="mt-1 flex items-center gap-1 text-amber-500" aria-label="Review stars"></div>
          </div>
            </div>
          </div>
        </div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">AI review summary</p>
          <p id="focus-review-summary" class="text-[11px] text-brand-muted leading-snug">Loading review summary…</p>
        </div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-2">Quick copy</p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
            <button type="button" id="focus-copy-phone" class="focus-quick-copy-btn inline-flex items-center gap-2 max-w-full px-3 py-2 rounded-xl text-left border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" title="Copy phone number">
              <span class="text-[9px] font-black uppercase tracking-wider text-brand-muted shrink-0">Phone</span>
              <span id="focus-copy-phone-value" class="text-[11px] font-semibold normal-case tracking-normal truncate min-w-0">—</span>
            </button>
            <button type="button" id="focus-copy-email" class="focus-quick-copy-btn inline-flex items-center gap-2 max-w-full px-3 py-2 rounded-xl text-left border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" title="Copy email address">
              <span class="text-[9px] font-black uppercase tracking-wider text-brand-muted shrink-0">Email</span>
              <span id="focus-copy-email-value" class="text-[11px] font-semibold normal-case tracking-normal truncate min-w-0">—</span>
            </button>
            <button type="button" id="focus-copy-website" class="focus-quick-copy-btn inline-flex items-center gap-2 max-w-full px-3 py-2 rounded-xl text-left border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" title="Copy website domain">
              <span class="text-[9px] font-black uppercase tracking-wider text-brand-muted shrink-0">Domain</span>
              <span id="focus-copy-website-value" class="text-[11px] font-semibold normal-case tracking-normal truncate min-w-0">—</span>
            </button>
          </div>
          <p id="focus-copy-feedback" class="text-[11px] text-brand-muted mt-2 min-h-[1rem]"></p>
        </div>
      </div>

      <div
        id="focus-recommended"
        class="hidden mb-4 rounded-2xl border border-brand-yellow/35 bg-brand-yellow/10 dark:bg-amber-500/10 dark:border-amber-500/30 px-4 py-3"
        role="group"
        aria-label="Product and service angle"
      >
        <% const _focusProductOptions = (typeof focusProductOptions !== 'undefined' && Array.isArray(focusProductOptions) && focusProductOptions.length) ? focusProductOptions : [
          { key: 'reputation', label: 'Reputation management' },
          { key: 'ai_automation', label: 'AI automation' },
          { key: 'ai_websites', label: 'AI websites' },
          { key: 'social_media', label: 'Social media' },
          { key: 'ad_management', label: 'Ad management' },
          { key: 'web_design', label: 'Web design' },
        ]; %>
        <label for="focus-service-select" class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-amber-200/80 mb-2 block">Recommended product</label>
        <button
          type="button"
          id="focus-recommended-toggle"
          class="w-full text-left rounded-xl border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-bold text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors"
          aria-expanded="false"
          aria-controls="focus-product-options"
        >
          —
        </button>
        <div id="focus-product-options" class="hidden mt-2 flex flex-wrap gap-2">
          <% _focusProductOptions.forEach(function (p) { %>
            <button
              type="button"
              class="focus-product-option inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors"
              data-service-key="<%= p.key %>"
              data-service-label="<%= p.label %>"
            ><%= p.label %></button>
          <% }); %>
        </div>
        <select
          id="focus-service-select"
          class="hidden"
        >
          <option value="auto">Use lead’s recommended</option>
          <% _focusProductOptions.forEach(function (p) { %>
            <option value="<%= p.key %>"><%= p.label %></option>
          <% }); %>
        </select>
        <p id="focus-recommended-hint" class="text-[11px] text-brand-muted dark:text-slate-400 mt-2 leading-snug" aria-live="polite"></p>
      </div>

      <div class="mb-4 rounded-2xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/35 dark:bg-slate-800/35 px-4 py-3">
        <div class="flex flex-col sm:flex-row sm:items-end gap-3 sm:gap-4">
        <label class="block flex-1 min-w-0" for="focus-script-variant">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Script style</span>
          <select
            id="focus-script-variant"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <option value="default">First touch / default</option>
            <option value="followup">Follow-up</option>
            <option value="reengage">Re-engagement</option>
            <option value="short">Short &amp; punchy</option>
          </select>
        </label>
        <label class="block flex-1 min-w-0" for="focus-tone">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Tone</span>
          <select
            id="focus-tone"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <option value="coffee-chat">Coffee-chat</option>
            <option value="pro">Pro</option>
          </select>
        </label>
        </div>
      </div>

      <div id="focus-subject-wrap" class="mb-3 hidden">
        <label for="focus-subject" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Subject</label>
        <input id="focus-subject" type="text" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm text-brand-dark dark:text-white" autocomplete="off" />
      </div>
      <div class="mb-6">
        <label for="focus-body" id="focus-body-label" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Outreach draft</label>
        <textarea id="focus-body" rows="10" class="w-full rounded-2xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white font-medium leading-relaxed resize-y min-h-[200px]" placeholder="Draft loads here — edit before you send or log."></textarea>
      </div>
      <div id="focus-call-dock" class="hidden mb-4 rounded-2xl border border-emerald-500/35 bg-emerald-500/10 dark:bg-emerald-500/15 px-4 py-3 flex flex-wrap items-center gap-2" aria-live="polite" aria-label="Softphone call status">
        <div class="flex-1 min-w-[10rem]">
          <p id="focus-call-dock-status" class="text-[10px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200">On call</p>
          <p id="focus-call-dock-number" class="text-xs font-semibold text-brand-dark dark:text-white tabular-nums truncate">—</p>
        </div>
        <button type="button" id="focus-call-dock-open" class="shrink-0 rounded-lg border border-emerald-600/40 bg-white/90 dark:bg-slate-900 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200 hover:bg-emerald-50 dark:hover:bg-slate-800 transition-colors">Open dialer</button>
        <button type="button" id="focus-call-dock-hangup" class="shrink-0 rounded-lg bg-rose-600 text-white px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest hover:bg-rose-500 transition-colors">Hang up</button>
        <button type="button" id="focus-call-dock-vm-next" class="shrink-0 rounded-lg border border-violet-500/45 bg-violet-600/10 text-violet-800 dark:text-violet-200 px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest hover:bg-violet-600/20 transition-colors">Drop VM + next</button>
        <button type="button" id="focus-call-dock-call-next" class="shrink-0 rounded-lg bg-brand-yellow text-brand-dark px-2.5 py-1.5 text-[9px] font-black uppercase tracking-widest hover:bg-amber-400 transition-colors">Call next</button>
      </div>

      <div id="focus-outcome-panel" class="mb-6 md:mb-4 md:sticky md:bottom-4 z-30 rounded-[1.35rem] border border-brand-border/60 dark:border-white/15 bg-brand-cream/25 dark:bg-slate-900/70 md:bg-white/70 md:dark:bg-slate-900/65 md:backdrop-blur-xl shadow-sm md:shadow-xl p-4 space-y-3">
        <div id="focus-outcome-header" class="flex items-center justify-between gap-2">
          <p id="focus-outcome-heading" class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Call outcome + notes</p>
          <button
            type="button"
            id="focus-outcome-collapse-toggle"
            class="inline-flex items-center justify-center w-7 h-7 rounded-lg border border-brand-border/60 dark:border-white/15 text-brand-muted hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors shrink-0"
            aria-expanded="true"
            aria-controls="focus-outcome-details"
            title="Collapse notes"
