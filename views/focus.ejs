    function applyScriptPlaceholders(text, contact, company, cityState) {
      var raw = String(text || '');
      if (Scripts.fillScriptPlaceholders) {
        return Scripts.fillScriptPlaceholders(raw, {
          sender: Scripts.getScriptProfile ? Scripts.getScriptProfile() : window.__ADHELLO_SCRIPT_PROFILE__,
          prospect: {
            name: contact,
            company: company,
            city: cityState || 'your area',
