    function syncBackButton() {
      var canBack = focusLeadHistory.length > 0;
      [btnBack, btnBackSecondary, btnMobileBack, btnEmptyBack].forEach(function (btn) {
        if (!btn) return;
        btn.disabled = !canBack;
        btn.classList.toggle('opacity-40', !canBack);
        btn.classList.toggle('pointer-events-none', !canBack);
      });
      if (btnEmptyBack) {
        btnEmptyBack.classList.toggle('hidden', !canBack || !elEmpty || elEmpty.classList.contains('hidden'));
      }
    }

    function adjustFocusHistoryAfterRemove(removedIdx) {
      focusLeadHistory = focusLeadHistory
        .filter(function (i) { return i !== removedIdx; })
        .map(function (i) { return i > removedIdx ? i - 1 : i; })
        .filter(function (i) { return i >= 0 && i < queue.length; });
      syncBackButton();
    }

    function rememberLeadBeforeAdvance() {
      if (!queue.length || idx < 0 || idx >= queue.length) return;
      focusLeadHistory.push(idx);
      syncBackButton();
    }

    function prevLead() {
      if (!focusLeadHistory.length) return;
      idx = focusLeadHistory.pop();
      if (idx < 0) idx = 0;
      if (idx >= queue.length) idx = Math.max(0, queue.length - 1);
      elEmpty.classList.add('hidden');
      elSection.classList.remove('hidden');
      renderCard();
      updateDraftFromSelection();
      syncBackButton();
      closeMobileFabActions();
    }

    function currentLead() {
      return queue[idx] || null;
    }
    window.__getFocusCurrentLead = function () {
      var lead = currentLead();
      if (!lead || !lead.key) return null;
      return {
        key: String(lead.key || '').trim(),
        title: String(lead.title || '').trim(),
        address: String(lead.address || '').trim(),
        city: String(lead.city || '').trim(),
        state: String(lead.state || '').trim(),
      };
    };

    window.__onFocusLeadTagsUpdated = function (leadKey, tagKeys) {
      var short = String(leadKey || '').trim().replace(/^lead:/i, '');
      var next = Array.isArray(tagKeys) ? tagKeys.map(String).filter(Boolean) : [];
      queue.forEach(function (item) {
        if (!item || !item.key) return;
        if (String(item.key).replace(/^lead:/i, '') === short) item.tags = next.slice();
      });
    };

    function renderCard() {
      var lead = currentLead();
      if (!lead) {
        elSection.classList.add('hidden');
        elEmpty.classList.remove('hidden');
        elEmptyReload.classList.add('hidden');
        elEmptyTitle.textContent = 'No leads in this queue';
        elEmptyDesc.textContent = 'Add or import leads to your pipeline, then come back.';
        var fwEmpty = document.getElementById('focus-map-wrap');
        var fiEmpty = document.getElementById('focus-map-img');
        if (fwEmpty) {
          fwEmpty.classList.add('hidden');
          fwEmpty.setAttribute('aria-hidden', 'true');
        }
        if (fiEmpty) {
          fiEmpty.onload = null;
          fiEmpty.onerror = null;
          fiEmpty.removeAttribute('src');
          fiEmpty.classList.add('hidden');
        }
        return;
      }
      elEmpty.classList.add('hidden');
      elSection.classList.remove('hidden');
      elCompany.textContent = lead.title || '—';
      elContact.textContent = lead.contactName || '—';
      elStage.textContent = lead.pipelineLabel || ('Stage ' + lead.pipelineStage);
      elLast.textContent = lead.lastTouchLabel || '—';
      if (typeof window.__renderFocusLeadTags === 'function') {
        window.__renderFocusLeadTags(
          document.getElementById('focusLeadTagsHost'),
          lead.key,
          Array.isArray(lead.tags) ? lead.tags : [],
        );
      }
      renderLinks(lead);
      renderBusinessInfo(lead);
      if (elServiceSelect) {
        elServiceSelect.value = getDefaultProductKey();
      }
      currentChannel = 'call-script';
      hydrateFocusQuickLogFromLead(lead);
      if (elFollowupEnable) elFollowupEnable.checked = false;
      if (elFollowupWrap) elFollowupWrap.classList.add('hidden');
      if (focusFollowupPicker && typeof focusFollowupPicker.clear === 'function') {
        focusFollowupPicker.clear();
      } else if (elFollowupAt) {
        elFollowupAt.value = '';
      }
      setOutcomeFeedback('');
      applyChannelUI();
      updateDraftFromSelection();
      fetchReviewSummary();
      updateSelectionProgress();
    }

    function buildNoteText() {
      var ch = currentChannel;
      var body = (elBody.value || '').trim();
      var out = outcomeLabel(elOutcome && elOutcome.value);
      var outNotes = String((elOutcomeNotes && elOutcomeNotes.value) || '').trim();
      var note = '[Focus · call script]\n\n' + body;
      if (ch === 'email') {
        var sub = (elSubject.value || '').trim();
        note = sub ? '[Focus · email] ' + sub + '\n\n' + body : '[Focus · email]\n\n' + body;
      } else if (ch === 'voicemail-drop') {
        note = '[Focus · voicemail drop]\n\n' + body;
      } else if (ch === 'sms') {
        note = '[Focus · sms]\n\n' + body;
      } else if (ch === 'dm') {
        note = '[Focus · DM]\n\n' + body;
      } else if (ch === 'objection-handling') {
        note = '[Focus · objection handling]\n\n' + body;
      }
      if (out) note += '\n\nOutcome: ' + out;
      if (outNotes) note += '\nNotes: ' + outNotes;
      return note;
    }

    function updateSelectionProgress() {
      if (!isSelectionSession) return;
      var total = queue.length;
      var current = total ? Math.min(total, Math.max(1, idx + 1)) : 0;
      if (countEl) countEl.textContent = String(current);
      var goalEl = document.getElementById('focus-touch-goal');
      if (goalEl) goalEl.textContent = String(total);
      touchGoal = total || touchGoal;
      var pct = total > 0 ? Math.min(100, Math.round((current / total) * 100)) : 0;
      if (fill) fill.style.width = pct + '%';
      if (barWrap) {
        barWrap.setAttribute('aria-valuenow', String(current));
        barWrap.setAttribute('aria-valuemax', String(total));
      }
    }

    function refreshMetrics() {
      if (isSelectionSession) {
        updateSelectionProgress();
        return Promise.resolve();
      }
      return fetch('/focus/metrics.json', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.success) return;
          var n = data.touchesToday;
          touchGoal = data.touchGoal || touchGoal;
          countEl.textContent = n;
          document.getElementById('focus-touch-goal').textContent = touchGoal;
          var pct = touchGoal > 0 ? Math.min(100, Math.round((n / touchGoal) * 100)) : 0;
          fill.style.width = pct + '%';
          barWrap.setAttribute('aria-valuenow', String(n));
          barWrap.setAttribute('aria-valuemax', String(touchGoal));
          if (!celebrateDismissed && n >= touchGoal) {
            modalCelebrate.classList.remove('hidden');
          }
        })
        .catch(function () {});
    }

    function nextLead() {
      rememberLeadBeforeAdvance();
      idx += 1;
      if (idx >= queue.length) {
        elSection.classList.add('hidden');
        elEmpty.classList.remove('hidden');
        elEmptyReload.classList.remove('hidden');
        elEmptyTitle.textContent = 'End of queue';
        elEmptyDesc.textContent = 'Reload for a fresh ordering, or head back to your pipeline.';
        syncBackButton();
        updateSelectionProgress();
        return;
      }
      renderCard();
      updateDraftFromSelection();
    }

    function postNote() {
      var lead = currentLead();
      if (!lead) return Promise.resolve(null);
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/notes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ content: buildNoteText() }),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error('note failed');
          return j;
        });
      });
    }

    function maybeAdvanceStage() {
      var lead = currentLead();
      if (!lead) return Promise.resolve(null);
      var ps = parseInt(lead.pipelineStage, 10);
      if (ps !== 1 && ps !== 2) return Promise.resolve(null);
      var nextStage = ps + 1;
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          pipelineStage: nextStage,
          pipelineStageUpdatedAt: new Date().toISOString(),
        }),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error('stage update failed');
          lead.pipelineStage = nextStage;
          return j;
        });
      });
    }

    function onSendAdvance() {
      onFocusCall();
    }

    function onLogNext() {
      var lead = currentLead();
      if (!lead) return;
      autoDialNext = (currentChannel === 'call-script');
      btnLog.disabled = true;
      applyFocusQuickLogIfNeeded(lead)
        .then(function () { return postNote(); })
        .then(function () {
          nextLead();
          if (autoDialNext && currentLead() && String(currentLead().phone || '').trim()) {
            autoDialNext = false;
            setTimeout(function () { openDialerForLead({ autoDial: true }); }, 300);
          }
          autoDialNext = false;
          return refreshMetrics();
        })
        .catch(function (err) {
          autoDialNext = false;
          setOutcomeFeedback(err && err.message ? err.message : 'Could not log this lead.', true);
        })
        .finally(function () { btnLog.disabled = false; });
    }

