    function iconLink(href, label, svgPath) {
      var a = document.createElement('a');
      a.href = href;
      a.setAttribute('aria-label', label);
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'inline-flex items-center justify-center w-9 h-9 rounded-xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/80 text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors';
      a.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' + svgPath + '</svg>';
      return a;
    }

    function cleanUrlLabel(raw) {
      if (!raw) return '';
      return String(raw).replace(/^https?:\/\//i, '').replace(/\/$/, '');
    }

    function renderLinks(lead) {
      elLinks.innerHTML = '';
      if (lead.website) elLinks.appendChild(iconLink(hrefUrl(lead.website), 'Website', '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>'));
      if (lead.phone) {
        var phoneBtn = iconLink('#', 'Phone', '<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>');
        phoneBtn.removeAttribute('target');
        phoneBtn.removeAttribute('rel');
        phoneBtn.addEventListener('click', function (e) {
          e.preventDefault();
          openDialerForLead();
        });
        elLinks.appendChild(phoneBtn);
      }
      if (lead.email) elLinks.appendChild(iconLink('mailto:' + encodeURIComponent(lead.email), 'Email', '<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'));
      renderFocusPipelineSocials(elLinks, lead, true);
