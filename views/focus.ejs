    function syncFocusMailListBtn(lead) {
      if (!btnAddMailList) return;
      var key = focusLeadKeyParam(lead);
      if (!key) {
        btnAddMailList.disabled = true;
        btnAddMailList.textContent = '+ Mail list · today';
        btnAddMailList.classList.remove('is-on-list');
        btnAddMailList.removeAttribute('aria-pressed');
        return;
      }
      var onList =
        typeof window.__isLeadOnDirectMailListToday === 'function' &&
