    function setOutcomeFeedback(msg, isError) {
      if (!elOutcomeFeedback) return;
      elOutcomeFeedback.textContent = msg || '';
      elOutcomeFeedback.classList.toggle('text-rose-600', !!isError);
      elOutcomeFeedback.classList.toggle('text-emerald-700', !!msg && !isError);
      elOutcomeFeedback.classList.toggle('text-brand-muted', !msg);
      if (window.__focusOutcomeTimer) clearTimeout(window.__focusOutcomeTimer);
      if (!msg) return;
      window.__focusOutcomeTimer = setTimeout(function () {
        if (elOutcomeFeedback) {
          elOutcomeFeedback.textContent = '';
          elOutcomeFeedback.classList.remove('text-rose-600', 'text-emerald-700');
          elOutcomeFeedback.classList.add('text-brand-muted');
        }
      }, 2800);
    }

    function outcomeLabel(v) {
      var item = focusQuickLogItemForValue(v);
      return item ? item.label : '';
    }

    function hydrateFocusQuickLogFromLead(lead) {
      if (!elOutcome) return;
      var value = '';
      var disp = String((lead && lead.lastDisposition) || '').trim().toLowerCase();
      if (disp) {
        var dispItem = focusQuickLogItems().find(function (i) { return i.disposition === disp; });
        if (dispItem) {
          value = dispItem.disposition || (dispItem.status ? 'status:' + dispItem.status : '');
        }
      }
      if (!value && lead && lead.status) {
        var statusItem = focusQuickLogItems().find(function (i) { return i.status === lead.status; });
        if (statusItem && statusItem.status) value = 'status:' + statusItem.status;
      }
      elOutcome.value = value;
      syncQuickOutcomeButtons();
      if (elOutcomeNotes) {
        elOutcomeNotes.value = lead && lead.lastDispositionNotes ? String(lead.lastDispositionNotes) : '';
      }
      syncFocusNotesIndicator();
    }

    function ensureSuggestedOutcome() {
      if (!elOutcome || String(elOutcome.value || '').trim()) return;
      syncQuickOutcomeButtons();
    }

    function syncQuickOutcomeButtons() {
      if (!elQuickOutcomeBtns || !elQuickOutcomeBtns.length || !elOutcome) return;
      var selected = String(elOutcome.value || '').trim();
      elQuickOutcomeBtns.forEach(function (btn) {
        var active = focusBtnSelectionValue(btn) === selected;
        btn.setAttribute('data-active', active ? 'true' : 'false');
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (elSelectedOutcomeLabel) {
        var label = outcomeLabel(selected);
        elSelectedOutcomeLabel.innerHTML =
          'Selected: ' +
          (label || 'none') +
          ' · <a href="/direct-mail?day=today" id="focus-link-mail-list-today" class="focus-mail-list-link font-semibold hover:text-brand-yellow transition-colors">View today\'s list</a>';
        focusLinkMailListToday = document.getElementById('focus-link-mail-list-today');
        if (focusLinkMailListToday && typeof window.__buildDirectMailQueueUrl === 'function') {
          focusLinkMailListToday.href = window.__buildDirectMailQueueUrl({ day: 'today' });
        }
      }
    }

    function syncFollowupStripForOutcome(value) {
      var item = focusQuickLogItemForValue(value);
      var needs = !!(item && item.enableFollowup);
      if (elFollowupStrip) elFollowupStrip.classList.toggle('hidden', !needs);
      if (!needs) return;
      if (elFollowupEnable) elFollowupEnable.checked = true;
      if (elFollowupWrap) elFollowupWrap.classList.remove('hidden');
      defaultFollowupDatetime();
    }

    function quickSetOutcome(value) {
      if (!elOutcome) return;
      var v = String(value || '').trim();
      if (!v) return;
      elOutcome.value = v;
      syncQuickOutcomeButtons();
      var item = focusQuickLogItemForValue(v);
      if (elOutcomeNotes && item && item.noteTemplate) {
        var existing = String(elOutcomeNotes.value || '').trim();
        var templates = {};
        focusQuickLogItems().forEach(function (i) {
          var key = i.disposition || (i.status ? 'status:' + i.status : '');
          if (key && i.noteTemplate) templates[key] = i.noteTemplate;
        });
        var isExistingTemplate = Object.keys(templates).some(function (k) {
          return String(templates[k]) === existing;
        });
        if ((!existing || isExistingTemplate) && templates[v]) {
          elOutcomeNotes.value = templates[v];
        }
      }
      syncFocusNotesIndicator();
      syncFollowupStripForOutcome(v);
      setOutcomeFeedback('Quick log: ' + (outcomeLabel(v) || v.replace(/_/g, ' ')), false);
      if (v === 'send_info' && typeof window.__leadSendInfoOpenWithAudit === 'function') {
        window.__leadSendInfoOpenWithAudit({ lead: currentLead(), rootId: 'focusSendInfo', scroll: true });
      }
    }

