    function saveFocusScriptToLibrary() {
      if (focusScriptSaving) return Promise.resolve();
      var serviceKey = currentFocusProductKey();
      var body = getFocusBodyHtml();
      if (!serviceKey || !getFocusBodyPlain()) {
        setFocusScriptSaveStatus('Nothing to save', true);
        return Promise.resolve();
      }
      focusScriptSaving = true;
      setFocusScriptSaveStatus('Saving…');
      updateFocusScriptSaveUi();
      return fetch('/workspace/scripts/blocks', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          blocks: (function () {
            var blocks = {};
            blocks[serviceKey] = {
              opening: body,
              discovery: '',
              valueProp: '',
              objectionHandling: '',
              close: '',
            };
            return blocks;
          })(),
        }),
      })
        .then(function (r) {
          return r.json().then(function (j) {
            return { ok: r.ok, j: j };
          });
        })
        .then(function (res) {
          if (!res.ok || !res.j || !res.j.success) {
            throw new Error((res.j && res.j.error) || 'Could not save script.');
          }
          if (!focusScriptLibrary[serviceKey]) focusScriptLibrary[serviceKey] = {};
          focusScriptLibrary[serviceKey].opening = body;
          focusScriptLibrary[serviceKey].discovery = '';
          focusScriptLibrary[serviceKey].valueProp = '';
          focusScriptLibrary[serviceKey].objectionHandling = '';
          focusScriptLibrary[serviceKey].close = '';
          markFocusScriptClean('Saved');
        })
        .catch(function (err) {
          setFocusScriptSaveStatus((err && err.message) || 'Save failed', true);
        })
        .finally(function () {
          focusScriptSaving = false;
          updateFocusScriptSaveUi();
        });
    }

