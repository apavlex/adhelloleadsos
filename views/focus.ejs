      if (onList) {
        btnAddMailList.textContent = 'On mail list ✓';
        btnAddMailList.classList.add('is-on-list');
        btnAddMailList.disabled = true;
        btnAddMailList.setAttribute('aria-pressed', 'true');
      } else {
        btnAddMailList.textContent = '+ Mail list · today';
