    function fetchBusinessNeedsInsight(lead) {
      if (!lead || !lead.key) return Promise.resolve();
      var needs = lead.businessNeeds || {};
      if (needs.hasCachedInsight) return Promise.resolve();
      var reqId = String(lead.key) + '|needs|' + Date.now();
