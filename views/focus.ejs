    function setFocusSmsComposeStatus(msg, isError) {
      if (!elSmsComposeStatus) return;
      elSmsComposeStatus.textContent = msg || '';
      elSmsComposeStatus.classList.toggle('text-red-500', Boolean(isError));
      elSmsComposeStatus.classList.toggle('text-brand-muted', !isError);
    }

    function syncFocusSmsComposeCount() {
      if (elSmsComposeCount && elSmsComposeInput) {
        elSmsComposeCount.textContent = String((elSmsComposeInput.value || '').length);
