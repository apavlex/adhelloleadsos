    var elEmptyDesc = document.getElementById('focus-empty-desc');
    var elEmptyReload = document.getElementById('focus-empty-reload');
    var elSection = document.getElementById('focus-card-section');
    var elCompany = document.getElementById('focus-company');
    var elContact = document.getElementById('focus-contact');
    var elStage = document.getElementById('focus-stage-badge');
    var elLast = document.getElementById('focus-last-touch');
    var elLinks = document.getElementById('focus-links');
    var elBizWebsite = document.getElementById('focus-biz-website');
    var elBizLocation = document.getElementById('focus-biz-location');
    var elBizCategory = document.getElementById('focus-biz-category');
    var elBizReviews = document.getElementById('focus-biz-reviews');
    var elBizReviewStars = document.getElementById('focus-biz-review-stars');
    var elReviewSummary = document.getElementById('focus-review-summary');
    var elNeedsHeadline = document.getElementById('focus-needs-headline');
    var elNeedsOfferPill = document.getElementById('focus-needs-offer-pill');
    var elNeedsGaps = document.getElementById('focus-needs-gaps');
    var elNeedsRationale = document.getElementById('focus-needs-rationale');
    var elNeedsOpener = document.getElementById('focus-needs-opener');
    var elNeedsOpenerText = document.getElementById('focus-needs-opener-text');
    var elNeedsLoading = document.getElementById('focus-needs-loading');
    var elNeedsEmpty = document.getElementById('focus-needs-empty');
    var elBizSocials = null;
    var btnCopyPhone = document.getElementById('focus-copy-phone');
    var btnCopyEmail = document.getElementById('focus-copy-email');
    var btnCopyWebsite = document.getElementById('focus-copy-website');
    var elCopyPhoneValue = document.getElementById('focus-copy-phone-value');
    var elCopyEmailValue = document.getElementById('focus-copy-email-value');
    var elCopyWebsiteValue = document.getElementById('focus-copy-website-value');
    var elCopyFeedback = document.getElementById('focus-copy-feedback');
    var elOutcome = document.getElementById('focus-outcome');
    var elSelectedOutcomeLabel = document.getElementById('focus-selected-outcome-label');
    var elQuickOutcomeBtns = document.querySelectorAll('.focus-quick-outcome');
    var elOutcomeNotes = document.getElementById('focus-outcome-notes');
    var elFollowupEnable = document.getElementById('focus-followup-enable');
    var elFollowupWrap = document.getElementById('focus-followup-wrap');
    var elFollowupAt = document.getElementById('focus-followup-at');
    var focusFollowupPicker =
      elFollowupAt && typeof window.initGcalDatetimePicker === 'function'
        ? window.initGcalDatetimePicker(elFollowupAt, {
            triggerId: 'focus-followup-at-trigger',
            label: 'Schedule follow-up date and time',
            minDate: new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()),
          })
        : null;

    function ensureFollowupDefaultDateTime() {
      if (!elFollowupAt || String(elFollowupAt.value || '').trim()) return;
      if (focusFollowupPicker && typeof focusFollowupPicker.setDefaultInDays === 'function') {
        focusFollowupPicker.setDefaultInDays(1, 10, 0);
      }
    }
    var elOutcomeFeedback = document.getElementById('focus-outcome-feedback');
    var elSubjectWrap = document.getElementById('focus-subject-wrap');
    var elSubject = document.getElementById('focus-subject');
    var elBody = document.getElementById('focus-body');
    var elActionHint = document.getElementById('focus-action-hint');
    var btnCall = document.getElementById('focus-btn-call');
    var btnVoicemail = document.getElementById('focus-btn-voicemail');
    var btnSms = document.getElementById('focus-btn-sms');
    var btnEmail = document.getElementById('focus-btn-email');
    var btnLog = document.getElementById('focus-btn-log');
    var btnSkip = document.getElementById('focus-btn-skip');
    var btnCallNext = document.getElementById('focus-btn-call-next');
    var btnDelete = document.getElementById('focus-btn-delete');
    var autoDialNext = false;
    var modalHelp = document.getElementById('focus-modal-help');
    var modalCelebrate = document.getElementById('focus-modal-celebrate');
    var fill = document.getElementById('focus-progress-fill');
    var countEl = document.getElementById('focus-touch-count');
    var barWrap = document.getElementById('focus-progress-bar-wrap');
    var elRecommended = document.getElementById('focus-recommended');
    var elRecommendedToggle = document.getElementById('focus-recommended-toggle');
    var elProductOptions = document.getElementById('focus-product-options');
    var elProductOptionBtns = document.querySelectorAll('.focus-product-option');
    var elServiceSelect = document.getElementById('focus-service-select');
    var elRecommendedHint = document.getElementById('focus-recommended-hint');
    var elNeedsLabel = document.getElementById('focus-needs-label');
    var elBusinessNeeds = document.getElementById('focus-business-needs');
    var elScriptVariant = document.getElementById('focus-script-variant');
    var elTone = document.getElementById('focus-tone');
    var btnScheduleDeliverables = document.getElementById('focus-schedule-deliverables');
    var elFocusCallDock = document.getElementById('focus-call-dock');
    var elFocusCallDockStatus = document.getElementById('focus-call-dock-status');
    var elFocusCallDockNumber = document.getElementById('focus-call-dock-number');
    var btnFocusCallDockOpen = document.getElementById('focus-call-dock-open');
    var btnFocusCallDockHangup = document.getElementById('focus-call-dock-hangup');
    var btnFocusCallDockVmNext = document.getElementById('focus-call-dock-vm-next');
    var btnFocusCallDockCallNext = document.getElementById('focus-call-dock-call-next');
    var elBodyLabel = document.getElementById('focus-body-label');
    var elMobileFabWrap = document.getElementById('focus-mobile-fab-wrap');
    var elMobileFabActions = document.getElementById('focus-mobile-fab-actions');
    var btnMobileFabToggle = document.getElementById('focus-mobile-fab-toggle');
    var btnMobileCall = document.getElementById('focus-mobile-call');
    var btnMobileCallNext = document.getElementById('focus-mobile-call-next');
    var btnMobileLog = document.getElementById('focus-mobile-log');
    var btnMobileSkip = document.getElementById('focus-mobile-skip');
    var elOutcomePanel = document.getElementById('focus-outcome-panel');
    var elOutcomeDetails = document.getElementById('focus-outcome-details');
    var btnOutcomeCollapse = document.getElementById('focus-outcome-collapse-toggle');
    var elOutcomeCollapseIcon = document.getElementById('focus-outcome-collapse-icon');
    var elOutcomeHeading = document.getElementById('focus-outcome-heading');
    var elOutcomeShortcuts = document.getElementById('focus-outcome-shortcuts');
    var outcomePanelCollapsed = false;

    function setOutcomePanelCollapsed(collapsed) {
      outcomePanelCollapsed = !!collapsed;
      if (elOutcomePanel) {
        elOutcomePanel.setAttribute('data-collapsed', outcomePanelCollapsed ? 'true' : 'false');
      }
      if (elOutcomeDetails) {
        elOutcomeDetails.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeHeading) {
        elOutcomeHeading.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeShortcuts) {
        elOutcomeShortcuts.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (btnOutcomeCollapse) {
        btnOutcomeCollapse.setAttribute('aria-expanded', outcomePanelCollapsed ? 'false' : 'true');
        btnOutcomeCollapse.setAttribute('title', outcomePanelCollapsed ? 'Expand notes' : 'Collapse notes');
      }
      if (elOutcomeCollapseIcon) {
        elOutcomeCollapseIcon.classList.toggle('rotate-180', outcomePanelCollapsed);
      }
    }

    function isMobileViewport() {
      return window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    }
    function closeMobileFabActions() {
      if (elMobileFabActions) elMobileFabActions.classList.add('hidden');
      if (btnMobileFabToggle) btnMobileFabToggle.setAttribute('aria-expanded', 'false');
    }

    function normalizeTel(raw) {
      var s = String(raw || '').trim();
      if (!s) return '';
      var plus = s.indexOf('+') === 0 ? '+' : '';
      var digits = s.replace(/\D/g, '');
      if (!digits) return '';
      return plus + digits;
    }

    function focusHasSoftphone() {
      return typeof window.__adhelloOpenSoftphoneWithDial === 'function';
    }

    function focusSoftphoneDialLead(lead, autoDial) {
      if (!lead || !String(lead.phone || '').trim() || String(lead.phone) === 'N/A') return false;
      if (isMobileViewport()) {
        var to = normalizeTel(lead.phone);
        if (!to) return false;
        window.location.href = 'tel:' + to;
        return true;
      }
      if (!focusHasSoftphone()) return false;
      return window.__adhelloOpenSoftphoneWithDial(lead.phone, {
        autoDial: !!autoDial,
        leadKey: lead.key ? String(lead.key).trim() : '',
      });
    }

    function focusSoftphoneWrapRequired() {
      if (typeof window.__adhelloSoftphoneGetSession !== 'function') return false;
      var s = window.__adhelloSoftphoneGetSession();
      return !!(s && s.wrapRequired);
    }

    function syncFocusCallDock(detail) {
      if (!elFocusCallDock) return;
      if (isMobileViewport()) {
        elFocusCallDock.classList.add('hidden');
        return;
      }
      var d = detail && typeof detail === 'object' ? detail : {};
      if (typeof window.__adhelloSoftphoneGetSession === 'function' && !d.state) {
        d = Object.assign({}, window.__adhelloSoftphoneGetSession(), d);
      }
      var lead = currentLead();
      var rowKey = lead && lead.key ? String(lead.key).trim() : '';
      var sessionKey = String(d.leadKey || '').trim();
      var state = String(d.state || 'idle').toLowerCase();
      var active = state === 'dialing' || state === 'in_call' || state === 'ended';
      var forThisLead = !sessionKey || !rowKey || sessionKey === rowKey;
      var show = active && forThisLead;
      elFocusCallDock.classList.toggle('hidden', !show);
      if (!show) return;
      if (elFocusCallDockStatus) {
        var label = 'Call active';
        if (state === 'dialing') label = 'Dialing · ' + (d.timer || '00:00');
        else if (state === 'in_call') label = 'On call · ' + (d.timer || '00:00');
        else if (state === 'ended') label = d.wrapRequired ? 'Wrap-up required' : 'Call ended';
        elFocusCallDockStatus.textContent = label;
      }
      if (elFocusCallDockNumber) {
        var num = String(d.number || (lead && lead.phone) || '').trim();
        elFocusCallDockNumber.textContent = num || '—';
      }
      if (btnFocusCallDockHangup) {
        btnFocusCallDockHangup.disabled = !(state === 'dialing' || state === 'in_call');
      }
      if (btnFocusCallDockCallNext) {
        btnFocusCallDockCallNext.disabled = !!d.wrapRequired;
      }
    }

    function mapSoftphoneDispositionToFocusOutcome(disp) {
      var d = String(disp || '').trim().toLowerCase();
      if (!d) return '';
      if (d.indexOf('voicemail') !== -1) return 'voicemail';
      if (d.indexOf('no answer') !== -1) return 'no_pickup';
      if (d.indexOf('callback') !== -1) return 'callback_requested';
      if (d.indexOf('connected') !== -1) return 'talked_owner';
