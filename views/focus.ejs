    if (btnFocusContactDetailsToggle) {
      btnFocusContactDetailsToggle.addEventListener('click', function () {
        var open = elFocusContactDetailsDrawer && elFocusContactDetailsDrawer.classList.contains('focus-contact-details-drawer--open');
        setFocusContactDetailsOpen(!open);
      });
    }
    setFocusContactDetailsOpen(false);
    if (btnFocusNotesToggle) {
      btnFocusNotesToggle.addEventListener('click', function () {
        var open = elFocusNotesDrawer && elFocusNotesDrawer.classList.contains('focus-notes-drawer--open');
        setFocusNotesOpen(!open);
      });
    }
    if (elOutcomeNotes) {
      elOutcomeNotes.addEventListener('input', syncFocusNotesIndicator);
    }
    window.__setFocusNotesOpen = setFocusNotesOpen;
    setFocusNotesOpen(false);
    syncFocusNotesIndicator();
    if (btnOpenDialer) {
      btnOpenDialer.addEventListener('click', function () {
        openDialerForLead();
      });
    }
    if (btnAddMailList) {
      btnAddMailList.addEventListener('click', function () {
        var lead = currentLead();
        if (!lead || !lead.key) {
          setOutcomeFeedback('No lead selected.', true);
          return;
        }
        var key = focusLeadKeyParam(lead);
        if (
          typeof window.__isLeadOnDirectMailListToday === 'function' &&
          window.__isLeadOnDirectMailListToday(key)
        ) {
          setOutcomeFeedback('Already on today\'s mail list.');
          syncFocusMailListBtn(lead);
          return;
        }
        if (typeof window.__addLeadsToDirectMailQueue !== 'function') {
          setOutcomeFeedback('Direct mail queue unavailable.', true);
          return;
        }
        btnAddMailList.disabled = true;
        setOutcomeFeedback('Adding to mail list…');
        window.__addLeadsToDirectMailQueue([key])
          .then(function () {
            setOutcomeFeedback('Added to today\'s Direct Mail list.');
            syncFocusMailListBtn(lead);
          })
          .catch(function (err) {
            setOutcomeFeedback((err && err.message) || 'Could not add to mail list.', true);
            syncFocusMailListBtn(lead);
          });
      });
    }
    if (btnAddTask && elQuickTaskTitle) {
      function submitFocusQuickTask() {
        var lead = currentLead();
        var title = String(elQuickTaskTitle.value || '').trim();
        if (!title) {
          if (elQuickTaskHint) {
            elQuickTaskHint.textContent = 'Enter a task description.';
            elQuickTaskHint.classList.remove('hidden');
          }
          return;
        }
        if (typeof window.adhelloCreateManualTask !== 'function') {
          setOutcomeFeedback('Task helper unavailable.', true);
          return;
        }
        btnAddTask.disabled = true;
        if (elQuickTaskHint) {
          elQuickTaskHint.textContent = 'Saving…';
          elQuickTaskHint.classList.remove('hidden');
        }
        window.adhelloCreateManualTask({
          title: title,
          leadKey: lead && lead.key ? focusLeadKeyParam(lead) : null,
        })
          .then(function () {
            elQuickTaskTitle.value = '';
            if (elQuickTaskHint) elQuickTaskHint.textContent = 'Saved to Tasks.';
            setOutcomeFeedback('Task saved to Tasks.', false);
          })
          .catch(function (err) {
            var msg = (err && err.message) || 'Could not save task.';
            if (elQuickTaskHint) elQuickTaskHint.textContent = msg;
            setOutcomeFeedback(msg, true);
          })
          .finally(function () {
            btnAddTask.disabled = false;
          });
      }
      btnAddTask.addEventListener('click', submitFocusQuickTask);
      elQuickTaskTitle.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' || e.metaKey || e.ctrlKey || e.altKey) return;
        e.preventDefault();
        submitFocusQuickTask();
      });
    }
    if (btnMobileCall) {
      btnMobileCall.addEventListener('click', function () {
        closeMobileFabActions();
        openDialerForLead();
      });
    }
    if (btnMobileSms) {
      btnMobileSms.addEventListener('click', function () {
        closeMobileFabActions();
        openFocusSmsComposer();
      });
    }
    if (btnMobileCallNext) {
      btnMobileCallNext.addEventListener('click', function () {
        closeMobileFabActions();
        if (btnCallNext) btnCallNext.click();
      });
    }
    if (btnMobileLog) {
      btnMobileLog.addEventListener('click', function () {
        closeMobileFabActions();
        onLogNext();
      });
    }
    if (btnMobileSkip) {
      btnMobileSkip.addEventListener('click', function () {
        closeMobileFabActions();
        onSkip();
      });
    }
    function setFollowupDatetimeLocal(d) {
      if (focusFollowupPicker && typeof focusFollowupPicker.setDate === 'function') {
        focusFollowupPicker.setDate(d);
        return;
      }
      if (!elFollowupAt) return;
      var pad = function (n) { return String(n).padStart(2, '0'); };
      elFollowupAt.value =
        d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
        'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function defaultFollowupDatetime() {
      var d = new Date();
      d.setDate(d.getDate() + 1);
      d.setHours(10, 0, 0, 0);
      setFollowupDatetimeLocal(d);
    }

    function applyFollowupPreset(preset) {
      var d = new Date();
      if (preset === 'tomorrow') {
        d.setDate(d.getDate() + 1);
        d.setHours(10, 0, 0, 0);
      } else if (preset === '3days') {
        d.setDate(d.getDate() + 3);
        d.setHours(10, 0, 0, 0);
      } else if (preset === 'nextweek') {
        d.setDate(d.getDate() + 7);
        d.setHours(10, 0, 0, 0);
      } else if (preset === 'custom') {
        if (focusFollowupPicker && typeof focusFollowupPicker.open === 'function') {
          focusFollowupPicker.open();
        }
        return;
      }
      setFollowupDatetimeLocal(d);
    }

    if (elFollowupAt && typeof window.initGcalDatetimePicker === 'function') {
      focusFollowupPicker = window.initGcalDatetimePicker(elFollowupAt, {
        label: 'Schedule follow-up date and time',
        triggerId: 'focus-followup-at-trigger',
      });
    }

    if (btnOwnerSignalAi) {
      btnOwnerSignalAi.addEventListener('click', function () {
        var lead = currentLead();
        if (!lead || !lead.key) {
          setOwnerSignalFeedback('No lead selected.', true);
          return;
        }
        runFocusOwnerSignalAnalysis(lead);
      });
    }

    if (elFollowupEnable && elFollowupWrap) {
      elFollowupEnable.addEventListener('change', function () {
        var on = !!elFollowupEnable.checked;
        elFollowupWrap.classList.toggle('hidden', !on);
        if (on && elFollowupAt && !String(elFollowupAt.value || '').trim()) {
          defaultFollowupDatetime();
        }
      });
    }
    if (elFollowupPresets && elFollowupPresets.length) {
      elFollowupPresets.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (elFollowupEnable) elFollowupEnable.checked = true;
          if (elFollowupWrap) elFollowupWrap.classList.remove('hidden');
          applyFollowupPreset(btn.getAttribute('data-preset') || 'tomorrow');
        });
      });
    }
    if (elQuickOutcomeBtns && elQuickOutcomeBtns.length) {
      elQuickOutcomeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          quickSetOutcome(focusBtnSelectionValue(btn));
        });
      });
    }
    if (btnMobileFabToggle && elMobileFabActions) {
      btnMobileFabToggle.addEventListener('click', function () {
        var isOpen = !elMobileFabActions.classList.contains('hidden');
        elMobileFabActions.classList.toggle('hidden', isOpen);
        btnMobileFabToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });
      document.addEventListener('click', function (e) {
        if (!elMobileFabWrap || elMobileFabWrap.classList.contains('hidden')) return;
        if (!elMobileFabWrap.contains(e.target)) closeMobileFabActions();
      });
    }

    if (btnCall) btnCall.addEventListener('click', function () { onFocusCall(); });
    if (btnSms) btnSms.addEventListener('click', function () { openFocusSmsComposer(); });
    if (btnImproveText) btnImproveText.addEventListener('click', function () { onFocusImproveText(); });
    if (btnSmsImproveText) btnSmsImproveText.addEventListener('click', function () { onFocusImproveText(); });
    if (btnSmsComposeSend) btnSmsComposeSend.addEventListener('click', function () { sendFocusSmsCompose(); });
    if (btnSmsExpandToggle) {
      btnSmsExpandToggle.addEventListener('click', function () {
        var expanded = !!(elSmsComposeInput && elSmsComposeInput.classList.contains('focus-sms-compose-input--expanded'));
        setFocusSmsComposeExpanded(!expanded);
      });
    }
    if (btnSmsClose) btnSmsClose.addEventListener('click', function () { closeFocusSmsComposer(); });
    if (elSmsComposeInput) {
      elSmsComposeInput.addEventListener('input', syncFocusSmsComposeCount);
      elSmsComposeInput.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeFocusSmsComposer();
          return;
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
          e.preventDefault();
          sendFocusSmsCompose();
        }
      });
    }
    if (btnPushGhl) {
      btnPushGhl.addEventListener('click', function (e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        pushFocusLeadToGhl();
      });
    }
    document.addEventListener(
      'click',
      function (e) {
        if (!e.target || !e.target.closest || !e.target.closest('#focus-btn-push-ghl')) return;
        if (e.defaultPrevented) return;
        e.preventDefault();
        e.stopPropagation();
        pushFocusLeadToGhl();
      },
      true,
    );
    btnLog.addEventListener('click', onLogNext);
    btnSkip.addEventListener('click', onSkip);
    if (btnBack) btnBack.addEventListener('click', prevLead);
    if (btnBackSecondary) btnBackSecondary.addEventListener('click', prevLead);
    if (btnMobileBack) btnMobileBack.addEventListener('click', prevLead);
    if (btnEmptyBack) btnEmptyBack.addEventListener('click', prevLead);
    if (btnCallNext) btnCallNext.addEventListener('click', function () {
      var lead = currentLead();
      if (!lead) return;
      if (btnCallNext) btnCallNext.disabled = true;
      if (btnLog) btnLog.disabled = true;
      postNote()
        .then(function () { return applyFocusQuickLogIfNeeded(lead); })
        .then(function () { return maybeAdvanceStage(); })
        .then(function () {
          nextLead();
          var next = currentLead();
          if (next && String(next.phone || '').trim()) {
            setTimeout(function () { openDialerForLead({ autoDial: true }); }, 300);
          }
          return refreshMetrics();
        })
        .catch(function () {})
        .finally(function () {
          if (btnCallNext) btnCallNext.disabled = false;
          if (btnLog) btnLog.disabled = false;
        });
    });
    function deleteCurrentLead() {
      var lead = currentLead();
      if (!lead || !lead.key) return;
      if (!confirm('Delete ' + (lead.title || 'this lead') + '?')) return;
      if (btnDelete) btnDelete.disabled = true;
      fetch('/leads/' + encodeURIComponent(lead.key) + '/delete', {
        method: 'POST',
        headers: { Accept: 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.success) throw new Error(data.error || 'Delete failed');
          var removedIdx = idx;
          queue.splice(removedIdx, 1);
          adjustFocusHistoryAfterRemove(removedIdx);
          if (idx >= queue.length) idx = Math.max(0, queue.length - 1);
          if (!queue.length) {
            elSection.classList.add('hidden');
            elEmpty.classList.remove('hidden');
            elEmptyReload.classList.add('hidden');
            elEmptyTitle.textContent = 'No leads in this queue';
            elEmptyDesc.textContent = 'Add or import leads to your pipeline, then come back.';
            return;
          }
          renderCard();
          return refreshMetrics();
        })
        .catch(function (err) {
          setCopyFeedback(err && err.message ? err.message : 'Could not delete lead.', true);
        })
        .finally(function () {
          if (btnDelete) btnDelete.disabled = false;
        });
    }
    if (btnDelete) btnDelete.addEventListener('click', deleteCurrentLead);
    if (btnCopyPhone) btnCopyPhone.addEventListener('click', function () { copyLeadField('phone', 'Phone'); });
    if (btnCopyEmail) btnCopyEmail.addEventListener('click', function () { copyLeadField('email', 'Email'); });
    if (btnCopyWebsite) btnCopyWebsite.addEventListener('click', function () { copyLeadField('website', 'Website'); });

    document.getElementById('focus-help-btn').addEventListener('click', function () {
      modalHelp.classList.remove('hidden');
    });
    document.getElementById('focus-help-close').addEventListener('click', function () {
      modalHelp.classList.add('hidden');
    });
    modalHelp.addEventListener('click', function (e) {
      if (e.target === modalHelp) modalHelp.classList.add('hidden');
    });
    document.getElementById('focus-celebrate-continue').addEventListener('click', function () {
      celebrateDismissed = true;
      modalCelebrate.classList.add('hidden');
    });
    modalCelebrate.addEventListener('click', function (e) {
      if (e.target === modalCelebrate) {
        celebrateDismissed = true;
        modalCelebrate.classList.add('hidden');
      }
    });

    function typingTarget(el) {
      if (!el) return false;
      var tag = el.tagName;
      if (tag === 'TEXTAREA') return true;
      if (tag === 'SELECT') return true;
      if (tag === 'INPUT') return el.type !== 'button' && el.type !== 'submit' && el.type !== 'checkbox' && el.type !== 'radio';
      return el.isContentEditable;
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        modalHelp.classList.add('hidden');
        celebrateDismissed = true;
        modalCelebrate.classList.add('hidden');
      }
      if (e.key === '?' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        modalHelp.classList.toggle('hidden');
      }
      if (e.key === 'e' || e.key === 'E') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        (elBodyRich || elBody).focus();
      }
      if (e.key === 'l' || e.key === 'L') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        onLogNext();
      }
      if (e.key === 'b' || e.key === 'B') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        prevLead();
      }
      if (e.key === 'n' || e.key === 'N') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        if (btnCallNext) btnCallNext.click();
      }
      if (e.key === 'j' || e.key === 'J') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        onSkip();
      }
      if (e.key === 'd' || e.key === 'D') {
        if (typingTarget(document.activeElement)) return;
        e.preventDefault();
        deleteCurrentLead();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        onSendAdvance();
      }
    });

    elEmptyReload.addEventListener('click', function () {
      location.reload();
    });
    window.addEventListener('resize', updateDialerCta);
    window.addEventListener('adhello-softphone-state', updateDialerCta);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        refreshFocusScriptLibrary().then(updateDraftFromSelection);
      }
    });

    initFocusContactEdit();

    if (elServiceSelect) {
      elServiceSelect.value = getDefaultProductKey();
    }

    if (typeof window.bindRapidapiWebsiteEnrichButton === 'function') {
      window.bindRapidapiWebsiteEnrichButton(document.getElementById('focus-rapidapi-enrich-btn'), {
        statusEl: document.getElementById('focus-rapidapi-enrich-status'),
        getLeadKey: function () {
          var lead = currentLead();
          return lead ? focusLeadKeyParam(lead) : '';
        },
        onUpdated: function (updatedLead) {
          if (!updatedLead) return;
          var lead = currentLead();
          if (lead) {
            Object.keys(updatedLead).forEach(function (k) {
              if (updatedLead[k] !== undefined && updatedLead[k] !== null) lead[k] = updatedLead[k];
            });
          }
          renderLinks(lead || updatedLead);
          renderFocusContactFields(lead || updatedLead);
          renderBusinessInfo(lead || updatedLead);
          if (elCopyFeedback) {
            elCopyFeedback.textContent = 'Contacts enriched.';
          }
        },
      });
    }

    if (!queue.length) {
      elSection.classList.add('hidden');
      elEmpty.classList.remove('hidden');
      elEmptyReload.classList.add('hidden');
    } else {
      if (typeof window.__refreshDirectMailQueueFromServer === 'function') {
        window.__refreshDirectMailQueueFromServer()
          .catch(function () {})
          .then(function () {
            renderCard();
            syncBackButton();
            updateSelectionProgress();
          });
      } else {
        renderCard();
        syncBackButton();
        updateSelectionProgress();
      }
      if (!isSelectionSession) {
        var initial = parseInt(countEl.textContent, 10) || 0;
        if (initial >= touchGoal) modalCelebrate.classList.remove('hidden');
      }
    }
  })();
  </script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
