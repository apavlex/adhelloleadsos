<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden<%= (typeof isAgencySalesWorkspace !== 'undefined' && isAgencySalesWorkspace) ? '' : ' lead-panel--non-agency' %>">
  <%- include('partials/navbar') %>

  <% const _isAgencySalesWorkspace = typeof isAgencySalesWorkspace !== 'undefined' && isAgencySalesWorkspace; %>
  <% const _focusIsSelectionSession = typeof focusIsSelectionSession !== 'undefined' && focusIsSelectionSession; %>
  <% const _focusSelectionCount = typeof focusSelectionCount === 'number' && focusSelectionCount > 0 ? focusSelectionCount : null; %>
  <% const _focusDailyGoal = typeof touchGoal !== 'undefined' ? touchGoal : 54; %>
  <% const _focusProgressCurrent = _focusIsSelectionSession ? 1 : (typeof touchesToday !== 'undefined' ? touchesToday : 0); %>
  <% const _focusProgressGoal = _focusIsSelectionSession && _focusSelectionCount ? _focusSelectionCount : _focusDailyGoal; %>
  <% const _focusProgressPct = _focusProgressGoal > 0 ? Math.min(100, Math.round((_focusProgressCurrent / _focusProgressGoal) * 100)) : 0; %>
  <% const _eq = typeof entrepreneurQuote !== 'undefined' && entrepreneurQuote ? entrepreneurQuote : null; %>
  <main class="max-wide px-6 py-8 pb-28 md:pb-10 md:py-10">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <h1 id="focus-session-title" class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Focus Mode</h1>
          <% if (_eq && _eq.text) { %>
          <blockquote class="mt-3 max-w-xl">
            <p class="font-display font-bold text-base md:text-lg leading-snug text-brand-dark dark:text-slate-100">“<%= _eq.text %>”</p>
            <% if (_eq.author) { %><footer class="mt-1.5 text-sm font-bold text-brand-muted dark:text-slate-400">— <%= _eq.author %></footer><% } %>
          </blockquote>
          <% } %>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-2">One lead at a time — draft, log, next. <button type="button" id="focus-help-btn" class="font-bold text-brand-dark dark:text-white underline decoration-brand-yellow/60 hover:decoration-brand-yellow">Shortcuts (?)</button></p>
        </div>
        <a href="/today" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">← Today</a>
      </div>
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-4 py-3">
        <div class="flex justify-between items-baseline text-sm mb-2">
          <span id="focus-progress-label" class="text-brand-muted dark:text-slate-400">Touches today</span>
          <span class="font-display font-black text-brand-dark dark:text-white"><span id="focus-touch-count"><%= _focusProgressCurrent %></span> <span class="text-brand-muted font-bold text-sm">/ <span id="focus-touch-goal"><%= _focusProgressGoal %></span></span></span>
        </div>
        <div class="h-2 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= _focusProgressGoal %>" aria-valuenow="<%= _focusProgressCurrent %>" id="focus-progress-bar-wrap">
          <div id="focus-progress-fill" class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width: <%= _focusProgressPct %>%"></div>
        </div>
      </div>
    </header>

    <div id="focus-empty" class="hidden rounded-[2rem] border-2 border-dashed border-brand-border dark:border-white/15 bg-white/60 dark:bg-slate-900/50 px-8 py-14 text-center">
      <h2 id="focus-empty-title" class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2">No leads in this queue</h2>
      <p id="focus-empty-desc" class="text-sm text-brand-muted mb-6 max-w-md mx-auto">Add or import business leads to your pipeline, then come back. Listings and products are excluded from Focus.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <button type="button" id="focus-empty-back" class="hidden btn-pill border-2 border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white disabled:opacity-40 disabled:pointer-events-none" disabled>← Go back</button>
        <button type="button" id="focus-empty-reload" class="hidden btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Reload queue</button>
        <a href="/prospecting?tab=pipeline" class="btn-pill btn-primary inline-flex px-8 py-3 text-xs font-black uppercase tracking-widest">Open pipeline</a>
      </div>
    </div>

    <section id="focus-card-section" class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/85 dark:bg-slate-900/75 shadow-sm p-6 md:p-8 max-w-4xl lg:max-w-5xl xl:max-w-6xl mx-auto w-full min-w-0" aria-label="Current lead">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h2 id="focus-company" class="font-display font-black text-2xl text-brand-dark dark:text-white truncate">—</h2>
          <p id="focus-contact" class="text-sm font-semibold text-brand-muted dark:text-slate-400 mt-1">—</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="focus-btn-back" disabled class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-800/60 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/50 transition-colors disabled:opacity-40 disabled:pointer-events-none shrink-0" title="Previous lead in this session" aria-label="Go back to previous lead">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            <span class="hidden sm:inline">Back</span>
          </button>
          <button type="button" id="focus-btn-delete" class="w-8 h-8 rounded-lg border border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-800/60 text-brand-muted hover:text-red-600 dark:hover:text-red-400 hover:border-red-500/40 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors flex items-center justify-center shrink-0" title="Delete lead" aria-label="Delete lead">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
          <span id="focus-stage-badge" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 border border-brand-border/50 dark:border-white/10 text-brand-dark dark:text-slate-200">—</span>
        </div>
      </div>
      <div class="mb-4 rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/40 px-3 py-2.5">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Last touch</p>
        <p id="focus-last-touch" class="text-sm font-bold text-brand-dark dark:text-white leading-snug">—</p>
        <p id="focus-last-touch-detail" class="text-[11px] text-brand-muted mt-1 line-clamp-2 hidden"></p>
        <span id="focus-engagement-badge" class="hidden mt-2 inline-flex text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border border-emerald-500/40 text-emerald-800 dark:text-emerald-200"></span>
      </div>

      <div id="focusLeadTagsSection" class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-800/40 px-4 py-3">
        <div class="flex items-center justify-between gap-2 mb-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Tags</p>
          <a href="/tags/manage" class="text-[9px] font-bold uppercase tracking-wide text-brand-yellow hover:underline shrink-0">Manage all tags →</a>
        </div>
        <div id="focusLeadTagsHost" class="rounded-xl border border-brand-border/20 dark:border-white/10 bg-white/60 dark:bg-slate-900/40 p-3">
          <p class="text-[11px] text-brand-muted dark:text-slate-400 italic">Loading tags…</p>
        </div>
      </div>

      <div id="focus-links" class="flex flex-wrap gap-2 mb-4" aria-label="Contact and social links"></div>
      <div id="focus-contact-fields" class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-800/40 overflow-hidden">
        <button type="button" id="focusContactDetailsToggle" aria-expanded="false" aria-controls="focusContactDetailsDrawer" class="w-full flex items-center justify-between gap-3 px-4 py-3 text-left hover:bg-brand-cream/50 dark:hover:bg-slate-800/80 transition-colors">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Contact details</span>
          <svg id="focusContactDetailsChevron" class="w-4 h-4 shrink-0 text-brand-muted transition-transform duration-300 ease-out rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="focusContactDetailsDrawer" class="focus-contact-details-drawer border-t border-brand-border/15 dark:border-white/10 px-4 space-y-2.5" role="region" aria-label="Contact details">
        <div id="focus-header-address-row" class="flex items-start gap-2.5 group/item">
          <div class="w-5 h-5 mt-0.5 rounded-md flex items-center justify-center shrink-0 bg-brand-cream dark:bg-slate-800 text-brand-muted"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg></div>
          <div class="flex-1 min-w-0"><span id="focus-header-address" class="text-[13px] font-semibold leading-snug text-brand-muted dark:text-slate-400">—</span><input id="focus-header-address-input" type="text" class="hidden w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[13px] font-semibold text-brand-dark dark:text-white" placeholder="Street, city, state" autocomplete="street-address" /></div>
          <button type="button" id="focus-edit-address-btn" class="shrink-0 w-7 h-7 rounded-lg border border-brand-border/30 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 text-brand-muted hover:text-brand-yellow hover:border-brand-yellow/40 transition-colors flex items-center justify-center" aria-label="Edit address" title="Edit address"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
        </div>
        <div id="focus-header-phone-row" class="flex items-center gap-2.5 group/item">
          <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0 bg-brand-cream dark:bg-slate-800 text-brand-muted"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg></div>
          <div class="flex-1 min-w-0"><span id="focus-header-phone" class="text-[13px] font-bold text-brand-dark dark:text-white tabular-nums">—</span><input id="focus-header-phone-input" type="tel" class="hidden w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[13px] font-bold text-brand-dark dark:text-white tabular-nums" placeholder="(555) 555-5555" autocomplete="tel" /></div>
          <button type="button" id="focus-edit-phone-btn" class="shrink-0 w-7 h-7 rounded-lg border border-brand-border/30 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 text-brand-muted hover:text-brand-yellow hover:border-brand-yellow/40 transition-colors flex items-center justify-center" aria-label="Edit phone" title="Edit phone"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
        </div>
        <div id="focus-header-website-row" class="flex items-center gap-2.5 group/item">
          <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0 bg-brand-cream dark:bg-slate-800 text-brand-muted"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg></div>
          <div class="flex-1 min-w-0"><a href="#" id="focus-header-website" target="_blank" rel="noopener noreferrer" class="text-[13px] font-semibold text-brand-dark dark:text-white hover:text-brand-yellow transition-colors truncate block no-underline">—</a><input id="focus-header-website-input" type="url" inputmode="url" class="hidden w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[13px] font-semibold text-brand-dark dark:text-white" placeholder="https://example.com" autocomplete="url" /></div>
          <button type="button" id="focus-edit-website-btn" class="shrink-0 w-7 h-7 rounded-lg border border-brand-border/30 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 text-brand-muted hover:text-brand-yellow hover:border-brand-yellow/40 transition-colors flex items-center justify-center" aria-label="Edit website" title="Edit website"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
        </div>
        <div id="focus-header-email-row" class="flex items-center gap-2.5 group/item">
          <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0 bg-brand-cream dark:bg-slate-800 text-brand-muted"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg></div>
          <div class="flex-1 min-w-0"><a href="#" id="focus-header-email" class="text-[13px] font-semibold text-brand-dark dark:text-white hover:text-brand-yellow transition-colors truncate block no-underline">—</a><input id="focus-header-email-input" type="email" class="hidden w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[13px] font-semibold text-brand-dark dark:text-white" placeholder="owner@business.com" autocomplete="email" /></div>
          <button type="button" id="focus-edit-email-btn" class="shrink-0 w-7 h-7 rounded-lg border border-brand-border/30 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 text-brand-muted hover:text-brand-yellow hover:border-brand-yellow/40 transition-colors flex items-center justify-center" aria-label="Edit email" title="Edit email"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
        </div>
        <div id="focus-header-socials-row" class="flex items-start gap-2.5 group/item">
          <div class="w-5 h-5 mt-0.5 rounded-md flex items-center justify-center shrink-0 bg-brand-cream dark:bg-slate-800 text-brand-muted"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg></div>
          <div class="flex-1 min-w-0">
            <span id="focus-header-socials-summary" class="text-[13px] font-semibold leading-snug text-brand-muted dark:text-slate-400">—</span>
            <div id="focus-socials-edit-panel" class="hidden w-full mt-1.5 space-y-2">
              <div><label for="focus-social-url-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">Google Business / Maps URL</label><input id="focus-social-url-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://maps.google.com/…" autocomplete="url" /></div>
              <div><label for="focus-social-facebook-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">Facebook</label><input id="focus-social-facebook-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://facebook.com/…" autocomplete="url" /></div>
              <div><label for="focus-social-instagram-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">Instagram</label><input id="focus-social-instagram-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://instagram.com/…" autocomplete="url" /></div>
              <div><label for="focus-social-twitter-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">X / Twitter</label><input id="focus-social-twitter-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://x.com/…" autocomplete="url" /></div>
              <div><label for="focus-social-linkedin-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">LinkedIn</label><input id="focus-social-linkedin-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://linkedin.com/…" autocomplete="url" /></div>
              <div><label for="focus-social-tiktok-input" class="text-[9px] font-black uppercase tracking-widest text-brand-muted block mb-0.5">TikTok</label><input id="focus-social-tiktok-input" type="url" inputmode="url" class="w-full rounded-lg border border-brand-border/40 dark:border-white/15 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-[12px] font-semibold text-brand-dark dark:text-white" placeholder="https://tiktok.com/@…" autocomplete="url" /></div>
              <div class="flex flex-wrap items-center gap-2 pt-0.5"><button type="button" id="focus-socials-save-btn" class="btn-pill bg-brand-yellow text-brand-dark px-2.5 py-1 text-[9px] font-black uppercase tracking-widest">Save</button><button type="button" id="focus-socials-cancel-btn" class="text-[9px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">Cancel</button></div>
            </div>
          </div>
          <button type="button" id="focus-edit-socials-btn" class="shrink-0 w-7 h-7 rounded-lg border border-brand-border/30 dark:border-white/10 bg-white/80 dark:bg-slate-800/80 text-brand-muted hover:text-brand-yellow hover:border-brand-yellow/40 transition-colors flex items-center justify-center" aria-label="Edit social links" title="Edit social links"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
        </div>
        <p id="focus-contact-edit-feedback" class="text-[11px] text-brand-muted min-h-[1rem]"></p>
        </div>
      </div>
      <div class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/35 dark:bg-slate-800/60 px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Business info</p>
        <div class="flex flex-col md:flex-row gap-4 items-stretch">
          <div id="focus-map-wrap" class="hidden w-full md:w-[min(100%,280px)] shrink-0 rounded-xl border border-brand-border/50 dark:border-white/10 overflow-hidden bg-slate-200/80 dark:bg-slate-950/80 aspect-[4/3] md:aspect-auto md:h-52 min-h-[11rem] relative shadow-inner" aria-hidden="true">
            <img id="focus-map-img" class="absolute inset-0 z-0 w-full h-full object-cover opacity-0 pointer-events-none transition-opacity duration-200" alt="" loading="eager" width="560" height="336" decoding="async" />
            <div id="focus-map-fallback" class="absolute inset-0 z-0 hidden flex-col items-center justify-center gap-2 px-4 text-center bg-brand-cream/85 dark:bg-slate-800/95">
