          ? 'Comms'
          : data && data.provider === 'ghl'
            ? 'Go High Level'
            : 'SMS');
      return kind + ' sent via ' + provider + '.';
    }

    function placeFocusSmsFromBody(msgBody) {
      var lead = currentLead();
      if (!lead || !lead.key) return Promise.resolve();
      msgBody = String(msgBody || '').trim();
      if (!msgBody) {
        setFocusSmsComposeStatus('SMS body is empty. Add a message first.', true);
        return Promise.reject(new Error('sms body empty'));
      }
      var phone = normalizeTel(lead.phone || '');
      if (!phone) {
        setFocusSmsComposeStatus('No phone found for this lead.', true);
        return Promise.reject(new Error('missing phone'));
      }
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/sms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ body: msgBody }),
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'SMS failed');
            return j;
          });
        });
    }

    function setFocusSmsSendBusy(busy) {
      if (btnSmsComposeSend) {
        btnSmsComposeSend.disabled = !!busy;
        btnSmsComposeSend.textContent = busy ? 'Sending…' : 'Send SMS';
      }
    }

    function openFocusSmsComposer() {
      var lead = currentLead();
      if (!lead || !lead.key) return;
      if (isFocusSmsComposeOpen()) {
        closeFocusSmsComposer();
        return;
      }
      var phone = normalizeTel(lead.phone || '');
      if (!phone) {
        setFocusSmsComposeStatus('No phone found for this lead.', true);
        if (elSmsComposeSection) elSmsComposeSection.classList.remove('hidden');
        syncFocusSmsButtonState();
        return;
      }
      if (outcomePanelCompact) {
        smsOpenedFromCompact = true;
      } else {
        smsOpenedFromCompact = false;
      }
      if (elSmsComposeSection) elSmsComposeSection.classList.remove('hidden');
      var scriptText = getFocusBodyPlain();
      if (elSmsComposeInput && !String(elSmsComposeInput.value || '').trim() && scriptText) {
        elSmsComposeInput.value = scriptText;
        if (scriptText.length > 180) setFocusSmsComposeExpanded(true);
        syncFocusSmsComposeCount();
      } else {
        autogrowFocusSmsCompose();
      }
      if (elSmsComposeSection) elSmsComposeSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (elSmsComposeInput) {
        window.setTimeout(function () {
          elSmsComposeInput.focus();
          var len = elSmsComposeInput.value.length;
          if (typeof elSmsComposeInput.setSelectionRange === 'function') elSmsComposeInput.setSelectionRange(len, len);
        }, 120);
      }
      setFocusSmsComposeStatus('Type your message, use Improve text if needed, then Send SMS.');
      syncFocusSmsButtonState();
    }

    function sendFocusSmsCompose() {
      var lead = currentLead();
      if (!lead || !lead.key) return;
      var msgBody = String((elSmsComposeInput && elSmsComposeInput.value) || '').trim();
      if (!msgBody) {
        setFocusSmsComposeStatus('Add a message before sending.', true);
        return;
      }
      setFocusSmsSendBusy(true);
      setFocusSmsComposeStatus('Sending…');
      placeFocusSmsFromBody(msgBody)
        .then(function (data) {
          setFocusSmsComposeStatus(focusSmsSuccessLabel(data));
          if (data && data.lead) {
            Object.assign(lead, data.lead);
            applyFocusPipelineFromLead(lead, data.lead);
          }
          if (elSmsComposeInput) {
            elSmsComposeInput.value = '';
            syncFocusSmsComposeCount();
          }
        })
        .catch(function (err) {
          setFocusSmsComposeStatus(err && err.message ? err.message : 'Could not send SMS.', true);
        })
        .finally(function () {
          setFocusSmsSendBusy(false);
        });
    }

    function onFocusImproveText() {
      var lead = currentLead();
      if (!lead || !lead.key) {
        if (isFocusSmsComposeOpen()) setFocusSmsComposeStatus('No lead selected.', true);
        else setCopyFeedback('No lead selected.', true);
        return;
      }
      var composeOpen = isFocusSmsComposeOpen();
      var targetingSms = composeOpen && elSmsComposeInput;
      var activeImproveBtn = targetingSms && btnSmsImproveText ? btnSmsImproveText : btnImproveText;
      var draft = targetingSms
        ? String((elSmsComposeInput && elSmsComposeInput.value) || '').trim()
        : getFocusBodyPlain();
      if (!draft) {
        var emptyMsg = 'Add a message to improve first.';
        if (composeOpen) setFocusSmsComposeStatus(emptyMsg, true);
        else setCopyFeedback(emptyMsg, true);
        return;
      }
      if (activeImproveBtn) {
        activeImproveBtn.disabled = true;
        activeImproveBtn.textContent = 'Improving…';
      }
      if (composeOpen) setFocusSmsComposeStatus('Improving text…');
      else setCopyFeedback('Improving text…');
      fetch('/leads/' + encodeURIComponent(lead.key) + '/sms-personalize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ scriptText: draft, context: 'outreach' }),
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok || !j.success) throw new Error((j && j.error) || 'Could not improve text.');
            return j;
          });
        })
        .then(function (data) {
          if (data.personalized) {
            if (targetingSms && elSmsComposeInput) elSmsComposeInput.value = data.personalized;
            else {
              setFocusBodyHtml(data.personalized);
              markFocusScriptDirty();
            }
          }
          if (composeOpen) {
            syncFocusSmsComposeCount();
            setFocusSmsComposeStatus('Text improved — review and tap Send SMS when ready.');
          } else {
            setCopyFeedback('Text improved — review the script, then Call, SMS, or Save.');
          }
        })
        .catch(function (err) {
          var errMsg = err && err.message ? err.message : 'Could not improve text.';
          if (composeOpen) setFocusSmsComposeStatus(errMsg, true);
          else setCopyFeedback(errMsg, true);
        })
        .finally(function () {
          [btnImproveText, btnSmsImproveText].forEach(function (btn) {
            if (!btn) return;
            btn.disabled = false;
            btn.textContent = 'Improve text';
          });
        });
    }

    function placeFocusEmail() {
      var lead = currentLead();
      if (!lead) return Promise.resolve();
      var email = String((lead && lead.email) || '').trim();
      if (!email || email === 'N/A') {
        setCopyFeedback('No email found for this lead.', true);
        return Promise.reject(new Error('missing email'));
      }
      var subject = String((elSubject && elSubject.value) || '').trim();
      var body = getFocusBodyPlain();
      var mailto = 'mailto:' + encodeURIComponent(email);
      var params = [];
      if (subject) params.push('subject=' + encodeURIComponent(subject));
      if (body) params.push('body=' + encodeURIComponent(body));
      if (params.length) mailto += '?' + params.join('&');
      try {
        window.location.href = mailto;
        setCopyFeedback('Email client opened.');
        return Promise.resolve({ success: true });
      } catch (err) {
        setCopyFeedback('Could not open email client.', true);
        return Promise.reject(err);
      }
    }

    function mapQueryFromFocusLead(lead) {
      var street = String((lead && lead.address) || '').trim();
      if (street === 'N/A') street = '';
      street = street.replace(/\s*[·•|]\s*/g, ', ').replace(/\s+/g, ' ').trim();
      var city = String((lead && lead.city) || '').trim();
      if (city === 'N/A') city = '';
      var state = String((lead && lead.state) || '').trim();
      if (state === 'N/A') state = '';
      var zip = String((lead && (lead.zip || lead.postalCode)) || '').trim();
      if (zip === 'N/A') zip = '';
      if (street) {
        var locParts = [];
        if (city) locParts.push(city);
        if (state) locParts.push(state);
        var loc = locParts.join(', ');
        if (zip) loc = loc ? loc + ' ' + zip : zip;
        return loc ? street + ', ' + loc : street;
      }
      var cs = [city, state].filter(Boolean).join(', ');
      var title = String((lead && lead.title) || '').trim();
      if (title && cs) return title + ', ' + cs;
      return title || cs || '';
    }

    function focusMapPreviewFallbackUrl(q, lat, lng) {
      var mapKey = (typeof window !== 'undefined' && window.__ADHELLO_GOOGLE_MAPS_STATIC_KEY__) || '';
      if (mapKey && Number.isFinite(lat) && Number.isFinite(lng)) {
        var center = lat + ',' + lng;
        return (
          'https://maps.googleapis.com/maps/api/staticmap?center=' + encodeURIComponent(center) +
          '&zoom=15&size=560x336&scale=2&maptype=roadmap&markers=' + encodeURIComponent('color:0xEAB308|' + center) +
          '&key=' + encodeURIComponent(mapKey)
        );
      }
      if (mapKey && q) {
        return (
          'https://maps.googleapis.com/maps/api/staticmap?center=' + encodeURIComponent(q) +
          '&zoom=15&size=560x336&scale=2&maptype=roadmap&markers=' + encodeURIComponent('color:0xEAB308|' + q) +
          '&key=' + encodeURIComponent(mapKey)
        );
      }
      if (Number.isFinite(lat) && Number.isFinite(lng)) {
        var point = lat + ',' + lng;
        return 'https://staticmap.openstreetmap.de/staticmap.php?center=' + encodeURIComponent(point) +
          '&zoom=15&size=560x336&markers=' + encodeURIComponent(point + ',red-pushpin');
      }
      if (q) {
        return 'https://staticmap.openstreetmap.de/staticmap.php?center=' + encodeURIComponent(q) +
          '&zoom=15&size=560x336&markers=' + encodeURIComponent(q + ',red-pushpin');
      }
      return '';
    }

    function renderFocusMap(lead) {
      var wrap = document.getElementById('focus-map-wrap');
      var img = document.getElementById('focus-map-img');
      var attrib = document.getElementById('focus-map-attribution');
      var fallback = document.getElementById('focus-map-fallback');
      var openLink = document.getElementById('focus-map-open-link');
      if (!wrap || !img) return;
      var q = mapQueryFromFocusLead(lead);
      if (!q) {
        wrap.classList.add('hidden');
        wrap.setAttribute('aria-hidden', 'true');
        img.onload = null;
        img.onerror = null;
        img.removeAttribute('src');
        img.classList.add('opacity-0');
        if (attrib) attrib.classList.add('hidden');
        if (fallback) {
          fallback.classList.add('hidden');
          fallback.classList.remove('flex');
        }
        return;
      }
      var mapsHref = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
      if (openLink) openLink.href = mapsHref;

      wrap.classList.remove('hidden');
      wrap.setAttribute('aria-hidden', 'false');
      img.onload = null;
      img.onerror = null;
      img.removeAttribute('src');
      img.classList.add('opacity-0');
      if (attrib) attrib.classList.add('hidden');
      if (fallback) {
        fallback.classList.add('hidden');
        fallback.classList.remove('flex');
      }

      var params = new URLSearchParams();
      params.set('center', q);
      params.set('w', '560');
      params.set('h', '336');
      var lat = Number(lead && lead.latitude);
      var lng = Number(lead && lead.longitude);
      if (Number.isFinite(lat) && Number.isFinite(lng)) {
        params.set('lat', String(lat));
        params.set('lng', String(lng));
      }

      var loadGen = (window.__focusMapLoadGen = (window.__focusMapLoadGen || 0) + 1);
      var isCurrent = function () { return loadGen === window.__focusMapLoadGen; };

      var revealMap = function () {
        if (!isCurrent()) return;
        img.classList.remove('opacity-0');
        if (attrib) attrib.classList.remove('hidden');
        if (fallback) {
          fallback.classList.add('hidden');
          fallback.classList.remove('flex');
        }
      };

      var showFallback = function () {
        if (!isCurrent()) return;
        img.onload = null;
        img.onerror = null;
        img.removeAttribute('src');
        img.classList.add('opacity-0');
        if (attrib) attrib.classList.add('hidden');
        if (fallback) {
          fallback.classList.remove('hidden');
          fallback.classList.add('flex');
        }
      };

      var tryLoad = function (url, nextUrl) {
        if (!url) {
          if (nextUrl) tryLoad(nextUrl, '');
          else showFallback();
          return;
        }
        img.onload = function () {
          if (!isCurrent()) return;
          revealMap();
        };
        img.onerror = function () {
          if (!isCurrent()) return;
          img.onload = null;
          img.onerror = null;
          img.removeAttribute('src');
          img.classList.add('opacity-0');
          if (nextUrl) tryLoad(nextUrl, '');
          else showFallback();
        };
        img.alt = q ? 'Map near ' + q.slice(0, 120) : 'Location map';
        img.src = url;
      };

      var serverUrl = '/leads/map-preview?' + params.toString();
      var clientFallback = focusMapPreviewFallbackUrl(q, lat, lng);
      tryLoad(serverUrl, clientFallback);
    }

    function parseFocusTechStackTags(raw) {
      if (Array.isArray(raw)) return raw.map(function (t) { return String(t).trim(); }).filter(Boolean);
      var s = String(raw || '').trim();
      if (!s) return [];
      try {
        var parsed = JSON.parse(s);
        if (Array.isArray(parsed)) return parsed.map(function (t) { return String(t).trim(); }).filter(Boolean);
      } catch (e) { /* plain string */ }
      return s.split(',').map(function (t) { return t.trim(); }).filter(Boolean);
    }

    function domainFromLeadWebsite(raw) {
      var s = String(raw || '').trim();
      if (!s || s === 'N/A' || s === '—') return '';
      try {
        var u = s.indexOf('http') === 0 ? s : 'https://' + s;
        return new URL(u).hostname.replace(/^www\./i, '');
      } catch (e) {
        return '';
      }
    }

    function renderBuiltWith(lead) {
      if (!elBuiltWithWrap || !elBuiltWithTags) return;
      if (!isAgencySalesWorkspace) {
        elBuiltWithWrap.classList.add('hidden');
        return;
      }
      var website = lead && lead.website ? String(lead.website).trim() : '';
      var domain = domainFromLeadWebsite(website);
      var cms = lead && lead.cmsPlatform ? String(lead.cmsPlatform).trim() : '';
      var tags = parseFocusTechStackTags(lead && lead.techStackTags);
      var builtWithUrl = (lead && lead.builtWithUrl ? String(lead.builtWithUrl).trim() : '') || (domain ? 'https://builtwith.com/' + domain : '');
      var hasWebsite = !!domain;
      var hasStack = !!cms || tags.length > 0;

      if (!hasWebsite && !hasStack) {
        elBuiltWithWrap.classList.add('hidden');
        return;
      }
      elBuiltWithWrap.classList.remove('hidden');

      if (elBuiltWithLink) {
        if (builtWithUrl) {
          elBuiltWithLink.href = builtWithUrl;
          elBuiltWithLink.classList.remove('hidden');
        } else {
          elBuiltWithLink.href = '#';
          elBuiltWithLink.classList.add('hidden');
        }
      }
      if (elBuiltWithCms) {
        if (cms && cms !== 'N/A') {
          elBuiltWithCms.textContent = 'CMS / platform: ' + cms;
          elBuiltWithCms.classList.remove('hidden');
        } else {
          elBuiltWithCms.textContent = '';
          elBuiltWithCms.classList.add('hidden');
        }
      }
      elBuiltWithTags.innerHTML = '';
      var showTags = tags.slice(0, 12);
      showTags.forEach(function (tag) {
        var pill = document.createElement('span');
        pill.className = 'inline-flex items-center px-2 py-0.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-white/70 dark:bg-slate-900/60 text-[10px] font-semibold text-brand-dark dark:text-slate-200';
        pill.textContent = tag;
        elBuiltWithTags.appendChild(pill);
      });
      if (tags.length > showTags.length) {
        var more = document.createElement('span');
        more.className = 'text-[10px] font-semibold text-brand-muted';
        more.textContent = '+' + (tags.length - showTags.length) + ' more';
        elBuiltWithTags.appendChild(more);
      }
      if (elBuiltWithMeta) {
        if (hasWebsite && !hasStack && lead && lead._builtWithLoading) {
          elBuiltWithMeta.textContent = 'Fetching tech stack from BuiltWith…';
          elBuiltWithMeta.classList.remove('hidden');
        } else if (lead && lead._builtWithError) {
          elBuiltWithMeta.textContent = String(lead._builtWithError);
          elBuiltWithMeta.classList.remove('hidden');
        } else if (!hasStack && hasWebsite) {
          elBuiltWithMeta.textContent = 'Click BuiltWith → to load tech stack for this site.';
          elBuiltWithMeta.classList.remove('hidden');
        } else {
          elBuiltWithMeta.textContent = '';
          elBuiltWithMeta.classList.add('hidden');
        }
      }
    }

    function fetchFocusBuiltWithTechStack(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key || !lead) return;
      lead._builtWithLoading = true;
      delete lead._builtWithError;
      renderBuiltWith(lead);
      fetch('/leads/' + encodeURIComponent(key) + '/builtwith-enrich', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok || !result.data || !result.data.success) {
            throw new Error((result.data && result.data.error) || 'Could not load tech stack');
          }
          if (result.data.lead) Object.assign(lead, result.data.lead);
          delete lead._builtWithLoading;
          var cmsAfter = lead.cmsPlatform ? String(lead.cmsPlatform).trim() : '';
          var tagsAfter = parseFocusTechStackTags(lead.techStackTags);
          var gotStack = (!!cmsAfter && cmsAfter !== 'N/A') || tagsAfter.length > 0;
          if (!gotStack && result.data.message) lead._builtWithError = String(result.data.message);
          var cur = currentLead();
          if (cur && focusLeadKeyParam(cur) === key) {
            renderBuiltWith(cur);
            renderBusinessInfo(cur);
          }
        })
        .catch(function (err) {
          delete lead._builtWithLoading;
          lead._builtWithError = (err && err.message) ? err.message : 'Tech stack fetch failed.';
          var cur = currentLead();
          if (cur && focusLeadKeyParam(cur) === key) renderBuiltWith(cur);
        });
    }

    if (elBuiltWithLink && !elBuiltWithLink.dataset.focusBuiltWithBound) {
      elBuiltWithLink.dataset.focusBuiltWithBound = '1';
      elBuiltWithLink.addEventListener('click', function (e) {
        var lead = currentLead();
        if (!lead) return;
        var website = lead.website ? String(lead.website).trim() : '';
        var domain = domainFromLeadWebsite(website);
        var cms = lead.cmsPlatform ? String(lead.cmsPlatform).trim() : '';
        var tags = parseFocusTechStackTags(lead.techStackTags);
        var hasStack = (!!cms && cms !== 'N/A') || tags.length > 0;
        if (domain && !hasStack) {
          e.preventDefault();
          if (lead._builtWithLoading) return;
          fetchFocusBuiltWithTechStack(lead);
        }
      });
    }

    var __focusPanelHydrateInflight = null;

    function hydrateFocusLeadFromPanelData(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return;
      if (__focusPanelHydrateInflight === key) return;
      __focusPanelHydrateInflight = key;
      fetch('/leads/' + encodeURIComponent(key) + '/panel-data', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data || !data.success || !data.lead) return;
          Object.assign(lead, data.lead);
          var cur = currentLead();
          if (cur && focusLeadKeyParam(cur) === key) {
            renderBuiltWith(cur);
            renderBusinessInfo(cur);
            renderFocusContactFields(cur);
            renderLinks(cur);
          }
        })
        .catch(function (err) {
          console.warn('[Focus] panel-data hydrate failed:', err);
        })
        .finally(function () {
          if (__focusPanelHydrateInflight === key) __focusPanelHydrateInflight = null;
          var cur = currentLead();
          if (cur && focusLeadKeyParam(cur) === key) renderBuiltWith(cur);
        });
    }

    function renderBusinessInfo(lead) {
      var websiteHref = hrefUrl(lead.website || '');
      if (websiteHref) {
        elBizWebsite.href = websiteHref;
        elBizWebsite.textContent = cleanUrlLabel(websiteHref);
        elBizWebsite.classList.remove('pointer-events-none', 'text-brand-muted');
      } else {
        elBizWebsite.href = '#';
        elBizWebsite.textContent = '—';
        elBizWebsite.classList.add('pointer-events-none', 'text-brand-muted');
      }

      var parts = [];
      if (lead.address) parts.push(lead.address);
      var cityState = [lead.city || '', lead.state || ''].filter(Boolean).join(', ');
      if (cityState) parts.push(cityState);
      elBizLocation.textContent = parts.length ? parts.join(' · ') : '—';

      elBizCategory.textContent = lead.categoryName || '—';

      var score = Number(lead.totalScore || 0);
      var reviews = parseInt(lead.reviewsCount, 10) || 0;
      if (score > 0) {
        elBizReviews.textContent = score.toFixed(1) + ' stars · ' + reviews + ' review' + (reviews === 1 ? '' : 's');
      } else if (reviews > 0) {
        elBizReviews.textContent = reviews + ' review' + (reviews === 1 ? '' : 's');
      } else {
        elBizReviews.textContent = '—';
      }
      applyReviewTone(score, reviews);
      renderReviewStars(score);
      syncFocusOwnerSignalUi(lead);

      renderFocusMap(lead);
      renderWhyReasons(lead);
      renderBuiltWith(lead);

      var rapidBtn = document.getElementById('focus-rapidapi-enrich-btn');
      if (rapidBtn) {
        rapidBtn.dataset.leadKey = focusLeadKeyParam(lead);
        rapidBtn.disabled = !hrefUrl(lead.website || '');
      }
    }

    function renderTouchPoints(lead) {
      var tp = lead && lead.touchPoints ? lead.touchPoints : null;
      var last = tp && tp.lastTouch ? tp.lastTouch : null;
      if (elLast) {
        elLast.textContent = (last && last.summary) ? last.summary : (lead.lastTouchLabel || '—');
      }
      if (elLastDetail) {
        var detail = last && last.text ? String(last.text).trim() : '';
        if (detail) {
          elLastDetail.textContent = detail;
          elLastDetail.classList.remove('hidden');
        } else {
          elLastDetail.textContent = '';
          elLastDetail.classList.add('hidden');
        }
      }
      if (elEngagementBadge) {
        var badge = tp && tp.engagementBadge ? tp.engagementBadge : null;
        if (badge && badge.label) {
          elEngagementBadge.textContent = badge.label;
          elEngagementBadge.classList.remove('hidden');
        } else {
          elEngagementBadge.textContent = '';
          elEngagementBadge.classList.add('hidden');
        }
      }
      if (elTouchSummary) {
        var total = tp && typeof tp.totalCount === 'number' ? tp.totalCount : 0;
        elTouchSummary.textContent = total
          ? (total + ' logged touch' + (total === 1 ? '' : 'es') + ' — most recent below')
          : 'No touches logged yet — log calls and outreach to build history.';
      }
      if (!elTouchPointsList) return;
      var items = tp && Array.isArray(tp.recentTouches) ? tp.recentTouches : [];
      if (!items.length) {
        elTouchPointsList.innerHTML = '<li class="text-brand-muted italic">No touch history yet.</li>';
        return;
      }
      elTouchPointsList.innerHTML = items.map(function (item) {
        var warm = item.isEngagement ? ' border-emerald-500/30 bg-emerald-500/5' : ' border-brand-border/40 dark:border-white/10';
        var label = String(item.typeLabel || 'Touch').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        var when = String(item.atLabel || '—').replace(/</g, '&lt;');
        var body = String(item.text || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return '<li class="rounded-lg border px-2.5 py-2' + warm + '">' +
          '<p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">' + when + ' · ' + label + '</p>' +
          (body ? '<p class="text-[11px] font-semibold text-brand-dark dark:text-slate-200 mt-0.5 leading-snug">' + body + '</p>' : '') +
          '</li>';
      }).join('');
    }

    function renderReviewStars(score) {
      if (!elBizReviewStars) return;
      var val = Number(score || 0);
      if (!(val > 0)) {
        elBizReviewStars.innerHTML = '';
        var noData = document.createElement('span');
        noData.className = 'text-[10px] text-brand-muted';
        noData.textContent = 'No rating data';
        elBizReviewStars.appendChild(noData);
        return;
      }
      if (typeof window.__renderStarsInElement === 'function') {
        window.__renderStarsInElement(elBizReviewStars, val, 'w-3.5 h-3.5');
      }
    }

    function applyReviewTone(score, reviews) {
      if (!elBizReviews && !elBizReviewStars) return;
      var s = Number(score || 0);
      var r = parseInt(reviews, 10) || 0;
      var tone = 'muted';
      if (s > 0) {
        if (s >= 4.4 && r >= 20) tone = 'good';
        else if (s <= 3.4 || (r >= 20 && s < 3.9)) tone = 'risk';
        else tone = 'mid';
      }
      var textClass = tone === 'good'
        ? 'text-emerald-700 dark:text-emerald-300'
        : tone === 'risk'
          ? 'text-rose-700 dark:text-rose-300'
          : tone === 'mid'
            ? 'text-amber-700 dark:text-amber-300'
            : 'text-brand-dark dark:text-slate-100';
      var starClass = tone === 'good'
        ? 'text-emerald-500'
        : tone === 'risk'
          ? 'text-rose-500'
          : tone === 'mid'
            ? 'text-amber-500'
            : 'text-brand-muted';
      if (elBizReviews) {
        elBizReviews.classList.remove(
          'text-brand-dark', 'dark:text-slate-100',
          'text-emerald-700', 'dark:text-emerald-300',
          'text-rose-700', 'dark:text-rose-300',
          'text-amber-700', 'dark:text-amber-300'
        );
        textClass.split(' ').forEach(function (c) { if (c) elBizReviews.classList.add(c); });
      }
      if (elBizReviewStars) {
        elBizReviewStars.classList.remove(
          'text-amber-500', 'text-emerald-500', 'text-rose-500', 'text-brand-muted'
        );
        starClass.split(' ').forEach(function (c) { if (c) elBizReviewStars.classList.add(c); });
      }
    }

    var WHY_CTA_MAP = {
      'No usable website': { label: 'Build a site', cls: 'border-rose-500/50 bg-rose-500/10 text-rose-800 dark:text-rose-200' },
      'website': { label: 'Website redesign', cls: 'border-rose-500/50 bg-rose-500/10 text-rose-800 dark:text-rose-200' },
      'outdated': { label: 'Redesign pitch', cls: 'border-amber-500/50 bg-amber-500/10 text-amber-800 dark:text-amber-200' },
      'mobile': { label: 'Fix mobile UX', cls: 'border-orange-500/50 bg-orange-500/10 text-orange-800 dark:text-orange-200' },
      'schema': { label: 'Local SEO', cls: 'border-blue-500/50 bg-blue-500/10 text-blue-800 dark:text-blue-200' },
      'chatbot': { label: 'AI chat / voice', cls: 'border-purple-500/50 bg-purple-500/10 text-purple-800 dark:text-purple-200' },
      'reviews': { label: 'Reputation mgmt', cls: 'border-emerald-500/50 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200' },
      'rating': { label: 'Review boost', cls: 'border-emerald-500/50 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200' },
      'social': { label: 'Social presence', cls: 'border-indigo-500/50 bg-indigo-500/10 text-indigo-800 dark:text-indigo-200' },
      'click-to-call': { label: 'Click-to-call', cls: 'border-sky-500/50 bg-sky-500/10 text-sky-800 dark:text-sky-200' },
      'AEO': { label: 'AEO / voice SEO', cls: 'border-cyan-500/50 bg-cyan-500/10 text-cyan-800 dark:text-cyan-200' },
      'automation': { label: 'AI automation', cls: 'border-purple-500/50 bg-purple-500/10 text-purple-800 dark:text-purple-200' },
      'booking': { label: 'Owned funnel', cls: 'border-violet-500/50 bg-violet-500/10 text-violet-800 dark:text-violet-200' },
      'marketplace': { label: 'Owned funnel', cls: 'border-violet-500/50 bg-violet-500/10 text-violet-800 dark:text-violet-200' },
    };

    function pickWhyCta(reason) {
      var r = String(reason || '').toLowerCase();
      for (var key in WHY_CTA_MAP) {
        if (r.indexOf(key.toLowerCase()) !== -1) return WHY_CTA_MAP[key];
      }
      return { label: 'Opportunity', cls: 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow' };
    }

    function renderWhyReasons(lead) {
      if (!elWhySection || !elWhyReasons) return;
      if (!isAgencySalesWorkspace) {
        elWhySection.classList.add('hidden');
        elWhyReasons.innerHTML = '';
        return;
      }
      var reasons = lead.whyReasons;
      if (!reasons || !Array.isArray(reasons) || !reasons.length) {
        elWhySection.classList.add('hidden');
        return;
      }
      elWhySection.classList.remove('hidden');
      elWhyReasons.innerHTML = '';

      var groups = [];
      var indexByLabel = Object.create(null);
      reasons.forEach(function (r) {
        var text = String(r || '').trim();
        if (!text) return;
        var cta = pickWhyCta(text);
        var label = cta.label;
        var idx = indexByLabel[label];
        if (idx == null) {
          idx = groups.length;
          indexByLabel[label] = idx;
          groups.push({ cta: cta, notes: [text] });
        } else if (groups[idx].notes.indexOf(text) === -1) {
          groups[idx].notes.push(text);
        }
      });

      groups.forEach(function (group) {
        var pill = document.createElement('span');
        pill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border ' + group.cta.cls;
        pill.textContent = group.cta.label;
        var reason = document.createElement('span');
        reason.className = 'text-[11px] font-semibold text-brand-dark dark:text-slate-200 ml-1';
        reason.textContent = group.notes.join(' · ');
        var row = document.createElement('div');
        row.className = 'flex flex-wrap items-center gap-2';
        row.appendChild(pill);
        row.appendChild(reason);
        elWhyReasons.appendChild(row);
      });
    }

    function renderReviewSummaryText(strengths, weaknesses, sourceNote) {
      var bits = [];
      if (Array.isArray(strengths) && strengths.length) {
        bits.push('Strength: ' + String(strengths[0]));
      }
      if (Array.isArray(weaknesses) && weaknesses.length) {
        bits.push('Risk: ' + String(weaknesses[0]));
      }
      if (sourceNote) bits.push(String(sourceNote));
      return bits.join(' ');
    }

    function fetchReviewSummary() {
      var lead = currentLead();
      if (!isAgencySalesWorkspace) return Promise.resolve();
      if (!elReviewSummary) return Promise.resolve();
      if (!lead || !lead.key) {
        elReviewSummary.textContent = 'No lead selected.';
        return Promise.resolve();
      }
      var requestId = String(lead.key) + '|' + Date.now();
      window.__focusReviewReq = requestId;
      elReviewSummary.textContent = 'Loading review summary…';
      return fetch('/leads/' + encodeURIComponent(lead.key) + '/review-intelligence', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({}),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (window.__focusReviewReq !== requestId) return;
          if (!data || !data.success) {
            elReviewSummary.textContent = 'No AI summary available yet.';
            return;
          }
          var msg = renderReviewSummaryText(data.strengths, data.weaknesses, data.sourceNote);
          elReviewSummary.textContent = msg || 'No AI summary available yet.';
        })
        .catch(function () {
          if (window.__focusReviewReq === requestId) {
            elReviewSummary.textContent = 'No AI summary available right now.';
          }
        });
    }

    function setCopyFeedback(msg, isError) {
      if (!elCopyFeedback) return;
      elCopyFeedback.textContent = msg || '';
      elCopyFeedback.classList.toggle('text-red-500', Boolean(isError));
      elCopyFeedback.classList.toggle('text-brand-muted', !isError);
      if (window.__focusCopyTimer) clearTimeout(window.__focusCopyTimer);
      if (msg) {
        window.__focusCopyTimer = setTimeout(function () {
          elCopyFeedback.textContent = '';
          elCopyFeedback.classList.remove('text-red-500');
          elCopyFeedback.classList.add('text-brand-muted');
        }, 1800);
      }
    }

    var elDeliverablesFeedback = document.getElementById('focus-deliverables-feedback');
    var focusAiToolsReady = {};

    function setDeliverablesFeedback(msg, isError) {
      if (!elDeliverablesFeedback) return;
      elDeliverablesFeedback.textContent = msg || '';
      elDeliverablesFeedback.classList.toggle('text-red-500', Boolean(isError));
      elDeliverablesFeedback.classList.toggle('text-brand-muted', !isError);
      if (window.__focusDeliverablesTimer) clearTimeout(window.__focusDeliverablesTimer);
      if (!msg) return;
      window.__focusDeliverablesTimer = setTimeout(function () {
        if (elDeliverablesFeedback) {
          elDeliverablesFeedback.textContent = '';
          elDeliverablesFeedback.classList.remove('text-red-500');
          elDeliverablesFeedback.classList.add('text-brand-muted');
        }
      }, 2600);
    }

    function focusLeadKeyParam(lead) {
      return lead && lead.key ? String(lead.key).trim() : '';
    }

    function focusHasAiTools(lead) {
      var k = focusLeadKeyParam(lead);
      if (!k) return false;
      if (focusAiToolsReady[k]) return true;
      return !!(lead && lead.hasAiToolsAssessment);
    }

    function focusPostJson(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body || {}),
      }).then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || !j.success) throw new Error((j && j.error) || 'Request failed');
          return j;
        });
      });
    }

    function focusEnsureAiToolsAssessment(lead) {
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      if (focusHasAiTools(lead)) return Promise.resolve({ assessment: true });
      setDeliverablesFeedback('Generating AI tools deck…');
      return focusPostJson('/leads/' + encodeURIComponent(key) + '/ai-tools-assessment/generate', {})
        .then(function (data) {
          focusAiToolsReady[key] = true;
          if (lead) lead.hasAiToolsAssessment = true;
          setDeliverablesFeedback('AI tools deck ready.');
          return data;
        });
    }

    function focusHasAiWebsiteAnalysis(lead) {
      return !!(lead && lead.hasAiWebsiteAnalysis);
    }

    function setOwnerSignalFeedback(msg, isError) {
      if (!elOwnerSignalFeedback) return;
      elOwnerSignalFeedback.textContent = msg || '';
      elOwnerSignalFeedback.classList.toggle('text-rose-600', !!isError);
      elOwnerSignalFeedback.classList.toggle('text-emerald-700', !!msg && !isError);
      elOwnerSignalFeedback.classList.toggle('text-brand-muted', !msg);
    }

    function syncFocusOwnerSignalUi(lead) {
      if (!isAgencySalesWorkspace) return;
      if (!elOwnerSignal) return;
      var ownerSignal = String((lead && lead.ownerSignal) || '').trim();
      var website = lead && lead.website ? String(lead.website).trim() : '';
      var hasWebsite = !!website && website !== 'N/A' && website !== '—';
      elOwnerSignal.textContent = ownerSignal || 'Run AI analysis to generate a concrete signal for your call.';
      if (btnOwnerSignalAi) {
        btnOwnerSignalAi.classList.toggle('hidden', !!ownerSignal);
        btnOwnerSignalAi.disabled = !hasWebsite;
        btnOwnerSignalAi.title = hasWebsite
          ? 'Analyze this lead\'s website and generate an owner signal'
          : 'Add a website URL for this lead first';
      }
      if (ownerSignal) setOwnerSignalFeedback('');
    }

    function runFocusOwnerSignalAnalysis(lead) {
      if (!isAgencySalesWorkspace) {
        return Promise.reject(new Error('Website analysis is only available in agency workspaces.'));
      }
      var key = focusLeadKeyParam(lead);
      if (!key) return Promise.reject(new Error('Lead key missing'));
      var website = lead && lead.website ? String(lead.website).trim() : '';
      if (!website || website === 'N/A' || website === '—') {
        return Promise.reject(new Error('Add a website URL for this lead first.'));
      }
      if (btnOwnerSignalAi) {
        btnOwnerSignalAi.disabled = true;
        btnOwnerSignalAi.setAttribute('aria-busy', 'true');
      }
      setOwnerSignalFeedback('Running AI analysis…', false);
      return focusPostJson('/leads/' + encodeURIComponent(key) + '/ai-analysis', {})
        .then(function (data) {
          if (lead) {
            lead.hasAiWebsiteAnalysis = true;
            if (data && data.ownerSignal) lead.ownerSignal = String(data.ownerSignal).trim();
          }
          syncFocusOwnerSignalUi(lead || {});
          setOwnerSignalFeedback('Owner signal ready.', false);
          return data;
        })
        .catch(function (err) {
          setOwnerSignalFeedback((err && err.message) || 'AI analysis failed.', true);
          throw err;
        })
        .finally(function () {
          if (btnOwnerSignalAi) {
            btnOwnerSignalAi.removeAttribute('aria-busy');
            syncFocusOwnerSignalUi(lead || currentLead());
          }
        });
    }

    function focusEnsureAiWebsiteAnalysis(lead) {
