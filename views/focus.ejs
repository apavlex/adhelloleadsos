    function focusSmsComposeHeightLimits() {
      var expanded = !!(elSmsComposeInput && elSmsComposeInput.classList.contains('focus-sms-compose-input--expanded'));
      var min = expanded ? Math.min(window.innerHeight * 0.32, 240) : 88;
      var max = expanded ? Math.min(window.innerHeight * 0.62, 420) : Math.min(window.innerHeight * 0.5, 320);
      return { min: Math.round(min), max: Math.round(max) };
    }

    function autogrowFocusSmsCompose() {
      if (!elSmsComposeInput) return;
      var limits = focusSmsComposeHeightLimits();
      elSmsComposeInput.style.height = 'auto';
      var next = Math.max(limits.min, Math.min(limits.max, elSmsComposeInput.scrollHeight));
      elSmsComposeInput.style.height = next + 'px';
    }

    function setFocusSmsComposeExpanded(expanded) {
      if (!elSmsComposeInput) return;
      elSmsComposeInput.classList.toggle('focus-sms-compose-input--expanded', !!expanded);
      if (btnSmsExpandToggle) {
        btnSmsExpandToggle.textContent = expanded ? 'Compact' : 'Expand';
        btnSmsExpandToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        btnSmsExpandToggle.title = expanded ? 'Use a shorter compose area' : 'Toggle a taller compose area';
      }
      autogrowFocusSmsCompose();
    }

    function syncFocusSmsButtonState() {
      var open = isFocusSmsComposeOpen();
      [btnSms, btnMobileSms].forEach(function (b) {
        if (!b) return;
        b.setAttribute('aria-pressed', open ? 'true' : 'false');
