<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <% const _focusIsSelectionSession = typeof focusIsSelectionSession !== 'undefined' && focusIsSelectionSession; %>
  <% const _focusSelectionCount = typeof focusSelectionCount === 'number' && focusSelectionCount > 0 ? focusSelectionCount : null; %>
  <% const _focusDailyGoal = typeof touchGoal !== 'undefined' ? touchGoal : 54; %>
  <% const _focusTitleCount = _focusIsSelectionSession && _focusSelectionCount ? _focusSelectionCount : _focusDailyGoal; %>
  <% const _focusProgressCurrent = _focusIsSelectionSession ? 1 : (typeof touchesToday !== 'undefined' ? touchesToday : 0); %>
  <% const _focusProgressGoal = _focusIsSelectionSession && _focusSelectionCount ? _focusSelectionCount : _focusDailyGoal; %>
  <% const _focusProgressPct = _focusProgressGoal > 0 ? Math.min(100, Math.round((_focusProgressCurrent / _focusProgressGoal) * 100)) : 0; %>
  <main class="max-wide px-6 py-8 pb-28 md:pb-10 md:py-10">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Focus mode</p>
          <h1 id="focus-session-title" class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Start my <%= _focusTitleCount %></h1>
          <p class="text-sm text-brand-muted dark:text-slate-400 mt-2">One lead at a time — draft, log, next. <button type="button" id="focus-help-btn" class="font-bold text-brand-dark dark:text-white underline decoration-brand-yellow/60 hover:decoration-brand-yellow">Shortcuts (?)</button></p>
        </div>
        <a href="/today" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white">← Today</a>
      </div>
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-4 py-3">
        <div class="flex justify-between items-baseline text-sm mb-2">
          <span id="focus-progress-label" class="text-brand-muted dark:text-slate-400">Touches today</span>
          <span class="font-display font-black text-brand-dark dark:text-white"><span id="focus-touch-count"><%= _focusProgressCurrent %></span> <span class="text-brand-muted font-bold text-sm">/ <span id="focus-touch-goal"><%= _focusProgressGoal %></span></span></span>
        </div>
        <div class="h-2 rounded-full bg-brand-cream/80 dark:bg-slate-800 overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="<%= _focusProgressGoal %>" aria-valuenow="<%= _focusProgressCurrent %>" id="focus-progress-bar-wrap">
          <div id="focus-progress-fill" class="h-full bg-brand-yellow rounded-full transition-[width] duration-300" style="width: <%= _focusProgressPct %>%"></div>
        </div>
      </div>
    </header>

    <div id="focus-empty" class="hidden rounded-[2rem] border-2 border-dashed border-brand-border dark:border-white/15 bg-white/60 dark:bg-slate-900/50 px-8 py-14 text-center">
      <h2 id="focus-empty-title" class="font-display font-extrabold text-xl text-brand-dark dark:text-white mb-2">No leads in this queue</h2>
      <p id="focus-empty-desc" class="text-sm text-brand-muted mb-6 max-w-md mx-auto">Add or import business leads to your pipeline, then come back. Listings and products are excluded from Focus.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <button type="button" id="focus-empty-back" class="hidden btn-pill border-2 border-brand-border dark:border-white/20 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white disabled:opacity-40 disabled:pointer-events-none" disabled>← Go back</button>
        <button type="button" id="focus-empty-reload" class="hidden btn-pill border-2 border-brand-dark dark:border-white/25 bg-white dark:bg-slate-900 px-8 py-3 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Reload queue</button>
        <a href="/prospecting?tab=pipeline" class="btn-pill btn-primary inline-flex px-8 py-3 text-xs font-black uppercase tracking-widest">Open pipeline</a>
      </div>
    </div>

    <section id="focus-card-section" class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/85 dark:bg-slate-900/75 shadow-sm p-6 md:p-8 max-w-3xl lg:max-w-4xl mx-auto" aria-label="Current lead">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h2 id="focus-company" class="font-display font-black text-2xl text-brand-dark dark:text-white truncate">—</h2>
          <p id="focus-contact" class="text-sm font-semibold text-brand-muted dark:text-slate-400 mt-1">—</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="focus-btn-back" disabled class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-800/60 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/50 transition-colors disabled:opacity-40 disabled:pointer-events-none shrink-0" title="Previous lead in this session" aria-label="Go back to previous lead">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            <span class="hidden sm:inline">Back</span>
          </button>
          <button type="button" id="focus-btn-delete" class="w-8 h-8 rounded-lg border border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-800/60 text-brand-muted hover:text-red-600 dark:hover:text-red-400 hover:border-red-500/40 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors flex items-center justify-center shrink-0" title="Delete lead" aria-label="Delete lead">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
          <span id="focus-stage-badge" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider bg-brand-cream/60 dark:bg-white/10 border border-brand-border/50 dark:border-white/10 text-brand-dark dark:text-slate-200">—</span>
        </div>
      </div>
      <p class="text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-4">Last touch <span id="focus-last-touch" class="text-brand-dark dark:text-white normal-case">—</span></p>

      <div id="focusLeadTagsSection" class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-800/40 px-4 py-3">
        <div class="flex items-center justify-between gap-2 mb-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Tags</p>
          <a href="/tags/manage" class="text-[9px] font-bold uppercase tracking-wide text-brand-yellow hover:underline shrink-0">Manage all tags →</a>
        </div>
        <div id="focusLeadTagsHost" class="rounded-xl border border-brand-border/20 dark:border-white/10 bg-white/60 dark:bg-slate-900/40 p-3">
          <p class="text-[11px] text-brand-muted dark:text-slate-400 italic">Loading tags…</p>
        </div>
      </div>

      <div id="focus-links" class="flex flex-wrap gap-2 mb-6" aria-label="Contact and social links"></div>
      <div class="mb-6 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/35 dark:bg-slate-800/60 px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Business info</p>
        <div class="flex flex-col md:flex-row gap-4 items-stretch">
          <div id="focus-map-wrap" class="hidden w-full md:w-[min(100%,280px)] shrink-0 rounded-xl border border-brand-border/50 dark:border-white/10 overflow-hidden bg-slate-200/80 dark:bg-slate-950/80 aspect-[4/3] md:aspect-auto md:h-52 min-h-[11rem] relative shadow-inner" aria-hidden="true">
            <img id="focus-map-img" class="absolute inset-0 w-full h-full object-cover hidden" alt="" loading="lazy" width="560" height="336" decoding="async" />
          </div>
          <div class="flex-1 min-w-0 w-full">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Website</p>
            <a id="focus-biz-website" href="#" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-dark dark:text-slate-100 hover:text-brand-yellow transition-colors truncate block">—</a>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Location</p>
            <p id="focus-biz-location" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Category</p>
            <p id="focus-biz-category" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">Reviews</p>
            <p id="focus-biz-reviews" class="font-semibold text-brand-dark dark:text-slate-100 truncate">—</p>
            <div id="focus-biz-review-stars" class="mt-1 flex items-center gap-1 text-amber-500" aria-label="Review stars"></div>
          </div>
            </div>
            <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
              <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-2">Quick copy</p>
              <div class="flex flex-wrap gap-2">
                <button type="button" id="focus-copy-phone" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Phone</button>
                <button type="button" id="focus-copy-email" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Email</button>
                <button type="button" id="focus-copy-website" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Website</button>
              </div>
              <p id="focus-copy-feedback" class="text-[11px] text-brand-muted mt-2 min-h-[1rem]"></p>
            </div>
          </div>
        </div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-1">AI review summary</p>
          <p id="focus-review-summary" class="text-[11px] text-brand-muted leading-snug">Loading review summary…</p>
        </div>
        <div id="focus-owner-signal-callout" class="mt-3 rounded-xl border border-sky-300/40 dark:border-sky-700/40 bg-sky-50/60 dark:bg-sky-900/20 p-3">
          <p class="text-[9px] font-black uppercase tracking-wider text-sky-700 dark:text-sky-300 mb-1">Owner signal</p>
          <p id="focus-owner-signal" class="text-[12px] font-semibold text-brand-dark dark:text-slate-100 leading-snug">Run AI analysis to generate a concrete signal for your call.</p>
          <button
            type="button"
            id="focus-owner-signal-ai-btn"
            class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider border border-sky-400/50 bg-sky-500/15 text-sky-800 dark:text-sky-200 hover:bg-sky-500/25 transition-colors disabled:opacity-40 disabled:pointer-events-none"
            title="Analyze this lead's website and generate an owner signal"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Run AI analysis
          </button>
          <p id="focus-owner-signal-feedback" class="text-[11px] text-brand-muted mt-1.5 min-h-[1rem]"></p>
        </div>
        <div class="mt-3 pt-3 border-t border-brand-border/50 dark:border-white/10">
          <p class="text-[9px] font-black uppercase tracking-wider text-brand-muted mb-2">Client deliverables</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="focus-hosted-audit-open" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Hosted audit</button>
            <button type="button" id="focus-hosted-audit-copy" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Copy audit link</button>
            <button type="button" id="focus-ai-tools-generate" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Generate AI deck</button>
            <button type="button" id="focus-ai-tools-preview" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Preview &amp; edit</button>
            <button type="button" id="focus-ai-tools-copy" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Copy deck link</button>
            <button type="button" id="focus-ai-tools-open" class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-brand-border/60 dark:border-white/15 text-brand-dark dark:text-slate-200 hover:border-brand-yellow/60 transition-colors">Open presentation</button>
          </div>
          <p id="focus-deliverables-feedback" class="text-[11px] text-brand-muted mt-2 min-h-[1rem]"></p>
        </div>
      </div>

      <div
        id="focus-why-section"
        class="hidden mb-4 rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/50 dark:bg-slate-800/40 px-4 py-3"
        role="group"
        aria-label="Why this lead"
      >
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Why this lead</p>
        <div id="focus-why-reasons" class="space-y-1.5"></div>
      </div>

      <div class="mb-4 rounded-2xl border-2 border-brand-yellow/35 dark:border-brand-yellow/35 bg-brand-yellow/10 dark:bg-brand-yellow/10 px-4 py-3 shadow-sm">
        <div class="flex items-center gap-2 mb-1">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Outreach</p>
          <%- include('/partials/app_info_tip', {
            tipId: 'focus-outreach-help',
            tipKey: 'focus-outreach',
            label: 'Call and Sync GHL in Focus mode',
            size: 'sm',
            content: 'Use <strong>Call</strong> for live dials in AdHello. <strong>AI SMS</strong> personalizes and sends text or iMessage via Comms or GHL. <strong>Sync GHL</strong> saves your disposition and notes, then pushes the contact to Go High Level for email and voicemail.'
          }) %>
        </div>
        <p id="focus-channel-hint" class="text-[11px] text-brand-muted dark:text-slate-400 mt-2 min-h-[1.25rem] leading-snug" aria-live="polite">Rehearse the call script below, then Call, AI SMS, or Sync GHL.</p>
      </div>

      <div class="mb-4 rounded-2xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/35 dark:bg-slate-800/35 px-4 py-3">
        <% const _focusProductOptions = (typeof focusProductOptions !== 'undefined' && Array.isArray(focusProductOptions) && focusProductOptions.length) ? focusProductOptions : [
          { key: 'reputation', label: 'Reputation management' },
          { key: 'ai_automation', label: 'AI automation' },
          { key: 'ai_websites', label: 'AI websites' },
          { key: 'social_media', label: 'Social media' },
          { key: 'ad_management', label: 'Ad management' },
          { key: 'web_design', label: 'Web design' },
        ]; %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <label class="block min-w-0" for="focus-service-select">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Product</span>
          <select
            id="focus-service-select"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <% _focusProductOptions.forEach(function (p) { %>
              <option value="<%= p.key %>"><%= p.label %></option>
            <% }); %>
          </select>
        </label>
        <label class="block flex-1 min-w-0" for="focus-script-variant">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Script style</span>
          <select
            id="focus-script-variant"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <option value="default">First touch / default</option>
            <option value="followup">Follow-up</option>
            <option value="reengage">Re-engagement</option>
            <option value="short">Short &amp; punchy</option>
          </select>
        </label>
        <label class="block flex-1 min-w-0" for="focus-tone">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Tone</span>
          <select
            id="focus-tone"
            class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white"
          >
            <option value="coffee-chat">Coffee-chat</option>
            <option value="pro">Pro</option>
          </select>
        </label>
        </div>
      </div>

      <div id="focus-subject-wrap" class="mb-3 hidden">
        <label for="focus-subject" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-2">Subject</label>
        <input id="focus-subject" type="text" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm text-brand-dark dark:text-white" autocomplete="off" />
      </div>
      <div class="mb-6">
        <div class="flex items-center justify-between gap-3 mb-2">
          <label for="focus-body" id="focus-body-label" class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Outreach draft</label>
          <div class="flex items-center gap-2 shrink-0">
            <span id="focus-script-save-status" class="text-[10px] text-brand-muted dark:text-slate-400 tabular-nums" aria-live="polite"></span>
            <button
              type="button"
              id="focus-save-script"
              class="btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 disabled:opacity-40 disabled:pointer-events-none"
              title="Save script to workspace library for this product"
            >
              Save script
            </button>
          </div>
        </div>
        <textarea id="focus-body" rows="10" class="w-full rounded-2xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-brand-dark dark:text-white font-medium leading-relaxed resize-y min-h-[200px]" placeholder="Choose a product above — the call script loads here instantly."></textarea>
      </div>
      <div id="focus-outcome-panel" class="mb-6 md:mb-4 md:sticky md:bottom-4 z-30 rounded-[1.35rem] border border-brand-border/60 dark:border-white/15 bg-brand-cream/25 dark:bg-slate-900/70 md:bg-white/70 md:dark:bg-slate-900/65 md:backdrop-blur-xl shadow-sm md:shadow-xl p-4 space-y-3">
        <div id="focus-outcome-header" class="flex items-center justify-between gap-2">
          <p id="focus-outcome-heading" class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Call outcome + notes</p>
          <button
            type="button"
            id="focus-outcome-collapse-toggle"
            class="inline-flex items-center justify-center w-7 h-7 rounded-lg border border-brand-border/60 dark:border-white/15 text-brand-muted hover:border-brand-yellow/50 hover:text-brand-dark dark:hover:text-white transition-colors shrink-0"
            aria-expanded="true"
            aria-controls="focus-outcome-details"
            title="Collapse notes"
          >
            <svg id="focus-outcome-collapse-icon" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M18 15l-6-6-6 6"/></svg>
            <span class="sr-only">Toggle call outcome notes</span>
          </button>
        </div>
        <div id="focus-outcome-details" class="space-y-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Quick log</p>
          <div class="flex flex-wrap gap-2" id="focus-quick-log-row">
            <%- include('/partials/quick_log_pills', {
              quickLogBtnClass: 'focus-quick-outcome btn-pill border border-brand-border dark:border-white/15 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 data-[active=true]:border-brand-yellow data-[active=true]:bg-brand-yellow/15',
            }) %>
          </div>
          <p id="focus-selected-outcome-label" class="mt-2 text-[11px] text-brand-muted">Selected: none</p>
        </div>
        <input type="hidden" id="focus-outcome" value="" />
        <div>
          <label for="focus-outcome-notes" class="text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-1.5">Notes</label>
          <textarea id="focus-outcome-notes" rows="3" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-brand-dark dark:text-white" placeholder="Owner response, objection, timing, next step…"></textarea>
        </div>
        <div id="focus-followup-strip" class="hidden rounded-xl border border-brand-border/70 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/40 p-3 space-y-3">
          <label class="inline-flex items-center gap-2 text-xs font-semibold text-brand-dark dark:text-white">
            <input type="checkbox" id="focus-followup-enable" class="rounded border-brand-border" checked />
            Schedule next follow-up
          </label>
          <div id="focus-followup-presets" class="flex flex-wrap gap-2">
