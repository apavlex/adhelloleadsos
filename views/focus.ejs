  <script>
  (function () {
    var FOCUS_PRODUCT_STORAGE_KEY = 'focusProductKey';
    var focusScriptLibrary = {};
    try {
      focusScriptLibrary = JSON.parse(document.getElementById('focus-script-library-json').textContent || '{}');
    } catch (e) {
      focusScriptLibrary = {};
    }

    var queue = [];
    try {
      queue = JSON.parse(document.getElementById('focus-queue-json').textContent || '[]');
    } catch (e) {
      queue = [];
    }

    var idx = 0;
    var focusLeadHistory = [];
    var currentChannel = 'call-script';
    var isSelectionSession = <%= _focusIsSelectionSession ? 'true' : 'false' %>;
    var touchGoal = parseInt(document.getElementById('focus-touch-goal').textContent, 10) || 54;
    var celebrateDismissed = false;

    var elEmpty = document.getElementById('focus-empty');
    var elEmptyTitle = document.getElementById('focus-empty-title');
    var elEmptyDesc = document.getElementById('focus-empty-desc');
    var elEmptyReload = document.getElementById('focus-empty-reload');
    var elSection = document.getElementById('focus-card-section');
    var elCompany = document.getElementById('focus-company');
    var elContact = document.getElementById('focus-contact');
    var elStage = document.getElementById('focus-stage-badge');
    var elLast = document.getElementById('focus-last-touch');
    var elLinks = document.getElementById('focus-links');
    var elBizWebsite = document.getElementById('focus-biz-website');
    var elBizLocation = document.getElementById('focus-biz-location');
    var elBizCategory = document.getElementById('focus-biz-category');
    var elBizReviews = document.getElementById('focus-biz-reviews');
    var elBizReviewStars = document.getElementById('focus-biz-review-stars');
    var elReviewSummary = document.getElementById('focus-review-summary');
    var elOwnerSignal = document.getElementById('focus-owner-signal');
    var btnOwnerSignalAi = document.getElementById('focus-owner-signal-ai-btn');
    var elOwnerSignalFeedback = document.getElementById('focus-owner-signal-feedback');
    var btnCopyPhone = document.getElementById('focus-copy-phone');
    var btnCopyEmail = document.getElementById('focus-copy-email');
    var btnCopyWebsite = document.getElementById('focus-copy-website');
    var elCopyFeedback = document.getElementById('focus-copy-feedback');
    var elOutcome = document.getElementById('focus-outcome');
    var elSelectedOutcomeLabel = document.getElementById('focus-selected-outcome-label');
    var elQuickOutcomeBtns = document.querySelectorAll('.focus-quick-outcome');
    var elOutcomeNotes = document.getElementById('focus-outcome-notes');
    var elFollowupStrip = document.getElementById('focus-followup-strip');
    var elFollowupEnable = document.getElementById('focus-followup-enable');
    var elFollowupWrap = document.getElementById('focus-followup-wrap');
    var elFollowupAt = document.getElementById('focus-followup-at');
    var elFollowupPresets = document.querySelectorAll('.focus-followup-preset');
    var focusFollowupPicker = null;
    var elOutcomeFeedback = document.getElementById('focus-outcome-feedback');
    var elSubjectWrap = document.getElementById('focus-subject-wrap');
    var elSubject = document.getElementById('focus-subject');
    var elBody = document.getElementById('focus-body');
    var channelBtns = document.querySelectorAll('.focus-channel-btn');
    var btnCall = document.getElementById('focus-btn-call');
    var btnAiSms = document.getElementById('focus-btn-ai-sms');
    var btnPushGhl = document.getElementById('focus-btn-push-ghl');
    var btnLog = document.getElementById('focus-btn-log');
    var btnSkip = document.getElementById('focus-btn-skip');
    var btnBack = document.getElementById('focus-btn-back');
    var btnBackSecondary = document.getElementById('focus-btn-back-secondary');
    var btnEmptyBack = document.getElementById('focus-empty-back');
    var btnCallNext = document.getElementById('focus-btn-call-next');
    var btnDelete = document.getElementById('focus-btn-delete');
    var autoDialNext = false;
    var modalHelp = document.getElementById('focus-modal-help');
    var modalCelebrate = document.getElementById('focus-modal-celebrate');
    var fill = document.getElementById('focus-progress-fill');
    var countEl = document.getElementById('focus-touch-count');
    var barWrap = document.getElementById('focus-progress-bar-wrap');
    var elServiceSelect = document.getElementById('focus-service-select');
    var elChannelHint = document.getElementById('focus-channel-hint');
    var elScriptVariant = document.getElementById('focus-script-variant');
    var elTone = document.getElementById('focus-tone');
    var btnOpenDialer = document.getElementById('focus-btn-open-dialer');
    var elBodyLabel = document.getElementById('focus-body-label');
    var btnSaveScript = document.getElementById('focus-save-script');
    var elScriptSaveStatus = document.getElementById('focus-script-save-status');
    var focusScriptDirty = false;
    var focusScriptSaving = false;
    var elMobileFabWrap = document.getElementById('focus-mobile-fab-wrap');
    var elMobileFabActions = document.getElementById('focus-mobile-fab-actions');
    var btnMobileFabToggle = document.getElementById('focus-mobile-fab-toggle');
    var btnMobileCall = document.getElementById('focus-mobile-call');
    var btnMobileAiSms = document.getElementById('focus-mobile-ai-sms');
    var btnMobileBack = document.getElementById('focus-mobile-back');
    var btnMobileCallNext = document.getElementById('focus-mobile-call-next');
    var btnMobileLog = document.getElementById('focus-mobile-log');
    var btnMobileSkip = document.getElementById('focus-mobile-skip');
    var elOutcomePanel = document.getElementById('focus-outcome-panel');
    var elOutcomeDetails = document.getElementById('focus-outcome-details');
    var btnOutcomeCollapse = document.getElementById('focus-outcome-collapse-toggle');
    var elOutcomeCollapseIcon = document.getElementById('focus-outcome-collapse-icon');
    var elOutcomeHeading = document.getElementById('focus-outcome-heading');
    var elOutcomeShortcuts = document.getElementById('focus-outcome-shortcuts');
    var outcomePanelCollapsed = false;
    var elWhySection = document.getElementById('focus-why-section');
    var elWhyReasons = document.getElementById('focus-why-reasons');

    function setOutcomePanelCollapsed(collapsed) {
      outcomePanelCollapsed = !!collapsed;
      if (elOutcomePanel) {
        elOutcomePanel.setAttribute('data-collapsed', outcomePanelCollapsed ? 'true' : 'false');
      }
      if (elOutcomeDetails) {
        elOutcomeDetails.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeHeading) {
        elOutcomeHeading.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (elOutcomeShortcuts) {
        elOutcomeShortcuts.classList.toggle('hidden', outcomePanelCollapsed);
      }
      if (btnOutcomeCollapse) {
        btnOutcomeCollapse.setAttribute('aria-expanded', outcomePanelCollapsed ? 'false' : 'true');
        btnOutcomeCollapse.setAttribute('title', outcomePanelCollapsed ? 'Expand notes' : 'Collapse notes');
      }
      if (elOutcomeCollapseIcon) {
        elOutcomeCollapseIcon.classList.toggle('rotate-180', outcomePanelCollapsed);
      }
    }

    function isMobileViewport() {
      return window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    }
    function closeMobileFabActions() {
      if (elMobileFabActions) elMobileFabActions.classList.add('hidden');
      if (btnMobileFabToggle) btnMobileFabToggle.setAttribute('aria-expanded', 'false');
    }

    function normalizeTel(raw) {
      var s = String(raw || '').trim();
      if (!s) return '';
      var plus = s.indexOf('+') === 0 ? '+' : '';
      var digits = s.replace(/\D/g, '');
      if (!digits) return '';
      return plus + digits;
    }

    function focusCallableQueue() {
      return (queue || [])
        .filter(function (lead) {
          var phone = String((lead && lead.phone) || '').trim();
          return phone && phone !== 'N/A';
        })
        .map(function (lead) {
          return {
            key: String(lead.key || '').trim(),
            title: String(lead.title || 'Lead').trim(),
            phone: String(lead.phone || '').trim(),
          };
        });
    }

    window.__getFocusCallQueueLeads = focusCallableQueue;

    function syncFocusQueueToSoftphone() {
      if (typeof window.__adhelloSetSoftphoneFocusQueue !== 'function') return;
      var lead = currentLead();
      window.__adhelloSetSoftphoneFocusQueue(focusCallableQueue(), lead && lead.key);
    }

    function openDialerForLead(opts) {
      opts = opts && typeof opts === 'object' ? opts : {};
      var lead = currentLead();
      if (!lead || !String(lead.phone || '').trim()) {
        setCopyFeedback('No phone on this lead.', true);
        return;
      }
      if (isMobileViewport()) {
        var to = normalizeTel(lead.phone);
        if (!to) {
          setCopyFeedback('Could not normalize this phone number.', true);
          return;
        }
        setCopyFeedback('Opening your phone app...');
        window.location.href = 'tel:' + to;
        return;
      }
      syncFocusQueueToSoftphone();
      if (typeof window.__adhelloSoftphoneGetSession === 'function') {
        var sess = window.__adhelloSoftphoneGetSession();
        if (sess.wrapRequired && sess.leadKey && String(sess.leadKey) === String(lead.key || '')) {
          if (typeof window.__adhelloFocusSoftphone === 'function') window.__adhelloFocusSoftphone();
          if (typeof window.__adhelloSoftphoneRedial === 'function') {
            window.__adhelloSoftphoneRedial();
            setCopyFeedback('Redialing same number…');
            return;
          }
          setCopyFeedback('Complete wrap-up in the dialer (quick log + Done), or tap Redial same number.', true);
          return;
        }
      }
      var navSoftphoneBtn = document.getElementById('navSoftphoneOpen') || document.getElementById('navSoftphoneOpenMobile');
      if (navSoftphoneBtn) navSoftphoneBtn.click();
      if (typeof window.__adhelloOpenSoftphoneWithDial === 'function') {
        var autoDial = opts.autoDial !== false;
        if (!window.__adhelloOpenSoftphoneWithDial(lead.phone, {
          leadKey: lead.key,
          title: lead.title || '',
          autoDial: autoDial,
        })) {
          setCopyFeedback('Could not normalize that phone number for the dialer.', true);
          return;
        }
        setCopyFeedback(
          autoDial
            ? 'Dialing ' + (lead.title || 'lead') + ' via browser audio…'
            : 'Dialer opened — press the green call button to dial.',
        );
        updateDialerCta();
      } else {
        setCopyFeedback('Dialer opened. Copy phone if needed.', false);
      }
    }

    function onFocusCall() {
      var lead = currentLead();
      if (!lead) return;
      if (btnCall) btnCall.disabled = true;
      openDialerForLead({ autoDial: true });
      if (btnCall) btnCall.disabled = false;
    }

    function setChannelHint() {
      if (!elChannelHint) return;
      elChannelHint.textContent =
        'Call: rehearse the script, dial, and log. AI SMS personalizes your script and sends text or iMessage. Sync GHL saves disposition, notes, and follow-up — then opens the contact in Go High Level.';
    }

    function updateBodyLabel() {
      if (!elBodyLabel) return;
      elBodyLabel.textContent = 'Call script';
    }

    function isSoftphoneOpen() {
      if (typeof window.__adhelloIsSoftphoneOpen === 'function') {
        return window.__adhelloIsSoftphoneOpen();
      }
      var spModal = document.getElementById('softphoneModal');
      return !!(spModal && !spModal.classList.contains('hidden'));
    }

    function updateDialerCta() {
      var lead = currentLead();
      var hasPhone = Boolean(lead && String(lead.phone || '').trim() && String(lead.phone) !== 'N/A');
      var dialerOpen = isSoftphoneOpen();
      if (btnOpenDialer) {
        btnOpenDialer.classList.toggle('hidden', !hasPhone || dialerOpen);
      }
      if (btnCallNext) {
        btnCallNext.classList.toggle('hidden', !hasPhone || currentChannel !== 'call-script');
      }
      if (elMobileFabWrap) {
        var showFab = isMobileViewport() && hasPhone;
        elMobileFabWrap.classList.toggle('hidden', !showFab);
        if (!showFab) closeMobileFabActions();
      }
    }

    function getDefaultProductKey() {
      var stored = '';
      try {
        stored = String(window.sessionStorage.getItem(FOCUS_PRODUCT_STORAGE_KEY) || '').trim();
      } catch (e) {
        stored = '';
      }
      if (stored && elServiceSelect && elServiceSelect.querySelector('option[value="' + stored + '"]')) {
        return stored;
      }
      if (elServiceSelect && elServiceSelect.options && elServiceSelect.options.length) {
        return elServiceSelect.options[0].value;
      }
      return 'reputation';
    }

    function rememberProductKey(key) {
      var k = String(key || '').trim();
      if (!k) return;
      try {
