    function openDialerForLead(opts) {
      opts = opts && typeof opts === 'object' ? opts : {};
      var lead = currentLead();
      if (!lead || !String(lead.phone || '').trim()) {
        setCopyFeedback('No phone on this lead.', true);
        return;
      }
      if (isMobileViewport()) {
        var to = normalizeTel(lead.phone);
        if (!to) {
          setCopyFeedback('Could not normalize this phone number.', true);
          return;
        }
        setCopyFeedback('Opening your phone app...');
        window.location.href = 'tel:' + to;
        return;
      }
      syncFocusQueueToSoftphone();
      if (typeof window.__adhelloSoftphoneGetSession === 'function') {
        var sess = window.__adhelloSoftphoneGetSession();
        if (sess.wrapRequired && sess.leadKey && String(sess.leadKey) === String(lead.key || '')) {
          if (typeof window.__adhelloFocusSoftphone === 'function') window.__adhelloFocusSoftphone();
          if (typeof window.__adhelloSoftphoneRedial === 'function') {
            window.__adhelloSoftphoneRedial();
            setCopyFeedback('Redialing same number…');
            return;
