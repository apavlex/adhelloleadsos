<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark">
  <%- include('partials/navbar') %>
  <main class="max-w-5xl mx-auto px-6 pt-12 pb-24">
    <div class="mb-10 rounded-[2rem] border-2 border-brand-yellow/40 bg-brand-yellow/10 dark:bg-brand-yellow/5 dark:border-brand-yellow/30 p-8 md:p-10">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Default for cold local SMBs</p>
      <div class="page-heading-with-tip">
        <h1 class="font-display font-extrabold text-4xl md:text-5xl text-brand-dark dark:text-white leading-tight">Cadences</h1>
        <%- include('partials/help/sequences_hero_info') %>
      </div>
      <a href="/today" class="inline-flex mt-5 btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Open Today’s cadence queue</a>
    </div>

    <div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-8 mb-10">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white">Active cadences</h2>
          <p class="text-sm text-brand-muted"><%= typeof activeCount !== 'undefined' ? activeCount : 0 %> lead(s) with status <span class="font-semibold text-brand-yellow">active</span></p>
        </div>
        <a href="/pipeline" class="text-sm font-black uppercase tracking-widest text-brand-yellow hover:underline">Open Pipeline</a>
      </div>
      <% if (!activeSequences || activeSequences.length === 0) { %>
        <p class="text-sm text-brand-muted italic">No active sequences. Open a lead on <a href="/pipeline" class="text-brand-yellow font-bold hover:underline">Pipeline</a> (saved leads), run a touch from the row (e.g. voicemail disposition auto-attaches the audit cadence), or start via the API below.</p>
      <% } else { %>
        <ul class="space-y-2">
          <% activeSequences.slice(0, 20).forEach((l) => { %>
            <li>
              <button type="button" class="cadence-lead-open group w-full flex flex-wrap justify-between gap-2 p-4 rounded-2xl bg-brand-cream/40 dark:bg-white/5 border border-brand-border/50 text-left cursor-pointer transition-colors hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow" data-lead-key="<%= String(l.key || '').replace(/"/g, '&quot;') %>" title="Open lead details">
                <span class="font-bold text-brand-dark dark:text-white group-hover:text-brand-dark dark:group-hover:text-brand-yellow"><%= l.title %></span>
                <span class="text-xs text-brand-muted"><%= (l.sequenceState && l.sequenceState.templateId) || '—' %> · next <%= (l.sequenceState && l.sequenceState.nextDueAt) ? new Date(l.sequenceState.nextDueAt).toLocaleString() : '—' %></span>
              </button>
            </li>
          <% }) %>
        </ul>
        <p class="text-[11px] text-brand-muted mt-3">Tip: click a row to open the same business sidebar as on Pipeline.</p>
      <% } %>
    </div>

    <% const _gs = typeof ghlStatus !== 'undefined' && ghlStatus ? ghlStatus : {}; %>
    <% const _go = typeof ghlOutreach !== 'undefined' && ghlOutreach ? ghlOutreach : { tagName: 'auto-outreach', dailyCap: 100, enrolledToday: 0, campaigns: null }; %>
    <% const _goLeads = typeof ghlOutreachLeads !== 'undefined' && Array.isArray(ghlOutreachLeads) ? ghlOutreachLeads : []; %>
    <% const _camp = _go.campaigns || {}; %>
    <% const _canManage = typeof canManageWorkspace !== 'undefined' && canManageWorkspace; %>
    <section id="ghl-auto-outreach" class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/80 dark:bg-slate-900/70 p-8 mb-10 scroll-mt-28 space-y-6">
      <header class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 max-w-2xl">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Runs in GHL</p>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white">GHL auto outreach</h2>
          <p class="text-sm text-brand-muted leading-relaxed mt-1">Enrolled leads get the <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800"><%= _go.tagName %></code> tag in GHL, and your GHL workflow sends the email, SMS, and voicemail. A lead is either on an in-app cadence above or on GHL auto outreach — never both, so nobody gets double-messaged.</p>
        </div>
        <a href="/prospecting?tab=folders" class="text-sm font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Enroll from folders</a>
      </header>

      <div class="grid gap-3 sm:grid-cols-3">
        <div id="ghlOutreachConn" class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-white/5 p-4" data-ghl-configured="<%= _gs.configured ? '1' : '0' %>">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">GHL connection</p>
          <p class="flex items-center gap-2 text-sm font-bold text-brand-dark dark:text-white">
            <span id="ghlOutreachConnDot" class="w-2.5 h-2.5 rounded-full shrink-0 <%= _gs.configured ? 'bg-brand-muted animate-pulse' : 'bg-rose-500' %>" aria-hidden="true"></span>
            <span id="ghlOutreachConnText"><%= _gs.configured ? 'Checking…' : 'Not connected' %></span>
          </p>
          <a href="/workspace/integrations/ghl-setup" class="text-[11px] text-brand-muted underline hover:text-brand-dark dark:hover:text-white">Setup guide</a>
        </div>
        <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-white/5 p-4">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Enrolled today</p>
          <p class="text-sm font-bold text-brand-dark dark:text-white"><%= _go.enrolledToday %> / <%= _go.dailyCap %></p>
          <p class="text-[11px] text-brand-muted">Daily cap keeps GHL out of spam filters (resets midnight UTC).</p>
        </div>
        <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-white/5 p-4">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Enrolling automatically</p>
          <% if (_camp.active) { %>
          <p class="text-sm font-bold text-brand-dark dark:text-white"><%= _camp.folderCount || 0 %> folder<%= _camp.folderCount === 1 ? '' : 's' %><%= _camp.autoPoolEnabled ? ' + auto-pool' : '' %></p>
          <a href="<%= _camp.href || '/prospecting?tab=folders' %>" class="text-[11px] text-brand-muted underline hover:text-brand-dark dark:hover:text-white">Manage campaigns</a>
          <% } else { %>
          <p class="text-sm font-bold text-brand-dark dark:text-white">Off</p>
          <a href="/workspace/integrations/ghl-setup#autoOutreachPoolCard" class="text-[11px] text-brand-muted underline hover:text-brand-dark dark:hover:text-white">Turn on auto-pool</a>
          <% } %>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-brand-dark dark:text-white text-sm mb-2"><%= _goLeads.length %> lead(s) on GHL auto outreach</h3>
        <% if (_goLeads.length === 0) { %>
        <p class="text-sm text-brand-muted italic">No leads enrolled yet. Select leads on Pipeline and choose Auto outreach, or turn on a folder campaign.</p>
        <% } else { %>
        <ul class="space-y-2">
          <% _goLeads.slice(0, 20).forEach((l) => { %>
          <li>
            <button type="button" class="cadence-lead-open group w-full flex flex-wrap justify-between gap-2 p-4 rounded-2xl bg-brand-cream/40 dark:bg-white/5 border border-brand-border/50 text-left cursor-pointer transition-colors hover:border-brand-yellow/50 hover:bg-brand-yellow/10 dark:hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow" data-lead-key="<%= String(l.key || '').replace(/"/g, '&quot;') %>" title="Open lead details">
              <span class="font-bold text-brand-dark dark:text-white group-hover:text-brand-dark dark:group-hover:text-brand-yellow"><%= l.title %></span>
              <span class="text-xs text-brand-muted">Runs in GHL · enrolled <%= l.enrolledAt ? new Date(l.enrolledAt).toLocaleDateString() : '—' %></span>
            </button>
          </li>
          <% }) %>
        </ul>
        <% if (_goLeads.length > 20) { %>
        <p class="text-[11px] text-brand-muted mt-3">Showing the 20 most recent of <%= _goLeads.length %>.</p>
        <% } %>
        <% } %>
      </div>

      <%- include('partials/ghl_auto_outreach_workflow_prompt', { promptId: 'ghlAutoOutreachPromptCadences', compact: false }) %>

      <% const _folderPrompts = typeof folderPrompts !== 'undefined' && Array.isArray(folderPrompts) ? folderPrompts : []; %>
      <% if (_folderPrompts.length) { %>
      <div class="space-y-2">
        <h3 class="font-bold text-brand-dark dark:text-white text-sm">Folder prompts</h3>
        <p class="text-xs text-brand-muted">Custom GHL prompts saved on folder campaigns. Edit them from the folder's Auto outreach settings.</p>
        <% _folderPrompts.forEach(function (fp, i) { %>
        <details class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-950/50 p-4">
          <summary class="cursor-pointer flex flex-wrap items-center justify-between gap-2 text-sm font-bold text-brand-dark dark:text-white">
            <span><%= fp.name %><% if (fp.goal) { %> <span class="font-normal text-brand-muted">· <%= fp.goal.length > 80 ? fp.goal.slice(0, 80) + '…' : fp.goal %></span><% } %></span>
            <span class="text-[10px] font-black uppercase tracking-widest <%= fp.enabled ? 'text-emerald-700 dark:text-emerald-300' : 'text-brand-muted' %>"><%= fp.enabled ? 'Campaign on' : 'Campaign off' %></span>
          </summary>
          <textarea readonly rows="12" id="folderPromptText<%= i %>" class="mt-3 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-3 text-[11px] md:text-xs font-mono leading-relaxed text-brand-dark dark:text-slate-100 resize-y custom-scrollbar" aria-label="GHL prompt for <%= fp.name %>"><%= fp.prompt %></textarea>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <button type="button" class="folder-prompt-copy rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90" data-target="folderPromptText<%= i %>">Copy prompt</button>
            <a href="/prospecting?tab=folders&folderKey=<%= encodeURIComponent(fp.key) %>" class="text-[11px] text-brand-muted underline hover:text-brand-dark dark:hover:text-white">Open folder</a>
          </div>
        </details>
        <% }) %>
      </div>
      <% } %>

      <% if (_canManage) { %>
      <%- include('partials/ghl_workflow_coach', { senderOffers: typeof senderOffers !== 'undefined' ? senderOffers : [] }) %>
      <% } %>
    </section>

    <div class="mb-4 max-w-3xl">
      <div class="page-heading-with-tip mb-2">
        <h2 class="font-display font-bold text-2xl text-brand-dark dark:text-white">Templates (persona)</h2>
        <%- include('partials/help/sequences_templates_info') %>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <% (templates || []).forEach((t) => { %>
        <article class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-6 flex flex-col">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2"><%= t.persona %></span>
          <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-2"><%= t.name %></h3>
          <p class="text-sm text-brand-muted flex-1 mb-3"><%= t.description %></p>
          <p class="text-[11px] text-brand-muted/90 leading-relaxed border-t border-brand-border/20 dark:border-white/10 pt-3 mb-4"><span class="font-bold text-brand-dark dark:text-slate-300">How to use:</span> Start this cadence on a lead via API or from leads workflow; the scheduler advances steps. Use <code class="text-[10px] font-mono bg-brand-cream/80 dark:bg-white/10 px-1 rounded"><%= t.id %></code> in API calls.</p>
          <p class="text-[10px] font-bold text-brand-muted uppercase tracking-widest"><%= t.stepCount %> steps</p>
          <p class="text-[10px] text-brand-muted mt-2 font-mono">id: <%= t.id %></p>
        </article>
      <% }) %>
    </div>

    <div class="mt-12 p-6 rounded-2xl bg-violet-500/10 border border-violet-500/20 text-sm text-brand-dark dark:text-slate-300">
      <strong class="font-display text-brand-dark dark:text-white">API</strong>
      <code class="block mt-2 text-xs bg-white/60 dark:bg-black/30 rounded-lg p-3 overflow-x-auto">POST /leads/:leadKey/sequence/start<br/>Content-Type: application/json<br/>{ "templateId": "audit_local_14" }<br/><br/>POST /leads/:leadKey/cadence/snooze<br/>{ "days": 90, "note": "Call me in Q3" }</code>
    </div>
  </main>

  <%- include('partials/lead_detail_panel') %>
  <div id="leadPanelDatasetHost" class="result-row result-row--panel-source fixed left-[-9999px] top-0 w-px h-px overflow-hidden opacity-0 pointer-events-none" aria-hidden="true" tabindex="-1"></div>

  <script>
    window.PIPELINE_STAGE_LABELS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.name; return m; }, {})) %>;
    window.PIPELINE_STAGE_COLORS = <%- JSON.stringify((typeof pipelineStages !== 'undefined' && pipelineStages ? pipelineStages : []).reduce((m, s) => { m[s.id] = s.color || '#94a3b8'; return m; }, {})) %>;
    window.INITIAL_SAVED_LEADS = [];
  </script>
  <script src="/js/lead-panel-merges.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-notes.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-paint.js?v=<%= assetVersion %>"></script>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <script>
    (function () {
      document.querySelectorAll('.cadence-lead-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var k = btn.getAttribute('data-lead-key');
          if (k && typeof window.openLeadDetailFromKey === 'function') {
            window.openLeadDetailFromKey(k);
          }
        });
      });

      document.querySelectorAll('.folder-prompt-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var ta = document.getElementById(btn.getAttribute('data-target'));
          if (!ta) return;
          function done(ok) {
            btn.textContent = ok ? 'Copied' : 'Select and copy';
            setTimeout(function () { btn.textContent = 'Copy prompt'; }, 2500);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(ta.value).then(function () { done(true); }).catch(function () { done(false); });
          } else {
            ta.select();
            try { done(document.execCommand('copy')); } catch (e) { done(false); }
          }
        });
      });

      var conn = document.getElementById('ghlOutreachConn');
      if (!conn || conn.getAttribute('data-ghl-configured') !== '1') return;
      var dot = document.getElementById('ghlOutreachConnDot');
      var text = document.getElementById('ghlOutreachConnText');
      function setConn(ok, label) {
        if (dot) dot.className = 'w-2.5 h-2.5 rounded-full shrink-0 ' + (ok ? 'bg-emerald-500' : 'bg-amber-500');
        if (text) text.textContent = label;
      }
      fetch('/ghl/status?verify=1', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.connected) setConn(true, data.emailReady ? 'Connected' : 'Connected · set email sender');
          else setConn(false, 'Saved, not verified');
        })
        .catch(function () { setConn(false, 'Could not check'); });
    })();
  </script>
  <%- include('partials/footer') %>
</body>
</html>
