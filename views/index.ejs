<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 pt-12 pb-24">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-8 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-yellow opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-yellow"></span>
        </span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400"><%= typeof warmInboundCount !== 'undefined' ? warmInboundCount : savedLeadsCount %> warm inbound · <%= typeof totalPipelineCount !== 'undefined' ? totalPipelineCount : workspaceLeadsCount %> total pipeline</span>
      </div>
      
      <h1 class="font-display font-extrabold text-5xl md:text-7xl tracking-tight mb-6 leading-[1.1]">
        Lead Generation <br/>
        <span class="text-brand-muted">Run now or run on a schedule</span>
      </h1>
      
      <p class="max-w-2xl mx-auto text-base md:text-lg text-brand-muted font-medium mb-10 leading-relaxed">
        Your <strong class="inline font-bold text-brand-dark dark:text-white">daily leads workflow</strong> for the SaaS motion — scrape verticals, enrich, then run pipeline + outreach from <strong class="inline font-bold text-brand-dark dark:text-white">Today</strong>.
      </p>

      <!-- Map + search hub: map first, then keyword row -->
      <div class="max-w-5xl mx-auto bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl rounded-[2.5rem] border border-white/20 dark:border-white/5 shadow-2xl relative z-10 transition-all duration-500 overflow-hidden text-left" id="searchContainer">
        <%- include('partials/find_area_map') %>

        <div class="p-2 sm:p-3">
          <div class="px-3 pt-4 pb-2 sm:px-5 sm:pt-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Step 2</p>
            <h2 class="font-display font-extrabold text-lg md:text-xl text-brand-dark dark:text-white mt-0.5">What to find &amp; how many</h2>
            <p class="text-sm text-brand-muted mt-1">Keyword and location power the scrape. <strong class="font-semibold text-brand-dark dark:text-white">Scheduled</strong> repeats this search automatically; you’ll get the bell + desktop notification when each run finishes (allow notifications for this site).</p>
          </div>
        <form action="/search" method="POST" id="searchForm">
          <!-- Main Search Row -->
          <div class="grid grid-cols-1 lg:flex items-center gap-2 lg:gap-0 px-2 w-full">
            <!-- Keyword -->
            <div class="px-4 py-3 flex flex-col items-start hover:bg-white/40 dark:hover:bg-white/5 rounded-2xl transition-all duration-300 group flex-[1.5] min-w-0">
              <label class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-1 ml-1 group-hover:text-brand-yellow transition-colors whitespace-nowrap">Business Keyword</label>
              <input type="text" name="keyword" id="searchKeywordField" required placeholder="e.g. Plumber, Dentist"
                class="w-full bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold placeholder:text-brand-dark/20 text-lg p-0 truncate">
            </div>
            
            <div class="hidden lg:block w-px h-8 bg-brand-border/20 mx-2 shrink-0"></div>
            
            <!-- Location -->
            <div class="px-3 py-3 flex flex-col items-start hover:bg-white/40 dark:hover:bg-white/5 rounded-2xl transition-all duration-300 group flex-[1.5] min-w-0">
              <label class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-1 ml-1 group-hover:text-brand-yellow transition-colors whitespace-nowrap">Location</label>
              <div class="flex items-center w-full min-w-0 gap-1">
                <input type="text" name="city" required placeholder="City"
                  class="flex-[2] min-w-[50px] bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold placeholder:text-brand-dark/20 text-lg p-0 truncate">
                <span class="text-brand-muted shrink-0 text-lg">,</span>
                <input type="text" name="state" required placeholder="TX" maxlength="2"
                  class="w-10 min-w-[40px] shrink-0 bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold placeholder:text-brand-dark/20 text-lg p-0 uppercase text-center truncate">
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-brand-border/20 mx-2 shrink-0"></div>

            <!-- Leads Qty -->
            <div class="px-3 py-3 flex flex-col items-start hover:bg-white/40 dark:hover:bg-white/5 rounded-2xl transition-all duration-300 group flex-1 min-w-0">
              <label class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-1 ml-1 group-hover:text-brand-yellow transition-colors whitespace-nowrap">Leads Qty</label>
              <input type="number" name="maxResults" value="20" min="1" max="100"
                class="w-full min-w-0 bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold text-lg p-0">
            </div>

            <div class="hidden lg:block w-px h-8 bg-brand-border/20 mx-2 shrink-0"></div>

            <!-- Mode Toggle -->
            <div class="px-4 py-3 flex flex-col items-start hover:bg-white/40 dark:hover:bg-white/5 rounded-2xl transition-all duration-300 flex-1 min-w-0">
              <label class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-2 ml-1 whitespace-nowrap">Mode</label>
              <div class="flex items-center gap-1 p-1 bg-brand-cream/80 dark:bg-slate-800/80 rounded-xl border border-brand-border/20 dark:border-white/5 w-full h-9">
                <button type="button" id="modeRunNow" class="flex-1 h-full rounded-lg text-[9px] font-black uppercase transition-all bg-white dark:bg-slate-700 text-brand-dark dark:text-slate-100 shadow-sm border border-brand-border/10">Run Now</button>
                <button type="button" id="modeSchedule" class="flex-1 h-full rounded-lg text-[9px] font-black uppercase transition-all text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-slate-100">Scheduled</button>
              </div>
              <input type="hidden" name="mode" id="searchModeInput" value="run">
              <input type="hidden" name="timezone" id="userTimezone">
            </div>

            <div class="hidden lg:block w-px h-8 bg-brand-border/20 mx-2 shrink-0"></div>
            
            <!-- CTA Button -->
            <div class="p-1 shrink-0">
              <button type="submit" id="searchBtn" class="w-full lg:w-auto btn-pill btn-primary px-8 py-4 text-base group shadow-lg hover:shadow-brand-yellow/20 rounded-2xl transition-all duration-300">
                <span id="searchBtnText" class="flex items-center justify-center gap-2 whitespace-nowrap font-black">
                  Find Leads
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <!-- Scheduled scrape settings -->
          <div id="scheduledSearchSettings" class="hidden overflow-hidden border-t border-brand-border/10 dark:border-white/5 transition-all duration-500">
            <div class="flex flex-wrap items-center gap-6 sm:gap-8 px-6 py-4">
                <div id="datePocket" class="flex flex-col items-start group/date">
                    <label for="scheduledDateInput" class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-1 ml-1 group-hover/date:text-brand-yellow transition-colors whitespace-nowrap">Run date</label>
                    <input type="date" id="scheduledDateInput" name="scheduledDate"
                        class="bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold text-base p-0 min-w-[10rem]">
                </div>

                <div class="hidden sm:block w-px h-8 bg-brand-border/10 shrink-0"></div>

                <div id="timePocket" class="flex flex-col items-start group/time">
                    <label class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-brand-muted mb-1 ml-1 group-hover/time:text-brand-yellow transition-colors whitespace-nowrap">Time of day</label>
                    <div class="flex items-center gap-2">
                        <input type="time" name="scheduledTime" id="scheduledTimeInput" value="09:00"
                            class="bg-transparent border-none focus:ring-0 text-brand-dark dark:text-slate-100 font-bold text-base p-0 w-full min-w-[70px]">
                        <svg class="w-3.5 h-3.5 text-brand-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                </div>
                
                <div class="w-full sm:w-auto sm:ml-auto text-[10px] font-black uppercase tracking-widest text-brand-muted/40 italic"><a href="/schedules" class="hover:text-brand-yellow transition-colors">Scheduled runs</a></div>
            </div>
          </div>
        </form>
        </div>
      </div>
    </div>

    <!-- Loading indicator -->
    <div id="loadingIndicator" class="hidden">
      <div class="brand-card max-w-lg mx-auto p-12 text-center animate-pulse">
        <div class="w-16 h-16 bg-brand-yellow/20 rounded-full flex items-center justify-center mx-auto mb-6">
          <div class="animate-spin rounded-full h-8 w-8 border-4 border-brand-yellow/30 border-t-brand-yellow"></div>
        </div>
        <h3 class="font-display font-bold text-xl mb-2">Scraping & Hunting Socials...</h3>
        <p class="text-brand-muted text-sm px-8">We're finding company data and performing a deep social hunt. This can take 2-5 minutes. Please keep this tab open.</p>
      </div>
    </div>

    <!-- Features Section / Proof -->
    <div class="grid-features mt-24">
      <div class="brand-card p-10">
        <div class="feature-icon-container bg-blue-50 text-blue-500">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
        </div>
        <h4 class="font-display font-bold text-xl mb-3">Direct Phone</h4>
        <p class="text-brand-muted text-sm leading-relaxed">Scrape verified phone numbers directly from business listings for outreach.</p>
      </div>
      
      <div class="brand-card p-10">
        <div class="feature-icon-container bg-purple-50 text-purple-500">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
        <h4 class="font-display font-bold text-xl mb-3">Company Websites</h4>
        <p class="text-brand-muted text-sm leading-relaxed">Instantly retrieve official websites to research your leads before contact.</p>
      </div>

      <div class="brand-card p-10">
        <div class="feature-icon-container bg-emerald-50 text-emerald-500">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 6.5h.01" />
          </svg>
        </div>
        <h4 class="font-display font-bold text-xl mb-3">Social Profiles</h4>
        <p class="text-brand-muted text-sm leading-relaxed">Find Facebook, Instagram, and Twitter profiles to connect with leads where they are.</p>
      </div>

      <div class="brand-card p-10">
        <div class="feature-icon-container bg-yellow-50 text-brand-yellow">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </div>
        <h4 class="font-display font-bold text-xl mb-3">Verified Ratings</h4>
        <p class="text-brand-muted text-sm leading-relaxed">Filter leads based on customer reviews and ratings to target the best prospects.</p>
      </div>
    </div>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
