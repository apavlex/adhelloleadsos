<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <% const _findType = typeof searchType !== 'undefined' ? searchType : 'maps'; %>
  <% const _sp = typeof searchPrefill !== 'undefined' && searchPrefill ? searchPrefill : { keyword: '', city: '', state: '', qty: 20 }; %>
  <% const _warm = typeof warmInboundCount !== 'undefined' ? warmInboundCount : savedLeadsCount; %>
  <% const _pipe = typeof totalPipelineCount !== 'undefined' ? totalPipelineCount : workspaceLeadsCount; %>

  <main class="max-wide px-4 sm:px-6 pt-8 pb-20 md:pt-10 md:pb-24">
    <!-- Page header -->
    <header class="max-w-5xl mx-auto mb-6 md:mb-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Prospecting</p>
          <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Find leads</h1>
          <p class="text-sm md:text-base text-brand-muted mt-2 max-w-xl leading-relaxed">
            Pick a search type, set your area, and run. Business, real estate, home owners, products, or wholesale — one workflow.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-border/60 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-brand-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
            <%= _warm %> warm · <%= _pipe %> pipeline
          </span>
        </div>
      </div>
    </header>

    <% if (typeof activeSearchFolder !== 'undefined' && activeSearchFolder && activeSearchFolder.name) { %>
      <div class="max-w-5xl mx-auto mb-4 rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 sm:px-6 py-4 space-y-3">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Folder search</p>
            <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white"><%= activeSearchFolder.name %></h2>
            <% if (typeof folderSearchSummary !== 'undefined' && folderSearchSummary && folderSearchSummary.rows) { %>
              <p class="text-sm text-brand-muted mt-1">Saved setup loaded — review below, pick a city/state, then run.</p>
            <% } else { %>
              <p class="text-sm text-brand-muted mt-1">No search setup saved yet. Use <strong class="text-brand-dark dark:text-white">Search setup</strong> in Folder manager first.</p>
            <% } %>
          </div>
          <a href="/prospecting?tab=folders" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Edit in Folder manager</a>
        </div>
        <% if (typeof folderSearchSummary !== 'undefined' && folderSearchSummary && folderSearchSummary.rows) { %>
          <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 pt-2 border-t border-brand-yellow/25">
            <% folderSearchSummary.rows.forEach(function (row) { %>
              <div class="min-w-0">
                <dt class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= row.label %></dt>
                <dd class="text-sm font-semibold text-brand-dark dark:text-white truncate" title="<%= row.value %>"><%= row.value %></dd>
              </div>
            <% }); %>
          </dl>
        <% } %>
      </div>
    <% } %>

    <!-- Main wizard card -->
    <div class="max-w-5xl mx-auto" id="searchContainer">
      <div class="rounded-[1.75rem] md:rounded-[2rem] border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900/95 shadow-xl shadow-brand-dark/5 overflow-hidden">
        <!-- Search type -->
        <div class="px-4 sm:px-6 py-4 border-b border-brand-border/20 dark:border-white/5 bg-brand-cream/15 dark:bg-slate-950/40">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">What are you searching for?</p>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Search type" id="findTypeTabs">
            <% const _searchTypes = typeof searchTypes !== 'undefined' && searchTypes ? searchTypes : [
              { findTab: 'maps', shortLabel: 'Business' },
              { findTab: 'real_estate', shortLabel: 'Real estate' },
              { findTab: 'home_owners', shortLabel: 'Home owners' },
              { findTab: 'products', shortLabel: 'Products' },
              { findTab: 'wholesale', shortLabel: 'Wholesale' },
            ]; %>
            <% _searchTypes.forEach(function (st) { %>
            <button type="button" role="tab" data-find-type="<%= st.findTab %>" aria-selected="<%= _findType === st.findTab ? 'true' : 'false' %>"
              class="find-type-tab rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors <%= _findType === st.findTab ? 'border-brand-yellow bg-brand-yellow text-brand-dark shadow-sm' : 'border-brand-border/50 bg-white dark:bg-slate-900 text-brand-muted hover:border-brand-yellow/40 hover:text-brand-dark dark:hover:text-white' %>">
              <%= st.shortLabel || st.label %>
            </button>
            <% }); %>
          </div>
        </div>
        <!-- Step progress -->
        <div id="findWizardStepBar" class="px-4 sm:px-6 py-4 border-b border-brand-border/20 dark:border-white/5">
          <ol class="flex items-center gap-2 sm:gap-4" aria-label="Search steps">
            <li class="flex items-center gap-2 min-w-0 flex-1 sm:flex-none">
              <button type="button" data-step-goto="1" data-step-indicator="1" class="find-step-pill flex items-center gap-2 rounded-full border px-3 py-2 text-left transition-colors border-brand-yellow/50 bg-brand-yellow/15 text-brand-dark dark:text-white">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-yellow text-[11px] font-black text-brand-dark">1</span>
                <span class="min-w-0 hidden sm:block">
                  <span class="block text-[10px] font-black uppercase tracking-widest">Area</span>
                  <span class="block text-[11px] text-brand-muted truncate" id="findStep1Hint">Map or city</span>
                </span>
              </button>
            </li>
            <li class="hidden sm:block w-8 h-px bg-brand-border/40 dark:bg-white/10 shrink-0" aria-hidden="true"></li>
            <li class="flex items-center gap-2 min-w-0 flex-1 sm:flex-none">
              <button type="button" data-step-goto="2" data-step-indicator="2" class="find-step-pill flex items-center gap-2 rounded-full border px-3 py-2 text-left transition-colors border-brand-border/40 dark:border-white/10 text-brand-muted">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-cream dark:bg-slate-800 text-[11px] font-black">2</span>
                <span class="min-w-0 hidden sm:block">
                  <span class="block text-[10px] font-black uppercase tracking-widest">Search</span>
                  <span class="block text-[11px] text-brand-muted truncate">Keyword &amp; run</span>
                </span>
              </button>
            </li>
          </ol>
        </div>

        <form action="/search" method="POST" id="searchForm" data-find-type="<%= _findType %>">
          <% if (typeof presetFolderKey !== 'undefined' && presetFolderKey) { %>
            <input type="hidden" name="folderKey" value="<%= presetFolderKey %>" />
          <% } %>
          <!-- STEP 1: Area -->
          <section data-step-panel="1" class="wizard-step-panel">
            <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[min(72vh,720px)]">
              <div class="lg:col-span-3 relative min-h-[min(58vh,640px)] lg:min-h-0 lg:h-full border-b lg:border-b-0 lg:border-r border-brand-border/20 dark:border-white/10 overflow-hidden">
                <%- include('partials/find_area_map') %>
              </div>
              <aside class="lg:col-span-2 p-5 sm:p-6 flex flex-col gap-5 bg-brand-cream/20 dark:bg-slate-950/30 lg:overflow-y-auto">
                <div class="flex items-center gap-2">
                  <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white">Target location</h2>
                  <%- include('/partials/app_info_tip', {
                    tipId: 'find-location-help',
                    tipKey: 'find-location',
                    label: 'Target location for Find Leads',
                    size: 'sm',
                    content: 'Use the map, or type city and state directly. Both stay in sync. Map requires <code class="text-[10px] px-1 rounded bg-white dark:bg-slate-800">GOOGLE_MAPS_API_KEY</code> on the server. Manual entry always works for Find Leads search.'
                  }) %>
                </div>
                <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 p-4 space-y-3">
                  <div>
                    <label for="findManualCity" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">City</label>
                    <input type="text" id="findManualCity" name="city" placeholder="e.g. Vancouver" value="<%= _sp.city || '' %>"
                      class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30" />
                  </div>
                  <div>
                    <label for="findManualState" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">State</label>
                    <input type="text" id="findManualState" name="state" placeholder="BC or WA" maxlength="2" value="<%= _sp.state || '' %>"
                      class="w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold uppercase text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30" />
                  </div>
                </div>
                <div id="findLocationSummary" class="rounded-xl border border-dashed border-brand-yellow/40 bg-brand-yellow/5 px-4 py-3 text-sm text-brand-dark dark:text-slate-200 min-h-[3rem] flex items-center">
                  <span class="text-brand-muted text-xs" id="findLocationSummaryText">Set a city and state to continue.</span>
                </div>

                <div class="mt-auto pt-2 flex justify-end">
                  <button type="button" data-step-next="2" id="findStep1Next" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest w-full sm:w-auto">
                    Continue to keyword
                  </button>
                </div>
              </aside>
            </div>
          </section>

          <!-- STEP 2: Options & run -->
          <section data-step-panel="2" class="wizard-step-panel hidden">
            <div class="p-5 sm:p-6 md:p-8 space-y-6">
              <div id="findStep2Intro">
                <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white" id="findStep2Title">What should we find?</h2>
                <p class="text-sm text-brand-muted mt-1" id="findStep2Desc">We’ll pull Google Maps businesses matching your keyword in the area you chose.</p>
              </div>

              <!-- Live preview -->
              <div id="findSearchPreview" class="rounded-2xl border border-brand-yellow/30 bg-gradient-to-br from-brand-yellow/10 to-transparent dark:from-brand-yellow/5 px-4 py-4 sm:px-5">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Preview</p>
                <p class="font-display font-bold text-base sm:text-lg text-brand-dark dark:text-white" id="findSearchPreviewLine">
                  <span class="text-brand-muted font-semibold">—</span> in <span class="text-brand-muted">—</span>
                </p>
                <p class="text-xs text-brand-muted mt-1" id="findSearchPreviewMeta">Up to 20 results</p>
              </div>

              <!-- Maps / business -->
              <div data-find-panel="maps" class="find-type-panel space-y-6 <%= _findType !== 'maps' ? 'hidden' : '' %>">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-7">
                  <label for="searchKeywordField" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Business keyword</label>
                  <input type="text" name="keyword" id="searchKeywordField" placeholder="Plumber, dental office, HVAC…" value="<%= _sp.keyword || '' %>"
                    class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-lg font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                </div>
                <div class="md:col-span-5 flex items-end">
                  <div class="w-full rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/50 px-4 py-3">
                    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Location</p>
                    <p class="text-sm font-bold text-brand-dark dark:text-white truncate" id="findSearchPreviewLoc">—</p>
                  </div>
                </div>
              </div>

              <%- include('partials/maps_search_criteria', {
                idPrefix: 'find',
                preset: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && _findType === 'maps') ? folderSearchPreset : {}
              }) %>
              </div>

              <!-- Real estate (includes mobile homes) -->
              <div data-find-panel="real_estate" class="find-type-panel space-y-6 <%= _findType !== 'real_estate' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_real_estate', {
                  defaultQuery: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.query) ? folderSearchPreset.query : 'homes for sale',
                  minPrice: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.minPrice != null) ? folderSearchPreset.minPrice : '',
                  maxPrice: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.maxPrice != null) ? folderSearchPreset.maxPrice : '',
                  scraper: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.scraper) ? folderSearchPreset.scraper : 'listings',
                  enabledSources: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.sources) ? folderSearchPreset.sources : null
                }) %>
              </div>

              <% const _defSrc = typeof defaultListingSources !== 'undefined' ? defaultListingSources : {}; %>
              <% const _fp = typeof folderSearchPreset !== 'undefined' ? folderSearchPreset : null; %>
              <div data-find-panel="home_owners" class="find-type-panel space-y-6 <%= _findType !== 'home_owners' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'home_owners',
                  queryLabel: 'Owner / property search terms',
                  queryPlaceholder: 'property owner, tax records, deed…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : 'property owner',
                  scraperHint: 'SerpAPI web search + Oxylabs for owner/property queries; Zillow, Redfin, Realtor for listing context.',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.home_owners || null)
                }) %>
              </div>
              <div data-find-panel="products" class="find-type-panel space-y-6 <%= _findType !== 'products' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'products',
                  queryLabel: 'Product search terms',
                  queryPlaceholder: 'iPhone, furniture, tools…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : '',
                  scraperHint: 'Nationwide search — eBay, OfferUp, web search, and Oxylabs run without a city. Craigslist and Facebook need a local area (use Real estate or Business for geo searches).',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.products || null)
                }) %>
              </div>
              <div data-find-panel="wholesale" class="find-type-panel space-y-6 <%= _findType !== 'wholesale' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'wholesale',
                  queryLabel: 'Wholesale / supplier search terms',
                  queryPlaceholder: 'wholesale, bulk supplier, distributor…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : 'wholesale',
                  scraperHint: 'Nationwide supplier search — web search, Oxylabs, eBay, and OfferUp. Local marketplace scrapers are skipped unless you add a city later.',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.wholesale || null)
                }) %>
              </div>

              <div data-find-panel="permits" class="find-type-panel space-y-6 <%= _findType !== 'permits' ? 'hidden' : '' %>">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  <div class="md:col-span-7">
                    <label for="findPermitCategory" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Permit category / trade</label>
                    <input type="text" name="category" id="findPermitCategory" placeholder="roofing, hvac, solar, plumbing…" value="<%= (_sp.keyword || 'roofing') %>"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-lg font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                  </div>
                  <div class="md:col-span-5 flex items-end">
                    <div class="w-full rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/50 px-4 py-3">
                      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Location</p>
                      <p class="text-sm font-bold text-brand-dark dark:text-white truncate" id="findPermitPreviewLoc">—</p>
                    </div>
                  </div>
                </div>
                <p class="text-xs text-brand-muted leading-relaxed">Imports recent building permits from <a href="https://permit-stack.com/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Permit Stack</a> — contractor name, property address, project value, and filing dates. Add your API key under Workspace → Integrations.</p>
              </div>

              <!-- Shared: max results + folder -->
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-4">
                  <label for="findMaxResults" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Max results</label>
                  <input type="number" name="maxResults" id="findMaxResults" value="<%= _sp.qty != null ? _sp.qty : 25 %>" min="1" max="100"
                    class="w-full rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-lg font-bold text-brand-dark dark:text-white focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                </div>
              </div>

              <details class="group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/30 open:pb-2">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white">
                  <span class="inline-flex items-center gap-2">Pipeline folder<%- include('/partials/app_info_tip', { tipId: 'find-folder-help', tipKey: 'find-folder', label: 'Pipeline folder override', size: 'sm', content: 'Each search type saves to its own pipeline folder by default. Override here if needed.' }) %></span>
                  <span class="text-brand-muted group-open:rotate-180 transition-transform">▾</span>
                </summary>
                <div class="px-4 pb-4 space-y-4 border-t border-brand-border/30 dark:border-white/10 pt-4">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                      <label for="searchFolderKey" class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1 block">Folder</label>
                      <select id="searchFolderKey" name="folderKey" class="w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold">
                        <option value="">Auto (by search type)</option>
                        <% const _pf = typeof pipelineFolderByType !== 'undefined' ? pipelineFolderByType : {}; %>
                        <% _searchTypes.forEach(function (st) {
                          var pf = _pf[st.findTab];
                          if (!pf || !pf.key) return;
                        %><option value="<%= pf.key %>" data-job-type="<%= st.findTab %>"><%= pf.name %></option><% }); %>
                        <% (folders || []).forEach((fd) => { if (!fd || !fd.key || (fd.isPipelineDefault)) return; %>
                          <option value="<%= fd.key %>"><%= fd.name %></option>
                        <% }) %>
                        <option value="__new__">+ Create new folder</option>
                      </select>
                    </div>
                    <div id="searchNewFolderWrap" class="hidden">
                      <label for="searchNewFolderName" class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1 block">New folder name</label>
                      <input id="searchNewFolderName" name="newFolderName" type="text" maxlength="80" placeholder="Plumbers — Austin Apr" class="w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold" />
                    </div>
                  </div>
                </div>
              </details>

              <!-- Run mode -->
              <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 p-4 sm:p-5 space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">When to run</p>
                    <p class="text-sm text-brand-muted mt-0.5">Search now is recommended. Schedule only if you need autopilot.</p>
                  </div>
                  <div class="flex items-center gap-1 p-1 bg-brand-cream/80 dark:bg-slate-800/80 rounded-xl border border-brand-border/20 dark:border-white/5 h-10 w-full sm:w-auto max-w-xs">
                    <button type="button" id="modeRunNow" class="flex-1 h-full rounded-lg text-[9px] font-black uppercase transition-all">Run now</button>
                    <button type="button" id="modeSchedule" class="flex-1 h-full rounded-lg text-[9px] font-black uppercase transition-all">Schedule</button>
                  </div>
                </div>
                <input type="hidden" name="mode" id="searchModeInput" value="run" />
                <input type="hidden" name="timezone" id="userTimezone" />
                <div id="scheduledSearchSettings" class="hidden space-y-4 pt-2 border-t border-brand-border/30 dark:border-white/10">
                  <%- include('partials/schedule_run_options', { schedulePrefix: 'findSchedule' }) %>
                  <label class="inline-flex items-center gap-2 text-sm">
                    <input type="checkbox" name="runNowAlso" id="runNowAlso" class="rounded border-brand-border" />
                    Run once now as well
                  </label>
                  <div class="find-maps-only">
                    <%- include('partials/find_nightly_prep_checkbox') %>
                  </div>
                  <p class="text-[11px] text-brand-muted"><a href="/prospecting?tab=queue" class="text-brand-yellow hover:underline">View scheduled jobs</a></p>
                </div>
              </div>

              <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-2">
                <button type="button" data-step-prev="1" id="findStepBackArea" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Back to area</button>
                <button type="submit" id="searchBtn" class="btn-pill btn-primary px-8 py-4 text-[11px] font-black uppercase tracking-widest shadow-lg shadow-brand-yellow/25 group">
                  <span id="searchBtnText" class="flex items-center justify-center gap-2">
                    Start search
                    <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </span>
                </button>
              </div>
            </div>
          </section>
        </form>

        <% if (typeof schedules !== 'undefined' && schedules.length > 0) { %>
        <div class="border-t border-brand-border/20 dark:border-white/10 px-4 sm:px-6 py-4 bg-brand-cream/20 dark:bg-slate-950/20">
          <div class="flex items-center justify-between gap-2 mb-3">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Upcoming scheduled runs</p>
            <a href="/prospecting?tab=queue" class="text-[10px] font-bold uppercase text-brand-yellow hover:underline">Manage</a>
          </div>
          <ul class="space-y-2 max-h-40 overflow-y-auto" aria-label="Scheduled search queue">
            <% schedules.forEach((job) => { %>
            <li class="flex flex-wrap items-center gap-2 rounded-xl bg-white dark:bg-slate-900 border border-brand-border/20 dark:border-white/10 px-3 py-2.5 text-sm">
              <div class="min-w-0 flex-1">
                <div class="font-bold truncate"><%= job.keyword %></div>
                <div class="text-[11px] text-brand-muted"><%= job.city %>, <%= job.state %> · <%= job.maxResults %> leads</div>
              </div>
              <div class="text-[11px] font-bold tabular-nums shrink-0 text-brand-muted">
                <%= job.scheduledDate || '' %> <%= job.scheduledTime || '09:00' %>
              </div>
              <form action="/schedules/delete" method="POST" class="shrink-0" onsubmit="return confirm('Remove this scheduled run?')">
                <input type="hidden" name="key" value="<%= job.key %>" />
                <input type="hidden" name="returnTo" value="/leads/find" />
                <button type="submit" class="p-2 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30" aria-label="Remove schedule">×</button>
              </form>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
      </div>
    </div>

    <div id="loadingIndicator" class="hidden max-w-lg mx-auto mt-8">
      <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 p-10 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-brand-yellow/20 flex items-center justify-center">
          <div class="animate-spin h-7 w-7 rounded-full border-4 border-brand-yellow/30 border-t-brand-yellow"></div>
        </div>
        <h3 class="font-display font-bold text-lg mb-1">Search started</h3>
        <p class="text-sm text-brand-muted">Keep working — we’ll notify you when leads are ready.</p>
      </div>
    </div>

    <% if ((typeof totalPipelineCount !== 'undefined' ? totalPipelineCount : 0) === 0) { %>
    <section class="max-w-5xl mx-auto mt-10 md:mt-14" aria-label="What each lead includes">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3 text-center">Each lead can include</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-4 py-4 text-center">
          <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-yellow/12 dark:bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <p class="text-xs font-bold text-brand-dark dark:text-white">Phone</p>
        </div>
        <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-4 py-4 text-center">
          <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-yellow/12 dark:bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>
          </div>
          <p class="text-xs font-bold text-brand-dark dark:text-white">Website</p>
        </div>
        <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-4 py-4 text-center">
          <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-yellow/12 dark:bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" /></svg>
          </div>
          <p class="text-xs font-bold text-brand-dark dark:text-white">Social</p>
        </div>
        <div class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-4 py-4 text-center">
          <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-yellow/12 dark:bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
          </div>
          <p class="text-xs font-bold text-brand-dark dark:text-white">Ratings</p>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <script>
  (function () {
    window.FOLDER_SEARCH_PRESET = <%- JSON.stringify(typeof folderSearchPreset !== 'undefined' ? folderSearchPreset : null) %>;
    window.ACTIVE_FOLDER_KEY = <%- JSON.stringify(typeof presetFolderKey !== 'undefined' ? presetFolderKey : '') %>;

    function applyListingSources(root, sourceIds) {
      if (!root) return;
      var ids = Array.isArray(sourceIds) ? sourceIds : [];
      root.querySelectorAll('[data-listing-source]').forEach(function (cb) {
        var sid = cb.getAttribute('data-listing-source');
        cb.checked = !ids.length || ids.indexOf(sid) >= 0;
      });
    }

    function applyFolderSearchPreset() {
      var p = window.FOLDER_SEARCH_PRESET;
      if (!p) return;
      var maxEl = document.getElementById('findMaxResults');
      if (maxEl && p.maxResults) maxEl.value = String(p.maxResults);
      var kw = document.getElementById('searchKeywordField');
      if (kw && p.keyword) kw.value = p.keyword;
      var mhQ = document.getElementById('findReQuery');
      if (mhQ && p.query) mhQ.value = p.query;
      document.querySelectorAll('[data-find-panel="real_estate"] input[name="minPrice"], [data-find-panel="home_owners"] input[name="minPrice"], [data-find-panel="products"] input[name="minPrice"], [data-find-panel="wholesale"] input[name="minPrice"]').forEach(function (el) {
        if (p.minPrice != null) el.value = String(p.minPrice);
      });
      document.querySelectorAll('[data-find-panel="real_estate"] input[name="maxPrice"], [data-find-panel="home_owners"] input[name="maxPrice"], [data-find-panel="products"] input[name="maxPrice"], [data-find-panel="wholesale"] input[name="maxPrice"]').forEach(function (el) {
        if (p.maxPrice != null) el.value = String(p.maxPrice);
      });
      ['real_estate', 'home_owners', 'products', 'wholesale'].forEach(function (tab) {
        var panel = document.querySelector('[data-find-panel="' + tab + '"]');
        if (panel && p.sources) applyListingSources(panel, p.sources);
      });
      ['home_owners', 'products', 'wholesale'].forEach(function (tab) {
        var q = document.querySelector('[data-find-panel="' + tab + '"] input[name="query"]');
        if (q && p.query) q.value = p.query;
      });
      var dirCb = document.getElementById('findDirectorySupplement');
      if (dirCb && p.jobType === 'maps_business') dirCb.checked = p.directorySupplement !== false;
      var mapsProv = document.getElementById('findMapsProvider');
      if (mapsProv && p.mapsProvider) mapsProv.value = p.mapsProvider;
      var minRat = document.getElementById('findMinRating');
      if (minRat && p.minRating != null) minRat.value = String(p.minRating);
      var minRev = document.getElementById('findMinReviews');
      if (minRev && p.minReviews != null) minRev.value = String(p.minReviews);
      var autoTags = document.getElementById('findAutoTags');
      if (autoTags && p.autoTags) autoTags.value = Array.isArray(p.autoTags) ? p.autoTags.join(', ') : p.autoTags;
      var notes = document.getElementById('findSearchNotes');
      if (notes && p.searchNotes) notes.value = p.searchNotes;
      var dirSup = document.getElementById('findDirectorySupplement');
      if (dirSup) dirSup.checked = p.directorySupplement !== false;
      var reScraper = document.getElementById('findReScraper');
      if (reScraper && p.scraper) reScraper.value = p.scraper;
      if (p.flipFilter && p.flipFilter.enabled) {
        var flipCb = document.getElementById('findFlipEnabled');
        if (flipCb) {
          flipCb.checked = true;
          flipCb.dispatchEvent(new Event('change'));
        }
        var ff = p.flipFilter;
        var scoreEl = document.querySelector('[name="minFlipScore"]');
        if (scoreEl && ff.minFlipScore != null) scoreEl.value = String(ff.minFlipScore);
        var roiEl = document.querySelector('[name="minRoiPercent"]');
        if (roiEl && ff.minRoiPercent != null) roiEl.value = String(ff.minRoiPercent);
        var landEl = document.getElementById('findFlipLandMode');
        if (landEl && ff.landMode) landEl.value = ff.landMode;
        var exPark = document.querySelector('[name="flipExcludePark"]');
        if (exPark) exPark.checked = !!ff.excludeParkRent;
        var ownLand = document.querySelector('[name="flipRequireOwnLand"]');
        if (ownLand) ownLand.checked = !!ff.requireOwnLand;
        var noHoa = document.querySelector('[name="flipRequireNoHoa"]');
        if (noHoa) noHoa.checked = !!ff.requireNoHoa;
      }
      var folderSel = document.getElementById('searchFolderKey');
      if (folderSel && window.ACTIVE_FOLDER_KEY) folderSel.value = window.ACTIVE_FOLDER_KEY;
      syncFindPreview();
    }

    function lockFindTypeWhenFolderPreset() {
      if (!window.FOLDER_SEARCH_PRESET || !window.ACTIVE_FOLDER_KEY) return;
      document.querySelectorAll('.find-type-tab').forEach(function (tab) {
        tab.disabled = true;
        tab.setAttribute('aria-disabled', 'true');
        tab.classList.add('opacity-60', 'cursor-not-allowed', 'pointer-events-none');
      });
    }

    var FIND_CONFIG = {
      maps: {
        action: '/search',
        title: 'What should we find?',
        desc: 'Google Maps businesses matching your keyword — enriched in the background.',
        submitRun: 'Start search',
        submitSched: 'Save scheduled job',
        previewLabel: 'leads',
        defaultQuery: 'plumber',
        requiresLocation: true,
      },
      real_estate: {
        action: '/listings/search',
        title: 'Real estate listings',
        desc: 'Homes, land, and mobile homes — multi-source listings with optional flip scoring.',
        submitRun: 'Search all sources',
        submitSched: 'Save scheduled job',
        previewLabel: 'listings',
        defaultQuery: 'homes for sale',
        requiresLocation: true,
      },
      home_owners: {
        action: '/listings/search',
        title: 'Home owners & property info',
        desc: 'Property and owner signals — public records, listings, and web intelligence.',
        submitRun: 'Search sources',
        submitSched: 'Save scheduled job',
        previewLabel: 'results',
        defaultQuery: 'property owner',
        requiresLocation: true,
      },
      products: {
        action: '/listings/search',
        title: 'Product listings',
        desc: 'Search marketplaces nationwide — no city or map required. eBay, OfferUp, and web sources run without a location.',
        submitRun: 'Search marketplaces',
        submitSched: 'Save scheduled job',
        previewLabel: 'listings',
        defaultQuery: 'products',
        requiresLocation: false,
      },
      wholesale: {
        action: '/listings/search',
        title: 'Wholesale suppliers',
        desc: 'Find bulk suppliers and listings nationwide — no area step. Web search, eBay, and OfferUp work without location.',
        submitRun: 'Search suppliers',
        submitSched: 'Save scheduled job',
        previewLabel: 'results',
        defaultQuery: 'wholesale',
        requiresLocation: false,
      },
      permits: {
        action: '/permits/search',
        title: 'Building permits',
        desc: 'Recent permits by city and trade — contractors, addresses, and project details from Permit Stack.',
        submitRun: 'Import permits',
        submitSched: 'Save scheduled job',
        previewLabel: 'permits',
        defaultQuery: 'roofing',
        requiresLocation: true,
      },
    };

    var form = document.getElementById('searchForm');
    var currentType = (form && form.getAttribute('data-find-type')) || 'maps';
    if (!FIND_CONFIG[currentType]) currentType = 'maps';

    function setPanelInputsEnabled(panel, enabled) {
      if (!panel) return;
      panel.querySelectorAll('input, select, textarea, button').forEach(function (el) {
        if (el.classList.contains('find-type-tab')) return;
        el.disabled = !enabled;
      });
    }

    function findTypeRequiresLocation(type) {
      var cfg = FIND_CONFIG[type || currentType];
      return !cfg || cfg.requiresLocation !== false;
    }

    function syncFindLocationMode(type) {
      var needsLoc = findTypeRequiresLocation(type);
      var stepBar = document.getElementById('findWizardStepBar');
      var backBtn = document.getElementById('findStepBackArea');
      var cityEl = document.getElementById('findManualCity');
      var stateEl = document.getElementById('findManualState');
      if (stepBar) stepBar.classList.toggle('hidden', !needsLoc);
      if (backBtn) backBtn.classList.toggle('hidden', !needsLoc);
      if (cityEl) cityEl.required = needsLoc;
      if (stateEl) stateEl.required = needsLoc;
      if (!needsLoc && cityEl) cityEl.value = '';
      if (!needsLoc && stateEl) stateEl.value = '';
      document.dispatchEvent(new CustomEvent('find:locationModeChanged', {
        detail: { requiresLocation: needsLoc, findType: type || currentType },
      }));
    }

    function setFindType(type) {
      if (!FIND_CONFIG[type]) type = 'maps';
      currentType = type;
      if (form) {
        form.action = FIND_CONFIG[type].action;
        form.setAttribute('data-find-type', type);
      }
      document.querySelectorAll('[data-find-panel]').forEach(function (panel) {
        var on = panel.getAttribute('data-find-panel') === type;
        panel.classList.toggle('hidden', !on);
        setPanelInputsEnabled(panel, on);
      });
      document.querySelectorAll('.find-type-tab').forEach(function (tab) {
        var active = tab.getAttribute('data-find-type') === type;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.classList.toggle('border-brand-yellow', active);
        tab.classList.toggle('bg-brand-yellow', active);
        tab.classList.toggle('text-brand-dark', active);
        tab.classList.toggle('shadow-sm', active);
        tab.classList.toggle('border-brand-border/50', !active);
        tab.classList.toggle('bg-white', !active);
        tab.classList.toggle('dark:bg-slate-900', !active);
        tab.classList.toggle('text-brand-muted', !active);
      });
      var cfg = FIND_CONFIG[type];
      var title = document.getElementById('findStep2Title');
      var desc = document.getElementById('findStep2Desc');
      if (title) title.textContent = cfg.title;
      if (desc) desc.textContent = cfg.desc;
      var kw = document.getElementById('searchKeywordField');
      if (kw) kw.required = type === 'maps';
      var nightly = document.getElementById('findNightlyPrepForm');
      if (nightly) nightly.closest('.find-maps-only') && nightly.closest('.find-maps-only').classList.toggle('hidden', type !== 'maps');
      document.querySelectorAll('.find-maps-only').forEach(function (el) {
        el.classList.toggle('hidden', type !== 'maps');
      });
      syncFindPreview();
      updateSubmitLabel();
      syncFindLocationMode(type);
      if (history.replaceState) {
        var url = new URL(window.location.href);
        if (type === 'maps') url.searchParams.delete('type');
        else url.searchParams.set('type', type);
        history.replaceState({}, '', url.pathname + url.search);
      }
    }

    function updateSubmitLabel() {
      var mode = document.getElementById('searchModeInput');
      var isSched = mode && mode.value === 'schedule';
      if (typeof window.syncFindSubmitLabel === 'function') {
        window.syncFindSubmitLabel(isSched);
      }
    }

    var ARROW_SVG = '<svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>';
    var CAL_SVG = '<svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>';
    window.syncFindSubmitLabel = function (isSchedule) {
      var cfg = FIND_CONFIG[currentType];
      var searchBtnLabel = document.getElementById('searchBtnText');
      if (!searchBtnLabel || !cfg) return;
      searchBtnLabel.innerHTML = (isSchedule ? cfg.submitSched : cfg.submitRun) + (isSchedule ? CAL_SVG : ARROW_SVG);
    };

    function syncFindPreview() {
      var kw = document.getElementById('searchKeywordField');
      var reQ = document.getElementById('findReQuery');
      var city = document.getElementById('findManualCity');
      var state = document.getElementById('findManualState');
      var max = document.getElementById('findMaxResults');
      var line = document.getElementById('findSearchPreviewLine');
      var meta = document.getElementById('findSearchPreviewMeta');
      var loc = document.getElementById('findSearchPreviewLoc');
      var hint = document.getElementById('findStep1Hint');
      var summary = document.getElementById('findLocationSummaryText');
      var dir = document.querySelector('[data-find-panel="maps"] input[name="directorySupplement"]');
      if (!dir) dir = document.getElementById('findDirectorySupplement');
      var cfg = FIND_CONFIG[currentType] || FIND_CONFIG.maps;
      var k = '—';
      if (currentType === 'maps') {
        k = kw && kw.value.trim() ? kw.value.trim() : 'Your keyword';
      } else if (currentType === 'permits') {
        var catEl = document.getElementById('findPermitCategory');
        k = catEl && catEl.value.trim() ? catEl.value.trim() + ' permits' : 'roofing permits';
      } else {
        var panel = document.querySelector('[data-find-panel="' + currentType + '"]');
        var qEl = panel && panel.querySelector('input[name="query"]');
        var qVal = qEl && qEl.value.trim ? qEl.value.trim() : '';
        k = qVal || (cfg.defaultQuery || 'listings');
      }
      var c = city && city.value.trim() ? city.value.trim() : '';
      var s = state && state.value.trim() ? state.value.trim().toUpperCase() : '';
      var nationwide = !findTypeRequiresLocation(currentType);
      var locLabel = nationwide ? 'Nationwide' : (c || s ? (c + (c && s ? ', ' : '') + s) : '—');
      if (line) {
        if (nationwide) {
          line.innerHTML = '<span class="text-brand-dark dark:text-white">' + k + '</span> <span class="text-brand-muted font-semibold">· nationwide</span>';
        } else {
          line.innerHTML = '<span class="text-brand-dark dark:text-white">' + k + '</span> in <span class="text-brand-dark dark:text-white">' + locLabel + '</span>';
        }
      }
      if (loc) loc.textContent = locLabel;
      if (hint) hint.textContent = nationwide ? 'No area needed' : (locLabel !== '—' ? locLabel : 'Map or city');
      if (summary) {
        summary.textContent = nationwide
          ? 'No location required — set search terms on the next step.'
          : (locLabel !== '—' ? 'Searching in ' + locLabel : 'Set a city and state to continue.');
        summary.classList.toggle('text-brand-dark', nationwide || locLabel !== '—');
        summary.classList.toggle('dark:text-white', nationwide || locLabel !== '—');
        summary.classList.toggle('text-brand-muted', !nationwide && locLabel === '—');
      }
      if (meta && max) {
        var n = parseInt(max.value, 10) || 20;
        var extra = '';
        if (currentType === 'maps') {
          if (dir && dir.checked) extra += ' · directory supplement on';
          var mp = document.getElementById('findMapsProvider');
          if (mp && mp.value && mp.value !== 'auto') extra += ' · ' + mp.options[mp.selectedIndex].text;
        } else {
          var listPanel = document.querySelector('[data-find-panel="' + currentType + '"]');
          if (listPanel) {
            var srcCount = listPanel.querySelectorAll('[data-listing-source]:checked').length;
            if (srcCount) extra += ' · ' + srcCount + ' scraper' + (srcCount === 1 ? '' : 's');
            var minP = listPanel.querySelector('input[name="minPrice"]');
            var maxP = listPanel.querySelector('input[name="maxPrice"]');
            if ((minP && minP.value) || (maxP && maxP.value)) extra += ' · price filter';
          }
          if (currentType === 'real_estate') {
            var flipOn = document.getElementById('findFlipEnabled');
            if (flipOn && flipOn.checked) extra += ' · flip filter on';
            var scraperSel = document.getElementById('findReScraper');
            if (scraperSel && scraperSel.value && scraperSel.value !== 'listings') {
              extra += ' · ' + scraperSel.options[scraperSel.selectedIndex].text;
            }
          }
        }
        meta.textContent = 'Up to ' + n + ' ' + (cfg.previewLabel || 'results') + extra;
      }
    }

    document.querySelectorAll('.find-type-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        setFindType(tab.getAttribute('data-find-type'));
      });
    });

    ['searchKeywordField', 'findReQuery', 'findPermitCategory', 'findManualCity', 'findManualState', 'findMaxResults'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', syncFindPreview);
    });
    document.querySelectorAll('[data-find-panel] input[name="query"]').forEach(function (el) {
      el.addEventListener('input', syncFindPreview);
    });
    document.querySelectorAll('[data-listing-source]').forEach(function (el) {
      el.addEventListener('change', syncFindPreview);
    });
    var dirCb = document.getElementById('findDirectorySupplement');
    if (dirCb) dirCb.addEventListener('change', syncFindPreview);
    document.addEventListener('find:locationUpdated', syncFindPreview);

    var flipCb = document.getElementById('findFlipEnabled');
    var flipOpts = document.getElementById('findFlipOptions');
    function syncFlip() {
      if (flipOpts && flipCb) flipOpts.classList.toggle('hidden', !flipCb.checked);
    }
    if (flipCb) flipCb.addEventListener('change', syncFlip);
    syncFlip();

    var modeInput = document.getElementById('searchModeInput');
    if (modeInput) modeInput.addEventListener('change', updateSubmitLabel);
    document.getElementById('modeRunNow') && document.getElementById('modeRunNow').addEventListener('click', function () { setTimeout(updateSubmitLabel, 0); });
    document.getElementById('modeSchedule') && document.getElementById('modeSchedule').addEventListener('click', function () { setTimeout(updateSubmitLabel, 0); });

    if (form) {
      form.addEventListener('submit', function () {
        document.querySelectorAll('[data-find-panel].hidden').forEach(function (panel) {
          setPanelInputsEnabled(panel, false);
        });
      });
    }

    setFindType(currentType);
    applyFolderSearchPreset();
    lockFindTypeWhenFolderPreset();
  })();
  </script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
