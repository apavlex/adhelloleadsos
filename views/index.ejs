<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <% const _findType = typeof searchType !== 'undefined' ? searchType : 'maps'; %>
  <% const _sp = typeof searchPrefill !== 'undefined' && searchPrefill ? searchPrefill : { keyword: '', city: '', state: '', qty: 20 }; %>
  <% const _warm = typeof warmInboundCount !== 'undefined' ? warmInboundCount : savedLeadsCount; %>
  <% const _pipe = typeof totalPipelineCount !== 'undefined' ? totalPipelineCount : workspaceLeadsCount; %>

  <main class="max-wide px-4 sm:px-6 pt-8 pb-20 md:pt-10 md:pb-24">
    <!-- Page header -->
    <header class="max-w-5xl mx-auto mb-6 md:mb-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">Prospecting</p>
          <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Find leads</h1>
          <p class="text-sm md:text-base text-brand-muted mt-2 max-w-xl leading-relaxed">
            Pick a search type, set your area, and run. Business, real estate, home owners, products, or wholesale — one workflow.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-border/60 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-brand-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
            <%= _warm %> warm · <%= _pipe %> pipeline
          </span>
        </div>
      </div>
    </header>

    <% if (typeof activeSearchFolder !== 'undefined' && activeSearchFolder && activeSearchFolder.name) { %>
      <div class="max-w-5xl mx-auto mb-4 rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 sm:px-6 py-4 space-y-3">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Folder search</p>
            <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white"><%= activeSearchFolder.name %></h2>
            <% if (typeof folderSearchSummary !== 'undefined' && folderSearchSummary && folderSearchSummary.rows) { %>
              <p class="text-sm text-brand-muted mt-1">Saved setup loaded — review below, pick a city/state, then run.</p>
            <% } else { %>
              <p class="text-sm text-brand-muted mt-1">No search setup saved yet. Use <strong class="text-brand-dark dark:text-white">Search setup</strong> in Folder manager first.</p>
            <% } %>
          </div>
          <a href="/prospecting?tab=folders" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline shrink-0">Edit in Folder manager</a>
        </div>
        <% if (typeof folderSearchSummary !== 'undefined' && folderSearchSummary && folderSearchSummary.rows) { %>
          <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 pt-2 border-t border-brand-yellow/25">
            <% folderSearchSummary.rows.forEach(function (row) { %>
              <div class="min-w-0">
                <dt class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= row.label %></dt>
                <dd class="text-sm font-semibold text-brand-dark dark:text-white truncate" title="<%= row.value %>"><%= row.value %></dd>
              </div>
            <% }); %>
          </dl>
        <% } %>
      </div>
    <% } %>

    <!-- Main wizard card -->
    <div class="max-w-5xl mx-auto" id="searchContainer">
      <div class="rounded-[1.75rem] md:rounded-[2rem] border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900/95 shadow-xl shadow-brand-dark/5 overflow-hidden">
        <!-- Search type -->
        <div class="px-4 sm:px-6 py-4 border-b border-brand-border/20 dark:border-white/5 bg-brand-cream/15 dark:bg-slate-950/40">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">What are you searching for?</p>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Search type" id="findTypeTabs">
            <% const _searchTypes = typeof searchTypes !== 'undefined' && searchTypes ? searchTypes : [
              { findTab: 'maps', shortLabel: 'Business' },
              { findTab: 'real_estate', shortLabel: 'Real estate' },
              { findTab: 'home_owners', shortLabel: 'Home owners' },
              { findTab: 'products', shortLabel: 'Products' },
              { findTab: 'wholesale', shortLabel: 'Wholesale' },
            ]; %>
            <% _searchTypes.forEach(function (st) { %>
            <button type="button" role="tab" data-find-type="<%= st.findTab %>" aria-selected="<%= _findType === st.findTab ? 'true' : 'false' %>"
              class="find-type-tab rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors <%= _findType === st.findTab ? 'border-brand-yellow bg-brand-yellow text-brand-dark shadow-sm' : 'border-brand-border/50 bg-white dark:bg-slate-900 text-brand-muted hover:border-brand-yellow/40 hover:text-brand-dark dark:hover:text-white' %>">
              <%= st.shortLabel || st.label %>
            </button>
            <% }); %>
          </div>
        </div>
        <!-- Step progress -->
        <div id="findWizardStepBar" class="px-4 sm:px-6 py-4 border-b border-brand-border/20 dark:border-white/5">
          <ol class="flex items-center gap-2 sm:gap-4" aria-label="Search steps">
            <li class="flex items-center gap-2 min-w-0 flex-1 sm:flex-none">
              <button type="button" data-step-goto="1" data-step-indicator="1" class="find-step-pill flex items-center gap-2 rounded-full border px-3 py-2 text-left transition-colors border-brand-yellow/50 bg-brand-yellow/15 text-brand-dark dark:text-white">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-yellow text-[11px] font-black text-brand-dark">1</span>
                <span class="min-w-0 hidden sm:block">
                  <span class="block text-[10px] font-black uppercase tracking-widest">Area</span>
                  <span class="block text-[11px] text-brand-muted truncate" id="findStep1Hint">City or address</span>
                </span>
              </button>
            </li>
            <li class="hidden sm:block w-8 h-px bg-brand-border/40 dark:bg-white/10 shrink-0" aria-hidden="true"></li>
            <li class="flex items-center gap-2 min-w-0 flex-1 sm:flex-none">
              <button type="button" data-step-goto="2" data-step-indicator="2" class="find-step-pill flex items-center gap-2 rounded-full border px-3 py-2 text-left transition-colors border-brand-border/40 dark:border-white/10 text-brand-muted">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-cream dark:bg-slate-800 text-[11px] font-black">2</span>
                <span class="min-w-0 hidden sm:block">
                  <span class="block text-[10px] font-black uppercase tracking-widest">Search</span>
                  <span class="block text-[11px] text-brand-muted truncate">Keyword &amp; run</span>
                </span>
              </button>
            </li>
          </ol>
        </div>

        <form action="/search" method="POST" id="searchForm" data-find-type="<%= _findType %>">
          <% if (typeof presetFolderKey !== 'undefined' && presetFolderKey) { %>
            <input type="hidden" name="folderKey" value="<%= presetFolderKey %>" />
          <% } %>
          <!-- STEP 1: Area -->
          <% const _prefCity = String(_sp.city || '').trim();
             const _prefState = String(_sp.state || '').trim().toUpperCase();
             const _prefLocationQuery = _prefCity && _prefState ? _prefCity + ', ' + _prefState : (_prefCity || ''); %>
          <section data-step-panel="1" class="wizard-step-panel">
            <div id="findLocationSimple" class="p-5 sm:p-8 md:p-10 bg-brand-cream/15 dark:bg-slate-950/20">
              <div class="max-w-2xl mx-auto space-y-6">
                <div class="text-center space-y-2">
                  <div class="flex items-center justify-center gap-2">
                    <h2 class="font-display font-bold text-xl md:text-2xl text-brand-dark dark:text-white">Where should we search?</h2>
                    <%- include('/partials/app_info_tip', {
                      tipId: 'find-location-help',
                      tipKey: 'find-location',
                      label: 'Target location for Find Leads',
                      size: 'sm',
                      content: 'Type a city and state like <strong>Vancouver, WA</strong> or a full address. Optional map search opens when you click <strong>Search by map</strong>.'
                    }) %>
                  </div>
                  <p class="text-sm text-brand-muted max-w-md mx-auto">Enter a city, state, or address — like a Google search.</p>
                </div>

                <div id="findPermitCityWrap" class="rounded-2xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 p-4 space-y-3 <%= _findType !== 'permits' ? 'hidden' : '' %>">
                  <div>
                    <label for="findPermitCitySearch" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Permit Stack city</label>
                    <% const _permCityGroups = typeof permitStackCitiesByState !== 'undefined' ? permitStackCitiesByState : [];
                       let _prefPermitLabel = 'Select a supported city…';
                       let _prefPermitCity = '';
                       let _prefPermitState = '';
                       if (_prefCity) {
                         for (const group of _permCityGroups) {
                           for (const row of group[1] || []) {
                             if ((row.city === _prefCity || row.label === _prefCity) && (!_prefState || !row.state || row.state === _prefState)) {
                               _prefPermitCity = row.city;
                               _prefPermitState = row.state || '';
                               _prefPermitLabel = row.label + (row.state ? ' (' + row.state + ')' : '');
                               break;
                             }
                           }
                           if (_prefPermitCity) break;
                         }
                       } %>
                    <div class="permit-city-picker relative" data-permit-city-picker>
                      <input type="hidden" id="findPermitCity" name="permitCity" value="<%= _prefPermitCity %>" data-state="<%= _prefPermitState %>" data-permit-city-value />
                      <button type="button" id="findPermitCityTrigger" class="permit-city-picker-trigger w-full rounded-xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white text-left flex items-center justify-between gap-2 hover:border-brand-yellow/40 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30 transition-colors" aria-haspopup="listbox" aria-expanded="false">
                        <span class="permit-city-picker-label truncate"><%= _prefPermitLabel %></span>
                        <span class="text-brand-muted text-xs shrink-0" aria-hidden="true">▾</span>
                      </button>
                      <div class="permit-city-picker-panel hidden absolute left-0 right-0 top-full mt-1 z-[500] rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 shadow-xl overflow-hidden" role="listbox" aria-label="Permit Stack cities">
                        <div class="p-2 border-b border-brand-border/30 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40">
                          <input type="search" id="findPermitCitySearch" class="permit-city-picker-search w-full rounded-lg border border-brand-border/50 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30" placeholder="Search cities, states…" autocomplete="off" aria-label="Search Permit Stack cities" />
                        </div>
                        <div class="permit-city-picker-list max-h-64 overflow-y-auto custom-scrollbar p-1">
                          <% _permCityGroups.forEach(function (group) {
                               const st = group[0];
                               const rows = group[1] || [];
                          %>
                            <div class="permit-city-picker-group" data-group="<%= st %>">
                              <div class="px-3 pt-2 pb-1 text-[10px] font-black uppercase tracking-widest text-brand-muted sticky top-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm"><%= st === '—' ? 'Other' : st %></div>
                              <% rows.forEach(function (row) {
                                   const selected = _prefPermitCity && row.city === _prefPermitCity;
                                   const searchText = [row.label, row.state, row.city].filter(Boolean).join(' ');
                              %>
                                <button type="button" class="permit-city-picker-option w-full text-left px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white rounded-lg hover:bg-brand-yellow/10 dark:hover:bg-brand-yellow/15<%= selected ? ' is-selected bg-brand-yellow/15 dark:bg-brand-yellow/10' : '' %>"
                                  data-city="<%= row.city %>"
                                  data-state="<%= row.state || '' %>"
                                  data-label="<%= row.label %>"
                                  data-search="<%= searchText %>"
                                  title="<%= row.label %><%= row.state ? ' (' + row.state + ')' : '' %>">
                                  <%= row.label %><%= row.state ? ' (' + row.state + ')' : '' %>
                                </button>
                              <% }); %>
                            </div>
                          <% }); %>
                          <p class="permit-city-picker-empty hidden px-3 py-4 text-sm text-brand-muted text-center">No cities match your search.</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <p class="text-xs text-brand-muted leading-relaxed">Permit Stack only includes supported jurisdictions — pick from this list (same cities as <a href="https://permit-stack.com/search.html" class="underline" target="_blank" rel="noopener noreferrer">permit-stack.com/search</a>).</p>
                </div>

                <div id="findSimpleLocationWrap" class="space-y-4 <%= _findType === 'permits' ? 'hidden' : '' %>">
                  <div class="flex items-stretch rounded-full border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 shadow-lg shadow-brand-dark/5 overflow-hidden focus-within:border-brand-yellow focus-within:ring-4 focus-within:ring-brand-yellow/20 transition-all">
                    <label for="findLocationQuery" class="sr-only">Search city, state, or address</label>
                    <span class="hidden sm:flex items-center pl-5 text-brand-muted shrink-0" aria-hidden="true">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
                    </span>
                    <input type="search" id="findLocationQuery" autocomplete="off" placeholder="Vancouver, WA or full address…" value="<%= _prefLocationQuery %>"
                      class="min-w-0 flex-1 border-0 bg-transparent px-4 sm:px-2 py-4 sm:py-3.5 text-base sm:text-lg font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/55 focus:outline-none focus:ring-0" />
                    <button type="button" id="findLocationResolveBtn" class="shrink-0 m-1.5 sm:m-2 rounded-full bg-brand-yellow px-5 sm:px-6 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark hover:brightness-105 active:scale-[0.98] transition-all">
                      Search
                    </button>
                  </div>
                  <div class="flex justify-center">
                    <button type="button" id="findOpenMapBtn" class="inline-flex items-center gap-2 rounded-full border border-brand-border/40 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/40 transition-colors">
                      <svg class="w-4 h-4 text-brand-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      Search by map
                    </button>
                  </div>
                </div>

                <div id="findManualCityWrap" class="sr-only" aria-hidden="true">
                  <input type="text" id="findManualCity" name="city" tabindex="-1" value="<%= _sp.city || '' %>" />
                  <input type="text" id="findManualState" name="state" maxlength="2" tabindex="-1" value="<%= _sp.state || '' %>" />
                </div>

                <div id="findLocationSummary" class="rounded-xl border border-dashed border-brand-yellow/40 bg-brand-yellow/5 px-4 py-3 text-sm text-brand-dark dark:text-slate-200 min-h-[3rem] flex items-center justify-center text-center">
                  <span class="text-brand-muted text-xs" id="findLocationSummaryText">Enter a location above to continue.</span>
                </div>

                <div class="flex justify-center pt-2">
                  <button type="button" data-step-next="2" id="findStep1Next" class="btn-pill btn-primary px-8 py-3.5 text-[10px] font-black uppercase tracking-widest w-full sm:w-auto min-w-[12rem]">
                    Continue to keyword
                  </button>
                </div>
              </div>
            </div>

            <div id="findAreaMapPanel" class="hidden border-t border-brand-border/20 dark:border-white/10 bg-brand-cream/10 dark:bg-slate-950/40">
              <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-brand-border/20 dark:border-white/10">
                <div>
                  <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-0.5">Map search</p>
                  <h3 class="font-display font-bold text-base text-brand-dark dark:text-white">Pick an area on the map</h3>
                </div>
                <button type="button" id="findCloseMapBtn" class="shrink-0 rounded-full border border-brand-border/40 dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white transition-colors">
                  Close map
                </button>
              </div>
              <div class="relative min-h-[min(52vh,560px)] overflow-hidden" id="findAreaMapCol">
                <%- include('partials/find_area_map') %>
              </div>
            </div>
          </section>

          <!-- STEP 2: Options & run -->
          <section data-step-panel="2" class="wizard-step-panel hidden">
            <div class="p-5 sm:p-6 md:p-8 space-y-6">
              <div id="findStep2Intro">
                <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white" id="findStep2Title">What should we find?</h2>
                <p class="text-sm text-brand-muted mt-1" id="findStep2Desc">We’ll pull Google Maps businesses matching your keyword in the area you chose.</p>
              </div>

              <!-- Live preview -->
              <div id="findSearchPreview" class="rounded-2xl border border-brand-yellow/30 bg-gradient-to-br from-brand-yellow/10 to-transparent dark:from-brand-yellow/5 px-4 py-4 sm:px-5">
                <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Preview</p>
                <p class="font-display font-bold text-base sm:text-lg text-brand-dark dark:text-white" id="findSearchPreviewLine">
                  <span class="text-brand-muted font-semibold">—</span> in <span class="text-brand-muted">—</span>
                </p>
                <p class="text-xs text-brand-muted mt-1" id="findSearchPreviewMeta">Up to 20 results</p>
              </div>

              <!-- Maps / business -->
              <div data-find-panel="maps" class="find-type-panel space-y-6 <%= _findType !== 'maps' ? 'hidden' : '' %>">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-7">
                  <label for="searchKeywordField" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Business keyword</label>
                  <input type="text" name="keyword" id="searchKeywordField" placeholder="Plumber, dental office, HVAC…" value="<%= _sp.keyword || '' %>"
                    class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-lg font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                </div>
                <div class="md:col-span-5 flex items-end">
                  <div class="w-full rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/50 px-4 py-3">
                    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Location</p>
                    <p class="text-sm font-bold text-brand-dark dark:text-white truncate" id="findSearchPreviewLoc">—</p>
                  </div>
                </div>
              </div>

              <%- include('partials/maps_search_criteria', {
                idPrefix: 'find',
                preset: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && _findType === 'maps') ? folderSearchPreset : {}
              }) %>
              </div>

              <!-- Real estate (includes mobile homes) -->
              <div data-find-panel="real_estate" class="find-type-panel space-y-6 <%= _findType !== 'real_estate' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_real_estate', {
                  defaultQuery: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.query) ? folderSearchPreset.query : 'homes for sale',
                  minPrice: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.minPrice != null) ? folderSearchPreset.minPrice : '',
                  maxPrice: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.maxPrice != null) ? folderSearchPreset.maxPrice : '',
                  scraper: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.scraper) ? folderSearchPreset.scraper : 'listings',
                  enabledSources: (typeof folderSearchPreset !== 'undefined' && folderSearchPreset && folderSearchPreset.sources) ? folderSearchPreset.sources : null
                }) %>
              </div>

              <% const _defSrc = typeof defaultListingSources !== 'undefined' ? defaultListingSources : {}; %>
              <% const _fp = typeof folderSearchPreset !== 'undefined' ? folderSearchPreset : null; %>
              <div data-find-panel="home_owners" class="find-type-panel space-y-6 <%= _findType !== 'home_owners' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'home_owners',
                  queryLabel: 'Owner / property search terms',
                  queryPlaceholder: 'property owner, tax records, deed…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : 'property owner',
                  scraperHint: 'SerpAPI web search + Oxylabs for owner/property queries; Zillow, Redfin, Realtor for listing context.',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.home_owners || null)
                }) %>
              </div>
              <div data-find-panel="products" class="find-type-panel space-y-6 <%= _findType !== 'products' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'products',
                  queryLabel: 'Product search terms',
                  queryPlaceholder: 'iPhone, furniture, tools…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : '',
                  scraperHint: 'Nationwide search — eBay, OfferUp, web search, and Oxylabs run without a city. Craigslist and Facebook need a local area (use Real estate or Business for geo searches).',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.products || null)
                }) %>
              </div>
              <div data-find-panel="wholesale" class="find-type-panel space-y-6 <%= _findType !== 'wholesale' ? 'hidden' : '' %>">
                <%- include('partials/find_panel_listing_generic', {
                  jobType: 'wholesale',
                  queryLabel: 'Wholesale / supplier search terms',
                  queryPlaceholder: 'wholesale, bulk supplier, distributor…',
                  defaultQuery: (_fp && _fp.query) ? _fp.query : 'wholesale',
                  scraperHint: 'Nationwide supplier search — web search, Oxylabs, eBay, and OfferUp. Local marketplace scrapers are skipped unless you add a city later.',
                  enabledSources: (_fp && _fp.sources) ? _fp.sources : (_defSrc.wholesale || null)
                }) %>
              </div>

              <div data-find-panel="permits" class="find-type-panel space-y-6 <%= _findType !== 'permits' ? 'hidden' : '' %>">
                <% const _permCatRaw = String(_sp.keyword || 'roofing').trim().toLowerCase().replace(/\s+/g, '_').replace(/-/g, '_');
                   const _permCats = typeof permitStackCategories !== 'undefined' ? permitStackCategories : [{ value: '', label: 'All categories' }];
                   const _permCatKnown = _permCats.find(function (c) { return c.value && c.value === _permCatRaw; });
                   const _permCatSelected = _permCatKnown ? _permCatKnown.value : (_permCatRaw === 'all' ? '' : _permCatRaw); %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  <div>
                    <label for="findPermitCategory" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Category</label>
                    <select name="category" id="findPermitCategory"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-sm font-bold text-brand-dark dark:text-white focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25">
                      <% _permCats.forEach(function (cat) { %>
                        <option value="<%= cat.value %>"<%= cat.value === _permCatSelected ? ' selected' : '' %>><%= cat.label %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div>
                    <label for="findPermitZip" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Zip code</label>
                    <input type="text" name="zip" id="findPermitZip" inputmode="numeric" pattern="[0-9]*" maxlength="10" placeholder="e.g. 78702" value="<%= _sp.zip || '' %>"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-sm font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                  </div>
                  <div>
                    <label for="findPermitKeyword" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Keyword</label>
                    <input type="text" name="permitKeyword" id="findPermitKeyword" placeholder="e.g. solar panel" value="<%= _sp.permitKeyword || '' %>"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-sm font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                  </div>
                  <div>
                    <label for="findPermitContractor" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Contractor</label>
                    <input type="text" name="contractor" id="findPermitContractor" placeholder="e.g. ABC Roofing" value="<%= _sp.permitContractor || '' %>"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-sm font-bold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                  </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  <div>
                    <label for="findPermitFiledAfter" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Filed after</label>
                    <input type="date" name="filed_after" id="findPermitFiledAfter" value="<%= _sp.filedAfter || '' %>"
                      class="w-full rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-sm font-bold text-brand-dark dark:text-white focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                  </div>
                  <div class="sm:col-span-1 lg:col-span-3 flex items-end">
                    <div class="w-full rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/40 dark:bg-slate-800/50 px-4 py-3">
                      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Location</p>
                      <p class="text-sm font-bold text-brand-dark dark:text-white truncate" id="findPermitPreviewLoc">—</p>
                    </div>
                  </div>
                </div>
                <p class="text-xs text-brand-muted leading-relaxed">Imports recent building permits from <a href="https://permit-stack.com/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Permit Stack</a>. Optional filters (keyword, contractor, filed after) narrow results — leave blank for the broadest match. Add your API key under Workspace → Integrations.</p>
              </div>

              <!-- Shared: max results + folder -->
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-4">
                  <label for="findMaxResults" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Max results</label>
                  <input type="number" name="maxResults" id="findMaxResults" value="<%= _sp.qty != null ? _sp.qty : 25 %>" min="1" max="100"
                    class="w-full rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3.5 text-lg font-bold text-brand-dark dark:text-white focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
                </div>
              </div>

              <details class="group rounded-2xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/30 open:pb-2">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white">
                  <span class="inline-flex items-center gap-2">Pipeline folder<%- include('/partials/app_info_tip', { tipId: 'find-folder-help', tipKey: 'find-folder', label: 'Pipeline folder override', size: 'sm', content: 'Each search type saves to its own pipeline folder by default. Override here if needed.' }) %></span>
