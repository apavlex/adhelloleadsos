  </main>

  <script src="/js/permit-city-picker.js?v=<%= assetVersion %>"></script>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <script>
  (function () {
    window.FOLDER_SEARCH_PRESET = <%- JSON.stringify(typeof folderSearchPreset !== 'undefined' ? folderSearchPreset : null) %>;
    window.ACTIVE_FOLDER_KEY = <%- JSON.stringify(typeof presetFolderKey !== 'undefined' ? presetFolderKey : '') %>;

    function applyListingSources(root, sourceIds) {
      if (!root) return;
      var ids = Array.isArray(sourceIds) ? sourceIds : [];
      root.querySelectorAll('[data-listing-source]').forEach(function (cb) {
        var sid = cb.getAttribute('data-listing-source');
        cb.checked = !ids.length || ids.indexOf(sid) >= 0;
      });
    }

    function applyFolderSearchPreset() {
      var p = window.FOLDER_SEARCH_PRESET;
      if (!p) return;
      var maxEl = document.getElementById('findMaxResults');
      if (maxEl && p.maxResults) maxEl.value = String(p.maxResults);
      var kw = document.getElementById('searchKeywordField');
      if (kw && p.keyword) kw.value = p.keyword;
      var mhQ = document.getElementById('findReQuery');
      if (mhQ && p.query) mhQ.value = p.query;
      document.querySelectorAll('[data-find-panel="real_estate"] input[name="minPrice"], [data-find-panel="home_owners"] input[name="minPrice"], [data-find-panel="products"] input[name="minPrice"], [data-find-panel="wholesale"] input[name="minPrice"]').forEach(function (el) {
        if (p.minPrice != null) el.value = String(p.minPrice);
      });
      document.querySelectorAll('[data-find-panel="real_estate"] input[name="maxPrice"], [data-find-panel="home_owners"] input[name="maxPrice"], [data-find-panel="products"] input[name="maxPrice"], [data-find-panel="wholesale"] input[name="maxPrice"]').forEach(function (el) {
        if (p.maxPrice != null) el.value = String(p.maxPrice);
      });
      ['real_estate', 'home_owners', 'products', 'wholesale'].forEach(function (tab) {
        var panel = document.querySelector('[data-find-panel="' + tab + '"]');
        if (panel && p.sources) applyListingSources(panel, p.sources);
      });
      ['home_owners', 'products', 'wholesale'].forEach(function (tab) {
        var q = document.querySelector('[data-find-panel="' + tab + '"] input[name="query"]');
        if (q && p.query) q.value = p.query;
      });
      var dirCb = document.getElementById('findDirectorySupplement');
      if (dirCb && p.jobType === 'maps_business') dirCb.checked = p.directorySupplement !== false;
      var mapsProv = document.getElementById('findMapsProvider');
      if (mapsProv && p.mapsProvider) mapsProv.value = p.mapsProvider;
      var minRat = document.getElementById('findMinRating');
      if (minRat && p.minRating != null) minRat.value = String(p.minRating);
      var minRev = document.getElementById('findMinReviews');
      if (minRev && p.minReviews != null) minRev.value = String(p.minReviews);
      var autoTags = document.getElementById('findAutoTags');
      if (autoTags && p.autoTags) autoTags.value = Array.isArray(p.autoTags) ? p.autoTags.join(', ') : p.autoTags;
      var notes = document.getElementById('findSearchNotes');
      if (notes && p.searchNotes) notes.value = p.searchNotes;
      var dirSup = document.getElementById('findDirectorySupplement');
      if (dirSup) dirSup.checked = p.directorySupplement !== false;
      var reScraper = document.getElementById('findReScraper');
      if (reScraper && p.scraper) reScraper.value = p.scraper;
      if (p.flipFilter && p.flipFilter.enabled) {
        var flipCb = document.getElementById('findFlipEnabled');
        if (flipCb) {
          flipCb.checked = true;
          flipCb.dispatchEvent(new Event('change'));
        }
        var ff = p.flipFilter;
        var scoreEl = document.querySelector('[name="minFlipScore"]');
        if (scoreEl && ff.minFlipScore != null) scoreEl.value = String(ff.minFlipScore);
        var roiEl = document.querySelector('[name="minRoiPercent"]');
        if (roiEl && ff.minRoiPercent != null) roiEl.value = String(ff.minRoiPercent);
        var landEl = document.getElementById('findFlipLandMode');
        if (landEl && ff.landMode) landEl.value = ff.landMode;
        var exPark = document.querySelector('[name="flipExcludePark"]');
        if (exPark) exPark.checked = !!ff.excludeParkRent;
        var ownLand = document.querySelector('[name="flipRequireOwnLand"]');
        if (ownLand) ownLand.checked = !!ff.requireOwnLand;
        var noHoa = document.querySelector('[name="flipRequireNoHoa"]');
        if (noHoa) noHoa.checked = !!ff.requireNoHoa;
      }
      var folderSel = document.getElementById('searchFolderKey');
      if (folderSel && window.ACTIVE_FOLDER_KEY) folderSel.value = window.ACTIVE_FOLDER_KEY;
      syncFindPreview();
    }

    function lockFindTypeWhenFolderPreset() {
      if (!window.FOLDER_SEARCH_PRESET || !window.ACTIVE_FOLDER_KEY) return;
      document.querySelectorAll('.find-type-tab').forEach(function (tab) {
        tab.disabled = true;
        tab.setAttribute('aria-disabled', 'true');
        tab.classList.add('opacity-60', 'cursor-not-allowed', 'pointer-events-none');
      });
    }

    var FIND_CONFIG = {
      maps: {
        action: '/search',
        title: 'What should we find?',
        desc: 'Google Maps businesses matching your keyword — enriched in the background.',
        submitRun: 'Start search',
        submitSched: 'Save scheduled job',
        previewLabel: 'leads',
        defaultQuery: 'plumber',
        requiresLocation: true,
      },
      real_estate: {
        action: '/listings/search',
        title: 'Real estate listings',
        desc: 'Homes, land, and mobile homes — multi-source listings with optional flip scoring.',
        submitRun: 'Search all sources',
        submitSched: 'Save scheduled job',
        previewLabel: 'listings',
        defaultQuery: 'homes for sale',
        requiresLocation: true,
      },
      home_owners: {
        action: '/listings/search',
        title: 'Home owners & property info',
        desc: 'Property and owner signals — public records, listings, and web intelligence.',
        submitRun: 'Search sources',
        submitSched: 'Save scheduled job',
        previewLabel: 'results',
        defaultQuery: 'property owner',
        requiresLocation: true,
      },
      products: {
        action: '/listings/search',
        title: 'Product listings',
        desc: 'Search marketplaces nationwide — no city or map required. eBay, OfferUp, and web sources run without a location.',
        submitRun: 'Search marketplaces',
        submitSched: 'Save scheduled job',
        previewLabel: 'listings',
        defaultQuery: 'products',
        requiresLocation: false,
      },
      wholesale: {
        action: '/listings/search',
        title: 'Wholesale suppliers',
        desc: 'Find bulk suppliers and listings nationwide — no area step. Web search, eBay, and OfferUp work without location.',
        submitRun: 'Search suppliers',
        submitSched: 'Save scheduled job',
        previewLabel: 'results',
        defaultQuery: 'wholesale',
        requiresLocation: false,
      },
      permits: {
        action: '/permits/search',
        title: 'Building permits',
        desc: 'Recent permits by city and trade — contractors, addresses, and project details from Permit Stack.',
        submitRun: 'Import permits',
        submitSched: 'Save scheduled job',
        previewLabel: 'permits',
        defaultQuery: 'roofing',
        requiresLocation: true,
      },
    };

    var form = document.getElementById('searchForm');
    var currentType = (form && form.getAttribute('data-find-type')) || 'maps';
    if (!FIND_CONFIG[currentType]) currentType = 'maps';

    function setPanelInputsEnabled(panel, enabled) {
      if (!panel) return;
      panel.querySelectorAll('input, select, textarea, button').forEach(function (el) {
        if (el.classList.contains('find-type-tab')) return;
        el.disabled = !enabled;
      });
    }

    function findTypeRequiresLocation(type) {
      var cfg = FIND_CONFIG[type || currentType];
      return !cfg || cfg.requiresLocation !== false;
    }

    function syncFindLocationMode(type) {
      var needsLoc = findTypeRequiresLocation(type);
      var isPermits = (type || currentType) === 'permits';
      var stepBar = document.getElementById('findWizardStepBar');
      var backBtn = document.getElementById('findStepBackArea');
      var cityEl = document.getElementById('findManualCity');
      var stateEl = document.getElementById('findManualState');
      var permitWrap = document.getElementById('findPermitCityWrap');
      var simpleWrap = document.getElementById('findSimpleLocationWrap');
      var mapPanel = document.getElementById('findAreaMapPanel');
      var permitCityEl = document.getElementById('findPermitCity');
      if (stepBar) stepBar.classList.toggle('hidden', !needsLoc);
      if (backBtn) backBtn.classList.toggle('hidden', !needsLoc);
      if (permitWrap) permitWrap.classList.toggle('hidden', !isPermits);
      if (simpleWrap) simpleWrap.classList.toggle('hidden', isPermits);
      if (mapPanel && isPermits) mapPanel.classList.add('hidden');
      if (cityEl) cityEl.required = needsLoc && !isPermits;
      if (stateEl) stateEl.required = needsLoc && !isPermits;
      if (permitCityEl) permitCityEl.required = needsLoc && isPermits;
      if (!needsLoc && cityEl) cityEl.value = '';
      if (!needsLoc && stateEl) stateEl.value = '';
      if (isPermits) syncPermitCityToManual();
      document.dispatchEvent(new CustomEvent('find:locationModeChanged', {
        detail: { requiresLocation: needsLoc, findType: type || currentType },
      }));
    }

    function parseCityStateFromQuery(raw) {
      var q = String(raw || '').trim();
      if (!q) return { city: '', state: '' };
      var parts = q.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      if (parts.length >= 2) {
        var last = parts[parts.length - 1];
        var stMatch = last.match(/^([A-Za-z]{2})(?:\s+\d{5}(?:-\d{4})?)?$/);
        if (stMatch) {
          return {
            city: parts[parts.length - 2] || parts[0] || '',
            state: stMatch[1].toUpperCase(),
          };
        }
        var zipMatch = last.match(/([A-Za-z]{2})\s+(\d{5})/);
        if (zipMatch && parts.length >= 3) {
          return { city: parts[parts.length - 2] || '', state: zipMatch[1].toUpperCase() };
        }
      }
      if (parts.length === 1) return { city: parts[0], state: '' };
      return { city: parts[0] || '', state: '' };
    }

    function writeFindManualLocation(city, state, queryLabel) {
      var cityEl = document.getElementById('findManualCity');
      var stateEl = document.getElementById('findManualState');
      var queryEl = document.getElementById('findLocationQuery');
      if (cityEl) cityEl.value = city || '';
      if (stateEl) stateEl.value = (state || '').slice(0, 2).toUpperCase();
      if (queryEl && queryLabel) queryEl.value = queryLabel;
      else if (queryEl && city && state) queryEl.value = city + ', ' + state;
      try {
        document.dispatchEvent(new CustomEvent('find:locationUpdated', {
          detail: { city: city || '', state: state || '' },
        }));
      } catch (e) { /* ignore */ }
    }

    function geocodeFindLocationQuery(query, done) {
      var q = String(query || '').trim();
      if (!q) {
        done(null, 'Enter a city, state, or address.');
        return;
      }
      if (window.google && google.maps && google.maps.Geocoder) {
        var geocoder = new google.maps.Geocoder();
        geocoder.geocode({ address: q }, function (results, status) {
          if (status === 'OK' && results && results[0]) {
            var comps = results[0].address_components || [];
            var city = '';
            var state = '';
            for (var i = 0; i < comps.length; i++) {
              var t = comps[i].types || [];
              if (t.indexOf('locality') >= 0) city = comps[i].long_name;
              if (t.indexOf('administrative_area_level_1') >= 0) state = comps[i].short_name || '';
            }
            if (!city) {
              for (var j = 0; j < comps.length; j++) {
                var t2 = comps[j].types || [];
                if (t2.indexOf('sublocality') >= 0 || t2.indexOf('neighborhood') >= 0) {
                  city = comps[j].long_name;
                  break;
                }
              }
            }
            var label = results[0].formatted_address || q;
            done({ city: city || '', state: (state || '').slice(0, 2).toUpperCase(), label: label }, null);
            return;
          }
          var parsed = parseCityStateFromQuery(q);
          if (parsed.city && parsed.state) {
            done({ city: parsed.city, state: parsed.state, label: q }, null);
            return;
          }
          done(null, 'Could not find that location — try City, ST (e.g. Vancouver, WA).');
        });
        return;
      }
      var fallback = parseCityStateFromQuery(q);
      if (fallback.city && fallback.state) {
        done({ city: fallback.city, state: fallback.state, label: q }, null);
        return;
      }
      if (fallback.city) {
        done({ city: fallback.city, state: '', label: q }, 'Add a state — e.g. Vancouver, WA');
        return;
      }
      done(null, 'Enter city and state — e.g. Vancouver, WA');
    }

    function resolveFindLocationFromQuery(cb) {
      var queryEl = document.getElementById('findLocationQuery');
      var summary = document.getElementById('findLocationSummaryText');
      var q = queryEl ? String(queryEl.value || '').trim() : '';
      if (!q) {
        if (summary) summary.textContent = 'Enter a location above to continue.';
        if (cb) cb(false);
        return;
      }
      if (typeof window.__bootFindAreaMap === 'function') window.__bootFindAreaMap();
      if (summary) summary.textContent = 'Looking up location…';
      geocodeFindLocationQuery(q, function (loc, err) {
        if (!loc || !loc.city || !loc.state) {
          if (summary) summary.textContent = err || 'Enter city and state — e.g. Vancouver, WA';
          if (cb) cb(false);
          return;
        }
        writeFindManualLocation(loc.city, loc.state, loc.label || q);
        syncFindPreview();
        if (cb) cb(true);
      });
    }

    function openFindAreaMapPanel() {
      var panel = document.getElementById('findAreaMapPanel');
      if (!panel) return;
      panel.classList.remove('hidden');
      if (typeof window.__bootFindAreaMap === 'function') window.__bootFindAreaMap();
      setTimeout(function () {
        if (window.__findAreaMap && window.google && google.maps) {
          try {
            google.maps.event.trigger(window.__findAreaMap, 'resize');
          } catch (e) { /* ignore */ }
        }
      }, 200);
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeFindAreaMapPanel() {
      var panel = document.getElementById('findAreaMapPanel');
      if (panel) panel.classList.add('hidden');
    }

    function syncPermitCityToManual() {
      var hidden = document.getElementById('findPermitCity');
      var cityEl = document.getElementById('findManualCity');
      var stateEl = document.getElementById('findManualState');
      if (!hidden || !cityEl || !stateEl) return;
      var city = String(hidden.value || '').trim();
      var state = String(hidden.getAttribute('data-state') || '').trim();
      cityEl.value = city;
      stateEl.value = state;
    }

    function setFindType(type) {
      if (!FIND_CONFIG[type]) type = 'maps';
      currentType = type;
      if (form) {
        form.action = FIND_CONFIG[type].action;
        form.setAttribute('data-find-type', type);
      }
      document.querySelectorAll('[data-find-panel]').forEach(function (panel) {
        var on = panel.getAttribute('data-find-panel') === type;
        panel.classList.toggle('hidden', !on);
        setPanelInputsEnabled(panel, on);
      });
      document.querySelectorAll('.find-type-tab').forEach(function (tab) {
        var active = tab.getAttribute('data-find-type') === type;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.classList.toggle('border-brand-yellow', active);
        tab.classList.toggle('bg-brand-yellow', active);
        tab.classList.toggle('text-brand-dark', active);
        tab.classList.toggle('shadow-sm', active);
        tab.classList.toggle('border-brand-border/50', !active);
        tab.classList.toggle('bg-white', !active);
        tab.classList.toggle('dark:bg-slate-900', !active);
        tab.classList.toggle('text-brand-muted', !active);
      });
      var cfg = FIND_CONFIG[type];
      var title = document.getElementById('findStep2Title');
      var desc = document.getElementById('findStep2Desc');
      if (title) title.textContent = cfg.title;
      if (desc) desc.textContent = cfg.desc;
      var kw = document.getElementById('searchKeywordField');
      if (kw) kw.required = type === 'maps';
      var nightly = document.getElementById('findNightlyPrepForm');
      if (nightly) nightly.closest('.find-maps-only') && nightly.closest('.find-maps-only').classList.toggle('hidden', type !== 'maps');
      document.querySelectorAll('.find-maps-only').forEach(function (el) {
        el.classList.toggle('hidden', type !== 'maps');
      });
      syncFindPreview();
      updateSubmitLabel();
      syncFindLocationMode(type);
      if (history.replaceState) {
        var url = new URL(window.location.href);
        if (type === 'maps') url.searchParams.delete('type');
        else url.searchParams.set('type', type);
        history.replaceState({}, '', url.pathname + url.search);
      }
    }

    function updateSubmitLabel() {
      var mode = document.getElementById('searchModeInput');
      var isSched = mode && mode.value === 'schedule';
      if (typeof window.syncFindSubmitLabel === 'function') {
        window.syncFindSubmitLabel(isSched);
      }
    }

    var ARROW_SVG = '<svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>';
    var CAL_SVG = '<svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>';
    window.syncFindSubmitLabel = function (isSchedule) {
      var cfg = FIND_CONFIG[currentType];
      var searchBtnLabel = document.getElementById('searchBtnText');
      if (!searchBtnLabel || !cfg) return;
      searchBtnLabel.innerHTML = (isSchedule ? cfg.submitSched : cfg.submitRun) + (isSchedule ? CAL_SVG : ARROW_SVG);
    };

    function syncFindPreview() {
      var kw = document.getElementById('searchKeywordField');
      var reQ = document.getElementById('findReQuery');
      var city = document.getElementById('findManualCity');
      var state = document.getElementById('findManualState');
      var max = document.getElementById('findMaxResults');
      var line = document.getElementById('findSearchPreviewLine');
      var meta = document.getElementById('findSearchPreviewMeta');
      var loc = document.getElementById('findSearchPreviewLoc');
      var hint = document.getElementById('findStep1Hint');
      var summary = document.getElementById('findLocationSummaryText');
      var dir = document.querySelector('[data-find-panel="maps"] input[name="directorySupplement"]');
      if (!dir) dir = document.getElementById('findDirectorySupplement');
      var cfg = FIND_CONFIG[currentType] || FIND_CONFIG.maps;
      var k = '—';
      if (currentType === 'maps') {
        k = kw && kw.value.trim() ? kw.value.trim() : 'Your keyword';
      } else if (currentType === 'permits') {
        var catEl = document.getElementById('findPermitCategory');
        var catLabel = 'All categories';
        if (catEl && catEl.options && catEl.selectedIndex >= 0) {
          catLabel = catEl.options[catEl.selectedIndex].text;
        }
        k = catLabel === 'All categories' ? 'Building permits' : catLabel + ' permits';
        var kwEl = document.getElementById('findPermitKeyword');
        if (kwEl && kwEl.value.trim()) k += ' · ' + kwEl.value.trim();
      } else {
        var panel = document.querySelector('[data-find-panel="' + currentType + '"]');
        var qEl = panel && panel.querySelector('input[name="query"]');
        var qVal = qEl && qEl.value.trim ? qEl.value.trim() : '';
        k = qVal || (cfg.defaultQuery || 'listings');
      }
      var c = city && city.value.trim() ? city.value.trim() : '';
      var s = state && state.value.trim() ? state.value.trim().toUpperCase() : '';
      if (currentType === 'permits') {
        var pHidden = document.getElementById('findPermitCity');
        if (pHidden && pHidden.value) {
          c = pHidden.value;
          var pState = pHidden.getAttribute('data-state');
          if (pState) {
            s = String(pState).trim().toUpperCase();
          }
        }
      }
      var nationwide = !findTypeRequiresLocation(currentType);
      var locLabel = nationwide ? 'Nationwide' : (c || s ? (c + (c && s ? ', ' : '') + s) : '—');
      if (line) {
        if (nationwide) {
          line.innerHTML = '<span class="text-brand-dark dark:text-white">' + k + '</span> <span class="text-brand-muted font-semibold">· nationwide</span>';
        } else {
          line.innerHTML = '<span class="text-brand-dark dark:text-white">' + k + '</span> in <span class="text-brand-dark dark:text-white">' + locLabel + '</span>';
        }
      }
      if (loc) loc.textContent = locLabel;
      var permitLoc = document.getElementById('findPermitPreviewLoc');
      if (permitLoc) permitLoc.textContent = locLabel;
      if (hint) hint.textContent = nationwide ? 'No area needed' : (currentType === 'permits' ? 'Supported city' : (locLabel !== '—' ? locLabel : 'City or address'));
      if (summary) {
        summary.textContent = nationwide
          ? 'No location required — set search terms on the next step.'
          : currentType === 'permits'
            ? (locLabel !== '—' ? 'Searching permits in ' + locLabel : 'Select a supported Permit Stack city to continue.')
            : (locLabel !== '—' ? 'Searching in ' + locLabel : 'Enter a location above to continue.');
        summary.classList.toggle('text-brand-dark', nationwide || locLabel !== '—');
        summary.classList.toggle('dark:text-white', nationwide || locLabel !== '—');
        summary.classList.toggle('text-brand-muted', !nationwide && locLabel === '—');
      }
      if (meta && max) {
        var n = parseInt(max.value, 10) || 20;
        var extra = '';
        if (currentType === 'maps') {
          if (dir && dir.checked) extra += ' · directory supplement on';
          var mp = document.getElementById('findMapsProvider');
          if (mp && mp.value && mp.value !== 'auto') extra += ' · ' + mp.options[mp.selectedIndex].text;
        } else {
          var listPanel = document.querySelector('[data-find-panel="' + currentType + '"]');
          if (listPanel) {
            var srcCount = listPanel.querySelectorAll('[data-listing-source]:checked').length;
            if (srcCount) extra += ' · ' + srcCount + ' scraper' + (srcCount === 1 ? '' : 's');
            var minP = listPanel.querySelector('input[name="minPrice"]');
            var maxP = listPanel.querySelector('input[name="maxPrice"]');
            if ((minP && minP.value) || (maxP && maxP.value)) extra += ' · price filter';
          }
          if (currentType === 'real_estate') {
            var flipOn = document.getElementById('findFlipEnabled');
            if (flipOn && flipOn.checked) extra += ' · flip filter on';
            var scraperSel = document.getElementById('findReScraper');
            if (scraperSel && scraperSel.value && scraperSel.value !== 'listings') {
              extra += ' · ' + scraperSel.options[scraperSel.selectedIndex].text;
            }
          }
          if (currentType === 'permits') {
            var pZip = document.getElementById('findPermitZip');
            var pContractor = document.getElementById('findPermitContractor');
            var pFiled = document.getElementById('findPermitFiledAfter');
            if (pZip && pZip.value.trim()) extra += ' · ZIP ' + pZip.value.trim();
            if (pContractor && pContractor.value.trim()) extra += ' · contractor filter';
            if (pFiled && pFiled.value) extra += ' · filed after ' + pFiled.value;
          }
        }
        meta.textContent = 'Up to ' + n + ' ' + (cfg.previewLabel || 'results') + extra;
      }
    }

    document.querySelectorAll('.find-type-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        setFindType(tab.getAttribute('data-find-type'));
      });
    });

    ['searchKeywordField', 'findReQuery', 'findPermitCategory', 'findPermitCity', 'findPermitZip', 'findPermitKeyword', 'findPermitContractor', 'findPermitFiledAfter', 'findManualCity', 'findManualState', 'findLocationQuery', 'findMaxResults'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', syncFindPreview);
      if (el && el.tagName === 'SELECT') el.addEventListener('change', syncFindPreview);
    });
    var findLocQuery = document.getElementById('findLocationQuery');
    var findLocResolveBtn = document.getElementById('findLocationResolveBtn');
    if (findLocResolveBtn) findLocResolveBtn.addEventListener('click', function () { resolveFindLocationFromQuery(); });
    if (findLocQuery) {
      findLocQuery.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          resolveFindLocationFromQuery();
        }
      });
    }
    var openMapBtn = document.getElementById('findOpenMapBtn');
    var closeMapBtn = document.getElementById('findCloseMapBtn');
    if (openMapBtn) openMapBtn.addEventListener('click', openFindAreaMapPanel);
    if (closeMapBtn) closeMapBtn.addEventListener('click', closeFindAreaMapPanel);
    window.resolveFindLocationFromQuery = resolveFindLocationFromQuery;
    var permitCitySel = document.getElementById('findPermitCity');
    if (permitCitySel) {
      permitCitySel.addEventListener('change', function () {
        syncPermitCityToManual();
        syncFindPreview();
        document.dispatchEvent(new CustomEvent('find:locationUpdated'));
      });
    }
    document.querySelectorAll('[data-find-panel] input[name="query"]').forEach(function (el) {
      el.addEventListener('input', syncFindPreview);
    });
    document.querySelectorAll('[data-listing-source]').forEach(function (el) {
      el.addEventListener('change', syncFindPreview);
    });
    var dirCb = document.getElementById('findDirectorySupplement');
    if (dirCb) dirCb.addEventListener('change', syncFindPreview);
    document.addEventListener('find:locationUpdated', syncFindPreview);

    var flipCb = document.getElementById('findFlipEnabled');
    var flipOpts = document.getElementById('findFlipOptions');
    function syncFlip() {
      if (flipOpts && flipCb) flipOpts.classList.toggle('hidden', !flipCb.checked);
    }
    if (flipCb) flipCb.addEventListener('change', syncFlip);
    syncFlip();

    var modeInput = document.getElementById('searchModeInput');
    if (modeInput) modeInput.addEventListener('change', updateSubmitLabel);
    document.getElementById('modeRunNow') && document.getElementById('modeRunNow').addEventListener('click', function () { setTimeout(updateSubmitLabel, 0); });
    document.getElementById('modeSchedule') && document.getElementById('modeSchedule').addEventListener('click', function () { setTimeout(updateSubmitLabel, 0); });

    if (form) {
      form.addEventListener('submit', function () {
        if (currentType === 'permits') syncPermitCityToManual();
        document.querySelectorAll('[data-find-panel].hidden').forEach(function (panel) {
          setPanelInputsEnabled(panel, false);
        });
      });
    }

    setFindType(currentType);
    applyFolderSearchPreset();
    lockFindTypeWhenFolderPreset();
  })();
  </script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
