<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/navbar') %>

  <!-- Main content offset by sidebar width -->
  <div class="ml-56 min-h-screen flex flex-col">

    <!-- Top filter bar -->
    <div class="bg-white border-b border-gray-200 px-8 py-4">
      <form action="/search" method="POST" id="searchForm">
        <div class="flex items-end gap-4">
          <div class="flex-1">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Keyword</label>
            <input type="text" name="keyword" required
              placeholder="e.g. plumber, dentist"
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent">
          </div>
          <div class="flex-1">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">City</label>
            <input type="text" name="city" required
              placeholder="e.g. Austin"
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent">
          </div>
          <div class="w-32">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">State</label>
            <input type="text" name="state" required
              placeholder="e.g. TX"
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent">
          </div>
          <div class="w-28">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Max Results</label>
            <input type="number" name="maxResults" value="20" min="1" max="100"
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent">
          </div>
          <button type="submit" id="searchBtn"
            class="px-5 py-2 bg-sidebar text-white rounded-lg text-sm font-medium hover:bg-sidebar-active transition-colors whitespace-nowrap flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Find my leads
          </button>
        </div>
      </form>
    </div>

    <!-- Loading indicator -->
    <div id="loadingIndicator" class="hidden px-8 py-6">
      <div class="flex items-center gap-3 text-gray-500">
        <div class="animate-spin rounded-full h-5 w-5 border-2 border-gray-300 border-t-accent"></div>
        <span class="text-sm">Searching Google Maps... This may take a minute or two.</span>
      </div>
    </div>

    <!-- Empty state / welcome -->
    <div class="flex-1 flex items-center justify-center px-8">
      <div class="text-center max-w-md">
        <div class="w-16 h-16 bg-accent-light rounded-2xl flex items-center justify-center mx-auto mb-5">
          <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-800 mb-2">Find business leads on Google Maps</h2>
        <p class="text-gray-500 text-sm leading-relaxed">
          Enter a business keyword and location above to scrape leads from Google Maps.
          Results will include company names, phone numbers, websites, ratings, and more.
        </p>
        <div class="mt-6 flex items-center justify-center gap-6 text-xs text-gray-400">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            Phone numbers
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
            Websites
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
            Ratings & reviews
          </div>
        </div>
      </div>
    </div>

  </div>

  <script src="/js/app.js"></script>
</body>
</html>
