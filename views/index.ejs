                  </div>
                </div>
                <input type="hidden" name="mode" id="searchModeInput" value="run" />
                <input type="hidden" name="timezone" id="userTimezone" />
                <div id="scheduledSearchSettings" class="hidden space-y-4 pt-2 border-t border-brand-border/30 dark:border-white/10">
                  <%- include('partials/schedule_run_options', { schedulePrefix: 'findSchedule' }) %>
                  <label class="inline-flex items-center gap-2 text-sm">
                    <input type="checkbox" name="runNowAlso" id="runNowAlso" class="rounded border-brand-border" />
