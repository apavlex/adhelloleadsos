<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden dm-studio-page">
  <%- include('partials/navbar') %>

  <main class="dm-studio-root">
    <div id="dmStudioShell" class="dm-studio-shell">
    <!-- Studio top bar -->
    <header class="dm-studio-topbar">
      <div class="dm-studio-topbar-start">
        <div>
          <p class="dm-studio-eyebrow">Outreach · Creative studio</p>
          <div class="page-heading-with-tip flex items-center gap-2 flex-wrap">
            <h1 class="dm-studio-title"><% if (typeof dmIsSelectionSession !== 'undefined' && dmIsSelectionSession) { %>Mail <%= typeof dmSelectionCount === 'number' ? dmSelectionCount : mailableLeads.length %> selected<% } else { %>Marketing Studio<% } %></h1>
            <%- include('/partials/app_info_tip', {
              tipId: 'direct-mail-help',
              tipKey: 'direct-mail',
              label: 'Direct mail overview',
              size: 'md',
              wide: true,
              content: (typeof dmIsSelectionSession !== 'undefined' && dmIsSelectionSession)
                ? ('From your pipeline selection — design a postcard, pick mailable leads below, then send via Lob.' + ((typeof dmSkippedCount === 'number' && dmSkippedCount > 0) ? ' <span class="text-amber-700 dark:text-amber-300 font-semibold">' + dmSkippedCount + ' lead' + (dmSkippedCount === 1 ? '' : 's') + ' skipped (incomplete address).</span>' : ''))
                : 'Send 4×6 postcards to leads with a mailable address via <a href="https://www.lob.com/" target="_blank" rel="noopener noreferrer" class="text-brand-yellow hover:underline">Lob.com</a>. Upload custom PDF designs in <a href="/workspace/integrations/lob-setup" class="text-brand-yellow hover:underline">Workspace → Lob design guide</a>. Test keys print in Lob’s test mode — no postage charged.'
            }) %>
          </div>
        </div>
        <span id="dmStudioFormatPill" class="dm-studio-format-pill">4×6 Postcard</span>
      </div>
      <div class="dm-studio-topbar-end">
        <button type="button" id="dmFullscreenBtn" class="dm-studio-topbtn dm-fullscreen-btn" aria-pressed="false" title="Full screen studio">
          <svg class="dm-fs-icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
          <svg class="dm-fs-icon-compress hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" /></svg>
          <span class="dm-fullscreen-label">Full screen</span>
        </button>
        <% if (!kieImageReady) { %>
        <span class="dm-studio-badge dm-studio-badge--warn">KIE key not set</span>
        <% } else { %>
        <span class="dm-studio-badge dm-studio-badge--ok">GPT Image 2 ready</span>
        <% } %>
        <a href="/workspace/integrations/lob-setup" class="dm-studio-topbtn">Design guide</a>
        <a href="/prospecting?tab=pipeline&amp;reach=direct_mail#tableView" class="dm-studio-topbtn">Pipeline</a>
        <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
        <a href="/workspace/integrations#lob-integration" class="dm-studio-topbtn dm-studio-topbtn--primary">Lob settings</a>
        <% } %>
      </div>
    </header>

    <div id="lobStatusBanner" class="dm-lob-banner <%= lobReady.configured ? 'dm-lob-banner--ok' : 'dm-lob-banner--warn' %>">
      <% if (lobReady.configured) { %>
      <span class="dm-lob-dot"></span>
      <p class="dm-lob-text">Lob connected<%= lobReady.testMode ? ' · test mode' : ' · live' %> — <% if (typeof dmIsSelectionSession !== 'undefined' && dmIsSelectionSession) { %><%= typeof dmMailableCount === 'number' ? dmMailableCount : mailableLeads.length %> of <%= typeof dmSelectionCount === 'number' ? dmSelectionCount : mailableLeads.length %> selected lead<%= (typeof dmSelectionCount === 'number' ? dmSelectionCount : mailableLeads.length) === 1 ? '' : 's' %> ready.<% } else { %><%= mailableLeads.filter(function (l) { return l.mailable !== false; }).length %> mailable lead<%= mailableLeads.filter(function (l) { return l.mailable !== false; }).length === 1 ? '' : 's' %>.<% } %><% if (lobReady.hasCustomPostcard) { %> Using your uploaded PDFs.<% } else { %> Built-in template — <a href="/workspace/integrations#lob-integration" class="text-brand-yellow hover:underline">upload PDFs</a> for branded mail.<% } %></p>
      <% } else { %>
      <p class="dm-lob-text"><strong>Lob not configured</strong> — Add API key under <a href="/workspace/integrations#lob-integration" class="text-brand-yellow hover:underline">Integrations</a>.</p>
      <% } %>
    </div>

    <!-- Canva-style workspace -->
    <section class="dm-studio" id="dmStudio" aria-label="Design studio">
      <nav class="dm-studio-rail" aria-label="Studio tools">
        <button type="button" class="dm-rail-btn is-active" data-dm-tab="formats" title="Formats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span>Formats</span>
        </button>
        <button type="button" class="dm-rail-btn" data-dm-tab="brand" title="Brand kit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
          <span>Brand</span>
        </button>
        <button type="button" class="dm-rail-btn" data-dm-tab="copy" title="Postcard copy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h14"/></svg>
          <span>Copy</span>
        </button>
        <button type="button" class="dm-rail-btn" data-dm-tab="library" title="Saved designs">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
          <span>Saved</span>
        </button>
      </nav>

      <aside class="dm-studio-drawer">
        <!-- Formats panel -->
        <div class="dm-drawer-panel is-active" data-dm-panel="formats">
          <h2 class="dm-drawer-title">Choose a format</h2>
          <p class="dm-drawer-desc">Pick a canvas size for ads, social, or direct mail.</p>
          <div class="dm-format-grid" role="listbox" aria-label="Platform format">
            <% var dmFormats = [
              { id: 'postcard', label: 'Postcard', sub: '4×6 · 2:3', icon: 'postcard' },
              { id: 'instagram_feed', label: 'Instagram', sub: 'Feed · 1:1', icon: 'ig' },
              { id: 'instagram_story', label: 'Story', sub: '9:16 vertical', icon: 'story' },
              { id: 'instagram_portrait', label: 'IG Portrait', sub: '4:5', icon: 'portrait' },
              { id: 'facebook_feed', label: 'Facebook', sub: 'Feed · 1:1', icon: 'fb' },
              { id: 'facebook_cover', label: 'FB Cover', sub: '16:9 wide', icon: 'cover' },
              { id: 'facebook_story', label: 'FB Story', sub: '9:16', icon: 'story' },
              { id: 'linkedin_post', label: 'LinkedIn', sub: 'Post · 1:1', icon: 'linkedin' },
              { id: 'linkedin_banner', label: 'LI Banner', sub: '16:9', icon: 'banner' },
              { id: 'google_display', label: 'Display', sub: 'Google · 16:9', icon: 'display' },
              { id: 'youtube_thumb', label: 'YouTube', sub: 'Thumbnail', icon: 'youtube' },
              { id: 'custom', label: 'Custom', sub: 'Any ratio', icon: 'custom' }
            ]; %>
            <% dmFormats.forEach(function (f) { %>
            <button type="button" class="dm-format-card<%= f.id === 'postcard' ? ' is-selected' : '' %>" data-dm-platform="<%= f.id %>" role="option">
              <span class="dm-format-icon" aria-hidden="true"><%- include('/partials/dm_format_icon', { icon: f.icon }) %></span>
              <span class="dm-format-label"><%= f.label %></span>
              <span class="dm-format-sub"><%= f.sub %></span>
            </button>
            <% }) %>
          </div>
          <select id="dmPlatform" class="sr-only" aria-hidden="true" tabindex="-1">
            <option value="postcard" selected>4×6 Postcard</option>
            <option value="instagram_feed">Instagram Feed</option>
            <option value="instagram_story">Instagram Story / Reels</option>
            <option value="instagram_portrait">Instagram Portrait</option>
            <option value="facebook_feed">Facebook Feed</option>
            <option value="facebook_cover">Facebook Cover</option>
            <option value="facebook_story">Facebook Story</option>
            <option value="linkedin_post">LinkedIn Post</option>
            <option value="linkedin_banner">LinkedIn Banner</option>
            <option value="google_display">Google Display</option>
            <option value="youtube_thumb">YouTube Thumbnail</option>
            <option value="custom">Custom ratio</option>
          </select>
          <div class="dm-drawer-settings">
            <label class="dm-field-label" for="dmAspectRatio">Aspect ratio</label>
            <select id="dmAspectRatio" class="dm-select">
              <option value="2:3" selected>2:3 (4×6 postcard)</option>
              <option value="3:2">3:2 (landscape)</option>
              <option value="1:1">1:1 (square)</option>
              <option value="4:5">4:5 (portrait)</option>
              <option value="9:16">9:16 (story / reels)</option>
              <option value="16:9">16:9 (wide)</option>
              <option value="auto">Auto</option>
            </select>
            <label class="dm-field-label" for="dmResolution">Export quality</label>
            <select id="dmResolution" class="dm-select">
              <option value="1K">1K</option>
              <option value="2K" selected>2K</option>
              <option value="4K">4K</option>
            </select>
            <span id="dmSideWrap" class="dm-side-wrap">
              <label class="dm-field-label" for="dmDesignSlot">Active page</label>
              <select id="dmDesignSlot" class="dm-select">
                <option value="front">Front (main creative)</option>
                <option value="back">Back (minimal / return)</option>
              </select>
            </span>
          </div>
        </div>

        <!-- Brand panel -->
        <div class="dm-drawer-panel" data-dm-panel="brand" hidden>
          <h2 class="dm-drawer-title">Brand kit</h2>
          <p class="dm-drawer-desc">Business details included in AI prompts and on generated ads.</p>
          <div class="dm-brand-form">
            <label class="dm-field-label" for="dmBrandName">Business name</label>
            <input id="dmBrandName" type="text" class="dm-brand-field dm-input" placeholder="Acme Plumbing LLC" value="<%= (brandKit && brandKit.businessName) || '' %>" />
            <label class="dm-field-label" for="dmBrandPhone">Phone</label>
            <input id="dmBrandPhone" type="tel" class="dm-brand-field dm-input" placeholder="(555) 123-4567" value="<%= (brandKit && brandKit.phone) || '' %>" />
            <label class="dm-field-label" for="dmBrandEmail">Email</label>
            <input id="dmBrandEmail" type="email" class="dm-brand-field dm-input" placeholder="hello@business.com" value="<%= (brandKit && brandKit.email) || '' %>" />
            <label class="dm-field-label" for="dmBrandWebsite">Website</label>
            <input id="dmBrandWebsite" type="url" class="dm-brand-field dm-input" placeholder="https://business.com" value="<%= (brandKit && brandKit.website) || '' %>" />
            <label class="dm-field-label" for="dmBrandAddress">Address</label>
            <input id="dmBrandAddress" type="text" class="dm-brand-field dm-input" placeholder="123 Main St, Portland, OR" value="<%= (brandKit && brandKit.address) || '' %>" />
            <label class="dm-field-label" for="dmBrandHours">Business hours</label>
            <input id="dmBrandHours" type="text" class="dm-brand-field dm-input" placeholder="Mon–Fri 8am–6pm" value="<%= (brandKit && brandKit.hours) || '' %>" />
            <div class="dm-brand-logo-row">
              <div id="dmBrandLogoPreview" class="dm-brand-logo-preview">
                <% if (brandKit && brandKit.logoUrl) { %>
                <img src="<%= brandKit.logoUrl %>" alt="Business logo" />
                <% } else { %>
                <span>No logo</span>
                <% } %>
              </div>
              <div class="dm-brand-logo-actions">
                <label class="dm-studio-topbtn cursor-pointer">
                  Upload logo
                  <input type="file" id="dmBrandLogoInput" accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml" class="hidden" />
                </label>
                <label class="dm-check-row">
                  <input type="checkbox" id="dmBrandUseLogo" <%= (!brandKit || brandKit.useLogoInDesign !== false) ? 'checked' : '' %> />
                  Use logo in AI designs
                </label>
                <button type="button" id="dmBrandSaveBtn" class="dm-studio-topbtn dm-studio-topbtn--primary w-full justify-center">Save brand kit</button>
                <p id="dmBrandSaveStatus" class="dm-brand-save-status" aria-live="polite"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Copy panel -->
        <div class="dm-drawer-panel" data-dm-panel="copy" hidden>
          <h2 class="dm-drawer-title">Postcard copy</h2>
          <p class="dm-drawer-desc">Merge tokens: <code>{business}</code> <code>{city}</code> <code>{state}</code> <code>{audit_url}</code></p>
          <p id="dmMergePreview" class="dm-merge-preview" aria-live="polite"></p>
          <label class="dm-field-label" for="dmHeadline">Headline</label>
          <input id="dmHeadline" type="text" class="dm-input dm-merge-field" placeholder="Your new website is ready, {business}" />
          <label class="dm-field-label" for="dmBody">Body</label>
          <textarea id="dmBody" rows="4" class="dm-input dm-merge-field resize-y" placeholder="We built a custom preview for {business} in {city}."></textarea>
          <label class="dm-field-label" for="dmCtaUrl">Audit / landing URL <span class="font-normal normal-case tracking-normal">(optional)</span></label>
          <input id="dmCtaUrl" type="text" class="dm-input dm-merge-field" placeholder="Leave blank or use {audit_url} per lead" autocomplete="off" />
          <p class="text-[11px] text-brand-muted mt-1 leading-relaxed">Omit for brand-only postcards, or use <code>{audit_url}</code> to pull each lead&apos;s audit link at send time.</p>
          <label class="dm-check-row mt-2">
            <input type="checkbox" id="dmPersonalizeOverlay" checked />
            <span><strong>Personalize at send</strong> — overlay headline and copy on generated art per lead.</span>
          </label>
        </div>

        <!-- Library panel -->
        <div class="dm-drawer-panel" data-dm-panel="library" hidden>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="dm-drawer-title mb-0">Saved designs</h2>
            <span id="dmSavedCount" class="text-[11px] text-brand-muted">0 saved</span>
          </div>
          <p class="dm-drawer-desc">Reuse generated front or back art — filtered by the active canvas page.</p>
          <div id="dmSavedLibraryFilter" class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-2 hidden">Showing: Front</div>
          <div id="dmSavedLibrary" class="dm-saved-library">
            <p class="text-[11px] text-brand-muted col-span-full">Save a generated design from the canvas toolbar.</p>
          </div>
        </div>
      </aside>

      <!-- Center canvas -->
      <div class="dm-studio-stage">
        <div class="dm-stage-toolbar">
          <div class="dm-page-tabs" id="dmPageTabs" role="tablist">
            <button type="button" class="dm-page-tab is-active" data-dm-page="front" role="tab" aria-selected="true">Front</button>
            <button type="button" class="dm-page-tab" data-dm-page="back" role="tab" aria-selected="false">Back</button>
          </div>
          <div class="dm-stage-toolbar-center">
            <span id="dmPreviewHint" class="dm-stage-hint">Design your creative — describe it below and hit Generate.</span>
          </div>
          <div class="dm-stage-toolbar-end">
            <button type="button" id="dmFullscreenBtnCanvas" class="dm-zoom-btn dm-fullscreen-btn-canvas" title="Full screen studio" aria-label="Full screen studio">
              <svg class="dm-fs-icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
              <svg class="dm-fs-icon-compress hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" /></svg>
            </button>
            <div class="dm-zoom-controls" aria-label="Canvas zoom">
              <button type="button" class="dm-zoom-btn" id="dmZoomOut" title="Zoom out">−</button>
              <span id="dmZoomLabel" class="dm-zoom-label">100%</span>
              <button type="button" class="dm-zoom-btn" id="dmZoomIn" title="Zoom in">+</button>
              <button type="button" class="dm-zoom-btn" id="dmZoomFit" title="Fit to view">Fit</button>
            </div>
          </div>
        </div>

        <div class="dm-canvas-viewport" id="dmCanvasViewport">
          <div class="dm-canvas-scaler" id="dmCanvasScaler" style="--dm-zoom: 1">
            <div class="dm-artboard-wrap">
              <button type="button" id="dmPreviewFrontBtn" class="dm-artboard dm-preview-btn is-active-page" style="aspect-ratio:2/3" data-slot="front" aria-label="Front design">
                <div id="dmPreviewFront" class="dm-artboard-inner">
                  <span class="dm-artboard-empty">No front yet — describe your design and generate</span>
                </div>
                <span class="dm-artboard-badge">Front</span>
                <span class="dm-preview-zoom-badge">Click to zoom in</span>
              </button>
              <button type="button" id="dmPreviewBackBtn" class="dm-artboard dm-preview-btn dm-artboard--back" style="aspect-ratio:2/3" data-slot="back" aria-label="Back design" hidden>
                <div id="dmPreviewBack" class="dm-artboard-inner">
                  <span class="dm-artboard-empty">No back yet</span>
                </div>
                <span class="dm-artboard-badge">Back</span>
                <span class="dm-preview-zoom-badge">Click to zoom in</span>
              </button>
            </div>
          </div>
        </div>

        <div class="dm-artboard-actions">
          <div id="dmPreviewFrontCol" class="dm-page-actions">
            <label class="dm-check-row">
              <input type="checkbox" id="dmUseFront" disabled />
              Use front on send
            </label>
            <button type="button" id="dmSaveFront" class="dm-text-btn hidden" data-slot="front">Save to library</button>
          </div>
          <div id="dmPreviewBackCol" class="dm-page-actions" hidden>
            <label class="dm-check-row">
              <input type="checkbox" id="dmUseBack" disabled />
              Use back on send
            </label>
            <button type="button" id="dmSaveBack" class="dm-text-btn hidden" data-slot="back">Save to library</button>
          </div>
        </div>

        <!-- Magic Design prompt bar -->
        <div class="dm-prompt-resizer" id="dmPromptResizer" role="separator" aria-orientation="horizontal" aria-label="Drag to resize chat panel" title="Drag to resize chat"></div>
        <div class="dm-prompt-dock" id="dmPromptDock">
          <div id="dmChatLog" class="dm-chat-log custom-scrollbar" aria-live="polite">
            <div class="dm-chat-welcome">
              <strong>AI design assistant</strong> — Pick a format, describe the look you want, then Generate. Chat refines the prompt before image creation.
            </div>
          </div>
          <div class="dm-prompt-row">
            <textarea id="dmChatInput" rows="1" class="dm-prompt-input" placeholder="Describe your ad… e.g. Warm bakery postcard, golden hour photo, bold headline, navy + cream brand colors" <%= kieImageReady ? '' : 'disabled' %>></textarea>
            <button type="button" id="dmChatSend" class="dm-prompt-btn" <%= kieImageReady ? '' : 'disabled' %>>Chat</button>
            <button type="button" id="dmGenerateBtn" class="dm-prompt-btn dm-prompt-btn--primary" <%= kieImageReady ? '' : 'disabled' %>>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>
              Generate
            </button>
          </div>
          <p id="dmDesignStatus" class="dm-design-status hidden" aria-live="polite"></p>
        </div>
      </div>

      <!-- Right inspector: prompt editor -->
      <aside class="dm-studio-inspector">
        <h2 class="dm-drawer-title">Prompt &amp; refine</h2>
        <p class="dm-drawer-desc">Edit the GPT Image 2 prompt, then regenerate.</p>
        <div id="dmPromptEditorWrap" class="dm-prompt-editor-wrap">
          <div class="flex items-center justify-between gap-2 mb-2">
            <label for="dmPromptEditor" class="dm-field-label mb-0">Image prompt</label>
            <span id="dmPromptEditorSlot" class="dm-slot-badge">Front</span>
          </div>
          <textarea id="dmPromptEditor" rows="8" class="dm-input dm-prompt-editor" placeholder="The full image generation prompt appears here after Chat or Generate…"></textarea>
          <div class="flex flex-wrap gap-2 mt-2">
            <button type="button" id="dmPromptApply" class="dm-studio-topbtn">Use prompt</button>
            <button type="button" id="dmPromptRegenerate" class="dm-studio-topbtn dm-studio-topbtn--primary">Regenerate</button>
          </div>
        </div>
        <div id="dmExportActions" class="dm-export-actions mt-4 hidden">
          <p class="text-[11px] font-bold uppercase tracking-widest text-brand-muted mb-2">Export current side</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="dmDownloadBtn" class="dm-studio-topbtn">Download to computer</button>
            <button type="button" id="dmDriveSaveBtn" class="dm-studio-topbtn">Save to Google Drive</button>
          </div>
          <p id="dmExportStatus" class="text-[11px] text-brand-muted mt-2 hidden" aria-live="polite"></p>
        </div>
        <div class="dm-inspector-tips">
          <p class="text-[11px] font-bold uppercase tracking-widest text-brand-muted mb-2">Tips</p>
          <ul class="text-[11px] text-brand-muted space-y-1.5 leading-relaxed">
            <li>Fill in <strong>Brand</strong> for phone, logo, and hours on ads.</li>
            <li>Use <strong>Chat</strong> to iterate; <strong>Generate</strong> creates the image.</li>
            <li>Postcard mode supports front + back pages.</li>
          </ul>
        </div>
      </aside>
    </section>
    </div><!-- /dmStudioShell -->

    <!-- Hidden grid compat for JS -->
    <div id="dmPreviewGrid" class="hidden" aria-hidden="true"></div>

    <!-- Send workflow (below studio) -->
    <section class="dm-workflow-section">
      <details class="dm-workflow-details" open>
        <summary class="dm-workflow-summary">
          <span>Recent sends</span>
          <span class="text-brand-muted font-normal normal-case tracking-normal text-xs"><%= recentSends.length ? recentSends.length + ' campaign' + (recentSends.length === 1 ? '' : 's') : 'None yet' %></span>
        </summary>
        <div class="brand-card p-5 dark:bg-slate-900 dark:border-white/10 mt-2">
          <% if (!recentSends.length) { %>
          <p class="text-sm text-brand-muted">No postcards sent yet.</p>
          <% } else { %>
          <ul class="space-y-3 max-h-48 overflow-y-auto custom-scrollbar">
            <% recentSends.forEach(function (s) { %>
            <li class="text-sm border-b border-brand-border/20 dark:border-white/10 pb-2">
              <p class="font-semibold text-brand-dark dark:text-white truncate"><%= s.title %></p>
              <p class="text-[11px] text-brand-muted mt-0.5"><%= s.message %></p>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>
      </details>

      <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10 mt-6">
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-brand-border/25 dark:border-white/10">
          <div>
            <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white"><% if (typeof dmIsSelectionSession !== 'undefined' && dmIsSelectionSession) { %>Selected leads<% } else if (typeof dmIsQueueSession !== 'undefined' && dmIsQueueSession) { %>Direct Mail queue<% } else { %>Mailable leads<% } %></h2>
            <p class="text-xs text-brand-muted mt-0.5"><% if (typeof dmIsSelectionSession !== 'undefined' && dmIsSelectionSession) { %>Mailable rows are pre-selected. Fix or enrich others in pipeline.<% } else if (typeof dmIsQueueSession !== 'undefined' && dmIsQueueSession) { %>Select rows to move to folders, tag, remove from queue, or delete.<% } else { %>Street address, city, state, and ZIP required.<% } %></p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" id="dmSelectAll" class="btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/15 text-[10px] font-black uppercase tracking-widest px-3 py-2">Select all</button>
            <button type="button" id="dmSendBtn" class="btn-pill btn-primary text-[10px] font-black uppercase tracking-widest px-4 py-2.5 disabled:opacity-50" <%= lobReady.configured ? '' : 'disabled' %>>Send postcards</button>
          </div>
        </div>
        <p id="dmStatus" class="hidden px-5 py-2 text-xs font-semibold" aria-live="polite"></p>
        <% if (!mailableLeads.length) { %>
        <div class="p-10 text-center text-brand-muted text-sm"><% if (typeof dmQueueEmpty !== 'undefined' && dmQueueEmpty) { %>No leads in your Direct Mail queue yet. In Focus or the dialer <strong>Mail</strong> tab, tap <strong>+ Add current lead</strong>, or tag leads with <em>Direct Mail List</em> in the pipeline.<% } else { %>No leads with a complete mailable address. Enrich leads or import addresses from search results.<% } %></div>
        <% } else { %>
        <div class="overflow-x-auto">
          <table id="dmLeadsTable" class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-brand-border/30 dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-muted">
                <th class="pl-5 pr-2 py-3 w-12"><input type="checkbox" id="dmCheckAll" class="rounded border-brand-border" aria-label="Select all" /></th>
                <th class="px-2 py-3">Company</th>
                <th class="px-2 py-3">Address</th>
                <th class="px-2 py-3">City</th>
                <th class="px-2 py-3">State</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/15 dark:divide-white/10">
              <% mailableLeads.forEach(function (l) { %>
              <tr class="result-row hover:bg-brand-cream/20 dark:hover:bg-white/[0.03]<%= l.mailable === false ? ' opacity-50' : '' %>" data-lead-key="<%= l.key %>" data-mailable="<%= l.mailable !== false ? '1' : '0' %>" data-business="<%= (l.title || '').replace(/"/g, '&quot;') %>" data-city="<%= (l.city || '').replace(/"/g, '&quot;') %>" data-state="<%= (l.state || '').replace(/"/g, '&quot;') %>" data-audit-url="<%= (l.stitchDesignUrl || l.stitchScreenshotUrl || (l.website && l.website !== 'N/A' ? l.website : '') || '').replace(/"/g, '&quot;') %>">
                <td class="pl-5 pr-2 py-3 align-middle"><input type="checkbox" class="dm-lead-check rounded border-brand-border" value="<%= l.key %>" aria-label="Select <%= l.title %>"<% if (l.preselected && l.mailable !== false) { %> checked<% } %> /></td>
                <td class="px-2 py-3 font-semibold text-brand-dark dark:text-white"><%= l.title %><% if (l.mailable === false) { %> <span class="ml-1 text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-300">No address</span><% } %></td>
                <td class="px-2 py-3 text-brand-muted max-w-[14rem] truncate" title="<%= l.address %>"><%= l.address || '—' %></td>
                <td class="px-2 py-3 text-brand-muted"><%= l.city || '—' %></td>
                <td class="px-2 py-3 text-brand-muted"><%= l.state || '—' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('partials/dm_bulk_action_bar') %>

  <div id="dmImageLightbox" class="dm-lightbox hidden fixed inset-0 z-[500] flex items-center justify-center p-4 md:p-8" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Postcard preview">
    <button type="button" id="dmLightboxBackdrop" class="absolute inset-0 bg-brand-dark/80 backdrop-blur-sm" aria-label="Close preview"></button>
    <div class="dm-lightbox-panel relative z-10 w-full max-w-3xl max-h-[92vh] flex flex-col rounded-2xl border border-white/10 bg-white dark:bg-slate-900 shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-brand-border/20 dark:border-white/10">
        <div>
          <p id="dmLightboxTitle" class="text-sm font-bold text-brand-dark dark:text-white">Postcard preview</p>
          <p id="dmLightboxMeta" class="text-[11px] text-brand-muted mt-0.5"></p>
        </div>
        <button type="button" id="dmLightboxClose" class="rounded-full w-9 h-9 flex items-center justify-center border border-brand-border/40 dark:border-white/15 text-brand-muted hover:text-brand-dark dark:hover:text-white" aria-label="Close">✕</button>
      </div>
      <div class="flex-1 min-h-0 overflow-auto custom-scrollbar p-4 bg-brand-cream/20 dark:bg-slate-950/40 flex items-center justify-center">
        <img id="dmLightboxImg" src="" alt="Postcard design preview" class="max-w-full max-h-[min(70vh,720px)] w-auto h-auto rounded-lg shadow-lg object-contain" />
      </div>
      <div class="flex flex-wrap gap-2 px-4 py-3 border-t border-brand-border/20 dark:border-white/10 bg-white/95 dark:bg-slate-900/95">
        <button type="button" id="dmLightboxSave" class="btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/15 text-[10px] font-black uppercase tracking-widest px-3 py-2">Save for later</button>
        <button type="button" id="dmLightboxDownload" class="btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/15 text-[10px] font-black uppercase tracking-widest px-3 py-2">Download</button>
        <button type="button" id="dmLightboxDrive" class="btn-pill bg-white dark:bg-slate-800 border border-brand-border dark:border-white/15 text-[10px] font-black uppercase tracking-widest px-3 py-2">Save to Drive</button>
        <button type="button" id="dmLightboxEditPrompt" class="btn-pill btn-primary text-[10px] font-black uppercase tracking-widest px-3 py-2 ml-auto">Edit prompt</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="dm-brand-kit-json"><%- typeof brandKitJson !== 'undefined' ? brandKitJson : '{}' %></script>
  <script type="application/json" id="dm-workspace-tags-json"><%- JSON.stringify((typeof tags !== 'undefined' && tags ? tags : []).map(function (t) { return { key: t.key, name: t.name, color: t.color || '#94a3b8' }; })) %></script>
  <script>
    window.__DM_QUEUE = {
      isQueueSession: <%= typeof dmIsQueueSession !== 'undefined' && dmIsQueueSession ? 'true' : 'false' %>,
      tagKey: <%= JSON.stringify(typeof dmQueueTagKey !== 'undefined' ? dmQueueTagKey : '') %>,
      folderKey: <%= JSON.stringify(typeof dmQueueFolderKey !== 'undefined' ? dmQueueFolderKey : '') %>,
    };
  </script>
  <script src="/js/direct-mail.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
  <%- include('/partials/app_shell_close') %>
</body>
</html>
