    function webParts(website) {
      var web = String(website || '').trim();
      if (!web || web === '[object Object]') return { href: '', label: '' };
      var lower = web.toLowerCase();
      var href = web;
      if (lower.indexOf('http://') !== 0 && lower.indexOf('https://') !== 0) {
        href = 'https://' + web;
      }
      var label = web;
      var schemeAt = label.indexOf('://');
      if (schemeAt >= 0) label = label.slice(schemeAt + 3);
      while (label.length > 1 && label.charAt(label.length - 1) === '/') {
        label = label.slice(0, -1);
      }
      return { href: href, label: label };
    }
