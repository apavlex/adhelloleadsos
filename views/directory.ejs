        var body = Object.fromEntries(fd.entries());
        ['showPhone', 'showWebsite', 'showAddress', 'showRating', 'showReviews'].forEach(function (k) {
          body[k] = fd.get(k) ? '1' : '0';
        });
        say('Saving…');
        postJson('/directory/settings', body)
          .then(function () { window.location.href = '/directory?ok=saved'; })
          .catch(function (err) { say(err.message || 'Save failed', false); });
      });
    }
    var rotateBtn = document.getElementById('dirRotateToken');
    if (rotateBtn && settingsForm) {
      rotateBtn.addEventListener('click', function () {
        if (!window.confirm('Rotate the publish token? Existing AI Studio pages must be updated with the new feed URLs.')) return;
        var fd = new FormData(settingsForm);
        var body = Object.fromEntries(fd.entries());
        body.rotate_token = '1';
        ['showPhone', 'showWebsite', 'showAddress', 'showRating', 'showReviews'].forEach(function (k) {
          body[k] = fd.get(k) ? '1' : '0';
        });
        say('Rotating token…');
        postJson('/directory/settings', body)
          .then(function () { window.location.href = '/directory?ok=saved'; })
          .catch(function (err) { say(err.message || 'Rotate failed', false); });
      });
    }

    var addForm = document.getElementById('dirAddForm');
    if (addForm) {
      addForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(addForm);
        say('Adding…');
        postJson('/directory/listings', { leadKey: fd.get('leadKey'), published: true })
          .then(function () { window.location.href = '/directory?ok=added'; })
          .catch(function (err) { say(err.message || 'Add failed', false); });
      });
    }

    document.addEventListener('change', function (e) {
      if (e.target && (e.target.id === 'dirSelectAll' || e.target.classList.contains('dir-select'))) {
        if (e.target.id === 'dirSelectAll') {
          var on = !!e.target.checked;
          document.querySelectorAll('.dir-select').forEach(function (el) { el.checked = on; });
        }
        syncBulkBar();
      }
    });
    var pullBtn = document.getElementById('dirPullReviewsBtn');
    if (pullBtn) {
      pullBtn.addEventListener('click', function () {
        void scrapeReviews(selectedListingIds());
      });
    }
    syncBulkBar();

    document.addEventListener('click', function (e) {
      var openBtn = e.target.closest('.js-dir-open');
      if (openBtn) {
        e.preventDefault();
        openEdit(openBtn.getAttribute('data-id'));
        return;
      }
      var scrapeOne = e.target.closest('.js-dir-scrape');
      if (scrapeOne) {
        e.preventDefault();
        if (scrapeOne.disabled) return;
        var scrapeId = scrapeOne.getAttribute('data-id');
        // Paint this row immediately (don't wait on POST) so Reviews → Scraping… is obvious.
        setRowScrapeUi(scrapeId, 'starting', 'Launching review scrape for this business…');
        void scrapeReviews([scrapeId]);
        return;
      }
      var pub = e.target.closest('.js-dir-publish');
      if (pub) {
        e.preventDefault();
        say('Updating…');
        postJson('/directory/listings/' + encodeURIComponent(pub.getAttribute('data-id')) + '/publish', {
          published: pub.getAttribute('data-published') === '1',
        }).then(function () { window.location.href = '/directory?ok=publish'; })
          .catch(function (err) { say(err.message || 'Publish failed', false); });
        return;
      }
      var refresh = e.target.closest('.js-dir-refresh');
      if (refresh) {
        e.preventDefault();
        say('Refreshing…');
        postJson('/directory/listings/' + encodeURIComponent(refresh.getAttribute('data-id')) + '/refresh', {})
          .then(function () { window.location.href = '/directory?ok=refreshed'; })
          .catch(function (err) { say(err.message || 'Refresh failed', false); });
        return;
      }
      var remove = e.target.closest('.js-dir-remove');
      if (remove) {
        e.preventDefault();
        if (!window.confirm('Remove this listing from the directory?')) return;
        say('Removing…');
        postJson('/directory/listings/' + encodeURIComponent(remove.getAttribute('data-id')) + '/remove', {})
          .then(function () { window.location.href = '/directory?ok=removed'; })
          .catch(function (err) { say(err.message || 'Remove failed', false); });
      }
    });

    if (backdrop) backdrop.addEventListener('click', function () { setEditOpen(false); });
    var closeBtn = document.getElementById('dirEditClose');
    if (closeBtn) closeBtn.addEventListener('click', function () { setEditOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && editOpenId) setEditOpen(false);
    });
    if (editForm) {
      editForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var id = editForm.querySelector('[name="id"]').value;
        if (!id) return;
        var fd = new FormData(editForm);
        var body = Object.fromEntries(fd.entries());
        body.published = fd.get('published') ? '1' : '0';
        if (editErr) {
          editErr.textContent = '';
          editErr.classList.add('hidden');
        }
        say('Saving listing…');
        postJson('/directory/listings/' + encodeURIComponent(id), body)
          .then(function (data) {
            if (data.listing) listingsById[id] = data.listing;
            say('Listing saved.');
            setEditOpen(false);
            return fetch('/directory/inbox.json', {
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
            });
          })
          .then(function (res) { return res ? res.json() : null; })
          .then(function (data) {
            if (data && data.success) applyInbox(data);
          })
          .catch(function (err) {
            var msg = err.message || 'Save failed';
            say(msg, false);
            if (editErr) {
              editErr.textContent = msg;
              editErr.classList.remove('hidden');
            }
          });
      });
    }
    var editRefresh = document.getElementById('dirEditRefresh');
    if (editRefresh) {
      editRefresh.addEventListener('click', function () {
        var id = editOpenId || (editForm && editForm.querySelector('[name="id"]').value);
        if (!id) return;
        say('Refreshing from lead…');
        postJson('/directory/listings/' + encodeURIComponent(id) + '/refresh', {})
          .then(function (data) {
            if (data.listing) {
              listingsById[id] = data.listing;
              fillEditForm(data.listing);
            }
            say('Listing refreshed from lead.');
            return fetch('/directory/inbox.json', {
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
            });
          })
          .then(function (res) { return res ? res.json() : null; })
          .then(function (data) {
            if (data && data.success) applyInbox(data);
          })
          .catch(function (err) { say(err.message || 'Refresh failed', false); });
      });
    }

    var promptDetails = document.querySelector('details[data-prompt-url]');
    var promptText = document.getElementById('dirPromptText');
    var copyBtn = document.getElementById('dirCopyPrompt');
    var promptLoaded = false;
    if (promptDetails && promptText) {
      promptDetails.addEventListener('toggle', function () {
        if (!promptDetails.open || promptLoaded) return;
        var url = promptDetails.getAttribute('data-prompt-url') || '/directory/page-prompt.txt';
        fetch(url, { credentials: 'same-origin' })
          .then(function (r) { return r.text(); })
          .then(function (t) { promptText.value = t; promptLoaded = true; })
          .catch(function () { promptText.value = 'Could not load prompt.'; });
      });
    }
    if (copyBtn && promptText) {
      copyBtn.addEventListener('click', function () {
        if (!promptText.value) return;
        navigator.clipboard.writeText(promptText.value).then(function () {
          say('Prompt copied.');
        }).catch(function () {
          promptText.select();
          say('Select and copy the prompt manually.');
        });
      });
    }
  })();
  </script>
</body>
</html>
