    function applyJobRowProgress(job, listingIds) {
      try {
        var ids = (job && Array.isArray(job.listingIds) && job.listingIds.length)
          ? job.listingIds.map(String)
          : (listingIds || []).map(String);
        var doneMap = {};
        (job && Array.isArray(job.results) ? job.results : []).forEach(function (r) {
          if (!r || r.id == null) return;
          doneMap[String(r.id)] = r;
        });
        var currentId = job && job.currentListingId != null ? String(job.currentListingId) : '';
        ids.forEach(function (id) {
          var r = doneMap[id];
          if (!r) {
            var msg = currentId && currentId === id
              ? 'Scraping Google reviews for this business…'
              : (currentId ? 'Queued — scraping another listing…' : 'Scraping Google reviews…');
            setRowScrapeUi(id, 'working', msg);
            return;
          }
          if (r.ok) {
            var bits = [];
            var ratingN = r.rating != null && r.rating !== '' ? Number(r.rating) : NaN;
            var countN = r.reviewCount != null && r.reviewCount !== '' ? Number(r.reviewCount) : NaN;
            if (Number.isFinite(ratingN)) bits.push(ratingN.toFixed(1) + '\u2605');
            if (Number.isFinite(countN)) bits.push(String(Math.max(0, Math.floor(countN))) + ' reviews');
            setRowScrapeUi(
              id,
              'done',
              bits.length ? ('Reviews pulled — ' + bits.join(' \u00b7 ')) : 'Reviews pulled for this business.'
            );
          } else {
            setRowScrapeUi(id, 'error', r.error || r.reviewError || 'Review scrape failed for this business.');
          }
        });
      } catch (err) {
        try { console.warn('[directory] applyJobRowProgress failed', err); } catch (_) {}
      }
    }
    function scrapeReviews(ids) {
      var listingIds = (ids || []).map(String).filter(Boolean);
      if (!listingIds.length) {
        say('Select at least one listing.', false);
        return Promise.resolve();
      }
      if (listingIds.length > 15) {
        say('Select at most 15 listings per run.', false);
        return Promise.resolve();
      }
      var btn = document.getElementById('dirPullReviewsBtn');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Starting…';
      }
      markRowsScraping(listingIds, 'starting', 'Launching review scrape…');
      say(
        listingIds.length === 1
          ? 'Launching review scrape for this business…'
          : ('Launching review scrape for ' + listingIds.length + ' businesses…')
      );
      return postJson('/directory/listings/scrape-reviews', { listingIds: listingIds })
        .then(function (data) {
          var jobId = data && data.jobId;
          if (!jobId) throw new Error((data && data.error) || 'Could not start scrape');
          markRowsScraping(listingIds, 'working', 'Scraping Google reviews…');
          if (data.job) applyJobRowProgress(data.job, listingIds);
          say(
            listingIds.length === 1
              ? 'Scraping Google reviews for this business…'
              : ('Scraping Google reviews for ' + listingIds.length + ' businesses…')
          );
          if (btn) btn.textContent = 'Pulling…';
          return new Promise(function (resolve, reject) {
            var tries = 0;
            function poll() {
              tries += 1;
              fetch('/directory/listings/scrape-reviews/' + encodeURIComponent(jobId) + '.json', {
                credentials: 'same-origin',
                headers: { Accept: 'application/json' },
              })
                .then(function (r) {
                  return r.json()
                    .then(function (d) { return { ok: r.ok, status: r.status, data: d }; })
                    .catch(function () { return { ok: false, status: r.status, data: {} }; });
                })
                .then(function (parsed) {
                  var job = parsed.data && parsed.data.job;
                  if (!parsed.ok || !job) throw new Error((parsed.data && parsed.data.error) || 'Job missing');
                  applyJobRowProgress(job, listingIds);
                  say('Pulling reviews… ' + (job.done || 0) + '/' + (job.total || listingIds.length));
                  if (job.status === 'running') {
                    if (tries > 180) throw new Error('Review pull is taking too long — refresh Directory later.');
                    setTimeout(poll, 2000);
                    return;
                  }
                  if (job.status === 'error') throw new Error(job.error || 'Scrape failed');
                  resolve(job);
                })
                .catch(reject);
            }
            setTimeout(poll, 1200);
          });
        })
        .then(function (job) {
          applyJobRowProgress(job, listingIds);
          var scraped = job && job.scraped != null ? job.scraped : 0;
          var failed = job && job.failed != null ? job.failed : 0;
          say(
            'Reviews done — ' + scraped + ' updated' + (failed ? ', ' + failed + ' failed' : '') + '.',
            !failed
          );
          return fetch('/directory/inbox.json', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          }).then(function (r) { return r.json().then(function (d) { return { inbox: d, job: job }; }); });
        })
        .then(function (pack) {
          if (pack.inbox && pack.inbox.success) applyInbox(pack.inbox);
          // List HTML was rebuilt — restore per-business done/error notes on the new rows.
          applyJobRowProgress(pack.job, listingIds);
          syncBulkBar();
        })
        .catch(function (err) {
          markRowsScraping(listingIds, 'error', err.message || 'Review scrape failed');
          say(err.message || 'Pull reviews failed', false);
        })
        .finally(function () {
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Pull reviews';
          }
          listingIds.forEach(function (id) {
            var row = listingRowEl(id);
            if (!row) return;
            var btnOne = row.querySelector('.js-dir-scrape');
            if (btnOne) {
              btnOne.disabled = false;
              btnOne.classList.remove('opacity-60', 'cursor-wait');
              btnOne.textContent = 'Reviews';
              btnOne.title = 'Pull Google reviews for this business';
            }
            row.setAttribute('data-scraping', '0');
          });
        });
    }
    function applyInbox(data) {
