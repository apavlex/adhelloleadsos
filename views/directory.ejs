    function setRowScrapeUi(id, state, message) {
      try {
        var row = listingRowEl(id);
        if (!row) return;
        var btn = row.querySelector('.js-dir-scrape');
        var status = row.querySelector('.js-dir-scrape-status');
        if (!status) {
          status = document.createElement('p');
          status.className = 'js-dir-scrape-status hidden mt-2 text-[11px] font-semibold';
          status.setAttribute('role', 'status');
          status.setAttribute('aria-live', 'polite');
          status.setAttribute('data-id', String(id || ''));
          var body = row.querySelector('.min-w-0');
          if (body) body.appendChild(status);
          else row.appendChild(status);
        }
        var busy = state === 'working' || state === 'starting';
        row.setAttribute('data-scraping', busy ? '1' : '0');
        status.setAttribute('data-state', state || 'idle');
        if (btn) {
          btn.disabled = !!busy;
          if (busy) {
            btn.classList.add('opacity-60', 'cursor-wait');
            btn.textContent = state === 'starting' ? 'Launching…' : 'Scraping…';
            btn.title = message || 'Scraping Google reviews for this business…';
          } else {
            btn.classList.remove('opacity-60', 'cursor-wait');
            btn.textContent = 'Reviews';
            btn.title = 'Pull Google reviews for this business';
          }
        }
        if (state === 'idle' || !message) {
          status.textContent = '';
          status.classList.add('hidden');
          status.style.color = '';
          return;
        }
        status.classList.remove('hidden');
        if (state === 'done') status.style.color = '#047857';
        else if (state === 'error') status.style.color = '#be123c';
        else status.style.color = '#b45309';
        status.textContent = String(message);
