<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <main class="max-wide px-6 py-8 md:py-12">
    <% const _inboxHydrate = typeof inboxHydrate !== 'undefined' ? !!inboxHydrate : false; %>
    <% const _inboxPending = typeof inboxPending !== 'undefined' ? !!inboxPending : _inboxHydrate; %>
    <% const _summary = typeof summary !== 'undefined' && summary ? summary : { total: 0, published: 0, draft: 0 }; %>
    <% const _settings = typeof settings !== 'undefined' && settings ? settings : {}; %>
    <% const _listings = Array.isArray(listings) ? listings : []; %>
    <% const _feedUrl = typeof feedUrl !== 'undefined' ? feedUrl : ''; %>
    <% const _detailUrl = typeof detailUrlTemplate !== 'undefined' ? detailUrlTemplate : ''; %>
    <% const _leadFormUrl = typeof leadFormUrlTemplate !== 'undefined' ? leadFormUrlTemplate : ''; %>
    <% const _flash = typeof flash !== 'undefined' ? flash : null; %>
    <% const _promptUrl = typeof pageBuilderPromptUrl !== 'undefined' ? String(pageBuilderPromptUrl || '') : '/directory/page-prompt.txt'; %>

    <header class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-2">SEO / Local Rank · Directory</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Business Directory</h1>
        <p class="text-sm text-brand-muted dark:text-slate-400 mt-2 max-w-2xl">Publish curated Pipeline leads to a public feed for <strong class="text-brand-dark dark:text-white">this workspace</strong>. Host the pages on your own site / custom domain in AI Studio — same pattern as Q&amp;A, with crawlable schema.</p>
      </div>
    </header>
    <%- include('partials/seo_local_rank_nav') %>

    <% if (_flash && _flash.ok) { %>
    <p class="mb-4 text-sm font-semibold text-emerald-700 dark:text-emerald-300" role="status"><%= _flash.ok %></p>
    <% } %>
    <% if (_flash && _flash.error) { %>
    <p class="mb-4 text-sm font-semibold text-rose-600 dark:text-rose-300" role="alert"><%= _flash.error %></p>
    <% } %>
    <p id="dirStatus" class="mb-4 text-sm font-semibold text-brand-muted dark:text-slate-300 min-h-[1.25rem]" role="status" aria-live="polite"></p>

    <div class="grid grid-cols-3 gap-3 mb-6">
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 p-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Total</p>
        <p id="dirKpiTotal" class="font-display font-black text-2xl"><%= _inboxPending ? '…' : _summary.total %></p>
      </div>
      <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200">Published</p>
        <p id="dirKpiPublished" class="font-display font-black text-2xl"><%= _inboxPending ? '…' : _summary.published %></p>
      </div>
      <div class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 p-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Draft</p>
        <p id="dirKpiDraft" class="font-display font-black text-2xl"><%= _inboxPending ? '…' : _summary.draft %></p>
      </div>
    </div>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 shadow-sm p-5 sm:p-6 mb-6" aria-labelledby="dirConnectTitle">
      <h2 id="dirConnectTitle" class="font-display font-bold text-lg mb-1">Connect your site / custom domain</h2>
      <p class="text-xs text-brand-muted mb-4">Set the live directory URL for <em>this</em> workspace (e.g. <code class="text-[10px]">https://homeelk.com/pros</code>), save to mint a publish token, then paste the page-builder prompt into that brand’s AI Studio project — not AdHello.io. Profile lead forms POST into Reviews so the business gets an app notification.</p>

      <form id="dirSettingsForm" class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Page title</span>
          <input type="text" name="pageTitle" value="<%= _settings.pageTitle || '' %>" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Brand name</span>
          <input type="text" name="businessName" value="<%= _settings.businessName || '' %>" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Live directory URL (your custom domain)</span>
          <input type="url" name="pageUrl" placeholder="https://flooringquote.com/directory" value="<%= _settings.pageUrl || '' %>" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Path prefix</span>
          <input type="text" name="pathPrefix" value="<%= _settings.pathPrefix || '/directory' %>" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <div class="flex flex-wrap items-end gap-4 text-sm">
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="showPhone" value="1" <%= _settings.showPhone !== false ? 'checked' : '' %> class="rounded border-brand-border" /> Phone</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="showWebsite" value="1" <%= _settings.showWebsite !== false ? 'checked' : '' %> class="rounded border-brand-border" /> Website</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="showAddress" value="1" <%= _settings.showAddress !== false ? 'checked' : '' %> class="rounded border-brand-border" /> Address</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="showRating" value="1" <%= _settings.showRating !== false ? 'checked' : '' %> class="rounded border-brand-border" /> Rating</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="showReviews" value="1" <%= _settings.showReviews !== false ? 'checked' : '' %> class="rounded border-brand-border" /> Reviews / sentiment</label>
        </div>
        <div class="sm:col-span-2 flex flex-wrap gap-2">
          <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Save settings</button>
          <button type="button" id="dirRotateToken" class="btn-pill border border-brand-border dark:border-white/20 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Rotate publish token</button>
        </div>
      </form>

      <div id="dirFeedUrls" class="mt-5 rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4 space-y-3<%= _feedUrl ? '' : ' hidden' %>">
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Public index feed</p>
          <code id="dirFeedUrl" class="block text-[11px] break-all"><%= _feedUrl %></code>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Public detail feed</p>
          <code id="dirDetailUrl" class="block text-[11px] break-all"><%= _detailUrl %></code>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Profile lead form (POST)</p>
          <code id="dirLeadFormUrl" class="block text-[11px] break-all"><%= _leadFormUrl %></code>
        </div>
        <p class="text-xs text-brand-muted leading-relaxed">SEO tip: AI Studio should SSR the feed into HTML and inject <code class="text-[10px]">item_list_schema</code> / <code class="text-[10px]">local_business_schema</code> as JSON-LD. Detail JSON includes <code class="text-[10px]">review_page_url</code> (Leave a review → Reviews app links) and a lead form POST URL for quote requests.</p>
      </div>

      <details class="mt-5 rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/10 dark:bg-slate-950/30 p-4" data-prompt-url="<%= _promptUrl %>">
        <summary class="cursor-pointer font-display font-bold text-sm">AI Studio page-builder prompt</summary>
        <p class="text-xs text-brand-muted mt-2 mb-3">Copy into <strong class="text-brand-dark dark:text-white">that brand’s</strong> AI Studio chat (the site on your custom domain) to build index + <code class="text-[10px]">/{slug}</code> pages. Save settings first so feed URLs and the domain are filled in.</p>
        <textarea id="dirPromptText" readonly rows="8" class="w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-white dark:bg-slate-950/60 px-3 py-2.5 text-[11px] font-mono" placeholder="Open this panel to load the prompt…"></textarea>
        <button type="button" id="dirCopyPrompt" class="mt-3 btn-pill border border-brand-border dark:border-white/20 px-4 py-2 text-[10px] font-black uppercase tracking-widest">Copy prompt</button>
      </details>
    </section>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 shadow-sm p-5 sm:p-6 mb-6" aria-labelledby="dirAddTitle">
      <h2 id="dirAddTitle" class="font-display font-bold text-lg mb-1">Add a business from Pipeline</h2>
      <p class="text-xs text-brand-muted mb-4">Select leads in Pipeline → More → <strong class="text-brand-dark dark:text-white">Directory</strong> for bulk publish, or paste a single lead key here. Listings stay in this workspace only.</p>
      <form id="dirAddForm" class="grid gap-3 sm:grid-cols-[1fr_auto]">
        <label class="block">
          <span class="sr-only">Lead key</span>
          <input type="text" name="leadKey" required placeholder="lead:… or storage key" class="w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Add &amp; publish</button>
      </form>
    </section>

    <section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900/80 shadow-sm overflow-hidden" aria-label="Directory listings">
      <div class="px-5 sm:px-6 py-4 border-b border-brand-border/40 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 min-w-0">
          <h2 class="font-display font-bold text-lg">Listings</h2>
          <p id="dirListCount" class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><% if (_inboxPending) { %>Loading…<% } else { %><%= _listings.length %> item<%= _listings.length === 1 ? '' : 's' %><% } %></p>
        </div>
        <div id="dirBulkBar" class="hidden flex flex-wrap items-center gap-2">
          <label class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-brand-muted cursor-pointer">
            <input type="checkbox" id="dirSelectAll" class="rounded border-brand-border" />
            Select all
          </label>
          <span id="dirSelectedCount" class="text-[10px] font-bold text-brand-muted tabular-nums">0 selected</span>
          <button type="button" id="dirPullReviewsBtn" class="btn-pill btn-primary px-4 py-2 text-[10px] font-black uppercase tracking-widest" title="Outscraper pulls ~25 Google reviews per business (~$0.08 after free tier)">Pull reviews</button>
        </div>
      </div>
      <p class="px-5 sm:px-6 pt-3 text-[11px] text-brand-muted">Select listings → <strong class="text-brand-dark dark:text-white">Pull reviews</strong> to scrape Google reviews into the lead and Directory (and the public API). Max 15 per run.</p>
      <div id="dirListLoading" class="px-6 py-12 text-center text-sm text-brand-muted<%= (_inboxPending || _inboxHydrate) && !_listings.length ? '' : ' hidden' %>">Loading listings…</div>
      <div id="dirListEmpty" class="px-6 py-12 text-center text-sm text-brand-muted<%= (!_listings.length && !(_inboxPending || _inboxHydrate)) ? '' : ' hidden' %>">No listings yet. Add a Pipeline lead key above.</div>
      <ul id="dirList" class="divide-y divide-brand-border/30 dark:divide-white/10 m-0 p-0 list-none<%= _listings.length ? '' : ' hidden' %>">
        <%/* Contact + reviews rows are painted by hydrate (renderRow). Shell stays empty. */%>
      </ul>
    </section>
  </main>

  <div id="dirEditBackdrop" class="fixed inset-0 bg-black/40 z-40 hidden" aria-hidden="true"></div>
  <aside id="dirEditDrawer" class="fixed top-0 right-0 h-full w-full max-w-lg z-50 bg-white dark:bg-slate-900 border-l border-brand-border/60 dark:border-white/10 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="dirEditTitle">
    <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-brand-border/50 dark:border-white/10 shrink-0">
      <div class="min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Directory listing</p>
        <h2 id="dirEditTitle" class="font-display font-bold text-lg truncate">Edit business</h2>
      </div>
      <button type="button" id="dirEditClose" class="btn-pill border border-brand-border dark:border-white/20 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest">Close</button>
    </div>
    <form id="dirEditForm" class="flex-1 overflow-y-auto p-5 space-y-4">
      <input type="hidden" name="id" value="" />
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Business name</span>
        <input type="text" name="name" required class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Slug</span>
          <input type="text" name="slug" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Category</span>
          <input type="text" name="category" placeholder="e.g. HVAC contractor" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">City</span>
          <input type="text" name="city" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">State</span>
          <input type="text" name="state" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Address</span>
        <input type="text" name="address" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Phone</span>
          <input type="text" name="phone" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Website</span>
          <input type="url" name="website" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">License label</span>
          <input type="text" name="licenseLabel" placeholder="CCB / WA L&amp;I" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">CCB / License #</span>
          <input type="text" name="licenseNumber" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Rating</span>
          <input type="number" name="rating" min="0" max="5" step="0.1" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Review count</span>
          <input type="number" name="reviewCount" min="0" step="1" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Review sentiment</span>
        <select name="reviewSentiment" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm">
          <option value="">—</option>
          <option value="positive">Positive</option>
          <option value="mostly_positive">Mostly positive</option>
          <option value="mixed">Mixed</option>
          <option value="needs_attention">Needs attention</option>
          <option value="negative">Negative</option>
        </select>
      </label>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Short blurb</span>
        <textarea name="blurb" rows="2" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm"></textarea>
      </label>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Description</span>
        <textarea name="description" rows="4" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm"></textarea>
      </label>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Review summary</span>
        <textarea name="reviewSummary" rows="3" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm"></textarea>
      </label>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Review quotes (one per line)</span>
        <textarea name="reviewSnippets" rows="4" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" placeholder="Great communication and fair pricing."></textarea>
      </label>
      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Image URL</span>
        <input type="url" name="imageUrl" class="mt-1 w-full rounded-xl border border-brand-border/50 dark:border-white/15 bg-brand-cream/30 dark:bg-slate-950/40 px-3 py-2.5 text-sm" />
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="published" value="1" class="rounded border-brand-border" />
        Published on the public feed
      </label>
      <p id="dirEditLeadKey" class="text-[11px] text-brand-muted break-all"></p>
      <p id="dirEditErr" class="text-xs text-rose-600 dark:text-rose-400 hidden"></p>
    </form>
    <div class="shrink-0 border-t border-brand-border/50 dark:border-white/10 p-4 flex flex-wrap gap-2">
      <button type="submit" form="dirEditForm" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Save listing</button>
      <button type="button" id="dirEditRefresh" class="btn-pill border border-brand-border dark:border-white/20 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest">Refresh from lead</button>
    </div>
  </aside>

  <%- include('partials/navbar_scripts') %>
  <script>
  (function () {
    var statusEl = document.getElementById('dirStatus');
    var listingsById = {};
    var editOpenId = '';
    var drawer = document.getElementById('dirEditDrawer');
    var backdrop = document.getElementById('dirEditBackdrop');
    var editForm = document.getElementById('dirEditForm');
    var editErr = document.getElementById('dirEditErr');
    function say(msg, ok) {
      if (!statusEl) return;
      statusEl.textContent = msg || '';
      statusEl.className = 'mb-4 text-sm font-semibold min-h-[1.25rem] ' + (ok === false ? 'text-rose-600 dark:text-rose-300' : 'text-brand-muted dark:text-slate-300');
    }
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    async function postJson(url, body) {
      var res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body || {}),
      });
      var data = await res.json().catch(function () { return {}; });
      // 202 Accepted (async scrape) is success — do not treat as failure.
      if (data.success === false || (res.status >= 400 && !data.jobId)) {
        throw new Error((data && data.error) || 'Request failed');
      }
      if (!res.ok && !(res.status === 202 && data.success)) {
        throw new Error((data && data.error) || 'Request failed');
      }
      return data;
    }
    function setEditOpen(open) {
      if (!drawer || !backdrop) return;
      if (open) {
        drawer.classList.remove('hidden');
        // Next frame so translate transition still runs after un-hiding.
        requestAnimationFrame(function () {
          drawer.classList.remove('translate-x-full');
        });
      } else {
        drawer.classList.add('translate-x-full');
