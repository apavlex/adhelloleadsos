              }
              throw new Error((parsed.data && parsed.data.error) || 'Could not load directory');
            }
            applyInbox(parsed.data);
            try { window.dispatchEvent(new Event('adhello:inbox-hydrated')); } catch (_) {}
          })
          .catch(function (e) {
            clearTimeout(hydrateTimer);
            if (hydrateAttempts < 6 && e && e.name === 'AbortError') {
