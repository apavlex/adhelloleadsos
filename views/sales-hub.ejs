<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-14">
    <%- include('partials/sales-nav') %>

    <% const h = typeof hubStats !== 'undefined' && hubStats ? hubStats : null; %>
    <div class="mb-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Daily leads generator</span>
      </div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark dark:text-white">
        Your SaaS <span class="text-brand-muted">Lead HQ</span>
      </h1>
      <p class="text-brand-muted font-medium mt-3 text-lg">
        Generate demand, move deals through the full pipeline (10 stages including outreach + close), and log outreach every day — one workspace for your AdHello-style SaaS motion.
      </p>
    </div>

    <% if (h) { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      <div class="brand-card p-5 dark:bg-slate-900 dark:border-white/10">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Workspace leads</p>
        <p class="text-3xl font-display font-black text-brand-dark dark:text-white"><%= h.totalWorkspace %></p>
        <p class="text-[11px] text-brand-muted mt-1"><%= h.newThisWeek %> new in last 7 days</p>
      </div>
      <div class="brand-card p-5 dark:bg-slate-900 dark:border-white/10">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outreach streak</p>
        <p class="text-3xl font-display font-black text-emerald-600 dark:text-emerald-400"><%= h.streak %></p>
        <p class="text-[11px] text-brand-muted mt-1">Consecutive days with activity</p>
      </div>
      <div class="brand-card p-5 dark:bg-slate-900 dark:border-white/10">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Touches today</p>
        <p class="text-3xl font-display font-black text-brand-yellow"><%= h.touchesToday %></p>
        <p class="text-[11px] text-brand-muted mt-1">Emails + DMs + calls + bids</p>
      </div>
      <div class="brand-card p-5 dark:bg-slate-900 dark:border-white/10 flex flex-col justify-center gap-2">
        <a href="/leads/find" class="btn-pill btn-primary text-center text-xs font-black uppercase py-3">Run search</a>
        <a href="/prospecting?tab=pipeline" class="text-center text-[10px] font-black uppercase text-brand-muted hover:text-brand-dark dark:hover:text-white underline">Saved leads →</a>
      </div>
    </div>

    <% if (h.chartSeries && h.chartSeries.length) { %>
      <% const maxT = Math.max(1, ...h.chartSeries.map((x) => x.total)); %>
      <div class="brand-card p-6 mb-10 dark:bg-slate-900 dark:border-white/10">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display font-extrabold text-sm text-brand-dark dark:text-white">14-day outreach volume</h3>
          <a href="/reports?tab=tracker" class="text-[10px] font-black uppercase text-brand-yellow underline">Today’s touches</a>
        </div>
        <div class="flex items-end gap-1.5 h-40 w-full">
          <% h.chartSeries.forEach((pt) => { %>
            <% const barPx = Math.max(6, Math.round((pt.total / maxT) * 120)); %>
            <div class="flex-1 min-w-0 flex flex-col justify-end h-full group" title="<%= pt.date %>: <%= pt.total %> touches">
              <div class="w-full rounded-t-lg bg-brand-yellow/90 dark:bg-brand-yellow transition-all group-hover:brightness-110 mx-auto max-w-[28px]" style="height: <%= barPx %>px"></div>
              <span class="text-[8px] font-bold text-brand-muted truncate w-full text-center mt-1"><%= pt.date.slice(5) %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
    <% } %>

    <div class="grid md:grid-cols-3 gap-6 mb-16">
      <a href="/sales/workflow" class="group brand-card p-8 dark:bg-slate-900 dark:border-white/10 hover:border-brand-yellow/50 transition-all">
        <div class="w-12 h-12 rounded-2xl bg-brand-yellow/20 flex items-center justify-center mb-6 text-brand-dark font-black text-xl border border-brand-yellow/30">10</div>
        <h2 class="font-display font-extrabold text-xl mb-2 group-hover:text-brand-yellow transition-colors">Pipeline workflow</h2>
        <p class="text-sm text-brand-muted leading-relaxed">New → Contacted → Booked → CQI → Trial → Retainer → Upsell → Referrals. CQI notes live on each lead.</p>
        <span class="inline-block mt-6 text-[10px] font-black uppercase tracking-widest text-brand-yellow">Open workflow →</span>
      </a>
      <a href="/reports?tab=tracker" class="group brand-card p-8 dark:bg-slate-900 dark:border-white/10 hover:border-brand-yellow/50 transition-all">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/15 flex items-center justify-center mb-6 text-emerald-700 dark:text-emerald-400 font-black text-xl border border-emerald-500/20">∑</div>
        <h2 class="font-display font-extrabold text-xl mb-2 group-hover:text-emerald-600 transition-colors">Daily Action Tracker</h2>
        <p class="text-sm text-brand-muted leading-relaxed">Cold outreach, social posts, ad creatives, and bids — tracked per day under Reports.</p>
        <span class="inline-block mt-6 text-[10px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Log today →</span>
      </a>
      <a href="/sales/personas" class="group brand-card p-8 dark:bg-slate-900 dark:border-white/10 hover:border-brand-yellow/50 transition-all">
        <div class="w-12 h-12 rounded-2xl bg-violet-500/15 flex items-center justify-center mb-6 text-violet-700 dark:text-violet-300 font-black text-xl border border-violet-500/20">AI</div>
        <h2 class="font-display font-extrabold text-xl mb-2 group-hover:text-violet-600 transition-colors">Sales scripts</h2>
        <p class="text-sm text-brand-muted leading-relaxed">Talk tracks by offer, merge tags, script coach, and saved snippets for this workspace.</p>
        <span class="inline-block mt-6 text-[10px] font-black uppercase tracking-widest text-violet-600 dark:text-violet-300">View scripts →</span>
      </a>
    </div>

    <div class="brand-card p-8 dark:bg-slate-900 dark:border-white/10">
      <h3 class="font-display font-extrabold text-lg mb-4">Methodology at a glance</h3>
      <ol class="grid sm:grid-cols-2 gap-4 text-sm text-brand-muted">
        <% stages.forEach((s) => { %>
          <li class="flex gap-3">
            <span class="shrink-0 w-7 h-7 rounded-lg bg-brand-cream dark:bg-slate-800 flex items-center justify-center text-[11px] font-black text-brand-dark dark:text-white"><%= s.id %></span>
            <span><strong class="text-brand-dark dark:text-white"><%= s.name %></strong> — <%= s.summary %></span>
          </li>
        <% }) %>
      </ol>
    </div>
  </main>
</body>
</html>
