<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 pt-12 pb-24">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="animate-fade-in">
        <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Scheduled lead runs</span>
        </div>
        <h1 class="font-display font-black text-5xl md:text-6xl tracking-tight text-brand-dark mb-4">Scheduled <span class="text-brand-muted">Jobs</span></h1>
        <p class="text-lg text-brand-muted font-medium max-w-xl">
          Manage your automated lead discovery tasks. Our bots will scour Google Maps on a schedule to find your next clients.
        </p>
      </div>
      
      <a href="/" class="btn-pill btn-primary px-8 flex items-center gap-3 group">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Create New Job
      </a>
    </div>

    <% if (success) { %>
      <div class="max-w-xl mx-auto mb-10 bg-emerald-50 border border-emerald-100 text-emerald-700 px-6 py-4 rounded-2xl flex items-center gap-4 animate-bounce-subtle">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        <span class="font-bold text-sm">Scheduled scrape saved — we’ll run it once at the date and time you picked.</span>
      </div>
    <% } %>

    <% if (typeof schedules !== 'undefined' && schedules.length > 0) { %>
      <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-brand-border dark:border-white/10 bg-white dark:bg-white/5">
                <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400">Target Keyword</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Location</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Target Schedule</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-center">Last Pulse</th>
                <th class="px-6 py-5 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-muted dark:text-slate-400 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border/40">
              <% schedules.forEach(job => { %>
                <tr class="group hover:bg-brand-cream/50 dark:hover:bg-white/5 transition-all duration-300">
                  <td class="px-8 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-brand-yellow/10 rounded-xl flex items-center justify-center font-display font-extrabold text-brand-dark border border-brand-yellow/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="1.5" stroke-linecap="round" /></svg>
                      </div>
                      <div>
                        <div class="font-bold text-brand-dark text-base"><%= job.keyword %></div>
                        <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider mt-0.5">Scraping up to <%= job.maxResults %> leads</div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-center">
                    <span class="text-sm font-bold text-brand-dark"><%= job.city %>, <%= job.state %></span>
                  </td>
                  <td class="px-6 py-6 text-center">
                    <div class="inline-flex flex-col items-center">
                      <% if (job.scheduledRunAt) { %>
                      <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-purple-50 text-purple-600 mb-1">
                        One-time
                      </span>
                      <div class="text-[10px] font-bold text-brand-dark tracking-tight">
                        <%= job.scheduledDate || '' %> · <%= job.scheduledTime || '09:00' %>
                      </div>
                      <% } else { %>
                      <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-purple-50 text-purple-600 mb-1">
                        <%= job.frequency || 'daily' %>
                      </span>
                      <div class="text-[10px] font-bold text-brand-dark tracking-tight">
                        @ <%= job.scheduledTime || '09:00' %>
                      </div>
                      <% } %>
                      <div class="text-[9px] font-medium text-brand-muted uppercase tracking-tighter">
                        <%= job.timezone || 'UTC' %>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-center text-sm font-medium text-brand-muted">
                    <div class="flex flex-col">
                      <span><%= job.lastRun ? new Date(job.lastRun).toLocaleDateString() : 'Pending' %></span>
                      <span class="text-[10px]"><%= job.lastRun ? new Date(job.lastRun).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'Waiting for run...' %></span>
                    </div>
                  </td>
                  <td class="px-6 py-6 text-right">
                    <form action="/schedules/delete" method="POST" onsubmit="return confirm('Stop this scheduled job?')">
                      <input type="hidden" name="key" value="<%= job.key %>">
                      <button type="submit" class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-red-500 hover:bg-red-50 hover:border-red-200 transition-all flex items-center justify-center ml-auto">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="brand-card p-24 text-center max-wide">
        <div class="w-20 h-20 bg-brand-cream rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-border">
          <svg class="w-10 h-10 text-brand-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        </div>
        <h2 class="font-display font-extrabold text-3xl text-brand-dark mb-4">No scheduled jobs</h2>
        <p class="text-brand-muted font-medium mb-10 max-w-sm mx-auto">Create a scheduled search on Find Leads — pick a date and time; we run once then notify you when the scrape completes.</p>
        <a href="/" class="btn-pill btn-primary px-10">Create scheduled search</a>
      </div>
    <% } %>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
