<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <% if (typeof tab !== 'undefined' && tab === 'pipeline') { %>
  <script src="/js/sortable-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
  <% } %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide w-full min-w-0 px-6 py-10 md:py-14">
    <% const activeTab = typeof tab !== 'undefined' ? tab : 'queue'; %>
    <% if (activeTab === 'pipeline') { %>
      <%- include('partials/prospecting_board') %>
    <% } else if (activeTab === 'queue') { %>
      <%- include('partials/scheduled_jobs_content', {
        scheduledJobsEmbed: true,
        scheduleSuccess: typeof scheduleSuccess !== 'undefined' && scheduleSuccess,
        schedules: typeof schedules !== 'undefined' ? schedules : [],
        scheduleDeleteReturnTo: '/prospecting?tab=queue'
      }) %>
    <% } else { %>
      <% 
        var _folderCounts = {};
        (folderListLeads || []).forEach(function (l) {
          var fk = String((l && l.folderKey) || '').trim();
          if (!fk) return;
          _folderCounts[fk] = (_folderCounts[fk] || 0) + 1;
        });
      %>
      <section class="space-y-8" aria-label="Folder manager">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
              <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Outreach folders</span>
            </div>
            <h2 class="font-display font-black text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Folder manager</h2>
            <p class="text-sm text-brand-muted mt-2 max-w-2xl">System folders group your search types — click a folder’s <strong class="text-brand-dark dark:text-white">▶</strong> to expand subfolders. <strong class="text-brand-dark dark:text-white">Businesses</strong> includes <%= typeof tradeFolderCount !== 'undefined' ? tradeFolderCount : 28 %> home-service trade subfolders (from <a href="https://www.servicetitan.com/industries" class="text-brand-yellow hover:underline" target="_blank" rel="noopener">ServiceTitan industries</a>). Use <strong class="text-brand-dark dark:text-white">Search setup</strong> on system folders, then <strong class="text-brand-dark dark:text-white">Run search</strong> on any folder.</p>
          </div>
          <button type="button" id="folderCreateOpen" class="btn-pill btn-primary px-6 md:px-8 py-3.5 text-[10px] font-black uppercase tracking-widest shrink-0 inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            New subfolder
          </button>
        </div>

        <div class="relative max-w-xl">
          <label for="folderSearchFilter" class="sr-only">Search folders</label>
          <input type="search" id="folderSearchFilter" autocomplete="off" placeholder="Search folders — HVAC, plumbing, dental…"
            class="w-full rounded-2xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 pl-11 pr-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/60 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/25" />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
          <p id="folderSearchEmpty" class="hidden text-sm text-brand-muted mt-2">No folders match your search.</p>
        </div>

        <% if (!(folders || []).length) { %>
          <div class="brand-card p-14 md:p-20 text-center dark:bg-slate-900 dark:border-white/10">
            <p class="text-brand-muted mb-6 max-w-md mx-auto">No folders yet. Create one to organize outreach (e.g. Referrals, Events, High-priority).</p>
          </div>
        <% } else { %>
          <% const _tree = typeof folderTree !== 'undefined' && folderTree ? folderTree : { groups: [] }; %>
          <div class="space-y-4" id="folderTreeRoot">
            <% (_tree.groups || []).forEach(function (group) {
              var rootFolder = group.folder;
              var rootFc = rootFolder ? (_folderCounts[rootFolder.key] || 0) : 0;
              var childTotal = 0;
              (group.childRows || []).forEach(function (row) { childTotal += _folderCounts[row.folder.key] || 0; });
              var groupTotal = rootFc + childTotal;
            %>
            <details class="folder-group brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10 group/folder" open data-folder-group="<%= group.key %>" data-folder-group-search="<%= (group.name + ' ' + (group.jobType || '')).toLowerCase() %>">
              <summary class="cursor-pointer list-none flex flex-wrap items-center justify-between gap-3 px-6 py-4 bg-brand-cream/30 dark:bg-slate-950/40 border-b border-brand-border/30 dark:border-white/10 hover:bg-brand-cream/50 dark:hover:bg-slate-950/60 transition-colors [&::-webkit-details-marker]:hidden">
                <div class="min-w-0 flex-1">
                  <p class="font-display font-black text-lg text-brand-dark dark:text-white flex flex-wrap items-center gap-2">
                    <%= group.name %>
                    <% if (group.isSystem) { %><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted border border-brand-border/50 rounded-full px-2 py-0.5">System</span><% } %>
                    <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= (group.childRows || group.children || []).length %> subfolder<%= (group.childRows || group.children || []).length === 1 ? '' : 's' %></span>
                  </p>
                  <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-1"><%= groupTotal %> lead<%= groupTotal === 1 ? '' : 's' %> total</p>
                </div>
                <span class="folder-group-chevron text-brand-muted text-xs font-bold uppercase tracking-widest transition-transform group-open/folder:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <ul class="m-0 p-0 list-none divide-y divide-brand-border/20 dark:divide-white/5">
                <% if (rootFolder) { %>
                  <%- include('partials/folder_manager_node', {
                    f: rootFolder,
                    fc: rootFc,
                    depth: 0,
                    children: group.children || [],
                    folderCounts: _folderCounts
                  }) %>
                <% } else { %>
                  <% (group.children || []).forEach(function (child) { %>
                    <%- include('partials/folder_manager_node', {
                      f: child,
                      fc: _folderCounts[child.key] || 0,
                      depth: 0,
                      children: child.children || [],
                      folderCounts: _folderCounts
                    }) %>
                  <% }); %>
                <% } %>
                <% if (!rootFolder && !(group.children || []).length) { %>
                  <li class="px-6 py-8 text-sm text-brand-muted list-none">No folders in this group.</li>
                <% } %>
              </ul>
            </details>
            <% }); %>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>

  <% if (activeTab === 'pipeline') { %>
  <script src="/js/folder-filter-picker.js?v=<%= assetVersion %>"></script>
  <%- include('partials/leads_interactive_tail', { leads: typeof leads !== 'undefined' ? leads : [], leadBootstrapLeads: typeof leadBootstrapLeads !== 'undefined' ? leadBootstrapLeads : null, pipelineStages, folders, tags: typeof tags !== 'undefined' ? tags : [], activeFolderKey: typeof activeFolderKey !== 'undefined' ? activeFolderKey : '', isBusinessesView: typeof isBusinessesView !== 'undefined' ? isBusinessesView : false, scriptLibraryOfferPicklist: Array.isArray(locals.scriptLibraryOfferPicklist) ? locals.scriptLibraryOfferPicklist : [], outreachChannelLibrary: locals.outreachChannelLibrary && typeof locals.outreachChannelLibrary === 'object' ? locals.outreachChannelLibrary : {} }) %>
  <script src="/js/httpJson.js?v=<%= assetVersion %>"></script>
  <script src="/js/socialBrandIcons.js?v=<%= assetVersion %>"></script>
  <% if (typeof driveImport !== 'undefined' && driveImport && driveImport.pickerReady) { %>
  <script>
  (function () {
    window.__DRIVE_IMPORT__ = <%- JSON.stringify({
      developerKey: driveImport.pickerApiKey || '',
      appId: driveImport.googleClientId || ''
    }) %>;
    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    function ensurePicker(cb) {
      if (window.google && google.picker) return cb();
      if (window.gapi && gapi.load) {
        gapi.load('picker', function () { cb(); });
        return;
      }
      loadScript('https://apis.google.com/js/api.js').then(function () {
        gapi.load('picker', function () { cb(); });
      }).catch(function () { alert('Could not load Google Picker.'); });
    }
    function driveImportPick(btn) {
      if (!btn) btn = document.querySelector('.js-drive-import-pick');
      var cfg = window.__DRIVE_IMPORT__ || {};
      var dk = cfg.developerKey;
      var appId = cfg.appId;
      if (!dk) {
        alert('Picker API key is not configured.');
        return;
      }
      if (!appId) {
        alert('Google OAuth client ID is not configured.');
        return;
      }
      if (btn) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
      }
      var fetchJsonFn = typeof window.fetchJson === 'function' ? window.fetchJson : null;
      var tokenReq = fetchJsonFn
        ? fetchJsonFn('/leads/google-drive/access-token', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          })
        : fetch('/leads/google-drive/access-token', { credentials: 'same-origin' }).then(function (r) {
            return r.json().then(function (j) { return { ok: r.ok, j: j }; });
          });
      tokenReq
        .then(function (pack) {
          if (!pack.ok || !pack.j || !pack.j.success || !pack.j.accessToken) {
            throw new Error((pack.j && pack.j.error) || 'Not signed in to Google Drive. Use Connect Google Drive.');
          }
          var oauthToken = pack.j.accessToken;
          ensurePicker(function () {
            var view = new google.picker.DocsView(google.picker.ViewId.DOCUMENTS)
              .setIncludeFolders(true)
              .setMimeTypes('text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.google-apps.spreadsheet');
            var picker = new google.picker.PickerBuilder()
              .setOAuthToken(oauthToken)
              .setDeveloperKey(dk)
              .setAppId(appId)
              .addView(view)
              .setTitle('Select CSV, XLSX, or Google Sheet')
              .setCallback(function (data) {
                var action = data[google.picker.Response.ACTION];
                if (action === google.picker.Action.CANCEL) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                if (action !== google.picker.Action.PICKED) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                var docs = data[google.picker.Response.DOCUMENTS];
                var doc = docs && docs[0];
                var fileId = doc && doc[google.picker.Document.ID];
                if (!fileId) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                if (btn) {
                  btn.disabled = true;
                  btn.setAttribute('aria-busy', 'true');
                }
                var importReq = fetchJsonFn
                  ? fetchJsonFn('/leads/drive-import/google', {
                      method: 'POST',
                      credentials: 'same-origin',
                      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                      body: JSON.stringify({ fileId: fileId }),
                    })
                  : fetch('/leads/drive-import/google', {
                      method: 'POST',
                      credentials: 'same-origin',
                      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                      body: JSON.stringify({ fileId: fileId }),
                    }).then(function (r) {
                      return r.json().then(function (j) { return { ok: r.ok, j: j }; });
                    });
                importReq
                  .then(function (imp) {
                    if (!imp.ok || !imp.j || !imp.j.success) {
                      throw new Error((imp.j && imp.j.error) || 'Import failed');
                    }
                    var j = imp.j;
                    var q = 'tab=pipeline&origin=csv&includeFoldered=1&source=all&rows=' + encodeURIComponent(j.totalRows || 0)
                      + '&rawRows=' + encodeURIComponent(j.rawRows != null ? j.rawRows : j.totalRows || 0)
                      + '&rejected=' + encodeURIComponent(j.rejected || 0)
                      + '&created=' + encodeURIComponent(j.created || 0)
                      + '&updated=' + encodeURIComponent(j.updated || 0)
                      + '&imported=' + encodeURIComponent(j.imported || 0)
                      + '&skipped=' + encodeURIComponent(j.skipped || 0)
                      + '&failed=' + encodeURIComponent(j.failed || 0);
                    if (j.realEstateImport) q += '&realEstate=1';
                    window.location.href = '/prospecting?' + q;
                  })
                  .catch(function (e) {
                    alert(e && e.message ? e.message : 'Import failed');
                    if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  });
              })
              .build();
            picker.setVisible(true);
            if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
          });
        })
        .catch(function (e) {
          alert(e && e.message ? e.message : 'Could not open Drive');
          if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
        });
    }
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.js-drive-import-pick').forEach(function (b) {
        b.addEventListener('click', function () { driveImportPick(b); });
      });
    });
  })();
  </script>
  <% } %>
  <script src="/js/pipeline-bulk-select.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-tags.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-outreach-lists.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-notes.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-paint.js?v=<%= assetVersion %>"></script>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-contact-edit.js?v=<%= assetVersion %>"></script>
  <% } else if (activeTab === 'folders') { %>
  <div id="folderCreateModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderCreateTitle">
    <div id="folderCreateBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderCreateTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">New folder</h2>
      <p class="text-sm text-brand-muted mb-5">Create a subfolder under a system folder or an existing subfolder. Assign leads from the Pipeline tab.</p>
      <label for="folderCreateParent" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Parent folder</label>
      <select id="folderCreateParent" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white mb-3">
        <% const _roots = typeof folderTree !== 'undefined' && folderTree && folderTree.groups ? folderTree.groups.filter(function (g) { return g.isSystem && g.folder; }) : []; %>
        <% _roots.forEach(function (g) {
          if (!g.folder) return;
          var rootJt = g.folder.jobType || '';
        %>
        <optgroup label="<%= g.name %>">
          <option value="<%= g.folder.key %>" data-job-type="<%= rootJt %>"><%= g.name %></option>
          <% (g.childRows || []).forEach(function (row) {
            var child = row.folder;
            if (!child) return;
            var depth = row.depth || 1;
            var prefix = depth > 1 ? '\u21b3 '.repeat(depth) : '\u21b3 ';
            var childJt = child.jobType || rootJt;
          %>
          <option value="<%= child.key %>" data-job-type="<%= childJt %>"><%= prefix %><%= child.name %></option>
          <% }); %>
        </optgroup>
        <% }); %>
        <% const _other = typeof folderTree !== 'undefined' && folderTree && folderTree.groups ? folderTree.groups.find(function (g) { return !g.isSystem && g.key === '__other__'; }) : null; %>
        <% if (_other && (_other.childRows || []).length) { %>
        <optgroup label="Other folders">
          <% (_other.childRows || []).forEach(function (row) {
            var child = row.folder;
            if (!child) return;
            var childJt = child.jobType || '';
          %>
          <option value="<%= child.key %>" data-job-type="<%= childJt %>"><%= child.name %></option>
          <% }); %>
        </optgroup>
        <% } %>
        <option value="">No parent (top-level)</option>
      </select>
      <label for="folderCreateName" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Folder name</label>
      <input id="folderCreateName" type="text" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" placeholder="e.g. HVAC — Phoenix" />
      <p id="folderCreateError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderCreateSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Create</button>
        <button id="folderCreateCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <div id="folderMoveModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderMoveTitle">
    <div id="folderMoveBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderMoveTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">Move folder</h2>
      <p id="folderMoveSubtitle" class="text-sm text-brand-muted mb-5">Choose which system folder or subfolder should contain this folder.</p>
      <input type="hidden" id="folderMoveKey" value="" />
      <label for="folderMoveParent" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Move to</label>
      <select id="folderMoveParent" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white mb-3"></select>
      <p id="folderMoveError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderMoveSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Move folder</button>
        <button id="folderMoveCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <div id="folderSearchSetupModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderSearchSetupTitle">
    <div id="folderSearchSetupBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-2xl w-full max-h-[90vh] overflow-y-auto rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderSearchSetupTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-1">Search setup</h2>
      <p id="folderSearchSetupSubtitle" class="text-sm text-brand-muted mb-5">Save how Find should run for this folder. Location (city/state) is set when you run the search.</p>
      <input type="hidden" id="folderSearchSetupKey" value="" />
      <div class="space-y-4">
        <div>
          <label for="folderSearchJobType" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Search type</label>
          <select id="folderSearchJobType" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold">
            <option value="maps_business">Business</option>
            <option value="real_estate">Real estate</option>
            <option value="home_owners">Home owners</option>
            <option value="products">Products</option>
            <option value="wholesale">Wholesale</option>
          </select>
        </div>
        <div>
          <label for="folderSearchMaxResults" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Max results</label>
          <input type="number" id="folderSearchMaxResults" min="1" max="100" value="25" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold" />
        </div>
        <div id="folderSearchMapsFields" class="space-y-3">
          <div>
            <label for="folderSearchKeyword" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Business keyword</label>
            <input type="text" id="folderSearchKeyword" placeholder="e.g. electrician" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold" />
          </div>
          <%- include('partials/maps_search_criteria', { idPrefix: 'folderSearch', preset: {} }) %>
        </div>
        <div id="folderSearchListingFields" class="space-y-3 hidden">
          <div>
            <label for="folderSearchQuery" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Listing search terms</label>
            <input type="text" id="folderSearchQuery" placeholder="homes for sale, mobile home, wholesale…" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold" />
          </div>
          <%- include('partials/listing_sources_fieldset', { enabledSources: null }) %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="folderSearchMinPrice" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Min price</label>
              <input type="number" id="folderSearchMinPrice" min="0" step="1000" placeholder="Optional" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold" />
            </div>
            <div>
              <label for="folderSearchMaxPrice" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Max price</label>
              <input type="number" id="folderSearchMaxPrice" min="0" step="1000" placeholder="Optional" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold" />
            </div>
          </div>
          <div id="folderSearchReExtras" class="space-y-3 hidden">
            <div>
              <label for="folderSearchReScraper" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Property scraper mode</label>
              <select id="folderSearchReScraper" name="scraper" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800 px-3 py-2.5 text-sm font-semibold">
                <option value="listings">Multi-source listings (recommended)</option>
                <option value="auto">Auto (Apify Zillow → Oxylabs fallback)</option>
                <option value="apify_zillow">Apify Zillow only</option>
                <option value="oxylabs">Oxylabs only</option>
              </select>
            </div>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="folderSearchFlipEnabled" class="mt-1 rounded border-brand-border" />
              <span>
                <span class="font-bold text-sm block">Flip deals only (AI filter)</span>
                <span class="text-[11px] text-brand-muted">Mobile home flip scoring — same as Find → Real estate.</span>
              </span>
            </label>
            <div id="folderSearchFlipFields" class="hidden space-y-3 pl-0 sm:pl-7">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="folderSearchMinFlipScore" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Min flip score</label>
                  <input type="number" id="folderSearchMinFlipScore" value="7" min="1" max="10" step="0.5" class="w-full rounded-xl border px-3 py-2.5 text-sm font-semibold dark:bg-slate-800" />
                </div>
                <div>
                  <label for="folderSearchMinRoi" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Min ROI %</label>
                  <input type="number" id="folderSearchMinRoi" value="15" min="0" max="200" step="5" class="w-full rounded-xl border px-3 py-2.5 text-sm font-semibold dark:bg-slate-800" />
                </div>
              </div>
              <div>
                <label for="folderSearchLandMode" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Land mode</label>
                <select id="folderSearchLandMode" class="w-full rounded-xl border px-3 py-2.5 text-sm font-semibold dark:bg-slate-800">
                  <option value="any">Any tenure</option>
                  <option value="exclude_park">Exclude park / lot rent</option>
                  <option value="prefer_own_land">Prefer land-owned</option>
                  <option value="own_land_only">Own land only</option>
                </select>
              </div>
              <div class="flex flex-wrap gap-3">
                <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                  <input type="checkbox" id="folderSearchRequireOwnLand" class="rounded border-brand-border" />
                  <span class="font-semibold text-xs">Require own-land phrases</span>
                </label>
                <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                  <input type="checkbox" id="folderSearchExcludePark" checked class="rounded border-brand-border" />
                  <span class="font-semibold text-xs">Exclude park / lot rent</span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p id="folderSearchSetupError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderSearchSetupSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Save setup</button>
        <button id="folderSearchSetupCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <script>
  window.FOLDER_DEFAULT_SOURCES = {
    real_estate: ['zillow', 'realtor', 'redfin', 'mhvillage', 'craigslist', 'facebook_marketplace', 'offerup', 'oxylabs', 'web_search'],
    home_owners: ['web_search', 'oxylabs', 'zillow', 'redfin', 'realtor'],
    products: ['facebook_marketplace', 'craigslist', 'offerup', 'ebay'],
    wholesale: ['web_search', 'oxylabs', 'facebook_marketplace', 'craigslist', 'offerup', 'ebay'],
  };
  window.WORKSPACE_FOLDERS = <%- JSON.stringify((folders || []).map(function (f) {
    return { key: f.key, name: f.name, jobType: f.jobType || '', parentFolderKey: f.parentFolderKey || '', searchPreset: f.searchPreset || null, isPipelineDefault: !!f.isPipelineDefault, isTradeFolder: !!f.isTradeFolder };
  })) %>;
  window.FOLDER_TREE_GROUPS = <%- JSON.stringify((folderTree && folderTree.groups || []).map(function (g) {
    return {
      key: g.key,
      name: g.name,
      isSystem: !!g.isSystem,
      folderKey: g.folder && g.folder.key ? g.folder.key : '',
      folderName: g.folder && g.folder.name ? g.folder.name : '',
      childRows: (g.childRows || []).map(function (row) {
        var f = row.folder || {};
        return { key: f.key || '', name: f.name || '', depth: row.depth || 1, isTrade: !!f.isTradeFolder };
      })
    };
  })) %>;
  </script>

  <script>
  (function () {
    function $(id) { return document.getElementById(id); }
    var jsonHeaders = { Accept: 'application/json', 'Content-Type': 'application/json' };

    function bindFolderManager() {
      document.querySelectorAll('.folder-rename').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          var row = btn.closest('[data-folder-row]');
          var currentName = (row && row.getAttribute('data-folder-name')) || '';
          var nextName = window.prompt('Rename folder', currentName);
          if (nextName == null || !String(nextName).trim()) return;
          fetch('/folders/rename', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key, name: String(nextName).trim() })
          })
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function (data) {
              if (!data || !data.success) throw new Error((data && data.error) || 'Failed');
              window.location.reload();
            })
            .catch(function () { window.alert('Could not rename folder.'); });
        });
      });

      document.querySelectorAll('.folder-delete').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          var row = btn.closest('[data-folder-row]');
          var currentName = (row && row.getAttribute('data-folder-name')) || 'this folder';
          var isDefault = row && row.getAttribute('data-folder-is-default') === '1';
          var msg = 'Delete ' + currentName + '? Leads will be unassigned from this folder.';
          if (isDefault) msg += ' This is a system folder — it will not be recreated automatically.';
          if (!window.confirm(msg)) return;
          fetch('/folders/delete', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key })
          })
            .then(function (r) {
              return r.json().then(function (data) { return { ok: r.ok, data: data }; });
            })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Failed');
              }
              window.location.reload();
            })
            .catch(function (err) {
              window.alert(err && err.message ? err.message : 'Could not delete folder.');
            });
        });
      });

      document.querySelectorAll('.folder-search-setup').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          openFolderSearchSetup(key);
        });
      });

      document.querySelectorAll('.folder-move').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          var row = btn.closest('[data-folder-row]');
          var currentName = (row && row.getAttribute('data-folder-name')) || 'Folder';
          var currentParent = (row && row.getAttribute('data-folder-parent-key')) || '';
          openFolderMoveModal(key, currentName, currentParent);
        });
      });
    }

    function collectFolderDescendantKeys(folderKey, folders) {
      var root = String(folderKey || '').trim();
      var blocked = new Set();
      if (!root) return blocked;
      var byParent = new Map();
      (folders || []).forEach(function (f) {
        if (!f || !f.key) return;
        var parent = String(f.parentFolderKey || '').trim();
        if (!parent) return;
        if (!byParent.has(parent)) byParent.set(parent, []);
        byParent.get(parent).push(String(f.key));
      });
      var queue = [root];
      while (queue.length) {
        var k = queue.shift();
        (byParent.get(k) || []).forEach(function (child) {
          if (blocked.has(child)) return;
          blocked.add(child);
          queue.push(child);
        });
      }
      return blocked;
    }

    function populateFolderMoveSelect(movingKey, currentParentKey) {
      var select = $('folderMoveParent');
      if (!select) return;
      var folders = window.WORKSPACE_FOLDERS || [];
      var groups = window.FOLDER_TREE_GROUPS || [];
      var blocked = collectFolderDescendantKeys(movingKey, folders);
      blocked.add(String(movingKey || '').trim());
      select.innerHTML = '';

      var topOpt = document.createElement('option');
      topOpt.value = '';
      topOpt.textContent = 'Other folders (top-level)';
      select.appendChild(topOpt);

      groups.forEach(function (group) {
        var og = document.createElement('optgroup');
        og.label = String(group.name || 'Folders');
        if (group.isSystem && group.folderKey && !blocked.has(group.folderKey)) {
          var rootOpt = document.createElement('option');
          rootOpt.value = group.folderKey;
          rootOpt.textContent = group.folderName || group.name;
          og.appendChild(rootOpt);
        }
        (group.childRows || []).forEach(function (row) {
          if (!row.key || blocked.has(row.key)) return;
          var opt = document.createElement('option');
          opt.value = row.key;
          var prefix = row.depth > 1 ? '\u21b3 '.repeat(row.depth) : '\u21b3 ';
          opt.textContent = prefix + row.name;
          og.appendChild(opt);
        });
        if (og.children.length) select.appendChild(og);
      });

      var desired = String(currentParentKey || '').trim();
      select.value = desired;
      if (select.value !== desired && desired) {
        var fallback = document.createElement('option');
        fallback.value = desired;
        fallback.textContent = 'Current parent';
        select.insertBefore(fallback, select.firstChild.nextSibling);
        select.value = desired;
      }
    }

    function openFolderMoveModal(folderKey, folderName, currentParentKey) {
      var modal = $('folderMoveModal');
      if (!modal) return;
      if ($('folderMoveKey')) $('folderMoveKey').value = folderKey || '';
      if ($('folderMoveTitle')) $('folderMoveTitle').textContent = 'Move “' + (folderName || 'Folder') + '”';
      populateFolderMoveSelect(folderKey, currentParentKey);
      var err = $('folderMoveError');
      if (err) { err.classList.add('hidden'); err.textContent = ''; }
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      if ($('folderMoveParent')) $('folderMoveParent').focus();
    }

    function closeFolderMoveModal() {
      var modal = $('folderMoveModal');
      if (!modal) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      if ($('folderMoveKey')) $('folderMoveKey').value = '';
    }

    function bindFolderMoveModal() {
      var modal = $('folderMoveModal');
      var bd = $('folderMoveBackdrop');
      var cancel = $('folderMoveCancel');
      var save = $('folderMoveSave');
      if (bd) bd.addEventListener('click', closeFolderMoveModal);
      if (cancel) cancel.addEventListener('click', closeFolderMoveModal);
      if (save) {
        save.addEventListener('click', function () {
          var key = ($('folderMoveKey') && $('folderMoveKey').value) || '';
          var parentKey = ($('folderMoveParent') && $('folderMoveParent').value) || '';
          var err = $('folderMoveError');
          if (!key) return;
          save.disabled = true;
          fetch('/folders/move', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ folderKey: key, parentFolderKey: parentKey })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not move folder.');
              }
              closeFolderMoveModal();
              window.location.reload();
            })
            .catch(function (e) {
              if (err) {
                err.textContent = e && e.message ? e.message : 'Could not move folder.';
                err.classList.remove('hidden');
              }
            })
            .finally(function () { save.disabled = false; });
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') closeFolderMoveModal();
      });
    }

    function folderByKey(key) {
      var list = window.WORKSPACE_FOLDERS || [];
      for (var i = 0; i < list.length; i++) {
        if (list[i] && list[i].key === key) return list[i];
      }
      return null;
    }

    function syncFolderSearchJobPanels() {
      var jt = ($('folderSearchJobType') && $('folderSearchJobType').value) || 'maps_business';
      var maps = $('folderSearchMapsFields');
      var listing = $('folderSearchListingFields');
      var reExtras = $('folderSearchReExtras');
      var isListing = jt === 'real_estate' || jt === 'home_owners' || jt === 'products' || jt === 'wholesale';
      if (maps) maps.classList.toggle('hidden', jt !== 'maps_business');
      if (listing) listing.classList.toggle('hidden', !isListing);
      if (reExtras) reExtras.classList.toggle('hidden', jt !== 'real_estate');
      if (isListing) applyListingSourcesForJobType(jt);
    }

    function applyListingSourcesForJobType(jt) {
      var root = $('folderSearchListingFields');
      if (!root) return;
      var defaults = (window.FOLDER_DEFAULT_SOURCES && window.FOLDER_DEFAULT_SOURCES[jt]) || [];
      root.querySelectorAll('[data-listing-source]').forEach(function (cb) {
        var sid = cb.getAttribute('data-listing-source');
        cb.checked = !defaults.length || defaults.indexOf(sid) >= 0;
        var label = cb.closest('label');
        if (label) label.classList.toggle('hidden', defaults.length > 0 && defaults.indexOf(sid) < 0);
      });
    }

    function fillFolderSearchForm(preset, folder) {
      var p = preset || {};
      var jt = p.jobType || (folder && folder.jobType) || 'maps_business';
      if (jt === 'mobile_homes' || (folder && folder.isPipelineDefault && String(folder.name || '').toLowerCase() === 'mobile homes')) {
        jt = 'real_estate';
      }
      if (['real_estate', 'home_owners', 'products', 'wholesale'].indexOf(jt) < 0 && jt !== 'maps_business') {
        jt = 'maps_business';
      }

      if ($('folderSearchJobType')) $('folderSearchJobType').value = jt;
      if ($('folderSearchMaxResults')) $('folderSearchMaxResults').value = String(p.maxResults || 25);
      if ($('folderSearchKeyword')) $('folderSearchKeyword').value = p.keyword || p.query || '';
      if ($('folderSearchMapsProvider')) $('folderSearchMapsProvider').value = p.mapsProvider || 'auto';
      if ($('folderSearchMinRating')) $('folderSearchMinRating').value = p.minRating != null ? String(p.minRating) : '';
      if ($('folderSearchMinReviews')) $('folderSearchMinReviews').value = p.minReviews != null ? String(p.minReviews) : '';
      if ($('folderSearchAutoTags')) {
        $('folderSearchAutoTags').value = Array.isArray(p.autoTags) ? p.autoTags.join(', ') : (p.autoTags || '');
      }
      if ($('folderSearchSearchNotes')) $('folderSearchSearchNotes').value = p.searchNotes || '';
      if ($('folderSearchDirectorySupplement')) {
        $('folderSearchDirectorySupplement').checked = p.directorySupplement !== false;
      }
      if ($('folderSearchReScraper')) $('folderSearchReScraper').value = p.scraper || 'listings';
      if ($('folderSearchQuery')) {
        var defaults = { real_estate: 'homes for sale', home_owners: 'property owner', products: '', wholesale: 'wholesale' };
        $('folderSearchQuery').value = p.query || defaults[jt] || '';
      }
      if ($('folderSearchMinPrice')) $('folderSearchMinPrice').value = p.minPrice != null ? String(p.minPrice) : '';
      if ($('folderSearchMaxPrice')) $('folderSearchMaxPrice').value = p.maxPrice != null ? String(p.maxPrice) : '';

      var ff = p.flipFilter || {};
      var flipOn = !!(ff && ff.enabled);
      if ($('folderSearchFlipEnabled')) $('folderSearchFlipEnabled').checked = flipOn;
      if ($('folderSearchFlipFields')) $('folderSearchFlipFields').classList.toggle('hidden', !flipOn);
      if ($('folderSearchMinFlipScore')) $('folderSearchMinFlipScore').value = String(ff.minFlipScore != null ? ff.minFlipScore : 7);
      if ($('folderSearchMinRoi')) $('folderSearchMinRoi').value = String(ff.minRoiPercent != null ? ff.minRoiPercent : 15);
      if ($('folderSearchLandMode')) $('folderSearchLandMode').value = ff.landMode || 'prefer_own_land';
      if ($('folderSearchRequireOwnLand')) $('folderSearchRequireOwnLand').checked = !!ff.requireOwnLand;
      if ($('folderSearchExcludePark')) $('folderSearchExcludePark').checked = ff.excludeParkRent !== false;

      var listingRoot = $('folderSearchListingFields');
      if (listingRoot && p.sources) applyListingSources(listingRoot, p.sources);

      syncFolderSearchJobPanels();
    }

    function applyListingSources(root, sourceIds) {
      if (!root) return;
      var ids = Array.isArray(sourceIds) ? sourceIds : [];
      root.querySelectorAll('[data-listing-source]').forEach(function (cb) {
        var sid = cb.getAttribute('data-listing-source');
        cb.checked = !ids.length || ids.indexOf(sid) >= 0;
      });
    }

    function openFolderSearchSetup(folderKey) {
      var modal = $('folderSearchSetupModal');
      var folder = folderByKey(folderKey);
      if (!modal || !folder) return;
      if ($('folderSearchSetupKey')) $('folderSearchSetupKey').value = folderKey;
      if ($('folderSearchSetupSubtitle')) {
        $('folderSearchSetupSubtitle').textContent = 'Configure search for "' + (folder.name || 'folder') + '". City/state are chosen when you run search.';
      }
      fillFolderSearchForm(folder.searchPreset, folder);
      var err = $('folderSearchSetupError');
      if (err) { err.classList.add('hidden'); err.textContent = ''; }
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeFolderSearchSetup() {
      var modal = $('folderSearchSetupModal');
      if (!modal) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    function buildFolderSearchPayload() {
      var key = ($('folderSearchSetupKey') && $('folderSearchSetupKey').value) || '';
      var jt = ($('folderSearchJobType') && $('folderSearchJobType').value) || 'maps_business';
      var body = {
        folderKey: key,
        jobType: jt,
        maxResults: parseInt(($('folderSearchMaxResults') && $('folderSearchMaxResults').value) || '25', 10) || 25,
      };
      var isListing = jt === 'real_estate' || jt === 'home_owners' || jt === 'products' || jt === 'wholesale';
      if (isListing) {
        body.query = ($('folderSearchQuery') && $('folderSearchQuery').value) || '';
        body.minPrice = ($('folderSearchMinPrice') && $('folderSearchMinPrice').value) || '';
        body.maxPrice = ($('folderSearchMaxPrice') && $('folderSearchMaxPrice').value) || '';
        var listingRoot = $('folderSearchListingFields');
        if (listingRoot) {
          listingRoot.querySelectorAll('[data-listing-source]').forEach(function (cb) {
            var sid = cb.getAttribute('data-listing-source');
            if (cb.checked && sid) body['source_' + sid] = 'on';
          });
        }
        if (jt === 'real_estate') {
          body.scraper = ($('folderSearchReScraper') && $('folderSearchReScraper').value) || 'listings';
          if ($('folderSearchFlipEnabled') && $('folderSearchFlipEnabled').checked) {
            body.flipFilterEnabled = 'on';
            body.minFlipScore = ($('folderSearchMinFlipScore') && $('folderSearchMinFlipScore').value) || '7';
            body.minRoiPercent = ($('folderSearchMinRoi') && $('folderSearchMinRoi').value) || '15';
            body.flipLandMode = ($('folderSearchLandMode') && $('folderSearchLandMode').value) || 'prefer_own_land';
            if ($('folderSearchRequireOwnLand') && $('folderSearchRequireOwnLand').checked) body.flipRequireOwnLand = 'on';
            if ($('folderSearchExcludePark') && $('folderSearchExcludePark').checked) body.flipExcludePark = 'on';
          }
        }
      } else {
        body.keyword = ($('folderSearchKeyword') && $('folderSearchKeyword').value) || 'plumber';
        body.mapsProvider = ($('folderSearchMapsProvider') && $('folderSearchMapsProvider').value) || 'auto';
        body.minRating = ($('folderSearchMinRating') && $('folderSearchMinRating').value) || '';
        body.minReviews = ($('folderSearchMinReviews') && $('folderSearchMinReviews').value) || '';
        body.autoTags = ($('folderSearchAutoTags') && $('folderSearchAutoTags').value) || '';
        body.searchNotes = ($('folderSearchSearchNotes') && $('folderSearchSearchNotes').value) || '';
        if ($('folderSearchDirectorySupplement') && $('folderSearchDirectorySupplement').checked) {
          body.directorySupplement = 'on';
        }
      }
      return body;
    }

    function bindFolderSearchSetupModal() {
      var modal = $('folderSearchSetupModal');
      var bd = $('folderSearchSetupBackdrop');
      var cancel = $('folderSearchSetupCancel');
      var save = $('folderSearchSetupSave');
      var jobSel = $('folderSearchJobType');
      var flipCb = $('folderSearchFlipEnabled');
      var err = $('folderSearchSetupError');

      if (jobSel) jobSel.addEventListener('change', syncFolderSearchJobPanels);
      if (flipCb) {
        flipCb.addEventListener('change', function () {
          if ($('folderSearchFlipFields')) {
            $('folderSearchFlipFields').classList.toggle('hidden', !flipCb.checked);
          }
        });
      }
      if (bd) bd.addEventListener('click', closeFolderSearchSetup);
      if (cancel) cancel.addEventListener('click', closeFolderSearchSetup);
      if (save) {
        save.addEventListener('click', function () {
          var body = buildFolderSearchPayload();
          if (!body.folderKey) return;
          fetch('/folders/save-search-preset', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify(body),
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not save search setup.');
              }
              closeFolderSearchSetup();
              window.location.reload();
            })
            .catch(function (e) {
              if (err) {
                err.textContent = e && e.message ? e.message : 'Could not save search setup.';
                err.classList.remove('hidden');
              }
            });
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') closeFolderSearchSetup();
      });
    }

    function bindFolderCreateModal() {
      var m = $('folderCreateModal');
      var openBtn = $('folderCreateOpen');
      var bd = $('folderCreateBackdrop');
      var cancel = $('folderCreateCancel');
      var save = $('folderCreateSave');
      var nameIn = $('folderCreateName');
      var err = $('folderCreateError');

      function openM() {
        if (!m) return;
        m.style.display = 'flex';
        m.setAttribute('aria-hidden', 'false');
        if (nameIn) {
          nameIn.value = '';
          nameIn.focus();
        }
        if (err) { err.classList.add('hidden'); err.textContent = ''; }
      }
      function closeM() {
        if (!m) return;
        m.style.display = 'none';
        m.setAttribute('aria-hidden', 'true');
        if (nameIn) nameIn.value = '';
      }

      if (openBtn) openBtn.addEventListener('click', function (e) { e.preventDefault(); openM(); });
      if (bd) bd.addEventListener('click', closeM);
      if (cancel) cancel.addEventListener('click', closeM);
      if (save) {
        save.addEventListener('click', function () {
          var n = (nameIn && nameIn.value || '').trim();
          if (!n) {
            if (err) { err.textContent = 'Enter a folder name.'; err.classList.remove('hidden'); }
            return;
          }
          fetch('/folders', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({
              name: n,
              parentFolderKey: ($('folderCreateParent') && $('folderCreateParent').value) || '',
              jobType: (function () {
                var sel = $('folderCreateParent');
                if (!sel || !sel.value) return '';
                var opt = sel.options[sel.selectedIndex];
                return opt && opt.getAttribute('data-job-type') ? opt.getAttribute('data-job-type') : '';
              })()
            })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not create folder.');
              }
              closeM();
              window.location.reload();
            })
            .catch(function (e) {
              if (err) { err.textContent = e && e.message ? e.message : 'Could not create folder.'; err.classList.remove('hidden'); }
            });
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && m && m.style.display === 'flex') closeM();
      });
    }

    function bindFolderTreeToggle() {
      document.querySelectorAll('.folder-tree-expand').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var node = btn.closest('[data-folder-tree-node]');
          var children = node && node.querySelector(':scope > [data-folder-tree-children]');
          if (!children) return;
          children.classList.toggle('hidden');
          var isOpen = !children.classList.contains('hidden');
          btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          btn.textContent = isOpen ? '\u25BC' : '\u25B6';
        });
      });
    }

    function bindFolderSearchFilter() {
      var input = $('folderSearchFilter');
      var empty = $('folderSearchEmpty');
      if (!input) return;

      function collapseAllTreeBranches() {
        document.querySelectorAll('[data-folder-tree-children]').forEach(function (el) {
          el.classList.add('hidden');
        });
        document.querySelectorAll('.folder-tree-expand').forEach(function (btn) {
          btn.textContent = '\u25B6';
          btn.setAttribute('aria-expanded', 'false');
        });
      }

      function revealFolderTreeAncestors(node) {
        while (node) {
          node.classList.remove('hidden');
          var parentList = node.parentElement;
          if (!parentList || !parentList.hasAttribute('data-folder-tree-children')) break;
          parentList.classList.remove('hidden');
          var parentNode = parentList.closest('[data-folder-tree-node]');
          if (parentNode) {
            var btn = parentNode.querySelector(':scope > div > .folder-tree-expand');
            if (btn) {
              btn.textContent = '\u25BC';
              btn.setAttribute('aria-expanded', 'true');
            }
            node = parentNode;
          } else {
            break;
          }
        }
      }

      function applyFilter() {
        var q = String(input.value || '').trim().toLowerCase();
        var anyVisible = false;
        document.querySelectorAll('.folder-group').forEach(function (group) {
          var groupMatch = !q || String(group.getAttribute('data-folder-group-search') || '').indexOf(q) >= 0;
          var visibleNodes = new Set();

          if (!q) {
            group.querySelectorAll('[data-folder-tree-node]').forEach(function (node) {
              node.classList.remove('hidden');
            });
            collapseAllTreeBranches();
          } else {
            group.querySelectorAll('.folder-row').forEach(function (row) {
              if (String(row.getAttribute('data-folder-search') || '').indexOf(q) < 0) return;
              var n = row.closest('[data-folder-tree-node]');
              while (n && group.contains(n)) {
                visibleNodes.add(n);
                var parentList = n.parentElement;
                if (!parentList || !parentList.hasAttribute('data-folder-tree-children')) break;
                n = parentList.closest('[data-folder-tree-node]');
              }
            });
            group.querySelectorAll('[data-folder-tree-node]').forEach(function (node) {
              var show = groupMatch || visibleNodes.has(node);
              node.classList.toggle('hidden', !show);
              if (show && visibleNodes.has(node)) revealFolderTreeAncestors(node);
            });
          }

          var showGroup = !q || groupMatch || visibleNodes.size > 0;
          group.classList.toggle('hidden', !showGroup);
          if (showGroup) anyVisible = true;
          if (q && showGroup && visibleNodes.size > 0) group.open = true;
        });
        if (empty) empty.classList.toggle('hidden', !q || anyVisible);
      }
      input.addEventListener('input', applyFilter);
    }

    function init() {
      bindFolderManager();
      bindFolderTreeToggle();
      bindFolderCreateModal();
      bindFolderMoveModal();
      bindFolderSearchSetupModal();
      bindFolderSearchFilter();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>
  <%- include('partials/footer') %>
  <% } else { %>
  <%- include('partials/footer') %>
  <% } %>
</body>
</html>
