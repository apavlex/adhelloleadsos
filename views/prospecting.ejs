<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <% if (typeof tab !== 'undefined' && tab === 'pipeline') { %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <% } %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide w-full min-w-0 px-6 py-10 md:py-14">
    <% const activeTab = typeof tab !== 'undefined' ? tab : 'queue'; %>
    <% if (activeTab === 'pipeline') { %>
      <%- include('partials/prospecting_board') %>
    <% } else if (activeTab === 'queue') { %>
      <%- include('partials/scheduled_jobs_content', {
        scheduledJobsEmbed: true,
        scheduleSuccess: typeof scheduleSuccess !== 'undefined' && scheduleSuccess,
        schedules: typeof schedules !== 'undefined' ? schedules : [],
        scheduleDeleteReturnTo: '/prospecting?tab=queue'
      }) %>
    <% } else { %>
      <% 
        var _folderCounts = {};
        (folderListLeads || []).forEach(function (l) {
          var fk = String((l && l.folderKey) || '').trim();
          if (!fk) return;
          _folderCounts[fk] = (_folderCounts[fk] || 0) + 1;
        });
      %>
      <section class="space-y-8" aria-label="Folder manager">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-1.5 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
              <span class="w-2 h-2 rounded-full bg-brand-yellow"></span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Outreach folders</span>
            </div>
            <h2 class="font-display font-black text-3xl md:text-4xl text-brand-dark dark:text-white tracking-tight">Folder manager</h2>
            <p class="text-sm text-brand-muted mt-2 max-w-2xl">Create, rename, and remove folders here. <strong class="text-brand-dark dark:text-white">Open leads</strong> jumps to the pipeline for that folder. You can also pick a folder under <strong class="text-brand-dark dark:text-white">Search &amp; refine</strong> on the Pipeline tab. Assign or re-file leads with row checkboxes → <strong class="text-brand-dark dark:text-white">Move</strong> in the floating bar.</p>
          </div>
          <button type="button" id="folderCreateOpen" class="btn-pill btn-primary px-6 md:px-8 py-3.5 text-[10px] font-black uppercase tracking-widest shrink-0 inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            New folder
          </button>
        </div>

        <% if (!(folders || []).length) { %>
          <div class="brand-card p-14 md:p-20 text-center dark:bg-slate-900 dark:border-white/10">
            <p class="text-brand-muted mb-6 max-w-md mx-auto">No folders yet. Create one to organize outreach (e.g. Referrals, Events, High-priority).</p>
          </div>
        <% } else { %>
          <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10">
            <ul class="divide-y divide-brand-border/40 dark:divide-white/10">
              <% (folders || []).forEach((f) => { %>
                <% var _fc = _folderCounts[f.key] || 0; %>
                <li class="folder-row flex flex-wrap items-center gap-4 px-6 py-5 hover:bg-brand-cream/25 dark:hover:bg-white/5 transition-colors" data-folder-row="<%= f.key %>" data-folder-name="<%= f.name %>">
                  <div class="min-w-0 flex-1">
                    <p class="font-display font-bold text-lg text-brand-dark dark:text-white"><%= f.name %></p>
                    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mt-1"><%= _fc %> lead<%= _fc === 1 ? '' : 's' %> in this folder</p>
                  </div>
                  <div class="flex flex-wrap items-center gap-2 shrink-0">
                    <a href="/prospecting?tab=pipeline&amp;folderKey=<%= encodeURIComponent(f.key) %>" class="px-4 py-2.5 rounded-xl bg-brand-yellow text-brand-dark border border-brand-yellow text-[10px] font-black uppercase tracking-widest hover:brightness-105 transition-colors shadow-sm">Open leads</a>
                    <button type="button" class="folder-rename px-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" data-folder-key="<%= f.key %>">Rename</button>
                    <button type="button" class="folder-delete px-4 py-2.5 rounded-xl bg-white dark:bg-red-950/30 border border-red-200/70 dark:border-red-900/50 text-[10px] font-black uppercase tracking-widest text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/50 transition-colors" data-folder-key="<%= f.key %>">Remove</button>
                  </div>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>

  <% if (activeTab === 'pipeline') { %>
  <%- include('partials/leads_interactive_tail', { leads: typeof leads !== 'undefined' ? leads : [], pipelineStages, folders, tags: typeof tags !== 'undefined' ? tags : [], activeFolderKey: typeof activeFolderKey !== 'undefined' ? activeFolderKey : '', scriptLibraryOfferPicklist: Array.isArray(locals.scriptLibraryOfferPicklist) ? locals.scriptLibraryOfferPicklist : [], outreachChannelLibrary: locals.outreachChannelLibrary && typeof locals.outreachChannelLibrary === 'object' ? locals.outreachChannelLibrary : {} }) %>
  <script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      var input = document.getElementById('leadsCsvFile');
      var hint = document.getElementById('csvFileAttachHint');
      var nameEl = document.getElementById('csvFileNameDisplay');
      var form = document.getElementById('leadsCsvImportForm');
      var uploadButton = document.getElementById('leadsCsvUploadButton');
      var uploadSpinner = document.getElementById('leadsCsvUploadSpinner');
      if (!input) return;

      function closePipelineMenus(except) {
        document.querySelectorAll('[data-pipeline-menu]').forEach(function (menu) {
          if (except && menu === except) return;
          var panel = menu.querySelector('[data-pipeline-menu-panel]');
          var trigger = menu.querySelector('[data-pipeline-menu-trigger]');
          if (panel) panel.classList.add('hidden');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });
      }

      document.querySelectorAll('[data-pipeline-menu]').forEach(function (menu) {
        var trigger = menu.querySelector('[data-pipeline-menu-trigger]');
        var panel = menu.querySelector('[data-pipeline-menu-panel]');
        if (!trigger || !panel) return;
        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = !panel.classList.contains('hidden');
          closePipelineMenus();
          if (!open) {
            panel.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
        panel.querySelectorAll('button, a').forEach(function (item) {
          item.addEventListener('click', function () {
            closePipelineMenus();
          });
        });
      });
      document.addEventListener('click', function () {
        closePipelineMenus();
      });

      document.querySelectorAll('.js-import-computer').forEach(function (btn) {
        btn.addEventListener('click', function () {
          input.click();
        });
      });

      function beginImportUi(filename) {
        if (nameEl && filename) nameEl.textContent = filename;
        if (hint) {
          hint.classList.remove('hidden');
          hint.classList.add('flex');
        }
        if (uploadButton) uploadButton.disabled = true;
        if (uploadSpinner) uploadSpinner.classList.remove('hidden');
      }

      input.addEventListener('change', function () {
        var f = input.files && input.files[0];
        if (!f || !form) return;
        beginImportUi(f.name);
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.submit();
      });

      if (form && uploadButton) {
        form.addEventListener('submit', function () {
          uploadButton.disabled = true;
          uploadButton.setAttribute('aria-busy', 'true');
          if (uploadSpinner) uploadSpinner.classList.remove('hidden');
        });
      }
      var params = new URLSearchParams(window.location.search);
      if (params.get('action') === 'import' && input) {
        setTimeout(function () {
          input.click();
        }, 400);
        params.delete('action');
        var clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
        window.history.replaceState({}, '', clean);
      }
    });
  })();
  </script>
  <script src="/js/httpJson.js?v=<%= assetVersion %>"></script>
  <script src="/js/socialBrandIcons.js?v=<%= assetVersion %>"></script>
  <% if (typeof driveImport !== 'undefined' && driveImport && driveImport.pickerReady) { %>
  <script>
  (function () {
    window.__DRIVE_IMPORT__ = <%- JSON.stringify({
      developerKey: driveImport.pickerApiKey || '',
      appId: driveImport.googleClientId || ''
    }) %>;
    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    function ensurePicker(cb) {
      if (window.google && google.picker) return cb();
      if (window.gapi && gapi.load) {
        gapi.load('picker', function () { cb(); });
        return;
      }
      loadScript('https://apis.google.com/js/api.js').then(function () {
        gapi.load('picker', function () { cb(); });
      }).catch(function () { alert('Could not load Google Picker.'); });
    }
    function driveImportPick(btn) {
      if (!btn) btn = document.querySelector('.js-drive-import-pick');
      var cfg = window.__DRIVE_IMPORT__ || {};
      var dk = cfg.developerKey;
      var appId = cfg.appId;
      if (!dk) {
        alert('Picker API key is not configured.');
        return;
      }
      if (!appId) {
        alert('Google OAuth client ID is not configured.');
        return;
      }
      if (btn) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
      }
      var fetchJsonFn = typeof window.fetchJson === 'function' ? window.fetchJson : null;
      var tokenReq = fetchJsonFn
        ? fetchJsonFn('/leads/google-drive/access-token', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          })
        : fetch('/leads/google-drive/access-token', { credentials: 'same-origin' }).then(function (r) {
            return r.json().then(function (j) { return { ok: r.ok, j: j }; });
          });
      tokenReq
        .then(function (pack) {
          if (!pack.ok || !pack.j || !pack.j.success || !pack.j.accessToken) {
            throw new Error((pack.j && pack.j.error) || 'Not signed in to Google Drive. Use Connect Google Drive.');
          }
          var oauthToken = pack.j.accessToken;
          ensurePicker(function () {
            var view = new google.picker.DocsView(google.picker.ViewId.DOCUMENTS)
              .setIncludeFolders(true)
              .setMimeTypes('text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.google-apps.spreadsheet');
            var picker = new google.picker.PickerBuilder()
              .setOAuthToken(oauthToken)
              .setDeveloperKey(dk)
              .setAppId(appId)
              .addView(view)
              .setTitle('Select CSV, XLSX, or Google Sheet')
              .setCallback(function (data) {
                var action = data[google.picker.Response.ACTION];
                if (action === google.picker.Action.CANCEL) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                if (action !== google.picker.Action.PICKED) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                var docs = data[google.picker.Response.DOCUMENTS];
                var doc = docs && docs[0];
                var fileId = doc && doc[google.picker.Document.ID];
                if (!fileId) {
                  if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  return;
                }
                if (btn) {
                  btn.disabled = true;
                  btn.setAttribute('aria-busy', 'true');
                }
                var importReq = fetchJsonFn
                  ? fetchJsonFn('/leads/drive-import/google', {
                      method: 'POST',
                      credentials: 'same-origin',
                      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                      body: JSON.stringify({ fileId: fileId }),
                    })
                  : fetch('/leads/drive-import/google', {
                      method: 'POST',
                      credentials: 'same-origin',
                      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                      body: JSON.stringify({ fileId: fileId }),
                    }).then(function (r) {
                      return r.json().then(function (j) { return { ok: r.ok, j: j }; });
                    });
                importReq
                  .then(function (imp) {
                    if (!imp.ok || !imp.j || !imp.j.success) {
                      throw new Error((imp.j && imp.j.error) || 'Import failed');
                    }
                    var j = imp.j;
                    var q = 'tab=pipeline&rows=' + encodeURIComponent(j.totalRows || 0)
                      + '&rawRows=' + encodeURIComponent(j.rawRows != null ? j.rawRows : j.totalRows || 0)
                      + '&rejected=' + encodeURIComponent(j.rejected || 0)
                      + '&created=' + encodeURIComponent(j.created || 0)
                      + '&updated=' + encodeURIComponent(j.updated || 0)
                      + '&imported=' + encodeURIComponent(j.imported || 0)
                      + '&skipped=' + encodeURIComponent(j.skipped || 0)
                      + '&failed=' + encodeURIComponent(j.failed || 0);
                    window.location.href = '/prospecting?' + q;
                  })
                  .catch(function (e) {
                    alert(e && e.message ? e.message : 'Import failed');
                    if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
                  });
              })
              .build();
            picker.setVisible(true);
            if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
          });
        })
        .catch(function (e) {
          alert(e && e.message ? e.message : 'Could not open Drive');
          if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
        });
    }
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.js-drive-import-pick').forEach(function (b) {
        b.addEventListener('click', function () { driveImportPick(b); });
      });
    });
  })();
  </script>
  <% } %>
  <script src="/js/pipeline-bulk-select.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-tags.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-outreach-lists.js?v=<%= assetVersion %>"></script>
  <script src="/js/lead-panel-paint.js?v=<%= assetVersion %>"></script>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <% } else if (activeTab === 'folders') { %>
  <div id="folderCreateModal" class="fixed inset-0 z-[6000] flex items-center justify-center p-4" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="folderCreateTitle">
    <div id="folderCreateBackdrop" class="absolute inset-0 bg-brand-dark/60 backdrop-blur-sm cursor-pointer" tabindex="-1"></div>
    <div class="relative max-w-md w-full rounded-[2rem] border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 p-8 shadow-2xl z-10">
      <h2 id="folderCreateTitle" class="font-display font-black text-xl text-brand-dark dark:text-white mb-2">New folder</h2>
      <p class="text-sm text-brand-muted mb-5">Create a folder to organize leads. Assign them from the Pipeline tab.</p>
      <input id="folderCreateName" type="text" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white" placeholder="e.g. Referrals" />
      <p id="folderCreateError" class="text-sm text-red-600 dark:text-red-400 mt-3 hidden"></p>
      <div class="flex gap-3 mt-6">
        <button id="folderCreateSave" type="button" class="flex-1 btn-pill btn-primary py-4 text-xs font-black uppercase tracking-widest">Create</button>
        <button id="folderCreateCancel" type="button" class="flex-1 btn-pill bg-brand-cream dark:bg-slate-800 border border-brand-border dark:border-white/10 py-4 text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <script>
  (function () {
    function $(id) { return document.getElementById(id); }
    var jsonHeaders = { Accept: 'application/json', 'Content-Type': 'application/json' };

    function bindFolderManager() {
      document.querySelectorAll('.folder-rename').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          var row = btn.closest('[data-folder-row]');
          var currentName = (row && row.getAttribute('data-folder-name')) || '';
          var nextName = window.prompt('Rename folder', currentName);
          if (nextName == null || !String(nextName).trim()) return;
          fetch('/folders/' + encodeURIComponent(key) + '/rename', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ name: String(nextName).trim() })
          })
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function (data) {
              if (!data || !data.success) throw new Error((data && data.error) || 'Failed');
              window.location.reload();
            })
            .catch(function () { window.alert('Could not rename folder.'); });
        });
      });

      document.querySelectorAll('.folder-delete').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var key = btn.getAttribute('data-folder-key') || '';
          var row = btn.closest('[data-folder-row]');
          var currentName = (row && row.getAttribute('data-folder-name')) || 'this folder';
          if (!window.confirm('Delete ' + currentName + '? Leads will be unassigned from this folder.')) return;
          fetch('/folders/' + encodeURIComponent(key) + '/delete', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({})
          })
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function (data) {
              if (!data || !data.success) throw new Error('Failed');
              window.location.reload();
            })
            .catch(function () { window.alert('Could not delete folder.'); });
        });
      });
    }

    function bindFolderCreateModal() {
      var m = $('folderCreateModal');
      var openBtn = $('folderCreateOpen');
      var bd = $('folderCreateBackdrop');
      var cancel = $('folderCreateCancel');
      var save = $('folderCreateSave');
      var nameIn = $('folderCreateName');
      var err = $('folderCreateError');

      function openM() {
        if (!m) return;
        m.style.display = 'flex';
        m.setAttribute('aria-hidden', 'false');
        if (nameIn) {
          nameIn.value = '';
          nameIn.focus();
        }
        if (err) { err.classList.add('hidden'); err.textContent = ''; }
      }
      function closeM() {
        if (!m) return;
        m.style.display = 'none';
        m.setAttribute('aria-hidden', 'true');
        if (nameIn) nameIn.value = '';
      }

      if (openBtn) openBtn.addEventListener('click', function (e) { e.preventDefault(); openM(); });
      if (bd) bd.addEventListener('click', closeM);
      if (cancel) cancel.addEventListener('click', closeM);
      if (save) {
        save.addEventListener('click', function () {
          var n = (nameIn && nameIn.value || '').trim();
          if (!n) {
            if (err) { err.textContent = 'Enter a folder name.'; err.classList.remove('hidden'); }
            return;
          }
          fetch('/folders', {
            method: 'POST',
            credentials: 'same-origin',
            headers: jsonHeaders,
            body: JSON.stringify({ name: n })
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (pack) {
              if (!pack.ok || !pack.data || !pack.data.success) {
                throw new Error((pack.data && pack.data.error) || 'Could not create folder.');
              }
              closeM();
              window.location.reload();
            })
            .catch(function (e) {
              if (err) { err.textContent = e && e.message ? e.message : 'Could not create folder.'; err.classList.remove('hidden'); }
            });
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && m && m.style.display === 'flex') closeM();
      });
    }

    function init() {
      bindFolderManager();
      bindFolderCreateModal();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>
  <%- include('partials/footer') %>
  <% } else { %>
  <%- include('partials/footer') %>
  <% } %>
</body>
</html>
