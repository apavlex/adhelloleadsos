<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: typeof title !== 'undefined' ? title : 'Tags' }) %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Workspace</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Tags</h1>
        <p class="text-sm text-brand-muted dark:text-slate-400 mt-2 max-w-xl">Create, rename, and delete tags used on leads. Tags sync to Go High Level when you push contacts.</p>
      </div>
      <a href="/prospecting?tab=pipeline" class="btn-pill border border-brand-border dark:border-white/15 bg-white dark:bg-slate-800 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors shrink-0">Back to pipeline</a>
    </div>

    <div class="brand-card p-6 md:p-8 dark:bg-slate-900 dark:border-white/10 mb-8">
      <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Create tag</h2>
      <form id="tagsManageCreateForm" class="flex flex-wrap items-end gap-3">
        <div class="flex-1 min-w-[12rem]">
          <label for="tagsManageNewName" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Tag name</label>
          <input type="text" id="tagsManageNewName" name="name" maxlength="80" required placeholder="e.g. Direct Mail List" autocomplete="off" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-3 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50 focus:ring-2 focus:ring-brand-yellow" />
        </div>
        <button type="submit" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest">Create tag</button>
      </form>
    </div>

    <p id="tagsManageMsg" class="hidden mb-4 text-sm rounded-xl px-4 py-3" role="status" aria-live="polite"></p>

    <div class="brand-card overflow-hidden dark:bg-slate-900 dark:border-white/10">
      <div class="px-6 py-4 border-b border-brand-border/30 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display font-bold text-lg text-brand-dark dark:text-white">All tags</h2>
        <span id="tagsManageCount" class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= (typeof tags !== 'undefined' && Array.isArray(tags)) ? tags.length : 0 %> tags</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left" id="tagsManageTable">
          <thead>
            <tr class="border-b border-brand-border/25 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/40">
              <th class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted w-12">Color</th>
              <th class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted">Name</th>
              <th class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted w-28">Quick add</th>
              <th class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted w-28">Leads</th>
              <th class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-brand-muted w-40 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="tagsManageBody">
            <% const _tags = (typeof tags !== 'undefined' && Array.isArray(tags)) ? tags : []; %>
            <% if (!_tags.length) { %>
            <tr id="tagsManageEmptyRow">
              <td colspan="5" class="px-6 py-12 text-center text-sm text-brand-muted dark:text-slate-400">No tags yet. Create one above or from a lead panel.</td>
            </tr>
            <% } else { %>
            <% _tags.forEach(function (tag) {
              if (!tag || !tag.key) return;
              const color = tag.color || '#94a3b8';
              const name = String(tag.name || 'Tag');
              const count = typeof tag.leadCount === 'number' ? tag.leadCount : 0;
              const isActive = tag.isActive !== false;
            %>
            <tr class="border-b border-brand-border/15 dark:border-white/[0.07] tags-manage-row" data-tag-key="<%= tag.key.replace(/"/g, '&quot;') %>" data-tag-active="<%= isActive ? '1' : '0' %>">
              <td class="px-4 py-3 align-middle">
                <span class="inline-block w-4 h-4 rounded-full border border-black/10 dark:border-white/15" style="background:<%= color %>" aria-hidden="true"></span>
              </td>
              <td class="px-4 py-3 align-middle">
                <input type="text" class="tags-manage-name w-full max-w-md rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" value="<%= name.replace(/"/g, '&quot;') %>" maxlength="80" data-original-name="<%= name.replace(/"/g, '&quot;') %>" />
              </td>
              <td class="px-4 py-3 align-middle">
                <button type="button" class="tags-manage-active-toggle inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border transition-colors <%= isActive ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'border-brand-border/50 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/60 text-brand-muted' %>" aria-pressed="<%= isActive ? 'true' : 'false' %>" title="<%= isActive ? 'Shown as quick-add on lead panel' : 'Hidden from lead panel add list' %>"><%= isActive ? 'Active' : 'Inactive' %></button>
              </td>
              <td class="px-4 py-3 align-middle">
                <% if (count > 0) { %>
                <a href="/prospecting?tab=pipeline&amp;tagKey=<%= encodeURIComponent(tag.key) %>" class="text-sm font-bold text-brand-dark dark:text-white tabular-nums hover:text-brand-yellow transition-colors"><%= count %></a>
                <% } else { %>
                <span class="text-sm font-semibold text-brand-muted tabular-nums">0</span>
                <% } %>
              </td>
              <td class="px-4 py-3 align-middle text-right whitespace-nowrap">
                <button type="button" class="tags-manage-save btn-pill bg-brand-yellow text-brand-dark px-3 py-1.5 text-[9px] font-black uppercase tracking-widest mr-2 disabled:opacity-40" disabled>Save</button>
                <button type="button" class="tags-manage-delete text-[10px] font-black uppercase tracking-widest text-red-500 hover:text-red-600 px-2 py-1">Delete</button>
              </td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    window.WORKSPACE_TAGS = <%- JSON.stringify(typeof tags !== 'undefined' ? tags : []) %>;
  </script>
  <script src="/js/tags-manage.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>
