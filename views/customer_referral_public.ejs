<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title><%= typeof missing !== 'undefined' && missing ? 'Link not found' : ('Referred to ' + (company || 'us')) %></title>
  <link rel="stylesheet" href="/css/member-app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <style>
    body.cr-public { background: linear-gradient(165deg, #f4f7fb 0%, #eef2f7 45%, #e8edf4 100%); min-height: 100vh; }
    .cr-wrap { max-width: 420px; margin: 0 auto; padding: 28px 18px 48px; }
    .cr-brand { font-family: var(--font-display, Georgia, serif); font-size: 22px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 6px; }
    .cr-lead { color: var(--muted); font-weight: 600; font-size: 15px; line-height: 1.4; margin: 0 0 18px; }
    .cr-card { background: var(--card, #fff); border: 1px solid var(--line, #e5e7eb); border-radius: 18px; padding: 18px; }
  </style>
</head>
<body class="cr-public">
  <main class="cr-wrap">
    <% if (typeof missing !== 'undefined' && missing) { %>
    <h1 class="cr-brand">Link not found</h1>
    <p class="cr-lead">This referral link isn’t valid anymore. Ask your friend for a new one.</p>
    <% } else if (typeof done !== 'undefined' && done) { %>
    <h1 class="cr-brand">You’re in</h1>
    <p class="cr-lead"><strong><%= company %></strong> got your info — referred by <%= referrerName %>. They’ll be in touch soon.</p>
    <% } else { %>
    <h1 class="cr-brand"><%= company %></h1>
    <p class="cr-lead"><strong><%= referrerName %></strong> sent you — tell <%= company %> how to reach you.</p>
    <% if (flash && flash.error) { %>
    <p class="ma-flash ma-flash--err"><%= flash.error %></p>
    <% } %>
    <% const fv = typeof formValues !== 'undefined' && formValues ? formValues : {}; %>
    <form method="post" action="/rf/<%= code %>" class="cr-card" autocomplete="on">
      <div class="ma-field">
        <label class="ma-label" for="crName">Your name</label>
        <input id="crName" name="name" class="ma-input" maxlength="120" value="<%= fv.name || '' %>" autocapitalize="words">
      </div>
      <div class="ma-field">
        <label class="ma-label" for="crPhone">Phone</label>
        <input id="crPhone" name="phone" type="tel" inputmode="tel" class="ma-input" maxlength="40" value="<%= fv.phone || '' %>">
      </div>
      <div class="ma-field">
        <label class="ma-label" for="crEmail">Email</label>
        <input id="crEmail" name="email" type="email" inputmode="email" class="ma-input" maxlength="120" value="<%= fv.email || '' %>">
      </div>
      <div class="ma-field">
        <label class="ma-label" for="crNote">What do you need? <span class="ma-label__hint">(optional)</span></label>
        <textarea id="crNote" name="note" class="ma-textarea" rows="3" maxlength="500" placeholder="e.g. Looking for a quote this week"><%= fv.note || '' %></textarea>
      </div>
      <button type="submit" class="ma-btn ma-btn--block">Send my info</button>
    </form>
    <% } %>
  </main>
</body>
</html>
