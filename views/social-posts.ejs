<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .platform-tab { transition: all .15s ease; }
    .platform-tab.active { background: var(--brand-yellow); color: #111827; font-weight: 800; }
    .platform-tab:not(.active) { background: transparent; color: var(--brand-muted); border: 1px solid var(--brand-border); }
    .platform-tab:not(.active):hover { border-color: var(--brand-yellow); color: var(--brand-yellow); }
    .post-card { transition: box-shadow .15s ease; }
    .post-card:hover { box-shadow: 0 4px 24px rgba(255,214,68,.12); }
    .post-card-thumb { aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; margin-bottom: 12px; position: relative; }
    .post-card-thumb:hover { transform: scale(1.02); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .post-card-thumb .thumb-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.35); opacity: 0; transition: opacity .15s ease; }
    .post-card-thumb:hover .thumb-overlay { opacity: 1; }
    .post-card-thumb .thumb-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #fff; background: rgba(0,0,0,.5); padding: 4px 10px; border-radius: 9999px; }
    .post-card .edit-area { display: none; }
    .post-card.editing .edit-area { display: block; }
    .post-card.editing .preview-area { display: none; }
    .copy-toast { animation: fadeInOut 2s ease forwards; }
    @keyframes fadeInOut { 0%{opacity:0;transform:translateY(8px)} 15%{opacity:1;transform:translateY(0)} 85%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(-8px)} }
    .style-tag { font-size: 10px; padding: 2px 8px; border-radius: 9999px; background: rgba(255,214,68,.15); color: var(--brand-yellow); font-weight: 700; }
    .action-btn { transition: all .15s ease; }
    .action-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(255,214,68,.2); }
    .calendar-day { min-height: 80px; transition: all .15s ease; }
    .calendar-day:hover { background: rgba(255,214,68,.05); }
    .calendar-day.today { border-color: var(--brand-yellow); background: rgba(255,214,68,.08); }
    .calendar-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
    .hashtag-pill { font-size: 10px; padding: 3px 10px; border-radius: 9999px; background: rgba(255,214,68,.1); color: var(--brand-yellow); font-weight: 700; border: 1px solid rgba(255,214,68,.2); cursor: pointer; transition: all .15s ease; }
    .hashtag-pill:hover { background: rgba(255,214,68,.25); }
    .hashtag-pill.copied { background: var(--brand-yellow); color: #111827; }
    .icon-flat { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .icon-flat-sm { width: 12px; height: 12px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  </style>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-4 sm:px-6 py-8 md:py-10">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Content</p>
        <div class="page-heading-with-tip">
          <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Social Post Ideas</h1>
          <%- include('/partials/app_info_tip', {
            tipId: 'social-posts-help',
            tipKey: 'social-posts',
            label: 'Social post ideas',
            size: 'md',
            content: 'Post ideas scoped to your workspace business profile. Bookmark favorites into folders, then open Marketing Studio from any card thumbnail to generate artwork.'
          }) %>
        </div>
        <p id="nicheLabel" class="text-xs text-brand-muted mt-1"></p>
        <div id="styleTags" class="flex flex-wrap gap-2 mt-2"></div>
      </div>
      <div class="flex items-center gap-3">
        <input id="nicheInput" type="text" placeholder="Override niche (optional)"
          class="rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50 w-56" />
        <button onclick="regenerateAll()" class="btn-brand-yellow text-sm font-bold px-4 py-2 rounded-xl whitespace-nowrap action-btn flex items-center gap-1.5">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>
          Refresh Ideas
        </button>
      </div>
    </div>

    <!-- QUICK ACTIONS BAR -->
    <div class="brand-card p-4 md:p-5 dark:bg-slate-900 dark:border-white/10 mb-6">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Quick Actions</span>
        <span id="qaStatus" class="text-[10px] text-brand-muted font-bold"></span>
      </div>
      <div class="flex flex-wrap gap-2">
        <button onclick="qaGenerateInstagram()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          Instagram
        </button>
        <button onclick="qaGenerateTikTok()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
          TikTok
        </button>
        <button onclick="qaGenerateAll()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>
          All Platforms
        </button>
        <button onclick="qaCopyAllVisible()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          Copy All
        </button>
        <button onclick="qaCopyLocalToday()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-yellow flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Today's Local
        </button>
        <button onclick="switchTab('instagram')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-[#E1306C] text-[#E1306C]">Filter: Instagram</button>
        <button onclick="switchTab('all')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white">Show All</button>
      </div>
    </div>

    <!-- CONTENT CALENDAR -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
            <svg class="icon-flat" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Content Calendar
          </h2>
          <p class="text-xs text-brand-muted mt-1">This week's planned content from local scout + ideas.</p>
        </div>
        <div class="flex gap-2">
          <button onclick="calendarPrevWeek()" class="text-xs font-bold text-brand-muted hover:text-brand-yellow px-2 py-1">&larr; Prev</button>
          <button onclick="calendarNextWeek()" class="text-xs font-bold text-brand-muted hover:text-brand-yellow px-2 py-1">Next &rarr;</button>
          <button onclick="calendarThisWeek()" class="text-xs font-bold text-brand-yellow hover:underline px-2 py-1">Today</button>
        </div>
      </div>
      <div id="calendarGrid" class="grid grid-cols-7 gap-2"></div>
      <div class="flex gap-4 mt-3 text-[10px] text-brand-muted">
        <span><span class="calendar-dot" style="background:#22c55e"></span> New Business</span>
        <span><span class="calendar-dot" style="background:#f59e0b"></span> Trending</span>
        <span><span class="calendar-dot" style="background:#3b82f6"></span> News</span>
        <span><span class="calendar-dot" style="background:#a855f7"></span> Event</span>
        <span><span class="calendar-dot" style="background:var(--brand-yellow)"></span> Idea</span>
      </div>
    </div>

    <!-- HASHTAG SETS -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
            <svg class="icon-flat" viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
            Hashtag Sets
          </h2>
          <p class="text-xs text-brand-muted mt-1">Optimized for Clark County / Vancouver WA reach. Click to copy.</p>
        </div>
        <button onclick="cycleHashtagSet()" class="text-xs font-bold text-brand-yellow hover:underline">Cycle Set &rarr;</button>
      </div>
      <div id="hashtagContainer" class="brand-card p-4 dark:bg-slate-900 dark:border-white/10"></div>
    </div>

    <!-- Platform Tabs -->
    <div class="flex flex-wrap gap-2 mb-6" id="platformTabs">
      <button class="platform-tab active px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="all">All</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="instagram">Instagram</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="facebook">Facebook</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="linkedin">LinkedIn</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="x">X / Twitter</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="tiktok">TikTok</button>
    </div>

    <!-- Ideas Grid -->
    <div id="ideasContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-20 text-brand-muted">
        <p class="text-lg font-bold mb-2">Loading today's ideas...</p>
      </div>
    </div>

    <!-- Saved Posts Section -->
    <div class="mt-12 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
        <svg class="icon-flat" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>
        Bookmarked Posts
      </h2>
      <div class="flex items-center gap-2 flex-wrap">
        <select id="bookmarkFolderFilter" class="rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs font-bold text-brand-dark dark:text-white">
          <option value="">All folders</option>
        </select>
        <button onclick="openFolderModalForNew()" class="text-xs font-bold text-brand-yellow hover:underline">+ New folder</button>
        <span id="savedCount" class="text-xs text-brand-muted font-bold">0 saved</span>
      </div>
    </div>
    <div id="savedPostsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noSavedMsg">
        No saved posts yet. Click the bookmark icon on any idea to save it.
      </div>
    </div>

    <!-- Clark County / Local Content Section (agency workspaces only) -->
    <div id="localContentSection" class="mt-14 mb-4 flex items-center justify-between hidden">
      <div>
        <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
          <svg class="icon-flat" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Clark County Content
        </h2>
        <p class="text-xs text-brand-muted mt-1">Daily scout findings for @ClarkCountyGuide. Click the star to save for newsletter.</p>
      </div>
      <span id="localCount" class="text-xs text-brand-muted font-bold">0 items</span>
    </div>
    <div id="localContentContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noLocalMsg">
        No content yet. The daily scout will populate this each morning.
      </div>
    </div>

    <!-- Newsletter Picks Section (agency workspaces only) -->
    <div id="newsletterSection" class="mt-14 mb-4 flex items-center justify-between hidden">
      <div>
        <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
          <svg class="icon-flat" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Newsletter Picks
        </h2>
        <p class="text-xs text-brand-muted mt-1">Starred items from Clark County content — ready for your weekly newsletter.</p>
      </div>
      <div class="flex gap-2">
        <span id="newsletterCount" class="text-xs text-brand-muted font-bold">0 picks</span>
        <button onclick="copyNewsletterDraft()" class="text-xs font-bold text-brand-yellow hover:underline">Copy Draft</button>
        <button onclick="clearNewsletterPicks()" class="text-xs font-bold text-brand-muted hover:text-red-500">Clear All</button>
      </div>
    </div>
    <div id="newsletterContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noNewsletterMsg">
        No picks yet. Click the star on any Clark County content item to save it here.
      </div>
    </div>

  </main>

  <!-- Style Modal -->
  <div id="styleModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeStyleModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-6 shadow-2xl">
      <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Style Profile</h3>
      <p class="text-xs text-brand-muted mb-4">Tell us about your voice. The more you save, the smarter the ideas get.</p>
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Niche / Business Type</label>
          <input id="styleNiche" type="text" placeholder="e.g. HVAC, coffee shop, roofing" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white" value="<%= (styleProfile && styleProfile.niche) || '' %>" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Tone</label>
          <select id="styleTone" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white">
            <option value="">Select tone...</option>
            <option value="professional">Professional</option>
            <option value="casual">Casual &amp; Friendly</option>
            <option value="bold">Bold &amp; Direct</option>
            <option value="educational">Educational</option>
            <option value="storyteller">Storyteller</option>
            <option value="humorous">Humorous</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Go-to Hooks (comma-separated)</label>
          <textarea id="styleHooks" rows="2" placeholder="e.g. Most owners don't realize, Here's what happened when" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50"></textarea>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Go-to CTAs (comma-separated)</label>
          <textarea id="styleCtas" rows="2" placeholder="e.g. Link in bio, Comment below, DM us" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button onclick="closeStyleModal()" class="text-sm font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-4 py-2">Cancel</button>
        <button onclick="saveStyle()" class="btn-brand-yellow text-sm font-bold px-5 py-2 rounded-xl">Save Style</button>
      </div>
    </div>
  </div>

  <!-- Bookmark Folder Modal -->
  <div id="folderModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeFolderModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-6 shadow-2xl">
      <h3 id="folderModalTitle" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Save to folder</h3>
      <div id="folderPickerList" class="space-y-2 mb-4 max-h-48 overflow-y-auto"></div>
      <div class="border-t border-brand-border/40 pt-4">
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Or create new folder</label>
        <div class="flex gap-2">
          <input id="newFolderName" type="text" placeholder="e.g. Review later, Q1 campaign" class="flex-1 rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
          <button onclick="createFolderAndSave()" class="btn-brand-yellow text-xs font-bold px-4 py-2 rounded-xl whitespace-nowrap">Create</button>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-5">
        <button onclick="closeFolderModal()" class="text-sm font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-4 py-2">Cancel</button>
        <button onclick="saveToFolder(null)" class="text-sm font-bold text-brand-yellow px-4 py-2">Save without folder</button>
      </div>
    </div>
  </div>

  <!-- Copy Toast -->
  <div id="copyToast" class="fixed bottom-6 right-6 z-50 hidden">
    <div class="copy-toast bg-brand-dark dark:bg-white text-white dark:text-brand-dark text-sm font-bold px-5 py-3 rounded-xl shadow-2xl">
      Copied to clipboard
    </div>
  </div>

  <%- include('/partials/app_shell_close') %>

  <script>
    // ── State ──────────────────────────────────────────────────────────────────
    const WORKSPACE_ID = <%- JSON.stringify(workspaceId || 'default') %>;
    const businessProfile = <%- JSON.stringify(typeof businessProfile !== 'undefined' ? businessProfile : {}) %>;
    let currentPlatform = 'all';
    let allIdeas = {};
    let savedPosts = [];
    let bookmarkFolders = <%- JSON.stringify(typeof bookmarkFolders !== 'undefined' ? bookmarkFolders : []) %>;
    let localContentItems = [];
    let styleProfile = <%- JSON.stringify(styleProfile || {}) %>;
    let calendarOffset = 0;
    let currentHashtagSet = 0;
    let pendingBookmark = null;
    let savedFolderFilter = '';

    // ── Flat SVG Icons (inline for convenience) ────────────────────────────────
    const ICONS = {
      refresh: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>',
      bookmark: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>',
      bookmarkFilled: '<svg class="icon-flat-sm" viewBox="0 0 24 24" fill="currentColor"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>',
      copy: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>',
      star: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
      starFilled: '<svg class="icon-flat-sm" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
      trash: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>',
      edit: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
      mapPin: '<svg class="icon-flat" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>',
      calendar: '<svg class="icon-flat" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
      hashtag: '<svg class="icon-flat" viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>',
      instagram: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
      tiktok: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>',
      save: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>',
    };

    const PLATFORM_COLORS = { instagram: '#E1306C', facebook: '#1877F2', linkedin: '#0A66C2', x: '#1DA1F2', tiktok: '#000' };
    const DM_PLATFORMS = { instagram: 'instagram_feed', facebook: 'facebook_feed', linkedin: 'linkedin_post', x: 'instagram_feed', tiktok: 'instagram_story' };

    // ── Hashtag Sets ───────────────────────────────────────────────────────────
    function buildHashtagSets() {
      if (businessProfile && businessProfile.isAgencyWorkspace) {
        return [
          { name: 'Clark County Local', tags: ['#ClarkCounty','#VancouverWA','#PNW','#PacificNorthwest','#WashingtonState','#CouverLife','#360','#PortlandMetro','#ClarkCountyWA','#ShopLocal'] },
          { name: 'Small Business', tags: ['#SmallBusiness','#ShopSmall','#SmallBusinessOwner','#Entrepreneur','#LocalBusiness','#SupportLocal','#BusinessOwner','#SupportSmallBusiness','#LocalFirst','#CommunityFirst'] },
          { name: 'New Business / Opening', tags: ['#GrandOpening','#NewBusiness','#NewInTown','#NowOpen','#GrandOpeningDay','#JustOpened','#NewSpot','#CheckThisOut','#LocalNews','#BusinessSpotlight'] },
          { name: 'Real Estate / Development', tags: ['#RealEstate','#NewDevelopment','#Construction','#Growth','#Downtown','#VancouverDowntown','#PDXRealEstate','#Housing','#CommercialRealEstate','#UrbanDevelopment'] },
          { name: 'Engagement / Community', tags: ['#KnowYourCity','#LocalLove','#CommunityMatters','#ExploreLocal','#HiddenGems','#ThingsToDo','#WeekendVibes','#LocalEats','#ExplorePNW','#WAFood'] }
        ];
      }
      const nicheTag = (businessProfile.icpKeyword || businessProfile.businessName || 'LocalBusiness').replace(/[^a-zA-Z0-9]/g, '');
      return [
        { name: 'Business / Service', tags: ['#' + nicheTag, '#SmallBusiness', '#LocalBusiness', '#ShopLocal', '#SupportLocal', '#HomeImprovement', '#ContractorLife', '#QualityWork', '#CustomerFirst', '#BeforeAndAfter'] },
        { name: 'Engagement', tags: ['#TipTuesday', '#Transformation', '#ProjectOfTheWeek', '#CustomerReview', '#BehindTheScenes', '#ProTips', '#HomeOwner', '#LocalExpert', '#TrustedPro', '#FreeEstimate'] },
        { name: 'Industry', tags: ['#Flooring', '#HomeRenovation', '#InteriorDesign', '#Contractor', '#Builder', '#Remodel', '#NewConstruction', '#DesignInspo', '#Craftsmanship', '#QualityInstall'].map(t => businessProfile.niche && businessProfile.niche.toLowerCase().includes('floor') ? t : t) }
      ];
    }
    let hashtagSets = buildHashtagSets();

    // ── Init: auto-load ideas on page visit ────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
      renderStyleTags();
      renderNicheLabel();
      renderBookmarkFolderFilter();
      if (businessProfile.showLocalContent) {
        document.getElementById('localContentSection')?.classList.remove('hidden');
        document.getElementById('newsletterSection')?.classList.remove('hidden');
        loadLocalContent();
      } else {
        document.getElementById('qaCopyLocalToday')?.classList.add('hidden');
      }
      loadSavedPosts();
      renderCalendar();
      renderHashtags();
      regenerateAll();
    });

    function renderNicheLabel() {
      const el = document.getElementById('nicheLabel');
      if (!el || !businessProfile.niche) return;
      el.textContent = 'Ideas for: ' + businessProfile.niche;
    }

    function wsQuery() { return 'workspaceId=' + encodeURIComponent(WORKSPACE_ID); }

    // ── QUICK ACTIONS ───────────────────────────────────────────────────────────
    function qaStatus(msg) {
      const el = document.getElementById('qaStatus');
      el.textContent = msg;
      setTimeout(() => el.textContent = '', 3000);
    }

    async function qaGenerateInstagram() {
      const preset = document.getElementById('nicheInput').value.trim();
      const q = preset ? '&preset=' + encodeURIComponent(preset) : '';
      try {
        const res = await fetch('/social-posts/api/ideas?' + wsQuery() + q);
        const data = await res.json();
        if (data.success) { allIdeas = data.ideas; switchTab('instagram'); qaStatus('Instagram ideas generated'); }
      } catch (err) { qaStatus('Error generating'); }
    }

    async function qaGenerateTikTok() {
      const preset = document.getElementById('nicheInput').value.trim();
      const q = preset ? '&preset=' + encodeURIComponent(preset) : '';
      try {
        const res = await fetch('/social-posts/api/ideas?' + wsQuery() + q);
        const data = await res.json();
        if (data.success) { allIdeas = data.ideas; switchTab('tiktok'); qaStatus('TikTok ideas generated'); }
      } catch (err) { qaStatus('Error generating'); }
    }

    async function qaGenerateAll() { await regenerateAll(); qaStatus('All platforms generated'); }

    function qaCopyAllVisible() {
      const platforms = currentPlatform === 'all' ? Object.keys(allIdeas) : [currentPlatform];
      let allText = '';
      for (const p of platforms) {
        const ideas = allIdeas[p] || [];
        allText += '=== ' + p.toUpperCase() + ' ===\n';
        for (const idea of ideas) { allText += idea.hook + '\n'; if (idea.cta) allText += 'CTA: ' + idea.cta + '\n'; allText += '\n'; }
      }
      if (!allText.trim()) { qaStatus('No ideas to copy'); return; }
      navigator.clipboard.writeText(allText.trim()).then(() => { showCopyToast(); qaStatus('Copied all visible ideas'); });
    }

    function qaCopyLocalToday() {
      const today = new Date().toISOString().slice(0, 10);
      const todayItems = localContentItems.filter(i => i.createdAt && i.createdAt.slice(0, 10) === today);
      if (!todayItems.length) { qaStatus('No local content for today'); return; }
      let text = 'Clark County Content for ' + today + '\n\n';
      for (const item of todayItems) { text += '\u2022 ' + item.title + '\n' + item.summary + '\nPost Idea: ' + item.postIdea + '\n\n'; }
      navigator.clipboard.writeText(text.trim()).then(() => { showCopyToast(); qaStatus('Copied today\'s local content'); });
    }

    function switchTab(platform) {
      currentPlatform = platform;
      document.querySelectorAll('.platform-tab').forEach(t => t.classList.remove('active'));
      const tab = document.querySelector(`[data-platform="${platform}"]`);
      if (tab) tab.classList.add('active');
      renderIdeas();
    }

    // ── CONTENT CALENDAR ────────────────────────────────────────────────────────
    function renderCalendar() {
      const grid = document.getElementById('calendarGrid');
      const today = new Date();
      const startOfWeek = new Date(today);
      startOfWeek.setDate(today.getDate() - today.getDay() + (calendarOffset * 7));
      const days = [];
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      for (let i = 0; i < 7; i++) { const d = new Date(startOfWeek); d.setDate(startOfWeek.getDate() + i); days.push(d); }
      const contentByDate = {};
      for (const item of localContentItems) {
        if (!item.createdAt) continue;
        const d = item.createdAt.slice(0, 10);
        if (!contentByDate[d]) contentByDate[d] = [];
        contentByDate[d].push(item);
      }
      grid.innerHTML = '';
      for (const d of days) {
        const dateStr = d.toISOString().slice(0, 10);
        const isToday = dateStr === new Date().toISOString().slice(0, 10);
        const items = contentByDate[dateStr] || [];
        const div = document.createElement('div');
        div.className = 'calendar-day brand-card rounded-xl border border-brand-border/40 p-2 dark:bg-slate-900 dark:border-white/10' + (isToday ? ' today' : '');
        const dots = items.slice(0, 4).map(item => {
          const colors = { 'new-business': '#22c55e', 'trending': '#f59e0b', 'news': '#3b82f6', 'event': '#a855f7', 'viral': '#ef4444', 'general': 'var(--brand-muted)' };
          return '<span class="calendar-dot" style="background:' + (colors[item.category] || 'var(--brand-muted)') + '; margin-right:2px" title="' + escapeHtml(item.title) + '"></span>';
        }).join('');
        div.innerHTML = '<div class="text-[10px] font-black uppercase tracking-widest ' + (isToday ? 'text-brand-yellow' : 'text-brand-muted') + ' mb-1">' + dayNames[d.getDay()] + ' ' + (d.getMonth() + 1) + '/' + d.getDate() + '</div><div class="mb-1">' + dots + '</div>' + (items.length ? '<div class="text-[10px] font-bold text-brand-dark dark:text-white">' + items.length + ' item' + (items.length > 1 ? 's' : '') + '</div>' : '<div class="text-[10px] text-brand-muted/40">-</div>') + (items.length ? items.slice(0, 2).map(item => '<div class="text-[9px] text-brand-muted truncate">' + escapeHtml(item.title) + '</div>').join('') : '');
        grid.appendChild(div);
      }
    }
    function calendarPrevWeek() { calendarOffset--; renderCalendar(); }
    function calendarNextWeek() { calendarOffset++; renderCalendar(); }
    function calendarThisWeek() { calendarOffset = 0; renderCalendar(); }

    // ── HASHTAGS ────────────────────────────────────────────────────────────────
    function renderHashtags() {
      const container = document.getElementById('hashtagContainer');
      const set = hashtagSets[currentHashtagSet % hashtagSets.length];
      const allTags = set.tags.join(' ');
      container.innerHTML = '<div class="flex items-center justify-between mb-2"><span class="text-xs font-bold text-brand-dark dark:text-white">' + set.name + '</span><span class="text-[9px] text-brand-muted">' + set.tags.length + ' tags</span></div><div class="flex flex-wrap gap-1.5 mb-3">' + set.tags.map(t => '<span class="hashtag-pill" onclick="copyHashtag(\'' + t.replace(/'/g, "\\'") + '\', this)">' + t + '</span>').join('') + '</div><button onclick="copyAllHashtags()" class="btn-brand-yellow text-xs font-bold px-3 py-1.5 rounded-lg">Copy All ' + set.tags.length + ' Tags</button>';
    }
    function copyHashtag(tag, el) { navigator.clipboard.writeText(tag).then(() => { el.classList.add('copied'); setTimeout(() => el.classList.remove('copied'), 1500); qaStatus('Copied ' + tag); }); }
    function copyAllHashtags() { const set = hashtagSets[currentHashtagSet % hashtagSets.length]; navigator.clipboard.writeText(set.tags.join(' ')).then(() => { showCopyToast(); qaStatus('Copied ' + set.tags.length + ' hashtags'); }); }
    function cycleHashtagSet() { currentHashtagSet++; renderHashtags(); }

    // ── Platform Tabs ──────────────────────────────────────────────────────────
    document.querySelectorAll('.platform-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.platform-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentPlatform = tab.dataset.platform;
        renderIdeas();
      });
    });

    // ── Generate Ideas ───────────────────────────────────────────────────────────
    async function regenerateAll() {
      const preset = document.getElementById('nicheInput').value.trim();
      const q = preset ? '&preset=' + encodeURIComponent(preset) : '';
      const container = document.getElementById('ideasContainer');
      container.innerHTML = '<div class="col-span-full text-center py-20 text-brand-muted"><p class="text-lg font-bold">Generating fresh ideas...</p></div>';
      try {
        const res = await fetch('/social-posts/api/ideas?' + wsQuery() + q);
        const data = await res.json();
        if (data.success) {
          allIdeas = data.ideas;
          if (data.niche) {
            const lbl = document.getElementById('nicheLabel');
            if (lbl) lbl.textContent = 'Ideas for: ' + data.niche;
          }
          renderIdeas();
        }
        else { container.innerHTML = '<div class="col-span-full text-center py-20 text-red-500"><p class="font-bold">Error: ' + (data.error || 'Failed') + '</p></div>'; }
      } catch (err) { container.innerHTML = '<div class="col-span-full text-center py-20 text-red-500"><p class="font-bold">Connection error.</p></div>'; }
    }

    function renderIdeas() {
      const container = document.getElementById('ideasContainer');
      container.innerHTML = '';
      const platforms = currentPlatform === 'all' ? Object.keys(allIdeas) : [currentPlatform];
      let total = 0;
      for (const p of platforms) {
        for (const idea of (allIdeas[p] || [])) { total++; container.appendChild(createIdeaCard(idea, p)); }
      }
      if (!total) { container.innerHTML = '<div class="col-span-full text-center py-20 text-brand-muted"><p class="text-lg font-bold mb-2">No ideas yet</p><p class="text-sm">Click Refresh Ideas to generate</p></div>'; }
    }

    function marketingStudioUrl(platform, hook, cta) {
      const dmPlatform = DM_PLATFORMS[platform] || 'instagram_feed';
      const copy = hook + (cta ? '\n\n' + cta : '');
      const params = new URLSearchParams({
        fromSocialPost: '1',
        platform: dmPlatform,
        copy: copy,
        headline: hook.slice(0, 120),
        body: cta || '',
        autoGenerate: '1',
      });
      return '/direct-mail?' + params.toString();
    }

    function thumbGradient(platform) {
      const c = PLATFORM_COLORS[platform] || '#64748b';
      return 'linear-gradient(135deg, ' + c + '33 0%, ' + c + '88 100%)';
    }

    function createIdeaCard(idea, platform) {
      const div = document.createElement('div');
      div.className = 'post-card brand-card p-5 dark:bg-slate-900 dark:border-white/10 rounded-2xl border border-brand-border/60';
      div.dataset.ideaId = idea.id;
      div.dataset.platform = platform;
      const labels = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', x: 'X / Twitter', tiktok: 'TikTok' };
      const colors = PLATFORM_COLORS;
      const isSaved = savedPosts.some(sp => sp.content === idea.hook && sp.platform === platform);
      const saveIcon = isSaved ? ICONS.bookmarkFilled : ICONS.bookmark;
      const saveColor = isSaved ? 'var(--brand-yellow)' : '';
      const saveTitle = isSaved ? 'Saved' : 'Bookmark for later';
      const studioUrl = marketingStudioUrl(platform, idea.hook, idea.cta || '');
      div.innerHTML =
        '<div class="post-card-thumb" onclick="window.location.href=\'' + studioUrl.replace(/'/g, "\\'") + '\'" title="Open in Marketing Studio">' +
        '<div style="width:100%;height:100%;background:' + thumbGradient(platform) + ';display:flex;align-items:center;justify-content:center;">' +
        '<span style="font-size:28px;opacity:.6;">' + (labels[platform] || platform).charAt(0) + '</span></div>' +
        '<div class="thumb-overlay"><span class="thumb-label">Create artwork →</span></div></div>' +
        '<div class="flex items-center justify-between mb-3">' +
        '<span class="text-[10px] font-black uppercase tracking-widest" style="color:' + (colors[platform] || 'var(--brand-muted)') + '">' + (labels[platform] || platform) + '</span>' +
        '<div class="flex gap-2">' +
        '<button onclick="event.stopPropagation();toggleSaveIdea(\'' + idea.id.replace(/'/g, "\\'") + '\', \'' + platform.replace(/'/g, "\\'") + '\')" class="text-[10px] font-bold hover:text-brand-yellow flex items-center gap-0.5" style="color:' + saveColor + '" title="' + saveTitle + '">' + saveIcon + '</button>' +
        '<button onclick="event.stopPropagation();copyIdea(\'' + idea.id.replace(/'/g, "\\'") + '\')" class="text-[10px] font-bold text-brand-muted hover:text-brand-yellow flex items-center gap-0.5" title="Copy">' + ICONS.copy + '</button>' +
        '<button onclick="event.stopPropagation();toggleEdit(\'' + idea.id.replace(/'/g, "\\'") + '\')" class="text-[10px] font-bold text-brand-muted hover:text-brand-yellow flex items-center gap-0.5" title="Edit">' + ICONS.edit + '</button>' +
        '</div></div>' +
        '<div class="preview-area"><p class="text-sm font-semibold text-brand-dark dark:text-white leading-relaxed whitespace-pre-wrap">' + escapeHtml(idea.hook) + '</p>' +
        (idea.cta ? '<p class="text-xs text-brand-muted mt-2 italic">CTA: ' + escapeHtml(idea.cta) + '</p>' : '') + '</div>' +
        '<div class="edit-area mt-3"><textarea class="edit-content w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white min-h-[100px] resize-y">' + escapeHtml(idea.hook) + '</textarea>' +
        '<textarea class="edit-cta w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-brand-muted mt-2 min-h-[40px] resize-y" placeholder="CTA">' + escapeHtml(idea.cta || '') + '</textarea>' +
        '<div class="flex gap-2 mt-3"><button onclick="saveIdea(\'' + idea.id.replace(/'/g, "\\'") + '\')" class="btn-brand-yellow text-xs font-bold px-4 py-1.5 rounded-lg">Save</button>' +
        '<button onclick="cancelEdit(\'' + idea.id.replace(/'/g, "\\'") + '\')" class="text-xs font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-3 py-1.5">Cancel</button></div></div>';
      return div;
    }

    // ── Bookmark idea with folder picker ───────────────────────────────────────
    async function toggleSaveIdea(ideaId, platform) {
      const card = document.querySelector('[data-idea-id="' + ideaId + '"]');
      if (!card) return;
      const content = card.querySelector('.preview-area p').textContent;
      const ctaEl = card.querySelector('.preview-area .text-xs');
      const cta = ctaEl ? ctaEl.textContent.replace('CTA: ', '') : '';
      const existing = savedPosts.find(sp => sp.content === content && sp.platform === platform);
      if (existing) {
        try {
          const res = await fetch('/social-posts/api/' + encodeURIComponent(existing.id), { method: 'DELETE' });
          const data = await res.json();
          if (data.success) { savedPosts = savedPosts.filter(sp => sp.id !== existing.id); renderSavedPosts(); renderIdeas(); qaStatus('Removed bookmark'); }
        } catch (err) { alert('Could not remove.'); }
      } else {
        pendingBookmark = { ideaId, platform, content, cta };
        openFolderModal();
      }
    }

    function openFolderModal() {
      document.getElementById('folderModalTitle').textContent = 'Save to folder';
      renderFolderPickerList();
      document.getElementById('folderModal').classList.remove('hidden');
      document.getElementById('newFolderName').value = '';
      const saveNoFolder = document.querySelector('#folderModal button[onclick="saveToFolder(null)"]');
      if (saveNoFolder) saveNoFolder.classList.toggle('hidden', !pendingBookmark);
    }
    function closeFolderModal() {
      document.getElementById('folderModal').classList.add('hidden');
      pendingBookmark = null;
    }

    function renderFolderPickerList() {
      const list = document.getElementById('folderPickerList');
      if (!list) return;
      if (!bookmarkFolders.length) {
        list.innerHTML = '<p class="text-xs text-brand-muted italic">No folders yet — create one below.</p>';
        return;
      }
      list.innerHTML = bookmarkFolders.map(f =>
        '<button type="button" onclick="saveToFolder(\'' + f.id.replace(/'/g, "\\'") + '\')" class="w-full text-left rounded-xl border border-brand-border/50 dark:border-white/10 px-4 py-2.5 text-sm font-bold text-brand-dark dark:text-white hover:border-brand-yellow transition-colors">' + escapeHtml(f.name) + '</button>'
      ).join('');
    }

    async function saveToFolder(folderId) {
      if (!pendingBookmark) return;
      const { platform, content, cta, ideaId } = pendingBookmark;
      try {
        const res = await fetch('/social-posts/api/save', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            platform, content, cta, ideaId,
            niche: businessProfile.niche || '',
            folderId: folderId || null,
            workspaceId: WORKSPACE_ID,
          })
        });
        const data = await res.json();
        if (data.success) {
          savedPosts.unshift(data.post || { id: data.id, platform, content, cta, folderId, createdAt: new Date().toISOString() });
          renderSavedPosts(); renderIdeas(); qaStatus('Bookmarked'); closeFolderModal();
        }
      } catch (err) { alert('Could not save.'); }
    }

    async function createFolderAndSave() {
      const name = document.getElementById('newFolderName').value.trim();
      if (!name) return;
      try {
        const res = await fetch('/social-posts/api/bookmark-folders', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, workspaceId: WORKSPACE_ID })
        });
        const data = await res.json();
        if (data.success && data.folder) {
          bookmarkFolders.unshift(data.folder);
          renderBookmarkFolderFilter();
          if (pendingBookmark) {
            await saveToFolder(data.folder.id);
          } else {
            closeFolderModal();
            qaStatus('Folder created');
          }
        }
      } catch (err) { alert('Could not create folder.'); }
    }

    function renderBookmarkFolderFilter() {
      const sel = document.getElementById('bookmarkFolderFilter');
      if (!sel) return;
      const prev = sel.value;
      sel.innerHTML = '<option value="">All folders</option>' +
        bookmarkFolders.map(f => '<option value="' + escapeHtml(f.id) + '">' + escapeHtml(f.name) + '</option>').join('');
      sel.value = prev || '';
      sel.onchange = function() { savedFolderFilter = sel.value; renderSavedPosts(); };
    }

    async function openFolderModalForNew() {
      pendingBookmark = null;
      document.getElementById('folderModalTitle').textContent = 'New bookmark folder';
      document.getElementById('folderModal').classList.remove('hidden');
      document.getElementById('newFolderName').value = '';
      renderFolderPickerList();
    }

    function copyIdea(ideaId) {
      const card = document.querySelector('[data-idea-id="' + ideaId + '"]');
      if (!card) return;
      const text = card.querySelector('.preview-area p').textContent;
      navigator.clipboard.writeText(text).then(() => showCopyToast());
    }

    function showCopyToast() {
      const t = document.getElementById('copyToast');
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 2000);
    }

    function toggleEdit(id) { const c = document.querySelector('[data-idea-id="' + id + '"]'); if (c) c.classList.add('editing'); }
    function cancelEdit(id) { const c = document.querySelector('[data-idea-id="' + id + '"]'); if (c) c.classList.remove('editing'); }

    async function saveIdea(ideaId) {
      const card = document.querySelector('[data-idea-id="' + ideaId + '"]');
      if (!card) return;
      const content = card.querySelector('.edit-content').value.trim();
      const cta = card.querySelector('.edit-cta').value.trim();
      if (!content) return;
      try {
        const res = await fetch('/social-posts/api/save', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ platform: card.dataset.platform, content, cta, niche: document.getElementById('nicheInput').value.trim() || businessProfile.niche, workspaceId: WORKSPACE_ID })
        });
        const data = await res.json();
        if (data.success) {
          card.querySelector('.preview-area p').textContent = content;
          const ctaEl = card.querySelector('.preview-area .text-xs');
          if (cta) { if (ctaEl) ctaEl.textContent = 'CTA: ' + cta; else { const p = document.createElement('p'); p.className = 'text-xs text-brand-muted mt-2 italic'; p.textContent = 'CTA: ' + cta; card.querySelector('.preview-area').appendChild(p); } } else if (ctaEl) ctaEl.remove();
          card.classList.remove('editing');
          showCopyToast();
          loadSavedPosts();
        }
      } catch (err) { alert('Could not save.'); }
    }

    // ── Saved Posts ─────────────────────────────────────────────────────────────
    async function loadSavedPosts() {
      try {
        const res = await fetch('/social-posts/api/saved?' + wsQuery());
        const data = await res.json();
        if (data.success && data.posts) { savedPosts = data.posts; renderSavedPosts(); }
      } catch (err) { /* ignore */ }
    }

    function folderName(folderId) {
      if (!folderId) return '';
      const f = bookmarkFolders.find(x => x.id === folderId);
      return f ? f.name : '';
    }

    function renderSavedPosts() {
      const container = document.getElementById('savedPostsContainer');
      let posts = savedPosts;
      if (savedFolderFilter) posts = posts.filter(p => p.folderId === savedFolderFilter);
      document.getElementById('savedCount').textContent = posts.length + ' bookmarked';
      if (!posts.length) {
        container.innerHTML = '<div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noSavedMsg">No bookmarked posts yet. Click the bookmark icon on any idea to save it.</div>';
        return;
      }
      container.innerHTML = '';
      for (const post of posts) {
        const div = document.createElement('div');
        div.className = 'post-card brand-card p-5 dark:bg-slate-900 dark:border-white/10 rounded-2xl border border-brand-border/60';
        const date = post.createdAt ? new Date(post.createdAt).toLocaleDateString() : '';
        const fName = folderName(post.folderId);
        const studioUrl = marketingStudioUrl(post.platform, post.content, post.cta || '');
        div.innerHTML =
          '<div class="post-card-thumb" onclick="window.location.href=\'' + studioUrl.replace(/'/g, "\\'") + '\'" title="Open in Marketing Studio">' +
          '<div style="width:100%;height:100%;background:' + thumbGradient(post.platform) + ';display:flex;align-items:center;justify-content:center;">' +
          '<span style="font-size:28px;opacity:.6;">' + post.platform.charAt(0).toUpperCase() + '</span></div>' +
          '<div class="thumb-overlay"><span class="thumb-label">Create artwork →</span></div></div>' +
          '<div class="flex items-center justify-between mb-3">' +
          '<span class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">' + post.platform + (fName ? ' · ' + escapeHtml(fName) : '') + '</span>' +
          '<div class="flex gap-2 items-center">' +
          '<span class="text-[10px] text-brand-muted">' + date + '</span>' +
          '<button onclick="navigator.clipboard.writeText(' + JSON.stringify(post.content) + ').then(()=>showCopyToast())" class="text-[10px] font-bold text-brand-muted hover:text-brand-yellow" title="Copy">' + ICONS.copy + '</button>' +
          '<button onclick="deleteSaved(\'' + post.id + '\')" class="text-[10px] font-bold text-brand-muted hover:text-red-500" title="Delete">' + ICONS.trash + '</button>' +
          '</div></div>' +
          '<p class="text-sm font-semibold text-brand-dark dark:text-white leading-relaxed whitespace-pre-wrap">' + escapeHtml(post.content) + '</p>' +
          (post.cta ? '<p class="text-xs text-brand-muted mt-2 italic">CTA: ' + escapeHtml(post.cta) + '</p>' : '');
        container.appendChild(div);
      }
    }

    async function deleteSaved(postId) {
      if (!confirm('Delete this saved post?')) return;
      try {
        const res = await fetch('/social-posts/api/' + encodeURIComponent(postId), { method: 'DELETE' });
        const data = await res.json();
        if (data.success) { savedPosts = savedPosts.filter(p => p.id !== postId); renderSavedPosts(); renderIdeas(); }
      } catch (err) { alert('Could not delete.'); }
    }

    // ── Style Profile ───────────────────────────────────────────────────────────
    function openStyleModal() {
      document.getElementById('styleModal').classList.remove('hidden');
      if (styleProfile) {
        document.getElementById('styleNiche').value = styleProfile.niche || '';
        document.getElementById('styleTone').value = styleProfile.tone || '';
        document.getElementById('styleHooks').value = (styleProfile.hooks || []).join(', ');
        document.getElementById('styleCtas').value = (styleProfile.ctas || []).join(', ');
      }
    }
    function closeStyleModal() { document.getElementById('styleModal').classList.add('hidden'); }

    async function saveStyle() {
      const profile = {
        niche: document.getElementById('styleNiche').value.trim(),
        tone: document.getElementById('styleTone').value,
        hooks: document.getElementById('styleHooks').value.split(',').map(s => s.trim()).filter(Boolean),
        ctas: document.getElementById('styleCtas').value.split(',').map(s => s.trim()).filter(Boolean),
        workspaceId: WORKSPACE_ID,
      };
      try {
        const res = await fetch('/social-posts/api/save-style', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(profile) });
        const data = await res.json();
        if (data.success) { styleProfile = { ...styleProfile, ...profile }; renderStyleTags(); closeStyleModal(); }
      } catch (err) { alert('Could not save style.'); }
    }

    function renderStyleTags() {
      const container = document.getElementById('styleTags');
      if (!container) return;
      const tags = [];
      if (styleProfile.niche) tags.push('Niche: ' + styleProfile.niche);
      if (styleProfile.tone) tags.push('Tone: ' + styleProfile.tone);
      if (styleProfile.hooks && styleProfile.hooks.length) tags.push(styleProfile.hooks.length + ' hooks');
      if (styleProfile.ctas && styleProfile.ctas.length) tags.push(styleProfile.ctas.length + ' CTAs');
      if (savedPosts.length) tags.push(savedPosts.length + ' saved');
      container.innerHTML = tags.length ? tags.map(t => '<span class="style-tag">' + escapeHtml(t) + '</span>').join('') : '<span class="text-xs text-brand-muted italic">Save edited posts to build your style profile...</span>';
    }

    // ── Local Content (Clark County) ─────────────────────────────────────────────
    async function loadLocalContent() {
      try {
        const res = await fetch('/social-posts/api/local-content?' + wsQuery() + '&limit=50');
        const data = await res.json();
        if (data.success && data.items) { localContentItems = data.items; renderLocalContent(); renderCalendar(); renderNewsletter(); }
      } catch (err) { /* ignore */ }
    }

    function renderLocalContent() {
      const container = document.getElementById('localContentContainer');
      document.getElementById('localCount').textContent = localContentItems.length + ' items';
      if (!localContentItems.length) {
        container.innerHTML = '<div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noLocalMsg">No content yet. The daily scout will populate this each morning.</div>';
        return;
      }
      container.innerHTML = '';
      const catColors = { 'new-business': '#22c55e', 'trending': '#f59e0b', 'news': '#3b82f6', 'event': '#a855f7', 'viral': '#ef4444', 'general': 'var(--brand-muted)' };
      const catLabels = { 'new-business': 'New Business', 'trending': 'Trending', 'news': 'News', 'event': 'Event', 'viral': 'Viral', 'general': 'Local' };
      for (const item of localContentItems) {
        const div = document.createElement('div');
        div.className = 'post-card brand-card p-5 dark:bg-slate-900 dark:border-white/10 rounded-2xl border border-brand-border/60';
        const color = catColors[item.category] || catColors.general;
        const label = catLabels[item.category] || catLabels.general;
        const date = item.createdAt ? new Date(item.createdAt).toLocaleDateString() : '';
        const starred = item.newsletter;
        div.innerHTML = '<div class="flex items-center justify-between mb-3">' +
          '<span class="text-[10px] font-black uppercase tracking-widest" style="color:' + color + '">' + label + '</span>' +
          '<div class="flex gap-2 items-center">' +
          '<span class="text-[10px] text-brand-muted">' + date + '</span>' +
          '<button onclick="toggleNewsletter(\'' + item.id + '\')" class="text-[10px] font-bold hover:text-brand-yellow" style="color:' + (starred ? 'var(--brand-yellow)' : '') + '" title="Save for newsletter">' + (starred ? ICONS.starFilled : ICONS.star) + '</button>' +
          '<button onclick="copyLocalItem(\'' + item.id + '\')" class="text-[10px] font-bold text-brand-muted hover:text-brand-yellow" title="Copy">' + ICONS.copy + '</button>' +
          '<button onclick="deleteLocalItem(\'' + item.id + '\')" class="text-[10px] font-bold text-brand-muted hover:text-red-500" title="Delete">' + ICONS.trash + '</button>' +
          '</div></div>' +
          '<p class="text-sm font-bold text-brand-dark dark:text-white mb-2">' + escapeHtml(item.title) + '</p>' +
          '<p class="text-xs text-brand-muted leading-relaxed mb-3">' + escapeHtml(item.summary) + '</p>' +
          '<div class="bg-brand-bg/50 dark:bg-slate-800/50 rounded-lg p-3 border border-brand-border/30">' +
          '<p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Post Idea</p>' +
          '<p class="text-xs text-brand-dark dark:text-white leading-relaxed whitespace-pre-wrap">' + escapeHtml(item.postIdea) + '</p></div>' +
          (item.source ? '<p class="text-[10px] text-brand-muted mt-2 italic">Source: ' + escapeHtml(item.source) + '</p>' : '');
        container.appendChild(div);
      }
    }

    async function toggleNewsletter(id) {
      try {
        const res = await fetch('/social-posts/api/local-content/' + encodeURIComponent(id) + '/newsletter', {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ workspaceId: WORKSPACE_ID })
        });
        const data = await res.json();
        if (data.success) { const item = localContentItems.find(i => i.id === id); if (item) { item.newsletter = data.newsletter; item.newsletterAt = new Date().toISOString(); } renderLocalContent(); renderNewsletter(); }
      } catch (err) { alert('Could not save.'); }
    }

    function copyLocalItem(id) {
      const item = localContentItems.find(i => i.id === id);
      if (!item) return;
      navigator.clipboard.writeText(item.title + '\n\n' + item.summary + '\n\nPost Idea: ' + item.postIdea).then(() => showCopyToast());
    }

    async function deleteLocalItem(id) {
      if (!confirm('Delete this content item?')) return;
      try {
        const res = await fetch('/social-posts/api/local-content/' + encodeURIComponent(id), { method: 'DELETE' });
        const data = await res.json();
        if (data.success) { localContentItems = localContentItems.filter(i => i.id !== id); renderLocalContent(); renderCalendar(); renderNewsletter(); }
      } catch (err) { alert('Could not delete.'); }
    }

    // ── Newsletter Picks ────────────────────────────────────────────────────────
    function renderNewsletter() {
      const container = document.getElementById('newsletterContainer');
      const picks = localContentItems.filter(i => i.newsletter);
      document.getElementById('newsletterCount').textContent = picks.length + ' picks';
      if (!picks.length) {
        container.innerHTML = '<div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noNewsletterMsg">No picks yet. Click the star on any Clark County content item to save it here.</div>';
        return;
      }
      container.innerHTML = '';
      const catColors = { 'new-business': '#22c55e', 'trending': '#f59e0b', 'news': '#3b82f6', 'event': '#a855f7', 'viral': '#ef4444', 'general': 'var(--brand-muted)' };
      const catLabels = { 'new-business': 'New Business', 'trending': 'Trending', 'news': 'News', 'event': 'Event', 'viral': 'Viral', 'general': 'Local' };
      for (const item of picks) {
        const div = document.createElement('div');
        div.className = 'post-card brand-card p-5 dark:bg-slate-900 dark:border-white/10 rounded-2xl border border-brand-yellow/40';
        const color = catColors[item.category] || catColors.general;
        const label = catLabels[item.category] || catLabels.general;
        const date = item.createdAt ? new Date(item.createdAt).toLocaleDateString() : '';
        div.innerHTML = '<div class="flex items-center justify-between mb-3">' +
          '<span class="text-[10px] font-black uppercase tracking-widest" style="color:' + color + '">' + label + '</span>' +
          '<div class="flex gap-2 items-center">' +
          '<span class="text-[10px] text-brand-muted">' + date + '</span>' +
          '<button onclick="toggleNewsletter(\'' + item.id + '\')" class="text-[10px] font-bold text-brand-yellow hover:text-brand-muted" title="Remove from newsletter">' + ICONS.starFilled + '</button>' +
          '<button onclick="copyLocalItem(\'' + item.id + '\')" class="text-[10px] font-bold text-brand-muted hover:text-brand-yellow" title="Copy">' + ICONS.copy + '</button>' +
          '</div></div>' +
          '<p class="text-sm font-bold text-brand-dark dark:text-white mb-2">' + escapeHtml(item.title) + '</p>' +
          '<p class="text-xs text-brand-muted leading-relaxed mb-3">' + escapeHtml(item.summary) + '</p>' +
          '<div class="bg-brand-bg/50 dark:bg-slate-800/50 rounded-lg p-3 border border-brand-border/30">' +
          '<p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-1">Post Idea</p>' +
          '<p class="text-xs text-brand-dark dark:text-white leading-relaxed whitespace-pre-wrap">' + escapeHtml(item.postIdea) + '</p></div>';
        container.appendChild(div);
      }
    }

    function copyNewsletterDraft() {
      const picks = localContentItems.filter(i => i.newsletter);
      if (!picks.length) { qaStatus('No newsletter picks'); return; }
      let text = 'Clark County Newsletter\n';
      text += 'Week of ' + new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + '\n';
      text += '------------------------------\n\n';
      for (let i = 0; i < picks.length; i++) { text += (i + 1) + '. ' + picks[i].title + '\n' + picks[i].summary + '\n'; if (picks[i].source) text += 'Source: ' + picks[i].source + '\n'; text += '\n'; }
      text += '------------------------------\n';
      text += 'Follow @@ClarkCountyGuide for daily Clark County updates';
      navigator.clipboard.writeText(text).then(() => { showCopyToast(); qaStatus('Newsletter draft copied'); });
    }

    async function clearNewsletterPicks() {
      if (!confirm('Clear all newsletter picks?')) return;
      const picks = localContentItems.filter(i => i.newsletter);
      for (const item of picks) {
        item.newsletter = false; item.newsletterAt = null;
        await fetch('/social-posts/api/local-content/' + encodeURIComponent(item.id) + '/newsletter', {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ workspaceId: WORKSPACE_ID })
        }).catch(() => {});
      }
      renderLocalContent(); renderNewsletter(); qaStatus('Newsletter picks cleared');
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────
    function escapeHtml(str) { const div = document.createElement('div'); div.textContent = str || ''; return div.innerHTML; }
  </script>
</body>
</html>
