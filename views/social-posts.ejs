    function createIdeaCard(idea, platform) {
      const div = document.createElement('div');
      div.className = 'post-card brand-card p-5 dark:bg-slate-900 dark:border-white/10 rounded-2xl border border-brand-border/60';
      div.dataset.ideaId = idea.id;
      div.dataset.platform = platform;
      const state = getIdeaState(idea.id);
      const isSaved = savedPosts.some(sp => sp.content === idea.hook && sp.platform === platform);
      div.innerHTML = buildPostCardHtml({
        mode: 'idea', platform, hook: idea.hook, cta: idea.cta || '', ideaId: idea.id,
        isSaved, liked: state.liked, tags: getTagsForIdea(platform, idea.id), imageNote: state.imageNote || '',
        artworkUrl: getArtworkForCard('idea', platform, idea.id, '', ''),
      });
      return div;
    }

    async function ensureReviewFolder() {
      try {
        const existing = bookmarkFolders.find(f => f.name.toLowerCase() === 'review later');
        if (existing) { reviewFolderId = existing.id; return; }
        const res = await fetch('/social-posts/api/ensure-review-folder', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ workspaceId: WORKSPACE_ID }),
        });
        const data = await res.json();
        if (data.success && data.folder) {
          reviewFolderId = data.folder.id;
          if (!bookmarkFolders.some(f => f.id === data.folder.id)) {
            bookmarkFolders.unshift(data.folder);
            renderBookmarkFolderFilter();
          }
        }
      } catch { /* ignore */ }
    }

    async function qaSaveAllForReview() {
      if (!reviewFolderId) await ensureReviewFolder();
      if (!reviewFolderId) { qaStatus('Review folder unavailable'); return; }
      const cards = document.querySelectorAll('#ideasContainer [data-idea-id]');
      if (!cards.length) { qaStatus('No visible ideas'); return; }
      let saved = 0;
      for (const card of cards) {
        const ideaId = card.dataset.ideaId;
        const platform = card.dataset.platform;
        const content = card.querySelector('.preview-hook')?.textContent || '';
        const ctaEl = card.querySelector('.preview-cta');
        const cta = ctaEl ? ctaEl.textContent.replace(/^CTA:\s*/, '') : '';
        if (!content) continue;
        const existing = savedPosts.find(sp => sp.content === content && sp.platform === platform);
        if (existing) continue;
        const state = getIdeaState(ideaId);
        try {
          const res = await fetch('/social-posts/api/save', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              platform, content, cta, ideaId,
              niche: businessProfile.niche || '',
              folderId: reviewFolderId,
              liked: state.liked,
              tags: state.tags || [],
              imageNote: state.imageNote || '',
              workspaceId: WORKSPACE_ID,
            }),
          });
          const data = await res.json();
          if (data.success) {
            savedPosts.unshift(data.post || { id: data.id, platform, content, cta, folderId: reviewFolderId });
            saved++;
          }
        } catch { /* continue */ }
      }
      renderSavedPosts(); renderIdeas();
      qaStatus(saved ? ('Saved ' + saved + ' ideas for review') : 'All visible ideas already bookmarked');
    }

    function toggleLikeIdea(ideaId) {
      const state = getIdeaState(ideaId);
      state.liked = !state.liked;
      persistIdeaCardState();
      const ref = cardRef('idea', ideaId, '');
      const btn = document.querySelector('[data-like-btn="' + ref + '"]');
      if (btn) {
        btn.classList.toggle('liked', state.liked);
        btn.innerHTML = state.liked ? ICONS.heartFilled : ICONS.heart;
      }
    }

    async function toggleLikeSaved(postId) {
      const post = savedPosts.find(p => p.id === postId);
      if (!post) return;
      const liked = !post.liked;
      try {
        const res = await fetch('/social-posts/api/' + encodeURIComponent(postId), {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ liked, workspaceId: WORKSPACE_ID }),
        });
        const data = await res.json();
        if (data.success) {
          post.liked = liked;
          renderSavedPosts();
        }
      } catch { qaStatus('Could not update like'); }
    }

    function saveNoteIdea(ideaId) {
      const ref = cardRef('idea', ideaId, '');
      const input = document.querySelector('[data-note-input="' + ref + '"]');
      const state = getIdeaState(ideaId);
      state.imageNote = input ? input.value.trim() : '';
      persistIdeaCardState();
      closeNoteEditor(ref);
      renderIdeas();
    }

    async function saveNoteSaved(postId) {
      const ref = cardRef('saved', '', postId);
      const input = document.querySelector('[data-note-input="' + ref + '"]');
      const imageNote = input ? input.value.trim() : '';
      try {
        const res = await fetch('/social-posts/api/' + encodeURIComponent(postId), {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imageNote, workspaceId: WORKSPACE_ID }),
        });
        const data = await res.json();
        if (data.success) {
          const post = savedPosts.find(p => p.id === postId);
          if (post) post.imageNote = imageNote;
          closeNoteEditor(ref);
          renderSavedPosts();
        }
      } catch { qaStatus('Could not save note'); }
