      return '<div class="edit-area mt-3"><textarea class="edit-content w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white min-h-[100px] resize-y">' + escapeHtml(hook) + '</textarea>' +
        '<textarea class="edit-cta w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-brand-muted mt-2 min-h-[40px] resize-y" placeholder="CTA">' + escapeHtml(cta || '') + '</textarea>' +
        '<div class="flex gap-2 mt-3"><button onclick="saveIdea(\'' + ideaId.replace(/'/g, "\\'") + '\')" class="btn-brand-yellow text-xs font-bold px-4 py-1.5 rounded-lg">Save</button>' +
        '<button onclick="cancelEdit(\'' + ideaId.replace(/'/g, "\\'") + '\')" class="text-xs font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-3 py-1.5">Cancel</button></div></div>';
    }

    function savedEditAreaHtml(postId, hook, cta) {
      return '<div class="edit-area mt-3"><textarea class="edit-content w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white min-h-[100px] resize-y">' + escapeHtml(hook) + '</textarea>' +
        '<textarea class="edit-cta w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-brand-muted mt-2 min-h-[40px] resize-y" placeholder="CTA">' + escapeHtml(cta || '') + '</textarea>' +
        '<div class="flex gap-2 mt-3"><button onclick="saveSavedEdit(\'' + postId.replace(/'/g, "\\'") + '\')" class="btn-brand-yellow text-xs font-bold px-4 py-1.5 rounded-lg">Save</button>' +
        '<button onclick="cancelEditSaved(\'' + postId.replace(/'/g, "\\'") + '\')" class="text-xs font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-3 py-1.5">Cancel</button></div></div>';
