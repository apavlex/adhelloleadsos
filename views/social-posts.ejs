    function toggleNoteEditor(ref) {
      const editor = document.querySelector('[data-note-editor="' + ref + '"]');
      if (!editor) return;
      editor.classList.toggle('hidden');
    }

    function closeNoteEditor(ref) {
      const editor = document.querySelector('[data-note-editor="' + ref + '"]');
      if (editor) editor.classList.add('hidden');
    }

