<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .platform-tab { transition: all .15s ease; }
    .platform-tab.active { background: var(--brand-yellow); color: #111827; font-weight: 800; }
    .platform-tab:not(.active) { background: transparent; color: var(--brand-muted); border: 1px solid var(--brand-border); }
    .platform-tab:not(.active):hover { border-color: var(--brand-yellow); color: var(--brand-yellow); }
    .post-card { transition: box-shadow .15s ease; }
    .post-card:hover { box-shadow: 0 4px 24px rgba(255,214,68,.12); }
    .post-card-thumb { aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; margin-bottom: 12px; position: relative; background: var(--brand-cream, #f1f5f9); }
    .dark .post-card-thumb { background: #1e293b; }
    .post-card-thumb:hover { transform: scale(1.02); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .post-card-thumb .thumb-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.35); opacity: 0; transition: opacity .15s ease; pointer-events: none; }
    .post-card-thumb:hover .thumb-overlay { opacity: 1; }
    .post-card-thumb .thumb-overlay a { pointer-events: auto; }
    .post-card-thumb .thumb-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #fff; background: rgba(0,0,0,.5); padding: 4px 10px; border-radius: 9999px; text-decoration: none; }
    .post-card-thumb .thumb-note-display { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 10px; background: linear-gradient(transparent 40%, rgba(0,0,0,.55)); pointer-events: none; }
    .post-card-thumb .thumb-note-display span { font-size: 11px; color: #fff; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .post-card-thumb .thumb-note-btn { position: absolute; top: 8px; left: 8px; z-index: 2; background: rgba(255,255,255,.85); border: none; border-radius: 8px; padding: 5px 7px; cursor: pointer; color: #64748b; display: flex; align-items: center; justify-content: center; }
    .dark .post-card-thumb .thumb-note-btn { background: rgba(15,23,42,.85); color: #94a3b8; }
    .post-card-thumb .thumb-note-btn:hover { color: var(--brand-yellow); }
    .post-card-thumb .thumb-bookmark-badge { position: absolute; top: 8px; right: 8px; z-index: 2; background: rgba(255,255,255,.92); border-radius: 8px; padding: 5px 7px; color: var(--brand-yellow); display: flex; align-items: center; justify-content: center; pointer-events: none; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .dark .post-card-thumb .thumb-bookmark-badge { background: rgba(15,23,42,.92); box-shadow: 0 2px 8px rgba(0,0,0,.35); }
    .post-card-thumb .thumb-bookmark-badge svg { width: 16px; height: 16px; }
    .post-card-thumb.has-artwork { background: #0f172a; }
    .post-card-thumb .thumb-artwork { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
    .post-card-thumb.has-artwork .thumb-overlay { background: rgba(0,0,0,.25); }
    .post-card-action-btn.has-artwork { color: var(--brand-yellow); }
    .post-card-thumb .thumb-note-editor { position: absolute; inset: 0; z-index: 3; background: rgba(15,23,42,.92); padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .post-card-thumb .thumb-note-editor.hidden { display: none; }
    .post-card-thumb .thumb-note-editor textarea { flex: 1; resize: none; border-radius: 8px; border: 1px solid rgba(255,255,255,.15); background: rgba(0,0,0,.3); color: #fff; padding: 8px; font-size: 12px; }
    .post-card-actions { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .post-card-action-btn { background: none; border: none; padding: 0; color: var(--brand-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: color .15s ease, transform .15s ease; }
    .post-card-action-btn:hover { color: var(--brand-yellow); transform: translateY(-1px); }
    .post-card-action-btn.liked { color: #ef4444; }
    .post-card-action-btn svg { width: 18px; height: 18px; }
    .platform-badge { display: inline-block; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--brand-muted); margin-bottom: 8px; }
    .tag-pill { font-size: 10px; padding: 2px 8px; border-radius: 9999px; background: rgba(255,214,68,.12); color: var(--brand-yellow); font-weight: 700; border: 1px solid rgba(255,214,68,.2); }
    .post-card .edit-area { display: none; }
    .post-card.editing .edit-area { display: block; }
    .post-card.editing .preview-area,
    .post-card.editing .post-card-actions,
    .post-card.editing .post-card-thumb { display: none; }
    .copy-toast { animation: fadeInOut 2s ease forwards; }
    @keyframes fadeInOut { 0%{opacity:0;transform:translateY(8px)} 15%{opacity:1;transform:translateY(0)} 85%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(-8px)} }
    .style-tag { font-size: 10px; padding: 2px 8px; border-radius: 9999px; background: rgba(255,214,68,.15); color: var(--brand-yellow); font-weight: 700; }
    .action-btn { transition: all .15s ease; }
    .action-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(255,214,68,.2); }
    .calendar-day { min-height: 80px; transition: all .15s ease; }
    .calendar-day:hover { background: rgba(255,214,68,.05); }
    .calendar-day.today { border-color: var(--brand-yellow); background: rgba(255,214,68,.08); }
    .calendar-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
    .hashtag-pill { font-size: 10px; padding: 3px 10px; border-radius: 9999px; background: rgba(255,214,68,.1); color: var(--brand-yellow); font-weight: 700; border: 1px solid rgba(255,214,68,.2); cursor: pointer; transition: all .15s ease; }
    .hashtag-pill:hover { background: rgba(255,214,68,.25); }
    .hashtag-pill.copied { background: var(--brand-yellow); color: #111827; }
    .hashtag-pill.hashtag-pill--hidden { display: none; }
    .hashtag-search-input { width: 100%; border-radius: 0.75rem; border: 1px solid rgba(148,163,184,.35); background: rgba(255,255,255,.9); padding: 0.5rem 0.75rem; font-size: 12px; font-weight: 600; color: var(--brand-dark, #111827); }
    .dark .hashtag-search-input { background: rgba(15,23,42,.85); border-color: rgba(255,255,255,.12); color: #f8fafc; }
    .hashtag-search-input:focus { outline: none; border-color: rgba(255,214,68,.55); box-shadow: 0 0 0 2px rgba(255,214,68,.15); }
    .tag-filter-btn { transition: all .15s ease; font-size: 10px; font-weight: 800; padding: 6px 12px; border-radius: 9999px; text-transform: none; letter-spacing: 0; border: 1px solid var(--brand-border); background: transparent; color: var(--brand-muted); cursor: pointer; }
    .tag-filter-btn:hover { border-color: var(--brand-yellow); color: var(--brand-yellow); }
    .tag-filter-btn.active { background: var(--brand-yellow); color: #111827; border-color: var(--brand-yellow); font-weight: 800; }
    .icon-flat { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .icon-flat-sm { width: 12px; height: 12px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  </style>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden">
  <%- include('partials/navbar') %>

  <main class="max-wide px-4 sm:px-6 py-8 md:py-10">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Content</p>
        <div class="page-heading-with-tip">
          <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Social Post Ideas</h1>
          <%- include('/partials/app_info_tip', {
            tipId: 'social-posts-help',
            tipKey: 'social-posts',
            label: 'Social post ideas',
            size: 'md',
            content: 'Post ideas scoped to your workspace business profile. Bookmark favorites into folders, then open Marketing Studio from any card thumbnail — your post copy loads in the studio and you choose when to Chat and Generate.'
          }) %>
        </div>
        <p id="nicheLabel" class="text-xs text-brand-muted mt-1"></p>
        <div id="styleTags" class="flex flex-wrap gap-2 mt-2"></div>
      </div>
      <div class="flex items-center gap-3">
        <input id="nicheInput" type="text" placeholder="Override niche (optional)"
          class="rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50 w-56" />
        <button onclick="regenerateAll()" class="btn-brand-yellow text-sm font-bold px-4 py-2 rounded-xl whitespace-nowrap action-btn flex items-center gap-1.5">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>
          Refresh Ideas
        </button>
      </div>
    </div>

    <!-- QUICK ACTIONS BAR -->
    <div class="brand-card p-4 md:p-5 dark:bg-slate-900 dark:border-white/10 mb-6">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Quick Actions</span>
        <span id="qaStatus" class="text-[10px] text-brand-muted font-bold"></span>
      </div>
      <div class="flex flex-wrap gap-2">
        <button onclick="qaGeneratePlatform('instagram')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          Instagram
        </button>
        <button onclick="qaGeneratePlatform('facebook')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          Facebook
        </button>
        <button onclick="qaGeneratePlatform('linkedin')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </button>
        <button onclick="qaGeneratePlatform('x')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20"/></svg>
          X
        </button>
        <button onclick="qaGeneratePlatform('tiktok')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
          TikTok
        </button>
        <button onclick="qaGeneratePlatform('gmb')" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Google Business
        </button>
        <button onclick="qaGenerateAll()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>
          All Platforms
        </button>
      </div>
      <div class="flex flex-wrap gap-2 mt-2 pt-2 border-t border-brand-border/30 dark:border-white/10">
        <button onclick="qaCopyAllVisible()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          Copy All
        </button>
        <button onclick="qaSaveAllForReview()" class="action-btn text-xs font-bold px-3 py-1.5 rounded-lg border border-brand-border hover:border-brand-yellow text-brand-dark dark:text-white flex items-center gap-1">
          <svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>
          Save all for review
        </button>
        <div id="tagFilterBar" class="hidden flex flex-wrap items-center gap-2 basis-full pt-1 border-t border-brand-border/30 dark:border-white/10 mt-1"></div>
      </div>
    </div>

    <!-- CONTENT CALENDAR -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
            <svg class="icon-flat" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Content Calendar
          </h2>
          <p class="text-xs text-brand-muted mt-1">This week's planned content from local scout + ideas.</p>
        </div>
        <div class="flex gap-2">
          <button onclick="calendarPrevWeek()" class="text-xs font-bold text-brand-muted hover:text-brand-yellow px-2 py-1">&larr; Prev</button>
          <button onclick="calendarNextWeek()" class="text-xs font-bold text-brand-muted hover:text-brand-yellow px-2 py-1">Next &rarr;</button>
          <button onclick="calendarThisWeek()" class="text-xs font-bold text-brand-yellow hover:underline px-2 py-1">Today</button>
        </div>
      </div>
      <div id="calendarGrid" class="grid grid-cols-7 gap-2"></div>
      <div class="flex gap-4 mt-3 text-[10px] text-brand-muted">
        <span><span class="calendar-dot" style="background:#22c55e"></span> New Business</span>
        <span><span class="calendar-dot" style="background:#f59e0b"></span> Trending</span>
        <span><span class="calendar-dot" style="background:#3b82f6"></span> News</span>
        <span><span class="calendar-dot" style="background:#a855f7"></span> Event</span>
        <span><span class="calendar-dot" style="background:var(--brand-yellow)"></span> Idea</span>
      </div>
    </div>

    <!-- HASHTAG SETS -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
            <svg class="icon-flat" viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
            Hashtag Sets
          </h2>
          <p id="hashtagSetsSubtitle" class="text-xs text-brand-muted mt-1">Search business tags or click to copy.</p>
        </div>
        <button onclick="cycleHashtagSet()" class="text-xs font-bold text-brand-yellow hover:underline">Cycle Set &rarr;</button>
      </div>
      <div id="hashtagContainer" class="brand-card p-4 dark:bg-slate-900 dark:border-white/10"></div>
    </div>

    <!-- Platform Tabs -->
    <div class="flex flex-wrap gap-2 mb-6" id="platformTabs">
      <button class="platform-tab active px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="all">All</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="instagram">Instagram</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="facebook">Facebook</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="linkedin">LinkedIn</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="x">X / Twitter</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="tiktok">TikTok</button>
      <button class="platform-tab px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider" data-platform="gmb">Google Business</button>
    </div>

    <!-- Ideas Grid -->
    <div id="ideasContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-20 text-brand-muted">
        <p class="text-lg font-bold mb-2">Loading today's ideas...</p>
      </div>
    </div>

    <!-- Saved Posts Section -->
    <div class="mt-12 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
        <svg class="icon-flat" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>
        Bookmarked Posts
      </h2>
      <div class="flex items-center gap-2 flex-wrap">
        <select id="bookmarkFolderFilter" class="rounded-lg border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs font-bold text-brand-dark dark:text-white">
          <option value="">All folders</option>
        </select>
        <button onclick="openFolderModalForNew()" class="text-xs font-bold text-brand-yellow hover:underline">+ New folder</button>
        <span id="savedCount" class="text-xs text-brand-muted font-bold">0 saved</span>
      </div>
    </div>
    <div id="savedPostsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noSavedMsg">
        No saved posts yet. Click the bookmark icon on any idea to save it.
      </div>
    </div>

    <!-- Clark County / Local Content Section (agency workspaces only) -->
    <div id="localContentSection" class="mt-14 mb-4 flex items-center justify-between hidden">
      <div>
        <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
          <svg class="icon-flat" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Clark County Content
        </h2>
        <p class="text-xs text-brand-muted mt-1">Daily scout findings for @ClarkCountyGuide. Click the star to save for newsletter.</p>
      </div>
      <span id="localCount" class="text-xs text-brand-muted font-bold">0 items</span>
    </div>
    <div id="localContentContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noLocalMsg">
        No content yet. The daily scout will populate this each morning.
      </div>
    </div>

    <!-- Newsletter Picks Section (agency workspaces only) -->
    <div id="newsletterSection" class="mt-14 mb-4 flex items-center justify-between hidden">
      <div>
        <h2 class="font-display font-bold text-xl text-brand-dark dark:text-white flex items-center gap-2">
          <svg class="icon-flat" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Newsletter Picks
        </h2>
        <p class="text-xs text-brand-muted mt-1">Starred items from Clark County content — ready for your weekly newsletter.</p>
      </div>
      <div class="flex gap-2">
        <span id="newsletterCount" class="text-xs text-brand-muted font-bold">0 picks</span>
        <button onclick="copyNewsletterDraft()" class="text-xs font-bold text-brand-yellow hover:underline">Copy Draft</button>
        <button onclick="clearNewsletterPicks()" class="text-xs font-bold text-brand-muted hover:text-red-500">Clear All</button>
      </div>
    </div>
    <div id="newsletterContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <div class="col-span-full text-center py-12 text-brand-muted text-sm italic" id="noNewsletterMsg">
        No picks yet. Click the star on any Clark County content item to save it here.
      </div>
    </div>

  </main>

  <!-- Style Modal -->
  <div id="styleModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeStyleModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-6 shadow-2xl">
      <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Style Profile</h3>
      <p class="text-xs text-brand-muted mb-4">Tell us about your voice. The more you save, the smarter the ideas get.</p>
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Niche / Business Type</label>
          <input id="styleNiche" type="text" placeholder="e.g. HVAC, coffee shop, roofing" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white" value="<%= (styleProfile && styleProfile.niche) || '' %>" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Tone</label>
          <select id="styleTone" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white">
            <option value="">Select tone...</option>
            <option value="professional">Professional</option>
            <option value="casual">Casual &amp; Friendly</option>
            <option value="bold">Bold &amp; Direct</option>
            <option value="educational">Educational</option>
            <option value="storyteller">Storyteller</option>
            <option value="humorous">Humorous</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Go-to Hooks (comma-separated)</label>
          <textarea id="styleHooks" rows="2" placeholder="e.g. Most owners don't realize, Here's what happened when" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50"></textarea>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Go-to CTAs (comma-separated)</label>
          <textarea id="styleCtas" rows="2" placeholder="e.g. Link in bio, Comment below, DM us" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-brand-dark dark:text-white placeholder:text-brand-muted/50"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button onclick="closeStyleModal()" class="text-sm font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-4 py-2">Cancel</button>
        <button onclick="saveStyle()" class="btn-brand-yellow text-sm font-bold px-5 py-2 rounded-xl">Save Style</button>
      </div>
    </div>
  </div>

  <!-- Bookmark Folder Modal -->
  <div id="folderModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeFolderModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-6 shadow-2xl">
      <h3 id="folderModalTitle" class="font-display font-bold text-lg text-brand-dark dark:text-white mb-4">Save to folder</h3>
      <div id="folderPickerList" class="space-y-2 mb-4 max-h-48 overflow-y-auto"></div>
      <div class="border-t border-brand-border/40 pt-4">
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Or create new folder</label>
        <div class="flex gap-2">
          <input id="newFolderName" type="text" placeholder="e.g. Review later, Q1 campaign" class="flex-1 rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white" />
          <button onclick="createFolderAndSave()" class="btn-brand-yellow text-xs font-bold px-4 py-2 rounded-xl whitespace-nowrap">Create</button>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-5">
        <button onclick="closeFolderModal()" class="text-sm font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-4 py-2">Cancel</button>
        <button onclick="saveToFolder(null)" class="text-sm font-bold text-brand-yellow px-4 py-2">Save without folder</button>
      </div>
    </div>
  </div>

  <!-- Tags Modal -->
  <div id="tagsModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeTagsModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-brand-border dark:border-white/10 p-6 shadow-2xl">
      <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white mb-2">Tags</h3>
      <p class="text-xs text-brand-muted mb-3">Comma-separated tags, or pick from the current hashtag set.</p>
      <input id="tagsModalInput" type="text" placeholder="e.g. #LocalBusiness, #TipTuesday" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-brand-dark dark:text-white mb-3" />
      <div id="tagsModalPills" class="flex flex-wrap gap-1.5 mb-4 max-h-24 overflow-y-auto"></div>
      <div class="flex justify-end gap-3">
        <button onclick="closeTagsModal()" class="text-sm font-bold text-brand-muted hover:text-brand-dark dark:hover:text-white px-4 py-2">Cancel</button>
        <button onclick="saveTagsModal()" class="btn-brand-yellow text-sm font-bold px-5 py-2 rounded-xl">Save tags</button>
      </div>
    </div>
  </div>

  <!-- Copy Toast -->
  <div id="copyToast" class="fixed bottom-6 right-6 z-50 hidden">
    <div class="copy-toast bg-brand-dark dark:bg-white text-white dark:text-brand-dark text-sm font-bold px-5 py-3 rounded-xl shadow-2xl" id="copyToastText">
      Copied to clipboard
    </div>
  </div>

  <%- include('/partials/app_shell_close') %>

  <script>
    // ── State ──────────────────────────────────────────────────────────────────
    const WORKSPACE_ID = <%- JSON.stringify(workspaceId || 'default') %>;
    const businessProfile = <%- JSON.stringify(typeof businessProfile !== 'undefined' ? businessProfile : {}) %>;
    let currentPlatform = 'all';
    let allIdeas = {};
    let savedPosts = [];
    let bookmarkFolders = <%- JSON.stringify(typeof bookmarkFolders !== 'undefined' ? bookmarkFolders : []) %>;
    let localContentItems = [];
    let styleProfile = <%- JSON.stringify(styleProfile || {}) %>;
    let calendarOffset = 0;
    let currentHashtagSet = 0;
    let pendingBookmark = null;
    let savedFolderFilter = '';
    let currentTagFilter = '';
    let reviewFolderId = null;
    let pendingTagsTarget = null;
    const ideaCardState = {};
    let ideaArtworks = {};
    const IDEA_STATE_KEY = 'adhello-social-idea-state-' + WORKSPACE_ID;

    function normalizeTagLabel(tag) {
      return String(tag || '').trim().toLowerCase().replace(/^#/, '');
    }

    function parseTagsInput(raw) {
      return String(raw || '').split(/[,;]+/).map(function (t) { return t.trim(); }).filter(Boolean);
    }

    function loadIdeaCardState() {
      try {
        const raw = localStorage.getItem(IDEA_STATE_KEY);
        if (raw) Object.assign(ideaCardState, JSON.parse(raw));
      } catch { /* ignore */ }
    }

    function persistIdeaCardState() {
      try { localStorage.setItem(IDEA_STATE_KEY, JSON.stringify(ideaCardState)); } catch { /* ignore */ }
    }

    function getIdeaState(ideaId) {
      if (!ideaCardState[ideaId]) ideaCardState[ideaId] = { liked: false, tags: [], imageNote: '' };
      return ideaCardState[ideaId];
    }

    async function loadIdeaArtworks() {
      try {
        const res = await fetch('/social-posts/api/idea-artwork?workspaceId=' + encodeURIComponent(WORKSPACE_ID));
        const data = await res.json();
        if (data.success && data.artworks) ideaArtworks = data.artworks;
      } catch { /* ignore */ }
    }

    function getArtworkForCard(mode, platform, ideaId, postId, savedArtworkUrl) {
      if (savedArtworkUrl) return savedArtworkUrl;
      if (mode === 'saved' && postId) {
        const post = savedPosts.find(function (p) { return p.id === postId; });
        if (post && post.artworkUrl) return post.artworkUrl;
      }
      if (ideaId) {
        const st = getIdeaState(ideaId);
        if (st.artworkUrl) return st.artworkUrl;
        if (ideaArtworks[ideaId] && ideaArtworks[ideaId].artworkUrl) return ideaArtworks[ideaId].artworkUrl;
        const saved = savedPosts.find(function (sp) { return sp.ideaId === ideaId && sp.platform === platform; });
        if (saved && saved.artworkUrl) return saved.artworkUrl;
      }
      return '';
    }

    function getTagsForIdea(platform, ideaId) {
      const st = ideaCardState[ideaId];
      if (st && Array.isArray(st.tags) && st.tags.length) return st.tags;
      const saved = savedPosts.find(function (sp) { return sp.ideaId === ideaId && sp.platform === platform; });
      if (saved && Array.isArray(saved.tags) && saved.tags.length) return saved.tags;
      const byContent = savedPosts.find(function (sp) { return sp.platform === platform; });
      if (byContent && byContent.ideaId === ideaId && byContent.tags && byContent.tags.length) return byContent.tags;
      return [];
    }

    function collectAllSavedTags() {
      const map = new Map();
      Object.keys(ideaCardState).forEach(function (id) {
        (ideaCardState[id].tags || []).forEach(function (t) {
          const n = normalizeTagLabel(t);
          if (n) map.set(n, String(t).trim());
        });
      });
      savedPosts.forEach(function (post) {
        (post.tags || []).forEach(function (t) {
          const n = normalizeTagLabel(t);
          if (n) map.set(n, String(t).trim());
        });
      });
      return Array.from(map.entries()).sort(function (a, b) { return a[0].localeCompare(b[0]); });
    }

    function renderTagFilters() {
      const bar = document.getElementById('tagFilterBar');
      if (!bar) return;
      const tags = collectAllSavedTags();
      if (!tags.length) {
        bar.classList.add('hidden');
        bar.innerHTML = '';
        return;
      }
      bar.classList.remove('hidden');
      let html = '<span class="text-[10px] font-black uppercase tracking-widest text-brand-muted mr-1">Filter by tag</span>';
      html += '<button type="button" class="tag-filter-btn' + (currentTagFilter ? '' : ' active') + '" onclick="switchTagFilter(\'\')">All tags</button>';
      tags.forEach(function (entry) {
        const norm = entry[0];
        const label = entry[1];
        html += '<button type="button" class="tag-filter-btn' + (currentTagFilter === norm ? ' active' : '') + '" onclick="switchTagFilter(\'' + norm.replace(/'/g, "\\'") + '\')">' + escapeHtml(label) + '</button>';
      });
      bar.innerHTML = html;
    }

    function switchTagFilter(tagNorm) {
      currentTagFilter = tagNorm || '';
      renderTagFilters();
      renderIdeas();
      renderSavedPosts();
      if (currentTagFilter) {
        updateTagFilterIndicator();
      } else {
        const el = document.getElementById('qaStatus');
        if (el && el.textContent.startsWith('Tag filter:')) el.textContent = '';
      }
    }

    function ideaHasTagFilter(platform, idea) {
      if (!currentTagFilter) return true;
      return getTagsForIdea(platform, idea.id).some(function (t) {
        return normalizeTagLabel(t) === currentTagFilter;
      });
    }

    function postHasTagFilter(post) {
      if (!currentTagFilter) return true;
      const postTags = post.tags && post.tags.length
        ? post.tags
        : (post.ideaId ? (getIdeaState(post.ideaId).tags || []) : []);
      return postTags.some(function (t) {
        return normalizeTagLabel(t) === currentTagFilter;
      });
    }

    function updateTagFilterIndicator() {
      const el = document.getElementById('qaStatus');
      if (!el || !currentTagFilter) return;
      const match = collectAllSavedTags().find(function (entry) { return entry[0] === currentTagFilter; });
      const label = match ? match[1] : currentTagFilter;
      el.textContent = 'Tag filter: ' + label;
    }

    // ── Flat SVG Icons (inline for convenience) ────────────────────────────────
    const ICONS = {
      refresh: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>',
      bookmark: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>',
      bookmarkFilled: '<svg class="icon-flat-sm" viewBox="0 0 24 24" fill="currentColor"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/></svg>',
      copy: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>',
      star: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
      starFilled: '<svg class="icon-flat-sm" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
      trash: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>',
      edit: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
      mapPin: '<svg class="icon-flat" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>',
      calendar: '<svg class="icon-flat" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
      hashtag: '<svg class="icon-flat" viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>',
      instagram: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
      tiktok: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>',
      save: '<svg class="icon-flat-sm" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>',
      heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>',
      heartFilled: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>',
      note: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
      send: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>',
      download: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
    };

    const PLATFORM_LABELS = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', x: 'X / Twitter', tiktok: 'TikTok', gmb: 'Google Business' };
    const DM_PLATFORMS = { instagram: 'instagram_feed', facebook: 'facebook_feed', linkedin: 'linkedin_post', x: 'instagram_feed', tiktok: 'instagram_story', gmb: 'google_business_post' };

    // ── Hashtag Sets ───────────────────────────────────────────────────────────
    function businessHashtagTag(name) {
      const tag = String(name || '').replace(/[^a-zA-Z0-9]/g, '');
      return tag ? '#' + tag : '';
    }

    function buildHashtagSets() {
      const biz = String(businessProfile.businessName || 'Your Business').trim();
      const bizTag = businessHashtagTag(biz);
      if (businessProfile && businessProfile.isAgencyWorkspace) {
        return [
          {
            name: biz,
            tags: [...new Set([
              bizTag,
              '#DigitalMarketing',
              '#LocalSEO',
              '#GoogleBusinessProfile',
              '#SmallBusiness',
              '#MarketingTips',
              '#ClarkCounty',
              '#VancouverWA',
              '#PNW',
              '#ShopLocal',
              '#SupportLocal',
            ].filter(Boolean))],
          },
          { name: 'Clark County Local', tags: ['#ClarkCounty','#VancouverWA','#PNW','#PacificNorthwest','#WashingtonState','#CouverLife','#360','#PortlandMetro','#ClarkCountyWA','#ShopLocal'] },
          { name: 'Small Business', tags: ['#SmallBusiness','#ShopSmall','#SmallBusinessOwner','#Entrepreneur','#LocalBusiness','#SupportLocal','#BusinessOwner','#SupportSmallBusiness','#LocalFirst','#CommunityFirst'] },
          { name: 'New Business / Opening', tags: ['#GrandOpening','#NewBusiness','#NewInTown','#NowOpen','#GrandOpeningDay','#JustOpened','#NewSpot','#CheckThisOut','#LocalNews','#BusinessSpotlight'] },
          { name: 'Real Estate / Development', tags: ['#RealEstate','#NewDevelopment','#Construction','#Growth','#Downtown','#VancouverDowntown','#PDXRealEstate','#Housing','#CommercialRealEstate','#UrbanDevelopment'] },
          { name: 'Engagement / Community', tags: ['#KnowYourCity','#LocalLove','#CommunityMatters','#ExploreLocal','#HiddenGems','#ThingsToDo','#WeekendVibes','#LocalEats','#ExplorePNW','#WAFood'] }
        ];
      }
      const nicheTag = businessHashtagTag(businessProfile.icpKeyword || biz);
      return [
        {
          name: biz,
          tags: [...new Set([
            bizTag || nicheTag,
            '#SmallBusiness',
            '#LocalBusiness',
            '#ShopLocal',
            '#SupportLocal',
            '#HomeImprovement',
            '#ContractorLife',
            '#QualityWork',
            '#CustomerFirst',
            '#BeforeAndAfter',
          ].filter(Boolean))],
        },
        { name: 'Engagement', tags: ['#TipTuesday', '#Transformation', '#ProjectOfTheWeek', '#CustomerReview', '#BehindTheScenes', '#ProTips', '#HomeOwner', '#LocalExpert', '#TrustedPro', '#FreeEstimate'] },
        { name: 'Industry', tags: ['#Flooring', '#HomeRenovation', '#InteriorDesign', '#Contractor', '#Builder', '#Remodel', '#NewConstruction', '#DesignInspo', '#Craftsmanship', '#QualityInstall'] }
      ];
    }
    let hashtagSets = buildHashtagSets();
    let hashtagSearchQuery = '';

    // ── Init: auto-load ideas on page visit ────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async () => {
      loadIdeaCardState();
      await loadIdeaArtworks();
      renderTagFilters();
      renderStyleTags();
      renderNicheLabel();
      renderBookmarkFolderFilter();
      ensureReviewFolder();
      renderHashtagSubtitle();
      if (businessProfile.showLocalContent) {
        document.getElementById('localContentSection')?.classList.remove('hidden');
        document.getElementById('newsletterSection')?.classList.remove('hidden');
        loadLocalContent();
      }
      loadSavedPosts();
      renderCalendar();
      renderHashtags();
      regenerateAll();
    });

    function renderNicheLabel() {
      const el = document.getElementById('nicheLabel');
      if (!el || !businessProfile.niche) return;
      el.textContent = 'Ideas for: ' + businessProfile.niche;
    }

    function wsQuery() { return 'workspaceId=' + encodeURIComponent(WORKSPACE_ID); }

    // ── QUICK ACTIONS ───────────────────────────────────────────────────────────
    function qaStatus(msg) {
      const el = document.getElementById('qaStatus');
      el.textContent = msg;
      setTimeout(() => el.textContent = '', 3000);
    }

    async function qaGeneratePlatform(platform) {
      const preset = document.getElementById('nicheInput').value.trim();
      const q = preset ? '&preset=' + encodeURIComponent(preset) : '';
      try {
        const res = await fetch('/social-posts/api/ideas?' + wsQuery() + q);
        const data = await res.json();
        if (data.success) {
          allIdeas = data.ideas;
          switchTab(platform);
          qaStatus((PLATFORM_LABELS[platform] || platform) + ' ideas ready');
        }
      } catch (err) { qaStatus('Error generating'); }
    }

    async function qaGenerateAll() { await regenerateAll(); qaStatus('All platforms generated'); }

    function qaCopyAllVisible() {
      const platforms = currentPlatform === 'all' ? Object.keys(allIdeas) : [currentPlatform];
      let allText = '';
      for (const p of platforms) {
        const ideas = allIdeas[p] || [];
        allText += '=== ' + p.toUpperCase() + ' ===\n';
        for (const idea of ideas) { allText += idea.hook + '\n'; if (idea.cta) allText += 'CTA: ' + idea.cta + '\n'; allText += '\n'; }
      }
      if (!allText.trim()) { qaStatus('No ideas to copy'); return; }
      navigator.clipboard.writeText(allText.trim()).then(() => { showCopyToast(); qaStatus('Copied all visible ideas'); });
    }

    function switchTab(platform) {
      currentPlatform = platform;
      document.querySelectorAll('.platform-tab').forEach(t => t.classList.remove('active'));
      const tab = document.querySelector(`[data-platform="${platform}"]`);
      if (tab) tab.classList.add('active');
      renderIdeas();
    }

    // ── CONTENT CALENDAR ────────────────────────────────────────────────────────
    function renderCalendar() {
      const grid = document.getElementById('calendarGrid');
      const today = new Date();
      const startOfWeek = new Date(today);
      startOfWeek.setDate(today.getDate() - today.getDay() + (calendarOffset * 7));
      const days = [];
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      for (let i = 0; i < 7; i++) { const d = new Date(startOfWeek); d.setDate(startOfWeek.getDate() + i); days.push(d); }
      const contentByDate = {};
      for (const item of localContentItems) {
        if (!item.createdAt) continue;
        const d = item.createdAt.slice(0, 10);
        if (!contentByDate[d]) contentByDate[d] = [];
        contentByDate[d].push(item);
      }
      grid.innerHTML = '';
      for (const d of days) {
        const dateStr = d.toISOString().slice(0, 10);
        const isToday = dateStr === new Date().toISOString().slice(0, 10);
        const items = contentByDate[dateStr] || [];
        const div = document.createElement('div');
        div.className = 'calendar-day brand-card rounded-xl border border-brand-border/40 p-2 dark:bg-slate-900 dark:border-white/10' + (isToday ? ' today' : '');
        const dots = items.slice(0, 4).map(item => {
          const colors = { 'new-business': '#22c55e', 'trending': '#f59e0b', 'news': '#3b82f6', 'event': '#a855f7', 'viral': '#ef4444', 'general': 'var(--brand-muted)' };
          return '<span class="calendar-dot" style="background:' + (colors[item.category] || 'var(--brand-muted)') + '; margin-right:2px" title="' + escapeHtml(item.title) + '"></span>';
        }).join('');
        div.innerHTML = '<div class="text-[10px] font-black uppercase tracking-widest ' + (isToday ? 'text-brand-yellow' : 'text-brand-muted') + ' mb-1">' + dayNames[d.getDay()] + ' ' + (d.getMonth() + 1) + '/' + d.getDate() + '</div><div class="mb-1">' + dots + '</div>' + (items.length ? '<div class="text-[10px] font-bold text-brand-dark dark:text-white">' + items.length + ' item' + (items.length > 1 ? 's' : '') + '</div>' : '<div class="text-[10px] text-brand-muted/40">-</div>') + (items.length ? items.slice(0, 2).map(item => '<div class="text-[9px] text-brand-muted truncate">' + escapeHtml(item.title) + '</div>').join('') : '');
        grid.appendChild(div);
      }
    }
    function calendarPrevWeek() { calendarOffset--; renderCalendar(); }
    function calendarNextWeek() { calendarOffset++; renderCalendar(); }
    function calendarThisWeek() { calendarOffset = 0; renderCalendar(); }

    // ── HASHTAGS ────────────────────────────────────────────────────────────────
    function renderHashtagSubtitle() {
      const el = document.getElementById('hashtagSetsSubtitle');
      if (!el) return;
      const biz = String(businessProfile.businessName || 'your business').trim();
      el.textContent = 'Tags for ' + biz + '. Search or click to copy.';
    }

    function filterHashtagSearch(value) {
      hashtagSearchQuery = String(value || '').trim().toLowerCase();
      renderHashtagPillsOnly();
    }

    function renderHashtagPillsOnly() {
      const wrap = document.getElementById('hashtagPillsWrap');
      const countEl = document.getElementById('hashtagVisibleCount');
      const set = hashtagSets[currentHashtagSet % hashtagSets.length];
      if (!wrap || !set) return;
      const filtered = hashtagSearchQuery
        ? set.tags.filter(function (t) { return t.toLowerCase().includes(hashtagSearchQuery); })
        : set.tags.slice();
      if (countEl) {
        countEl.textContent = hashtagSearchQuery
          ? filtered.length + ' of ' + set.tags.length + ' tags'
          : set.tags.length + ' tags';
      }
      wrap.innerHTML = filtered.length
        ? filtered.map(function (t) {
          return '<span class="hashtag-pill" onclick="copyHashtag(\'' + t.replace(/'/g, "\\'") + '\', this)">' + escapeHtml(t) + '</span>';
        }).join('')
        : '<p class="text-[11px] text-brand-muted italic w-full">No tags match “‘ + escapeHtml(hashtagSearchQuery) + '”.</p>';
      const copyBtn = document.getElementById('hashtagCopyAllBtn');
      if (copyBtn) {
        copyBtn.textContent = hashtagSearchQuery
          ? 'Copy ' + filtered.length + ' Shown Tags'
          : 'Copy All ' + set.tags.length + ' Tags';
        copyBtn.disabled = !filtered.length;
      }
    }

    function renderHashtags() {
      const container = document.getElementById('hashtagContainer');
      const set = hashtagSets[currentHashtagSet % hashtagSets.length];
      container.innerHTML =
        '<div class="flex items-center justify-between mb-2 gap-2">' +
          '<span class="text-xs font-bold text-brand-dark dark:text-white">' + escapeHtml(set.name) + '</span>' +
          '<span id="hashtagVisibleCount" class="text-[9px] text-brand-muted shrink-0">' + set.tags.length + ' tags</span>' +
        '</div>' +
        '<input type="search" id="hashtagSearchInput" class="hashtag-search-input" placeholder="Search tags (e.g. local, marketing, Vancouver)…" value="' + escapeHtml(hashtagSearchQuery) + '" autocomplete="off" aria-label="Search hashtag tags" />' +
        '<div id="hashtagPillsWrap" class="flex flex-wrap gap-1.5 mb-3 mt-2"></div>' +
        '<button type="button" id="hashtagCopyAllBtn" onclick="copyAllHashtags()" class="btn-brand-yellow text-xs font-bold px-3 py-1.5 rounded-lg">Copy All ' + set.tags.length + ' Tags</button>';
      const input = document.getElementById('hashtagSearchInput');
      if (input) {
        input.addEventListener('input', function () { filterHashtagSearch(input.value); });
      }
      renderHashtagPillsOnly();
    }
    function copyHashtag(tag, el) { navigator.clipboard.writeText(tag).then(() => { el.classList.add('copied'); setTimeout(() => el.classList.remove('copied'), 1500); qaStatus('Copied ' + tag); }); }
    function copyAllHashtags() {
      const set = hashtagSets[currentHashtagSet % hashtagSets.length];
      const tags = hashtagSearchQuery
        ? set.tags.filter(function (t) { return t.toLowerCase().includes(hashtagSearchQuery); })
        : set.tags;
      if (!tags.length) { qaStatus('No tags to copy'); return; }
      navigator.clipboard.writeText(tags.join(' ')).then(() => { showCopyToast(); qaStatus('Copied ' + tags.length + ' hashtags'); });
    }
    function cycleHashtagSet() { currentHashtagSet++; hashtagSearchQuery = ''; renderHashtags(); }

    // ── Platform Tabs ──────────────────────────────────────────────────────────
    document.querySelectorAll('.platform-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.platform-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentPlatform = tab.dataset.platform;
        renderIdeas();
      });
    });

    // ── Generate Ideas ───────────────────────────────────────────────────────────
    async function regenerateAll() {
      const preset = document.getElementById('nicheInput').value.trim();
      const q = preset ? '&preset=' + encodeURIComponent(preset) : '';
      const container = document.getElementById('ideasContainer');
      container.innerHTML = '<div class="col-span-full text-center py-20 text-brand-muted"><p class="text-lg font-bold">Generating fresh ideas...</p></div>';
      try {
        const res = await fetch('/social-posts/api/ideas?' + wsQuery() + q);
        const data = await res.json();
        if (data.success) {
          allIdeas = data.ideas;
          if (data.niche) {
            const lbl = document.getElementById('nicheLabel');
            if (lbl) lbl.textContent = 'Ideas for: ' + data.niche;
          }
          renderIdeas();
        }
        else { container.innerHTML = '<div class="col-span-full text-center py-20 text-red-500"><p class="font-bold">Error: ' + (data.error || 'Failed') + '</p></div>'; }
      } catch (err) { container.innerHTML = '<div class="col-span-full text-center py-20 text-red-500"><p class="font-bold">Connection error.</p></div>'; }
    }

    function renderIdeas() {
      const container = document.getElementById('ideasContainer');
      container.innerHTML = '';
      const platforms = currentPlatform === 'all' ? Object.keys(allIdeas) : [currentPlatform];
      let total = 0;
      let filteredOut = 0;
      for (const p of platforms) {
        for (const idea of (allIdeas[p] || [])) {
          if (!ideaHasTagFilter(p, idea)) { filteredOut++; continue; }
          total++;
          container.appendChild(createIdeaCard(idea, p));
        }
      }
      if (!total) {
        if (currentTagFilter && filteredOut > 0) {
          const match = collectAllSavedTags().find(function (entry) { return entry[0] === currentTagFilter; });
          const label = match ? match[1] : currentTagFilter;
          container.innerHTML = '<div class="col-span-full text-center py-20 text-brand-muted"><p class="text-lg font-bold mb-2">No ideas match tag filter</p><p class="text-sm">No ideas tagged with <span class="tag-pill">' + escapeHtml(label) + '</span>. <button type="button" onclick="switchTagFilter(\'\')" class="text-brand-yellow font-bold hover:underline ml-1">Clear filter</button></p></div>';
        } else {
          container.innerHTML = '<div class="col-span-full text-center py-20 text-brand-muted"><p class="text-lg font-bold mb-2">No ideas yet</p><p class="text-sm">Click Refresh Ideas to generate</p></div>';
        }
      }
    }

    function resolveDmPlatform(platform, extras) {
      extras = extras || {};
      if (extras.dmPlatform && typeof extras.dmPlatform === 'string') return extras.dmPlatform;
      const format = String(extras.format || '').trim().toLowerCase();
      if (platform === 'instagram') {
        if (format === 'story' || format === 'reels' || format === 'reel') return 'instagram_story';
        if (format === 'portrait') return 'instagram_portrait';
        return 'instagram_feed';
      }
      if (platform === 'facebook') {
        if (format === 'story') return 'facebook_story';
        if (format === 'cover') return 'facebook_cover';
        return 'facebook_feed';
      }
      if (platform === 'linkedin') {
        if (format === 'banner' || format === 'cover') return 'linkedin_banner';
        return 'linkedin_post';
      }
      if (platform === 'tiktok') return 'instagram_story';
      return DM_PLATFORMS[platform] || 'instagram_feed';
    }

    function marketingStudioUrl(platform, hook, cta, extras) {
      extras = extras || {};
      const dmPlatform = resolveDmPlatform(platform, extras);
      const copy = hook + (cta ? '\n\n' + cta : '');
      const params = new URLSearchParams({
        fromSocialPost: '1',
        platform: dmPlatform,
        copy: copy,
        headline: hook.slice(0, 120),
        body: cta || '',
      });
      if (extras.imageNote) params.set('imageNote', String(extras.imageNote).slice(0, 500));
      if (extras.tags && extras.tags.length) params.set('tags', extras.tags.join(', ').slice(0, 200));
      if (extras.postId) params.set('postId', String(extras.postId));
      if (extras.ideaId) params.set('ideaId', String(extras.ideaId));
      if (extras.socialPlatform) params.set('socialPlatform', String(extras.socialPlatform));
      return '/direct-mail?' + params.toString();
    }

    function launchMarketingStudioFromCard(mode, ideaId, postId, platform) {
      let hook = '';
      let cta = '';
      let imageNote = '';
      let tags = [];
      if (mode === 'saved') {
        const post = savedPosts.find(function (p) { return p.id === postId; });
        if (post) {
          hook = post.content || '';
          cta = post.cta || '';
          imageNote = post.imageNote || '';
          tags = post.tags || [];
        }
      } else {
        const card = document.querySelector('[data-idea-id="' + ideaId + '"]');
        if (card) {
          hook = card.querySelector('.preview-hook')?.textContent || '';
          const ctaEl = card.querySelector('.preview-cta');
          cta = ctaEl ? ctaEl.textContent.replace(/^CTA:\s*/, '') : '';
        }
        const state = getIdeaState(ideaId);
        imageNote = state.imageNote || '';
        tags = getTagsForIdea(platform, ideaId);
      }
      if (!String(hook).trim()) {
        qaStatus('Add post copy before creating artwork');
        return;
      }
      window.location.href = marketingStudioUrl(platform, hook, cta, {
        imageNote: imageNote,
        tags: tags,
        postId: mode === 'saved' ? postId : '',
        ideaId: mode === 'idea' ? ideaId : '',
        socialPlatform: platform,
      });
    }

    function cardRef(mode, ideaId, postId) {
      return mode === 'saved' ? 'saved-' + postId : 'idea-' + ideaId;
    }

    function buildPostCardHtml(opts) {
      const {
        mode = 'idea', platform, hook = '', cta = '', ideaId = '', postId = '',
        isSaved = false, liked = false, tags = [], imageNote = '', metaLabel = '',
        artworkUrl = '',
      } = opts;
      const ref = cardRef(mode, ideaId, postId);
      const platformLabel = (PLATFORM_LABELS[platform] || platform || '').toUpperCase();
      const resolvedArtwork = artworkUrl || getArtworkForCard(mode, platform, ideaId, postId, '');
      const hasArtwork = !!resolvedArtwork;
      const studioLaunch = mode === 'saved'
        ? "launchMarketingStudioFromCard('saved','','" + postId.replace(/'/g, "\\'") + "','" + platform.replace(/'/g, "\\'") + "')"
        : "launchMarketingStudioFromCard('idea','" + ideaId.replace(/'/g, "\\'") + "','','" + platform.replace(/'/g, "\\'") + "')";
      const likeClass = liked ? ' liked' : '';
      const likeIcon = liked ? ICONS.heartFilled : ICONS.heart;
      const bookmarkIcon = isSaved ? ICONS.bookmarkFilled : ICONS.bookmark;
      const bookmarkColor = isSaved ? ' style="color:var(--brand-yellow)"' : '';
      const noteDisplay = imageNote && !hasArtwork
        ? '<div class="thumb-note-display"><span>' + escapeHtml(imageNote) + '</span></div>'
        : '';
      const artworkImg = hasArtwork
        ? '<img class="thumb-artwork" src="' + escapeHtml(resolvedArtwork) + '" alt="Generated artwork" loading="lazy" />'
        : '';
      const thumbClass = 'post-card-thumb cursor-pointer' + (hasArtwork ? ' has-artwork' : '');
      const overlayLabel = hasArtwork ? 'Open studio →' : 'Open studio →';
      const tagPills = tags.length
        ? '<div class="flex flex-wrap gap-1 mt-2">' + tags.map(t => '<span class="tag-pill">' + escapeHtml(t) + '</span>').join('') + '</div>'
        : '';
      const deleteBtn = mode === 'saved'
        ? '<button type="button" onclick="event.stopPropagation();deleteSaved(\'' + postId.replace(/'/g, "\\'") + '\')" class="post-card-action-btn" title="Delete">' + ICONS.trash + '</button>'
        : '';
      const bookmarkHandler = mode === 'saved'
        ? 'toggleSaveSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'toggleSaveIdea(\'' + ideaId.replace(/'/g, "\\'") + '\', \'' + platform.replace(/'/g, "\\'") + '\')';
      const likeHandler = mode === 'saved'
        ? 'toggleLikeSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'toggleLikeIdea(\'' + ideaId.replace(/'/g, "\\'") + '\')';
      const tagsHandler = mode === 'saved'
        ? 'openTagsModalSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'openTagsModalIdea(\'' + ideaId.replace(/'/g, "\\'") + '\')';
      const sendHandler = mode === 'saved'
        ? 'exportToDriveSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'exportToDriveIdea(\'' + ideaId.replace(/'/g, "\\'") + '\', \'' + platform.replace(/'/g, "\\'") + '\')';
      const downloadHandler = mode === 'saved'
        ? 'downloadArtworkSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'downloadArtworkIdea(\'' + ideaId.replace(/'/g, "\\'") + '\', \'' + platform.replace(/'/g, "\\'") + '\')';
      const downloadBtn = hasArtwork
        ? '<button type="button" onclick="event.stopPropagation();' + downloadHandler + '" class="post-card-action-btn has-artwork" title="Download artwork">' + ICONS.download + '</button>'
        : '';
      const editHandler = mode === 'saved'
        ? 'toggleEditSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'toggleEdit(\'' + ideaId.replace(/'/g, "\\'") + '\')';
      const noteHandler = mode === 'saved'
        ? 'toggleNoteEditorSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'toggleNoteEditorIdea(\'' + ideaId.replace(/'/g, "\\'") + '\')';
      const saveNoteHandler = mode === 'saved'
        ? 'saveNoteSaved(\'' + postId.replace(/'/g, "\\'") + '\')'
        : 'saveNoteIdea(\'' + ideaId.replace(/'/g, "\\'") + '\')';
      const editArea = mode === 'idea'
        ? ideaEditAreaHtml(ideaId, hook, cta)
        : savedEditAreaHtml(postId, hook, cta);

      const bookmarkBadge = isSaved
        ? '<span class="thumb-bookmark-badge" title="Bookmarked">' + ICONS.bookmarkFilled + '</span>'
        : '';
      return '<div class="' + thumbClass + '" onclick="event.stopPropagation();' + studioLaunch + '">' +
        artworkImg +
        noteDisplay +
        bookmarkBadge +
        '<button type="button" class="thumb-note-btn" onclick="event.stopPropagation();' + noteHandler + '" title="Art direction note (optional)">' + ICONS.note + '</button>' +
        '<div class="thumb-note-editor hidden" data-note-editor="' + ref + '">' +
        '<textarea placeholder="Optional art direction for AI (e.g. before/after flooring, warm lighting)..." data-note-input="' + ref + '">' + escapeHtml(imageNote) + '</textarea>' +
        '<div class="flex gap-2"><button type="button" onclick="event.stopPropagation();' + saveNoteHandler + '" class="btn-brand-yellow text-xs font-bold px-3 py-1 rounded-lg">Save note</button>' +
        '<button type="button" onclick="event.stopPropagation();closeNoteEditor(\'' + ref.replace(/'/g, "\\'") + '\')" class="text-xs font-bold text-brand-muted px-2 py-1">Close</button></div></div>' +
        '<div class="thumb-overlay"><span class="thumb-label">' + overlayLabel + '</span></div></div>' +
        '<div class="post-card-actions">' +
        downloadBtn +
        '<button type="button" onclick="event.stopPropagation();' + likeHandler + '" class="post-card-action-btn' + likeClass + '" title="Like" data-like-btn="' + ref + '">' + likeIcon + '</button>' +
        '<button type="button" onclick="event.stopPropagation();' + bookmarkHandler + '" class="post-card-action-btn"' + bookmarkColor + ' title="' + (isSaved ? 'Saved' : 'Bookmark') + '">' + bookmarkIcon + '</button>' +
        '<button type="button" onclick="event.stopPropagation();' + tagsHandler + '" class="post-card-action-btn" title="Tags">' + ICONS.hashtag + '</button>' +
        '<button type="button" onclick="event.stopPropagation();' + sendHandler + '" class="post-card-action-btn" title="Send to Google Drive">' + ICONS.send + '</button>' +
        '<button type="button" onclick="event.stopPropagation();' + editHandler + '" class="post-card-action-btn" title="Edit">' + ICONS.edit + '</button>' +
        deleteBtn +
        '</div>' +
        '<div class="preview-area">' +
