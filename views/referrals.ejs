<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .referral-layout { display: grid; gap: 2.5rem; align-items: start; }
    @media (min-width: 1024px) {
      .referral-layout { grid-template-columns: minmax(16rem, 0.86fr) minmax(20rem, 1.14fr); gap: 3.5rem; }
    }
    .referral-step { display: flex; gap: 0.85rem; align-items: flex-start; }
    .referral-step svg { width: 1.35rem; height: 1.35rem; margin-top: 0.15rem; flex: none; color: #64748b; }
    .referral-card { background: #fff; border: 1px solid rgba(15, 23, 42, 0.06); border-radius: 1.75rem; box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06); }
    .referral-row + .referral-row { border-top: 1px solid rgba(15, 23, 42, 0.06); }
    .referral-pill { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0.4rem 0.85rem; font-size: 0.75rem; font-weight: 700; line-height: 1; white-space: nowrap; }
    .referral-pill-connect { background: #FFDB3A; color: #0F172A; }
    .referral-pill-connect:hover { filter: brightness(0.97); }
    .referral-pill-connected { border: 1px solid #34d399; color: #047857; background: #fff; }
    .referral-pill-intro { background: #fef3c7; color: #b45309; }
    .referral-mini { font-size: 0.68rem; font-weight: 700; color: #64748b; }
    .referral-mini:hover { color: #0F172A; }
    .dark .referral-card { background: rgb(15 23 42 / 0.8); border-color: rgb(255 255 255 / 0.08); }
    .dark .referral-row + .referral-row { border-color: rgb(255 255 255 / 0.08); }
    .dark .referral-pill-connected { background: transparent; color: #6ee7b7; }
  </style>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <%
    const placeParts = [];
    if (trade) placeParts.push(String(trade));
    const geo = [city, state].filter(Boolean).join(', ');
    if (geo) placeParts.push(geo);
    const placeLabel = placeParts.join(' · ');
    const rows = Array.isArray(partners) ? partners : [];
    const counts = totals || { partners: 0, connected: 0, intros: 0, sent: 0, received: 0 };
  %>
  <main class="max-wide px-6 py-10 md:py-16">
    <div class="referral-layout">
      <section>
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-brand-muted mb-4">Referral network</p>
        <h1 class="font-display font-extrabold text-4xl md:text-[2.7rem] leading-[1.05] tracking-tight text-brand-dark dark:text-white max-w-md">Build a referral network. Get leads that come back.</h1>
        <p class="mt-5 text-[15px] leading-relaxed text-brand-muted dark:text-slate-400 max-w-md">Cold lists run out. A referral network compounds. Search for local partners in complementary trades, connect with them — or mark the intro — and turn every relationship into a steady stream of referral leads.</p>
        <div class="mt-8 space-y-5 max-w-md">
          <div class="referral-step">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
            <div>
              <p class="font-semibold text-brand-dark dark:text-white">Search local partners</p>
              <p class="text-sm text-brand-muted dark:text-slate-400 mt-0.5">Find complementary trades in your saved leads — agents, contractors, insurers — sorted by reviews, website, and activity.</p>
            </div>
          </div>
          <div class="referral-step">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3.75h6m-8.25 6.75l2.25-2.25h9.75A2.25 2.25 0 0019.5 14.25v-7.5A2.25 2.25 0 0017.25 4.5H6.75A2.25 2.25 0 004.5 6.75v10.5z" /></svg>
            <div>
              <p class="font-semibold text-brand-dark dark:text-white">Connect or mark the intro</p>
              <p class="text-sm text-brand-muted dark:text-slate-400 mt-0.5">Reach out yourself, or record that the introduction was sent, and keep the relationship on this board.</p>
            </div>
          </div>
          <div class="referral-step">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-9L21 12m0 0l-4.5 4.5M21 12H7.5" /></svg>
            <div>
              <p class="font-semibold text-brand-dark dark:text-white">Turn connections into referral leads</p>
              <p class="text-sm text-brand-muted dark:text-slate-400 mt-0.5">Every partner becomes a referral source. Track who sends you business and return the favor from the same board.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="referral-card p-5 sm:p-6" aria-label="Find referral partners">
        <div class="flex items-start justify-between gap-3 mb-4">
          <h2 class="flex items-center gap-2 font-display font-bold text-base text-brand-dark dark:text-white">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-yellow text-brand-dark" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a8.97 8.97 0 003.74-.48 3 3 0 00-4.68-2.72m.94 3.2A11.96 11.96 0 0112 21c-2.17 0-4.21-.58-5.96-1.58A6.06 6.06 0 016 18.72m12 0a5.97 5.97 0 00-.94-3.2m0 0A6 6 0 0012 12.75a6 6 0 00-5.06 2.77m0 0a3 3 0 00-4.68 2.72 8.99 8.99 0 003.74.48" /></svg>
            </span>
            Find referral partners
          </h2>
          <% if (placeLabel) { %>
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-muted pt-1.5"><%= placeLabel %></p>
          <% } %>
        </div>

        <form method="get" action="/referrals" class="flex items-center gap-2" role="search">
          <label class="relative flex-1">
            <span class="sr-only">Search complementary trades</span>
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
            <input type="search" name="q" value="<%= query %>" placeholder="Real estate, contractors, insurance" class="w-full rounded-full border border-brand-border bg-white dark:bg-slate-900 dark:border-white/10 py-2.5 pl-9 pr-3 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted/80" />
          </label>
          <span class="shrink-0 rounded-full bg-[#F4F1EA] dark:bg-white/10 px-3 py-2 text-[11px] font-semibold text-brand-muted"><%= rows.length %> <%= query ? (rows.length === 1 ? 'match' : 'matches') : (rows.length === 1 ? 'partner' : 'partners') %></span>
        </form>
        <p class="mt-2 px-1 text-[11px] text-brand-muted">Sorted by reviews, rating &amp; website · top prospects first</p>

        <% if (notice) {
          const noticeBad = /^(Could not|That partner|Unknown)/.test(notice);
        %>
        <p class="mt-3 rounded-xl px-3 py-2 text-sm font-medium <%= noticeBad ? 'bg-amber-50 text-amber-900 dark:bg-amber-950/40 dark:text-amber-100' : 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200' %>" role="status"><%= notice %></p>
        <% } %>

        <% if (!rows.length) { %>
        <div class="mt-4 rounded-2xl border border-dashed border-brand-border dark:border-white/15 px-4 py-8 text-center">
          <% if (!savedCount) { %>
          <p class="text-sm text-brand-muted">Save local businesses first, then search them here as referral partners.</p>
          <a href="/leads/find" class="mt-3 inline-flex referral-pill referral-pill-connect">Find leads</a>
          <% } else if (query) { %>
          <p class="text-sm text-brand-muted">No saved leads match “<%= query %>”. Try another trade, or search a city.</p>
          <% } else { %>
          <p class="text-sm text-brand-muted">Search complementary trades to highlight partners. Connected and intro partners stay on this board.</p>
          <% } %>
        </div>
        <% } else { %>
        <div class="mt-3">
          <% rows.forEach(function (partner) {
            const where = [partner.category, [partner.city, partner.state].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
          %>
          <article class="referral-row flex items-center gap-3 py-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#F4F1EA] dark:bg-white/10 text-brand-muted" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 19.5a7.5 7.5 0 0115 0" /></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 min-w-0">
                <button type="button" class="truncate text-left text-sm font-semibold text-brand-dark dark:text-white hover:underline" data-referral-profile data-lead-key="<%= partner.key %>"><%= partner.title %></button>
                <% if (partner.website) { %>
                <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-sky-600 shrink-0">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-6-3.8-9s1.3-6.2 3.8-9z" /></svg>
                  site
                </span>
                <% } %>
              </div>
              <% if (where) { %><p class="truncate text-[10px] font-semibold uppercase tracking-wide text-brand-muted"><%= where %></p><% } %>
              <% if (partner.rating) { %>
              <p class="text-[11px] text-brand-muted"><span class="text-amber-500" aria-hidden="true">★</span> <%= partner.rating %><% if (partner.reviews) { %> · <%= partner.reviews %> reviews<% } %></p>
              <% } %>
              <div class="mt-0.5 flex flex-wrap items-center gap-x-2.5 gap-y-0.5">
                <% if (partner.highlighted) { %>
                <span class="text-[11px] text-brand-muted"><%= partner.sent %> sent · <%= partner.received %> received</span>
                <% } %>
                <% if (!partner.highlighted) { %>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="highlight" /><button type="submit" class="referral-mini">Highlight</button></form>
                <% } %>
                <% if (partner.status !== 'intro_sent') { %>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="intro" /><button type="submit" class="referral-mini"><%= partner.status === 'connected' ? 'Mark intro' : 'Intro' %></button></form>
                <% } %>
                <% if (partner.status === 'intro_sent') { %>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="connect" /><button type="submit" class="referral-mini">Mark connected</button></form>
                <% } %>
                <% if (partner.highlighted) { %>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="sent" /><button type="submit" class="referral-mini">+ Sent</button></form>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="received" /><button type="submit" class="referral-mini">+ Received</button></form>
                <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="clear" /><button type="submit" class="referral-mini">Remove</button></form>
                <% } %>
              </div>
            </div>
            <div class="shrink-0">
              <% if (partner.status === 'connected') { %>
              <span class="referral-pill referral-pill-connected">Connected</span>
              <% } else if (partner.status === 'intro_sent') { %>
              <span class="referral-pill referral-pill-intro">Intro sent</span>
              <% } else { %>
              <form method="post" action="/referrals/partner">
                <input type="hidden" name="leadKey" value="<%= partner.key %>" />
                <input type="hidden" name="q" value="<%= query %>" />
                <input type="hidden" name="action" value="connect" />
                <button type="submit" class="referral-pill referral-pill-connect">Connect →</button>
              </form>
              <% } %>
            </div>
          </article>
          <% }); %>
        </div>
        <% } %>

        <div class="mt-3 flex items-start gap-2 rounded-2xl bg-[#F7F4EE] dark:bg-white/5 px-3.5 py-3 text-xs leading-relaxed text-brand-muted">
          <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-9L21 12m0 0l-4.5 4.5M21 12H7.5" /></svg>
          <p>Every partner stays with the lead in your CRM. Track referrals sent and received, and watch the network grow.<% if (counts.partners) { %> <span class="text-brand-dark dark:text-slate-200 font-semibold"><%= counts.partners %> highlighted · <%= counts.connected %> connected · <%= counts.intros %> intros · <%= counts.sent %> sent · <%= counts.received %> received.</span><% } %></p>
        </div>
      </section>
    </div>
  </main>
  <%- include('partials/opportunity_company_panel') %>
  <script>
    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-referral-profile]');
      if (!btn) return;
      var key = btn.getAttribute('data-lead-key');
      if (key && typeof window.openLeadDetailFromKey === 'function') window.openLeadDetailFromKey(key);
    });
  </script>
  <%- include('partials/footer') %>
</body>
</html>
