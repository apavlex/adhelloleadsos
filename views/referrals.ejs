<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .ref-stat { border: 1px solid rgba(15, 23, 42, 0.08); background: rgba(255, 255, 255, 0.86); border-radius: 1.15rem; padding: 0.9rem 1rem; }
    html.dark .ref-stat { background: rgba(15, 23, 42, 0.72); border-color: rgba(255, 255, 255, 0.08); }
    .ref-card { border: 1px solid rgba(15, 23, 42, 0.08); background: #fff; border-radius: 1.35rem; padding: 1rem 1.05rem 0.95rem; }
    html.dark .ref-card { background: rgba(15, 23, 42, 0.78); border-color: rgba(255, 255, 255, 0.08); }
    .ref-fact { min-width: 0; }
    .ref-fact p { margin: 0; }
    .ref-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0.42rem 0.8rem; font-size: 0.72rem; font-weight: 700; line-height: 1; white-space: nowrap; border: 1px solid transparent; cursor: pointer; }
    .ref-btn:disabled { opacity: 0.6; cursor: wait; }
    .ref-btn-yellow { background: #FFDB3A; color: #0F172A; }
    .ref-btn-yellow:hover { filter: brightness(0.97); }
    .ref-btn-ghost { background: transparent; border-color: rgba(15, 23, 42, 0.12); color: inherit; }
    html.dark .ref-btn-ghost { border-color: rgba(255, 255, 255, 0.14); }
    .ref-btn-ghost:hover { border-color: #FFDB3A; }
    .ref-btn-quiet { background: transparent; color: #94a3b8; border: 0; padding-left: 0.35rem; padding-right: 0.35rem; }
    .ref-btn-quiet:hover { color: #e11d48; }
    .ref-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.28rem 0.65rem; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
    .ref-pill-connected { background: rgba(16, 185, 129, 0.14); color: #047857; }
    html.dark .ref-pill-connected { color: #6ee7b7; }
    .ref-pill-intro { background: rgba(245, 158, 11, 0.16); color: #b45309; }
    html.dark .ref-pill-intro { color: #fcd34d; }
    .ref-note { width: 100%; border-radius: 0.85rem; border: 1px solid rgba(15, 23, 42, 0.1); background: rgba(247, 244, 238, 0.7); padding: 0.55rem 0.75rem; font-size: 0.8rem; }
    html.dark .ref-note { background: rgba(2, 6, 23, 0.35); border-color: rgba(255, 255, 255, 0.1); color: #f8fafc; }
    .ref-pop { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-start; justify-content: center; padding: 4.5rem 1rem 1rem; background: rgba(2, 6, 23, 0.72); }
    .ref-pop[hidden] { display: none !important; }
    .ref-pop-card { width: 100%; max-width: 32rem; max-height: min(82vh, 42rem); overflow: auto; border-radius: 1.5rem; background: #fff; color: #0f172a; border: 1px solid rgba(15, 23, 42, 0.08); padding: 1.25rem; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28); }
    html.dark .ref-pop-card { background: #0f172a; color: #f8fafc; border-color: rgba(255, 255, 255, 0.1); }
    .ref-pop-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0; }
    .ref-pop-kicker { display: block; margin: 0.9rem 0 0.35rem; font-size: 10px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: #64748b; }
    .ref-pop-card select, .ref-pop-card textarea, .ref-pop-card input[type="text"] { width: 100%; border-radius: 0.9rem; border: 1px solid rgba(148, 163, 184, 0.35); background: rgba(248, 250, 252, 0.8); padding: 0.65rem 0.8rem; font-size: 0.875rem; color: inherit; }
    html.dark .ref-pop-card select, html.dark .ref-pop-card textarea, html.dark .ref-pop-card input[type="text"] { background: rgba(15, 23, 42, 0.8); border-color: rgba(255, 255, 255, 0.1); }
    .ref-pop-card textarea { min-height: 9rem; resize: vertical; }
    .ref-pop-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.75rem; }
    .ref-pop-tag { border-radius: 999px; border: 1px solid rgba(15, 23, 42, 0.14); padding: 0.35rem 0.75rem; font-size: 12px; font-weight: 700; background: transparent; color: inherit; cursor: pointer; }
    html.dark .ref-pop-tag { border-color: rgba(255, 255, 255, 0.16); }
    .ref-pop-tag.is-on { background: #FFDB3A; color: #0f172a; border-color: transparent; }
    .ref-pop-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
    .ref-pop-close { margin-left: auto; }
  </style>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <%
    const placeLabel = (typeof workspace !== 'undefined' && workspace && workspace.name)
      ? String(workspace.name).trim()
      : '';
    const rows = Array.isArray(partners) ? partners : [];
    const counts = totals || { partners: 0, connected: 0, intros: 0, sent: 0, received: 0 };
    const noticeBad = notice && /^(Could not|That partner|Unknown|Write a note)/.test(notice);
  %>
  <main class="max-wide px-6 py-8 md:py-12">
    <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-brand-muted mb-2">Referral partners</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Partners you trade leads with</h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-muted dark:text-slate-400">Track each partner you work with. Log leads you send them and leads they send you, record when you last connected, add notes on the lead, and keep the partner in Go High Level.</p>
      </div>
      <% if (placeLabel) { %>
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-muted"><%= placeLabel %></p>
      <% } %>
    </header>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
      <div class="ref-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Partners</p>
        <p class="font-display font-black text-2xl"><%= counts.partners %></p>
      </div>
      <div class="ref-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Connected</p>
        <p class="font-display font-black text-2xl"><%= counts.connected %></p>
      </div>
      <div class="ref-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Leads sent</p>
        <p class="font-display font-black text-2xl"><%= counts.sent %></p>
      </div>
      <div class="ref-stat">
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Leads received</p>
        <p class="font-display font-black text-2xl"><%= counts.received %></p>
      </div>
    </div>

    <form method="get" action="/referrals" class="mb-4 flex items-center gap-2" role="search">
      <label class="relative flex-1">
        <span class="sr-only">Find a saved business to add</span>
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
        <input type="search" name="q" value="<%= query %>" placeholder="Add a partner — search saved businesses" class="w-full rounded-full border border-brand-border bg-white dark:bg-slate-900 dark:border-white/10 py-2.5 pl-9 pr-3 text-sm text-brand-dark dark:text-white placeholder:text-brand-muted/80" />
      </label>
      <button type="submit" class="ref-btn ref-btn-ghost">Search</button>
    </form>

    <% if (notice) { %>
    <p id="referralStatus" class="mb-4 rounded-xl px-3 py-2 text-sm font-medium <%= noticeBad ? 'bg-amber-50 text-amber-950 dark:bg-amber-950/50 dark:text-amber-100' : 'bg-emerald-50 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100' %>" role="status"><%= notice %></p>
    <% } else { %>
    <p id="referralStatus" class="mb-4 hidden rounded-xl px-3 py-2 text-sm font-medium" role="status"></p>
    <% } %>

    <% if (!rows.length) { %>
    <div class="ref-card text-center py-10">
      <% if (!savedCount) { %>
      <p class="text-sm text-brand-muted">Save businesses first, then add the ones you trade leads with.</p>
      <a href="/leads/find" class="ref-btn ref-btn-yellow mt-4">Find leads</a>
      <% } else if (query) { %>
      <p class="text-sm text-brand-muted">No saved businesses match “<%= query %>”.</p>
      <% } else { %>
      <p class="text-sm text-brand-muted max-w-md mx-auto">No referral partners yet. Select a lead and click Referral, or search a saved business above and add it here.</p>
      <% } %>
    </div>
    <% } else { %>
    <div class="space-y-3">
      <% rows.forEach(function (partner) {
        const where = [partner.category, [partner.city, partner.state].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
      %>
      <article class="ref-card">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <button type="button" class="truncate text-left text-base font-semibold hover:underline" data-referral-profile data-lead-key="<%= partner.key %>"><%= partner.title %></button>
            <% if (where) { %><p class="truncate text-[11px] font-semibold uppercase tracking-wide text-brand-muted"><%= where %></p><% } %>
            <p class="mt-0.5 text-[12px] text-brand-muted">
              <% if (partner.rating) { %><span class="text-amber-500" aria-hidden="true">★</span> <%= partner.rating %><% if (partner.reviews) { %> · <%= partner.reviews %> review<%= partner.reviews === 1 ? '' : 's' %><% } %><% } %>
              <% if (partner.phone) { %><% if (partner.rating) { %> · <% } %><%= partner.phone %><% } %>
            </p>
          </div>
          <div class="shrink-0">
            <% if (partner.status === 'connected') { %>
            <span class="ref-pill ref-pill-connected">Connected</span>
            <% } else if (partner.status === 'intro_sent') { %>
            <span class="ref-pill ref-pill-intro">Intro sent</span>
            <% } else if (partner.highlighted) { %>
            <span class="ref-pill" style="background: rgba(148,163,184,0.16); color: #64748b;">Not connected</span>
            <% } %>
          </div>
        </div>

        <% if (!partner.highlighted) { %>
        <form method="post" action="/referrals/partner" class="mt-3">
          <input type="hidden" name="leadKey" value="<%= partner.key %>" />
          <input type="hidden" name="q" value="<%= query %>" />
          <input type="hidden" name="action" value="highlight" />
          <button type="submit" class="ref-btn ref-btn-yellow">Add as partner</button>
        </form>
        <% } else { %>
        <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-3">
          <div class="ref-fact">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Last connected</p>
            <p class="mt-1 text-sm font-semibold"><%= partner.connectedWhen || 'Not yet' %></p>
          </div>
          <div class="ref-fact">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Last intro</p>
            <p class="mt-1 text-sm font-semibold"><%= partner.introWhen || 'Not yet' %></p>
          </div>
          <div class="ref-fact">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Last lead sent</p>
            <p class="mt-1 text-sm font-semibold"><%= partner.sent %> sent<% if (partner.sentWhen) { %> · <%= partner.sentWhen %><% } %></p>
          </div>
          <div class="ref-fact">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Last lead received</p>
            <p class="mt-1 text-sm font-semibold"><%= partner.received %> received<% if (partner.receivedWhen) { %> · <%= partner.receivedWhen %><% } %></p>
          </div>
        </div>

        <% if (partner.note) { %>
        <p class="mt-3 text-sm text-brand-dark dark:text-slate-200"><span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Latest note · </span><%= partner.note %></p>
        <% } %>

        <% if (partner.activity && partner.activity.length) { %>
        <ul class="mt-3 space-y-1">
          <% partner.activity.forEach(function (item) { %>
          <li class="text-[12px] text-brand-muted"><span class="font-semibold text-brand-dark dark:text-slate-200"><%= item.label %></span><% if (item.when) { %> · <%= item.when %><% } %><% if (item.text && item.label === 'Note') { %> — <%= item.text %><% } %></li>
          <% }); %>
        </ul>
        <% } %>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button type="button" class="ref-btn ref-btn-ghost" data-referral-action="tags" data-lead-key="<%= partner.key %>" data-title="<%= partner.title %>" data-tags="<%= (partner.tagKeys || []).join(',') %>">Tags</button>
          <button type="button" class="ref-btn ref-btn-ghost" data-referral-action="sms" data-lead-key="<%= partner.key %>" data-title="<%= partner.title %>">SMS</button>
          <button type="button" class="ref-btn ref-btn-ghost" data-referral-action="email" data-lead-key="<%= partner.key %>" data-title="<%= partner.title %>">Email</button>
          <button type="button" class="ref-btn ref-btn-ghost" data-referral-action="dm" data-lead-key="<%= partner.key %>" data-title="<%= partner.title %>" data-instagram="<%= partner.instagram %>" data-facebook="<%= partner.facebook %>">DM</button>
          <button type="button" class="ref-btn ref-btn-ghost" data-referral-ghl data-lead-key="<%= partner.key %>" data-default-label="<%= partner.ghlWhen ? 'Sync GHL' : 'Connect GHL' %>"><%= partner.ghlWhen ? 'Sync GHL' : 'Connect GHL' %></button>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="sent" /><button type="submit" class="ref-btn ref-btn-yellow">Log lead sent</button></form>
          <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="received" /><button type="submit" class="ref-btn ref-btn-ghost">Log lead received</button></form>
          <% if (partner.status !== 'connected') { %>
          <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="connect" /><button type="submit" class="ref-btn ref-btn-ghost">Mark connected</button></form>
          <% } %>
          <% if (partner.status !== 'intro_sent') { %>
          <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="intro" /><button type="submit" class="ref-btn ref-btn-ghost">Mark intro sent</button></form>
          <% } %>
          <% if (partner.ghlWhen) { %><span class="text-[11px] text-brand-muted">In GHL · <%= partner.ghlWhen %></span><% } %>
          <form method="post" action="/referrals/partner"><input type="hidden" name="leadKey" value="<%= partner.key %>" /><input type="hidden" name="q" value="<%= query %>" /><input type="hidden" name="action" value="clear" /><button type="submit" class="ref-btn ref-btn-quiet">Remove</button></form>
        </div>

        <form method="post" action="/referrals/partner" class="mt-3 flex flex-col sm:flex-row gap-2">
          <input type="hidden" name="leadKey" value="<%= partner.key %>" />
          <input type="hidden" name="q" value="<%= query %>" />
          <input type="hidden" name="action" value="note" />
          <input type="text" name="note" maxlength="500" placeholder="Add a note on this lead" class="ref-note" />
          <button type="submit" class="ref-btn ref-btn-ghost shrink-0">Save note</button>
        </form>
        <% } %>
      </article>
      <% }); %>
    </div>
    <% } %>
  </main>
  <%- include('partials/opportunity_company_panel') %>
  <div id="referralContactPop" class="ref-pop" hidden>
    <div class="ref-pop-card" role="dialog" aria-modal="true" aria-labelledby="referralPopTitle">
      <div class="flex items-start justify-between gap-3">
        <h3 id="referralPopTitle">Contact</h3>
        <button type="button" class="ref-btn ref-btn-quiet ref-pop-close" data-referral-pop-close>Close</button>
      </div>
      <div id="referralPopBody"></div>
    </div>
  </div>
  <script>
    (function () {
      var pop = document.getElementById('referralContactPop');
      var popBody = document.getElementById('referralPopBody');
      var popTitle = document.getElementById('referralPopTitle');
      var status = document.getElementById('referralStatus');
      var searchQuery = <%- JSON.stringify(query || '') %>;

      function say(text, ok) {
        if (!status) return;
        status.textContent = text;
        status.classList.remove('hidden', 'bg-amber-50', 'text-amber-950', 'dark:bg-amber-950/50', 'dark:text-amber-100', 'bg-emerald-50', 'text-emerald-900', 'dark:bg-emerald-950/40', 'dark:text-emerald-100');
        if (ok) status.classList.add('bg-emerald-50', 'text-emerald-900', 'dark:bg-emerald-950/40', 'dark:text-emerald-100');
        else status.classList.add('bg-amber-50', 'text-amber-950', 'dark:bg-amber-950/50', 'dark:text-amber-100');
      }

      function closePop() {
        if (!pop) return;
        pop.hidden = true;
        if (popBody) popBody.textContent = '';
      }

      function openPop(title) {
        if (popTitle) popTitle.textContent = title;
        if (popBody) popBody.textContent = '';
        if (pop) pop.hidden = false;
      }

      function postJson(url, payload) {
        return fetch(url, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        }).then(function (res) {
          return res.json().then(function (data) { return { ok: res.ok, data: data || {} }; }).catch(function () { return { ok: false, data: {} }; });
        });
      }

      function plainText(value) {
        return String(value || '')
          .replace(/<style[\s\S]*?<\/style>/gi, ' ')
          .replace(/<[^>]+>/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function socialHref(raw, host) {
        var value = String(raw || '').trim();
        if (!value || /^n\/?a$/i.test(value)) return '';
        if (/^https?:\/\//i.test(value)) return value;
        if (value.indexOf(host) !== -1) return 'https://' + value.replace(/^\/\//, '');
        return 'https://' + host + '/' + value.replace(/^@/, '');
      }

      function openComposer(kind, key) {
        var opener = kind === 'email'
          ? (window.__openBulkEmailModal || window.__openBulkEmailModalImplFull)
          : (window.__openBulkSmsModalImpl || window.__openBulkSmsModal || window.__openBulkSmsModalImplFull);
        if (typeof opener !== 'function') {
          say(kind === 'email' ? 'Email templates are still loading. Try again.' : 'SMS templates are still loading. Try again.', false);
          return;
        }
        say(kind === 'email' ? 'Opening email templates…' : 'Opening SMS templates…', true);
        Promise.resolve(opener([key])).then(function (result) {
          if (result && result.ok === false) say(result.message || 'Could not open that composer.', false);
        }).catch(function () {
          say('Could not open that composer.', false);
        });
      }

      function openTags(button) {
        var key = button.getAttribute('data-lead-key');
        var applied = String(button.getAttribute('data-tags') || '').split(',').map(function (item) { return item.trim(); }).filter(Boolean);
        openPop('Tags · ' + (button.getAttribute('data-title') || 'Partner'));
        popBody.innerHTML = '<div class="ref-pop-tags">Loading tags…</div><form class="ref-pop-actions"><input type="text" name="name" maxlength="40" placeholder="New tag" /><button type="submit" class="ref-btn ref-btn-yellow">Add</button></form>';
        var list = popBody.querySelector('.ref-pop-tags');
        function paint(tags) {
          list.textContent = '';
          if (!tags.length) {
            list.textContent = 'No tags yet. Create one below.';
            return;
          }
          tags.forEach(function (tag) {
            if (!tag || !tag.key) return;
            var on = applied.indexOf(tag.key) >= 0;
            var chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'ref-pop-tag' + (on ? ' is-on' : '');
            chip.textContent = (on ? '' : '+ ') + (tag.name || 'Tag');
            chip.addEventListener('click', function () {
              chip.disabled = true;
              postJson('/tags/assign', { leadKey: key, tagKeys: [tag.key], mode: on ? 'remove' : 'add' }).then(function (result) {
                chip.disabled = false;
                if (!result.ok || !result.data || !result.data.success) {
                  say((result.data && result.data.error) || 'Could not update that tag.', false);
                  return;
                }
                applied = on ? applied.filter(function (item) { return item !== tag.key; }) : applied.concat([tag.key]);
                button.setAttribute('data-tags', applied.join(','));
                say(on ? 'Tag removed.' : 'Tag added.', true);
                paint(tags);
              }).catch(function () {
                chip.disabled = false;
                say('Could not update that tag.', false);
              });
            });
            list.appendChild(chip);
          });
        }
        fetch('/tags', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) { paint((data && data.tags) || []); })
          .catch(function () { list.textContent = 'Could not load tags.'; });
        popBody.querySelector('form').addEventListener('submit', function (event) {
          event.preventDefault();
          var input = popBody.querySelector('input');
          var name = String(input.value || '').trim();
          if (!name) return;
          input.disabled = true;
          postJson('/tags', { name: name }).then(function (created) {
            if (!created.ok || !created.data || !created.data.tag) {
              input.disabled = false;
              say((created.data && created.data.error) || 'Could not create that tag.', false);
              return;
            }
            return postJson('/tags/assign', { leadKey: key, tagKeys: [created.data.tag.key], mode: 'add' }).then(function (assigned) {
              input.disabled = false;
              input.value = '';
              if (!assigned.ok || !assigned.data || !assigned.data.success) {
                say((assigned.data && assigned.data.error) || 'Tag created, but it was not added.', false);
                return;
              }
              applied.push(created.data.tag.key);
              button.setAttribute('data-tags', applied.join(','));
              say('Tag added.', true);
              return fetch('/tags', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) { paint((data && data.tags) || []); });
            });
          }).catch(function () {
            input.disabled = false;
            say('Could not create that tag.', false);
          });
        });
      }

      function openDm(button) {
        var key = button.getAttribute('data-lead-key');
        var title = button.getAttribute('data-title') || 'this partner';
        var ig = socialHref(button.getAttribute('data-instagram'), 'instagram.com');
        var fb = socialHref(button.getAttribute('data-facebook'), 'facebook.com');
        openPop('DM · ' + title);
        popBody.innerHTML = '<p class="ref-pop-kicker">Template</p><select><option>Loading templates…</option></select><p class="ref-pop-kicker">Message</p><textarea maxlength="1000"></textarea><div class="ref-pop-actions"><button type="button" class="ref-btn ref-btn-yellow" data-dm-copy>Copy message</button></div>';
        var select = popBody.querySelector('select');
        var area = popBody.querySelector('textarea');
        var actions = popBody.querySelector('.ref-pop-actions');
        if (ig) {
          var igLink = document.createElement('a');
          igLink.className = 'ref-btn ref-btn-ghost';
          igLink.href = ig;
          igLink.target = '_blank';
          igLink.rel = 'noopener noreferrer';
          igLink.textContent = 'Open Instagram';
          actions.appendChild(igLink);
        }
        if (fb) {
          var fbLink = document.createElement('a');
          fbLink.className = 'ref-btn ref-btn-ghost';
          fbLink.href = fb;
          fbLink.target = '_blank';
          fbLink.rel = 'noopener noreferrer';
          fbLink.textContent = 'Open Facebook';
          actions.appendChild(fbLink);
        }
        var templates = [{ label: 'Referral intro', text: 'Hi — I work with businesses nearby and wanted to connect about trading referrals. Open to a quick chat?' }];
        function paintTemplates() {
          select.textContent = '';
          templates.forEach(function (item, index) {
            var option = document.createElement('option');
            option.value = String(index);
            option.textContent = item.label;
            select.appendChild(option);
          });
          area.value = templates[0] ? templates[0].text : '';
        }
        select.addEventListener('change', function () {
          var picked = templates[Number(select.value)] || templates[0];
          if (picked) area.value = picked.text;
        });
        actions.querySelector('[data-dm-copy]').addEventListener('click', function () {
          var text = String(area.value || '').trim();
          if (!text) {
            say('Write a message first.', false);
            return;
          }
          var done = function () { say('DM copied. Paste it in the message.', true); };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(function () {
              area.select();
              document.execCommand('copy');
              done();
            });
          } else {
            area.select();
            document.execCommand('copy');
            done();
          }
        });
        fetch('/leads/' + encodeURIComponent(key) + '/outreach-scripts', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            var library = data && data.library ? data.library : {};
            var fromLibrary = [];
            Object.keys(library).forEach(function (id) {
              var entry = library[id] || {};
              var channels = entry.channels || {};
              var text = plainText(channels.text || channels.call || '');
              if (!text) return;
              fromLibrary.push({ label: (entry.label || id) + ' — DM', text: text.slice(0, 1000) });
            });
            if (fromLibrary.length) templates = fromLibrary.concat(templates);
            paintTemplates();
          })
          .catch(function () { paintTemplates(); });
      }

      function syncGhl(button) {
        if (!button || button.disabled) return;
        var leadKey = button.getAttribute('data-lead-key');
        var label = button.getAttribute('data-default-label') || 'Connect GHL';
        button.disabled = true;
        button.textContent = 'Syncing…';
        postJson('/ghl/push', { leadKeys: [leadKey], extraTagNames: ['Referral partner'] }).then(function (result) {
          if (!result.ok || !result.data || !result.data.success) {
            button.disabled = false;
            button.textContent = label;
            say((result.data && result.data.error) || 'Could not sync that partner to Go High Level.', false);
            return;
          }
          var body = new URLSearchParams();
          body.set('leadKey', leadKey);
          body.set('action', 'ghl');
          body.set('q', searchQuery);
          return fetch('/referrals/partner', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
          }).then(function () {
            var next = '/referrals?notice=' + encodeURIComponent('Synced to Go High Level.');
            if (searchQuery) next += '&q=' + encodeURIComponent(searchQuery);
            window.location.href = next;
          });
        }).catch(function () {
          button.disabled = false;
          button.textContent = label;
          say('Could not sync that partner to Go High Level.', false);
        });
      }

      document.addEventListener('click', function (event) {
        if (event.target.closest('[data-referral-pop-close]') || event.target === pop) {
          closePop();
          return;
        }
        var profile = event.target.closest('[data-referral-profile]');
        if (profile) {
          var profileKey = profile.getAttribute('data-lead-key');
          if (profileKey && typeof window.openLeadDetailFromKey === 'function') window.openLeadDetailFromKey(profileKey);
          return;
        }
        var action = event.target.closest('[data-referral-action]');
        if (action) {
          var kind = action.getAttribute('data-referral-action');
          var leadKey = action.getAttribute('data-lead-key');
          if (!leadKey) return;
          if (kind === 'tags') openTags(action);
          else if (kind === 'sms') openComposer('sms', leadKey);
          else if (kind === 'email') openComposer('email', leadKey);
          else if (kind === 'dm') openDm(action);
          return;
        }
        var ghl = event.target.closest('[data-referral-ghl]');
        if (ghl) syncGhl(ghl);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closePop();
      });
    })();
  </script>
  <%- include('partials/footer') %>
</body>
</html>
