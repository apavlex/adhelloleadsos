<% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && typeof onboardingEditor !== 'undefined' && onboardingEditor) { %>
<% const _ob = onboardingEditor; %>
<% const _cfg = _ob.config; %>
<% const _tzLabel = typeof workspaceTimezone !== 'undefined' ? workspaceTimezone : 'America/Los_Angeles'; %>
<% const _input = 'w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-brand-dark dark:text-white'; %>
<% const _label = 'text-[10px] font-black uppercase tracking-widest text-brand-muted block mb-1'; %>
<% const _card = 'rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 md:p-8'; %>
<% function _hourLabel(h) { const s = h % 12 === 0 ? 12 : h % 12; return s + ':00 ' + (h < 12 ? 'AM' : 'PM'); } %>

<div id="onboardingEditor" class="space-y-6">
  <% if (!_ob.emailReady) { %>
  <div class="rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">
    <strong>GHL email isn&apos;t connected for this workspace yet.</strong> Emails send from this workspace&apos;s GHL sub-account. Add the GHL API key, location ID, and an <em>Email from</em> address in
    <a href="/workspace/integrations" class="font-bold underline">Integrations</a>. Until then, invites still create a link you can copy.
  </div>
  <% } else { %>
  <div class="rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-3 text-sm text-emerald-900 dark:text-emerald-100">
    GHL email is connected. New teammates are added to this workspace&apos;s GHL as contacts tagged <strong>agency os teammate</strong> so the emails can be delivered.
  </div>
  <% } %>

  <section class="<%= _card %> space-y-5">
    <div>
      <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">How it works</h2>
      <p class="text-sm text-brand-muted max-w-3xl">When you invite someone, they get the invite email. After they accept, Day 1 arrives right away and each following day arrives at the time below. The steps you edit here are also the activation checklist they see on Today.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <label class="inline-flex items-center gap-2 text-sm font-semibold cursor-pointer">
        <input type="checkbox" id="obEnabled" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow" <%= _cfg.enabled ? 'checked' : '' %> />
        Send onboarding emails to new teammates
      </label>
      <label class="inline-flex items-center gap-2 text-sm font-semibold cursor-pointer">
        <input type="checkbox" id="obSendInvite" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow" <%= _cfg.sendInviteEmail ? 'checked' : '' %> />
        Email the invite link when I invite someone
      </label>
      <label class="inline-flex items-center gap-2 text-sm font-semibold cursor-pointer">
        <input type="checkbox" id="obSkipCompleted" class="rounded border-brand-border text-brand-yellow focus:ring-brand-yellow" <%= _cfg.skipCompleted ? 'checked' : '' %> />
        Skip a day&apos;s email if they already did that step
      </label>
      <label class="flex items-center gap-3 text-sm font-semibold">
        <span>Daily email time</span>
        <select id="obSendHour" class="rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-1.5 text-sm">
          <% for (let h = 0; h < 24; h++) { %>
          <option value="<%= h %>" <%= _cfg.sendHour === h ? 'selected' : '' %>><%= _hourLabel(h) %></option>
          <% } %>
        </select>
        <span class="text-xs text-brand-muted font-normal"><%= _tzLabel %> · <a href="/workspace/revenue" class="underline">change timezone</a></span>
      </label>
    </div>
  </section>

  <section class="<%= _card %> space-y-4" data-ob-email="invite">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">Sent when invited</p>
        <h2 class="font-bold text-lg text-brand-dark dark:text-white">Invite email</h2>
      </div>
    </div>
    <label class="block">
      <span class="<%= _label %>">Subject</span>
      <input type="text" data-ob-field="subject" value="<%= _cfg.invite.subject %>" class="<%= _input %>" />
    </label>
    <label class="block">
      <span class="<%= _label %>">Email body</span>
      <textarea data-ob-field="body" rows="9" class="<%= _input %> font-mono text-[13px] leading-relaxed"><%= _cfg.invite.body %></textarea>
    </label>
    <div class="ob-ai-row flex flex-col sm:flex-row gap-2">
      <input type="text" data-ob-field="instruction" placeholder="Optional: tell AI how to rewrite it (e.g. shorter, mention our showroom)" class="<%= _input %> flex-1" />
      <button type="button" data-ob-action="rewrite" class="btn-pill border border-violet-400/60 bg-violet-50 dark:bg-violet-900/30 text-violet-800 dark:text-violet-200 px-4 py-2 text-[10px] font-black uppercase tracking-widest shrink-0">Rewrite with AI</button>
      <button type="button" data-ob-action="test" class="btn-pill border border-brand-border dark:border-white/15 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white shrink-0">Send test to me</button>
    </div>
    <p class="ob-status hidden text-xs" role="status"></p>
  </section>

  <section class="<%= _card %> space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow">One email per day after they join</p>
        <h2 class="font-bold text-lg text-brand-dark dark:text-white">Daily activation steps <span id="obStepCount" class="text-brand-muted font-normal text-sm"></span></h2>
        <p class="text-sm text-brand-muted mt-1 max-w-3xl">Each step is a checklist item and that day&apos;s email. Pick what auto-checks it, or leave it manual.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="obAddStep" class="btn-pill border border-brand-border dark:border-white/15 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">+ Add day</button>
        <button type="button" id="obResetSteps" class="btn-pill border border-brand-border dark:border-white/15 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-muted">Reset to defaults</button>
      </div>
    </div>
    <div class="rounded-2xl border border-violet-300/50 dark:border-violet-700/50 bg-violet-50/60 dark:bg-violet-950/20 p-4 space-y-2">
      <p class="text-xs font-bold text-violet-900 dark:text-violet-200">Generate a whole plan with AI, tailored to this workspace&apos;s business</p>
      <div class="flex flex-col sm:flex-row gap-2">
        <input type="text" id="obPlanInstruction" placeholder="e.g. Flooring showroom sales reps — focus on booking in-home measures and following up on quotes" class="<%= _input %> flex-1" />
        <select id="obPlanDays" class="rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm">
          <% [5, 7, 10, 14].forEach(function (n) { %><option value="<%= n %>" <%= n === 7 ? 'selected' : '' %>><%= n %> days</option><% }) %>
        </select>
        <button type="button" id="obGeneratePlan" class="btn-pill bg-violet-600 hover:bg-violet-700 text-white px-4 py-2 text-[10px] font-black uppercase tracking-widest shrink-0">Generate plan</button>
      </div>
      <p id="obPlanStatus" class="hidden text-xs" role="status"></p>
    </div>
    <ol id="obSteps" class="space-y-3"></ol>
  </section>

  <details class="<%= _card %>">
    <summary class="cursor-pointer text-sm font-bold text-brand-dark dark:text-white">Merge tags you can use in subjects and bodies</summary>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 text-xs">
      <% _ob.placeholders.forEach(function (p) { %>
      <li><code class="px-1.5 py-0.5 rounded bg-brand-cream dark:bg-slate-800">{{<%= p.key %>}}</code> <span class="text-brand-muted"><%= p.label %></span></li>
      <% }) %>
    </ul>
  </details>

  <div class="sticky bottom-4 z-10 flex flex-wrap items-center gap-3 rounded-2xl border border-brand-border dark:border-white/10 bg-white/95 dark:bg-slate-900/95 backdrop-blur px-5 py-3 shadow-lg">
    <button type="button" id="obSave" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save onboarding</button>
    <p id="obSaveMsg" class="text-sm text-brand-muted" role="status">Changes apply to future emails, including teammates already in progress.</p>
  </div>

  <section class="<%= _card %> space-y-4">
    <div>
      <h2 class="font-bold text-lg text-brand-dark dark:text-white">Teammates</h2>
      <p class="text-sm text-brand-muted">New members start automatically when they accept. Start existing members by hand.</p>
    </div>
    <% if (!_ob.members.length) { %>
    <p class="text-sm text-brand-muted">No members yet.</p>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-[10px] font-black uppercase tracking-widest text-brand-muted border-b border-brand-border/40 dark:border-white/10">
            <th class="py-2 pr-3">Member</th>
            <th class="py-2 px-3">Joined</th>
            <th class="py-2 px-3">Progress</th>
            <th class="py-2 px-3">Last email</th>
            <th class="py-2 pl-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% _ob.members.forEach(function (m) { %>
          <% const _statusText = m.status === 'active' ? ('Day ' + Math.min(m.nextIndex + 1, m.total) + ' of ' + m.total + ' next') : m.status === 'done' ? 'Finished' : m.status === 'stopped' ? 'Stopped' : 'Not started'; %>
          <tr class="border-b border-brand-border/30 dark:border-white/5 align-top" data-ob-member="<%= m.email %>">
            <td class="py-3 pr-3">
              <div class="font-semibold text-brand-dark dark:text-white"><%= m.name || m.email %></div>
              <% if (m.name) { %><div class="text-xs text-brand-muted"><%= m.email %></div><% } %>
              <div class="text-[10px] uppercase tracking-widest text-brand-muted mt-0.5"><%= m.role %></div>
            </td>
            <td class="py-3 px-3 text-xs text-brand-muted whitespace-nowrap"><%= m.joinedAt ? wsDate(m.joinedAt, { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %></td>
            <td class="py-3 px-3 text-xs">
              <div class="font-semibold"><%= _statusText %></div>
              <div class="text-brand-muted"><%= m.sentCount %> sent<% if (m.status === 'active' && m.nextDueAt) { %> · next <%= wsDateTime(m.nextDueAt, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %><% } %></div>
              <% if (m.lastError) { %><div class="text-rose-600 dark:text-rose-400 mt-1 max-w-xs"><%= m.lastError %></div><% } %>
            </td>
            <td class="py-3 px-3 text-xs text-brand-muted whitespace-nowrap"><%= m.lastSentAt ? wsDateTime(m.lastSentAt, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—' %></td>
            <td class="py-3 pl-3 text-right whitespace-nowrap">
              <% if (m.status === 'active') { %>
              <button type="button" data-ob-member-action="stop" class="text-[10px] font-black uppercase tracking-widest text-rose-600 hover:underline">Stop</button>
              <% } else { %>
              <button type="button" data-ob-member-action="<%= m.status === 'not_started' ? 'start' : 'restart' %>" class="text-[10px] font-black uppercase tracking-widest text-brand-yellow hover:underline"><%= m.status === 'not_started' ? 'Start' : 'Restart' %></button>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</div>
<script type="application/json" id="onboardingEditorData"><%- safeJsonForScript({ config: _cfg, defaults: _ob.defaults, events: _ob.events, links: _ob.links, maxSteps: _ob.maxSteps }) %></script>
<script src="/js/onboarding-settings.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
<% } else { %>
<p class="text-sm text-brand-muted">Only workspace admins can edit teammate onboarding.</p>
<% } %>
