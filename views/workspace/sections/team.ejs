<% const _pendingInvites = (workspace && Array.isArray(workspace.pendingInvites)) ? workspace.pendingInvites.filter(function (x) { return x && !x.acceptedAt; }) : []; %>
<% const _memberEntries = (workspace && workspace.members) ? Object.entries(workspace.members) : []; %>
<% const _memberCount = _memberEntries.length; %>
<% const _pendingCount = _pendingInvites.length; %>
<% const _inviteStatus = typeof inviteStatus !== 'undefined' ? String(inviteStatus) : ''; %>
<% const _inviteEmail = typeof inviteEmail !== 'undefined' ? String(inviteEmail) : ''; %>
<% const _inviteLink = typeof inviteLink !== 'undefined' ? String(inviteLink) : ''; %>
<% const _wsId = workspace && workspace.id ? String(workspace.id) : ''; %>
<% const _wsName = workspace && workspace.name ? String(workspace.name) : ''; %>
<% const _inviteEmailed = typeof inviteEmailed !== 'undefined' && inviteEmailed; %>
<% const _inviteEmailError = typeof inviteEmailError !== 'undefined' ? String(inviteEmailError) : ''; %>
<% const _obCfg = workspace && workspace.onboarding ? workspace.onboarding : {}; %>
<% const _obInviteOn = _obCfg.enabled !== false && _obCfg.sendInviteEmail !== false; %>
<% const _canManage = typeof canManageWorkspace !== 'undefined' && !!canManageWorkspace; %>
<% const _ra = typeof roleAccess !== 'undefined' && roleAccess ? roleAccess : { matrix: {}, pages: [], roles: ['admin', 'sdr', 'viewer'], labels: { owner: 'Owner', admin: 'Admin', sdr: 'SDR', viewer: 'Viewer' }, hints: {}, myEmail: '', myRole: '' }; %>
<%
  function _wsDateTime(iso) {
    return wsDateTime(iso, { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }) || '—';
  }
  function _wsDate(iso) {
    return wsDate(iso, { year: 'numeric', month: 'short', day: 'numeric' }) || '—';
  }
%>
<% const _wsMetaDesc = typeof workspaceSectionDescription !== 'undefined' ? String(workspaceSectionDescription) : 'Who belongs to this workspace and what they can do.'; %>

<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
  <div>
    <div class="inline-flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-brand-border dark:border-white/10 shadow-sm mb-4">
      <span class="text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400">Workspace</span>
    </div>
    <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-brand-dark dark:text-white">
      <span class="text-brand-muted dark:text-slate-500">Team</span> &amp; assign
    </h1>
    <p class="text-sm font-bold text-brand-muted dark:text-slate-400 mt-2 tabular-nums">
      In this workspace · <%= _memberCount %> member<%= _memberCount === 1 ? '' : 's' %><% if (_pendingCount > 0) { %> · <%= _pendingCount %> pending invite<%= _pendingCount === 1 ? '' : 's' %><% } %>
    </p>
    <p class="text-sm text-brand-muted max-w-2xl mt-2 leading-relaxed">
      <%= _wsMetaDesc %>
    </p>
    <% if (_wsName) { %>
    <p class="mt-2 text-sm font-semibold text-brand-dark dark:text-white"><%= _wsName %></p>
    <% } %>
    <% if (_wsId) { %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <button type="button" id="teamCopyWorkspaceId" class="text-[10px] font-black uppercase tracking-widest rounded-lg border border-brand-border/50 dark:border-white/15 px-3 py-1.5 text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/40 transition-colors">
        Copy workspace ID
      </button>
      <span id="teamCopyWorkspaceIdMsg" class="text-[10px] text-emerald-700 dark:text-emerald-300 hidden" aria-live="polite">Copied</span>
    </div>
    <% } %>
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 mt-4 flex flex-wrap gap-x-4 gap-y-2">
      <a href="/outreach" class="text-brand-dark dark:text-white hover:underline">Cadences</a>
      <a href="/leads" class="text-brand-dark dark:text-white hover:underline">Working queue</a>
      <a href="/workspace/pipeline" class="text-brand-dark dark:text-white hover:underline">Board &amp; stages</a>
      <span class="text-brand-yellow">Team &amp; assign</span>
    </p>
  </div>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
    <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
    <a href="#team-invite-panel" class="btn-pill btn-primary text-center px-5 py-3 text-xs font-black uppercase tracking-widest shadow-sm">Invite teammate</a>
    <% } %>
  </div>
</div>

<% if (_inviteStatus === 'created') { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 text-sm text-emerald-900 dark:text-emerald-100">
    Invite created for <strong><%= _inviteEmail %></strong>.
    <% if (_inviteEmailed) { %>We emailed the invite through GHL. You can also share the link below.<% } else { %>Share the link below.<% } %>
    <% if (_inviteEmailError) { %>
      <div class="mt-2 rounded-lg border border-amber-300 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-700 px-3 py-2 text-xs text-amber-900 dark:text-amber-100">
        The invite email was not sent: <%= _inviteEmailError %> <a href="/workspace/onboarding" class="font-bold underline">Onboarding settings</a>
      </div>
    <% } %>
    <% if (_inviteLink) { %>
      <div class="mt-2 flex flex-col sm:flex-row gap-2 sm:items-center">
        <input id="teamInviteLinkField" type="text" readonly value="<%= _inviteLink %>" class="w-full rounded-lg border border-emerald-300/60 bg-white/80 dark:bg-slate-900/70 px-3 py-2 text-xs text-emerald-900 dark:text-emerald-100" />
        <button type="button" id="teamInviteCopyBtn" class="btn-pill border border-emerald-500/50 bg-emerald-100 dark:bg-emerald-900/40 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200 shrink-0">Copy</button>
      </div>
    <% } %>
  </div>
<% } else if (_inviteStatus === 'accepted') { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 text-sm text-emerald-900 dark:text-emerald-100">Invite accepted. Workspace membership is now active.</div>
<% } else if (_inviteStatus === 'already_member') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">That email is already a workspace member.</div>
<% } else if (_inviteStatus === 'invalid_email') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Enter a valid email address.</div>
<% } else if (_inviteStatus === 'domain_restricted') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">That email address can't be invited. Check it and try again.</div>
<% } else if (_inviteStatus === 'error') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Could not add member. Please try again.</div>
<% } else if (_inviteStatus === 'wrong_account') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">This invite was sent to a different email. Sign in with the invited account.</div>
<% } else if (_inviteStatus === 'expired') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">This invite link expired. Create a new invite from this page.</div>
<% } else if (_inviteStatus === 'already_used') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">This invite link was already used.</div>
<% } else if (_inviteStatus === 'invalid') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Invite link is invalid.</div>
<% } else if (_inviteStatus === 'revoked') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">Invite revoked.</div>
<% } else if (_inviteStatus === 'revoke_not_found') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Could not find that pending invite (it may have been accepted or removed).</div>
<% } else if (_inviteStatus === 'revoke_error') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Could not revoke invite.</div>
<% } else if (_inviteStatus === 'regen_not_found') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Invite not found.</div>
<% } else if (_inviteStatus === 'already_accepted') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">That invite was already accepted.</div>
<% } else if (_inviteStatus === 'regen_error') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Could not generate a new link.</div>
<% } else if (_inviteStatus === 'role_saved') { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 text-sm text-emerald-900 dark:text-emerald-100">Role updated<% if (_inviteEmail) { %> for <strong><%= _inviteEmail %></strong><% } %>. It applies the next time they load a page.</div>
<% } else if (_inviteStatus === 'member_removed') { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 text-sm text-emerald-900 dark:text-emerald-100"><strong><%= _inviteEmail || 'Member' %></strong> was removed from this workspace. Their leads and history stay.</div>
<% } else if (_inviteStatus === 'access_saved') { %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800 px-6 py-4 text-sm text-emerald-900 dark:text-emerald-100">Roles &amp; access saved.</div>
<% } else if (_inviteStatus === 'owner_locked') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">Owners can't be changed or removed here.</div>
<% } else if (_inviteStatus === 'self_locked') { %>
  <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-6 py-4 text-sm text-amber-900 dark:text-amber-100">You can't change or remove your own seat. Ask another owner or admin.</div>
<% } else if (_inviteStatus === 'member_not_found' || _inviteStatus === 'role_error') { %>
  <div class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/30 dark:border-rose-800 px-6 py-4 text-sm text-rose-900 dark:text-rose-100">Could not update that member. Reload the page and try again.</div>
<% } %>

<% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
<details id="team-invite-panel" class="brand-card dark:bg-slate-900 dark:border-white/10 mb-8 group overflow-hidden" open>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1">
      <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Invite member</span>
      <span class="text-[11px] text-brand-muted">Secure link · any email · they sign in with Google</span>
    </div>
    <span class="shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
    </span>
  </summary>
  <form action="/workspace/team/invite" method="post" class="border-t border-brand-border/40 px-5 pb-5 pt-4 dark:border-white/10 md:px-6 md:pb-6">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
      <label class="sm:col-span-6 lg:col-span-5">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Email</span>
        <input name="email" type="email" required placeholder="name@gmail.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
      </label>
      <label class="sm:col-span-4 lg:col-span-3">
        <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5 block">Role</span>
        <select name="role" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white/70 dark:bg-slate-800/70 px-4 py-2.5 text-sm font-bold text-brand-dark dark:text-white">
          <option value="viewer">Viewer</option>
          <option value="sdr">SDR</option>
          <option value="admin">Admin</option>
        </select>
      </label>
      <div class="sm:col-span-2 flex gap-2">
        <button type="submit" class="btn-pill btn-primary w-full sm:w-auto px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Create invite</button>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-brand-muted">
      Creates a secure invite link for this email.
      <% const _obDays = Array.isArray(_obCfg.steps) && _obCfg.steps.length ? _obCfg.steps.length : 7; %>
      <% if (_obInviteOn) { %>The invite and <%= _obDays %> daily onboarding emails go out through this workspace&apos;s GHL.<% } else if (_obCfg.enabled !== false) { %><%= _obDays %> daily onboarding emails start after they join (invite email is off).<% } else { %>Onboarding emails are off.<% } %>
      <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %><a href="/workspace/onboarding" class="font-bold text-brand-dark dark:text-white underline">Edit onboarding emails</a><% } %>
    </p>
  </form>
</details>
<% } %>

<% if (_pendingCount > 0) { %>
<div class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10 mb-8">
  <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-4 pb-3 border-b border-brand-border/25 dark:border-white/10">
    <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Pending invites</span>
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-[11px] text-brand-muted tabular-nums"><%= _pendingCount %> in queue</span>
      <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hidden sm:inline">Density</span>
      <div class="hidden sm:inline-flex rounded-full border border-brand-border/40 dark:border-white/10 p-0.5 bg-brand-cream/30 dark:bg-slate-800/80" role="group" aria-label="Table row density">
        <button type="button" class="team-density-btn px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" data-density="comfortable">Comfortable</button>
        <button type="button" class="team-density-btn px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" data-density="compact">Compact</button>
      </div>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table id="teamPendingTable" class="w-full text-left border-collapse prospect-leads-table prospect-leads-table--comfortable team-prospect-table">
      <thead>
        <tr class="border-b border-brand-border/40 dark:border-white/10">
          <th class="pl-5 pr-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle" scope="col">Email</th>
          <th class="px-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle whitespace-nowrap w-[1%]" scope="col">Role</th>
          <th class="px-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle whitespace-nowrap" scope="col">Invited</th>
          <th class="px-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle whitespace-nowrap" scope="col">Expires</th>
          <th class="pr-5 pl-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle text-right min-w-[12rem]" scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% _pendingInvites.slice().sort(function (a, b) { return Date.parse(String(b.invitedAt || '')) - Date.parse(String(a.invitedAt || '')); }).forEach(function (inv) { %>
        <tr class="border-b border-brand-border/25 dark:border-white/5 last:border-0">
          <td class="pl-5 pr-3 align-middle">
            <span class="font-semibold text-brand-dark dark:text-white"><%= inv.email %></span>
          </td>
          <td class="px-3 align-middle whitespace-nowrap">
            <% if (_canManage && inv.id) { %>
            <form action="/workspace/team/invite/role" method="post" class="inline">
              <input type="hidden" name="inviteId" value="<%= inv.id %>" />
              <select name="role" class="ta-role-select" aria-label="Role for <%= inv.email %>" onchange="this.form.submit()">
                <% _ra.roles.forEach(function (r) { %><option value="<%= r %>" <%= (inv.role || 'viewer') === r ? 'selected' : '' %>><%= _ra.labels[r] %></option><% }) %>
              </select>
            </form>
            <% } else { %>
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted"><%= inv.role || 'viewer' %></span>
            <% } %>
          </td>
          <td class="px-3 align-middle text-sm text-brand-muted whitespace-nowrap"><%= inv.invitedAt ? _wsDateTime(inv.invitedAt) : '—' %></td>
          <td class="px-3 align-middle text-sm text-brand-muted whitespace-nowrap"><%= inv.expiresAt ? _wsDateTime(inv.expiresAt) : '—' %></td>
          <td class="pr-5 pl-3 align-middle text-right">
            <% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && inv.id) { %>
            <div class="inline-flex flex-wrap items-center justify-end gap-2">
              <form action="/workspace/team/invite/regenerate" method="post" class="inline">
                <input type="hidden" name="inviteId" value="<%= inv.id %>" />
                <button type="submit" class="btn-pill btn-primary px-3 py-1.5 text-[9px] font-black uppercase tracking-widest">New link</button>
              </form>
              <form action="/workspace/team/invite/revoke" method="post" class="inline" onsubmit="return confirm('Revoke this invite? The old link will stop working.');">
                <input type="hidden" name="inviteId" value="<%= inv.id %>" />
                <button type="submit" class="btn-pill border border-rose-300/70 dark:border-rose-500/40 bg-white dark:bg-slate-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40">Revoke</button>
              </form>
            </div>
            <% } else { %>
            <span class="text-sm text-brand-muted">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10 mb-8">
  <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-4 pb-3 border-b border-brand-border/25 dark:border-white/10">
    <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Members</span>
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-[11px] text-brand-muted tabular-nums"><%= _memberCount %> seat<%= _memberCount === 1 ? '' : 's' %></span>
      <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400 hidden sm:inline">Density</span>
      <div class="hidden sm:inline-flex rounded-full border border-brand-border/40 dark:border-white/10 p-0.5 bg-brand-cream/30 dark:bg-slate-800/80" role="group" aria-label="Table row density">
        <button type="button" class="team-density-btn px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" data-density="comfortable">Comfortable</button>
        <button type="button" class="team-density-btn px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest transition-colors text-brand-muted dark:text-slate-400 hover:text-brand-dark dark:hover:text-white" data-density="compact">Compact</button>
      </div>
    </div>
  </div>
  <% if (_memberCount > 0) { %>
  <div class="overflow-x-auto">
    <table id="teamMembersTable" class="w-full text-left border-collapse prospect-leads-table prospect-leads-table--comfortable team-prospect-table">
      <thead>
        <tr class="border-b border-brand-border/40 dark:border-white/10">
          <th class="pl-5 pr-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle" scope="col">Member</th>
          <th class="px-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle whitespace-nowrap w-[1%]" scope="col">Role</th>
          <th class="px-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle whitespace-nowrap text-right" scope="col">Joined</th>
          <% if (_canManage) { %>
          <th class="pr-5 pl-3 py-3.5 text-[10px] font-bold uppercase tracking-widest text-brand-muted dark:text-slate-400 align-middle text-right" scope="col">Actions</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% _memberEntries.forEach(([email, meta]) => { %>
        <% const _isOwner = meta.role === 'owner'; %>
        <% const _isMe = String(email).toLowerCase() === _ra.myEmail; %>
        <% const _editable = _canManage && !_isOwner && !_isMe && _ra.roles.indexOf(meta.role) !== -1; %>
        <tr class="border-b border-brand-border/25 dark:border-white/5 last:border-0">
          <td class="pl-5 pr-3 align-middle">
            <span class="font-semibold text-brand-dark dark:text-white"><%= email %></span>
            <% if (_isMe) { %><span class="ml-1 text-[10px] font-bold uppercase tracking-widest text-brand-muted">(you)</span><% } %>
          </td>
          <td class="px-3 align-middle whitespace-nowrap">
            <% if (_editable) { %>
            <form action="/workspace/team/member/role" method="post" class="inline">
              <input type="hidden" name="email" value="<%= email %>" />
              <select name="role" class="ta-role-select" aria-label="Role for <%= email %>" onchange="this.form.submit()">
                <% _ra.roles.forEach(function (r) { %><option value="<%= r %>" <%= meta.role === r ? 'selected' : '' %>><%= _ra.labels[r] %></option><% }) %>
              </select>
            </form>
            <% } else { %>
            <span class="text-[10px] font-black uppercase tracking-widest px-2 py-1 rounded-lg bg-brand-yellow/15 text-amber-900 dark:text-amber-200"><%= meta.role %></span>
            <% } %>
          </td>
          <td class="px-3 align-middle text-right text-sm text-brand-muted whitespace-nowrap"><%= meta.joinedAt ? _wsDate(meta.joinedAt) : '—' %></td>
          <% if (_canManage) { %>
          <td class="pr-5 pl-3 align-middle text-right">
            <% if (_editable) { %>
            <form action="/workspace/team/member/remove" method="post" class="inline" onsubmit="return confirm('Remove this member from the workspace? They lose access right away. Their leads and history stay.');">
              <input type="hidden" name="email" value="<%= email %>" />
              <button type="submit" class="btn-pill border border-rose-300/70 dark:border-rose-500/40 bg-white dark:bg-slate-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40">Remove</button>
            </form>
            <% } else { %>
            <span class="text-sm text-brand-muted">—</span>
            <% } %>
          </td>
          <% } %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="px-5 py-10 md:px-6 text-center text-sm text-brand-muted border-t border-brand-border/25 dark:border-white/10">
    No members yet — sign in again to seed your account.
  </div>
  <% } %>
</div>

<% if (_canManage && _ra.pages.length) { %>
<form id="team-access" action="/workspace/team/access" method="post" class="brand-card overflow-hidden w-full dark:bg-slate-900 dark:border-white/10 mb-8 scroll-mt-28">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-4 pb-3 border-b border-brand-border/25 dark:border-white/10">
    <div class="min-w-0">
      <span class="text-[10px] font-black uppercase tracking-widest text-brand-muted dark:text-slate-400">Roles &amp; access</span>
      <p class="text-[11px] text-brand-muted mt-1">Choose which pages each role can open and which leads they see. Owners always have full access. Unchecked pages are hidden from their menu.</p>
    </div>
    <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Save access</button>
  </div>
  <div class="overflow-x-auto">
    <table class="ta-grid w-full text-left border-collapse">
      <thead>
        <tr>
          <th scope="col" class="ta-page-col">Page</th>
          <th scope="col" class="ta-role-col">
            <span class="ta-role-name"><%= _ra.labels.owner %></span>
            <span class="ta-role-hint"><%= _ra.hints.owner %></span>
          </th>
          <% _ra.roles.forEach(function (r) { %>
          <th scope="col" class="ta-role-col">
            <span class="ta-role-name"><%= _ra.labels[r] %></span>
            <span class="ta-role-hint"><%= _ra.hints[r] %></span>
          </th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <tr class="ta-leads-row">
          <th scope="row" class="ta-page-col">
            <span class="ta-page-name">Leads they see</span>
            <span class="ta-role-hint">Applies to Opportunities, Leads, Call mode and folders.</span>
          </th>
          <td class="ta-role-col"><span class="ta-fixed">All leads</span></td>
          <% _ra.roles.forEach(function (r) { %>
          <td class="ta-role-col">
            <select name="leads.<%= r %>" class="ta-role-select" aria-label="Leads <%= _ra.labels[r] %> can see">
              <option value="all" <%= _ra.matrix[r].leads === 'all' ? 'selected' : '' %>>All leads</option>
              <option value="assigned" <%= _ra.matrix[r].leads === 'assigned' ? 'selected' : '' %>>Only assigned to them</option>
            </select>
          </td>
          <% }) %>
        </tr>
        <% let _lastGroup = ''; %>
        <% _ra.pages.forEach(function (p) { %>
        <% if (p.group !== _lastGroup) { _lastGroup = p.group; %>
        <tr class="ta-group-row"><th scope="rowgroup" colspan="<%= _ra.roles.length + 2 %>"><%= p.group %></th></tr>
        <% } %>
        <tr>
          <th scope="row" class="ta-page-col"><span class="ta-page-name"><%= p.label %></span></th>
          <td class="ta-role-col"><input type="checkbox" checked disabled aria-label="<%= p.label %> for owners" /></td>
          <% _ra.roles.forEach(function (r) { %>
          <% const _lockAdminSettings = r === 'admin' && p.id === 'settings' && _ra.myRole !== 'owner'; %>
          <td class="ta-role-col">
            <input type="checkbox" name="page.<%= r %>.<%= p.id %>" <%= _ra.matrix[r].pages[p.id] ? 'checked' : '' %> <%= _lockAdminSettings ? 'disabled' : '' %> aria-label="<%= p.label %> for <%= _ra.labels[r] %>" />
            <% if (_lockAdminSettings) { %><input type="hidden" name="page.<%= r %>.<%= p.id %>" value="on" /><% } %>
          </td>
          <% }) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-t border-brand-border/25 dark:border-white/10">
    <p class="text-[11px] text-brand-muted">Changes apply the next time a member loads a page. Workspace settings includes this Team page.</p>
    <button type="submit" class="btn-pill btn-primary px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Save access</button>
  </div>
</form>
<% } %>

<style>
  .ta-role-select { border-radius: 0.75rem; border: 1px solid rgba(17, 24, 39, 0.14); background: #fff; padding: 0.35rem 1.9rem 0.35rem 0.65rem; font-size: 0.75rem; font-weight: 700; color: #111827; max-width: 12rem; }
  html.dark .ta-role-select { background: #1e293b; border-color: rgba(255, 255, 255, 0.12); color: #f8fafc; }
  .ta-grid th, .ta-grid td { padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(17, 24, 39, 0.06); vertical-align: middle; }
  html.dark .ta-grid th, html.dark .ta-grid td { border-color: rgba(255, 255, 255, 0.06); }
  .ta-grid thead th { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: #6b7280; }
  .ta-page-col { padding-left: 1.25rem !important; min-width: 12rem; font-weight: 600; }
  .ta-role-col { text-align: center; min-width: 7rem; }
  .ta-grid .ta-role-select { width: 100%; max-width: 10rem; font-size: 0.7rem; }
  .ta-role-name { display: block; color: #111827; }
  html.dark .ta-role-name, html.dark .ta-page-name { color: #f8fafc; }
  .ta-role-hint { display: block; margin-top: 0.15rem; font-size: 10px; font-weight: 500; letter-spacing: 0; text-transform: none; color: #6b7280; }
  .ta-page-name { font-size: 0.875rem; color: #111827; }
  .ta-group-row th { padding-top: 1rem; padding-left: 1.25rem; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.14em; color: #b45309; background: rgba(250, 204, 21, 0.06); }
  .ta-leads-row th, .ta-leads-row td { background: rgba(250, 204, 21, 0.05); }
  .ta-fixed { font-size: 0.75rem; font-weight: 700; color: #6b7280; }
  .ta-grid input[type="checkbox"] { width: 1.05rem; height: 1.05rem; accent-color: #ca8a04; cursor: pointer; }
  .ta-grid input[type="checkbox"]:disabled { cursor: not-allowed; opacity: 0.55; }
</style>

<p class="text-sm text-brand-muted mb-6">Manage invites and roles here. Links from <strong>New link</strong> replace the previous URL until accepted.</p>

<details class="text-xs text-brand-muted rounded-2xl border border-brand-border dark:border-white/10 px-4 py-3 bg-white/50 dark:bg-slate-900/40">
  <summary class="cursor-pointer font-semibold text-brand-dark dark:text-white">Advanced: SDR list via server configuration</summary>
  <p class="mt-2 leading-relaxed">Some deployments mark SDR seats with a server-side allowlist so routing stays aligned with your identity provider. If you are self-hosting, your operator can configure that list; it is not editable from this UI.</p>
</details>

<script>
(function () {
  var copyBtn = document.getElementById('teamInviteCopyBtn');
  var field = document.getElementById('teamInviteLinkField');
  if (copyBtn && field) {
    copyBtn.addEventListener('click', function () {
      var v = String(field.value || '').trim();
      if (!v) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(v).then(function () {
          copyBtn.textContent = 'Copied';
          setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1400);
        }).catch(function () {
          field.focus(); field.select();
        });
        return;
      }
      field.focus(); field.select();
    });
  }
  var widBtn = document.getElementById('teamCopyWorkspaceId');
  var widMsg = document.getElementById('teamCopyWorkspaceIdMsg');
  if (widBtn) {
    widBtn.addEventListener('click', function () {
      var id = <%- JSON.stringify(_wsId) %>;
      function flash() {
        if (widMsg) { widMsg.classList.remove('hidden'); window.setTimeout(function () { widMsg.classList.add('hidden'); }, 1600); }
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(id).then(flash).catch(function () { window.prompt('Workspace ID', id); });
      } else {
        window.prompt('Workspace ID', id);
      }
    });
  }
  document.querySelectorAll('.team-density-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var d = btn.getAttribute('data-density');
      document.querySelectorAll('.team-prospect-table').forEach(function (table) {
        table.classList.remove('prospect-leads-table--comfortable', 'prospect-leads-table--compact');
        table.classList.add(d === 'compact' ? 'prospect-leads-table--compact' : 'prospect-leads-table--comfortable');
      });
      document.querySelectorAll('.team-density-btn').forEach(function (b) {
        var on = b.getAttribute('data-density') === d;
        b.classList.toggle('lead-density-btn--active', on);
      });
    });
  });
  var comfortableBtns = document.querySelectorAll('.team-density-btn[data-density="comfortable"]');
  comfortableBtns.forEach(function (b) { b.classList.add('lead-density-btn--active'); });
})();
</script>
