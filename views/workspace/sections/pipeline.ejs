<% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace && workspace && workspace.id) { %>
<% const _prospect = workspace && workspace.prospecting && typeof workspace.prospecting === 'object' ? workspace.prospecting : {}; %>
<% const _lowReviewsThreshold = _prospect.lowReviewsThreshold != null && _prospect.lowReviewsThreshold !== '' ? _prospect.lowReviewsThreshold : 30; %>
<% const _goalCatalog = typeof workspaceGoalCatalog !== 'undefined' && Array.isArray(workspaceGoalCatalog) ? workspaceGoalCatalog : []; %>
<% const _roiProfile = typeof workspaceRoiProfile !== 'undefined' && workspaceRoiProfile ? workspaceRoiProfile : (_prospect.roiProfile || 'agency_gap'); %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 flex flex-wrap items-center justify-between gap-4">
  <div>
    <h2 class="font-bold text-lg text-brand-dark dark:text-white">Pipeline stages</h2>
    <p class="text-sm text-brand-muted mt-1">Reorder stages, apply presets, or redesign with AI. Leads stay mapped when you change the board.</p>
  </div>
  <a href="/workspaces/<%= workspace.id %>/settings/pipeline" class="btn-pill btn-primary px-6 py-3 text-[10px] font-black uppercase tracking-widest shrink-0">Edit pipeline</a>
</div>

<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8 mt-6">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">Workspace goal</h2>
  <p class="text-sm text-brand-muted mb-4">Controls what “high opportunity” means for this workspace — Money Mode, Today’s queue, and the Opportunity score/badge. AdHello agencies optimize for <em>no website</em>; HomeElk scores <em>CCB &amp; COI expiry</em>.</p>
  <fieldset class="space-y-3 mb-6">
    <legend class="sr-only">Workspace goal</legend>
    <% _goalCatalog.forEach(function (g) { %>
    <label class="flex gap-3 items-start cursor-pointer rounded-2xl border border-brand-border dark:border-white/10 p-4 has-[:checked]:border-brand-yellow has-[:checked]:bg-brand-yellow/5">
      <input type="radio" name="wsRoiProfile" value="<%= g.id %>" class="mt-1" <%= _roiProfile === g.id ? 'checked' : '' %> />
      <span>
        <strong class="text-brand-dark dark:text-white"><%= g.label %></strong>
        <span class="block text-xs text-brand-muted mt-0.5"><%= g.bestFor %></span>
        <span class="block text-[11px] text-brand-muted mt-1"><%= g.badgeHint %></span>
      </span>
    </label>
    <% }); %>
  </fieldset>

  <% const _colCatalog = typeof pipelineColumnPresetCatalog !== 'undefined' && Array.isArray(pipelineColumnPresetCatalog) ? pipelineColumnPresetCatalog : []; %>
  <% const _colPreset = typeof workspacePipelineColumnPreset !== 'undefined' && workspacePipelineColumnPreset ? workspacePipelineColumnPreset : 'local_agency'; %>
  <% if (_colCatalog.length) { %>
  <h3 class="font-bold text-sm text-brand-dark dark:text-white mb-2 mt-8">Pipeline Detail columns</h3>
  <p class="text-sm text-brand-muted mb-4">Default columns for this workspace’s Detail table (Compact stays the short view). Saving resets your personal column tweaks for this workspace to the preset.</p>
  <fieldset class="space-y-3 mb-6">
    <legend class="sr-only">Pipeline column layout</legend>
    <% _colCatalog.forEach(function (p) { %>
    <label class="flex gap-3 items-start cursor-pointer rounded-2xl border border-brand-border dark:border-white/10 p-4 has-[:checked]:border-brand-yellow has-[:checked]:bg-brand-yellow/5">
      <input type="radio" name="wsPipelineColumnPreset" value="<%= p.id %>" class="mt-1" <%= _colPreset === p.id ? 'checked' : '' %> />
      <span>
        <strong class="text-brand-dark dark:text-white"><%= p.label %></strong>
        <span class="block text-xs text-brand-muted mt-0.5"><%= p.bestFor %></span>
        <span class="block text-[11px] text-brand-muted mt-1"><%= p.hint %></span>
      </span>
    </label>
    <% }); %>
  </fieldset>
  <% } %>

  <h3 class="font-bold text-sm text-brand-dark dark:text-white mb-2">Prospecting signals</h3>
  <p class="text-sm text-brand-muted mb-4">Extra knobs for the Opportunity column (mainly website / reviews workspaces).</p>
  <div class="space-y-4 max-w-md">
    <div>
      <label for="wsLowReviewsThreshold" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Low reviews threshold</label>
      <input type="number" id="wsLowReviewsThreshold" min="0" max="10000" step="1" value="<%= _lowReviewsThreshold %>" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
      <p class="text-[11px] text-brand-muted mt-1">Leads with this many Google reviews or fewer get the <strong class="text-brand-dark dark:text-white">LOW REVIEWS</strong> tag (agency / partner goals). Default is 30.</p>
    </div>
    <p id="wsPipelineSettingsMsg" class="hidden text-sm"></p>
    <button type="button" id="wsPipelineSettingsSave" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save workspace layout</button>
  </div>
</div>
<%- include('../partials/scripts_pipeline') %>
<% } %>
