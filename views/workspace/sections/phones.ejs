<% if (typeof canManageWorkspace !== 'undefined' && canManageWorkspace) { %>
<% const _tp = workspace && workspace.telephony ? workspace.telephony : {}; %>
<% const _entryList = Array.isArray(_tp.numberBankEntries) ? _tp.numberBankEntries : []; %>
<% const _legacyBank = Array.isArray(_tp.numberBank) ? _tp.numberBank : []; %>
<% const _emptyStats = { incoming: 0, connected: 0, missed: 0, voicemail: 0 }; %>
<% const _entries = _entryList.length ? _entryList : _legacyBank.map(function (n) { return { number: n, callerName: '', cnamStatus: 'not_submitted', cnamNotes: '', inboundStats: _emptyStats }; }); %>
<% const _activeFrom = (_tp.activeFromNumber || '').toString(); %>
<% const _callMode = (_tp.callMode || 'cloud_dial').toString(); %>
<% const _pacing = _tp && _tp.dialerPacing && typeof _tp.dialerPacing === 'object' ? _tp.dialerPacing : {}; %>
<% const _drRaw = _tp.dialRetry && typeof _tp.dialRetry === 'object' ? _tp.dialRetry : {}; %>
<% const _dr = {
  autoNoAnswerOnDial: _drRaw.autoNoAnswerOnDial !== false,
  retrySchedule: (_drRaw.retrySchedule || '18h').toString(),
  retryDelayHours: parseInt(_drRaw.retryDelayHours, 10) || 18,
  retryDelayDays: parseInt(_drRaw.retryDelayDays, 10) || 3,
  retryAtHourLocal: parseInt(_drRaw.retryAtHourLocal, 10) || 10,
  queueMode: (_drRaw.queueMode || 'continue_list').toString()
}; %>
<% const _pEvents = Array.isArray(_pacing.events) ? _pacing.events : []; %>
<% const _pBurned = _pacing.burned && typeof _pacing.burned === 'object' ? _pacing.burned : {}; %>
<%
  const _nowMs = Date.now();
  const _hourAgo = _nowMs - (60 * 60 * 1000);
  const _attemptsLastHour = _pEvents.filter(function (e) {
    if (!e || e.type !== 'attempt' || !e.at) return false;
    const t = Date.parse(String(e.at));
    return Number.isFinite(t) && t >= _hourAgo;
  });
  const _outcomesRecent = _pEvents.filter(function (e) {
    if (!e || e.type !== 'outcome' || !e.at) return false;
    const t = Date.parse(String(e.at));
    return Number.isFinite(t) && t >= (_nowMs - (24 * 60 * 60 * 1000));
  });
  const _answeredRecent = _outcomesRecent.filter(function (e) { return e.answered === true; }).length;
  const _answerRateRecent = _outcomesRecent.length ? Math.round((_answeredRecent / _outcomesRecent.length) * 100) : 0;
  const _burnedLive = Object.entries(_pBurned).filter(function (entry) {
    const v = entry[1] || {};
    const until = Date.parse(String(v.until || ''));
    return Number.isFinite(until) && until > _nowMs;
  });
%>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">Phone number bank</h2>
  <p class="text-sm text-brand-muted mb-6">Manage outbound numbers, call routing mode, and CNAM request status. Active number is used for call/SMS/voicemail actions in cloud mode.</p>
  <div class="mb-6 space-y-2">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Guided walkthroughs</p>
    <div class="flex flex-wrap gap-2">
      <button type="button" id="callRoutingWalkthroughCloudBtn" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Cloud dial</button>
      <button type="button" id="callRoutingWalkthroughAgentBtn" class="inline-flex items-center gap-1.5 rounded-full border border-brand-yellow/50 bg-brand-yellow/10 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors">Agent first</button>
      <button type="button" id="callRoutingWalkthroughDeviceBtn" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border/60 dark:border-white/15 bg-brand-cream/40 dark:bg-slate-800/80 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">My device dialer</button>
    </div>
    <p class="text-[10px] text-brand-muted max-w-2xl leading-snug">Each opens a short checklist for that routing mode. If that mode is already saved and looks complete, you will see a quick “all set” message — you can still expand the full steps.</p>
  </div>

  <fieldset class="mb-6">
    <legend class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">Call routing mode</legend>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
      <label class="relative flex flex-col cursor-pointer min-h-0">
        <input type="radio" name="wsCallMode" value="cloud_dial" class="peer sr-only" <%= _callMode === 'cloud_dial' ? 'checked' : '' %> />
        <div class="flex-1 rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-4 transition-all peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/50 peer-checked:bg-brand-yellow/10">
          <p class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Cloud dial</p>
          <p class="text-[11px] text-brand-muted mt-1">SignalWire places calls from your workspace number.</p>
        </div>
        <p class="mt-2 text-[11px] text-brand-muted leading-snug hidden peer-checked:block">Best for talking on your computer: mic and speakers in the browser (WebRTC) when SignalWire is configured. Also supports voicemail drop and server-managed outbound.</p>
      </label>
      <label class="relative flex flex-col cursor-pointer min-h-0">
        <input type="radio" name="wsCallMode" value="agent_first" class="peer sr-only" <%= _callMode === 'agent_first' ? 'checked' : '' %> />
        <div class="flex-1 rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-4 transition-all peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/50 peer-checked:bg-brand-yellow/10">
          <p class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Agent first</p>
          <p class="text-[11px] text-brand-muted mt-1">Your mobile rings first, then the lead is bridged.</p>
        </div>
        <p class="mt-2 text-[11px] text-brand-muted leading-snug hidden peer-checked:block">Great for two-way talk on iPhone or Bluetooth. Requires your mobile in E.164. Voicemail drop still uses the cloud flow.</p>
      </label>
      <label class="relative flex flex-col cursor-pointer min-h-0">
        <input type="radio" name="wsCallMode" value="browser_device" class="peer sr-only" <%= _callMode === 'browser_device' ? 'checked' : '' %> />
        <div class="flex-1 rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-800/50 p-4 transition-all peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/50 peer-checked:bg-brand-yellow/10">
          <p class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">My device dialer</p>
          <p class="text-[11px] text-brand-muted mt-1">Opens your phone app with the number prefilled.</p>
        </div>
        <p class="mt-2 text-[11px] text-brand-muted leading-snug hidden peer-checked:block">Runs on your carrier or device, not in-browser audio. AdHello voicemail drop still uses cloud automation.</p>
      </label>
    </div>
  </fieldset>

  <div id="wsAgentPhoneWrap" class="<%= _callMode === 'agent_first' ? '' : 'hidden' %> mb-6">
    <label for="wsAgentPhone" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Your mobile (agent)</label>
    <input type="tel" id="wsAgentPhone" class="w-full max-w-md rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" placeholder="+15551234567" value="<%= (workspace && workspace.telephony && workspace.telephony.agentPhone) || '' %>" />
    <p class="text-[10px] text-brand-muted mt-1">E.164 personal cell only — not a Phone bank / SignalWire DID. SignalWire rings this number first; bank numbers are caller ID for the lead.</p>
    <div class="mt-3 rounded-xl border border-amber-300/50 dark:border-amber-500/30 bg-amber-50/70 dark:bg-amber-950/25 px-3 py-2.5 max-w-xl">
      <p class="text-[10px] font-black uppercase tracking-widest text-amber-900 dark:text-amber-200 mb-1">If your phone never rings</p>
      <ol class="text-[11px] text-amber-950/90 dark:text-amber-100/85 leading-relaxed list-decimal pl-4 space-y-1">
        <li><strong>Forwards to</strong> below is only for inbound records — it does not place agent-first calls.</li>
        <li>Save your workspace DID (e.g. +1 360-793-5057) as an iPhone contact named “AdHello Dialer”.</li>
        <li>Turn off iPhone <strong>Settings → Phone → Silence Unknown Callers</strong>.</li>
        <li>Use <strong>Test ring my phone</strong> — you should get a short call that says this is an agent phone test.</li>
      </ol>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <button type="button" id="wsAgentTestRingBtn" class="rounded-xl border border-brand-yellow/60 bg-brand-yellow/15 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/25 transition-colors">Test ring my phone</button>
        <p id="wsAgentTestRingMsg" class="text-[11px] text-brand-muted min-h-[1rem]"></p>
      </div>
    </div>
  </div>

  <div class="mb-6 rounded-xl border border-brand-border/30 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/40 p-4">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Pacing intelligence</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Cap / number / hour
        <input id="wsPerNumberHourCap" type="number" min="1" max="120" step="1" value="<%= (workspace && workspace.telephony && workspace.telephony.perNumberHourCap) || 24 %>" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" />
      </label>
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Lead local dial start
        <input id="wsQuietStart" type="time" value="<%= (workspace && workspace.telephony && workspace.telephony.quietHoursStart) || '08:00' %>" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" />
      </label>
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Lead local dial end
        <input id="wsQuietEnd" type="time" value="<%= (workspace && workspace.telephony && workspace.telephony.quietHoursEnd) || '20:00' %>" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" />
      </label>
    </div>
    <p class="text-[10px] text-brand-muted mt-2">Caller IDs rotate automatically, numbers over cap are throttled, and low-answer numbers cool down before reuse.</p>
  </div>

  <div class="mb-6 rounded-xl border border-brand-border/30 dark:border-white/10 bg-brand-cream/15 dark:bg-slate-800/40 p-4">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">After every dial</p>
    <label class="flex items-start gap-3 mb-4 cursor-pointer">
      <input type="checkbox" id="wsDialRetryAutoNoAnswer" class="mt-1 rounded border-brand-border" <%= _dr.autoNoAnswerOnDial ? 'checked' : '' %> />
      <span class="text-sm text-brand-dark dark:text-white">
        Auto-tag as <strong>No pickup</strong> and schedule a retry task
        <span class="block text-[11px] text-brand-muted mt-1 font-normal">Runs when a call is placed from Focus, pipeline, or softphone. You can still change the outcome before logging.</span>
      </span>
    </label>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Retry timing
        <select id="wsDialRetrySchedule" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs">
          <option value="18h" <%= _dr.retrySchedule === '18h' ? 'selected' : '' %>>18 hours (same day / next morning)</option>
          <option value="1d" <%= _dr.retrySchedule === '1d' ? 'selected' : '' %>>1 day at set hour</option>
          <option value="3d" <%= _dr.retrySchedule === '3d' ? 'selected' : '' %>>3 days at set hour</option>
          <option value="7d" <%= _dr.retrySchedule === '7d' ? 'selected' : '' %>>7 days at set hour</option>
          <option value="custom_hours" <%= _dr.retrySchedule === 'custom_hours' ? 'selected' : '' %>>Custom hours</option>
          <option value="custom_days" <%= _dr.retrySchedule === 'custom_days' ? 'selected' : '' %>>Custom days</option>
        </select>
      </label>
      <label class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Retry at hour (day-based)
        <select id="wsDialRetryAtHour" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs">
          <% for (var _h = 6; _h <= 20; _h++) { %>
          <option value="<%= _h %>" <%= _dr.retryAtHourLocal === _h ? 'selected' : '' %>><%= (_h % 12 || 12) %>:00 <%= _h < 12 ? 'AM' : 'PM' %></option>
          <% } %>
        </select>
      </label>
      <label id="wsDialRetryHoursWrap" class="text-[10px] font-black uppercase tracking-widest text-brand-muted <%= _dr.retrySchedule === 'custom_hours' ? '' : 'hidden' %>">Custom hours
        <input id="wsDialRetryDelayHours" type="number" min="1" max="720" step="1" value="<%= _dr.retryDelayHours %>" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" />
      </label>
      <label id="wsDialRetryDaysWrap" class="text-[10px] font-black uppercase tracking-widest text-brand-muted <%= _dr.retrySchedule === 'custom_days' ? '' : 'hidden' %>">Custom days
        <input id="wsDialRetryDelayDays" type="number" min="1" max="90" step="1" value="<%= _dr.retryDelayDays %>" class="mt-1 w-full rounded-xl border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-xs" />
      </label>
    </div>
    <fieldset>
      <legend class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Focus queue while waiting to retry</legend>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <label class="relative flex flex-col cursor-pointer">
          <input type="radio" name="wsDialRetryQueueMode" value="continue_list" class="peer sr-only" <%= _dr.queueMode === 'continue_list' ? 'checked' : '' %> />
          <div class="rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-900/45 p-4 peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/40">
            <p class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Continue the list first</p>
            <p class="text-[11px] text-brand-muted mt-1">Keep dialing new leads; retries move to the back until due.</p>
          </div>
        </label>
        <label class="relative flex flex-col cursor-pointer">
          <input type="radio" name="wsDialRetryQueueMode" value="retry_when_due" class="peer sr-only" <%= _dr.queueMode === 'retry_when_due' ? 'checked' : '' %> />
          <div class="rounded-2xl border-2 border-brand-border/50 dark:border-white/10 bg-white/60 dark:bg-slate-900/45 p-4 peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/40">
            <p class="text-xs font-black uppercase tracking-widest text-brand-dark dark:text-white">Hide until retry is due</p>
            <p class="text-[11px] text-brand-muted mt-1">No-answer leads drop out of Focus until their retry window opens.</p>
          </div>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="mb-6 rounded-xl border border-brand-border/30 dark:border-white/10 bg-white/60 dark:bg-slate-900/45 p-4">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">Pacing health</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
      <div class="rounded-lg border border-brand-border/30 dark:border-white/10 px-3 py-2">
        <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Attempts (last hour)</p>
        <p class="mt-1 text-lg font-black text-brand-dark dark:text-white tabular-nums"><%= _attemptsLastHour.length %></p>
      </div>
      <div class="rounded-lg border border-brand-border/30 dark:border-white/10 px-3 py-2">
        <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Answer rate (24h)</p>
        <p class="mt-1 text-lg font-black text-brand-dark dark:text-white tabular-nums"><%= _answerRateRecent %>%</p>
      </div>
      <div class="rounded-lg border border-brand-border/30 dark:border-white/10 px-3 py-2">
        <p class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Cooled numbers</p>
        <p class="mt-1 text-lg font-black <%= _burnedLive.length ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300' %> tabular-nums"><%= _burnedLive.length %></p>
      </div>
    </div>
    <% if (_burnedLive.length) { %>
      <div class="space-y-2">
        <% _burnedLive.forEach(function (entry) { const num = entry[0]; const data = entry[1] || {}; const until = String(data.until || ''); const reason = String(data.reason || 'Cooling down due to low answer rate.'); %>
          <div class="rounded-lg border border-amber-300/40 dark:border-amber-500/20 bg-amber-50/60 dark:bg-amber-950/15 px-3 py-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-xs font-bold text-brand-dark dark:text-white"><%= num %></p>
              <p class="text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-300">
                back in <span class="ws-burn-eta tabular-nums" data-until="<%= until %>">--:--</span>
              </p>
            </div>
            <p class="mt-1 text-[11px] text-brand-muted"><%= reason %></p>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-xs text-emerald-700 dark:text-emerald-300 font-semibold">All numbers healthy — none are currently cooling down.</p>
    <% } %>
  </div>

  <datalist id="swPhoneBankNumberOptions"></datalist>
  <p id="swPhoneListHint" class="hidden text-[11px] text-amber-800 dark:text-amber-200/90 mb-2 leading-snug"></p>
  <% const _pubBase = typeof publicAppBaseUrl !== 'undefined' ? String(publicAppBaseUrl || '').trim() : ''; %>
  <% const _tokOn = typeof telephonyWebhookTokenConfigured !== 'undefined' && telephonyWebhookTokenConfigured; %>
  <div class="mb-4 rounded-xl border border-sky-300/35 dark:border-sky-700/40 bg-sky-50/50 dark:bg-sky-950/20 px-4 py-3 text-[11px] text-brand-muted leading-relaxed max-w-4xl">
    <p class="text-[10px] font-black uppercase tracking-widest text-sky-800 dark:text-sky-300 mb-1">Inbound call analytics</p>
    <p>Set <strong>Forwards to</strong> to the mobile or desk line where SignalWire routes each DID (for your records). To fill the counters below, configure each purchased number in SignalWire so <strong>Voice · Status Callback</strong> posts to the same URL as outbound tracking:</p>
    <p class="mt-2 font-mono text-[10px] break-all bg-white/70 dark:bg-slate-900/60 rounded-lg px-2 py-1.5 border border-brand-border/30"><%= _pubBase ? _pubBase : 'https://YOUR_PUBLIC_BASE_URL' %>/api/telephony/voice/status<% if (_tokOn) { %>?token=…<% } %></p>
    <% if (!_tokOn) { %><p class="mt-1 text-[10px] text-amber-800 dark:text-amber-200/90">When <code class="px-1 rounded bg-brand-cream/80 dark:bg-slate-700">TELEPHONY_WEBHOOK_TOKEN</code> is set on the server, append <code class="px-1 rounded bg-brand-cream/80 dark:bg-slate-700">?token=…</code> to match your env.</p><% } %>
    <p class="mt-2">AdHello matches inbound calls to this workspace by the called number (<strong>To</strong>). Answered / missed / voicemail are estimated from call duration and machine detection when present.</p>
  </div>

  <% const _shareOn = !!(_tp.phoneAnalyticsShareTokenHash); %>
  <% const _shareCreated = (_tp.phoneAnalyticsShareCreatedAt || '').toString(); %>
  <% const _widShare = workspace && workspace.id ? String(workspace.id) : ''; %>
  <div id="wsPhoneShareRoot" class="mb-6 rounded-xl border border-violet-300/35 dark:border-violet-700/40 bg-violet-50/50 dark:bg-violet-950/20 px-4 py-3 max-w-4xl" data-workspace-id="<%= _widShare %>">
    <p class="text-[10px] font-black uppercase tracking-widest text-violet-800 dark:text-violet-300 mb-2">Client share</p>
    <p class="text-[11px] text-brand-muted leading-relaxed mb-3">Create a read-only page you can send to a client: forwarding destinations and inbound counters only (no CNAM notes or internal fields).</p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" id="wsPhoneShareGenerate" class="rounded-xl border border-violet-400/50 dark:border-violet-500/40 bg-white/80 dark:bg-slate-900/80 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-violet-900 dark:text-violet-200 hover:bg-violet-100/80 dark:hover:bg-violet-950/50"><%= _shareOn ? 'Rotate link' : 'Generate link' %></button>
      <button type="button" id="wsPhoneShareCopy" class="rounded-xl border border-brand-border/40 dark:border-white/15 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white disabled:opacity-40" <%= _shareOn ? '' : 'disabled' %>>Copy link</button>
      <button type="button" id="wsPhoneShareDisable" class="rounded-xl border border-rose-300/50 dark:border-rose-800/50 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-rose-700 dark:text-rose-300 disabled:opacity-40" <%= _shareOn ? '' : 'disabled' %>>Revoke</button>
    </div>
    <p id="wsPhoneShareUrl" class="mt-2 text-[10px] font-mono break-all text-brand-muted hidden"></p>
    <p id="wsPhoneShareMsg" class="mt-2 text-[11px] hidden"></p>
    <% if (_shareOn && _shareCreated) { %>
      <p class="mt-2 text-[10px] text-brand-muted">Share link is active · created <%= new Date(_shareCreated).toLocaleString() %>. Use <strong>Copy link</strong> if this browser still has the URL in session; otherwise rotate to issue a new URL.</p>
    <% } %>
  </div>

  <p class="text-[11px] text-brand-muted mb-3 max-w-3xl leading-relaxed">Use the number field to pick a value from the list of <strong>numbers in your SignalWire project</strong> (or type any E.164). Then set the caller name for CNAM. The list loads from the same project as this app&rsquo;s <code class="text-[10px] px-1 rounded bg-brand-cream/80 dark:bg-slate-700">SIGNALWIRE_</code> server keys. <a href="https://id.signalwire.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-yellow hover:underline">Open SignalWire</a> to sign in and purchase a new number, then refresh this page so it appears in the list.</p>

  <div id="wsPhoneBankList" class="space-y-2">
    <% _entries.forEach(function (entry, idx) { %>
    <% const _ist = entry.inboundStats && typeof entry.inboundStats === 'object' ? entry.inboundStats : {}; %>
    <% const _inc = parseInt(_ist.incoming, 10); const _conn = parseInt(_ist.connected, 10); const _miss = parseInt(_ist.missed, 10); const _vm = parseInt(_ist.voicemail, 10); %>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-2 items-center p-3 rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 ws-phone-entry" data-entry-index="<%= idx %>">
      <div class="md:col-span-3">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Number (DID)</label>
        <input type="text" class="ws-phone-number w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" list="swPhoneBankNumberOptions" value="<%= (entry.number || '').toString() %>" placeholder="Choose from list or type +1555…" autocomplete="off" />
      </div>
      <div class="md:col-span-3">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Forwards to</label>
        <input type="tel" class="ws-phone-forward w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.forwardNumber || '').toString() %>" placeholder="+1555… (your cell / desk)" autocomplete="off" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Caller name</label>
        <input type="text" class="ws-phone-caller-name w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.callerName || '').toString() %>" placeholder="ADHELLO AI" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM status</label>
        <select class="ws-phone-cnam-status w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs">
          <% const _st = (entry.cnamStatus || 'not_submitted').toString(); %>
          <% ['not_submitted','submitted','in_review','approved','rejected','live'].forEach(function (opt) { %>
            <option value="<%= opt %>" <%= _st === opt ? 'selected' : '' %>><%= opt %></option>
          <% }); %>
        </select>
      </div>
      <div class="md:col-span-1">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Active</label>
        <label class="inline-flex items-center gap-2 text-xs">
          <input type="radio" name="wsActiveCallerRadio" class="ws-phone-active" value="<%= (entry.number || '').toString() %>" <%= _activeFrom && _activeFrom === (entry.number || '').toString() ? 'checked' : '' %> />
          Use
        </label>
      </div>
      <div class="md:col-span-1 flex md:justify-end">
        <button type="button" class="ws-phone-remove text-[10px] font-black uppercase tracking-widest text-rose-600 hover:underline">Remove</button>
      </div>
      <div class="md:col-span-12 flex flex-wrap gap-x-6 gap-y-1 rounded-lg border border-brand-border/25 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-3 py-2">
        <span class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Inbound</span>
        <span class="text-xs font-bold tabular-nums text-brand-dark dark:text-white" title="Terminal inbound calls counted"><%= Number.isFinite(_inc) ? _inc : 0 %> total</span>
        <span class="text-[10px] text-emerald-700 dark:text-emerald-300 font-semibold tabular-nums"><%= Number.isFinite(_conn) ? _conn : 0 %> connected</span>
        <span class="text-[10px] text-rose-700 dark:text-rose-300 font-semibold tabular-nums"><%= Number.isFinite(_miss) ? _miss : 0 %> missed</span>
        <span class="text-[10px] text-violet-700 dark:text-violet-300 font-semibold tabular-nums"><%= Number.isFinite(_vm) ? _vm : 0 %> voicemail</span>
        <% if (entry.lastInboundAt) { %><span class="text-[10px] text-brand-muted">Last: <%= new Date(entry.lastInboundAt).toLocaleString() %></span><% } %>
      </div>
      <div class="md:col-span-12">
        <label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM notes</label>
        <input type="text" class="ws-phone-cnam-notes w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" value="<%= (entry.cnamNotes || '').toString() %>" placeholder="Carrier ticket / support notes" />
      </div>
    </div>
    <% }); %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" id="wsPhoneBankAdd" class="rounded-xl border border-brand-border dark:border-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white">Add number</button>
    <button type="button" id="wsPhoneBankSubmitCnam" class="text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white underline underline-offset-2">Submit CNAM request</button>
  </div>
  <p id="wsPhoneBankMsg" class="hidden text-sm"></p>
  <button type="button" id="wsPhoneBankSave" class="mt-4 rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save phone bank</button>
</div>
<%- include('../partials/scripts_phones') %>
<% } %>
