<%- include('../partials/scripts_accent') %>
<script>
  (function () {
    var form = document.getElementById('wlForm');
    if (!form) return;
    var fileInput = document.getElementById('wlLogo');
    var fileLabel = document.getElementById('wlLogoLabel');
    var heroInput = document.getElementById('wlHero');
    var heroLabel = document.getElementById('wlHeroLabel');
    var heroPreview = document.getElementById('wlHeroPreview');
    var nameInput = document.getElementById('wlAppName');
    var remove = document.getElementById('wlRemoveLogo');
    var removeHero = document.getElementById('wlRemoveHero');
    var iconImgs = Array.prototype.slice.call(document.querySelectorAll('[data-wl-icon-img]'));
    var namePreviews = Array.prototype.slice.call(document.querySelectorAll('[data-wl-name]'));
    var iconTiles = Array.prototype.slice.call(document.querySelectorAll('[data-wl-icon-tile]'));
    var msg = document.getElementById('wlMsg');
    var save = document.getElementById('wlSave');
    var savedIcon = iconImgs[0] ? iconImgs[0].getAttribute('src') : '';
    var savedHero = heroPreview ? heroPreview.getAttribute('src') : '/images/member-hero-your-business.jpg';
    var defaultHero = '/images/member-hero-your-business.jpg';
    var blobUrl = '';
    var heroBlobUrl = '';
    var defaultIcon = '/images/adhello-app-icon-512.png';

    function say(el, text, ok) {
      if (!el) return;
      el.textContent = text;
      el.className = 'text-sm font-semibold ' + (ok ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
    }

    function setIconSrc(src) {
      iconImgs.forEach(function (img) { img.src = src; });
    }

    function setHeroSrc(src, isCustom) {
      if (!heroPreview) return;
      heroPreview.src = src || defaultHero;
      heroPreview.classList.toggle('opacity-40', !isCustom);
    }

    function setNames(name) {
      namePreviews.forEach(function (el) { el.textContent = name; });
    }

    function syncTileAccent() {
      var accentEl = document.getElementById('wsAccentCustomHex') || document.getElementById('wsAccentCustom');
      var hex = accentEl && accentEl.value ? String(accentEl.value).trim() : '';
      if (!/^#[0-9a-fA-F]{6}$/.test(hex)) return;
      iconTiles.forEach(function (tile) { tile.style.backgroundColor = hex; });
    }

    nameInput.addEventListener('input', function () {
      setNames(nameInput.value.trim() || 'AdHello');
    });
    fileInput.addEventListener('change', function () {
      if (blobUrl) URL.revokeObjectURL(blobUrl);
      var file = fileInput.files && fileInput.files[0];
      blobUrl = file ? URL.createObjectURL(file) : '';
      fileLabel.textContent = file ? file.name : 'Choose a logo';
      setIconSrc(blobUrl || savedIcon);
      if (file && remove) remove.checked = false;
    });
    if (heroInput) {
      heroInput.addEventListener('change', function () {
        if (heroBlobUrl) URL.revokeObjectURL(heroBlobUrl);
        var file = heroInput.files && heroInput.files[0];
        heroBlobUrl = file ? URL.createObjectURL(file) : '';
        if (heroLabel) heroLabel.textContent = file ? file.name : 'Choose a banner photo';
        setHeroSrc(heroBlobUrl || savedHero, !!(heroBlobUrl || (savedHero && savedHero !== defaultHero)));
        if (file && removeHero) removeHero.checked = false;
      });
    }
    if (remove) {
      remove.addEventListener('change', function () {
        setIconSrc(remove.checked ? defaultIcon : (blobUrl || savedIcon));
      });
    }
    if (removeHero) {
      removeHero.addEventListener('change', function () {
        setHeroSrc(removeHero.checked ? defaultHero : (heroBlobUrl || savedHero), !removeHero.checked && !!(heroBlobUrl || (savedHero && savedHero !== defaultHero)));
      });
    }
    document.addEventListener('input', function (e) {
      if (!e.target) return;
      if (e.target.id === 'wsAccentCustom' || e.target.id === 'wsAccentCustomHex') syncTileAccent();
    });
    document.addEventListener('change', function (e) {
      if (e.target && e.target.name === 'wsAccentChoice') syncTileAccent();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      save.disabled = true;
      say(msg, 'Saving…', true);
      fetch('/workspace/white-label', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          save.disabled = false;
          if (!res.ok || !res.d.success) { say(msg, res.d.error || 'Could not save.', false); return; }
          say(msg, 'Saved. Reloading to apply…', true);
          setTimeout(function () { window.location.reload(); }, 700);
        })
        .catch(function () { save.disabled = false; say(msg, 'Could not save. Check your connection.', false); });
    });

    var themeSave = document.getElementById('wlThemeSave');
    var themeMsg = document.getElementById('wlThemeMsg');
    function syncReviewAppThemeLocal(theme) {
      // CRM + Review app share this origin — clear stale light pins so /m/… opens dark.
      try {
        localStorage.removeItem('ma-theme-pinned');
        localStorage.removeItem('ma-theme-pinned-at');
        if (theme === 'light' || theme === 'dark' || theme === 'system') {
          localStorage.setItem('ma-theme', theme);
        }
        if (theme === 'dark') localStorage.setItem('color-theme', 'dark');
        else if (theme === 'light') localStorage.setItem('color-theme', 'light');
      } catch (e) { /* private mode */ }
    }
    // Already-saved White-label light/dark: align Review-app storage on this page load.
    var savedTheme = <%= JSON.stringify(_wlTheme) %>;
    if (savedTheme === 'light' || savedTheme === 'dark') syncReviewAppThemeLocal(savedTheme);
    if (themeSave) {
      themeSave.addEventListener('click', function () {
        var picked = document.querySelector('input[name="wlPreferredTheme"]:checked');
        var theme = picked && picked.value ? picked.value : 'system';
        themeSave.disabled = true;
        say(themeMsg, 'Saving…', true);
        var body = new FormData();
        body.append('preferredTheme', theme);
        fetch('/workspace/white-label', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
          body: body,
        })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            themeSave.disabled = false;
            if (!res.ok || !res.d.success) { say(themeMsg, res.d.error || 'Could not save.', false); return; }
            syncReviewAppThemeLocal(theme);
            say(themeMsg, 'Appearance saved. Reopen or refresh the Review app to see it.', true);
          })
          .catch(function () { themeSave.disabled = false; say(themeMsg, 'Could not save. Check your connection.', false); });
      });
    }
  })();
</script>
<% } %>
