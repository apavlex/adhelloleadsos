<% const _accentChoices = typeof workspaceAccentChoices !== 'undefined' && workspaceAccentChoices ? workspaceAccentChoices : []; %>
<% const _textChoices = typeof workspaceAccentTextChoices !== 'undefined' && workspaceAccentTextChoices ? workspaceAccentTextChoices : [{ key: 'dark', label: 'Dark', hex: '#111827' }, { key: 'white', label: 'White', hex: '#FFFFFF' }]; %>
<% const _accentCur = ((workspace && workspace.accentColor) ? workspace.accentColor : '#CA8A04').toString().toLowerCase(); %>
<%
  const _textSaved = (workspace && workspace.accentTextColor) ? String(workspace.accentTextColor).toLowerCase() : '';
  const _textCur = (typeof workspaceAccentText !== 'undefined' && workspaceAccentText)
    ? String(workspaceAccentText).toLowerCase()
    : (_textSaved || '#111827');
%>
<%
  const _wlCan = typeof canManageWorkspace !== 'undefined' && canManageWorkspace;
  const _wlBrand = typeof whiteLabel !== 'undefined' && whiteLabel ? whiteLabel : { appName: 'AdHello', hasLogo: false, logoUrl: '/images/adhello-app-icon.png', iconUrl: function () { return '/images/adhello-app-icon-512.png'; } };
  const _wlSet = typeof whiteLabelSettings !== 'undefined' && whiteLabelSettings ? whiteLabelSettings : { appName: '', preferredTheme: 'system' };
  const _wlTheme = ['light', 'dark', 'system'].includes(String(_wlSet.preferredTheme || '')) ? String(_wlSet.preferredTheme) : 'system';
  const _wlOpenUrl = typeof appOpenUrl !== 'undefined' ? appOpenUrl : '/today';
  const _wlOpenPath = typeof appOpenPath !== 'undefined' ? appOpenPath : _wlOpenUrl;
  const _wlOpenHost = typeof reviewAppHost !== 'undefined' && reviewAppHost ? reviewAppHost : String(_wlOpenUrl).replace(/^https?:\/\//, '');
  const _wlHeroUrl = typeof reviewHeroUrl !== 'undefined' && reviewHeroUrl ? String(reviewHeroUrl) : '';
  const _wlIconSrc = _wlBrand.hasLogo ? _wlBrand.logoUrl : _wlBrand.iconUrl(512);
  const _wlQrSrc = (typeof reviewAppQrDataUrl !== 'undefined' && reviewAppQrDataUrl)
    ? String(reviewAppQrDataUrl)
    : '/workspace/white-label/qr.png';
%>
<div class="space-y-6">
<section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">Logo &amp; app name</h2>
  <p class="text-sm text-brand-muted mb-5">Shown in the CRM sidebar, the Review app Home badge, the browser tab, and the Home Screen icon. Light logos sit on your accent color so they stay visible.</p>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(240px,280px)] items-start">
    <% if (_wlCan) { %>
    <form id="wlForm" class="space-y-4" enctype="multipart/form-data" novalidate>
      <div>
        <label for="wlAppName" class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">App name</label>
        <input id="wlAppName" name="appName" type="text" maxlength="30" value="<%= _wlSet.appName %>" placeholder="AdHello" class="w-full rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-semibold text-brand-dark dark:text-white" />
        <p class="mt-1 text-[11px] text-brand-muted">Under the icon on a phone, only the first 12 or so characters fit.</p>
      </div>
      <div>
        <p class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Logo</p>
        <label for="wlLogo" class="flex flex-col items-center justify-center gap-1 rounded-2xl border-2 border-dashed border-brand-border/70 dark:border-white/15 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-6 text-center cursor-pointer hover:border-brand-yellow/60 transition-colors">
          <svg class="w-6 h-6 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0-12l-4 4m4-4l4 4"/></svg>
          <span id="wlLogoLabel" class="text-sm font-semibold text-brand-dark dark:text-white">Choose a logo</span>
          <span class="text-[11px] text-brand-muted">Square PNG works best, 512 × 512 or larger. JPEG, WebP or GIF also work, up to 8 MB.</span>
        </label>
        <input id="wlLogo" name="logo" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="sr-only" />
        <% if (_wlBrand.hasLogo) { %>
        <label class="mt-2 inline-flex items-center gap-2 text-[12px] font-semibold text-brand-muted"><input type="checkbox" id="wlRemoveLogo" name="remove_logo" value="on" /> Remove logo and go back to the AdHello icon</label>
        <% } %>
      </div>
      <div>
        <p class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Home banner</p>
        <p class="text-[11px] text-brand-muted mb-2">Big photo on Review app Home — truck, van, storefront, crew. Trucking companies usually use a truck or trailer shot.</p>
        <label for="wlHero" class="relative flex flex-col items-center justify-center gap-1 rounded-2xl border-2 border-dashed border-brand-border/70 dark:border-white/15 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-5 text-center cursor-pointer hover:border-brand-yellow/60 transition-colors overflow-hidden min-h-[140px]">
          <img id="wlHeroPreview" src="<%= _wlHeroUrl || '/images/member-hero-your-business.jpg' %>" alt="" class="absolute inset-0 w-full h-full object-cover<%= _wlHeroUrl ? '' : ' opacity-40' %>" data-wl-hero-img />
          <span class="relative z-10 flex flex-col items-center gap-1 rounded-xl bg-black/45 text-white px-3 py-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            <span id="wlHeroLabel" class="text-sm font-semibold">Choose a banner photo</span>
            <span class="text-[11px] text-white/80">Wide photo works best · JPEG, PNG, WebP or GIF · up to 8 MB</span>
          </span>
        </label>
        <input id="wlHero" name="hero" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="sr-only" />
        <% if (_wlHeroUrl) { %>
        <label class="mt-2 inline-flex items-center gap-2 text-[12px] font-semibold text-brand-muted"><input type="checkbox" id="wlRemoveHero" name="remove_hero" value="on" /> Remove banner and use the default photo</label>
        <% } %>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" id="wlSave" class="rounded-xl bg-brand-yellow px-6 py-3 text-xs font-black uppercase tracking-widest disabled:opacity-50">Save logo, name &amp; banner</button>
        <p id="wlMsg" class="text-sm" role="status"></p>
      </div>
    </form>
    <% } else { %>
    <p class="text-sm text-brand-muted">Only workspace admins can change the logo, name, and banner.</p>
    <% } %>
    <div class="flex flex-col gap-4">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">How it looks on a phone</p>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-[22px] p-3.5 flex flex-col items-center gap-2 shadow-inner" style="background: linear-gradient(165deg, #dbeafe 0%, #e0e7ff 45%, #fce7f3 100%);" data-wl-phone="light">
          <p class="text-[9px] font-black uppercase tracking-widest text-slate-600 self-start">Light</p>
          <div class="grid grid-cols-3 gap-2.5 opacity-50" aria-hidden="true">
            <span class="w-9 h-9 rounded-[20%] bg-white/70"></span><span class="w-9 h-9 rounded-[20%] bg-white/70"></span><span class="w-9 h-9 rounded-[20%] bg-white/70"></span>
          </div>
          <div class="flex flex-col items-center gap-1 mt-1">
            <span class="wl-icon-tile w-14 h-14 rounded-[22%] shadow-md overflow-hidden flex items-center justify-center p-1.5" style="background-color: <%= _accentCur %>" data-wl-icon-tile>
              <img id="wlIconPreviewLight" src="<%= _wlIconSrc %>" alt="" width="56" height="56" class="w-full h-full object-contain" data-wl-icon-img />
            </span>
            <span class="wl-name-preview max-w-[72px] truncate text-[10px] font-semibold text-slate-800" data-wl-name><%= _wlBrand.appName %></span>
          </div>
        </div>
        <div class="rounded-[22px] p-3.5 flex flex-col items-center gap-2 shadow-inner" style="background: linear-gradient(165deg, #0f172a 0%, #1e1b4b 55%, #3b0764 100%);" data-wl-phone="dark">
          <p class="text-[9px] font-black uppercase tracking-widest text-slate-300 self-start">Dark</p>
          <div class="grid grid-cols-3 gap-2.5 opacity-40" aria-hidden="true">
            <span class="w-9 h-9 rounded-[20%] bg-white/20"></span><span class="w-9 h-9 rounded-[20%] bg-white/20"></span><span class="w-9 h-9 rounded-[20%] bg-white/20"></span>
          </div>
          <div class="flex flex-col items-center gap-1 mt-1">
            <span class="wl-icon-tile w-14 h-14 rounded-[22%] shadow-md overflow-hidden flex items-center justify-center p-1.5" style="background-color: <%= _accentCur %>" data-wl-icon-tile>
              <img id="wlIconPreviewDark" src="<%= _wlIconSrc %>" alt="" width="56" height="56" class="w-full h-full object-contain" data-wl-icon-img />
            </span>
            <span class="wl-name-preview max-w-[72px] truncate text-[10px] font-semibold text-white drop-shadow" data-wl-name><%= _wlBrand.appName %></span>
          </div>
        </div>
      </div>
      <p class="text-[11px] text-brand-muted leading-relaxed">Icon tile uses your accent color so pale logos stay readable on both wallpapers.</p>
    </div>
  </div>
</section>

<% if (_wlCan) { %>
<section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">Default appearance</h2>
  <p class="text-sm text-brand-muted mb-5">Sets light or dark for this client’s Review app (and CRM). Choose Dark, then Save appearance — reopen the Review app (or refresh) and it switches. A Profile choice only sticks until you save appearance here again.</p>
  <div class="grid gap-3 sm:grid-cols-3" role="radiogroup" aria-label="Default appearance">
    <%
      const _themeOpts = [
        { id: 'light', label: 'Light', hint: 'Cream canvas, dark text', swatch: '#FAF7ED', ink: '#0f172a' },
        { id: 'dark', label: 'Dark', hint: 'Slate canvas, light text', swatch: '#020617', ink: '#f8fafc' },
        { id: 'system', label: 'System', hint: 'Follow the device setting', swatch: 'linear-gradient(135deg,#FAF7ED 50%,#020617 50%)', ink: '#64748b' },
      ];
      _themeOpts.forEach(function (opt) {
    %>
    <label class="cursor-pointer group">
      <input type="radio" name="wlPreferredTheme" value="<%= opt.id %>" class="sr-only peer" <%= _wlTheme === opt.id ? 'checked' : '' %> />
      <span class="flex flex-col gap-3 rounded-2xl border-2 border-brand-border/50 dark:border-white/10 peer-checked:border-brand-yellow peer-checked:ring-2 peer-checked:ring-brand-yellow/40 bg-white/70 dark:bg-slate-950/40 p-4 transition-colors">
        <span class="h-16 rounded-xl border border-black/5 dark:border-white/10 shadow-inner" style="background: <%= opt.swatch %>"></span>
        <span>
          <span class="block text-sm font-bold text-brand-dark dark:text-white"><%= opt.label %></span>
          <span class="block text-[11px] text-brand-muted mt-0.5"><%= opt.hint %></span>
        </span>
      </span>
    </label>
    <% }); %>
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <button type="button" id="wlThemeSave" class="rounded-xl bg-brand-yellow px-6 py-3 text-xs font-black uppercase tracking-widest disabled:opacity-50">Save appearance</button>
    <p id="wlThemeMsg" class="text-sm" role="status"></p>
  </div>
</section>
<% } %>

<% if (_wlCan) { %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">Colors</h2>
  <p class="text-sm text-brand-muted mb-4">Choose a preset or pick any custom color. Primary buttons, nav highlights, chat, and the workspace chip use this color.</p>
  <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Swatches</p>
  <div class="flex flex-wrap items-center gap-4 mb-6" role="radiogroup" aria-label="Accent color">
    <% _accentChoices.forEach(function (opt) { %>
    <label class="cursor-pointer group">
      <input type="radio" name="wsAccentChoice" value="<%= opt.hex %>" class="sr-only peer" <%= _accentCur === opt.hex.toLowerCase() ? 'checked' : '' %> />
      <span class="flex flex-col items-center gap-2">
        <span class="w-12 h-12 rounded-full border-2 border-transparent peer-checked:border-brand-dark dark:peer-checked:border-white peer-checked:ring-2 peer-checked:ring-brand-yellow/80 shadow-sm shrink-0" style="background-color:<%= opt.hex %>" title="<%= opt.label %>"></span>
        <span class="text-[10px] font-bold text-brand-muted group-hover:text-brand-dark dark:group-hover:text-white"><%= opt.label %></span>
      </span>
    </label>
    <% }); %>
  </div>
  <div class="mb-6 rounded-2xl border border-brand-border/40 dark:border-white/10 p-4 bg-white/70 dark:bg-slate-900/50">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Custom color</p>
    <div class="flex flex-wrap items-center gap-3">
      <input id="wsAccentCustom" type="color" value="<%= _accentCur %>" class="h-11 w-14 rounded-lg border border-brand-border/50 dark:border-white/15 bg-transparent cursor-pointer" aria-label="Pick custom accent color" />
      <input id="wsAccentCustomHex" type="text" value="<%= _accentCur %>" maxlength="7" class="w-28 rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-bold uppercase tracking-wider text-brand-dark dark:text-white" aria-label="Custom accent hex value" />
      <span class="text-[11px] text-brand-muted">Tip: choosing a custom color overrides preset swatches.</span>
    </div>
  </div>
  <div class="mb-6 rounded-2xl border border-brand-border/40 dark:border-white/10 p-4 bg-white/70 dark:bg-slate-900/50">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-2">Button text &amp; icons</p>
    <p class="text-[11px] text-brand-muted mb-3">Applies to <strong>every solid accent button</strong> — Find prospects, Save, chat bubble, active workspace tabs, and other yellow (brand) fills.</p>
    <div class="flex flex-wrap items-center gap-4 mb-4" role="radiogroup" aria-label="Button text and icon color">
      <% _textChoices.forEach(function (opt) { %>
      <label class="cursor-pointer group">
        <input type="radio" name="wsAccentTextChoice" value="<%= opt.hex %>" class="sr-only peer" <%= _textCur === opt.hex.toLowerCase() ? 'checked' : '' %> />
        <span class="flex flex-col items-center gap-2">
          <span class="w-12 h-12 rounded-full border-2 border-transparent peer-checked:border-brand-dark dark:peer-checked:border-white peer-checked:ring-2 peer-checked:ring-brand-yellow/80 shadow-sm shrink-0 flex items-center justify-center" style="background-color:<%= _accentCur %>; color:<%= opt.hex %>" data-ws-text-swatch title="<%= opt.label %>">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
          <span class="text-[10px] font-bold text-brand-muted group-hover:text-brand-dark dark:group-hover:text-white"><%= opt.label %></span>
        </span>
      </label>
      <% }); %>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <input id="wsAccentTextCustom" type="color" value="<%= _textCur %>" class="h-11 w-14 rounded-lg border border-brand-border/50 dark:border-white/15 bg-transparent cursor-pointer" aria-label="Pick custom button text color" />
      <input id="wsAccentTextHex" type="text" value="<%= _textCur %>" maxlength="7" class="w-28 rounded-xl border border-brand-border dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-bold uppercase tracking-wider text-brand-dark dark:text-white" aria-label="Custom button text hex value" />
      <button type="button" id="wsAccentTextAuto" class="rounded-xl border border-brand-border dark:border-white/15 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-muted hover:text-brand-dark dark:hover:text-white hover:border-brand-yellow/50 transition-colors">Auto contrast</button>
    </div>
  </div>
  <div id="wsAccentPreview" class="mb-6 rounded-2xl border border-brand-border/40 dark:border-white/10 p-4 bg-brand-cream/20 dark:bg-slate-800/50" style="--preview-accent: <%= _accentCur %>; --preview-on-accent: <%= _textCur %>">
    <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-3">Live preview</p>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="ws-preview-btn rounded-xl px-4 py-2 text-xs font-black uppercase tracking-widest shadow-sm inline-flex items-center gap-2" style="background: var(--preview-accent); color: var(--preview-on-accent)">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Primary
      </button>
      <span class="ws-preview-badge text-[10px] font-black uppercase tracking-widest px-2 py-1 rounded-lg border" style="border-color: var(--preview-accent); color: var(--preview-accent)">Badge</span>
      <span class="text-sm font-semibold ws-preview-nav" style="color: var(--preview-accent)">Nav highlight</span>
      <span id="wsAccentSelectedHex" class="text-[10px] font-black uppercase tracking-widest text-brand-muted border border-brand-border/40 dark:border-white/10 rounded-lg px-2 py-1"><%= _accentCur %> · <%= _textCur %></span>
    </div>
  </div>
  <p id="wsAccentMsg" class="hidden text-sm mb-3"></p>
  <button type="button" id="wsAccentSave" class="rounded-xl bg-brand-yellow px-6 py-3 text-xs font-black uppercase tracking-widest">Save colors</button>
</div>
<% } %>

<section class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-1">Text the Review app link</h2>
  <p class="text-sm text-brand-muted mb-5">When you sign a client up, text this link. They open the branded Review app right away — no workspace login. Branding above (logo, banner, colors, light/dark) is what they see.</p>
  <div class="grid gap-6 lg:grid-cols-[180px_minmax(0,1fr)] items-start">
    <div class="flex flex-col items-center text-center gap-2">
      <img src="<%= _wlQrSrc %>" alt="QR code that opens the Review app" width="160" height="160" class="w-40 h-40 rounded-2xl border border-brand-border/50 dark:border-white/10 bg-white p-1" decoding="async" onerror="this.onerror=null;this.src='/get-app/qr.png';" />
      <p class="text-[11px] text-brand-muted">Scan with a phone camera, or copy the link for SMS.</p>
      <p class="text-[11px] font-semibold text-brand-dark dark:text-white break-all" id="wlReviewAppHost"><%= _wlOpenHost %></p>
      <button
        type="button"
        class="mt-1 inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-dark/40 dark:border-white/40 bg-transparent text-brand-dark dark:text-white px-5 py-2.5 text-[10px] font-black uppercase tracking-widest hover:border-brand-yellow hover:bg-brand-yellow/15 transition-colors cursor-pointer"
        data-get-app-share="only"
        data-get-app-share-title="<%= _wlBrand.appName %> Review app"
        data-get-app-share-text="Here is a link to view and save your reviews app!"
        data-get-app-share-url="<%= _wlOpenUrl %>"
        data-share-label="Copy / share for SMS"
        title="Copy or share the Review app invite"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 00-2.25 2.25v9a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H15m0-3l-3-3m0 0l-3 3m3-3V15" /></svg>
        <span data-get-app-share-label>Copy / share for SMS</span>
      </button>
      <a href="<%= _wlOpenPath %>" class="inline-flex items-center justify-center rounded-full bg-brand-yellow text-brand-dark no-underline px-5 py-2.5 text-[10px] font-black uppercase tracking-widest">Open Review app</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4 md:col-span-2">
        <p class="font-bold text-brand-dark dark:text-white mb-2">Onboarding tip</p>
        <p class="text-sm text-brand-dark dark:text-slate-200">Paste the link into a welcome SMS right after signup. The short <code class="text-[11px] font-semibold">/a/…</code> URL opens their Review app (Home, reviews, customers) with your white-label branding — they never need CRM / workspace access.</p>
      </div>
      <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4">
        <p class="font-bold text-brand-dark dark:text-white mb-2">iPhone &amp; iPad</p>
        <ol class="list-decimal pl-5 space-y-1.5 text-sm text-brand-dark dark:text-slate-200">
          <li>Open the SMS link in <strong>Safari</strong>.</li>
          <li>Tap <strong>Share</strong> → <strong>Add to Home Screen</strong>.</li>
          <li>Tap <strong>Add</strong>. The icon uses your logo and accent.</li>
        </ol>
      </div>
      <div class="rounded-2xl border border-brand-border/50 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4">
        <p class="font-bold text-brand-dark dark:text-white mb-2">Android</p>
        <ol class="list-decimal pl-5 space-y-1.5 text-sm text-brand-dark dark:text-slate-200">
          <li>Open the SMS link in <strong>Chrome</strong>.</li>
          <li>Tap <strong>⋮</strong> → <strong>Add to Home screen</strong> or <strong>Install app</strong>.</li>
          <li>Tap <strong>Install</strong> or <strong>Add</strong>.</li>
        </ol>
      </div>
      <p class="md:col-span-2 text-[11px] text-brand-muted">Same link lives under <a href="/get-app" class="font-semibold underline decoration-brand-yellow/60 underline-offset-2">Get the app</a>. Changed the logo after install? Remove the old Home Screen icon and add it again.</p>
    </div>
  </div>
</section>
</div>
