<% const _sa = typeof scrapeAdvisor !== 'undefined' && scrapeAdvisor; %>
<% const _admin = typeof canManageWorkspace !== 'undefined' && canManageWorkspace; %>
<%- include('../../partials/chrome_extension_card') %>
<% if (_admin) { %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">API keys &amp; preferences</h2>
  <p class="text-sm text-brand-muted mb-4 leading-relaxed">
    Keys saved here apply to <strong>everyone</strong> in this workspace. Values you set override deployment environment variables for that integration only.
    Use <strong>Test &amp; save</strong> on each card to save your settings and run a live check (Find Leads providers run a sample coffee-shop search). Or use <strong>Save integrations</strong> to save without testing.
  </p>
  <% if (_sa) { %>
  <%- include('../../partials/scrape_cost_advisor') %>
  <% } %>
  <% if (!integrationsReady) { %>
  <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 px-4 py-4 mb-6 text-sm text-amber-950 dark:text-amber-100">
    <p class="font-semibold text-brand-dark dark:text-white mb-1">Integration keys are managed in your deployment environment</p>
    <p class="leading-relaxed">This screen cannot store API keys until your operator enables the workspace integrations secret on the server. Ask them to finish that setup, then return here to connect providers.</p>
  </div>
  <% } %>
  <% if (integrationsReady && integrationsMessage) { %>
    <p class="text-sm mb-4 rounded-xl px-4 py-3 <%= integrationsMessage.type === 'ok' ? 'bg-emerald-500/10 text-emerald-900 dark:text-emerald-200' : 'bg-amber-500/10 text-amber-900 dark:text-amber-100' %>"><%= integrationsMessage.text %></p>
  <% } %>
  <% if (typeof persistenceDeploymentHint !== 'undefined' && persistenceDeploymentHint) { %>
    <div class="mb-4 rounded-xl border px-4 py-3 text-sm leading-relaxed <%= persistenceDeploymentHint.level === 'err' ? 'border-rose-400/50 bg-rose-50 text-rose-950 dark:bg-rose-950/40 dark:text-rose-100' : 'border-amber-400/50 bg-amber-50 text-amber-950 dark:bg-amber-950/40 dark:text-amber-100' %>">
      <p class="font-semibold mb-1">Data persistence</p>
      <p><%= persistenceDeploymentHint.message %></p>
    </div>
  <% } %>
  <% if (typeof persistenceIntegrationsHint !== 'undefined' && persistenceIntegrationsHint) { %>
    <div class="mb-4 rounded-xl border border-rose-400/50 bg-rose-50 dark:bg-rose-950/40 px-4 py-3 text-sm text-rose-950 dark:text-rose-100 leading-relaxed">
      <p class="font-semibold mb-1">Saved API keys unavailable</p>
      <p><%= persistenceIntegrationsHint.message %></p>
    </div>
  <% } %>
  <% if (integrationsReady) { %>
  <% const masks = integrationMasks || {}; %>
  <% const _mapsPrimary = (mapsSearchPrimary || 'auto').toString().toLowerCase(); %>
  <% const _enrichPrimary = (enrichPrimary || 'auto').toString().toLowerCase(); %>
  <% const _mapsProviders = Array.isArray(mapsProviderStatus) ? mapsProviderStatus : []; %>
  <% const _mapsProviderById = {}; _mapsProviders.forEach(function (p) { if (p && p.id) _mapsProviderById[p.id] = p; }); %>
  <form method="post" action="/workspace/integrations" class="space-y-8">
    <div id="integration-find-leads">
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Find Leads — maps search</p>
      <p class="text-sm text-brand-muted mb-4 max-w-2xl leading-relaxed">Connect one or more providers below. In <strong>Auto</strong> mode the app tries them in order until results are returned.</p>

      <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-950/50 p-5 sm:p-6 mb-4">
        <h3 class="font-display font-bold text-base text-brand-dark dark:text-white">Maps provider preference</h3>
        <p class="text-xs text-brand-muted mt-1 mb-3">Which service to use for Find Leads (or Auto to run the chain).</p>
        <div class="flex flex-wrap items-center gap-2 mb-4" role="list" aria-label="Maps search providers">
          <% _mapsProviders.forEach(function (p) { %>
          <span role="listitem">
            <%- include('../../partials/integration_provider_status_pill', { label: p.label, connected: p.configured }) %>
          </span>
          <% }); %>
        </div>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Preference</label>
        <select name="mapsSearchPrimary" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
          <option value="auto" <%= _mapsPrimary === 'auto' || _mapsPrimary === '' ? 'selected' : '' %>>Auto (RapidAPI → SearchAPI.io → SerpAPI → Oxylabs → Outscraper → Monid → Apify)</option>
          <option value="rapidapi" <%= _mapsPrimary === 'rapidapi' ? 'selected' : '' %>>RapidAPI only</option>
          <option value="searchapi" <%= _mapsPrimary === 'searchapi' ? 'selected' : '' %>>SearchAPI.io only</option>
          <option value="serpapi" <%= _mapsPrimary === 'serpapi' ? 'selected' : '' %>>SerpAPI only</option>
          <option value="oxylabs" <%= _mapsPrimary === 'oxylabs' ? 'selected' : '' %>>Oxylabs only</option>
          <option value="outscraper" <%= _mapsPrimary === 'outscraper' ? 'selected' : '' %>>Outscraper only</option>
          <option value="monid" <%= _mapsPrimary === 'monid' ? 'selected' : '' %>>Monid (Google Maps) only</option>
          <option value="apify" <%= _mapsPrimary === 'apify' ? 'selected' : '' %>>Apify only</option>
        </select>
      </section>

      <div class="space-y-4">
        <section id="integration-rapidapi" class="rounded-2xl border-2 border-brand-yellow/25 dark:border-brand-yellow/20 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">RapidAPI — Google Maps</h3>
            <% if (_mapsProviderById.rapidapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.rapidapi.label, connected: _mapsProviderById.rapidapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">Local Business / Google Maps search on RapidAPI. Default first provider in Auto mode. Uses the key below (shared with other RapidAPI products if you use one account).</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.rapidapiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiKey %></p><% } %>
            <input type="password" name="rapidapiKey" autocomplete="off" placeholder="Paste RapidAPI key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiKey_clear" value="1" /> Remove saved key</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Host <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.rapidapiHost) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiHost %></p><% } %>
            <input type="text" name="rapidapiHost" autocomplete="off" placeholder="local-business-data.p.rapidapi.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiHost) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiHost_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Search endpoint URL <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.rapidapiLocalBusinessEndpoint) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiLocalBusinessEndpoint %></p><% } %>
            <input type="text" name="rapidapiLocalBusinessEndpoint" autocomplete="off" placeholder="https://local-business-data.p.rapidapi.com/search" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-xs text-brand-muted mt-2 leading-relaxed">Full URL to the <strong>search</strong> endpoint from your API’s RapidAPI page (not <code class="text-[11px]">review.php</code>). Host header is inferred from this URL if host is empty.</p>
            <% if (masks.rapidapiLocalBusinessEndpoint) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiLocalBusinessEndpoint_clear" value="1" /> Remove</label><% } %>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Query param <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiSearchQueryParam) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiSearchQueryParam %></p><% } %>
              <input type="text" name="rapidapiSearchQueryParam" autocomplete="off" placeholder="query" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.rapidapiSearchQueryParam) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiSearchQueryParam_clear" value="1" /> Remove</label><% } %>
            </div>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Limit param <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiSearchLimitParam) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiSearchLimitParam %></p><% } %>
              <input type="text" name="rapidapiSearchLimitParam" autocomplete="off" placeholder="limit" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.rapidapiSearchLimitParam) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiSearchLimitParam_clear" value="1" /> Remove</label><% } %>
            </div>
          </div>
          <p class="text-xs text-brand-muted leading-relaxed rounded-xl border border-brand-yellow/30 bg-brand-yellow/5 px-3 py-2">
            Need a <strong class="text-brand-dark dark:text-white">second RapidAPI</strong> for website email, phone, and socials?
            Configure it in the card below — do not replace this Maps host/endpoint.
            <a href="#integration-rapidapi-website" class="underline font-semibold text-brand-dark dark:text-brand-yellow ml-1">Jump to website scraper ↓</a>
          </p>
          <%- include('../../partials/integration_test_row', { provider: 'rapidapi' }) %>
        </section>

        <section id="integration-rapidapi-website" class="rounded-2xl border-2 border-brand-yellow/25 dark:border-brand-yellow/20 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow w-full">Second RapidAPI — lead enrichment</p>
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">RapidAPI — Website contacts &amp; socials</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed w-full">Scrapes a lead&apos;s website for email, phone, and social links. Powers the <strong class="text-brand-dark dark:text-white">Enrich Contacts</strong> button in Focus and the company profile sidebar. Leave key blank to reuse your Maps RapidAPI key.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key <span class="font-normal normal-case tracking-normal">(optional — uses Maps key)</span></label>
            <% if (masks.rapidapiWebsiteKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiWebsiteKey %></p><% } %>
            <input type="password" name="rapidapiWebsiteKey" autocomplete="off" placeholder="Dedicated key, or leave blank to use Maps key" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiWebsiteKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiWebsiteKey_clear" value="1" /> Remove saved key</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Host</label>
            <% if (masks.rapidapiWebsiteHost) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiWebsiteHost %></p><% } %>
            <input type="text" name="rapidapiWebsiteHost" autocomplete="off" placeholder="your-api.p.rapidapi.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiWebsiteHost) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiWebsiteHost_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Scrape endpoint URL</label>
            <% if (masks.rapidapiWebsiteEndpoint) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiWebsiteEndpoint %></p><% } %>
            <input type="text" name="rapidapiWebsiteEndpoint" autocomplete="off" placeholder="https://your-api.p.rapidapi.com/scrape" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-xs text-brand-muted mt-2 leading-relaxed">Full URL from your API&apos;s RapidAPI page. Host header is inferred from this URL if host is empty.</p>
            <% if (masks.rapidapiWebsiteEndpoint) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiWebsiteEndpoint_clear" value="1" /> Remove</label><% } %>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">URL param <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiWebsiteUrlParam) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiWebsiteUrlParam %></p><% } %>
              <input type="text" name="rapidapiWebsiteUrlParam" autocomplete="off" placeholder="url or query" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.rapidapiWebsiteUrlParam) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiWebsiteUrlParam_clear" value="1" /> Remove</label><% } %>
            </div>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">HTTP method <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiWebsiteMethod) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiWebsiteMethod %></p><% } %>
              <select name="rapidapiWebsiteMethod" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
                <option value="">GET (default)</option>
                <option value="GET" <%= masks.rapidapiWebsiteMethod === 'GET' ? 'selected' : '' %>>GET</option>
                <option value="POST" <%= masks.rapidapiWebsiteMethod === 'POST' ? 'selected' : '' %>>POST</option>
              </select>
            </div>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'rapidapiWebsite' }) %>
        </section>

        <section id="integration-searchapi" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">SearchAPI.io</h3>
            <% if (_mapsProviderById.searchapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.searchapi.label, connected: _mapsProviderById.searchapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://www.searchapi.io/docs/google-local-api" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Google Local API</a> — optional; runs after RapidAPI in Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.searchapiApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.searchapiApiKey %></p><% } %>
            <input type="password" name="searchapiApiKey" autocomplete="off" placeholder="Paste SearchAPI.io key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.searchapiApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="searchapiApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'searchapi' }) %>
        </section>

        <section id="integration-serpapi" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
            <% if (_mapsProviderById.serpapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.serpapi.label, connected: _mapsProviderById.serpapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://serpapi.com/google-local-api" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Google Local</a> — optional; runs after SearchAPI.io in Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.serpapiApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.serpapiApiKey %></p><% } %>
            <input type="password" name="serpapiApiKey" autocomplete="off" placeholder="Paste SerpAPI key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.serpapiApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="serpapiApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'serpapi' }) %>
        </section>

        <section id="integration-outscraper" class="rounded-2xl border-2 border-brand-yellow/25 dark:border-brand-yellow/20 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Outscraper</h3>
            <% if (_mapsProviderById.outscraper) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.outscraper.label, connected: _mapsProviderById.outscraper.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">Google Maps listings and <strong>review quotes</strong> for Hunt contacts &amp; reviews — also optional fallback in Find Leads Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.outscraperApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiKey %></p><% } %>
            <input type="password" name="outscraperApiKey" autocomplete="off" placeholder="Paste Outscraper key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.outscraperApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API base URL <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.outscraperApiBase) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiBase %></p><% } %>
            <input type="text" name="outscraperApiBase" autocomplete="off" placeholder="https://api.app.outscraper.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.outscraperApiBase) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiBase_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'outscraper' }) %>
        </section>

        <section id="integration-apify" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-28 transition-shadow duration-300">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Apify</h3>
              <p class="text-xs text-brand-muted mt-1 leading-relaxed">Google Maps actor — last fallback in Auto mode when other providers fail or return no rows.</p>
            </div>
            <% if (_mapsProviderById.apify) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.apify.label, connected: _mapsProviderById.apify.configured }) %><% } %>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API token</label>
            <% if (masks.apifyApiToken) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.apifyApiToken %></p><% } %>
            <input type="password" name="apifyApiToken" autocomplete="off" placeholder="Paste Apify token (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.apifyApiToken) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="apifyApiToken_clear" value="1" /> Remove saved token</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'apify' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Oxylabs</h3>
              <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://oxylabs.io/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Web Scraper API</a> — Google Maps leads, mobile home listing search, and real estate URLs. Create an <strong>API User</strong> under Web Scraper API → Users.</p>
            </div>
