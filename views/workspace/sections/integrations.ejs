      <section id="mcp-integration" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-24">
        <header class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">ChatGPT / MCP</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed max-w-2xl">
              Connect ChatGPT or other MCP clients to this workspace’s CRM — list folders and leads, search, read details, and update pipeline fields.
              Generate a workspace access token below, then add the MCP URL in your client with <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">Authorization: Bearer &lt;token&gt;</code>.
            </p>
          </div>
        </header>

        <% const _mcpBase = (typeof publicAppBaseUrl !== 'undefined' && publicAppBaseUrl) ? publicAppBaseUrl : ''; %>
        <% const _mcpEndpoint = (typeof mcpEndpoint !== 'undefined' && mcpEndpoint) ? mcpEndpoint : (_mcpBase ? _mcpBase + '/ceo/mcp' : ''); %>
        <% const _mcpManifest = (typeof mcpManifestUrl !== 'undefined' && mcpManifestUrl) ? mcpManifestUrl : (_mcpBase ? _mcpBase + '/ceo/mcp/manifest.json' : ''); %>
        <% const _mcpStatus = (typeof mcpTokenStatus !== 'undefined' && mcpTokenStatus) ? mcpTokenStatus : { configured: false }; %>

        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Connection URLs</p>
          <div class="space-y-2">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">MCP endpoint</p>
              <div class="flex flex-wrap items-center gap-2">
                <code id="mcpEndpointUrl" class="text-[11px] break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem]"><%= _mcpEndpoint || 'Set BASE_URL on the server to show the full URL' %></code>
                <button type="button" id="copyMcpEndpointUrl" class="shrink-0 rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" <%= _mcpEndpoint ? '' : 'disabled' %>>Copy URL</button>
              </div>
            </div>
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">OpenAI manifest</p>
              <div class="flex flex-wrap items-center gap-2">
                <code id="mcpManifestUrl" class="text-[11px] break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem]"><%= _mcpManifest || 'Set BASE_URL on the server to show the full URL' %></code>
                <button type="button" id="copyMcpManifestUrl" class="shrink-0 rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors" <%= _mcpManifest ? '' : 'disabled' %>>Copy URL</button>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-3">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Access token</p>
          <p id="mcpTokenStatusLine" class="text-xs text-brand-muted leading-relaxed">
            <% if (_mcpStatus.configured) { %>
            Active token ending in <strong class="text-brand-dark dark:text-white"><%= _mcpStatus.hint || '••••' %></strong><% if (_mcpStatus.createdAt) { %> · created <%= new Date(_mcpStatus.createdAt).toLocaleString() %><% } %><% if (_mcpStatus.createdBy) { %> by <%= _mcpStatus.createdBy %><% } %>
            <% } else { %>
            No workspace token yet. Generate one to connect ChatGPT or other MCP clients outside the browser.
            <% } %>
          </p>
          <div id="mcpNewTokenBox" class="hidden rounded-lg border border-emerald-400/40 bg-emerald-50 dark:bg-emerald-950/30 px-3 py-3 space-y-2">
            <p class="text-[10px] font-black uppercase tracking-widest text-emerald-800 dark:text-emerald-200">Copy this token now</p>
            <p class="text-xs text-emerald-950 dark:text-emerald-100 leading-relaxed">It will not be shown again. Paste it as the Bearer token in your MCP client settings.</p>
            <div class="flex flex-wrap items-center gap-2">
              <code id="mcpNewTokenValue" class="text-[11px] break-all rounded-lg bg-white/90 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem] font-mono"></code>
              <button type="button" id="copyMcpNewToken" class="shrink-0 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-emerald-900 dark:text-emerald-200 hover:bg-emerald-500/20 transition-colors">Copy token</button>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <button type="button" id="mcpGenerateTokenBtn" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50"><%= _mcpStatus.configured ? 'Rotate token' : 'Generate token' %></button>
            <button type="button" id="mcpRevokeTokenBtn" class="rounded-xl border border-rose-400/50 bg-rose-500/10 text-rose-900 dark:text-rose-200 px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:bg-rose-500/20 transition-colors disabled:opacity-50" <%= _mcpStatus.configured ? '' : 'disabled' %>>Revoke token</button>
            <p id="mcpTokenMsg" class="text-xs text-brand-muted min-h-[1.25rem] flex-1" aria-live="polite"></p>
          </div>
        </div>

        <div class="text-xs text-brand-muted leading-relaxed space-y-2">
          <p class="font-semibold text-brand-dark dark:text-white">Available tools</p>
          <p><code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">list_folders</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">get_folder</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">count_leads</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">list_leads</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">get_lead</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">update_lead</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">bulk_update_leads</code>, <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">search_leads</code></p>
          <p>Pavlex chat automatically registers this MCP server on every message using your logged-in session — no manual token required for in-app chat.</p>
          <% if (!(typeof openrouterConfigured !== 'undefined' && openrouterConfigured) && !process.env.OPENAI_API_KEY) { %>
          <div class="rounded-lg border border-amber-400/50 bg-amber-50 dark:bg-amber-950/30 px-3 py-2.5 text-xs text-amber-950 dark:text-amber-100 leading-relaxed">
            <strong class="font-bold">No AI key configured.</strong>
            Add an <a href="#openrouter-integration" class="underline font-semibold">OpenRouter key</a> in this form (free at
            <a href="https://openrouter.ai/keys" class="underline" target="_blank" rel="noopener noreferrer">openrouter.ai/keys</a>),
            or set <code class="text-[11px] px-1 rounded bg-white/60 dark:bg-slate-900">OPENAI_API_KEY</code> on the server.
            CRM shortcuts work without AI: “List my folders”, “How many leads do I have?”, “Find Acme Roofing”.
          </div>
          <% } %>
          <p>In ChatGPT: <strong>Settings → Connectors → Add MCP server</strong> — use the MCP endpoint URL and Bearer token above.</p>
        </div>

        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Pavlex MCP diagnostics</p>
          <p class="text-xs text-brand-muted leading-relaxed">Verify Pavlex can reach the CRM MCP server, authenticate as you, and call <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">list_folders</code>.</p>
          <div class="flex flex-wrap gap-2 items-center">
            <button type="button" id="mcpRunDiagnosticsBtn" class="rounded-xl border border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:bg-brand-yellow/20 transition-colors">Run diagnostics</button>
            <a href="/api/debug/mcp" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Open JSON</a>
          </div>
          <pre id="mcpDiagnosticsOutput" class="hidden text-[11px] whitespace-pre-wrap break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 max-h-64 overflow-auto"></pre>
        </div>
      </section>

      <section id="lob-integration" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-24">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Lob — Direct Mail</h3>
            <p class="text-sm text-brand-muted mt-1 max-w-2xl">Postcards via <a href="https://www.lob.com/" target="_blank" rel="noopener noreferrer" class="text-brand-yellow hover:underline">Lob.com</a>. Use a <code class="text-xs bg-brand-cream dark:bg-slate-800 px-1 rounded">test_</code> key for test mode (no postage). Live keys require a payment method on your Lob account.</p>
            <% if (!process.env.KIE_AI_API_KEY && !process.env.KIE_API_KEY) { %>
            <p class="text-xs text-amber-900 dark:text-amber-200 mt-2 leading-relaxed">Marketing Studio image generation needs <code class="text-[11px] px-1 rounded bg-amber-100 dark:bg-amber-900/40">KIE_AI_API_KEY</code> in Render → Environment (from <a href="https://kie.ai/" target="_blank" rel="noopener noreferrer" class="underline font-semibold">kie.ai</a>), then redeploy.</p>
            <% } %>
          </div>
          <div class="flex flex-wrap gap-2 shrink-0">
            <a href="/workspace/integrations/lob-setup" class="rounded-xl border border-brand-border/60 dark:border-white/15 bg-white dark:bg-slate-900 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Design guide</a>
            <a href="/direct-mail" class="rounded-xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors">Open Direct Mail</a>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Secret API key</label>
            <% if (masks.lobApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.lobApiKey %></p><% } %>
            <input type="password" name="lobApiKey" autocomplete="off" placeholder="test_… or live_… (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.lobApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="lobApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Return name</label>
            <% if (masks.lobFromName) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.lobFromName %></p><% } %>
            <input type="text" name="lobFromName" autocomplete="off" placeholder="Your agency name" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">Return street</label>
            <% if (masks.lobFromAddressLine1) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.lobFromAddressLine1 %></p><% } %>
            <input type="text" name="lobFromAddressLine1" autocomplete="off" placeholder="123 Main St" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">City</label>
            <input type="text" name="lobFromCity" autocomplete="off" placeholder="Portland" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">State</label>
            <input type="text" name="lobFromState" autocomplete="off" placeholder="OR" maxlength="2" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm uppercase" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5">ZIP</label>
            <input type="text" name="lobFromZip" autocomplete="off" placeholder="97201" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          </div>
        </div>

        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 p-4 space-y-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white mb-1">Mail designs (PDF)</p>
            <p class="text-xs text-brand-muted leading-relaxed">Upload print-ready PDFs — Agency OS sends them to Lob’s hosting. Postcards need <strong>both</strong> front and back. See the <a href="/workspace/integrations/lob-setup" class="text-brand-yellow hover:underline">design guide</a> for sizes.</p>
          </div>
          <% const _lobDesignSlots = [
            { slot: 'postcard_front', field: 'lobPostcardFrontUrl', label: 'Postcard front (4×6 PDF)' },
            { slot: 'postcard_back', field: 'lobPostcardBackUrl', label: 'Postcard back (4×6 PDF)' },
            { slot: 'letter', field: 'lobLetterPdfUrl', label: 'Letter (8.5×11 PDF)' },
          ]; %>
          <% _lobDesignSlots.forEach(function (d) { %>
          <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-2 items-end border-t border-brand-border/25 dark:border-white/10 pt-3 first:border-0 first:pt-0">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1.5"><%= d.label %></label>
              <% if (masks[d.field]) { %><p class="text-xs text-brand-muted mb-1 truncate" title="<%= masks[d.field] %>">Saved: <%= masks[d.field] %></p><% } %>
              <input type="url" name="<%= d.field %>" autocomplete="off" placeholder="https://… or upload PDF below" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="js-lob-design-upload cursor-pointer inline-flex items-center justify-center rounded-xl border border-brand-yellow/50 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors" data-lob-slot="<%= d.slot %>">
                Upload PDF
                <input type="file" accept="application/pdf,.pdf" class="sr-only js-lob-design-file" data-lob-slot="<%= d.slot %>" />
              </label>
              <p class="js-lob-design-upload-msg text-[10px] text-brand-muted min-h-[1rem]" data-lob-slot="<%= d.slot %>" aria-live="polite"></p>
            </div>
          </div>
          <% }) %>
        </div>

        <%- include('../../partials/integration_test_row', { provider: 'lob' }) %>
      </section>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-brand-border/40 dark:border-white/10">
      <button type="submit" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save integrations</button>
      <button type="button" id="testIntegrationsBtn" class="rounded-xl border border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow px-6 py-3 text-xs font-black uppercase tracking-widest hover:bg-brand-yellow/20">Test &amp; save all</button>
    </div>
    <div id="integrationsTestResult" class="hidden rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-900/40 px-4 py-3 text-sm text-brand-dark dark:text-slate-200"></div>
  </form>
  <% } %>
</div>
<script>
(function () {
  document.querySelectorAll('.js-integration-connect').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      var target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      target.classList.add('ring-2', 'ring-brand-yellow/50', 'shadow-lg');
      window.setTimeout(function () {
        target.classList.remove('ring-2', 'ring-brand-yellow/50', 'shadow-lg');
      }, 2200);
      var focusEl = target.querySelector(
        'input[type="password"], input[type="text"]:not([type="checkbox"]), input[type="email"], input[type="url"], select, textarea'
      );
      if (focusEl) {
        window.setTimeout(function () {
          focusEl.focus({ preventScroll: true });
        }, 450);
      }
    });
  });

  if (window.location.hash) {
    var hashLink = document.querySelector('.js-integration-connect[href="' + window.location.hash + '"]');
    if (hashLink) hashLink.click();
  }

  var form = document.querySelector('form[action="/workspace/integrations"]');
  var testAllBtn = document.getElementById('testIntegrationsBtn');
  var testAllOut = document.getElementById('integrationsTestResult');

  function formBodyObject() {
    if (!form) return {};
    var fd = new FormData(form);
    var body = {};
    fd.forEach(function (value, key) {
      body[key] = value;
    });
    return body;
  }

  function setProviderMsg(provider, text, ok) {
    var el = document.querySelector('.js-integration-test-msg[data-provider="' + provider + '"]');
    if (!el) return;
    el.textContent = text || '';
    el.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    if (!text) return;
    if (ok) el.classList.add('text-emerald-700', 'dark:text-emerald-300');
    else el.classList.add('text-red-700', 'dark:text-red-300');
    if (provider === 'ghl' && ok) refreshGhlConnectionBanner(true, text);
    if (provider === 'ghl' && !ok) refreshGhlConnectionBanner(false, text);
  }

  function refreshGhlConnectionBanner(connected, message) {
    var banner = document.getElementById('ghlConnectionBanner');
    if (!banner) return;
    banner.setAttribute('data-ghl-connected', connected ? '1' : '0');
    banner.setAttribute('data-ghl-configured', '1');
    banner.className = 'rounded-xl border px-4 py-3 flex flex-wrap items-start gap-3 ' +
      (connected
        ? 'border-emerald-500/40 bg-emerald-500/10'
        : 'border-amber-500/40 bg-amber-500/10');
    var dot = banner.querySelector('span[aria-hidden="true"]');
    if (dot) {
      dot.className = 'w-2.5 h-2.5 rounded-full shrink-0 mt-1 ' + (connected ? 'bg-emerald-500' : 'bg-amber-500');
    }
    var body = banner.querySelector('.min-w-0.flex-1');
    if (!body) return;
    if (connected) {
      body.innerHTML =
        '<p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">Connected to Go High Level</p>' +
        '<p class="text-xs text-emerald-800/90 dark:text-emerald-200/90 leading-relaxed">' +
        (message || 'API key and location ID verified.') +
        '</p>';
    } else {
      body.innerHTML =
        '<p class="text-sm font-semibold text-amber-950 dark:text-amber-100">Credentials saved — not verified</p>' +
        '<p class="text-xs text-amber-900/90 dark:text-amber-200/90 leading-relaxed">' +
        (message || 'Check your API key and location ID.') +
        '</p>';
    }
  }

  function verifyGhlConnectionOnLoad() {
    var banner = document.getElementById('ghlConnectionBanner');
    if (!banner || banner.getAttribute('data-ghl-connected') === '1') return;
    if (banner.getAttribute('data-ghl-configured') !== '1') return;
    fetch('/ghl/status?verify=1', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.success) return;
        if (data.connected) refreshGhlConnectionBanner(true, data.connectionMessage);
        else refreshGhlConnectionBanner(false, data.connectionError || 'Connection test failed');
      })
      .catch(function () {});
  }
  verifyGhlConnectionOnLoad();

  document.querySelectorAll('.js-integration-test').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var provider = btn.getAttribute('data-provider');
      if (!provider) return;
      var prev = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      setProviderMsg(provider, 'Saving settings…', true);
      try {
        var res = await fetch('/workspace/integrations/test/' + encodeURIComponent(provider), {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(formBodyObject()),
        });
        var data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error((data && (data.message || data.error)) || 'Test failed');
        }
        setProviderMsg(
          provider,
          '✅ Saved & connected — ' + (data.message || 'OK') + ' (' + (data.elapsedMs || 0) + 'ms)',
          true
        );
      } catch (e) {
        setProviderMsg(provider, '❌ ' + (e && e.message ? e.message : 'Test failed'), false);
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
      }
    });
  });

  if (!testAllBtn || !testAllOut) return;
  testAllBtn.addEventListener('click', async function () {
    var prev = testAllBtn.textContent;
    testAllBtn.disabled = true;
    testAllBtn.textContent = 'Saving…';
    testAllOut.classList.remove('hidden');
    testAllOut.textContent = 'Saving settings and running all provider checks…';
    document.querySelectorAll('.js-integration-test-msg').forEach(function (el) {
      el.textContent = '';
      el.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    });
    try {
      var res = await fetch('/workspace/integrations/test', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(formBodyObject()),
      });
      var data = await res.json();
      if (!res.ok || !data.success) throw new Error((data && data.error) || 'Integration test failed');
      var lines = [];
      lines.push((data.saved ? 'Saved. ' : '') + 'Working APIs: ' + data.okCount + '/' + data.total);
      (data.providers || []).forEach(function (p) {
        var pid = String(p.provider || p.id || '').toLowerCase();
        var line = (p.ok ? '✅ ' : '❌ ') + (p.id || pid) + ' — ' + (p.message || '') + ' (' + (p.elapsedMs || 0) + 'ms)';
        lines.push(line);
        if (pid) setProviderMsg(pid, line, p.ok);
      });
      testAllOut.textContent = lines.join('\n');
      testAllOut.style.whiteSpace = 'pre-line';
    } catch (e) {
      testAllOut.textContent = e && e.message ? e.message : 'Integration test failed';
    } finally {
      testAllBtn.disabled = false;
      testAllBtn.textContent = prev;
    }
  });

  var ghlMsg = document.getElementById('ghlSyncMsg');
  var ghlDirMsg = document.getElementById('ghlDirectionSaveMsg');
  var ghlDirInput = document.getElementById('ghlSyncDirectionInput');
  var ghlSyncNowBtn = document.getElementById('ghlSyncNowBtn');

  function activeGhlDirection() {
    return (ghlDirInput && ghlDirInput.value) || 'both';
  }

  function paintGhlDirectionButtons(direction) {
    document.querySelectorAll('.js-ghl-direction').forEach(function (btn) {
      var on = btn.getAttribute('data-direction') === direction;
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.classList.toggle('border-brand-yellow/50', on);
      btn.classList.toggle('bg-brand-yellow/10', on);
      btn.classList.toggle('text-brand-dark', on);
      btn.classList.toggle('dark:text-brand-yellow', on);
      btn.classList.toggle('border-brand-border/70', !on);
      btn.classList.toggle('dark:border-white/15', !on);
      btn.classList.toggle('bg-brand-cream/50', !on);
      btn.classList.toggle('dark:bg-slate-800', !on);
      btn.classList.toggle('dark:text-white', !on);
    });
  }

  async function saveGhlDirection(direction) {
    var dir = direction || activeGhlDirection();
    if (ghlDirInput) ghlDirInput.value = dir;
    paintGhlDirectionButtons(dir);
    if (ghlDirMsg) {
      ghlDirMsg.textContent = 'Saving…';
      ghlDirMsg.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    }
    try {
      var res = await fetch('/workspace/integrations/ghl-sync-direction', {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ direction: dir }),
      });
      var data = await res.json().catch(function () { return {}; });
      if (!res.ok || !data.success) throw new Error((data && data.error) || 'Could not save');
      if (ghlDirMsg) {
        ghlDirMsg.textContent = 'Saved — future syncs use this direction for this workspace.';
        ghlDirMsg.classList.add('text-emerald-700', 'dark:text-emerald-300');
      }
    } catch (e) {
      if (ghlDirMsg) {
        ghlDirMsg.textContent = '❌ ' + (e && e.message ? e.message : 'Could not save direction');
        ghlDirMsg.classList.add('text-red-700', 'dark:text-red-300');
      }
    }
  }

  document.querySelectorAll('.js-ghl-direction').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var direction = btn.getAttribute('data-direction') || 'both';
      saveGhlDirection(direction);
    });
  });

  async function runGhlSyncNow() {
    var direction = activeGhlDirection();
    if (ghlSyncNowBtn) ghlSyncNowBtn.disabled = true;
    if (ghlMsg) {
      ghlMsg.textContent = 'Syncing…';
      ghlMsg.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    }
    try {
      var res = await fetch('/ghl/sync', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ direction: direction, maxPages: 3, pushLimit: 200 }),
      });
      var data = await res.json();
      if (!res.ok || !data.success) throw new Error((data && data.error) || 'Sync failed');
      var parts = [];
      if (data.pull) {
        var pullNote = data.pull.notesPulled ? ', ' + data.pull.notesPulled + ' notes' : '';
        parts.push('Pull: ' + (data.pull.pulled || 0) + ' (' + (data.pull.created || 0) + ' new, ' + (data.pull.updated || 0) + ' updated' + pullNote + ')');
      }
      if (data.push) {
        var pushNote = '';
        if (data.push.results && data.push.results.length) {
          var np = 0;
          var npl = 0;
          data.push.results.forEach(function (r) { np += r.notesPushed || 0; npl += r.notesPulled || 0; });
          if (np || npl) pushNote = ', notes ' + np + '↑ ' + npl + '↓';
        }
        parts.push('Sync: ' + (data.push.pushed || 0) + '/' + (data.push.total || 0) + pushNote);
      }
      if (ghlMsg) {
        ghlMsg.textContent = '✅ ' + (parts.length ? parts.join(' · ') : 'Done');
        ghlMsg.classList.add('text-emerald-700', 'dark:text-emerald-300');
      }
    } catch (e) {
      if (ghlMsg) {
        ghlMsg.textContent = '❌ ' + (e && e.message ? e.message : 'Sync failed');
        ghlMsg.classList.add('text-red-700', 'dark:text-red-300');
      }
    } finally {
      if (ghlSyncNowBtn) ghlSyncNowBtn.disabled = false;
    }
  }

  if (ghlSyncNowBtn) {
    ghlSyncNowBtn.addEventListener('click', runGhlSyncNow);
  }

  var copyGhlBtn = document.getElementById('copyGhlWebhookUrl');
  if (copyGhlBtn) {
    copyGhlBtn.addEventListener('click', function () {
      var el = document.getElementById('ghlWebhookUrl');
      var text = el ? el.textContent : '';
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          copyGhlBtn.textContent = 'Copied';
          setTimeout(function () { copyGhlBtn.textContent = 'Copy URL'; }, 2000);
        });
      }
    });
  }

  var copyCommsBtn = document.getElementById('copyCommsWebhookUrl');
  if (copyCommsBtn) {
    copyCommsBtn.addEventListener('click', function () {
      var el = document.getElementById('commsWebhookUrl');
      var text = el ? el.textContent : '';
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          copyCommsBtn.textContent = 'Copied';
          setTimeout(function () { copyCommsBtn.textContent = 'Copy URL'; }, 2000);
        });
      }
    });
  }

  function copyTextFromEl(el, btn, defaultLabel) {
    var text = el ? (el.textContent || '').trim() : '';
    if (!text || !navigator.clipboard || !navigator.clipboard.writeText) return;
    navigator.clipboard.writeText(text).then(function () {
      if (btn) {
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = defaultLabel || 'Copy'; }, 2000);
      }
    });
  }

  var copyMcpEndpointBtn = document.getElementById('copyMcpEndpointUrl');
  if (copyMcpEndpointBtn) {
    copyMcpEndpointBtn.addEventListener('click', function () {
      copyTextFromEl(document.getElementById('mcpEndpointUrl'), copyMcpEndpointBtn, 'Copy URL');
    });
  }

  var copyMcpManifestBtn = document.getElementById('copyMcpManifestUrl');
  if (copyMcpManifestBtn) {
    copyMcpManifestBtn.addEventListener('click', function () {
      copyTextFromEl(document.getElementById('mcpManifestUrl'), copyMcpManifestBtn, 'Copy URL');
    });
  }

  var mcpGenerateBtn = document.getElementById('mcpGenerateTokenBtn');
  var mcpRevokeBtn = document.getElementById('mcpRevokeTokenBtn');
  var mcpTokenMsg = document.getElementById('mcpTokenMsg');
  var mcpTokenStatusLine = document.getElementById('mcpTokenStatusLine');
  var mcpNewTokenBox = document.getElementById('mcpNewTokenBox');
  var mcpNewTokenValue = document.getElementById('mcpNewTokenValue');
  var copyMcpNewTokenBtn = document.getElementById('copyMcpNewToken');

  function setMcpTokenUi(status) {
    var configured = status && status.configured;
    if (mcpRevokeBtn) mcpRevokeBtn.disabled = !configured;
    if (mcpGenerateBtn) {
      mcpGenerateBtn.textContent = configured ? 'Rotate token' : 'Generate token';
    }
    if (mcpTokenStatusLine) {
      if (configured) {
        var parts = ['Active token ending in <strong class="text-brand-dark dark:text-white">' + (status.hint || '••••') + '</strong>'];
        if (status.createdAt) {
          try {
            parts.push(' · created ' + new Date(status.createdAt).toLocaleString());
          } catch (e) {}
        }
        if (status.createdBy) parts.push(' by ' + status.createdBy);
        mcpTokenStatusLine.innerHTML = parts.join('');
      } else {
        mcpTokenStatusLine.textContent = 'No workspace token yet. Generate one to connect ChatGPT or other MCP clients outside the browser.';
      }
    }
  }

  if (copyMcpNewTokenBtn) {
    copyMcpNewTokenBtn.addEventListener('click', function () {
      copyTextFromEl(mcpNewTokenValue, copyMcpNewTokenBtn, 'Copy token');
    });
  }

  if (mcpGenerateBtn) {
    mcpGenerateBtn.addEventListener('click', async function () {
      if (mcpTokenMsg) {
        mcpTokenMsg.textContent = '';
        mcpTokenMsg.className = 'text-xs text-brand-muted min-h-[1.25rem] flex-1';
      }
      if (mcpNewTokenBox) mcpNewTokenBox.classList.add('hidden');
      mcpGenerateBtn.disabled = true;
      try {
        var res = await fetch('/workspace/integrations/mcp/token', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error((data && data.error) || 'Could not generate token');
        if (mcpNewTokenValue && data.token) mcpNewTokenValue.textContent = data.token;
        if (mcpNewTokenBox) mcpNewTokenBox.classList.remove('hidden');
        setMcpTokenUi({ configured: true, hint: data.hint, createdAt: data.createdAt });
        if (mcpTokenMsg) {
          mcpTokenMsg.textContent = '✅ Token generated — copy it now.';
          mcpTokenMsg.classList.add('text-emerald-700', 'dark:text-emerald-300');
        }
      } catch (e) {
        if (mcpTokenMsg) {
          mcpTokenMsg.textContent = '❌ ' + (e && e.message ? e.message : 'Token generation failed');
          mcpTokenMsg.classList.add('text-red-700', 'dark:text-red-300');
        }
      } finally {
        mcpGenerateBtn.disabled = false;
      }
    });
  }

  if (mcpRevokeBtn) {
    mcpRevokeBtn.addEventListener('click', async function () {
      if (!window.confirm('Revoke the MCP access token? Connected clients will stop working until you generate a new one.')) return;
      if (mcpTokenMsg) {
        mcpTokenMsg.textContent = '';
        mcpTokenMsg.className = 'text-xs text-brand-muted min-h-[1.25rem] flex-1';
      }
      if (mcpNewTokenBox) mcpNewTokenBox.classList.add('hidden');
      mcpRevokeBtn.disabled = true;
      try {
        var res = await fetch('/workspace/integrations/mcp/token', {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error((data && data.error) || 'Could not revoke token');
        setMcpTokenUi({ configured: false });
        if (mcpTokenMsg) {
          mcpTokenMsg.textContent = '✅ Token revoked.';
          mcpTokenMsg.classList.add('text-emerald-700', 'dark:text-emerald-300');
        }
      } catch (e) {
        if (mcpTokenMsg) {
          mcpTokenMsg.textContent = '❌ ' + (e && e.message ? e.message : 'Revoke failed');
          mcpTokenMsg.classList.add('text-red-700', 'dark:text-red-300');
        }
      } finally {
        if (mcpRevokeBtn) mcpRevokeBtn.disabled = false;
      }
    });
  }

  var mcpDiagBtn = document.getElementById('mcpRunDiagnosticsBtn');
  var mcpDiagOut = document.getElementById('mcpDiagnosticsOutput');
  if (mcpDiagBtn) {
    mcpDiagBtn.addEventListener('click', async function () {
      if (mcpDiagOut) {
        mcpDiagOut.classList.remove('hidden');
        mcpDiagOut.textContent = 'Running diagnostics…';
      }
      mcpDiagBtn.disabled = true;
      try {
        var res = await fetch('/api/debug/mcp', { credentials: 'same-origin' });
        var data = await res.json().catch(function () { return {}; });
        if (mcpDiagOut) {
          mcpDiagOut.textContent = JSON.stringify(data, null, 2);
        }
      } catch (e) {
        if (mcpDiagOut) {
          mcpDiagOut.textContent = 'Diagnostics failed: ' + (e && e.message ? e.message : 'unknown error');
        }
      } finally {
        mcpDiagBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll('.js-lob-design-file').forEach(function (input) {
    input.addEventListener('change', async function () {
      var slot = input.getAttribute('data-lob-slot') || '';
      var msgEl = document.querySelector('.js-lob-design-upload-msg[data-lob-slot="' + slot + '"]');
      var file = input.files && input.files[0];
      if (!file) return;
      if (msgEl) msgEl.textContent = 'Uploading…';
      try {
        var fd = new FormData();
        fd.append('file', file);
        fd.append('slot', slot);
        var res = await fetch('/workspace/integrations/lob-designs/upload', {
          method: 'POST',
          credentials: 'same-origin',
          body: fd,
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error((data && data.error) || 'Upload failed');
        var fieldName =
          slot === 'postcard_front'
            ? 'lobPostcardFrontUrl'
            : slot === 'postcard_back'
              ? 'lobPostcardBackUrl'
              : 'lobLetterPdfUrl';
        var urlInput = form && form.querySelector('[name="' + fieldName + '"]');
        if (urlInput) urlInput.value = data.url || '';
        if (msgEl) {
          msgEl.textContent = '✓ Uploaded to Lob';
          msgEl.classList.add('text-emerald-700', 'dark:text-emerald-300');
        }
      } catch (e) {
        if (msgEl) {
          msgEl.textContent = e && e.message ? e.message : 'Upload failed';
          msgEl.classList.add('text-red-700', 'dark:text-red-300');
        }
      } finally {
        input.value = '';
      }
    });
  });
})();
</script>
<% } else if (_sa) { %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 md:p-8 mb-8">
  <p class="text-sm text-brand-muted leading-relaxed max-w-2xl mb-6">
    API keys and sensitive credentials can only be edited by <strong>workspace owners and admins</strong>. The stack guide below is visible to everyone in this workspace.
  </p>
  <%- include('../../partials/scrape_cost_advisor') %>
</div>
<% } %>
