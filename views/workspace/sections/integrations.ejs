          <div class="flex flex-wrap gap-2 shrink-0">
          <a href="/workspace/integrations/ghl-setup" class="shrink-0 rounded-xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors">
