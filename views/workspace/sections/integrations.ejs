            <input type="text" name="ghlLocationId" autocomplete="off" placeholder="Sub-account location ID" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.ghlLocationId) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlLocationId_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Agency company ID</label>
            <% if (masks.ghlCompanyId) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlCompanyId %></p><% } %>
            <input type="text" name="ghlCompanyId" autocomplete="off" placeholder="GHL agency company ID" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Required to create client sub-accounts from the pipeline floater. Ask GHL support for your agency ID if it is not in Agency Settings.</p>
            <% if (masks.ghlCompanyId) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlCompanyId_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Snapshot ID (optional)</label>
            <% if (masks.ghlSnapshotId) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlSnapshotId %></p><% } %>
            <input type="text" name="ghlSnapshotId" autocomplete="off" placeholder="Snapshot applied to new sub-accounts" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Leave blank for an empty sub-account. Use a snapshot ID to clone your client template.</p>
            <% if (masks.ghlSnapshotId) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlSnapshotId_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Outbound email from</label>
            <% if (masks.ghlEmailFrom) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlEmailFrom %></p><% } %>
            <input type="email" name="ghlEmailFrom" autocomplete="off" placeholder="hello@yourdomain.com (verified in GHL)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Required to send email from Agency OS. Use a verified sender in your GHL sub-account.</p>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">SMS from number (optional)</label>
            <% if (masks.ghlSmsFromNumber) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlSmsFromNumber %></p><% } %>
            <input type="text" name="ghlSmsFromNumber" autocomplete="off" placeholder="+15551234567" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Leave blank to use your GHL location default. E.164 format recommended.</p>
          </div>
        </div>
        <%- include('../../partials/integration_test_row', { provider: 'ghl' }) %>
        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Inbound webhook (GHL → Agency OS)</p>
          <p class="text-xs text-brand-muted leading-relaxed">In GHL, subscribe to <strong>InboundMessage</strong>, <strong>OutboundMessage</strong>, <strong>ContactCreate</strong>, and <strong>ContactUpdate</strong> (plus <strong>EmailOpened</strong> / <strong>LinkClicked</strong> if available) and point the webhook URL below at this workspace. SMS/email replies sync into the Engagement inbox and lead activity when the location ID matches.</p>
          <% const _ghlHookBase = (typeof publicAppBaseUrl !== 'undefined' && publicAppBaseUrl) ? publicAppBaseUrl : ''; %>
          <% const _ghlHasSavedToken = !!masks.ghlWebhookSecret; %>
          <% const _ghlHasServerToken = (typeof ghlWebhookTokenHint !== 'undefined' && ghlWebhookTokenHint); %>
          <div class="flex flex-wrap items-center gap-2">
            <% if (_ghlHasSavedToken || _ghlHasServerToken) { %>
            <code id="ghlWebhookUrl" class="text-[11px] break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem]"><%= _ghlHookBase %>/api/webhooks/ghl?token=<% if (_ghlHasSavedToken) { %>••••••••<% } else { %>configured-on-server<% } %></code>
            <button type="button" id="copyGhlWebhookUrl" class="shrink-0 rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Copy URL</button>
            <% } else { %>
            <p class="text-xs text-brand-muted">Save a webhook token below (or set <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">GHL_WEBHOOK_SECRET</code> on the server) to reveal the full URL.</p>
            <% } %>
          </div>
          <div class="pt-1">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Webhook token (optional per-workspace)</label>
            <% if (masks.ghlWebhookSecret) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlWebhookSecret %></p><% } %>
            <input type="password" name="ghlWebhookSecret" autocomplete="off" placeholder="Leave blank to use server GHL_WEBHOOK_SECRET" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.ghlWebhookSecret) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlWebhookSecret_clear" value="1" /> Remove</label><% } %>
          </div>
        </div>
        <div class="pt-2 border-t border-brand-border/30 dark:border-white/10 space-y-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Default sync direction</p>
            <p class="text-xs text-brand-muted leading-relaxed mb-2">Saved for this workspace. Manual <strong class="text-brand-dark dark:text-white">Sync GHL</strong> on a lead still pushes when you click it; this controls bulk sync and automatic tag/SMS/email sync.</p>
            <input type="hidden" name="ghlSyncDirection" id="ghlSyncDirectionInput" value="<%= typeof ghlSyncDirection !== 'undefined' ? ghlSyncDirection : 'both' %>" />
            <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="GHL sync direction" id="ghlSyncDirectionGroup">
              <% const _ghlDir = typeof ghlSyncDirection !== 'undefined' ? ghlSyncDirection : 'both'; %>
              <button type="button" class="js-ghl-direction rounded-xl border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors disabled:opacity-50 <%= _ghlDir === 'pull' ? 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow' : 'border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-dark dark:text-white hover:border-brand-yellow/50' %>" data-direction="pull" aria-pressed="<%= _ghlDir === 'pull' ? 'true' : 'false' %>">Pull from GHL</button>
              <button type="button" class="js-ghl-direction rounded-xl border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors disabled:opacity-50 <%= _ghlDir === 'push' ? 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow' : 'border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-dark dark:text-white hover:border-brand-yellow/50' %>" data-direction="push" aria-pressed="<%= _ghlDir === 'push' ? 'true' : 'false' %>">Sync to GHL</button>
              <button type="button" class="js-ghl-direction rounded-xl border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors disabled:opacity-50 <%= _ghlDir === 'both' ? 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow' : 'border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 text-brand-dark dark:text-white hover:border-brand-yellow/50' %>" data-direction="both" aria-pressed="<%= _ghlDir === 'both' ? 'true' : 'false' %>">Sync both ways</button>
            </div>
            <p id="ghlDirectionSaveMsg" class="text-[11px] text-brand-muted mt-2 min-h-[1rem]" aria-live="polite"></p>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <button type="button" id="ghlSyncNowBtn" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50">Sync now</button>
            <p id="ghlSyncMsg" class="text-xs text-brand-muted min-h-[1.25rem] flex-1" aria-live="polite"></p>
          </div>
        </div>
      </section>

      <section id="comms-integration" class="rounded-2xl border-2 border-brand-yellow/30 dark:border-brand-yellow/25 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-24 mb-4">
        <header class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Comms by Osis</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed max-w-2xl">
              Send and receive <strong>iMessage</strong> and <strong>SMS</strong> through your dedicated line via
              <a href="https://comms.osis.co/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Comms</a>.
              Create a Messages API key at
              <a href="https://comms.osis.co/dashboard/settings/api-keys" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">comms.osis.co → Settings → API keys</a>
              with <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">comms_send</code> and
              <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">comms_read</code> scopes.
            </p>
          </div>
          <a href="https://docs.osis.co/messages-api/overview" class="shrink-0 rounded-xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors" target="_blank" rel="noopener noreferrer">
            API docs →
          </a>
        </header>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Messages API key</label>
            <% if (masks.commsApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.commsApiKey %></p><% } %>
            <input type="password" name="commsApiKey" autocomplete="off" placeholder="osis_… (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.commsApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="commsApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Default channel</label>
            <% const _commsChannel = (typeof commsDefaultChannel !== 'undefined' && commsDefaultChannel) ? commsDefaultChannel : ''; %>
            <select name="commsDefaultChannel" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
              <option value="" <%= !_commsChannel ? 'selected' : '' %>>Auto (Comms picks best channel)</option>
              <option value="imessage" <%= _commsChannel === 'imessage' ? 'selected' : '' %>>iMessage</option>
              <option value="sms" <%= _commsChannel === 'sms' ? 'selected' : '' %>>SMS</option>
            </select>
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Used when sending without an explicit channel. iMessage is tried first when the recipient supports it.</p>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">SMS send preference</label>
            <% const _smsPrimary = (typeof smsPrimary !== 'undefined' && smsPrimary) ? smsPrimary : 'auto'; %>
            <select name="smsPrimary" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
              <option value="auto" <%= _smsPrimary === 'auto' || !_smsPrimary ? 'selected' : '' %>>Auto — GHL → Saperly → Comms → SignalWire</option>
              <option value="saperly" <%= _smsPrimary === 'saperly' ? 'selected' : '' %>>Prefer Saperly</option>
              <option value="comms" <%= _smsPrimary === 'comms' ? 'selected' : '' %>>Prefer Comms (iMessage / SMS)</option>
              <option value="ghl" <%= _smsPrimary === 'ghl' ? 'selected' : '' %>>Prefer Go High Level</option>
            </select>
            <p class="text-[11px] text-brand-muted mt-1.5 leading-relaxed">Controls outreach, cadence text sends, Focus mode, and bulk SMS from the lead panel.</p>
          </div>
        </div>
        <%- include('../../partials/integration_test_row', { provider: 'comms' }) %>
        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Inbound webhook (Comms → Agency OS)</p>
          <p class="text-xs text-brand-muted leading-relaxed">In Comms, add a webhook for <strong>message.received</strong> and point it at the URL below. Use the same token here and in Comms webhook settings.</p>
          <% const _commsHookBase = (typeof publicAppBaseUrl !== 'undefined' && publicAppBaseUrl) ? publicAppBaseUrl : ''; %>
          <% const _commsHasSavedToken = !!masks.commsWebhookSecret; %>
          <% const _commsHasServerToken = (typeof commsWebhookTokenHint !== 'undefined' && commsWebhookTokenHint); %>
          <div class="flex flex-wrap items-center gap-2">
            <% if (_commsHasSavedToken || _commsHasServerToken) { %>
            <code id="commsWebhookUrl" class="text-[11px] break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem]"><%= _commsHookBase %>/api/webhooks/comms?token=<% if (_commsHasSavedToken) { %>••••••••<% } else { %>configured-on-server<% } %></code>
            <button type="button" id="copyCommsWebhookUrl" class="shrink-0 rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Copy URL</button>
            <% } else { %>
            <p class="text-xs text-brand-muted">Save a webhook token below (or set <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">COMMS_WEBHOOK_SECRET</code> on the server) to reveal the full URL.</p>
            <% } %>
          </div>
          <div class="pt-1">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Webhook token (optional per-workspace)</label>
            <% if (masks.commsWebhookSecret) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.commsWebhookSecret %></p><% } %>
            <input type="password" name="commsWebhookSecret" autocomplete="off" placeholder="Leave blank to use server COMMS_WEBHOOK_SECRET" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.commsWebhookSecret) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="commsWebhookSecret_clear" value="1" /> Remove</label><% } %>
          </div>
        </div>
      </section>

      <section id="saperly-integration" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-24 mb-4">
        <header class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Saperly</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed max-w-2xl">
              Send SMS from the pipeline, bulk bar, Focus mode, and cadence through
              <a href="https://saperly.com/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Saperly</a>
