            <input type="password" name="saperlyApiKey" autocomplete="off" placeholder="sap_sk_live_… (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.saperlyApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="saperlyApiKey_clear" value="1" /> Remove</label><% } %>
