<% const _sa = typeof scrapeAdvisor !== 'undefined' && scrapeAdvisor; %>
<% const _admin = typeof canManageWorkspace !== 'undefined' && canManageWorkspace; %>
<% if (_admin) { %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-8">
  <h2 class="font-bold text-lg text-brand-dark dark:text-white mb-2">API keys &amp; preferences</h2>
  <p class="text-sm text-brand-muted mb-4 leading-relaxed">
    Keys saved here apply to <strong>everyone</strong> in this workspace. Values you set override deployment environment variables for that integration only.
    Use <strong>Test &amp; save</strong> on each card to save your settings and run a live check (Find Leads providers run a sample coffee-shop search). Or use <strong>Save integrations</strong> to save without testing.
  </p>
  <% if (!integrationsReady) { %>
  <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 px-4 py-4 mb-6 text-sm text-amber-950 dark:text-amber-100">
    <p class="font-semibold text-brand-dark dark:text-white mb-1">Integration keys are managed in your deployment environment</p>
    <p class="leading-relaxed">This screen cannot store API keys until your operator enables the workspace integrations secret on the server. Ask them to finish that setup, then return here to connect providers.</p>
  </div>
  <% } %>
  <% if (integrationsReady && integrationsMessage) { %>
    <p class="text-sm mb-4 rounded-xl px-4 py-3 <%= integrationsMessage.type === 'ok' ? 'bg-emerald-500/10 text-emerald-900 dark:text-emerald-200' : 'bg-amber-500/10 text-amber-900 dark:text-amber-100' %>"><%= integrationsMessage.text %></p>
  <% } %>
  <% if (typeof persistenceDeploymentHint !== 'undefined' && persistenceDeploymentHint) { %>
    <div class="mb-4 rounded-xl border px-4 py-3 text-sm leading-relaxed <%= persistenceDeploymentHint.level === 'err' ? 'border-rose-400/50 bg-rose-50 text-rose-950 dark:bg-rose-950/40 dark:text-rose-100' : 'border-amber-400/50 bg-amber-50 text-amber-950 dark:bg-amber-950/40 dark:text-amber-100' %>">
      <p class="font-semibold mb-1">Data persistence</p>
      <p><%= persistenceDeploymentHint.message %></p>
    </div>
  <% } %>
  <% if (typeof persistenceIntegrationsHint !== 'undefined' && persistenceIntegrationsHint) { %>
    <div class="mb-4 rounded-xl border border-rose-400/50 bg-rose-50 dark:bg-rose-950/40 px-4 py-3 text-sm text-rose-950 dark:text-rose-100 leading-relaxed">
      <p class="font-semibold mb-1">Saved API keys unavailable</p>
      <p><%= persistenceIntegrationsHint.message %></p>
    </div>
  <% } %>
  <% if (integrationsReady) { %>
  <% const masks = integrationMasks || {}; %>
  <% const _mapsPrimary = (mapsSearchPrimary || 'auto').toString().toLowerCase(); %>
  <% const _enrichPrimary = (enrichPrimary || 'auto').toString().toLowerCase(); %>
  <% const _mapsProviders = Array.isArray(mapsProviderStatus) ? mapsProviderStatus : []; %>
  <% const _mapsProviderById = {}; _mapsProviders.forEach(function (p) { if (p && p.id) _mapsProviderById[p.id] = p; }); %>
  <form method="post" action="/workspace/integrations" class="space-y-8">
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Find Leads — maps search</p>
      <p class="text-sm text-brand-muted mb-4 max-w-2xl leading-relaxed">Connect one or more providers below. In <strong>Auto</strong> mode the app tries them in order until results are returned.</p>

      <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-950/50 p-5 sm:p-6 mb-4">
        <h3 class="font-display font-bold text-base text-brand-dark dark:text-white">Maps provider preference</h3>
        <p class="text-xs text-brand-muted mt-1 mb-3">Which service to use for Find Leads (or Auto to run the chain).</p>
        <div class="flex flex-wrap items-center gap-2 mb-4" role="list" aria-label="Maps search providers">
          <% _mapsProviders.forEach(function (p) { %>
          <span role="listitem">
            <%- include('../../partials/integration_provider_status_pill', { label: p.label, connected: p.configured }) %>
          </span>
          <% }); %>
        </div>
        <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Preference</label>
        <select name="mapsSearchPrimary" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
          <option value="auto" <%= _mapsPrimary === 'auto' || _mapsPrimary === '' ? 'selected' : '' %>>Auto (RapidAPI → SearchAPI.io → SerpAPI → Outscraper → Apify)</option>
          <option value="rapidapi" <%= _mapsPrimary === 'rapidapi' ? 'selected' : '' %>>RapidAPI only</option>
          <option value="searchapi" <%= _mapsPrimary === 'searchapi' ? 'selected' : '' %>>SearchAPI.io only</option>
          <option value="serpapi" <%= _mapsPrimary === 'serpapi' ? 'selected' : '' %>>SerpAPI only</option>
          <option value="outscraper" <%= _mapsPrimary === 'outscraper' ? 'selected' : '' %>>Outscraper only</option>
          <option value="apify" <%= _mapsPrimary === 'apify' ? 'selected' : '' %>>Apify only</option>
        </select>
      </section>

      <div class="space-y-4">
        <section class="rounded-2xl border-2 border-brand-yellow/25 dark:border-brand-yellow/20 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">RapidAPI</h3>
            <% if (_mapsProviderById.rapidapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.rapidapi.label, connected: _mapsProviderById.rapidapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">Local Business / Google Maps search on RapidAPI. Default first provider in Auto mode. Subscribe on <a href="https://rapidapi.com/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">rapidapi.com</a>.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.rapidapiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiKey %></p><% } %>
            <input type="password" name="rapidapiKey" autocomplete="off" placeholder="Paste RapidAPI key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiKey_clear" value="1" /> Remove saved key</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Host <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.rapidapiHost) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiHost %></p><% } %>
            <input type="text" name="rapidapiHost" autocomplete="off" placeholder="local-business-data.p.rapidapi.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.rapidapiHost) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiHost_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Search endpoint URL <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.rapidapiLocalBusinessEndpoint) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiLocalBusinessEndpoint %></p><% } %>
            <input type="text" name="rapidapiLocalBusinessEndpoint" autocomplete="off" placeholder="https://local-business-data.p.rapidapi.com/search" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <p class="text-xs text-brand-muted mt-2 leading-relaxed">Full URL to the <strong>search</strong> endpoint from your API’s RapidAPI page (not <code class="text-[11px]">review.php</code>). Host header is inferred from this URL if host is empty.</p>
            <% if (masks.rapidapiLocalBusinessEndpoint) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiLocalBusinessEndpoint_clear" value="1" /> Remove</label><% } %>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Query param <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiSearchQueryParam) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiSearchQueryParam %></p><% } %>
              <input type="text" name="rapidapiSearchQueryParam" autocomplete="off" placeholder="query" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.rapidapiSearchQueryParam) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiSearchQueryParam_clear" value="1" /> Remove</label><% } %>
            </div>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Limit param <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.rapidapiSearchLimitParam) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.rapidapiSearchLimitParam %></p><% } %>
              <input type="text" name="rapidapiSearchLimitParam" autocomplete="off" placeholder="limit" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.rapidapiSearchLimitParam) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="rapidapiSearchLimitParam_clear" value="1" /> Remove</label><% } %>
            </div>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'rapidapi' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">SearchAPI.io</h3>
            <% if (_mapsProviderById.searchapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.searchapi.label, connected: _mapsProviderById.searchapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://www.searchapi.io/docs/google-local-api" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Google Local API</a> — optional; runs after RapidAPI in Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.searchapiApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.searchapiApiKey %></p><% } %>
            <input type="password" name="searchapiApiKey" autocomplete="off" placeholder="Paste SearchAPI.io key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.searchapiApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="searchapiApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'searchapi' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">SerpAPI</h3>
            <% if (_mapsProviderById.serpapi) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.serpapi.label, connected: _mapsProviderById.serpapi.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://serpapi.com/google-local-api" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">Google Local</a> — optional; runs after SearchAPI.io in Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.serpapiApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.serpapiApiKey %></p><% } %>
            <input type="password" name="serpapiApiKey" autocomplete="off" placeholder="Paste SerpAPI key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.serpapiApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="serpapiApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'serpapi' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Outscraper</h3>
            <% if (_mapsProviderById.outscraper) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.outscraper.label, connected: _mapsProviderById.outscraper.configured }) %><% } %>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">Google Maps listings via Outscraper — optional fallback in Auto mode.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.outscraperApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiKey %></p><% } %>
            <input type="password" name="outscraperApiKey" autocomplete="off" placeholder="Paste Outscraper key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.outscraperApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API base URL <span class="font-normal normal-case tracking-normal">(optional)</span></label>
            <% if (masks.outscraperApiBase) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.outscraperApiBase %></p><% } %>
            <input type="text" name="outscraperApiBase" autocomplete="off" placeholder="https://api.app.outscraper.com" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.outscraperApiBase) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="outscraperApiBase_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'outscraper' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Apify</h3>
              <p class="text-xs text-brand-muted mt-1 leading-relaxed">Google Maps actor — last fallback in Auto mode when other providers fail or return no rows.</p>
            </div>
            <% if (_mapsProviderById.apify) { %><%- include('../../partials/integration_provider_status_pill', { label: _mapsProviderById.apify.label, connected: _mapsProviderById.apify.configured }) %><% } %>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API token</label>
            <% if (masks.apifyApiToken) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.apifyApiToken %></p><% } %>
            <input type="password" name="apifyApiToken" autocomplete="off" placeholder="Paste Apify token (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.apifyApiToken) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="apifyApiToken_clear" value="1" /> Remove saved token</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'apify' }) %>
        </section>
      </div>
    </div>

    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Enrich &amp; contact data</p>
      <div class="space-y-4">
        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
          <header>
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">BetterContact</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://bettercontact.rocks/" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">BetterContact</a> — <strong>Hunt for more contact data</strong> (verified email and mobile).</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
            <% if (masks.bettercontactApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.bettercontactApiKey %></p><% } %>
            <input type="password" name="bettercontactApiKey" autocomplete="off" placeholder="Paste BetterContact key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.bettercontactApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="bettercontactApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <%- include('../../partials/integration_test_row', { provider: 'bettercontact' }) %>
        </section>

        <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-brand-cream/25 dark:bg-slate-950/50 p-5 sm:p-6 space-y-4">
          <header>
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Website enhance</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">Firecrawl and/or Crawl4AI for Enhance jobs on lead websites.</p>
          </header>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Enhance provider preference</label>
            <select name="enrichPrimary" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm">
              <option value="auto" <%= _enrichPrimary === 'auto' || _enrichPrimary === '' ? 'selected' : '' %>>Auto (current defaults / env flags)</option>
              <option value="firecrawl_only" <%= _enrichPrimary === 'firecrawl_only' ? 'selected' : '' %>>Firecrawl only</option>
              <option value="crawl4ai_first" <%= _enrichPrimary === 'crawl4ai_first' ? 'selected' : '' %>>Crawl4AI first, then Firecrawl fallback</option>
            </select>
          </div>
          <div class="pt-2 border-t border-brand-border/40 dark:border-white/10 space-y-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Firecrawl</p>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
              <% if (masks.firecrawlApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.firecrawlApiKey %></p><% } %>
              <input type="password" name="firecrawlApiKey" autocomplete="off" placeholder="Paste Firecrawl key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.firecrawlApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="firecrawlApiKey_clear" value="1" /> Remove</label><% } %>
            </div>
            <%- include('../../partials/integration_test_row', { provider: 'firecrawl' }) %>
          </div>
          <div class="pt-2 border-t border-brand-border/40 dark:border-white/10 space-y-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Crawl4AI (self-hosted)</p>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Base URL</label>
              <% if (masks.crawl4aiBaseUrl) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.crawl4aiBaseUrl %></p><% } %>
              <input type="text" name="crawl4aiBaseUrl" autocomplete="off" placeholder="http://localhost:11235" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.crawl4aiBaseUrl) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="crawl4aiBaseUrl_clear" value="1" /> Remove</label><% } %>
            </div>
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API token <span class="font-normal normal-case tracking-normal">(optional)</span></label>
              <% if (masks.crawl4aiApiToken) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.crawl4aiApiToken %></p><% } %>
              <input type="password" name="crawl4aiApiToken" autocomplete="off" placeholder="Bearer token if required" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
              <% if (masks.crawl4aiApiToken) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="crawl4aiApiToken_clear" value="1" /> Remove</label><% } %>
            </div>
            <%- include('../../partials/integration_test_row', { provider: 'crawl4ai' }) %>
          </div>
        </section>
      </div>
    </div>

    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">Audits</p>
      <section class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4">
        <header>
          <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Google PageSpeed Insights</h3>
          <p class="text-xs text-brand-muted mt-1 leading-relaxed"><a href="https://developers.google.com/speed/docs/insights/v5/get-started" class="underline hover:text-brand-dark dark:hover:text-white" target="_blank" rel="noopener noreferrer">PageSpeed Insights API</a> — powers <strong>Run Lighthouse audit</strong> on the lead Insights tab. Often the same Google Cloud key as Maps.</p>
        </header>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">API key</label>
          <% if (masks.pagespeedApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.pagespeedApiKey %></p><% } %>
          <input type="password" name="pagespeedApiKey" autocomplete="off" placeholder="Google Cloud API key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
          <% if (masks.pagespeedApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="pagespeedApiKey_clear" value="1" /> Remove</label><% } %>
        </div>
        <%- include('../../partials/integration_test_row', { provider: 'pagespeed' }) %>
      </section>
      <p class="text-xs text-brand-muted mt-3 leading-relaxed">The interactive map on Find Leads uses <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">GOOGLE_MAPS_API_KEY</code> on the server (Render env), not this form.</p>
    </div>

    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-brand-yellow mb-3">CRM</p>
      <section id="ghl-integration" class="rounded-2xl border border-brand-border/60 dark:border-white/10 bg-white dark:bg-slate-900/60 p-5 sm:p-6 space-y-4 scroll-mt-24">
        <%- include('../../partials/ghl_connection_banner', { ghlStatus: typeof ghlStatus !== 'undefined' ? ghlStatus : {} }) %>
        <header class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-display font-bold text-lg text-brand-dark dark:text-white">Go High Level</h3>
            <p class="text-xs text-brand-muted mt-1 leading-relaxed">
              Push and pull pipeline leads as GHL contacts. Sub-agents use
              <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">POST /autonomous/ghl/push</code> and
              <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">/pull</code>.
            </p>
          </div>
          <a href="/workspace/integrations/ghl-setup" class="shrink-0 rounded-xl border border-brand-yellow/40 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors">
            Setup guide →
          </a>
        </header>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Private integration token</label>
            <% if (masks.ghlApiKey) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlApiKey %></p><% } %>
            <input type="password" name="ghlApiKey" autocomplete="off" placeholder="GHL API key (leave blank to keep)" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.ghlApiKey) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlApiKey_clear" value="1" /> Remove</label><% } %>
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Location ID</label>
            <% if (masks.ghlLocationId) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlLocationId %></p><% } %>
            <input type="text" name="ghlLocationId" autocomplete="off" placeholder="Sub-account location ID" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.ghlLocationId) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlLocationId_clear" value="1" /> Remove</label><% } %>
          </div>
        </div>
        <%- include('../../partials/integration_test_row', { provider: 'ghl' }) %>
        <div class="rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-950/40 px-4 py-3 space-y-2">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted">Inbound webhook (GHL → Agency OS)</p>
          <p class="text-xs text-brand-muted leading-relaxed">In GHL, subscribe to <strong>ContactCreate</strong> and <strong>ContactUpdate</strong> and point the webhook URL below at this workspace. Contacts sync in real time when the location ID matches.</p>
          <% const _ghlHookBase = (typeof publicAppBaseUrl !== 'undefined' && publicAppBaseUrl) ? publicAppBaseUrl : ''; %>
          <% const _ghlHasSavedToken = !!masks.ghlWebhookSecret; %>
          <% const _ghlHasServerToken = (typeof ghlWebhookTokenHint !== 'undefined' && ghlWebhookTokenHint); %>
          <div class="flex flex-wrap items-center gap-2">
            <% if (_ghlHasSavedToken || _ghlHasServerToken) { %>
            <code id="ghlWebhookUrl" class="text-[11px] break-all rounded-lg bg-white/80 dark:bg-slate-900 px-3 py-2 flex-1 min-w-[12rem]"><%= _ghlHookBase %>/api/webhooks/ghl?token=<% if (_ghlHasSavedToken) { %>••••••••<% } else { %>configured-on-server<% } %></code>
            <button type="button" id="copyGhlWebhookUrl" class="shrink-0 rounded-xl border border-brand-border/70 dark:border-white/15 bg-white dark:bg-slate-800 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors">Copy URL</button>
            <% } else { %>
            <p class="text-xs text-brand-muted">Save a webhook token below (or set <code class="text-[11px] px-1 rounded bg-brand-cream/80 dark:bg-slate-800">GHL_WEBHOOK_SECRET</code> on the server) to reveal the full URL.</p>
            <% } %>
          </div>
          <div class="pt-1">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-muted mb-1">Webhook token (optional per-workspace)</label>
            <% if (masks.ghlWebhookSecret) { %><p class="text-xs text-brand-muted mb-1">Saved: <%= masks.ghlWebhookSecret %></p><% } %>
            <input type="password" name="ghlWebhookSecret" autocomplete="off" placeholder="Leave blank to use server GHL_WEBHOOK_SECRET" class="w-full rounded-xl border border-brand-border dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-2 text-sm" />
            <% if (masks.ghlWebhookSecret) { %><label class="inline-flex items-center gap-2 text-xs text-brand-muted mt-2"><input type="checkbox" name="ghlWebhookSecret_clear" value="1" /> Remove</label><% } %>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 pt-2 border-t border-brand-border/30 dark:border-white/10">
          <button type="button" class="js-ghl-sync rounded-xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors disabled:opacity-50" data-direction="pull">Pull from GHL</button>
          <button type="button" class="js-ghl-sync rounded-xl border border-brand-border/70 dark:border-white/15 bg-brand-cream/50 dark:bg-slate-800 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-white hover:border-brand-yellow/50 transition-colors disabled:opacity-50" data-direction="push">Push to GHL</button>
          <button type="button" class="js-ghl-sync rounded-xl border border-brand-yellow/50 bg-brand-yellow/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-brand-dark dark:text-brand-yellow hover:bg-brand-yellow/20 transition-colors disabled:opacity-50" data-direction="both">Sync both ways</button>
          <p id="ghlSyncMsg" class="text-xs text-brand-muted min-h-[1.25rem] flex-1 basis-full sm:basis-auto sm:ml-2" aria-live="polite"></p>
        </div>
      </section>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-brand-border/40 dark:border-white/10">
      <button type="submit" class="rounded-xl bg-brand-dark dark:bg-brand-yellow text-white dark:text-brand-dark px-6 py-3 text-xs font-black uppercase tracking-widest">Save integrations</button>
      <button type="button" id="testIntegrationsBtn" class="rounded-xl border border-brand-yellow/50 bg-brand-yellow/10 text-brand-dark dark:text-brand-yellow px-6 py-3 text-xs font-black uppercase tracking-widest hover:bg-brand-yellow/20">Test &amp; save all</button>
    </div>
    <div id="integrationsTestResult" class="hidden rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/20 dark:bg-slate-900/40 px-4 py-3 text-sm text-brand-dark dark:text-slate-200"></div>
  </form>
  <% } %>
</div>
<script>
(function () {
  var form = document.querySelector('form[action="/workspace/integrations"]');
  var testAllBtn = document.getElementById('testIntegrationsBtn');
  var testAllOut = document.getElementById('integrationsTestResult');

  function formBodyObject() {
    if (!form) return {};
    var fd = new FormData(form);
    var body = {};
    fd.forEach(function (value, key) {
      body[key] = value;
    });
    return body;
  }

  function setProviderMsg(provider, text, ok) {
    var el = document.querySelector('.js-integration-test-msg[data-provider="' + provider + '"]');
    if (!el) return;
    el.textContent = text || '';
    el.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    if (!text) return;
    if (ok) el.classList.add('text-emerald-700', 'dark:text-emerald-300');
    else el.classList.add('text-red-700', 'dark:text-red-300');
    if (provider === 'ghl' && ok) refreshGhlConnectionBanner(true, text);
    if (provider === 'ghl' && !ok) refreshGhlConnectionBanner(false, text);
  }

  function refreshGhlConnectionBanner(connected, message) {
    var banner = document.getElementById('ghlConnectionBanner');
    if (!banner) return;
    banner.setAttribute('data-ghl-connected', connected ? '1' : '0');
    banner.setAttribute('data-ghl-configured', '1');
    banner.className = 'rounded-xl border px-4 py-3 flex flex-wrap items-start gap-3 ' +
      (connected
        ? 'border-emerald-500/40 bg-emerald-500/10'
        : 'border-amber-500/40 bg-amber-500/10');
    var dot = banner.querySelector('span[aria-hidden="true"]');
    if (dot) {
      dot.className = 'w-2.5 h-2.5 rounded-full shrink-0 mt-1 ' + (connected ? 'bg-emerald-500' : 'bg-amber-500');
    }
    var body = banner.querySelector('.min-w-0.flex-1');
    if (!body) return;
    if (connected) {
      body.innerHTML =
        '<p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">Connected to Go High Level</p>' +
        '<p class="text-xs text-emerald-800/90 dark:text-emerald-200/90 leading-relaxed">' +
        (message || 'API key and location ID verified.') +
        '</p>';
    } else {
      body.innerHTML =
        '<p class="text-sm font-semibold text-amber-950 dark:text-amber-100">Credentials saved — not verified</p>' +
        '<p class="text-xs text-amber-900/90 dark:text-amber-200/90 leading-relaxed">' +
        (message || 'Check your API key and location ID.') +
        '</p>';
    }
  }

  function verifyGhlConnectionOnLoad() {
    var banner = document.getElementById('ghlConnectionBanner');
    if (!banner || banner.getAttribute('data-ghl-connected') === '1') return;
    if (banner.getAttribute('data-ghl-configured') !== '1') return;
    fetch('/ghl/status?verify=1', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.success) return;
        if (data.connected) refreshGhlConnectionBanner(true, data.connectionMessage);
        else refreshGhlConnectionBanner(false, data.connectionError || 'Connection test failed');
      })
      .catch(function () {});
  }
  verifyGhlConnectionOnLoad();

  document.querySelectorAll('.js-integration-test').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var provider = btn.getAttribute('data-provider');
      if (!provider) return;
      var prev = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      setProviderMsg(provider, 'Saving settings…', true);
      try {
        var res = await fetch('/workspace/integrations/test/' + encodeURIComponent(provider), {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(formBodyObject()),
        });
        var data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error((data && (data.message || data.error)) || 'Test failed');
        }
        setProviderMsg(
          provider,
          '✅ Saved & connected — ' + (data.message || 'OK') + ' (' + (data.elapsedMs || 0) + 'ms)',
          true
        );
      } catch (e) {
        setProviderMsg(provider, '❌ ' + (e && e.message ? e.message : 'Test failed'), false);
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
      }
    });
  });

  if (!testAllBtn || !testAllOut) return;
  testAllBtn.addEventListener('click', async function () {
    var prev = testAllBtn.textContent;
    testAllBtn.disabled = true;
    testAllBtn.textContent = 'Saving…';
    testAllOut.classList.remove('hidden');
    testAllOut.textContent = 'Saving settings and running all provider checks…';
    document.querySelectorAll('.js-integration-test-msg').forEach(function (el) {
      el.textContent = '';
      el.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-red-700', 'dark:text-red-300');
    });
    try {
      var res = await fetch('/workspace/integrations/test', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(formBodyObject()),
      });
      var data = await res.json();
      if (!res.ok || !data.success) throw new Error((data && data.error) || 'Integration test failed');
      var lines = [];
      lines.push((data.saved ? 'Saved. ' : '') + 'Working APIs: ' + data.okCount + '/' + data.total);
      (data.providers || []).forEach(function (p) {
        var pid = String(p.provider || p.id || '').toLowerCase();
        var line = (p.ok ? '✅ ' : '❌ ') + (p.id || pid) + ' — ' + (p.message || '') + ' (' + (p.elapsedMs || 0) + 'ms)';
        lines.push(line);
        if (pid) setProviderMsg(pid, line, p.ok);
      });
      testAllOut.textContent = lines.join('\n');
      testAllOut.style.whiteSpace = 'pre-line';
    } catch (e) {
      testAllOut.textContent = e && e.message ? e.message : 'Integration test failed';
    } finally {
      testAllBtn.disabled = false;
      testAllBtn.textContent = prev;
    }
  });

  var ghlMsg = document.getElementById('ghlSyncMsg');
  var copyGhlBtn = document.getElementById('copyGhlWebhookUrl');
  if (copyGhlBtn) {
    copyGhlBtn.addEventListener('click', function () {
      var el = document.getElementById('ghlWebhookUrl');
      var text = el ? el.textContent : '';
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          copyGhlBtn.textContent = 'Copied';
          setTimeout(function () { copyGhlBtn.textContent = 'Copy URL'; }, 2000);
        });
      }
    });
  }
  document.querySelectorAll('.js-ghl-sync').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var direction = btn.getAttribute('data-direction') || 'both';
      var prev = btn.textContent;
      btn.disabled = true;
      if (ghlMsg) ghlMsg.textContent = 'Syncing…';
      try {
        var res = await fetch('/ghl/sync', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ direction: direction, maxPages: 3, pushLimit: 200 }),
        });
        var data = await res.json();
        if (!res.ok || !data.success) throw new Error((data && data.error) || 'Sync failed');
        var parts = [];
        if (data.pull) parts.push('Pull: ' + (data.pull.pulled || 0) + ' (' + (data.pull.created || 0) + ' new, ' + (data.pull.updated || 0) + ' updated)');
        if (data.push) parts.push('Push: ' + (data.push.pushed || 0) + '/' + (data.push.total || 0));
        if (ghlMsg) {
          ghlMsg.textContent = '✅ ' + (parts.length ? parts.join(' · ') : 'Done');
          ghlMsg.classList.remove('text-red-700', 'dark:text-red-300');
          ghlMsg.classList.add('text-emerald-700', 'dark:text-emerald-300');
        }
      } catch (e) {
        if (ghlMsg) {
          ghlMsg.textContent = '❌ ' + (e && e.message ? e.message : 'Sync failed');
          ghlMsg.classList.remove('text-emerald-700', 'dark:text-emerald-300');
          ghlMsg.classList.add('text-red-700', 'dark:text-red-300');
        }
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
      }
    });
  });
})();
</script>
<% } else if (_sa) { %>
<div class="rounded-[2rem] border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 p-6 md:p-8 mb-8">
  <p class="text-sm text-brand-muted leading-relaxed max-w-2xl">
    API keys and sensitive credentials can only be edited by <strong>workspace owners and admins</strong>. The <strong>scrape stack</strong> guide below is visible to everyone in this workspace.
  </p>
</div>
<% } %>

<% if (_sa) { %>
<div class="mt-2 md:mt-4">
  <%- include('../../partials/scrape_cost_advisor') %>
</div>
<% } %>
