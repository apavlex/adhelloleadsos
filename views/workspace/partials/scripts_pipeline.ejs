<script>
(function () {
  var btn = document.getElementById('wsPipelineSettingsSave');
  var msg = document.getElementById('wsPipelineSettingsMsg');
  var input = document.getElementById('wsLowReviewsThreshold');
  if (!btn || !input) return;
  btn.addEventListener('click', function () {
    fetch('/workspace/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ lowReviewsThreshold: input.value }),
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (msg) {
          msg.classList.remove('hidden');
          msg.textContent = data && data.success ? 'Saved. Reload the pipeline to refresh tags.' : (data && data.error) || 'Save failed';
          msg.className =
            'text-sm ' +
            (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
        }
      })
      .catch(function () {
        if (msg) {
          msg.classList.remove('hidden');
          msg.textContent = 'Save failed';
          msg.className = 'text-sm text-rose-600';
        }
      });
  });
})();
</script>
