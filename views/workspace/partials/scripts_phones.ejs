<script>
(function () {
  var btn = document.getElementById('wsPhoneBankSave');
  var msg = document.getElementById('wsPhoneBankMsg');
  var list = document.getElementById('wsPhoneBankList');
  var addBtn = document.getElementById('wsPhoneBankAdd');
  var submitBtn = document.getElementById('wsPhoneBankSubmitCnam');
  var agentPhoneInput = document.getElementById('wsAgentPhone');
  var agentWrap = document.getElementById('wsAgentPhoneWrap');
  var perNumberHourCapInput = document.getElementById('wsPerNumberHourCap');
  var quietStartInput = document.getElementById('wsQuietStart');
  var quietEndInput = document.getElementById('wsQuietEnd');
  var dialRetryAutoInput = document.getElementById('wsDialRetryAutoNoAnswer');
  var dialRetryScheduleInput = document.getElementById('wsDialRetrySchedule');
  var dialRetryAtHourInput = document.getElementById('wsDialRetryAtHour');
  var dialRetryHoursWrap = document.getElementById('wsDialRetryHoursWrap');
  var dialRetryDaysWrap = document.getElementById('wsDialRetryDaysWrap');
  var dialRetryDelayHoursInput = document.getElementById('wsDialRetryDelayHours');
  var dialRetryDelayDaysInput = document.getElementById('wsDialRetryDelayDays');
  function syncDialRetryCustomFields() {
    var sched = dialRetryScheduleInput ? String(dialRetryScheduleInput.value || '') : '18h';
    if (dialRetryHoursWrap) dialRetryHoursWrap.classList.toggle('hidden', sched !== 'custom_hours');
    if (dialRetryDaysWrap) dialRetryDaysWrap.classList.toggle('hidden', sched !== 'custom_days');
  }
  function getDialRetryQueueMode() {
    var r = document.querySelector('input[name="wsDialRetryQueueMode"]:checked');
    return r ? String(r.value || 'continue_list').trim() : 'continue_list';
  }
  if (dialRetryScheduleInput) {
    dialRetryScheduleInput.addEventListener('change', syncDialRetryCustomFields);
    syncDialRetryCustomFields();
  }
  function formatEta(ms) {
    if (ms <= 0) return '00:00';
    var totalMin = Math.ceil(ms / 60000);
    var hh = Math.floor(totalMin / 60);
    var mm = totalMin % 60;
    return String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
  }
  function tickBurnEtas() {
    var nodes = document.querySelectorAll('.ws-burn-eta[data-until]');
    if (!nodes.length) return;
    var now = Date.now();
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var ts = Date.parse(String(el.getAttribute('data-until') || ''));
      if (!Number.isFinite(ts)) {
        el.textContent = '--:--';
        continue;
      }
      var left = ts - now;
      el.textContent = formatEta(left);
      if (left <= 0) {
        el.textContent = '00:00';
      }
    }
  }
  function getCallMode() {
    var r = document.querySelector('input[name="wsCallMode"]:checked');
    return r ? String(r.value || 'cloud_dial').trim() : 'cloud_dial';
  }
  function syncAgentPhoneVisibility() {
    if (!agentWrap) return;
    agentWrap.classList.toggle('hidden', getCallMode() !== 'agent_first');
  }
  function bindCallModeRadios() {
    document.querySelectorAll('input[name="wsCallMode"]').forEach(function (r) {
      r.addEventListener('change', syncAgentPhoneVisibility);
    });
    syncAgentPhoneVisibility();
  }
  if (!btn) return;
  function loadSwNumberOptions() {
    var dl = document.getElementById('swPhoneBankNumberOptions');
    var hint = document.getElementById('swPhoneListHint');
    if (!dl) return;
    fetch('/workspace/phone-bank/available-numbers', {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        dl.innerHTML = '';
        if (data && data.success && data.numbers && data.numbers.length) {
          for (var i = 0; i < data.numbers.length; i++) {
            var n = data.numbers[i];
            if (!n || !n.phoneNumber) continue;
            var opt = document.createElement('option');
            opt.value = n.phoneNumber;
            if (n.friendlyName) {
              opt.appendChild(document.createTextNode(n.friendlyName + ' — ' + n.phoneNumber));
            }
            dl.appendChild(opt);
          }
          if (hint) {
            hint.classList.add('hidden');
            hint.textContent = '';
          }
        } else {
          if (hint) {
            var err = data && data.error;
            if (err === 'not_configured') {
              hint.textContent =
                'SignalWire is not fully configured on the server, or the list could not be loaded. You can still type any number you own in E.164. Your admin should set SIGNALWIRE_SPACE_URL, SIGNALWIRE_PROJECT_ID, SIGNALWIRE_TOKEN, and SIGNALWIRE_FROM_NUMBER.';
            } else if (err) {
              hint.textContent = 'Could not list numbers from SignalWire: ' + err + '. You can still type a number in E.164 if you know it.';
            } else {
              hint.textContent =
                'No numbers were returned for this project. Add phone numbers in the SignalWire dashboard, then refresh this page — or type a number in E.164.';
            }
            hint.classList.remove('hidden');
          }
        }
      })
      .catch(function () {
        if (hint) {
          hint.textContent = 'Could not load the number list. You can still type a number in E.164.';
          hint.classList.remove('hidden');
        }
      });
  }
  loadSwNumberOptions();
  function bindWalkthroughBtn(id, mode) {
    var el = document.getElementById(id);
    if (el && typeof window.openCallRoutingWalkthrough === 'function') {
      el.addEventListener('click', function () {
        window.openCallRoutingWalkthrough(mode);
      });
    }
  }
  bindWalkthroughBtn('callRoutingWalkthroughCloudBtn', 'cloud_dial');
  bindWalkthroughBtn('callRoutingWalkthroughAgentBtn', 'agent_first');
  bindWalkthroughBtn('callRoutingWalkthroughDeviceBtn', 'browser_device');
  tickBurnEtas();
  window.setInterval(tickBurnEtas, 30000);
  bindCallModeRadios();
  function bindEntryRow(row) {
    if (!row) return;
    var remove = row.querySelector('.ws-phone-remove');
    if (remove) {
      remove.addEventListener('click', function () {
        row.remove();
      });
    }
  }
  if (list) {
    Array.prototype.forEach.call(list.querySelectorAll('.ws-phone-entry'), bindEntryRow);
  }
  if (addBtn && list) {
    addBtn.addEventListener('click', function () {
      var div = document.createElement('div');
      div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 items-center p-3 rounded-xl border border-brand-border/40 dark:border-white/10 bg-brand-cream/30 dark:bg-slate-800/50 ws-phone-entry';
      div.innerHTML = '' +
        '<div class="md:col-span-3"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Number (DID)</label><input type="text" class="ws-phone-number w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" list="swPhoneBankNumberOptions" placeholder="Choose from list or type +1555…" autocomplete="off" /></div>' +
        '<div class="md:col-span-3"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Forwards to</label><input type="tel" class="ws-phone-forward w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="+1555… (your cell / desk)" autocomplete="off" /></div>' +
        '<div class="md:col-span-2"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Caller name</label><input type="text" class="ws-phone-caller-name w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="ADHELLO AI" /></div>' +
        '<div class="md:col-span-2"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM status</label><select class="ws-phone-cnam-status w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs"><option value="not_submitted">not_submitted</option><option value="submitted">submitted</option><option value="in_review">in_review</option><option value="approved">approved</option><option value="rejected">rejected</option><option value="live">live</option></select></div>' +
        '<div class="md:col-span-1"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">Active</label><label class="inline-flex items-center gap-2 text-xs"><input type="radio" name="wsActiveCallerRadio" class="ws-phone-active" value="" />Use</label></div>' +
        '<div class="md:col-span-1 flex md:justify-end"><button type="button" class="ws-phone-remove text-[10px] font-black uppercase tracking-widest text-rose-600 hover:underline">Remove</button></div>' +
        '<div class="md:col-span-12 flex flex-wrap gap-x-6 gap-y-1 rounded-lg border border-brand-border/25 dark:border-white/10 bg-white/50 dark:bg-slate-900/40 px-3 py-2"><span class="text-[9px] font-black uppercase tracking-widest text-brand-muted">Inbound</span><span class="text-xs font-bold tabular-nums text-brand-dark dark:text-white">0 total</span><span class="text-[10px] text-emerald-700 dark:text-emerald-300 font-semibold tabular-nums">0 connected</span><span class="text-[10px] text-rose-700 dark:text-rose-300 font-semibold tabular-nums">0 missed</span><span class="text-[10px] text-violet-700 dark:text-violet-300 font-semibold tabular-nums">0 voicemail</span></div>' +
        '<div class="md:col-span-12"><label class="block text-[9px] font-black uppercase tracking-widest text-brand-muted mb-1">CNAM notes</label><input type="text" class="ws-phone-cnam-notes w-full rounded-lg border border-brand-border/40 dark:border-white/10 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs" placeholder="Carrier ticket / support notes" /></div>';
      list.appendChild(div);
      bindEntryRow(div);
    });
  }
  function collectEntries() {
    if (!list) return [];
    var rows = list.querySelectorAll('.ws-phone-entry');
    return Array.prototype.map.call(rows, function (row) {
      var number = (row.querySelector('.ws-phone-number') || {}).value || '';
      var forwardNumber = (row.querySelector('.ws-phone-forward') || {}).value || '';
      var callerName = (row.querySelector('.ws-phone-caller-name') || {}).value || '';
      var cnamStatus = (row.querySelector('.ws-phone-cnam-status') || {}).value || 'not_submitted';
      var cnamNotes = (row.querySelector('.ws-phone-cnam-notes') || {}).value || '';
      return { number: number, forwardNumber: forwardNumber, callerName: callerName, cnamStatus: cnamStatus, cnamNotes: cnamNotes };
    }).filter(function (x) { return x.number && x.number.trim(); });
  }
  function activeNumber() {
    var picked = document.querySelector('input[name="wsActiveCallerRadio"]:checked');
    if (!picked) return '';
    return String(picked.value || '').trim();
  }
  if (list) {
    list.addEventListener('input', function (e) {
      if (e.target && e.target.classList.contains('ws-phone-number')) {
        var row = e.target.closest('.ws-phone-entry');
        var active = row ? row.querySelector('.ws-phone-active') : null;
        if (active) active.value = e.target.value;
      }
    });
  }
  btn.addEventListener('click', function () {
    var entries = collectEntries();
    fetch('/workspace/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        phoneBankEntries: entries,
        activeCallerId: activeNumber(),
        callMode: getCallMode(),
        agentPhone: agentPhoneInput ? String(agentPhoneInput.value || '').trim() : '',
        perNumberHourCap: perNumberHourCapInput ? String(perNumberHourCapInput.value || '').trim() : '',
        quietHoursStart: quietStartInput ? String(quietStartInput.value || '').trim() : '',
        quietHoursEnd: quietEndInput ? String(quietEndInput.value || '').trim() : '',
        dialRetryAutoNoAnswer: dialRetryAutoInput ? !!dialRetryAutoInput.checked : true,
        dialRetrySchedule: dialRetryScheduleInput ? String(dialRetryScheduleInput.value || '18h') : '18h',
        dialRetryDelayHours: dialRetryDelayHoursInput ? String(dialRetryDelayHoursInput.value || '18') : '18',
        dialRetryDelayDays: dialRetryDelayDaysInput ? String(dialRetryDelayDaysInput.value || '3') : '3',
        dialRetryAtHour: dialRetryAtHourInput ? String(dialRetryAtHourInput.value || '10') : '10',
        dialRetryQueueMode: getDialRetryQueueMode(),
      }),
    }).then(function (r) { return r.json(); }).then(function (data) {
      if (msg) {
        msg.classList.remove('hidden');
        msg.textContent = data && data.success ? 'Saved.' : (data && data.error) || 'Save failed';
        msg.className = 'text-sm ' + (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
      }
    }).catch(function () {
      if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Save failed'; msg.className = 'text-sm text-rose-600'; }
    });
  });
  if (submitBtn) {
    submitBtn.addEventListener('click', function () {
      var number = activeNumber();
      if (!number) {
        if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Select an active number first.'; msg.className = 'text-sm text-rose-600'; }
        return;
      }
      var row = document.querySelector('.ws-phone-entry input.ws-phone-active:checked');
      row = row ? row.closest('.ws-phone-entry') : null;
      var callerName = row ? ((row.querySelector('.ws-phone-caller-name') || {}).value || '') : '';
      var cnamNotes = row ? ((row.querySelector('.ws-phone-cnam-notes') || {}).value || '') : '';
      fetch('/workspace/phone-bank/cnam-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ number: number, callerName: callerName, cnamNotes: cnamNotes }),
      }).then(function (r) { return r.json(); }).then(function (data) {
        if (msg) {
          msg.classList.remove('hidden');
          msg.textContent = data && data.success ? 'CNAM request submitted.' : (data && data.error) || 'Submit failed';
          msg.className = 'text-sm ' + (data && data.success ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
        }
      }).catch(function () {
        if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Submit failed'; msg.className = 'text-sm text-rose-600'; }
      });
    });
  }

  var shareRoot = document.getElementById('wsPhoneShareRoot');
  var shareGen = document.getElementById('wsPhoneShareGenerate');
  var shareCopy = document.getElementById('wsPhoneShareCopy');
  var shareDisable = document.getElementById('wsPhoneShareDisable');
  var shareUrlEl = document.getElementById('wsPhoneShareUrl');
  var shareMsg = document.getElementById('wsPhoneShareMsg');
  var wsId = shareRoot ? String(shareRoot.getAttribute('data-workspace-id') || '').trim() : '';

  function setShareMsg(text, ok) {
    if (!shareMsg) return;
    shareMsg.classList.remove('hidden');
    shareMsg.textContent = text;
    shareMsg.className = 'mt-2 text-[11px] ' + (ok ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-600');
  }

  function stashShareUrl(url) {
    try {
      if (wsId && url) sessionStorage.setItem('phoneAnalyticsShareUrl_' + wsId, url);
    } catch (_) {}
  }
  function peekShareUrl() {
    try {
      if (!wsId) return '';
      return sessionStorage.getItem('phoneAnalyticsShareUrl_' + wsId) || '';
    } catch (_) {
      return '';
    }
  }

  if (shareGen) {
    shareGen.addEventListener('click', function () {
      fetch('/workspace/phone-analytics-share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ action: 'generate' }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.success && data.shareUrl) {
            stashShareUrl(data.shareUrl);
            if (shareUrlEl) {
              shareUrlEl.textContent = data.shareUrl;
              shareUrlEl.classList.remove('hidden');
            }
            if (shareCopy) shareCopy.disabled = false;
            if (shareDisable) shareDisable.disabled = false;
            setShareMsg('New link ready. Copy and send to your client.', true);
            shareGen.textContent = 'Rotate link';
          } else {
            setShareMsg((data && data.error) || 'Could not generate link.', false);
          }
        })
        .catch(function () {
          setShareMsg('Request failed.', false);
        });
    });
  }
  if (shareCopy) {
    shareCopy.addEventListener('click', function () {
      var url = peekShareUrl();
      if (!url && shareUrlEl && shareUrlEl.textContent) url = shareUrlEl.textContent.trim();
      if (!url) {
        setShareMsg('Generate or rotate to get a URL. If you opened this page fresh, rotate once to copy again.', false);
        return;
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {
          setShareMsg('Copied to clipboard.', true);
        }).catch(function () {
          setShareMsg('Could not copy — select the URL above.', false);
        });
      } else {
        setShareMsg(url, true);
      }
    });
  }
  if (shareDisable) {
    shareDisable.addEventListener('click', function () {
      fetch('/workspace/phone-analytics-share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ action: 'disable' }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.success) {
            try {
              if (wsId) sessionStorage.removeItem('phoneAnalyticsShareUrl_' + wsId);
            } catch (_) {}
            if (shareUrlEl) {
              shareUrlEl.textContent = '';
              shareUrlEl.classList.add('hidden');
            }
            shareCopy.disabled = true;
            shareDisable.disabled = true;
            shareGen.textContent = 'Generate link';
            setShareMsg('Share link revoked.', true);
          } else {
            setShareMsg((data && data.error) || 'Could not revoke.', false);
          }
        })
        .catch(function () {
          setShareMsg('Request failed.', false);
        });
    });
  }
})();
</script>
