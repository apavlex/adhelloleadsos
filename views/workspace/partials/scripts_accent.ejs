<script>
(function () {
  var btn = document.getElementById('wsAccentSave');
  var msg = document.getElementById('wsAccentMsg');
  var preview = document.getElementById('wsAccentPreview');
  var custom = document.getElementById('wsAccentCustom');
  var customHex = document.getElementById('wsAccentCustomHex');
  var selectedHex = document.getElementById('wsAccentSelectedHex');

  function normalizeHex(v) {
    var raw = String(v || '').trim();
    if (!raw) return '';
    if (raw.charAt(0) !== '#') raw = '#' + raw;
    if (!/^#[0-9a-fA-F]{6}$/.test(raw)) return '';
    return raw.toLowerCase();
  }

  function getPickedColor() {
    var picked = document.querySelector('input[name="wsAccentChoice"]:checked');
    if (picked && picked.value) return normalizeHex(picked.value);
    return normalizeHex(customHex && customHex.value ? customHex.value : (custom && custom.value ? custom.value : ''));
  }

  function applyPreview(hex) {
    if (!hex) return;
    if (preview) preview.style.setProperty('--preview-accent', hex);
    if (custom) custom.value = hex;
    if (customHex) customHex.value = hex;
    if (selectedHex) selectedHex.textContent = hex;
  }

  function syncPreview() {
    applyPreview(getPickedColor());
  }

  document.querySelectorAll('input[name="wsAccentChoice"]').forEach(function (r) {
    r.addEventListener('change', function () {
      applyPreview(normalizeHex(r.value));
    });
  });
  if (custom) {
    custom.addEventListener('input', function () {
      document.querySelectorAll('input[name="wsAccentChoice"]').forEach(function (r) { r.checked = false; });
      applyPreview(normalizeHex(custom.value));
    });
  }
  if (customHex) {
    customHex.addEventListener('input', function () {
      document.querySelectorAll('input[name="wsAccentChoice"]').forEach(function (r) { r.checked = false; });
      var hex = normalizeHex(customHex.value);
      if (hex) applyPreview(hex);
    });
    customHex.addEventListener('blur', function () {
      var hex = normalizeHex(customHex.value);
      if (hex) applyPreview(hex);
      else syncPreview();
    });
  }
  syncPreview();
  if (!btn) return;
  btn.addEventListener('click', function () {
    var pickedHex = getPickedColor();
    if (!pickedHex) {
      if (msg) {
        msg.classList.remove('hidden');
        msg.textContent = 'Choose a swatch or enter a valid 6-digit hex color.';
        msg.className = 'text-sm mb-3 text-rose-600';
      }
      return;
    }
    fetch('/workspace/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ accentColor: pickedHex }),
    }).then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); }).then(function (res) {
      if (msg) {
        msg.classList.remove('hidden');
        if (res.ok && res.data && res.data.success) {
          msg.textContent = 'Saved. Refreshing…';
          msg.className = 'text-sm mb-3 text-emerald-700 dark:text-emerald-300';
          window.location.reload();
        } else {
          msg.textContent = (res.data && res.data.error) || 'Save failed';
          msg.className = 'text-sm mb-3 text-rose-600';
        }
      }
    }).catch(function () {
      if (msg) { msg.classList.remove('hidden'); msg.textContent = 'Save failed'; msg.className = 'text-sm mb-3 text-rose-600'; }
    });
  });
})();
</script>
