<script>
(function () {
  var jsonEl = document.getElementById('rrPoolJson');
  var ribbon = document.getElementById('rrRibbon');
  var preview = document.getElementById('rrPreview');
  var msg = document.getElementById('rrOrderMsg');
  if (!jsonEl || !ribbon) return;
  var emails = [];
  try {
    emails = JSON.parse(jsonEl.textContent || '[]');
  } catch (_) {
    return;
  }
  if (!Array.isArray(emails) || !emails.length) return;

  function shortLabel(e) {
    var at = String(e || '').indexOf('@');
    return at > 0 ? String(e).slice(0, at) : String(e || '');
  }

  function updatePreview() {
    if (!preview) return;
    if (!emails.length) {
      preview.textContent = '';
      return;
    }
    var a = shortLabel(emails[0]);
    var b = emails.length > 1 ? shortLabel(emails[1]) : null;
    preview.textContent = b
      ? 'Next inbound → ' + a + ' · After that → ' + b
      : 'Next inbound → ' + a;
  }

  var dragEmail = null;

  function renderRibbon() {
    ribbon.innerHTML = '';
    emails.forEach(function (email, idx) {
      var chip = document.createElement('div');
      chip.setAttribute('role', 'listitem');
      chip.draggable = true;
      chip.dataset.email = String(email);
      chip.className =
        'rr-chip group flex items-center gap-2 cursor-grab active:cursor-grabbing select-none rounded-xl border-2 border-brand-border/50 dark:border-white/15 bg-white dark:bg-slate-900 px-3 py-2 text-xs font-semibold text-brand-dark dark:text-white shadow-sm hover:border-brand-yellow/60 transition-colors';
      chip.innerHTML =
        '<span class="text-brand-muted text-[10px] font-black tabular-nums">' +
        (idx + 1) +
        '</span>' +
        '<span class="truncate max-w-[11rem]"></span>' +
        '<span class="text-[9px] text-brand-muted opacity-0 group-hover:opacity-100 shrink-0" aria-hidden="true">↕</span>';
      chip.querySelector('span:nth-child(2)').textContent = shortLabel(email);
      chip.title = email;
      ribbon.appendChild(chip);
    });
    updatePreview();
  }

  function moveEmail(fromEmail, toEmail) {
    var from = emails.indexOf(fromEmail);
    var to = emails.indexOf(toEmail);
    if (from === -1 || to === -1 || from === to) return false;
    var next = emails.slice();
    var item = next.splice(from, 1)[0];
    next.splice(to, 0, item);
    emails = next;
    return true;
  }

  var saveTimer = null;
  function persistOrder() {
    if (saveTimer) window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(function () {
      fetch('/workspace/routing-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ emails: emails }),
      })
        .then(function (r) {
          return r.json().then(function (d) {
            return { ok: r.ok, d: d };
          });
        })
        .then(function (x) {
          if (!msg) return;
          msg.classList.remove('hidden');
          if (x.ok && x.d && x.d.success) {
            msg.textContent = 'Order saved.';
            msg.className = 'mt-2 text-xs text-emerald-700 dark:text-emerald-300';
          } else {
            msg.textContent = (x.d && x.d.error) || 'Could not save order.';
            msg.className = 'mt-2 text-xs text-rose-600';
          }
        })
        .catch(function () {
          if (msg) {
            msg.classList.remove('hidden');
            msg.textContent = 'Could not save order.';
            msg.className = 'mt-2 text-xs text-rose-600';
          }
        });
    }, 250);
  }

  ribbon.addEventListener('dragstart', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('.rr-chip') : null;
    if (!t) return;
    dragEmail = t.dataset.email || '';
    e.dataTransfer.effectAllowed = 'move';
    try {
      e.dataTransfer.setData('text/plain', dragEmail);
    } catch (_) {}
    t.classList.add('opacity-50');
  });

  ribbon.addEventListener('dragend', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('.rr-chip') : null;
    if (t) t.classList.remove('opacity-50');
    dragEmail = null;
  });

  ribbon.addEventListener('dragover', function (e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  });

  ribbon.addEventListener('drop', function (e) {
    e.preventDefault();
    var over = e.target && e.target.closest ? e.target.closest('.rr-chip') : null;
    var fromEmail = dragEmail;
    try {
      if (!fromEmail) fromEmail = String(e.dataTransfer.getData('text/plain') || '').trim();
    } catch (_) {}
    if (!over || !fromEmail) return;
    var toEmail = over.dataset.email || '';
    if (moveEmail(fromEmail, toEmail)) {
      renderRibbon();
      persistOrder();
    }
  });

  renderRibbon();
})();
</script>
