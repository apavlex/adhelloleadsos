<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { tailwindInPage: true }) %>
  <%- include('partials/tailwind_css') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark dark:text-white overflow-x-hidden">
  <%- include('partials/navbar') %>
  <%
    const placeLabel = (typeof workspace !== 'undefined' && workspace && workspace.name)
      ? String(workspace.name).trim()
      : '';
  %>
  <main class="max-wide px-6 py-8 md:py-12">
    <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-brand-muted mb-2">Referrals</p>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">Appointments</h1>
        <% const _canSellPage = typeof canSellAppointments !== 'undefined' && !!canSellAppointments; %>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-muted dark:text-slate-400"><% if (_canSellPage) { %>App admins list leads and packages on the shared appointments pool for commission. Workspaces buy available slots, then track booked and closed from Go High Level.<% } else { %>Buy available appointments from the AdHello pool. Purchased slots appear as Appts left — sync booked and closed from Go High Level. Only app admins can create or sell inventory.<% } %></p>
      </div>
      <% if (placeLabel) { %>
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-muted"><%= placeLabel %></p>
      <% } %>
    </header>

    <details class="appt-howto mb-6 rounded-2xl border border-brand-border dark:border-white/10 bg-white/90 dark:bg-slate-900/80 overflow-hidden">
      <summary class="cursor-pointer list-none flex items-center justify-between gap-3 px-5 py-4 select-none [&::-webkit-details-marker]:hidden">
        <span class="min-w-0">
          <span class="block text-[10px] font-black uppercase tracking-widest text-brand-muted">How to use this page</span>
          <span class="block mt-0.5 text-sm font-bold text-brand-dark dark:text-white"><%= _canSellPage ? 'List for pool → send leads → sync booked & closed' : 'Buy from pool → track booked & closed' %></span>
        </span>
        <svg class="appt-howto-chevron w-4 h-4 shrink-0 text-brand-muted transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </summary>
      <div class="px-5 pb-5 pt-0 border-t border-brand-border/40 dark:border-white/10">
        <ol class="mt-4 space-y-3 text-sm text-brand-dark dark:text-slate-200 max-w-3xl">
          <% if (_canSellPage) { %>
          <li><strong class="font-extrabold">List for pool</strong> — add a lead or slot package to the shared appointments pool with a commission note. Workspaces buy from that pool; they cannot create listings.</li>
          <li><strong class="font-extrabold">Sell appointments</strong> — create a package for a contractor (business, trade, slots). Optionally check “Also list on appointments pool” so leftover inventory is buyable by other workspaces.</li>
          <li><strong class="font-extrabold">Send lead</strong> — send a homeowner to contractors, and optionally list the same lead on the pool for commission so network workspaces can buy slots.</li>
          <li><strong class="font-extrabold">Sync GHL calendar</strong> — connect Go High Level in Workspace → Integrations, link a calendar, then sync so booked and closed update automatically.</li>
          <% } else { %>
          <li><strong class="font-extrabold">Buy appointments</strong> — choose a listing in the appointments pool, set quantity, and buy. Slots land on this workspace as Appts left.</li>
          <li><strong class="font-extrabold">Track &amp; sync</strong> — connect Go High Level in Workspace → Integrations and sync so booked and closed slots update. You cannot sell or list inventory from a workspace.</li>
          <% } %>
        </ol>
        <% if (_canSellPage) { %>
        <p class="mt-3 text-[12px] text-brand-muted">Tip: only AdHello app admins/managers (agency owner/admin or <code>PUBLIC_DEMO_ADMIN_EMAILS</code>) see Sell / List / Send. Regular workspaces only see Buy.</p>
        <% } %>
      </div>
    </details>
    <style>
      details.appt-howto[open] .appt-howto-chevron { transform: rotate(180deg); }
    </style>

    <%- include('partials/appointment_tracker') %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
