<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bg min-h-screen text-brand-dark overflow-x-hidden transition-colors duration-400">
  <%- include('partials/navbar') %>

  <main class="max-wide px-6 py-10 md:py-14">
    <%- include('partials/sales-nav') %>

    <div class="mb-12 max-w-3xl">
      <h1 class="font-display font-extrabold text-3xl md:text-4xl tracking-tight text-brand-dark dark:text-white">AI <span class="text-brand-muted">Personas</span></h1>
      <p class="text-brand-muted font-medium mt-2">Assign mental models to your tooling: prospect, close, build. Scripts below switch by offer — swap <code class="text-xs bg-brand-cream/80 dark:bg-slate-800 px-1 rounded">{{name}}</code> when pasting into outreach.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-16">
      <% PERSONAS.forEach((p) => { %>
        <div class="brand-card p-6 dark:bg-slate-900 dark:border-white/10 flex flex-col">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br <%= p.color %> mb-4 flex items-center justify-center text-white font-display font-black text-xl shadow-lg"><%= p.name[0] %></div>
          <h2 class="font-display font-extrabold text-xl text-brand-dark dark:text-white"><%= p.name %></h2>
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-muted mb-4"><%= p.role %></p>
          <ul class="text-sm text-brand-muted space-y-2 flex-1 mb-6">
            <% p.duties.forEach((d) => { %><li>• <%= d %></li><% }) %>
          </ul>
          <a href="<%= p.href %>" class="btn-pill bg-brand-dark text-white dark:bg-white dark:text-slate-900 text-center text-xs font-black uppercase tracking-widest py-3"><%= p.hrefLabel %></a>
        </div>
      <% }) %>
    </div>

    <div class="brand-card dark:bg-slate-900 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-brand-border dark:border-white/10 flex flex-wrap gap-2 items-center justify-between">
        <h2 class="font-display font-extrabold text-lg text-brand-dark dark:text-white">Dynamic scripting</h2>
        <div class="flex gap-2" id="pitchTabs">
          <button type="button" data-pitch="reputation" class="pitch-tab px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-brand-yellow text-brand-dark shadow-sm">Reputation</button>
          <button type="button" data-pitch="aiWebsites" class="pitch-tab px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-white dark:bg-slate-800 border border-brand-border dark:border-white/10 text-brand-muted">AI Websites</button>
        </div>
      </div>

      <% const pitches = ['reputation', 'aiWebsites']; %>
      <% pitches.forEach((pk, idx) => { %>
        <% const block = SCRIPT_LIBRARY[pk]; %>
        <div class="pitch-panel px-6 py-8 <%= idx === 0 ? '' : 'hidden' %>" data-panel="<%= pk %>">
          <p class="text-sm font-bold text-brand-muted mb-6"><%= block.label %></p>
          <% ['opening', 'discovery', 'valueProp', 'close'].forEach((section) => { %>
            <% const labels = { opening: 'Opening', discovery: 'Discovery', valueProp: 'Value prop', close: 'Close' }; %>
            <div class="mb-8 last:mb-0">
              <div class="flex items-center justify-between gap-4 mb-2">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-yellow"><%= labels[section] %></h3>
                <button type="button" class="copy-snippet text-[10px] font-black uppercase text-brand-muted hover:text-brand-dark dark:hover:text-white" data-copy-target="snippet-<%= pk %>-<%= section %>">Copy</button>
              </div>
              <pre id="snippet-<%= pk %>-<%= section %>" class="text-sm leading-relaxed text-brand-dark dark:text-slate-200 bg-brand-cream/30 dark:bg-black/20 rounded-2xl p-4 border border-brand-border/50 dark:border-white/10 whitespace-pre-wrap font-sans"><%= block[section] %></pre>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>

    <p class="mt-8 text-center text-[11px] text-brand-muted max-w-2xl mx-auto">
      Live AI coach and predictive scoring hook into the same stack later (WebSocket + speech APIs). This page is your static playbook until those services are wired.
    </p>
  </main>

  <script>
    (function () {
      var tabs = document.querySelectorAll('.pitch-tab');
      var panels = document.querySelectorAll('.pitch-panel');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var pitch = tab.getAttribute('data-pitch');
          tabs.forEach(function (t) {
            t.classList.remove('bg-brand-yellow', 'text-brand-dark', 'shadow-sm');
            t.classList.add('bg-white', 'dark:bg-slate-800', 'border', 'border-brand-border', 'dark:border-white/10', 'text-brand-muted');
          });
          tab.classList.add('bg-brand-yellow', 'text-brand-dark', 'shadow-sm');
          tab.classList.remove('bg-white', 'dark:bg-slate-800', 'border', 'border-brand-border', 'dark:border-white/10', 'text-brand-muted');
          panels.forEach(function (p) {
            p.classList.toggle('hidden', p.getAttribute('data-panel') !== pitch);
          });
        });
      });
      document.querySelectorAll('.copy-snippet').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-copy-target');
          var el = document.getElementById(id);
          if (!el) return;
          navigator.clipboard.writeText(el.textContent || '').then(function () {
            var t = btn.textContent;
            btn.textContent = 'Copied';
            setTimeout(function () { btn.textContent = t; }, 1500);
          });
        });
      });
    })();
  </script>
</body>
</html>
