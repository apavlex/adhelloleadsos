{
  "manifest_version": 3,
  "name": "AdHello Leads",
  "version": "1.5.1",
  "description": "Save leads, listings, and products from social profiles and directories into AdHello.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AdHello Leads",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://*.google.com/maps/*",
        "https://google.com/maps/*",
        "https://maps.google.com/*",
        "https://*.google.co.uk/maps/*",
        "https://*.google.ca/maps/*",
        "https://*.google.com.au/maps/*",
        "https://www.yelp.com/*",
        "https://yelp.com/*",
        "https://*.yelp.com/*",
        "https://www.yellowpages.com/*",
        "https://yellowpages.com/*",
        "https://www.bbb.org/*",
        "https://bbb.org/*",
        "https://*.tripadvisor.com/*",
        "https://tripadvisor.com/*",
        "https://www.angi.com/*",
        "https://angi.com/*",
        "https://www.homeadvisor.com/*",
        "https://homeadvisor.com/*",
        "https://www.thumbtack.com/*",
        "https://thumbtack.com/*",
        "https://maps.apple.com/*",
        "https://www.bing.com/maps/*",
        "https://bing.com/maps/*",
        "https://foursquare.com/*",
        "https://www.foursquare.com/*",
        "https://www.manta.com/*",
        "https://manta.com/*",
        "https://www.citysearch.com/*",
        "https://citysearch.com/*",
        "https://www.superpages.com/*",
        "https://superpages.com/*",
        "https://*.groupon.com/*",
        "https://www.groupon.com/*",
        "https://groupon.com/*",
        "https://*.craigslist.org/*",
        "http://*.craigslist.org/*",
        "https://nextdoor.com/*",
        "https://*.nextdoor.com/*",
        "https://www.houzz.com/*",
        "https://houzz.com/*",
        "https://www.zillow.com/*",
        "https://zillow.com/*",
        "https://*.zillow.com/*",
        "https://www.mhvillage.com/*",
        "https://mhvillage.com/*",
        "https://*.mhvillage.com/*",
        "https://www.realtor.com/*",
        "https://realtor.com/*",
        "https://www.redfin.com/*",
        "https://redfin.com/*",
        "https://www.offerup.com/*",
        "https://offerup.com/*",
        "https://www.ebay.com/*",
        "https://ebay.com/*"
      ],
      "js": ["src/address-utils.js", "src/listing-helpers.js", "src/listing-extractors.js", "src/extractors.js", "src/theme.js", "src/maps-bulk-scrape.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
