{
  "manifest_version": 3,
  "name": "AdHello Leads",
  "version": "1.8.2",
  "description": "Save leads from business websites, social profiles, and directories into AdHello — including contacts, address, and social links. Bulk-scrape Maps and enrich selected pipeline leads from their websites.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AdHello Leads",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://accounts.google.com/*",
        "https://chrome.google.com/*",
        "https://chromewebstore.google.com/*"
      ],
      "js": [
        "src/address-utils.js",
        "src/website-utils.js",
        "src/website-scrape.js",
        "src/listing-helpers.js",
        "src/listing-extractors.js",
        "src/extractors.js",
        "src/theme.js",
        "src/maps-bulk-scrape.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
