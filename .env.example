# Copy to .env and fill in values (do not commit real secrets).

# App
PORT=3000
BASE_URL=http://localhost:3000
# On Render / Cloud Run, set BASE_URL to your public URL. RENDER_EXTERNAL_URL is used as fallback if BASE_URL is unset.
SESSION_SECRET=

# Persistence — REQUIRED on Cloud Run / Render or data is wiped every deploy
# Directory for SQLite (leads, searches, workspace keys). Mount a persistent volume at this path in production.
# APP_DATA_DIR=/data
# Encrypts API keys saved from Workspace → Integrations (min 16 chars). Must stay the same across deploys.
# WORKSPACE_INTEGRATIONS_SECRET=

# Google sign-in (Pipeline → Import from Drive uses the same client + extra redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser API key (restrict by HTTP referrer). Enable "Google Picker API" + "Google Drive API" in the same GCP project.
GOOGLE_PICKER_API_KEY=

# OAuth redirect URIs to register on the Google client:
#   {BASE_URL}/auth/google/callback
#   {BASE_URL}/auth/google/drive/callback

# BetterContact — Hunt for more contact data (waterfall email + phone)
# BETTERCONTACT_API_KEY=

# Optional: nightly prep, cron, etc. (see app docs)
# CRON_SECRET=
# Browser + server maps (restrict key by HTTP referrer for your app URL + localhost).
# Enable in the same GCP project: Maps JavaScript API, Geocoding API, Maps Static API, Maps Embed API.
# GOOGLE_MAPS_API_KEY=

# Lighthouse audits in lead panel (Workspace → API integrations, or env). Same GCP key often works if PageSpeed Insights API is enabled.
# PAGESPEED_API_KEY=

# Cross-platform chat sync (AdHello CEO chat ↔ Telegram)
# TELEGRAM_BOT_TOKEN= your bot token from @BotFather
# TELEGRAM_CHAT_ID= 7325499142

# AI — OpenRouter (default for insights, flow coach, outreach, pipeline, etc.)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Default: qwen/qwen3-coder:free → deepseek/deepseek-v4-flash → deepseek/deepseek-v4-pro
# OPENROUTER_MODEL=qwen/qwen3-coder:free
# OPENROUTER_HTTP_REFERER=https://leads.adhello.ai
# OPENROUTER_APP_NAME=AdHello Leads OS

# AI — legacy chain (CEO dashboard chat + floating Pavlex chatbot only)
# KIE_AI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
