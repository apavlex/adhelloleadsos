# Copy to .env and fill in values (do not commit real secrets).

# App
PORT=3000
BASE_URL=http://localhost:3000
# On Render / Cloud Run, set BASE_URL to your public URL. RENDER_EXTERNAL_URL is used as fallback if BASE_URL is unset.
SESSION_SECRET=

# Persistence — REQUIRED on Render or data is wiped every deploy
# Render: attach a Persistent Disk at /app/data (see docs/DEPLOY_PERSISTENCE.md). Optional override:
# APP_DATA_DIR=/app/data
# Encrypts API keys saved from Workspace → Integrations (min 16 chars). Must stay the same across deploys.
# WORKSPACE_INTEGRATIONS_SECRET=

# Google sign-in (Pipeline → Import from Drive uses the same client + extra redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser API key (restrict by HTTP referrer). Enable "Google Picker API" + "Google Drive API" in the same GCP project.
GOOGLE_PICKER_API_KEY=

# OAuth redirect URIs to register on the Google client:
#   {BASE_URL}/auth/google/callback
#   {BASE_URL}/auth/google/drive/callback

# BetterContact — Hunt for more contact data (waterfall email + phone)
# BETTERCONTACT_API_KEY=

# Permit Stack — building permit lead search (Find leads → Permits)
# PERMITSTACK_API_KEY=

# Optional: nightly prep, cron, etc. (see app docs)
# CRON_SECRET=
# Browser + server maps (restrict key by HTTP referrer for your app URL + localhost).
# Enable in the same GCP project: Maps JavaScript API, Geocoding API, Maps Static API, Maps Embed API.
# GOOGLE_MAPS_API_KEY=

# Lighthouse audits in lead panel (Workspace → API integrations, or env). Same GCP key often works if PageSpeed Insights API is enabled.
# PAGESPEED_API_KEY=

# Go High Level — CRM sync (Workspace → Integrations, or env)
# Create a Private Integration token in GHL: Settings → Integrations → Private Integrations
# GHL_API_KEY=
# GHL_LOCATION_ID=  (sub-account location ID from GHL URL or API)
# GHL_WEBHOOK_SECRET=  (token for POST /api/webhooks/ghl?token=… — also accepts API_INGEST_KEY)

# Comms by Osis — iMessage & SMS (Workspace → Integrations, or env)
# Sign up at https://comms.osis.co/ and create an API key with comms_send + comms_read
# COMMS_API_KEY=osis_…
# COMMS_DEFAULT_CHANNEL=imessage  (optional: imessage | sms — blank = auto)
# COMMS_WEBHOOK_SECRET=  (token for POST /api/webhooks/comms?token=…)
# SAPERLY_API_KEY=sap_sk_live_…
# SAPERLY_FROM_NUMBER_ID=  (Saperly number id for outbound SMS)
# SAPERLY_WEBHOOK_SECRET=  (optional — for inbound Saperly webhooks)
# TIKHUB_API_KEY=  (TikHub — bulk Socials search for Instagram / TikTok / X)
# SMS_PRIMARY=auto  (auto | saperly | comms | ghl — outreach/cadence SMS routing)

# Lob — Direct mail postcards (Workspace → Integrations, or env)
# LOB_API_KEY=  (test_… for test mode, live_… for production)
# LOB_FROM_NAME=
# LOB_FROM_ADDRESS_LINE1=
# LOB_FROM_CITY=
# LOB_FROM_STATE=
# LOB_FROM_ZIP=
# LOB_POSTCARD_FRONT_URL=  (optional PDF URL — or upload in Integrations)
# LOB_POSTCARD_BACK_URL=
# LOB_LETTER_PDF_URL=

# Sub-agent API (Pavlex/Hermes) — same key used for /autonomous/* routes and the Chrome Lead Saver extension
# API_INGEST_KEY=adhello_secret_123
# CHROME_EXTENSION_REPO_URL=https://github.com/apavlex/adhelloleadsos/tree/main/chrome-extension

# Apify — listing scrapers (override actor IDs if needed)
# APIFY_REAL_ESTATE_ACTOR_ID=cirkit/zillow-search-scraper
# APIFY_CRAIGSLIST_ACTOR_ID=automation-lab/craigslist-scraper
# APIFY_FACEBOOK_MARKETPLACE_ACTOR_ID=parseforge/facebook-marketplace-scraper
# APIFY_OFFERUP_ACTOR_ID=piotrv1001/offerup-listings-scraper
# APIFY_MHVILLAGE_ACTOR_ID=piotrv1001/mhvillage-listings-scraper
# APIFY_REALTOR_ACTOR_ID=automation-lab/realtor-scraper
# APIFY_REDFIN_ACTOR_ID=h4sh/redfin-scraper
# APIFY_EBAY_ACTOR_ID=parseforge/ebay-scraper
# APIFY_BUSINESS_FORMATION_ACTOR_ID=scrapesage/us-business-formation-scraper
# SERPAPI_API_KEY=  (Google web search for listings — Workspace → Integrations)
# SEARCHAPI_API_KEY=  (fallback web search)

# Oxylabs Web Scraper API — Maps leads, listing search, real estate fallback
# Create API User at https://oxylabs.io/ → Web Scraper API → Users
# OXYLABS_USERNAME=customer-USERNAME
# OXYLABS_PASSWORD=
# OXYLABS_REALTIME_URL=https://realtime.oxylabs.io/v1/queries
# REAL_ESTATE_PRIMARY=oxylabs  (optional — prefer Oxylabs over Apify for /leads/find/real-estate)

# Cross-platform chat sync (AdHello CEO chat ↔ Telegram)
# TELEGRAM_BOT_TOKEN= your bot token from @BotFather
# TELEGRAM_CHAT_ID= 7325499142

# AI — OpenRouter (default for insights, flow coach, outreach, pipeline, etc.)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Default: qwen/qwen3-coder:free → deepseek/deepseek-v4-flash → deepseek/deepseek-v4-pro
# OPENROUTER_MODEL=qwen/qwen3-coder:free
# OPENROUTER_HTTP_REFERER=https://leads.adhello.ai
# OPENROUTER_APP_NAME=AdHello Leads OS

# AI — legacy chain (CEO dashboard chat + floating Pavlex chatbot only)
# KIE_AI_API_KEY=   # also used for Direct Mail → Design studio (GPT Image 2 via KIE Market API)
# KIE_AI_BASE_URL=https://api.kie.ai
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_RESPONSES_MODEL=gpt-4.1   # model for CEO Chief of Staff + MCP (Responses API)
# MCP_ACCESS_TOKEN=                # Bearer token OpenAI uses to call /ceo/mcp (or generate in Workspace → Integrations)
# MCP_WORKSPACE_ID=default         # optional — scope MCP_ACCESS_TOKEN to one workspace
# MCP_SESSION_SECRET=              # optional — signs short-lived Pavlex chat session tokens (defaults to SESSION_SECRET)
